{
  "comments": { "lineComment": "--" },
  "brackets": [["(", ")"], ["{", "}"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" }
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(·|\\.)\\s.*$",
      "action": { "indent": "indent" }
    }
  ]
}
