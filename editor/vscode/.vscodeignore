# Once this file exists, .gitignore no longer applies to vsce packaging,
# so everything that must stay out of the VSIX is listed here explicitly.
# NOTE: node_modules is NOT excluded on purpose — vsce bundles the production
# dependencies (vscode-languageclient & friends) into the VSIX; excluding it
# ships a package that fails with "Cannot find module" on install.
.vscode/**
.vscode-test/**
.vscode-test.mjs
.github/**
**/*.vsix
.DS_Store
# `src/` holds BOTH runtime modules (abbreviations.js / abbreviation-rewriter.js,
# required by extension.js) and the integration suite (src/test/**). Only the
# suite may be excluded — a blanket `src/**` shipped a VSIX whose extension
# crashed with "Cannot find module './src/abbreviation-rewriter'" (NI-2).
src/test/**
scripts/**
test-*.js

