{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sokonanoda",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#sorts"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#holes"
    },
    {
      "include": "#anonctor"
    },
    {
      "include": "#mathsymbols"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#binders"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "--.*$",
          "name": "comment.line.double-dash.sokonanoda"
        }
      ]
    },
    "declarations": {
      "match": "\\b(def|abbrev|theorem|axiom|inductive|ctor|rec|iota)\\s+([A-Za-z_][A-Za-z0-9_'.]*)",
      "captures": {
        "1": {
          "name": "keyword.other.sokonanoda"
        },
        "2": {
          "name": "entity.name.function.sokonanoda"
        }
      }
    },
    "keywords": {
      "match": "\\b(import|def|abbrev|theorem|example|axiom|inductive|ctor|rec|iota|end|fun|let|match|with|by|infix|infixl|infixr|prefix|postfix|notation|binder_notation|scoped|intro|exact|apply|assumption|rfl|constructor|left|right|use|exfalso|cases|have|forall|∀)\\b",
      "name": "keyword.other.sokonanoda"
    },
    "commands": {
      "match": "(#check|#reduce|#print)\\b",
      "name": "keyword.control.sokonanoda"
    },
    "sorts": {
      "match": "\\b(Prop|Type|Sort)\\b",
      "name": "storage.type.sokonanoda"
    },
    "constructors": {
      "match": "\\b[A-Z][A-Za-z0-9_']*(\\.[A-Za-z_][A-Za-z0-9_']*)+\\b",
      "name": "entity.name.type.sokonanoda"
    },
    "constants": {
      "match": "\\b[A-Z][A-Za-z0-9_']*\\b",
      "name": "entity.name.type.sokonanoda"
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.sokonanoda"
    },
    "holes": {
      "match": "\\bsorry\\b",
      "name": "markup.inserted.sokonanoda"
    },
    "operators": {
      "patterns": [
        {
          "match": "->|=>|=",
          "name": "keyword.operator.sokonanoda"
        },
        {
          "match": "->|=>",
          "name": "keyword.operator.sokonanoda"
        },
        {
          "match": ":=|\\|",
          "name": "keyword.operator.sokonanoda"
        },
        {
          "match": ":",
          "name": "punctuation.separator.sokonanoda"
        }
      ]
    },
    "binders": {
      "patterns": [
        {
          "match": "\\(\\s*([a-zA-Z_][A-Za-z0-9_']*)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "variable.parameter.sokonanoda"
            }
          }
        },
        {
          "match": "\\{\\s*([a-zA-Z_][A-Za-z0-9_']*)\\s*(?=[}:])",
          "captures": {
            "1": {
              "name": "variable.parameter.sokonanoda"
            }
          }
        }
      ]
    },
    "variables": {
      "match": "\\b[a-z_][A-Za-z0-9_']*\\b",
      "name": "variable.other.sokonanoda"
    },
    "mathsymbols": {
      "match": "[\\\\x{00AC}\\\\x{00B9}\\\\x{00D7}\\\\x{02E2}\\\\x{207B}\\\\x{2192}\\\\x{2194}\\\\x{2200}\\\\x{2203}\\\\x{2205}\\\\x{2208}\\\\x{2227}\\\\x{2228}\\\\x{2229}\\\\x{222A}\\\\x{2260}\\\\x{2286}\\\\x{1D4AB}\\\\x{1D9C}]+",
      "name": "keyword.operator.sokonanoda"
    },
    "anonctor": {
      "match": "⟨|⟩",
      "name": "punctuation.section.anonctor.sokonanoda"
    }
  },
  "scopeName": "source.sokonanoda"
}
