{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sokonanoda",
  "patterns": [
    {"include": "#comments"}, {"include": "#keywords"}, {"include": "#commands"}, {"include": "#sorts"}, {"include": "#numbers"}, {"include": "#arrows"}
  ],
  "repository": {
    "comments": {"patterns": [{"match": "--.*$", "name": "comment.line.double-dash.sokonanoda"}]},
    "keywords": {"match": "\\b(def|theorem|example|axiom|inductive|ctor|rec|iota|end|fun|let|match|with|by|intro|exact|apply|assumption|rfl|forall|∀)\\b", "name": "keyword.other.sokonanoda"},
    "commands": {"match": "(#check|#reduce|#print)\\b", "name": "keyword.other.sokonanoda"},
    "sorts": {"match": "\\b(Prop|Type|Sort)\\b", "name": "storage.type.sokonanoda"},
    "numbers": {"match": "\\b[0-9]+\\b", "name": "constant.numeric.sokonanoda"},
    "arrows": {
      "patterns": [
        {"match": "->", "name": "keyword.operator.arrow.sokonanoda"},
        {"match": "=>", "name": "keyword.operator.fatarrow.sokonanoda"},
        {"match": "\\bsorry\\b", "name": "markup.inserted.sokonanoda"}
      ]
    }
  },
  "scopeName": "source.sokonanoda"
}
