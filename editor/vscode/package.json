{
  "name": "sokonanoda",
  "displayName": "sokonanoda language support",
  "description": "Editor support for .sokonanoda teaching files (LSP diagnostics, hover types, exercise status)",
  "version": "0.1.0",
  "publisher": "sokonanoda-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlessBoy/sokonanoda-lang"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onLanguage:sokonanoda"],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In restricted mode the workspace-level sokonanoda.serverPath setting is ignored and the default server discovery is used.",
      "restrictedConfigurations": ["sokonanoda.serverPath"]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "sokonanoda",
        "aliases": ["sokonanoda", "sokonanoda lesson"],
        "extensions": [".sokonanoda"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sokonanoda",
        "scopeName": "source.sokonanoda",
        "path": "./syntaxes/sokonanoda.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sokonanoda.showStatus",
        "title": "sokonanoda: show exercise status",
        "icon": "$(checklist)"
      },
      {
        "command": "sokonanoda.status",
        "title": "sokonanoda: show declaration status"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "sokonanoda.status", "when": "false" }
      ]
    },
    "configuration": {
      "title": "sokonanoda",
      "properties": {
        "sokonanoda.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `sokonanoda-lsp` server binary. Leave empty for auto-discovery: `target/debug/sokonanoda-lsp`, then `target/release/sokonanoda-lsp`, in the workspace folders (and the repo checkout), else `sokonanoda-lsp` from `PATH`. Ignored in restricted (untrusted) workspaces."
        },
        "sokonanoda.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Log LSP traffic to the 'sokonanoda' output channel (for debugging)."
        }
      }
    },
    "keybindings": [
      {
        "command": "sokonanoda.showStatus",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "echo ok",
    "package": "vsce package --out sokonanoda.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
