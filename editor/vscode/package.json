{
  "name": "sokonanoda",
  "displayName": "sokonanoda language support",
  "description": "Learn theorem proving in a self-contained Lean-4-style language: real kernel grading, an Infoview goal panel, graded exercises, and agent skills that turn an LLM into your proof teacher. Zero setup - the language server ships inside the extension.",
  "version": "0.58.0",
  "publisher": "sokonanoda-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlessBoy/sokonanoda-lang"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:sokonanoda",
    "onView:sokonanoda.infoview"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In restricted mode the workspace-level sokonanoda.serverPath and sokonanoda.serverOverride settings are ignored and the bundled server is always used.",
      "restrictedConfigurations": [
        "sokonanoda.serverPath",
        "sokonanoda.serverOverride"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "sokonanoda",
        "aliases": [
          "sokonanoda",
          "sokonanoda lesson"
        ],
        "extensions": [
          ".sokonanoda"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sokonanoda",
        "scopeName": "source.sokonanoda",
        "path": "./syntaxes/sokonanoda.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sokonanoda.showStatus",
        "title": "sokonanoda: show exercise status",
        "icon": "$(checklist)"
      },
      {
        "command": "sokonanoda.status",
        "title": "sokonanoda: show declaration status"
      },
      {
        "command": "sokonanoda.nextHole",
        "title": "sokonanoda: go to next hole",
        "icon": "$(arrow-down)"
      },
      {
        "command": "sokonanoda.previousHole",
        "title": "sokonanoda: go to previous hole",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sokonanoda.goals.refresh",
        "title": "sokonanoda: refresh exercise panel",
        "icon": "$(refresh)"
      },
      {
        "command": "sokonanoda.courseRefresh",
        "title": "sokonanoda: 刷新课程地图",
        "icon": "$(refresh)"
      },
      {
        "command": "sokonanoda.revealRange",
        "title": "sokonanoda: reveal range"
      },
      {
        "command": "sokonanoda.revealHint",
        "title": "揭示下一条提示",
        "category": "sokonanoda"
      },
      {
        "command": "sokonanoda.restartServer",
        "title": "restart server",
        "icon": "$(debug-restart)",
        "category": "sokonanoda"
      },
      {
        "command": "sokonanoda.openInfoview",
        "title": "sokonanoda: 打开目标面板 (Infoview)",
        "icon": "$(open-preview)",
        "category": "sokonanoda"
      },
      {
        "command": "sokonanoda.doctor",
        "title": "doctor: 诊断服务器与版本",
        "icon": "$(heart)",
        "category": "sokonanoda"
      },
      {
        "command": "sokonanoda.project.refresh",
        "title": "sokonanoda: refresh project view",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "sokonanoda",
          "title": "sokonanoda",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "sokonanoda.goals",
          "name": "练习",
          "when": "resourceLangId == sokonanoda"
        },
        {
          "id": "sokonanoda.courseMap",
          "name": "课程",
          "when": "resourceLangId == sokonanoda"
        },
        {
          "id": "sokonanoda.project",
          "name": "项目",
          "when": "resourceLangId == sokonanoda"
        }
      ],
      "sokonanoda": [
        {
          "id": "sokonanoda.infoview",
          "name": "目标面板 (Infoview)",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sokonanoda.status",
          "when": "false"
        },
        {
          "command": "sokonanoda.revealRange",
          "when": "false"
        },
        {
          "command": "sokonanoda.goals.refresh",
          "when": "false"
        },
        {
          "command": "sokonanoda.courseRefresh",
          "when": "false"
        },
        {
          "command": "sokonanoda.project.refresh",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sokonanoda.goals.refresh",
          "group": "navigation",
          "when": "view == sokonanoda.goals"
        },
        {
          "command": "sokonanoda.nextHole",
          "group": "navigation",
          "when": "view == sokonanoda.goals"
        },
        {
          "command": "sokonanoda.openInfoview",
          "group": "navigation",
          "when": "view == sokonanoda.goals"
        },
        {
          "command": "sokonanoda.courseRefresh",
          "group": "navigation",
          "when": "view == sokonanoda.courseMap"
        },
        {
          "command": "sokonanoda.project.refresh",
          "group": "navigation",
          "when": "view == sokonanoda.project"
        }
      ]
    },
    "configuration": {
      "title": "sokonanoda",
      "properties": {
        "sokonanoda.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a custom `sokonanoda-lsp` server binary. **Ignored unless `sokonanoda.serverOverride` is enabled** — by default the extension always uses its own bundled server so a stale build cannot override it. Ignored in restricted (untrusted) workspaces."
        },
        "sokonanoda.serverOverride": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use an explicitly configured server instead of the bundled one. When off (default), the server shipped inside this extension always wins: `sokonanoda.serverPath`, the `SOKONANODA_LSP_BIN` environment variable and workspace `target/{debug,release}` builds are ignored (a one-time notice explains this). Turn it on only when developing the compiler locally; it restores the order `serverPath → SOKONANODA_LSP_BIN → bundled → workspace target → download cache`. Ignored in restricted (untrusted) workspaces."
        },
        "sokonanoda.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the 'sokonanoda' output channel (for debugging)."
        }
      }
    },
    "configurationDefaults": {
      "[sokonanoda]": {
        "editor.unicodeHighlight.ambiguousCharacters": false
      }
    },
    "keybindings": [
      {
        "command": "sokonanoda.showStatus",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.nextHole",
        "key": "alt+n",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.previousHole",
        "key": "alt+shift+n",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "echo ok",
    "clean:lsp": "node -e \"require('fs').rmSync('bin',{recursive:true,force:true})\"",
    "stage:lsp": "node scripts/stage-lsp.js",
    "package": "vsce package --out sokonanoda.vsix",
    "package:host": "node scripts/stage-lsp.js --package",
    "package:universal": "npm run clean:lsp && vsce package --out sokonanoda-universal.vsix",
    "test:unit": "node test-server.js && node test-download.js && node test-webview.js && node test-extension-host.js",
    "test": "vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.106.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2"
  },
  "keywords": [
    "lean",
    "theorem prover",
    "proof assistant",
    "teaching",
    "tutor",
    "LSP",
    "dependently typed"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "icon": "icon.png"
}
