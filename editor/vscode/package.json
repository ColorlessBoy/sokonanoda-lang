{
  "name": "sokonanoda",
  "displayName": "sokonanoda language support",
  "description": "Learn theorem proving in a self-contained Lean-4-style language: real kernel grading, an Infoview goal panel, graded exercises, and agent skills that turn an LLM into your proof teacher. Zero setup - the language server ships inside the extension.",
  "version": "0.68.0",
  "publisher": "sokonanoda-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColorlessBoy/sokonanoda-lang"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:sokonanoda",
    "onView:sokonanoda.infoview"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In restricted mode the workspace-level sokonanoda.serverPath and sokonanoda.serverOverride settings are ignored and the bundled server is always used.",
      "restrictedConfigurations": [
        "sokonanoda.serverPath",
        "sokonanoda.serverOverride"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "sokonanoda",
        "aliases": [
          "sokonanoda",
          "sokonanoda lesson"
        ],
        "extensions": [
          ".sokonanoda"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sokonanoda",
        "scopeName": "source.sokonanoda",
        "path": "./syntaxes/sokonanoda.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sokonanoda.showStatus",
        "title": "Show Exercise Status (练习状态)",
        "icon": "$(checklist)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.status",
        "title": "Show Declaration Status (声明状态)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.nextHole",
        "title": "Next Hole (下一个洞)",
        "icon": "$(arrow-down)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.previousHole",
        "title": "Previous Hole (上一个洞)",
        "icon": "$(arrow-up)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.goals.refresh",
        "title": "Refresh Exercise Panel (刷新练习面板)",
        "icon": "$(refresh)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.courseRefresh",
        "title": "Refresh Course Map (刷新课程地图)",
        "icon": "$(refresh)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.revealRange",
        "title": "Reveal Range (跳到该范围)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.revealHint",
        "title": "Reveal Hint (揭示下一条提示)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.restartServer",
        "title": "Restart Server (重启服务器)",
        "icon": "$(debug-restart)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.openInfoview",
        "title": "Infoview (目标面板)",
        "icon": "$(open-preview)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.doctor",
        "title": "Doctor (诊断服务器与版本)",
        "icon": "$(heart)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.build",
        "title": "Build (编译当前文件/工作区，预热缓存)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.rebuild",
        "title": "Rebuild (清空编译缓存后重编译)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.project.refresh",
        "title": "Refresh Project View (刷新项目视图)",
        "icon": "$(refresh)",
        "category": "Sokonanoda"
      },
      {
        "command": "sokonanoda.input.replaceAbbreviation",
        "title": "Replace Notation Abbreviation (替换记法缩写：\\and → ∧)",
        "category": "Sokonanoda"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "sokonanoda",
          "title": "sokonanoda",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "sokonanoda.goals",
          "name": "练习",
          "when": "resourceLangId == sokonanoda"
        },
        {
          "id": "sokonanoda.courseMap",
          "name": "课程",
          "when": "resourceLangId == sokonanoda"
        },
        {
          "id": "sokonanoda.project",
          "name": "项目",
          "when": "resourceLangId == sokonanoda"
        }
      ],
      "sokonanoda": [
        {
          "id": "sokonanoda.infoview",
          "name": "目标面板 (Infoview)",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sokonanoda.status",
          "when": "false"
        },
        {
          "command": "sokonanoda.revealRange",
          "when": "false"
        },
        {
          "command": "sokonanoda.goals.refresh",
          "when": "false"
        },
        {
          "command": "sokonanoda.courseRefresh",
          "when": "false"
        },
        {
          "command": "sokonanoda.project.refresh",
          "when": "false"
        },
        {
          "command": "sokonanoda.input.replaceAbbreviation",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sokonanoda.goals.refresh",
          "group": "navigation",
          "when": "view == sokonanoda.goals"
        },
        {
          "command": "sokonanoda.nextHole",
          "group": "navigation",
          "when": "view == sokonanoda.goals"
        },
        {
          "command": "sokonanoda.openInfoview",
          "group": "navigation",
          "when": "view == sokonanoda.goals"
        },
        {
          "command": "sokonanoda.courseRefresh",
          "group": "navigation",
          "when": "view == sokonanoda.courseMap"
        },
        {
          "command": "sokonanoda.project.refresh",
          "group": "navigation",
          "when": "view == sokonanoda.project"
        },
        {
          "command": "sokonanoda.build",
          "when": "view == sokonanoda.project",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "sokonanoda",
      "properties": {
        "sokonanoda.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a custom `sokonanoda-lsp` server binary. **Ignored unless `sokonanoda.serverOverride` is enabled** — by default the extension always uses its own bundled server so a stale build cannot override it. Ignored in restricted (untrusted) workspaces."
        },
        "sokonanoda.serverOverride": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use an explicitly configured server instead of the bundled one. When off (default), the server shipped inside this extension always wins: `sokonanoda.serverPath`, the `SOKONANODA_LSP_BIN` environment variable and workspace `target/{debug,release}` builds are ignored (a one-time notice explains this). Turn it on only when developing the compiler locally; it restores the order `serverPath → SOKONANODA_LSP_BIN → bundled → workspace target → download cache`. Ignored in restricted (untrusted) workspaces."
        },
        "sokonanoda.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the 'sokonanoda' output channel (for debugging)."
        },
        "sokonanoda.warmCacheOnOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "打开工作区时后台跑一次 `sokonanoda build <项目根>`，**预热编译缓存**，让随后第一次打开某个单元直接命中（T-A52）。\n\n**默认关**：它会占 CPU/IO，而「打开编辑器」本身会因此变慢——那正是另一面的抱怨。打开后状态栏不会提示，进度在输出面板 `sokonanoda build` 里；跑失败只是没预热，用 `sokonanoda: doctor` 查。"
        },
        "sokonanoda.input.eager": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Replace a notation abbreviation **as soon as the word is complete** (`\\and` → `∧`), instead of waiting for `Tab`. While you keep typing letters a prefix waits (`\\an` waits for `\\and`, `\\in` waits for `\\inter`); a separator (space/punctuation) closes the word and finishes it (`\\in ` → `∈ `, `\\sub ` → `⊆ `). A lone `\\` (set difference) is never touched. Off by default: `Tab` is the explicit, undo-friendly path. Hover any notation symbol to see its abbreviation."
        }
      }
    },
    "configurationDefaults": {
      "[sokonanoda]": {
        "editor.unicodeHighlight.ambiguousCharacters": false
      }
    },
    "keybindings": [
      {
        "command": "sokonanoda.showStatus",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.nextHole",
        "key": "alt+n",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.previousHole",
        "key": "alt+shift+n",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.build",
        "key": "alt+b",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.rebuild",
        "key": "alt+shift+b",
        "when": "editorTextFocus && editorLangId == sokonanoda"
      },
      {
        "command": "sokonanoda.input.replaceAbbreviation",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == sokonanoda && sokonanoda.input.abbreviationBeforeCursor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "echo ok",
    "clean:lsp": "node -e \"require('fs').rmSync('bin',{recursive:true,force:true})\"",
    "stage:lsp": "node scripts/stage-lsp.js",
    "package": "vsce package --out sokonanoda.vsix",
    "package:host": "node scripts/stage-lsp.js --package",
    "package:universal": "npm run clean:lsp && vsce package --out sokonanoda-universal.vsix",
    "test:unit": "node test-server.js && node test-download.js && node test-webview.js && node test-extension-host.js",
    "test": "vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.106.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2"
  },
  "keywords": [
    "lean",
    "theorem prover",
    "proof assistant",
    "teaching",
    "tutor",
    "LSP",
    "dependently typed"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "icon": "icon.png"
}
