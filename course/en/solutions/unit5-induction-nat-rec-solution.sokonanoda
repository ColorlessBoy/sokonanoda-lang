-- unit5-induction-nat-rec-solution.sokonanoda — Unit 5 answer key (agent only)
--
-- The solved twin of course/unit5-induction-nat-rec.sokonanoda: every sorry is
-- filled with a kernel-verified answer. Do not hand this directly to a learner.
-- ==========================================================================

-- The explicit inductive block, as on the canvas — it replaces the prelude Nat
-- for the whole file:
inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) -> Sort u) ->
  (mz : motive zero) ->
  (ms : (n : Nat) -> motive n -> motive (succ n)) ->
  (n : Nat) -> motive n
iota zero :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- Demo (same as the canvas): numbers built from constructors.
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two

-- Self-test: #reduce walks the iota rules — succ two is 3.
#reduce succ two

-- Exercise 1: four = succ three (one more layer on top of three).
def four : Nat := succ three

-- Exercise 2: double — zero maps to zero; at succ k, build succ (succ ih) from ih.
def double : Nat -> Nat :=
  fun (n : Nat) =>
    Nat.rec.{1} (fun (x : Nat) => Nat) zero
      (fun (k : Nat) => fun (ih : Nat) => succ (succ ih)) n

-- Exercise 3: add — the induction variable is m; return n at zero, and build
-- succ ih from ih at succ k.
def add : Nat -> Nat -> Nat :=
  fun (m : Nat) => fun (n : Nat) =>
    Nat.rec.{1} (fun (x : Nat) => Nat) n
      (fun (k : Nat) => fun (ih : Nat) => succ ih) m

-- Wrap-up (kernel re-check): add two two is four succs; iota counts for you.
#reduce add two two

-- Extra internal self-checks:
#reduce four
#reduce double two
#reduce add two three

-- ─────────────────────────────────────────────────────────────
-- `match`: the non-recursive enum Color, the swap demo, and the answers to
-- Exercises 4 and 5.
-- ─────────────────────────────────────────────────────────────

inductive Color : Type
ctor red : Color
ctor green : Color
rec Color.rec {u} :
  (motive : (c : Color) -> Sort u) ->
  (mr : motive red) ->
  (mg : motive green) ->
  (c : Color) -> motive c
iota red :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mr
iota green :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mg
end

-- Demo (same as the canvas): swap exchanges red and green.
def swap (c : Color) : Color := match c with
| red => green
| green => red

-- Self-test: #reduce walks the Color.rec that match lowers to — swap red is green.
#reduce swap red

-- Exercise 4: the identity map.
def relabel (c : Color) : Color := match c with
| red => red
| green => green

-- Exercise 5: put red in the green arm.
def swapOpen (c : Color) : Color := match c with
| red => green
| green => red

-- Extra internal self-checks:
#reduce relabel green
#reduce swapOpen green

-- ─────────────────────────────────────────────────────────────
-- `match` + recursion (IH): the addM demo and the answer to Exercise 6.
-- ─────────────────────────────────────────────────────────────

-- Demo (same as the canvas): addM's succ arm uses the auto-inserted IH `ih`.
def addM (a b : Nat) : Nat := match a with
| zero => b
| succ m => succ ih

-- Self-test: #reduce walks the Nat.rec that match lowers to — addM two three
-- is five succs.
#reduce addM two three

-- Exercise 6: recDouble builds succ (succ ih) from ih in the succ arm.
def recDouble (n : Nat) : Nat := match n with
| zero => zero
| succ m => succ (succ ih)

-- Extra internal self-checks:
#reduce recDouble two

-- ─────────────────────────────────────────────────────────────
-- Parameterized inductives: Option (A : Type), the fromOption demo, and the
-- answer to Exercise 7.
-- ─────────────────────────────────────────────────────────────

inductive Option (A : Type) : Type
ctor none : Option A
ctor some (a : A) : Option A
end

-- Demo (same as the canvas): fromOption takes a default and extracts.
def fromOption (x : Option Nat) (d : Nat) : Nat := match x with
| none => d
| some a => a

-- Self-test: #reduce walks the Option.rec that match lowers to — the some
-- arm is just the number inside.
#reduce fromOption (some Nat (succ zero)) zero

-- Exercise 7: the some arm hands back the substituted field a directly.
def valueOrZero (x : Option Nat) : Nat := match x with
| none => zero
| some a => a

-- Extra internal self-checks:
#reduce valueOrZero (some Nat (succ zero))
#reduce valueOrZero (none Nat)
theorem nat_induction (P : Nat -> Prop) (hz : P zero)
    (hs : (k : Nat) -> P k -> P (succ k)) (n : Nat) : P n :=
  match n with
  | zero => hz
  | succ k => hs k ih

theorem nat_induction_open (P : Nat -> Prop) (hz : P zero)
    (hs : (k : Nat) -> P k -> P (succ k)) (n : Nat) : P n :=
  match n with
  | zero => hz
  | succ k => hs k ih

-- Nested patterns and wildcards (mirrors the canvas tail):
def isZeroOpt (x : Option Nat) : Nat := match x with
| some zero => succ zero
| some _ => zero
| none => zero

def predOpt (x : Option Nat) : Nat := match x with
| some zero => zero
| some (succ k) => k
| none => zero

#reduce isZeroOpt (some Nat zero)
#reduce predOpt (some Nat (succ (succ zero)))
