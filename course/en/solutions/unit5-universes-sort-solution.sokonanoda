-- unit5-universes-sort-solution.sokonanoda — Unit 5 answer key (agent only)
#check Nat
#check (Nat → Nat)
#check Prop
#check (Type 0)
#check (Type 1)

def function_type_universe : Sort 1 := Nat → Nat

def type0_universe : Sort 2 := Type 0

example : Sort 1 := Nat

example : Sort 0 := (1 + 1) = 2

theorem Eq.symm {u} : {α : Sort u} → (a : α) → (b : α) → Eq.{u} α a b → Eq.{u} α b a := by -- soko:notation-ok: α : Sort u is polymorphic, so the `=` notation cannot solve the universe level u (engine boundary)
  intro α a b h
  exact Eq.subst.{u} α (fun (x : α) => Eq.{u} α x a) a b h (Eq.refl.{u} α a) -- soko:notation-ok: same as above (engine boundary)

def predict_then_prove : ((fun (x : Nat) => x + 1) 41) = 42 := by
  exact Eq.refl.{1} Nat 42

#reduce (fun (x : Nat) => x + 1) 41