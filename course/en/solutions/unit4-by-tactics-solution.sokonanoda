-- unit4-by-tactics-solution —— Unit 4 solution key (agent-only)
axiom True : Prop
axiom True.intro : True
axiom False : Prop

theorem demo_by_assumption : (a : Prop) → a → a := by
  intro a
  intro h
  assumption

theorem demo_by_apply : True ∨ False := by
  apply Or.inl
  exact True.intro

theorem demo_by_rfl : (1 + 1) = 2 := by rfl

theorem demo_by_have : (a : Prop) → a → a ∧ a := by
  intro a
  intro ha
  have h : a := ha
  exact And.intro h h

theorem demo_by_constructor : (a : Prop) → (b : Prop) → a → b → a ∧ b := by
  intro a
  intro b
  intro ha
  intro hb
  constructor
  exact ha
  exact hb

theorem demo_by_cases : (a : Prop) → (b : Prop) → a ∨ b → b ∨ a := by
  intro a
  intro b
  intro h
  cases h with
  | inl ha =>
      right
      exact ha
  | inr hb =>
      left
      exact hb

theorem by_ex1 : (a : Prop) → a → a := by
  intro a
  intro h
  assumption

theorem by_ex2 : (a : Prop) → (b : Prop) → a ∧ b → a := by
  intro a
  intro b
  intro h
  exact And.left h

theorem by_ex3 : (a : Prop) → (b : Prop) → a → a ∨ b := by
  intro a
  intro b
  intro ha
  apply Or.inl
  exact ha

theorem by_ex4 : (a : Prop) → (b : Prop) → a → b → a ∧ b := by
  intro a
  intro b
  intro ha
  intro hb
  apply And.intro
  exact ha
  exact hb

theorem by_ex5 : (a : Prop) → (b : Prop) → (a → b) → a → b ∧ a := by
  intro a
  intro b
  intro f
  intro ha
  have hb : b := f ha
  exact And.intro hb ha

theorem by_ex6 : (a : Prop) → (b : Prop) → a ∧ b → b ∧ a := by
  intro a
  intro b
  intro h
  exact And.intro (And.right h) (And.left h)
