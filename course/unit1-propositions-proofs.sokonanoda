-- ==========================================================================
-- unit1-propositions-proofs.sokonanoda —— 单元① 命题与证明项
--
-- 逻辑先行：不谈宇宙、不谈 Sort，先直接证明命题。
-- 规则：
--   * 带 sorry 的声明是练习。把 sorry 换成你的答案，由完整内核判定对错。
--   * 部分作答是合法状态：先写前几层 fun，最后一层留 sorry。
--   * 判定永远走内核：填完的每一行放回官方 Lean 也合法。
-- ==========================================================================

-- ─────────────────────────────────────────────────────────────
-- Prop 是“命题的世界”：True、a ∧ b 这些都是命题。
-- 证明就是项：一个类型为 P 的项，就是命题 P 的一个证明。
-- 下面四条用 axiom 写，是为了让你看清**公理**长什么样：只给名字和类型，
-- 不给值。至于 ∧ ∨ 这些连接符和它们的构造子（And.intro、And.left、
-- And.right、Or.inl、Or.inr），prelude 自带——那是官方 Lean core 一级
-- 的东西，不用自己造。
-- ─────────────────────────────────────────────────────────────

axiom True : Prop
axiom True.intro : True
axiom False : Prop
axiom False.rec : (P : Prop) → False → P

-- Not 不是公理，是定义：¬ a 展开后就是 a → False。
def Not : Prop → Prop := fun (a : Prop) => a → False

-- 自测：#reduce 会展开定义 —— ¬ True 就是 True → False。
#reduce ¬ True

-- 演示（已写好）：构造子当函数用，参数按顺序全部给全。
example : True ∨ False := Or.inl True.intro

-- ─────────────────────────────────────────────────────────────
-- 类型里的箭头对应值里的 fun：写证明 = 写一串 fun + 最后一个构造子调用。
-- ─────────────────────────────────────────────────────────────

-- 练习 1（第一个“证明”）：True 的证明项已经存在，把它叫出来即可。
-- soko:hint 思路：证明就是一个项——类型为 True 的项，就是 True 的证明。
-- soko:hint 目标形态：目标 True 没有箭头可拆，直接问自己：环境里谁能造出 True？
-- soko:hint 关键件：True.intro——True 的构造子，不需要任何参数。
theorem true_is_true : True := by sorry

-- 练习 2：假设 a、b 都成立，就能得到 a ∧ b。
-- 提示：四层箭头就是四层 fun；目标是 And 形状，最后一步选对应的构造子。
-- soko:hint 思路：类型里的箭头对应值里的 fun——写证明就是一串 fun 加最后一步构造。
-- soko:hint 目标形态：最外层是四个箭头：先写 fun (a : Prop) =>，每写一层就看剩余目标。
-- soko:hint 关键件：当剩余目标形如 a ∧ b 时，用 And.intro 这个构造子——它需要 a、b 与两份证明，四样都在上下文里。
theorem and_intro_rule : (a : Prop) → (b : Prop) → a → b → a ∧ b := by sorry

-- 练习 3：先用 And.left/And.right 把 h 拆开，再用 And.intro 装回去（换序）。
-- soko:hint 思路：先把拿到的 a ∧ b 拆开，再按新顺序装回去——先消去，再构造。
-- soko:hint 目标形态：三层箭头：fun (a : Prop) => fun (b : Prop) => fun (h : a ∧ b) => …，最后要造出 b ∧ a。
-- soko:hint 关键件：目标形如 b ∧ a、上下文有 h : a ∧ b：用 And.left / And.right 取出两半，再用 And.intro 按相反顺序装回。
theorem and_swap : (a : Prop) → (b : Prop) → a ∧ b → b ∧ a := by sorry

-- 练习 4：False 没有证明（没有构造子），但可以“用”它：从矛盾推出任何 P。
-- soko:hint 思路：False 证不出来（没有构造子），但可以“被使用”——从矛盾推出任何命题。
-- soko:hint 目标形态：两层箭头：先 fun (P : Prop) =>，再吃掉 h : False，剩余目标是任意的 P。
-- soko:hint 关键件：False.rec——它吃一个目标命题和一份 False 的证明，吐出那个命题的证明。
theorem ex_falso : (P : Prop) → False → P := by sorry

-- 练习 5（挑战 ★）：a ∧ (¬ a) 是自相矛盾的组合——拆开它，从矛盾得到 False。
-- soko:hint 思路：And 把 a 和 ¬ a 打包在一起；¬ a 展开后是 a → False——一个“吃 a”的函数。
-- soko:hint 目标形态：两层 fun 拿到 a 和 h : a ∧ (¬ a) 之后，目标就是 False 本身。
-- soko:hint 关键件：目标形如 False、上下文有 h : a ∧ (¬ a)：用 And.right 取 ¬ a、And.left 取 a，再把前者当函数作用到后者上。
theorem and_not_absurd : (a : Prop) → a ∧ ¬ a → False := by sorry

-- ─────────────────────────────────────────────────────────────
-- 补充：声明级 binder——把 fun 的活交给声明行
--
-- 官方 Lean 更常用的拼写是把 binder 直接写在名字和冒号之间：
--
--   theorem and_swap2 (a : Prop) (b : Prop) (h : a ∧ b) : b ∧ a := …
--
-- 它和箭头写法是同一件事：类型 = 一串箭头，值 = 自动包好一层层 fun。
-- 区别在写证明的时候——binder 已经在你手边，不用再写 fun（也不用 intro）。
--
-- 演示：下面这条声明与练习 3 的 and_swap 是同一道题，只是换了拼写；
-- 内核判定完全一样，可以对照着看。
theorem demo_binders (a : Prop) (b : Prop) (h : a ∧ b) : b ∧ a :=
  And.intro (And.right h) (And.left h)

-- 练习 6：用声明级 binder 再证一遍 and_intro_rule（这一次不用写 fun）。
-- soko:hint 思路：四样东西 a、b、ha、hb 都已经在上下文里；直接装出 a ∧ b。
-- soko:hint 目标形态：目标就是 a ∧ b，没有箭头要拆——不要再写 fun。
-- soko:hint 关键件：目标就是 a ∧ b，而 a、b、ha、hb 四样都已在上下文里：用 And.intro 构造子一步装出。
theorem and_intro_rule2 (a : Prop) (b : Prop) (ha : a) (hb : b) : a ∧ b := by sorry
