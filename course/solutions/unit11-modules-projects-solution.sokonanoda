-- unit11-modules-projects-solution —— 单元⑪ 解答钥匙（agent 专用；画布不 import 它）
-- And / Or 来自 prelude，Iff 是下面的 def——与画布逐字同形。
def Iff (A : Prop) (B : Prop) : Prop := (A → B) ∧ (B → A)

theorem and_comm (A : Prop) (B : Prop) (h : A ∧ B) : B ∧ A := by
  exact And.intro (And.right h) (And.left h)

theorem and_comm_imp_x (A : Prop) (B : Prop) : A ∧ B → B ∧ A := by
  intro h
  exact And.intro (And.right h) (And.left h)

def and_left_x (A : Prop) (B : Prop) (h : A ∧ B) : A := by
  exact And.left h

theorem or_comm_x (A : Prop) (B : Prop) : A ∨ B → B ∨ A := by
  intro h
  cases h with
  | inl a =>
      right
      exact a
  | inr b =>
      left
      exact b

example (A : Prop) (B : Prop) (mp : A → B) (mpr : B → A) : A ↔ B := by
  exact And.intro mp mpr

theorem and_comm_via_lib_x (A : Prop) (B : Prop) (h : A ∧ B) : B ∧ A := by
  exact and_comm A B h

theorem and_or_imp_x (A : Prop) (B : Prop) (C : Prop) : A ∧ (B ∨ C) → (A ∧ B) ∨ (A ∧ C) := by
  intro h
  have bc : B ∨ C := And.right h
  cases bc with
  | inl b =>
      left
      exact And.intro (And.left h) b
  | inr c =>
      right
      exact And.intro (And.left h) c
