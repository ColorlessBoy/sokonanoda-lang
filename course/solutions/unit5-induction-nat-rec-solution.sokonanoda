-- ==========================================================================
-- unit5-induction-nat-rec-solution.sokonanoda —— 单元⑤ 解答钥匙（agent 专用）
--
-- 与学习者画布 course/unit5-induction-nat-rec.sokonanoda 一一对应，
-- 所有 sorry 已填入经完整内核验证的答案。勿直接发给学习者。
-- ==========================================================================

-- 显式 inductive 块（与画布一致，取代整个文件里的 prelude Nat）：
inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) -> Sort u) ->
  (mz : motive zero) ->
  (ms : (n : Nat) -> motive n -> motive (succ n)) ->
  (n : Nat) -> motive n
iota zero :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- 演示（与画布一致）：数字用构造子搭出来。
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two

-- 自测：#reduce 走 iota 规则 —— succ two 是 3。
#reduce succ two

-- 练习 1：four = succ three（在 three 之上再叠一层）。
def four : Nat := succ three

-- 练习 2：double：zero 处返回 zero；succ k 处用 ih 造 succ (succ ih)。
def double : Nat -> Nat :=
  fun (n : Nat) =>
    Nat.rec.{1} (fun (x : Nat) => Nat) zero
      (fun (k : Nat) => fun (ih : Nat) => succ (succ ih)) n

-- 练习 3：add：归纳变量是 m，zero 处返回 n，succ k 处用 ih 造 succ ih。
def add : Nat -> Nat -> Nat :=
  fun (m : Nat) => fun (n : Nat) =>
    Nat.rec.{1} (fun (x : Nat) => Nat) n
      (fun (k : Nat) => fun (ih : Nat) => succ ih) m

-- 收尾（内核回判）：add two two 就是四层 succ，iota 在替你数数。
#reduce add two two

-- 额外自测（钥匙内部核对）：
#reduce four
#reduce double two
#reduce add two three

-- ─────────────────────────────────────────────────────────────
-- `match` 分情况：非递归枚举 Color + 演示 swap + 练习 4/5 的答案。
-- ─────────────────────────────────────────────────────────────

inductive Color : Type
ctor red : Color
ctor green : Color
rec Color.rec {u} :
  (motive : (c : Color) -> Sort u) ->
  (mr : motive red) ->
  (mg : motive green) ->
  (c : Color) -> motive c
iota red :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mr
iota green :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mg
end

-- 演示（与画布一致）：swap 对调 red/green。
def swap (c : Color) : Color := match c with
| red => green
| green => red

-- 自测：#reduce 走 match 降低出的 Color.rec —— swap red 就是 green。
#reduce swap red

-- 练习 4：恒等映射。
def relabel (c : Color) : Color := match c with
| red => red
| green => green

-- 练习 5：green 分支填 red。
def swapOpen (c : Color) : Color := match c with
| red => green
| green => red

-- 额外自测（钥匙内部核对）：
#reduce relabel green
#reduce swapOpen green

-- ─────────────────────────────────────────────────────────────
-- `match` + 递归（IH）：演示 addM + 练习 6 的答案。
-- ─────────────────────────────────────────────────────────────

-- 演示（与画布一致）：addM 在 succ 分支直接用自动插入的归纳假设 ih。
def addM (a b : Nat) : Nat := match a with
| zero => b
| succ m => succ ih

-- 自测：#reduce 走 match 降低出的 Nat.rec —— addM two three 是五层 succ。
#reduce addM two three

-- 练习 6：recDouble 在 succ 分支用 ih 造出 succ (succ ih)。
def recDouble (n : Nat) : Nat := match n with
| zero => zero
| succ m => succ (succ ih)

-- 额外自测（钥匙内部核对）：
#reduce recDouble two
