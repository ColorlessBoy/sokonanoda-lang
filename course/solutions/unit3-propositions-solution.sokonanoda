-- ==========================================================================
-- unit3-propositions-solution.sokonanoda —— 单元③ 解答钥匙（agent 专用）
--
-- 与学习者画布 course/unit3-propositions.sokonanoda 一一对应，
-- 所有 ??? 已填入经完整内核验证的答案。勿直接发给学习者。
-- ==========================================================================

axiom True : Prop
axiom True.intro : True
axiom False : Prop
axiom False.rec : (P : Prop) -> False -> P
axiom And : Prop -> Prop -> Prop
axiom And.intro : (a : Prop) -> (b : Prop) -> a -> b -> And a b
axiom And.left : (a : Prop) -> (b : Prop) -> And a b -> a
axiom And.right : (a : Prop) -> (b : Prop) -> And a b -> b
axiom Or : Prop -> Prop -> Prop
axiom Or.inl : (a : Prop) -> (b : Prop) -> a -> Or a b
axiom Or.inr : (a : Prop) -> (b : Prop) -> b -> Or a b

-- Not 不是公理，是定义：Not a 展开后就是 a -> False。
def Not : Prop -> Prop := fun (a : Prop) => a -> False

-- 自测：#reduce 会展开定义 —— Not True 就是 True -> False。
#reduce Not True

-- 演示（与画布一致）：构造子当函数用，参数按顺序全部给全。
example : Or True False := Or.inl True False True.intro

-- 练习 1：True.intro 已经存在，叫出来即可。
theorem true_is_true : True := True.intro

-- 练习 2：四层 fun，最后 And.intro a b ha hb —— 类型箭头与值 fun 一一对应。
theorem and_intro_rule : (a : Prop) -> (b : Prop) -> a -> b -> And a b :=
  fun (a : Prop) => fun (b : Prop) =>
    fun (ha : a) => fun (hb : b) => And.intro a b ha hb

-- 练习 3：先用 And.left/And.right 拆开 h，再用 And.intro 换序装回去。
theorem and_swap : (a : Prop) -> (b : Prop) -> And a b -> And b a :=
  fun (a : Prop) => fun (b : Prop) => fun (h : And a b) =>
    And.intro b a (And.right a b h) (And.left a b h)

-- 练习 4：False 只能“用”不能“证”：False.rec 直接从矛盾造出任何 P 的证明。
theorem ex_falso : (P : Prop) -> False -> P :=
  fun (P : Prop) => fun (h : False) => False.rec P h

-- 练习 5：把 Not a 那一半（h 的右半）当作 a -> False 的函数，
-- 应用到另一半（h 的左半，类型 a）上，得到 False。
theorem and_not_absurd : (a : Prop) -> And a (Not a) -> False :=
  fun (a : Prop) => fun (h : And a (Not a)) =>
    And.right a (Not a) h (And.left a (Not a) h)

-- 练习 6：有 a 就有 Or a b —— Or.inl a b ha。
theorem or_intro_left : (a : Prop) -> (b : Prop) -> a -> Or a b :=
  fun (a : Prop) => fun (b : Prop) => fun (ha : a) => Or.inl a b ha

-- 额外自测（钥匙内部核对）：内核逐个回判这些证明项。
#reduce true_is_true
#reduce and_intro_rule True True True.intro True.intro
#reduce or_intro_left True False True.intro
