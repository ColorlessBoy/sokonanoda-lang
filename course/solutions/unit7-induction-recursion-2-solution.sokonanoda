-- 自带的 Nat 归纳块（与画布一致，保证本文件独立可编译）。
inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) → Sort u) →
  (mz : motive zero) →
  (ms : (n : Nat) → motive n → motive (succ n)) →
  (n : Nat) → motive n
iota zero :=
  fun (motive : (n : Nat) → Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) → motive n → motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) → Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) → motive n → motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- ─────────────────────────────────────────────────────────────
-- 参数化归纳：Option (A : Type) + 演示 fromOption + 练习 1 的答案。
-- ─────────────────────────────────────────────────────────────

inductive Option (A : Type) : Type
ctor none : Option A
ctor some (a : A) : Option A
end

-- 演示（与画布一致）：fromOption 接默认值后取出。
def fromOption (x : Option Nat) (d : Nat) : Nat := match x with
| none => d
| some a => a

-- 自测：#reduce 走 match 降低出的 Option.rec —— some 那支就是里面的数。
#reduce fromOption (some Nat (succ zero)) zero

-- 练习 1：some 分支直接交出代入后的字段 a。
def valueOrZero (x : Option Nat) : Nat := match x with
| none => zero
| some a => a

-- 额外自测（钥匙内部核对）：
#reduce valueOrZero (some Nat (succ zero))
#reduce valueOrZero (none Nat)

-- ─────────────────────────────────────────────────────────────
-- 依赖 match（归纳法）：演示 nat_induction + 练习 2 的答案。
-- ─────────────────────────────────────────────────────────────

theorem nat_induction (P : Nat → Prop) (hz : P zero)
    (hs : (k : Nat) → P k → P (succ k)) (n : Nat) : P n := by
  exact match n with
  | zero => hz
  | succ k => hs k ih

-- 练习 2：succ 支把 ih 交给 hs。
theorem nat_induction_open (P : Nat → Prop) (hz : P zero)
    (hs : (k : Nat) → P k → P (succ k)) (n : Nat) : P n := by
  exact match n with
  | zero => hz
  | succ k => hs k ih

-- ─────────────────────────────────────────────────────────────
-- 嵌套模式与通配：演示 isZeroOpt + 练习 3 的答案。
-- ─────────────────────────────────────────────────────────────

def isZeroOpt (x : Option Nat) : Nat := match x with
| some zero => succ zero
| some _ => zero
| none => zero

-- 练习 3：succ 那一支交出字段 k。
def predOpt (x : Option Nat) : Nat := match x with
| some zero => zero
| some (succ k) => k
| none => zero

-- 额外自测（钥匙内部核对）：
#reduce isZeroOpt (some Nat zero)
#reduce predOpt (some Nat (succ (succ zero)))

-- ─────────────────────────────────────────────────────────────
-- 带索引归纳：演示 vlen + 练习 4 的答案。
-- ─────────────────────────────────────────────────────────────

inductive Vec (A : Type) : Nat → Type
ctor vnil : Vec A zero
ctor vcons (a : A) (n : Nat) (v : Vec A n) : Vec A (succ n)
end

def vlen (A : Type) (n : Nat) (v : Vec A n) : Nat := match v with
| vnil => zero
| vcons a m w => succ ih

-- 练习 4：vcons 把头部绑成 a，直接交出去。
def vhead (A : Type) (d : A) (n : Nat) (v : Vec A n) : A := match v with
| vnil => d
| vcons a m w => a

-- 额外自测（钥匙内部核对）：
#reduce vlen Nat (succ (succ zero)) (vcons Nat zero zero (vcons Nat (succ zero) zero (vnil Nat)))
