-- unit10-reading-proofs-solution —— 单元⑩ 解答钥匙（agent 专用）
axiom And : Prop -> Prop -> Prop
axiom And.intro : (a : Prop) -> (b : Prop) -> a -> b -> And a b
axiom And.left : (a : Prop) -> (b : Prop) -> And a b -> a
axiom And.right : (a : Prop) -> (b : Prop) -> And a b -> b

inductive Or (A B : Prop) : Prop
ctor inl (a : A) : Or A B
ctor inr (b : B) : Or A B
end

def Iff (A : Prop) (B : Prop) : Prop := And (A -> B) (B -> A)

theorem and_comm (A : Prop) (B : Prop) (h : And A B) : And B A :=
  And.intro B A (And.right A B h) (And.left A B h)

theorem or_intro_x (A : Prop) (B : Prop) (a : A) : Or A B :=
  inl A B a

theorem iff_intro_x (A : Prop) (B : Prop) (mp : A -> B) (mpr : B -> A) : Iff A B :=
  And.intro (A -> B) (B -> A) mp mpr

theorem nat_eq_self_x (n : Nat) : Eq.{1} Nat n n :=
  Eq.refl.{1} Nat n

theorem or_comm_fixed (A : Prop) (B : Prop) (h : Or A B) : Or B A :=
  match h with
  | inl a => inr B A a
  | inr b => inl B A b

theorem or_right_fixed (A : Prop) (B : Prop) (b : B) : Or A B :=
  inr A B b

theorem and_or_imp (A : Prop) (B : Prop) (C : Prop) : And A (Or B C) -> Or (And A B) (And A C) :=
  fun (h : And A (Or B C)) =>
    let bc : Or B C := And.right A (Or B C) h;
    match bc with
    | inl b => inl (And A B) (And A C) (And.intro A B (And.left A (Or B C) h) b)
    | inr c => inr (And A B) (And A C) (And.intro A C (And.left A (Or B C) h) c)
