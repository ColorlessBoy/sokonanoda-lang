-- unit10-reading-proofs-solution —— 单元⑩ 解答钥匙（agent 专用；画布不 import 它）
-- And / Or 来自 prelude，Iff 是下面的 def——与画布逐字同形。
def Iff (A : Prop) (B : Prop) : Prop := (A → B) ∧ (B → A)

theorem and_comm (A : Prop) (B : Prop) (h : A ∧ B) : B ∧ A := by
  exact And.intro (And.right h) (And.left h)

theorem or_intro_x (A : Prop) (B : Prop) (a : A) : A ∨ B := by
  left
  exact a

theorem iff_intro_x (A : Prop) (B : Prop) (mp : A → B) (mpr : B → A) : A ↔ B := by
  exact And.intro mp mpr

theorem nat_eq_self_x (n : Nat) : n = n := by
  rfl

theorem or_comm_fixed (A : Prop) (B : Prop) (h : A ∨ B) : B ∨ A := by
  cases h with
  | inl a =>
      right
      exact a
  | inr b =>
      left
      exact b

theorem or_right_fixed (A : Prop) (B : Prop) (b : B) : A ∨ B := by
  right
  exact b

theorem and_or_imp (A : Prop) (B : Prop) (C : Prop) : A ∧ (B ∨ C) → (A ∧ B) ∨ (A ∧ C) := by
  intro h
  have bc : B ∨ C := And.right h
  cases bc with
  | inl b =>
      left
      exact And.intro (And.left h) b
  | inr c =>
      right
      exact And.intro (And.left h) c
