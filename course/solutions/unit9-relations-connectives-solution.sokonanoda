-- unit9-relations-connectives-solution —— 单元⑨ 解答钥匙（agent 专用；画布不 import 它）
-- And / Or 来自 prelude，Iff 是下面的 def——与画布逐字同形。
def Iff (A : Prop) (B : Prop) : Prop := (A → B) ∧ (B → A)

theorem or_intro_demo (A : Prop) (B : Prop) (a : A) : A ∨ B := by
  exact Or.inl A B a

theorem or_comm (A : Prop) (B : Prop) (h : A ∨ B) : B ∨ A := by
  cases h with
  | inl a =>
      right
      exact a
  | inr b =>
      left
      exact b

theorem or_elim (A : Prop) (B : Prop) (C : Prop) (h : A ∨ B) (f : A → C) (g : B → C) : C := by
  cases h with
  | inl a =>
      exact f a
  | inr b =>
      exact g b

theorem or_id (A : Prop) (h : A ∨ A) : A := by
  cases h with
  | inl a =>
      exact a
  | inr a =>
      exact a

theorem iff_intro_demo (A : Prop) (B : Prop) (mp : A → B) (mpr : B → A) : A ↔ B := by
  exact And.intro (A → B) (B → A) mp mpr

theorem iff_mp (A : Prop) (B : Prop) (h : A ↔ B) : A → B := by
  exact And.left (A → B) (B → A) h

theorem iff_mpr (A : Prop) (B : Prop) (h : A ↔ B) : B → A := by
  exact And.right (A → B) (B → A) h

inductive Le : Nat → Nat → Prop
ctor le_refl (n : Nat) : Le n n
ctor le_succ (m : Nat) (n : Nat) : Le m n → Le m (Nat.succ n)
end

theorem le_succ_self (n : Nat) : Le n (Nat.succ n) := by
  exact le_succ n n (le_refl n)

theorem le_zero (n : Nat) : Le Nat.zero n := by
  exact match n with
    | Nat.zero => le_refl Nat.zero
    | Nat.succ k => le_succ Nat.zero k ih

theorem le_trans (m : Nat) (n : Nat) (k : Nat) (h1 : Le m n) (h2 : Le n k) : Le m k := by
  exact (Le.rec
    (fun (a : Nat) (b : Nat) (h : Le a b) => Le m a → Le m b)
    (fun (b : Nat) => fun (hx : Le m b) => hx)
    (fun (a : Nat) (b : Nat) (h : Le a b) (ih : Le m a → Le m b) =>
       fun (hx : Le m a) => le_succ m b (ih hx))
    n k h2) h1

inductive Even : Nat → Prop
ctor even_zero : Even Nat.zero
ctor even_succ (n : Nat) : Even n → Even (Nat.succ (Nat.succ n))
end

theorem even_two : Even (Nat.succ (Nat.succ Nat.zero)) := by
  exact even_succ Nat.zero even_zero

theorem even_plus_two (n : Nat) (h : Even n) : Even (Nat.succ (Nat.succ n)) := by
  exact Even.rec
    (fun (a : Nat) (x : Even a) => Even (Nat.succ (Nat.succ a)))
    (even_succ Nat.zero even_zero)
    (fun (a : Nat) (x : Even a) (ih : Even (Nat.succ (Nat.succ a))) => even_succ (Nat.succ (Nat.succ a)) ih)
    n h

theorem even_four : Even (Nat.succ (Nat.succ (Nat.succ (Nat.succ Nat.zero)))) := by
  exact even_succ (Nat.succ (Nat.succ Nat.zero)) even_two
