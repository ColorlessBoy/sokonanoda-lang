-- unit8-quantifiers-solution —— 单元⑧ 解答钥匙（agent 专用）
axiom True : Prop
axiom True.intro : True

axiom Person : Type 0
axiom someone : Person

theorem forall_demo (P : Person → Prop) : ∀ (x : Person), P x → P x := by
  intro x hx
  exact hx

example (P : Person → Prop) (h : ∀ (x : Person), P x) : (x : Person) → P x := h

#reduce (fun (x : Person) => x) someone

theorem forall_elim (P : Person → Prop) (w : Person) (h : ∀ (x : Person), P x) : P w := by
  exact h w

theorem forall_and (P : Person → Prop) (Q : Person → Prop)
    (h : ∀ (x : Person), P x ∧ Q x) :
    (∀ (x : Person), P x) ∧ (∀ (x : Person), Q x) := by
  apply And.intro
  intro x
  exact And.left (P x) (Q x) (h x)
  intro x
  exact And.right (P x) (Q x) (h x)

theorem and_forall (P : Person → Prop) (Q : Person → Prop)
    (h : (∀ (x : Person), P x) ∧ (∀ (x : Person), Q x)) :
    ∀ (x : Person), P x ∧ Q x := by
  intro x
  have hP : P x := And.left (∀ (y : Person), P y) (∀ (y : Person), Q y) h x
  have hQ : Q x := And.right (∀ (y : Person), P y) (∀ (y : Person), Q y) h x
  exact And.intro (P x) (Q x) hP hQ

axiom Exists : (A : Type 0) → (A → Prop) → Prop
axiom Exists.intro : (A : Type 0) → (p : A → Prop) → (w : A) → p w → Exists A p
axiom Exists.elim : (A : Type 0) → (p : A → Prop) → (Q : Prop) → Exists A p → ((w : A) → p w → Q) → Q
binder_notation "∃" => Exists

theorem exists_demo : ∃ (x : Person), True := by
  apply Exists.intro
  exact someone
  exact True.intro

theorem exists_use_demo (P : Person → Prop) (h : ∃ (x : Person), P x) : True := by
  exact Exists.elim Person P True h (fun (w : Person) => fun (hw : P w) => True.intro)

theorem exists_intro_rule (P : Person → Prop) (w : Person) (hw : P w) : ∃ (x : Person), P x := by
  exact Exists.intro Person P w hw

theorem exists_elim_rule (P : Person → Prop) (Q : Prop) (h : ∃ (x : Person), P x)
    (f : ∀ (x : Person), P x → Q) : Q := by
  exact Exists.elim Person P Q h f

theorem forall_exists (P : Person → Prop) (h : ∀ (x : Person), P x) : ∃ (x : Person), P x := by
  exact Exists.intro Person P someone (h someone)

theorem exists_mono (P : Person → Prop) (Q : Person → Prop)
    (f : ∀ (x : Person), P x → Q x) (h : ∃ (x : Person), P x) :
    ∃ (x : Person), Q x := by
  exact Exists.elim Person P (∃ (x : Person), Q x) h
    (fun (w : Person) => fun (hw : P w) => Exists.intro Person Q w (f w hw))
