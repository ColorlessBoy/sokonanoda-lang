-- unit2-equality-rfl-solution —— 单元② 解答钥匙（agent 专用）
def one : Nat := 1

#reduce 1 + 1

def demo_refl : (2 + 2) = 4 := by
  exact Eq.refl.{1} Nat (2 + 2)

#reduce demo_refl

def eq_symm_demo : (a : Nat) → (b : Nat) → a = b → b = a := by
  intro a b h
  exact Eq.symm.{1} Nat a b h

def two : Nat := 2

theorem one_plus_one_eq_two : (1 + 1) = 2 := by
  exact Eq.refl.{1} Nat (1 + 1)

theorem eq_symm_nat : (a : Nat) → (b : Nat) → a = b → b = a := by
  intro a b h
  exact Eq.subst.{1} Nat (fun (x : Nat) => x = a) a b h (Eq.refl.{1} Nat a)

theorem eq_trans_nat : (a : Nat) → (b : Nat) → (c : Nat)
  → a = b → b = c → a = c := by
  intro a b c h1 h2
  exact Eq.subst.{1} Nat (fun (x : Nat) => a = x) b c h2 h1

theorem eq_refl_prop : {a : Prop} → a = a := by
  intro a
  exact Eq.refl.{1} Prop a

-- 闭环：two 确实等于 1 + 1（内核计算两侧后判定）。
theorem two_def : two = (1 + 1) := by
  exact Eq.refl.{1} Nat two
