-- unit1-propositions-proofs-solution —— 单元① 解答钥匙（agent 专用；画布不 import 它）
axiom True : Prop
axiom True.intro : True
axiom False : Prop
axiom False.rec : (P : Prop) → False → P

def Not : Prop → Prop := fun (a : Prop) => a → False

#reduce ¬ True

example : True ∨ False := Or.inl True.intro

theorem true_is_true : True := by
  exact True.intro

theorem and_intro_rule : (a : Prop) → (b : Prop) → a → b → a ∧ b := by
  intro a b ha hb
  exact And.intro ha hb

theorem and_swap : (a : Prop) → (b : Prop) → a ∧ b → b ∧ a := by
  intro a b h
  exact And.intro (And.right h) (And.left h)

theorem ex_falso : (P : Prop) → False → P := by
  intro P h
  exact False.rec P h

theorem and_not_absurd : (a : Prop) → a ∧ ¬ a → False := by
  intro a h
  exact And.right a (¬ a) h (And.left a (¬ a) h) -- soko:notation-ok: And.right 后面还跟着对结果的继续应用（参数个数超出签名显式层数），隐式插入不适用（引擎边界）

theorem demo_binders (a : Prop) (b : Prop) (h : a ∧ b) : b ∧ a := by
  exact And.intro (And.right h) (And.left h)

theorem and_intro_rule2 (a : Prop) (b : Prop) (ha : a) (hb : b) : a ∧ b := by
  exact And.intro ha hb
