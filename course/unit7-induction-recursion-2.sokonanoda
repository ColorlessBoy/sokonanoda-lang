-- ==========================================================================
-- unit7-induction-recursion-2.sokonanoda —— 单元⑦ 归纳与递归 Ⅱ
--
-- 规则：
--   * 带 sorry 的声明是练习。把 sorry 换成你的答案，由完整内核判定对错。
--   * 部分作答是合法状态：先写前几层 fun，最后一层留 sorry。
--   * 判定永远走内核：填完的每一行放回官方 Lean 也合法。
--
-- 本单元是「归纳与递归」的下半：上一个单元搭好了显式 Nat 块，练了手写
-- `Nat.rec` 与递归 `match`；这一单元继续往前——参数化类型（`Option`）、
-- 依赖 `match`（也就是数学归纳法）、嵌套与通配模式，最后是带索引的 `Vec`。
-- 文件仍然自给自足：下面重复一遍与上一个单元相同的 Nat 块。
-- ==========================================================================

-- 自带的 Nat 归纳块（与上一个单元相同，保证本文件独立可编译）。
inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) → Sort u) →
  (mz : motive zero) →
  (ms : (n : Nat) → motive n → motive (succ n)) →
  (n : Nat) → motive n
iota zero :=
  fun (motive : (n : Nat) → Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) → motive n → motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) → Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) → motive n → motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- ─────────────────────────────────────────────────────────────
-- 参数化归纳：类型可以带参数。
-- `Option (A : Type)` 表示「可能有一个 A、也可能什么都没有」：参数 A 是
-- 元素类型，none 不带元素，some 带一个 A。派生递归子 Option.rec 由前端
-- 自动合成（参数在最外层）。match 的参数实例从 scrutinee 的书写类型取
-- ——这里 x : Option Nat，所以分支里的 a 是 Nat。
-- ─────────────────────────────────────────────────────────────

inductive Option (A : Type) : Type
ctor none : Option A
ctor some (a : A) : Option A
end

-- 演示（已写好）：fromOption 把「可能没有」的值接一个默认值后取出。
def fromOption (x : Option Nat) (d : Nat) : Nat := match x with
| none => d
| some a => a

-- 自测：#reduce 走 match 降低出的 Option.rec —— some 那支就是里面的数。
#reduce fromOption (some Nat (succ zero)) zero

-- 练习 1：valueOrZero 把「可能没有」的值取出来：some a 给 a，none 给 zero。
-- soko:hint 思路：match 一次列全 none 与 some 两个构造子，分支结果都必须是 Nat。
-- soko:hint 目标形态：fun (x : Option Nat) => match x with | none => zero | some a => <some 分支>；参数 Nat 从 x 的书写类型代入。
-- soko:hint 关键件：some 分支的 a 类型就是参数 A 代入后的 Nat，直接把它作为 Nat 交出去。
def valueOrZero (x : Option Nat) : Nat := match x with
| none => zero
| some a => sorry

-- ─────────────────────────────────────────────────────────────
-- 依赖 match：结果类型随 scrutinee 的取值变化。
-- 数学归纳法就是这种形状：给定命题 P、基础 P zero，以及递推
-- 「对每个 k，P k 推出 P (succ k)」，就能对任意 n 得到 P n。
-- match 每支的结果类型不同——zero 支要证 P zero，succ 支要证 P (succ k)；
-- 关键是 succ 支里的归纳假设 ih，它的类型正是 P k（依赖 IH）。
-- ─────────────────────────────────────────────────────────────

theorem nat_induction (P : Nat → Prop) (hz : P zero)
    (hs : (k : Nat) → P k → P (succ k)) (n : Nat) : P n :=
  match n with
  | zero => hz
  | succ k => hs k ih

-- 练习 2：同样的归纳法，递推那步自己写——succ 支里 ih : P k。
-- soko:hint 思路：match n 分 zero/succ 两支：zero 交基础 hz，succ 交递推。
-- soko:hint 目标形态：succ 支的目标是 P (succ k)，上下文有 k : Nat 与 ih : P k。
-- soko:hint 关键件：hs 吃 k 和一份 P k 的证明——把 ih 交给它就行。
theorem nat_induction_open (P : Nat → Prop) (hz : P zero)
    (hs : (k : Nat) → P k → P (succ k)) (n : Nat) : P n :=
  match n with
  | zero => hz
  | succ k => sorry

-- ─────────────────────────────────────────────────────────────
-- 嵌套模式与通配：模式可以「看进」字段里。
-- `some zero` 与 `some _` 分开了「里面的数是不是零」——同一个构造子
-- `some` 可以写多条 arm，按顺序、第一个匹配的胜出；`_` 兜住其余取值。
-- ─────────────────────────────────────────────────────────────

-- 演示（已写好）：里面是零就给一，否则给零。
def isZeroOpt (x : Option Nat) : Nat := match x with
| some zero => succ zero
| some _ => zero
| none => zero

-- 自测：#reduce 先走外层 Option 的 match，再走内层 Nat 的嵌套 match。
#reduce isZeroOpt (some Nat zero)
#reduce isZeroOpt (some Nat (succ zero))

-- 练习 3：predOpt 取出「里面那个数的前驱」：some (succ k) 给 k，
-- some zero 与 none 都给 zero——用嵌套模式把 succ 的字段 k 绑出来。
-- soko:hint 思路：some 要分两种：里面是 zero 还是 succ k。
-- soko:hint 目标形态：match x with | some zero => … | some (succ k) => … | none => …。
-- soko:hint 关键件：succ 那一支把字段 k 绑出来了，直接把它作为 Nat 交出去。
def predOpt (x : Option Nat) : Nat := match x with
| some zero => zero
| some (succ k) => sorry
| none => zero

-- ─────────────────────────────────────────────────────────────
-- 带索引归纳：类型除了参数，还能带**索引**——索引随构造子取值变化。
-- `Vec A n` = 「长度为 n 的 A 列表」：vnil 的长度是 zero，
-- vcons 把头接在长度 n 的尾巴前，长度变成 succ n。
-- （v1 边界：match 的结果类型不能依赖索引本身。）
-- ─────────────────────────────────────────────────────────────

inductive Vec (A : Type) : Nat → Type
ctor vnil : Vec A zero
ctor vcons (a : A) (n : Nat) (v : Vec A n) : Vec A (succ n)
end

-- 演示（已写好）：长度。
def vlen (A : Type) (n : Nat) (v : Vec A n) : Nat := match v with
| vnil => zero
| vcons a m w => succ ih

-- 自测：#reduce 走 Vec.rec —— 两层 vcons 的长度是两层 succ。
#reduce vlen Nat (succ (succ zero)) (vcons Nat zero zero (vcons Nat (succ zero) zero (vnil Nat)))

-- 练习 4：vhead 取出第一个元素；空表返回默认值 d。
-- soko:hint 思路：match v 分 vnil / vcons a m w 两支。
-- soko:hint 目标形态：vnil 支返回 d；vcons 支的结果类型是 A。
-- soko:hint 关键件：vcons 把头部绑成 a——直接把 a 交出去。
def vhead (A : Type) (d : A) (n : Nat) (v : Vec A n) : A := match v with
| vnil => d
| vcons a m w => sorry
