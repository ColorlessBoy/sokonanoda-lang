-- ==========================================================================
-- unit9-relations-connectives.sokonanoda —— 单元⑨ 关系与联结词
--
-- 规则：
--   * 带 sorry 的声明是练习。把 sorry 换成你的答案，由完整内核判定对错。
--   * 部分作答是合法状态：先写前几层 fun，最后一层留 sorry。
--   * 判定永远走内核：填完的每一行放回官方 Lean 也合法。
--
-- ∧、∨、→、¬ 这些连接符与它们的构造子 **prelude 自带**（内核 core 级，任何
-- 文件都能直接用，不用自己声明）。本单元补上三块：
--   * Or 的**消去子用法**：Or 一直是真归纳类型，内核知道它恰好有 inl / inr
--     两个构造子，也自动派生了消去子 Or.rec——拿到一份 A ∨ B 的证明就能对
--     两份证据分情况（cases / Or.elim / 手写 Or.rec，match 也降低到它上面）；
--   * Iff（当且仅当）是一个**定义**：展开后就是一对方向相反的箭头；
--   * 关系 Le（≤）也是归纳定义，证明要对**证据**做归纳——这就是
--     PLFA 的「消去 / inversion 引理」套路。
-- 最后用 Even（偶数）再练一次「归纳定义关系 + 构造证据」。
-- ==========================================================================

-- 本文件用到的名字：And / Or 来自 prelude（见 9.1），Iff 是下面 9.2 的 def。

-- ─────────────────────────────────────────────────────────────
-- 9.1 Or 的消去子：一份 A ∨ B 的证据怎么用
--
-- Or 一直是**真归纳类型**（prelude 自带）：内核知道它恰好有 inl / inr 两个
-- 构造子，并自动派生了消去子 Or.rec——形状与单元⑥手写的 Nat.rec 相同
-- （motive → 各分支 → 目标）；Or.elim 是它的柯里化包装，match 也降低到它
-- 上面。构造子写在**表达式位**要带前缀（Or.inl / Or.inr），写在**模式位**
-- 照旧是裸名（match h with | inl a => …）。拆 Or = 对两份可能的证据分情况。
-- ─────────────────────────────────────────────────────────────

-- 演示（已写好）：构造子当函数用，参数按顺序全部给全。
theorem or_intro_demo (A : Prop) (B : Prop) (a : A) : A ∨ B :=
  Or.inl A B a

-- 练习 1：交换 Or 的两边。
-- soko:hint 思路：match h 一次列全 inl / inr 两个构造子，每支把里面的证据装到另一边的构造子里。
-- soko:hint 目标形态：目标是 B ∨ A；inl 支手里是 a : A，inr 支手里是 b : B。
-- soko:hint 关键件：目标是拆开重装：inl 支用 Or.inr 的构造子，inr 支用 Or.inl 的构造子，两个构造子都要把 A、B 两个参数补全。
theorem or_comm (A : Prop) (B : Prop) (h : A ∨ B) : B ∨ A := by
  sorry

-- 练习 2：显式使用消去子 Or.rec，把「两个方向都通向 C」合成「A ∨ B 通向 C」。
-- soko:hint 思路：目标是 C、手里是 h : A ∨ B——消去子 Or.rec 正是「从 Or 得到任意命题」的工具。
-- soko:hint 目标形态：Or.rec 的 motive 是常函数 fun (x : A ∨ B) => C；两个分支分别交出 f 与 g。
-- soko:hint 关键件：Or.rec 吃五样：命题 A、命题 B、motive、吃 A 证明的左分支、吃 B 证明的右分支，最后喂 h；f、g 正好是两个分支。
theorem or_elim (A : Prop) (B : Prop) (C : Prop) (h : A ∨ B) (f : A → C) (g : B → C) : C := by
  sorry

-- 练习 3（读/评阅 R）：下面这份 or_id 的证明被内核拒绝了，错在哪？
--
--   theorem or_id_wrong (A : Prop) (h : A ∨ A) : A :=
--     match h with
--     | inl a => a
--
-- 提示：一个 match 要覆盖**全部**构造子；Or 有两个。
-- 请写出改正后、内核可判定的版本。
-- soko:hint 思路：A ∨ A 拆开后两支都是 A 的证明；把缺掉的另一支补齐即可。
-- soko:hint 目标形态：目标是 A；match 的每一支都必须是 A 的一个证明。
-- soko:hint 关键件：上下文 h : A ∨ A：inl 与 inr 两个构造子各带一份 A 的证明，两份都能直接交出去。
theorem or_id (A : Prop) (h : A ∨ A) : A := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 9.2 Iff：当且仅当是一个定义
--
-- `↔` 就是指向下面这个 Iff 定义的记法，但「当且仅当」不需要新公理，它就是一个定义：
--
--     A ↔ B 展开后 = (A → B) ∧ (B → A)
--
-- 也就是说，一份 A ↔ B 的证明就是一对函数：一个把 A 变成 B（正向，
-- 常叫 mp），一个把 B 变成 A（反向，常叫 mpr）。证明它用 And.intro；
-- 使用它用 And.left / And.right（内核会自动展开 Iff 这个定义）。
-- ─────────────────────────────────────────────────────────────

def Iff (A : Prop) (B : Prop) : Prop := (A → B) ∧ (B → A)

-- 演示（已写好）：把两个方向打包成 Iff。
theorem iff_intro_demo (A : Prop) (B : Prop) (mp : A → B) (mpr : B → A) : A ↔ B :=
  And.intro (A → B) (B → A) mp mpr

-- 练习 4：取出 Iff 的正向。
-- soko:hint 思路：A ↔ B 是定义，展开后是一个 And；正向就在它的左边。
-- soko:hint 目标形态：目标是一个箭头 A → B；h 展开后是 (A → B) ∧ (B → A)。
-- soko:hint 关键件：h : A ↔ B（内核会展开定义）：用 And.left 取出左半，它就是 A → B。
theorem iff_mp (A : Prop) (B : Prop) (h : A ↔ B) : A → B := by
  sorry

-- 练习 5：取出 Iff 的反向。
-- soko:hint 思路：与上一题对称——反向是展开后那个 And 的右边。
-- soko:hint 目标形态：目标是箭头 B → A；h 展开后仍是 (A → B) ∧ (B → A)。
-- soko:hint 关键件：h : A ↔ B：用 And.right 取出右半，它就是 B → A。
theorem iff_mpr (A : Prop) (B : Prop) (h : A ↔ B) : B → A := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 9.3 Le：用归纳定义的关系
--
-- 关系「m ≤ n」也是归纳定义的类型，只不过它带**索引**：两个构造子分别
-- 说明「n ≤ n」（自反）与「若 m ≤ n 则 m ≤ succ n」（后缀加一）。
--
--     le_refl n : Le n n
--     le_succ m n : Le m n → Le m (succ n)
--
-- 证明关于 Le 的命题，就是对那份**证据**做归纳。消去子 Le.rec 现在由
-- 前端自动派生（带索引的关系也一样）：它的三条前提——motive、le_refl
-- 处的分支、le_succ 处的分支（多一个对递归证据的归纳假设 ih）——正是
-- PLFA 所说的 induction/inversion 原则。下面的 inductive 块只写构造子，
-- rec/iota 交给前端。Nat 继续用 prelude 自带的（写成 Nat.zero / Nat.succ）。
-- ─────────────────────────────────────────────────────────────

inductive Le : Nat → Nat → Prop
ctor le_refl (n : Nat) : Le n n
ctor le_succ (m : Nat) (n : Nat) : Le m n → Le m (Nat.succ n)
end

-- 演示（已写好）：自反性立刻给出「n ≤ n+1」的构造子链条。
theorem le_succ_self (n : Nat) : Le n (Nat.succ n) :=
  le_succ n n (le_refl n)

-- 练习 6（自证 L）：零小于等于任何自然数——对 n 做归纳。
-- soko:hint 思路：对 n 做 match：zero 支用自反性；succ 支把归纳假设 ih : Le Nat.zero k 经 le_succ 抬一层。
-- soko:hint 目标形态：match n with | Nat.zero => … | Nat.succ k => …，两支的目标是 Le Nat.zero Nat.zero 与 Le Nat.zero (Nat.succ k)。
-- soko:hint 关键件：zero 支用 le_refl；succ 支有 ih : Le Nat.zero k，用 le_succ 把它抬到 Le Nat.zero (Nat.succ k)。
theorem le_zero (n : Nat) : Le Nat.zero n := by
  sorry

-- 练习 7（翻译 X）：下面这句非形式命题，请写成上面的 Le 版本并给出内核可判定的证明：
--
--   「对任意自然数 m、n、k：若 m ≤ n 且 n ≤ k，则 m ≤ k。」（≤ 的传递性）
--
-- (注意：这里说的「≤」就是本单元定义的 Le，自变量顺序是 Le 左小右大。)
-- soko:hint 思路：要证 Le m k，对第二个证据 h2 : Le n k 用消去子 Le.rec 归纳，motive 取「Le m a → Le m b」。
-- soko:hint 目标形态：Le.rec 需要三样：motive、le_refl 处的分支、le_succ 处的分支（比前者多一个归纳假设 ih）。
-- soko:hint 关键件：目标 Le m k：le_refl 支直接交 h1；le_succ 支对 hx : Le m a 先用 ih 得 Le m b、再用 le_succ 抬一层；对 (n, k, h2) 归纳后把 h1 应用上去。
theorem le_trans (m : Nat) (n : Nat) (k : Nat) (h1 : Le m n) (h2 : Le n k) : Le m k := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 9.4 Even：再练一个归纳定义的关系
--
-- 「n 是偶数」同样是一个带索引的归纳关系：零是偶数；若 n 是偶数，则
-- n+2 也是偶数。Even.rec 同样由前端自动派生——它的 le_succ 式分支多一个
-- 归纳假设，正是下一题「用 Even.rec 证性质」要用的东西。
-- ─────────────────────────────────────────────────────────────

inductive Even : Nat → Prop
ctor even_zero : Even Nat.zero
ctor even_succ (n : Nat) : Even n → Even (Nat.succ (Nat.succ n))
end

-- 演示（已写好）：用构造子直接搭出「2 是偶数」。
theorem even_two : Even (Nat.succ (Nat.succ Nat.zero)) :=
  even_succ Nat.zero even_zero

-- 演示（已写好）：用消去子 Even.rec 证明「偶数加二还是偶数」——motive
-- 是「Even (succ (succ n))」，le_succ 式分支里的 ih 正好是这一性质。
theorem even_plus_two (n : Nat) (h : Even n) : Even (Nat.succ (Nat.succ n)) :=
  Even.rec
    (fun (a : Nat) (x : Even a) => Even (Nat.succ (Nat.succ a)))
    (even_succ Nat.zero even_zero)
    (fun (a : Nat) (x : Even a) (ih : Even (Nat.succ (Nat.succ a))) => even_succ (Nat.succ (Nat.succ a)) ih)
    n h

-- 练习 8：搭出「4 是偶数」——在 even_two 的基础上再叠一次 even_succ。
-- soko:hint 思路：even_succ 把「n 是偶数」变成「n+2 是偶数」；把 n 取成 2，前提就是上面证好的 even_two。
-- soko:hint 目标形态：目标是 Even 4（写成构造子链是 succ (succ (succ (succ zero)))）。
-- soko:hint 关键件：even_succ——它吃一个 Nat 和一份 Even Nat，交出 Even (Nat.succ (Nat.succ Nat))；前提用 even_two。
theorem even_four : Even (Nat.succ (Nat.succ (Nat.succ (Nat.succ Nat.zero)))) := by
  sorry
