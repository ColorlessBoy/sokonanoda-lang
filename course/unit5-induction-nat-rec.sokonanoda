-- ==========================================================================
-- unit5-induction-nat-rec.sokonanoda —— 单元⑤ 显式归纳与递归
--
-- 规则：
--   * 带 sorry 的声明是练习。把 sorry 换成你的答案，由完整内核判定对错。
--   * 部分作答是合法状态：先写前几层 fun，最后一层留 sorry。
--   * 判定永远走内核：填完的每一行放回官方 Lean 也合法。
-- ==========================================================================

-- ─────────────────────────────────────────────────────────────
-- 到目前为止的 Nat 都是 prelude 送的。这次我们**自己搭一遍**：
-- 一个显式的 inductive 块 = 类型 + 构造子 + 消去子 Nat.rec + iota 规则。
-- （这个块会取代整个文件里的 prelude Nat —— 文件从此自给自足。）
-- 演示部分照抄 examples/py-nat.sokonanoda，无需改动。
-- ─────────────────────────────────────────────────────────────

inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) -> Sort u) ->
  (mz : motive zero) ->
  (ms : (n : Nat) -> motive n -> motive (succ n)) ->
  (n : Nat) -> motive n
iota zero :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- 演示（已写好）：数字现在用构造子搭出来，不再有字面量的魔法。
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two

-- 自测：#reduce 走 iota 规则 —— succ two 是 3。
#reduce succ two

-- ─────────────────────────────────────────────────────────────
-- Nat.rec 的读法：给定 motive、zero 处的值 mz、以及“从 k 的结果 ih
-- 造出 succ k 的结果”的步进函数 ms，就能对任意 n 算出 motive n。
-- 定义递归函数 = 选好这三样东西，再喂一个 n。
-- ─────────────────────────────────────────────────────────────

-- 练习 1：定义 four : Nat。提示：three 已经有了，再叠一个 succ。
-- soko:hint 思路：数字不再有字面量的魔法——现在用构造子一层层叠出来；环境里已经有 three。
-- soko:hint 目标形态：目标就是 Nat：在 three 的基础上再叠一层。
-- soko:hint 关键件：succ——吃一个 Nat、返回“下一个” Nat 的构造子。
def four : Nat := sorry

-- 练习 2（递归定义 double）：对 zero 返回 zero；对 succ k，
-- 用归纳结果 ih 造出 succ (succ ih)。motive 全程是常函数 (fun (x : Nat) => Nat)。
-- 提示：照抄 Nat.rec 的形状：motive -> mz -> ms -> n。
-- soko:hint 思路：递归定义 = 选好 Nat.rec 的三样东西：motive、zero 处的值 mz、步进函数 ms，最后喂 n。
-- soko:hint 目标形态：外层 fun (n : Nat) => Nat.rec … n；motive 全程是常函数 fun (x : Nat) => Nat，zero 处返回 zero。
-- soko:hint 关键件：Nat.rec.{1} 按 motive -> mz -> ms -> n 给全；ms 吃 k 和归纳结果 ih——想想 succ k 的翻倍该比 ih 多叠几个 succ。
def double : Nat -> Nat := sorry

-- 练习 3（加法）：add m n 从 m 出发做归纳：zero 处返回 n（“数 zero 次”）；
-- succ k 处用 ih 造 succ ih（“多叠一层”）。
-- 提示：注意归纳变量是 m：Nat.rec 的第一个显式参数放 n，最后一个放 m。
-- soko:hint 思路：还是那三样东西，但归纳变量换成 m：“数 zero 次”就是 n 本身，“多叠一层”就是 succ ih。
-- soko:hint 目标形态：fun (m : Nat) => fun (n : Nat) => Nat.rec … m——注意最后喂的是 m（归纳变量），n 是起点值。
-- soko:hint 关键件：Nat.rec.{1}，motive 仍是常函数；mz 处放 n（zero 次的结果），ms 吃 k 和 ih、只叠一层 succ。
def add : Nat -> Nat -> Nat := sorry

-- 收尾（内核回判）：解完练习 3 后，把下面这行的注释去掉。
-- 它必须变绿 —— add two two 就是四层 succ，这是 iota 在替你数数。
-- #reduce add two two

-- ─────────────────────────────────────────────────────────────
-- `match` 分情况：对非递归枚举「看构造子办事」。
-- 下面的 Color 只有两个构造子 red/green；我们照旧给出消去子
-- Color.rec 与 iota 规则，再用 match 一次覆盖全部构造子。
-- v1 的 match 只做**非递归**的源内 inductive，且结果类型必须已知。
-- ─────────────────────────────────────────────────────────────

inductive Color : Type
ctor red : Color
ctor green : Color
rec Color.rec {u} :
  (motive : (c : Color) -> Sort u) ->
  (mr : motive red) ->
  (mg : motive green) ->
  (c : Color) -> motive c
iota red :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mr
iota green :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mg
end

-- 演示（已写好）：swap 把 red/green 对调；两个分支各写一次。
def swap (c : Color) : Color := match c with
| red => green
| green => red

-- 自测：#reduce 走的是 match 降低出的 Color.rec —— swap red 就是 green。
#reduce swap red

-- 练习 4：relabel 把 red 映到 red、green 映到 green（原样返回）。
-- soko:hint 思路：match 一次列全 red 与 green 两个构造子，每个分支给一个 Color。
-- soko:hint 目标形态：fun (c : Color) => match c with …；分支顺序随意，前端按声明序重排。
-- soko:hint 关键件：red 分支写 red、green 分支写 green——这就是恒等映射。
def relabel (c : Color) : Color := sorry

-- 练习 5：在 match 的一个分支里留 sorry —— 只需补上 green 这一支。
-- soko:hint 思路：red 分支已经给出 green；green 分支待填，目标类型是 Color。
-- soko:hint 目标形态：match c with | red => green | green => <你的答案>。
-- soko:hint 关键件：green 分支填 red——这样得到的正是 swap。
def swapOpen (c : Color) : Color := match c with
| red => green
| green => sorry

-- ─────────────────────────────────────────────────────────────
-- `match` + 递归：分支里的归纳假设 IH。
-- 对源内递归归纳类型，每个递归字段之后会自动多出一个名为 `ih` 的 binder
-- （类型就是 match 的结果类型 Nat），分支里直接引用它即可——递归不再需要
-- 函数自引用。下面 addM 在 succ 分支里做的事就是「把 ih 再叠一层 succ」。
-- ─────────────────────────────────────────────────────────────

-- 演示（已写好）：addM a b 对 a 归纳：zero 处返回 b；succ 处返回 succ ih。
-- 语义与练习 3 的 add 相同，只是改用 match 写。
def addM (a b : Nat) : Nat := match a with
| zero => b
| succ m => succ ih

-- 自测：#reduce 走 match 降低出的 Nat.rec —— addM two three 就是五层 succ。
#reduce addM two three

-- 练习 6：recDouble 对 n 归纳：zero 处返回 zero；succ 处用归纳假设 ih
-- 造出 succ (succ ih)。只需补 succ 分支。
-- soko:hint 思路：递归字段 m 之后会自动多出一个归纳假设 ih（类型就是结果类型 Nat），succ 分支里直接用它拼结果。
-- soko:hint 目标形态：match n with | zero => zero | succ m => <succ 分支>；两个分支的结果都必须是 Nat。
-- soko:hint 关键件：succ 分支写 succ (succ ih)——在 ih 的基础上再叠两层 succ，正好是翻倍。
def recDouble (n : Nat) : Nat := match n with
| zero => zero
| succ m => sorry

-- ─────────────────────────────────────────────────────────────
-- 参数化归纳：类型可以带参数。
-- `Option (A : Type)` 表示「可能有一个 A、也可能什么都没有」：参数 A 是
-- 元素类型，none 不带元素，some 带一个 A。派生递归子 Option.rec 由前端
-- 自动合成（参数在最外层）。match 的参数实例从 scrutinee 的书写类型取
-- ——这里 x : Option Nat，所以分支里的 a 是 Nat。
-- ─────────────────────────────────────────────────────────────

inductive Option (A : Type) : Type
ctor none : Option A
ctor some (a : A) : Option A
end

-- 演示（已写好）：fromOption 把「可能没有」的值接一个默认值后取出。
def fromOption (x : Option Nat) (d : Nat) : Nat := match x with
| none => d
| some a => a

-- 自测：#reduce 走 match 降低出的 Option.rec —— some 那支就是里面的数。
#reduce fromOption (some Nat (succ zero)) zero

-- 练习 7：valueOrZero 把「可能没有」的值取出来：some a 给 a，none 给 zero。
-- soko:hint 思路：match 一次列全 none 与 some 两个构造子，分支结果都必须是 Nat。
-- soko:hint 目标形态：fun (x : Option Nat) => match x with | none => zero | some a => <some 分支>；参数 Nat 从 x 的书写类型代入。
-- soko:hint 关键件：some 分支的 a 类型就是参数 A 代入后的 Nat，直接把它作为 Nat 交出去。
def valueOrZero (x : Option Nat) : Nat := match x with
| none => zero
| some a => sorry

-- ─────────────────────────────────────────────────────────────
-- 依赖 match：结果类型随 scrutinee 的取值变化。
-- 数学归纳法就是这种形状：给定命题 P、基础 P zero，以及递推
-- 「对每个 k，P k 推出 P (succ k)」，就能对任意 n 得到 P n。
-- match 每支的结果类型不同——zero 支要证 P zero，succ 支要证 P (succ k)；
-- 关键是 succ 支里的归纳假设 ih，它的类型正是 P k（依赖 IH）。
-- ─────────────────────────────────────────────────────────────

theorem nat_induction (P : Nat -> Prop) (hz : P zero)
    (hs : (k : Nat) -> P k -> P (succ k)) (n : Nat) : P n :=
  match n with
  | zero => hz
  | succ k => hs k ih

-- 练习 8：同样的归纳法，递推那步自己写——succ 支里 ih : P k。
-- soko:hint 思路：match n 分 zero/succ 两支：zero 交基础 hz，succ 交递推。
-- soko:hint 目标形态：succ 支的目标是 P (succ k)，上下文有 k : Nat 与 ih : P k。
-- soko:hint 关键件：hs 吃 k 和一份 P k 的证明——把 ih 交给它就行。
theorem nat_induction_open (P : Nat -> Prop) (hz : P zero)
    (hs : (k : Nat) -> P k -> P (succ k)) (n : Nat) : P n :=
  match n with
  | zero => hz
  | succ k => sorry

-- ─────────────────────────────────────────────────────────────
-- 嵌套模式与通配：模式可以「看进」字段里。
-- `some zero` 与 `some _` 分开了「里面的数是不是零」——同一个构造子
-- `some` 可以写多条 arm，按顺序、第一个匹配的胜出；`_` 兜住其余取值。
-- ─────────────────────────────────────────────────────────────

-- 演示（已写好）：里面是零就给一，否则给零。
def isZeroOpt (x : Option Nat) : Nat := match x with
| some zero => succ zero
| some _ => zero
| none => zero

-- 自测：#reduce 先走外层 Option 的 match，再走内层 Nat 的嵌套 match。
#reduce isZeroOpt (some Nat zero)
#reduce isZeroOpt (some Nat (succ zero))

-- 练习 9：predOpt 取出「里面那个数的前驱」：some (succ k) 给 k，
-- some zero 与 none 都给 zero——用嵌套模式把 succ 的字段 k 绑出来。
-- soko:hint 思路：some 要分两种：里面是 zero 还是 succ k。
-- soko:hint 目标形态：match x with | some zero => … | some (succ k) => … | none => …。
-- soko:hint 关键件：succ 那一支把字段 k 绑出来了，直接把它作为 Nat 交出去。
def predOpt (x : Option Nat) : Nat := match x with
| some zero => zero
| some (succ k) => sorry
| none => zero

-- ─────────────────────────────────────────────────────────────
-- 带索引归纳：类型除了参数，还能带**索引**——索引随构造子取值变化。
-- `Vec A n` = 「长度为 n 的 A 列表」：vnil 的长度是 zero，
-- vcons 把头接在长度 n 的尾巴前，长度变成 succ n。
-- （v1 边界：match 的结果类型不能依赖索引本身。）
-- ─────────────────────────────────────────────────────────────

inductive Vec (A : Type) : Nat -> Type
ctor vnil : Vec A zero
ctor vcons (a : A) (n : Nat) (v : Vec A n) : Vec A (succ n)
end

-- 演示（已写好）：长度。
def vlen (A : Type) (n : Nat) (v : Vec A n) : Nat := match v with
| vnil => zero
| vcons a m w => succ ih

-- 自测：#reduce 走 Vec.rec —— 两层 vcons 的长度是两层 succ。
#reduce vlen Nat (succ (succ zero)) (vcons Nat zero zero (vcons Nat (succ zero) zero (vnil Nat)))

-- 练习 10：vhead 取出第一个元素；空表返回默认值 d。
-- soko:hint 思路：match v 分 vnil / vcons a m w 两支。
-- soko:hint 目标形态：vnil 支返回 d；vcons 支的结果类型是 A。
-- soko:hint 关键件：vcons 把头部绑成 a——直接把 a 交出去。
def vhead (A : Type) (d : A) (n : Nat) (v : Vec A n) : A := match v with
| vnil => d
| vcons a m w => sorry
