-- ==========================================================================
-- unit6-induction-recursion-1.sokonanoda —— 单元⑥ 归纳与递归 Ⅰ
--
-- 规则：
--   * 带 sorry 的声明是练习。把 sorry 换成你的答案，由完整内核判定对错。
--   * 部分作答是合法状态：先写前几层 fun，最后一层留 sorry。
--   * 判定永远走内核：填完的每一行放回官方 Lean 也合法。
--
-- 本单元是「归纳与递归」的上半：自己搭出归纳类型 Nat、用它写递归定义
-- （把 `Nat.rec` 手写展开）、再学 `match` 分情况与递归 `match` 自动带上
-- 归纳假设。下半单元（单元⑦）继续讲参数化、依赖 match 与带索引类型。
-- ==========================================================================

-- ─────────────────────────────────────────────────────────────
-- 到目前为止的 Nat 都是 prelude 送的。这次我们**自己搭一遍**：
-- 一个显式的 inductive 块 = 类型 + 构造子 + 消去子 Nat.rec + iota 规则。
-- （这个块会取代整个文件里的 prelude Nat —— 文件从此自给自足。）
-- 演示部分照抄 examples/py-nat.sokonanoda，无需改动。
-- ─────────────────────────────────────────────────────────────

inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) -> Sort u) ->
  (mz : motive zero) ->
  (ms : (n : Nat) -> motive n -> motive (succ n)) ->
  (n : Nat) -> motive n
iota zero :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) -> Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) -> motive n -> motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- 演示（已写好）：数字现在用构造子搭出来，不再有字面量的魔法。
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two

-- 自测：#reduce 走 iota 规则 —— succ two 是 3。
#reduce succ two

-- ─────────────────────────────────────────────────────────────
-- Nat.rec 的读法：给定 motive、zero 处的值 mz、以及“从 k 的结果 ih
-- 造出 succ k 的结果”的步进函数 ms，就能对任意 n 算出 motive n。
-- 定义递归函数 = 选好这三样东西，再喂一个 n。
-- ─────────────────────────────────────────────────────────────

-- 练习 1：定义 four : Nat。提示：three 已经有了，再叠一个 succ。
-- soko:hint 思路：数字不再有字面量的魔法——现在用构造子一层层叠出来；环境里已经有 three。
-- soko:hint 目标形态：目标就是 Nat：在 three 的基础上再叠一层。
-- soko:hint 关键件：succ——吃一个 Nat、返回“下一个” Nat 的构造子。
def four : Nat := sorry

-- 练习 2（递归定义 double）：对 zero 返回 zero；对 succ k，
-- 由归纳结果 ih 得到 succ k 的翻倍。motive 全程是常函数 (fun (x : Nat) => Nat)。
-- 提示：照抄 Nat.rec 的形状：motive -> mz -> ms -> n。
-- soko:hint 思路：递归定义 = 选好 Nat.rec 的三样东西：motive、zero 处的值 mz、步进函数 ms，最后喂 n。
-- soko:hint 目标形态：外层 fun (n : Nat) => Nat.rec … n；motive 全程是常函数 fun (x : Nat) => Nat，zero 处返回 zero。
-- soko:hint 关键件：Nat.rec.{1} 按 motive -> mz -> ms -> n 给全；ms 吃 k 和归纳结果 ih——想想 succ k 的翻倍该比 ih 多叠几个 succ。
def double : Nat -> Nat := sorry

-- 练习 3（加法）：add m n 从 m 出发做归纳：zero 处返回 n（“数 zero 次”）；
-- succ k 处把 ih 再叠一层 succ（“多叠一层”）。
-- 提示：注意归纳变量是 m：Nat.rec 的第一个显式参数放 n，最后一个放 m。
-- soko:hint 思路：还是那三样东西，但归纳变量换成 m：“数 zero 次”就是 n 本身，“多叠一层”就是 succ ih。
-- soko:hint 目标形态：fun (m : Nat) => fun (n : Nat) => Nat.rec … m——注意最后喂的是 m（归纳变量），n 是起点值。
-- soko:hint 关键件：Nat.rec.{1}，motive 仍是常函数；mz 处放 n（zero 次的结果），ms 吃 k 和 ih、只叠一层 succ。
def add : Nat -> Nat -> Nat := sorry

-- 收尾（内核回判）：解完练习 3 后，把下面这行的注释去掉。
-- 它必须变绿 —— add two two 就是四层 succ，这是 iota 在替你数数。
-- #reduce add two two

-- ─────────────────────────────────────────────────────────────
-- `match` 分情况：对非递归枚举「看构造子办事」。
-- 下面的 Color 只有两个构造子 red/green；我们照旧给出消去子
-- Color.rec 与 iota 规则，再用 match 一次覆盖全部构造子。
-- ─────────────────────────────────────────────────────────────

inductive Color : Type
ctor red : Color
ctor green : Color
rec Color.rec {u} :
  (motive : (c : Color) -> Sort u) ->
  (mr : motive red) ->
  (mg : motive green) ->
  (c : Color) -> motive c
iota red :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mr
iota green :=
  fun (motive : (c : Color) -> Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mg
end

-- 演示（已写好）：swap 把 red/green 对调；两个分支各写一次。
def swap (c : Color) : Color := match c with
| red => green
| green => red

-- 自测：#reduce 走的是 match 降低出的 Color.rec —— swap red 就是 green。
#reduce swap red

-- 练习 4：relabel 把 red 映到 red、green 映到 green（原样返回）。
-- soko:hint 思路：match 一次列全 red 与 green 两个构造子，每个分支给一个 Color。
-- soko:hint 目标形态：fun (c : Color) => match c with …；分支顺序随意，前端按声明序重排。
-- soko:hint 关键件：match 要覆盖 red 与 green，每个分支的目标类型都是 Color；恒等映射就是把每个构造子原样交回。
def relabel (c : Color) : Color := sorry

-- 练习 5：在 match 的一个分支里留 sorry —— 只需补上 green 这一支。
-- soko:hint 思路：red 分支已经给出 green；green 分支待填，目标类型是 Color。
-- soko:hint 目标形态：match c with | red => green | green => <你的答案>。
-- soko:hint 关键件：green 分支的目标是 Color；要得到 swap（red 与 green 对调），这一支该交出另一个构造子。
def swapOpen (c : Color) : Color := match c with
| red => green
| green => sorry

-- ─────────────────────────────────────────────────────────────
-- `match` + 递归：分支里的归纳假设 IH。
-- 对源内递归归纳类型，每个递归字段之后会自动多出一个名为 `ih` 的 binder
-- （类型就是 match 的结果类型 Nat），分支里直接引用它即可——递归不再需要
-- 函数自引用。下面 addM 在 succ 分支里做的事就是「把 ih 再叠一层 succ」。
-- ─────────────────────────────────────────────────────────────

-- 演示（已写好）：addM a b 对 a 归纳：zero 处返回 b；succ 处返回 succ ih。
-- 语义与练习 3 的 add 相同，只是改用 match 写。
def addM (a b : Nat) : Nat := match a with
| zero => b
| succ m => succ ih

-- 自测：#reduce 走 match 降低出的 Nat.rec —— addM two three 就是五层 succ。
#reduce addM two three

-- 练习 6：recDouble 对 n 归纳：zero 处返回 zero；succ 处用归纳假设 ih
-- 造出 succ (succ ih)。只需补 succ 分支。
-- soko:hint 思路：递归字段 m 之后会自动多出一个归纳假设 ih（类型就是结果类型 Nat），succ 分支里直接用它拼结果。
-- soko:hint 目标形态：match n with | zero => zero | succ m => <succ 分支>；两个分支的结果都必须是 Nat。
-- soko:hint 关键件：succ 分支的目标是 Nat，手里有自动插入的归纳假设 ih；翻倍就是比 ih 再高两层 succ。
def recDouble (n : Nat) : Nat := match n with
| zero => zero
| succ m => sorry
