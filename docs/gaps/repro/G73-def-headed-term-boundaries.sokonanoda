-- G-73 复现（自包含、零 import）：**定义头类型上的三条 elaborator 边界**
--
-- 期望（官方 Lean 4 语义）：下面每一条都**判绿** —— 它们全是「定义只是缩写」的直接后果，
-- Lean 的 defeq 在 elaboration 期就把 `def` 展开了。
-- 今天（本语言）：本文件**被判红**（复现 `today` 里写的那几条）。
--
-- 症状一族（三条都指向同一件事：**elaborator 的展开比内核弱**）：
--   ① `And.left h` 拿到的是**定义头**类型（`Reflexive α r` 这种）；把**这个结果**
--      再应用到实参上 ⇒ 「期望 `Sort(0)`，实际是 `IsPO …` ✗」
--   ② `And.intro` / `Iff.intro` / `Or.elim` 在**期望类型不是语法上的** `And`/`Or` 时
--      （即目标或实参位是定义头）⇒ 前导 Prop 实参反解失败 ✗
--   ③ `≠` / `=` 的记法在**嵌套位置**（λ 的绑定类型里）⇒ 宇宙层级 `u` 反解不出来
--      ⇒ 「期望 `Sort(0)`，实际是 `Sort(1)` ✗」
--
-- 影响面（卷 I 实测）：课程只能靠三种绕法写证明 —— 取用子（库层把参数收全）、
-- 智能构造子（库层做 `And.intro`）、`(fun (hx : <展开形态>) => hx …) 假设` 的显式绑定；
-- 每一种都让**证明文本偏离 Lean 4 的写法**，与硬规则 3（教学语法是真实 Lean 4 的子集）冲突。
-- 记账现场：`courses/set-theory/lib/Order.sokonanoda` 文件头 + `units/unit13-orders.sokonanoda`。

-- 词汇（与课标库同形，但这里自足）
def Reflexive (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a : α), r a a

def IsPO (α : Type) (r : α → α → Prop) : Prop :=
  Reflexive α r ∧ Reflexive α r

axiom hpo : IsPO Nat (fun (x y : Nat) => x = y)

-- 形状 ①：定义头类型的假设取出合取支后**直接应用**
theorem shape1 (a : Nat) : a = a :=
  And.left hpo a

-- ── 形状 ③ 的**第二处落点**（原课程侧 C-02，2026-10-02 收编为 G-73）──────────
-- 位置与上面那条不同：等式不在 λ 的绑定类型里，而在**定理的陈述**里
-- （`Eq` 的 `{α : Sort u}` 要落在 `Nat` 上 ⇒ `u` 反解不出来）。
-- 现场（课程侧已 `closed`，绕法是**把宇宙写显式**）：
--   `courses/set-theory/units/solutions/I.6/unit109-solution.sokonanoda`
--   的 `ordinal_rec_nat_eq` ✓（写 `Eq.{1}` / `Eq.refl.{1}` 判绿 ✓）。
-- 这里把两态都钉在同一份复现里：② 判红（缺口仍在）· ③ 判绿（绕法有效）。

inductive Acc (α : Type) (r : α → α → Prop) : α → Prop
ctor Acc.intro (x : α) (h : ∀ (y : α), r y x → Acc α r y) : Acc α r x
end

-- 良基递归**定义侧**判绿（G-56/G-58 的收益：能定义到 Type 层的函数）
def accConst (α : Type) (E : α → α → Prop) (x : α) (h : Acc α E x) : Nat :=
  Acc.rec α E (fun (z : α) (_ : Acc α E z) => Nat)
    (fun (z : α) (_hz : ∀ (y : α), E y z → Acc α E y)
      (_ih : ∀ (y : α) (hy : E y z), Nat) => Nat.succ Nat.zero) x h

-- ② 等式侧判红：`Eq` 的宇宙层级反解不出来 ⇒ 「期望 Sort(0)，实际是 Sort(1)」✗
theorem accConst_eq (α : Type) (E : α → α → Prop) (x : α)
    (hr : ∀ (y : α), E y x → Acc α E y) :
    Eq Nat (accConst α E x (Acc.intro α E x hr)) (Nat.succ Nat.zero) :=
  Eq.refl Nat (Nat.succ Nat.zero)

-- ③ 把宇宙写显式 ⇒ 判绿 ✓（课程侧的绕法，逐字同形）
theorem accConst_eq_explicit (α : Type) (E : α → α → Prop) (x : α)
    (hr : ∀ (y : α), E y x → Acc α E y) :
    Eq.{1} Nat (accConst α E x (Acc.intro α E x hr)) (Nat.succ Nat.zero) :=
  Eq.refl.{1} Nat (Nat.succ Nat.zero)
