-- G-77 **改正件**（2026-10-01 第 570 轮）：原报告「内核没有函数外延」是**误报** ✗
--
-- **当时的探针错在哪**：只 import 了 `lib.Rel`/`lib.Set`/`lib.Order`，**没 import
-- `lib.Extensionality`** ⇒ `funext` 当然是 `unknown identifier` ✗ ⇒ 误判成"内核没有外延" ✗。
--
-- **事实**：`propext` 与 `funext`（**依赖版**）一直是课程库里的**公理**
-- （`lib/Extensionality` ✓），文件头还自己点名了 L3 内容：「用它们推 `Set.ext`、
-- 函数相等的推理」✓ —— 本文件就是那件事的最小复现（**判绿** ✓）。
--
-- ⇒ 后果修正：单元㉜㉞㉟ 里"只能写逐点"的结论**其实可以升级成等式** ✓
--   已在**单元㊹**里升级（逐点序**是**偏序 · 合成结合律 · 双边逆唯一 ·
--   由两条公理推出 `Set.ext`/`Rel.ext` 的推理）✓
-- **教训**：报缺口前先把库里**已有的公理与引理**找一遍 ✗
import lib.Rel
import lib.Set
import lib.Extensionality

theorem funext_available (α β : Type) (f g : α → β)
    (h : ∀ (a : α), Eq.{1} β (f a) (g a)) : Eq.{1} (α → β) f g :=
  funext_spec α (fun (_ : α) => β) f g h

theorem propext_available (a b : Prop) (h : a ↔ b) : Eq.{1} Prop a b :=
  propext_spec a b h

theorem set_ext_derived (α : Type) (A B : Set α) (h : ∀ (x : α), A x ↔ B x) :
    Eq.{1} (Set α) A B :=
  funext_spec α (fun (_ : α) => Prop) A B (fun (x : α) => propext_spec (A x) (B x) (h x))
