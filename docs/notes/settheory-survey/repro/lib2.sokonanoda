import lib

-- U6 关系：复合结合律（关系 = α -> β -> Prop）
def Rel (α : Type) (β : Type) : Type := α -> β -> Prop
def Rel.comp (α : Type) (β : Type) (γ : Type) (R : Rel α β) (S : Rel β γ) : Rel α γ :=
  fun (a : α) => fun (c : γ) => Exists β (fun (b : β) => And (R a b) (S b c))

theorem rel_comp_assoc (α : Type) (β : Type) (γ : Type) (δ : Type)
    (R : Rel α β) (S : Rel β γ) (T : Rel γ δ)
    (a : α) (d : δ) :
    Rel.comp α γ δ (Rel.comp α β γ R S) T a d -> Rel.comp α β δ R (Rel.comp β γ δ S T) a d :=
  fun (h : Exists γ (fun (c : γ) => And (Exists β (fun (b : β) => And (R a b) (S b c))) (T c d))) =>
    Exists.elim γ (fun (c : γ) => And (Exists β (fun (b : β) => And (R a b) (S b c))) (T c d))
      (Exists β (fun (b : β) => And (R a b) (Exists γ (fun (c2 : γ) => And (S b c2) (T c2 d)))))
      h
      (fun (c : γ) => fun (hc : And (Exists β (fun (b : β) => And (R a b) (S b c))) (T c d)) =>
        Exists.elim β (fun (b : β) => And (R a b) (S b c))
          (Exists β (fun (b : β) => And (R a b) (Exists γ (fun (c2 : γ) => And (S b c2) (T c2 d)))))
          (And.left (Exists β (fun (b : β) => And (R a b) (S b c))) (T c d) hc)
          (fun (b : β) => fun (hb : And (R a b) (S b c)) =>
            Exists.intro β (fun (b2 : β) => And (R a b2) (Exists γ (fun (c2 : γ) => And (S b2 c2) (T c2 d)))) b
              (And.intro (R a b) (Exists γ (fun (c2 : γ) => And (S b c2) (T c2 d)))
                (And.left (R a b) (S b c) hb)
                (Exists.intro γ (fun (c2 : γ) => And (S b c2) (T c2 d)) c
                  (And.intro (S b c) (T c d) (And.right (R a b) (S b c) hb)
                    (And.right (Exists β (fun (b2 : β) => And (R a b2) (S b2 c))) (T c d) hc))))))

-- U7 函数复合保单射 / 保满射
def Fun.comp (α : Type) (β : Type) (γ : Type) (g : β -> γ) (f : α -> β) : α -> γ :=
  fun (x : α) => g (f x)

def Injective (α : Type) (β : Type) (f : α -> β) : Prop :=
  forall (x : α), forall (y : α), Eq.{1} β (f x) (f y) -> Eq.{1} α x y

def Surjective (α : Type) (β : Type) (f : α -> β) : Prop :=
  forall (y : β), Exists α (fun (x : α) => Eq.{1} β (f x) y)

theorem comp_injective (α : Type) (β : Type) (γ : Type) (g : β -> γ) (f : α -> β)
    (hg : Injective β γ g) (hf : Injective α β f) : Injective α γ (Fun.comp α β γ g f) :=
  fun (x : α) => fun (y : α) => fun (h : Eq.{1} γ (g (f x)) (g (f y))) => hf x y (hg (f x) (f y) h)

theorem comp_surjective (α : Type) (β : Type) (γ : Type) (g : β -> γ) (f : α -> β)
    (hg : Surjective β γ g) (hf : Surjective α β f) : Surjective α γ (Fun.comp α β γ g f) :=
  fun (z : γ) =>
    Exists.elim β (fun (y : β) => Eq.{1} γ (g y) z) (Exists α (fun (x : α) => Eq.{1} γ (g (f x)) z))
      (hg z)
      (fun (y : β) => fun (hy : Eq.{1} γ (g y) z) =>
        Exists.elim α (fun (x : α) => Eq.{1} β (f x) y)
          (Exists α (fun (x : α) => Eq.{1} γ (g (f x)) z))
          (hf y)
          (fun (x : α) => fun (hx : Eq.{1} β (f x) y) =>
            Exists.intro α (fun (x2 : α) => Eq.{1} γ (g (f x2)) z) x
              (Eq.subst.{1} β (fun (w : β) => Eq.{1} γ (g w) z) y (f x) (Eq.symm.{1} β (f x) y hx) hy)))

-- U8 原像保交（回拉），像只保包含（前推）
def Set.image (α : Type) (β : Type) (f : α -> β) (A : Set α) : Set β :=
  fun (y : β) => Exists α (fun (x : α) => And (A x) (Eq.{1} β (f x) y))

def Set.preimage (α : Type) (β : Type) (f : α -> β) (B : Set β) : Set α :=
  fun (x : α) => B (f x)

theorem image_subset_image (α : Type) (β : Type) (f : α -> β) (A B : Set α)
    (h : Set.subset α A B) : Set.subset β (Set.image α β f A) (Set.image α β f B) :=
  fun (y : β) => fun (hy : Exists α (fun (x : α) => And (A x) (Eq.{1} β (f x) y))) =>
    Exists.elim α (fun (x : α) => And (A x) (Eq.{1} β (f x) y))
      (Exists α (fun (x : α) => And (B x) (Eq.{1} β (f x) y)))
      hy
      (fun (x : α) => fun (hx : And (A x) (Eq.{1} β (f x) y)) =>
        Exists.intro α (fun (x2 : α) => And (B x2) (Eq.{1} β (f x2) y)) x
          (And.intro (B x) (Eq.{1} β (f x) y)
            (h x (And.left (A x) (Eq.{1} β (f x) y) hx))
            (And.right (A x) (Eq.{1} β (f x) y) hx)))
