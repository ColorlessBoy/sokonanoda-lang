-- 集合论共享库可行性探针（用今天的内核实测）
axiom False : Prop
axiom False.rec : (C : Prop) -> False -> C

-- G-02 实测：inductive 的构造子是裸名（`intro`），拿不到 `And.intro`。
-- 所以 And 走 axiom 族（与 course/unit9 一致），才有点名 And.intro / And.left。
axiom And : Prop -> Prop -> Prop
axiom And.intro : (a : Prop) -> (b : Prop) -> a -> b -> And a b
axiom And.left : (a : Prop) -> (b : Prop) -> And a b -> a
axiom And.right : (a : Prop) -> (b : Prop) -> And a b -> b

inductive Or (A B : Prop) : Prop
ctor inl (a : A) : Or A B
ctor inr (b : B) : Or A B
end

def Set (α : Type) : Type := α -> Prop
def Set.mem (α : Type) (a : α) (A : Set α) : Prop := A a
def Set.subset (α : Type) (A B : Set α) : Prop := forall (x : α), A x -> B x
def Set.empty (α : Type) : Set α := fun (x : α) => False
def Set.singleton (α : Type) (a : α) : Set α := fun (x : α) => Eq.{1} α x a
def Set.pair (α : Type) (a b : α) : Set α := fun (x : α) => Or (Eq.{1} α x a) (Eq.{1} α x b)
def Set.union (α : Type) (A B : Set α) : Set α := fun (x : α) => Or (A x) (B x)
def Set.inter (α : Type) (A B : Set α) : Set α := fun (x : α) => And (A x) (B x)
def Set.compl (α : Type) (A : Set α) : Set α := fun (x : α) => A x -> False
def Set.power (α : Type) (A : Set α) : Set (Set α) := fun (B : Set α) => Set.subset α B A

axiom Set.ext : (α : Type) -> (A : Set α) -> (B : Set α) -> Set.subset α A B -> Set.subset α B A -> Eq.{1} (Set α) A B
axiom Exists : (α : Type) -> (α -> Prop) -> Prop
axiom Exists.intro : (α : Type) -> (p : α -> Prop) -> (w : α) -> p w -> Exists α p
axiom Exists.elim : (α : Type) -> (p : α -> Prop) -> (C : Prop) -> Exists α p -> (forall (w : α), p w -> C) -> C

-- U2 必证：子集自反 / 传递 / 空集是最小元
theorem subset_refl (α : Type) (A : Set α) : Set.subset α A A :=
  fun (x : α) => fun (hx : A x) => hx

theorem subset_trans (α : Type) (A B C : Set α)
    (h1 : Set.subset α A B) (h2 : Set.subset α B C) : Set.subset α A C :=
  fun (x : α) => fun (hx : A x) => h2 x (h1 x hx)

theorem empty_subset (α : Type) (A : Set α) : Set.subset α (Set.empty α) A :=
  fun (x : α) => fun (h : False) => False.rec (A x) h

theorem not_mem_empty (α : Type) (x : α) : (Set.empty α) x -> False :=
  fun (h : False) => h

-- U2 必证：并的左右引入
theorem subset_union_left (α : Type) (A B : Set α) : Set.subset α A (Set.union α A B) :=
  fun (x : α) => fun (hx : A x) => inl (A x) (B x) hx

-- U3 必证：交/并的分配律（用外延性公理）
theorem inter_subset_left (α : Type) (A B : Set α) : Set.subset α (Set.inter α A B) A :=
  fun (x : α) => fun (h : And (A x) (B x)) => And.left (A x) (B x) h

theorem union_subset_iff (α : Type) (A B C : Set α) :
    Set.subset α (Set.union α A B) C -> And (Set.subset α A C) (Set.subset α B C) :=
  fun (h : Set.subset α (Set.union α A B) C) =>
    And.intro (Set.subset α A C) (Set.subset α B C)
      (fun (x : α) => fun (hx : A x) => h x (inl (A x) (B x) hx))
      (fun (x : α) => fun (hx : B x) => h x (inr (A x) (B x) hx))

-- U4 必证：幂集成员 = 子集（幂集定义的展开）
theorem mem_power (α : Type) (A B : Set α) : Set.power α A B -> Set.subset α B A :=
  fun (h : Set.subset α B A) => h
