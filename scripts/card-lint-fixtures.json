{
  "schema": "soko.card-lint-fixtures/1",
  "note": "知识卡覆盖门禁的红/绿对照夹具：每条判据至少一条必红、一条必绿。`--selftest` 会把绿例误报、红例不咬、声明解析分错类、基线棘轮失效都判红。改判据必须同步改这里。",
  "declarations": {
    "lib/Fixture.sokonanoda": "theorem foo_lemma (α : Type) (A : Set α) : A ⊆ A := by\n  intro x hx\n  exact hx\n\ndef bar_pred (α : Type) (x : α) : Prop := True\n\ndef SomeType (α : Type) : Type := α\n\ndef univLike {α : Type} : Set α := fun (x : α) => True\n\ndef Set.Le (α β : Type) (A : Set α) (B : Set β) : Prop := True\n\ntheorem Set.Le.refl (α : Type) (A : Set α) : A ≼ A := by\n  exact Set.Le.intro α α A A (fun x => x) (fun x => x) (fun x hx => hx)\n\ntheorem api_lemma (α : Type) (A : Set α) : A ⊆ A := by\n  intro x hx\n  exact hx\n\naxiom h : True\n"
  },
  "expected_candidates": [
    "foo_lemma",
    "bar_pred",
    "api_lemma"
  ],
  "expected_not_candidates": [
    "SomeType",
    "univLike",
    "h"
  ],
  "expected_namespaces": [
    "Set.Le"
  ],
