#!/usr/bin/env node
// 本文件提到的 `docs/**` 指针都指向**已收口删除**的设计文档（原文在 git 历史里）：要读原文用 `git log --all -- <path>`。doc-refs: history-only
// scripts/soko — harness-neutral launcher for the version-pinned sokonanoda
// binaries (CLI + language server).
//
// Why this exists: DeepSeek Harness (and any non-opencode harness) cannot inject
// a project directory into the model's PATH, and a repository cannot ship a
// startup hook. So the agent needs one committed, executable path it can call
// without any environment setup:
//
//   ./scripts/soko doctor --json
//   ./scripts/soko grade playground.sokonanoda
//   ./scripts/soko gate                 # contributors: cargo gate + course gate
//
// It resolves the binaries in the same order as `.opencode/plugins/sokonanoda.ts`
// does (explicit override → repository build → cache with a matching version marker
// → language server bundled by an installed VS Code extension → version-pinned
// download) and then execs the resolved binary, passing every argument through.
//
// Zero dependencies, no shell, cross-platform (macOS / Linux / Windows; Node is
// already present wherever DSH runs). Downloads are always pinned to the version
// in the chain below — the download URL is always tagged with that version, so
// a mutable "latest" release can never be picked up. Set SOKONANODA_OFFLINE=1 to
// refuse network access, SOKONANODA_BIN / SOKONANODA_LSP_BIN to override the
// resolved path, SOKONANODA_CACHE_DIR to relocate the cache.
//
// The version pin has its own chain (WO-001 / G-11 + G-16). A course repository
// has no `Cargo.toml`, so the pin is: `$SOKONANODA_VERSION` (release tag, with
// or without a leading `v`) → `<repo>/sokonanoda-version.txt` →
// `<repo>/sokonanoda.toml`'s `requires` → `<repo>/Cargo.toml`. Every source that
// is *present* must agree on major.minor, and two files that disagree are a
// named-file error rather than a silent winner. Without a pinned version there
// is no such thing as a matching cache entry, so the launcher refuses to run a
// cached or repository binary instead of guessing.
// Design: docs/design/deepseek-harness.md (H1); docs/design/onboarding.md.

import { spawnSync } from 'node:child_process'
import {
  chmodSync,
  copyFileSync,
  existsSync,
  mkdirSync,
  mkdtempSync,
  readFileSync,
  readdirSync,
  rmSync,
  statSync,
  writeFileSync,
} from 'node:fs'
import { tmpdir } from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

/// Default release download base; `SOKONANODA_RELEASE_BASE` overrides it (the
/// same switch the CLI's own downloader reads — crates/cli/src/env/target.rs).
const DEFAULT_RELEASES = 'https://github.com/ColorlessBoy/sokonanoda-lang/releases/download'

function releaseBase() {
  return process.env.SOKONANODA_RELEASE_BASE || DEFAULT_RELEASES
}

const HERE = path.dirname(fileURLToPath(import.meta.url))
const REPO = path.dirname(HERE)

/// **改动过的 crate**（`gate --fast` 的判据）：工作区里被改/新增的文件落在哪个
/// `crates/<dir>` 下，就返回那个 crate 的 **package 名**（`crates/kernel` 的包名
/// 是 `sokonanoda`，不是目录名——所以从各自的 `Cargo.toml` 读，不靠猜）。
///
/// 只看 `crates/`：`courses/`、`editor/`、`docs/` 的改动由**课程门禁**与
/// 集成测试覆盖，不在这个内环里（它们是提交前那一轮的事）。
function changedCrates() {
  const names = []
  let out
  try {
    // ⚠ **不只看工作区**：`gate --fast` 最常是在**提交之后**跑的，那时
    // `git diff HEAD` 是空的 ⇒ 会静默跳过所有单测（实测踩到：提交后跑 --fast，
    // 它打印"crates/ 下没有改动"）。所以取三段并集：
    //   ① 相对 **origin/main** 的差异（本轮已提交的改动）
    //   ② 工作区未提交的改动
    //   ③ 未跟踪的新文件
    // origin/main 不在（新克隆/无远端）时退回 `HEAD~1`，再不行就只看工作区。
    let base = 'origin/main'
    if (spawnSync('git', ['rev-parse', '--verify', '--quiet', base], { cwd: REPO }).status !== 0) {
      base = 'HEAD~1'
    }
    out = spawnSync('git', ['diff', '--name-only', `${base}...HEAD`], {
      cwd: REPO,
      encoding: 'utf8',
    })
    const working = spawnSync('git', ['diff', '--name-only', 'HEAD'], { cwd: REPO, encoding: 'utf8' })
    const untracked = spawnSync('git', ['ls-files', '--others', '--exclude-standard'], {
      cwd: REPO,
      encoding: 'utf8',
    })
    const files = `${out.stdout || ''}\n${working.stdout || ''}\n${untracked.stdout || ''}`.split('\n')
    for (const f of files) {
      const m = /^crates\/([^/]+)\//.exec(f.trim())
      if (!m) continue
      const manifest = path.join(REPO, 'crates', m[1], 'Cargo.toml')
      try {
        const line = readFileSync(manifest, 'utf8').split('\n').find((l) => l.startsWith('name ='))
        const name = line && /"([^"]+)"/.exec(line)
        if (name && !names.includes(name[1])) names.push(name[1])
      } catch {
        /* 没有清单就不是 crate */
      }
    }
  } catch {
    /* git 不在也不该让 gate 挂——退回"什么都不跑"由调用方决定 */
  }
  return names
}

// ── environment facts ────────────────────────────────────────────────────────

function cacheDir() {
  if (process.env.SOKONANODA_CACHE_DIR) return process.env.SOKONANODA_CACHE_DIR
  const home = process.env.HOME ?? process.env.USERPROFILE ?? ''
  return path.join(home, '.local', 'share', 'sokonanoda', 'bin')
}

function binaryName(base) {
  return process.platform === 'win32' ? `${base}.exe` : base
}

/// VS Code / vsce target for this host (the marker vocabulary too).
function platformTarget() {
  const { platform, arch } = process
  if (platform === 'darwin') return arch === 'arm64' ? 'darwin-arm64' : 'darwin-x64'
  if (platform === 'linux') {
    const alpine = existsSync('/etc/alpine-release')
    if (arch === 'arm64') return alpine ? 'alpine-arm64' : 'linux-arm64'
    return alpine ? 'alpine-x64' : 'linux-x64'
  }
  if (platform === 'win32') return arch === 'arm64' ? 'win32-arm64' : 'win32-x64'
  return undefined
}

/// Rust target triple used in release asset names.
function rustTriple() {
  switch (platformTarget()) {
    case 'darwin-arm64': return 'aarch64-apple-darwin'
    case 'darwin-x64': return 'x86_64-apple-darwin'
    case 'linux-x64': return 'x86_64-unknown-linux-gnu'
    case 'linux-arm64': return 'aarch64-unknown-linux-gnu'
    case 'alpine-x64': return 'x86_64-unknown-linux-musl'
    case 'alpine-arm64': return 'aarch64-unknown-linux-musl'
    case 'win32-x64': return 'x86_64-pc-windows-msvc'
    case 'win32-arm64': return 'aarch64-pc-windows-msvc'
    default: return undefined
  }
}

function offline() {
  return Boolean(process.env.SOKONANODA_OFFLINE)
}

/// `"x.y.z"` / `"x.y"` / an optional leading `v`; anything else is not a version.
function parseVersion(text) {
  const match = /^v?(\d+)\.(\d+)(?:\.(\d+))?$/.exec(String(text).trim())
  if (!match) return undefined
  const [major, minor] = [Number(match[1]), Number(match[2])]
  return {
    major,
    minor,
    patch: match[3] === undefined ? undefined : Number(match[3]),
    text: match[3] === undefined ? `${major}.${minor}` : `${major}.${minor}.${match[3]}`,
  }
}

function readTextFile(file) {
  try {
    return readFileSync(file, 'utf8')
  } catch {
    return undefined
  }
}

/// A download anchor is a *complete* version: the release tag is `v0.58.0`, so
/// `0.58` can never become one (that is the "constraint, not a pin" case).
function fullVersion(text) {
  const parsed = parseVersion(text)
  return parsed && parsed.patch !== undefined ? parsed : undefined
}

/// A version pin in a file: the first line that is exactly a version. Comments
/// and blank lines are allowed so a generated file stays human-editable.
function versionFromText(file) {
  const text = readTextFile(file)
  if (text === undefined) return undefined
  for (const line of text.split(/\r?\n/)) {
    const value = line.trim()
    if (value.startsWith('#') || !value) continue
    const found = fullVersion(value)
    if (found) return found
    return { invalid: value }
  }
  return undefined
}

/// The three-key manifest is parsed with a *minimal* single-line reader, not a
/// TOML parser: the launcher is zero-dependency Node and must not spawn a
/// binary it has not resolved yet. Only a top-level `requires` is read.
function manifestRequires(file) {
  const text = readTextFile(file)
  if (text === undefined) return undefined
  for (const line of text.split(/\r?\n/)) {
    const value = /^\s*requires\s*=\s*["']([^"']+)["']/.exec(line)?.[1]
    if (value !== undefined) return value.trim()
  }
  return undefined
}

function cargoVersion(file) {
  const text = readTextFile(file)
  if (text === undefined) return undefined
  return text.match(/^version = "([^"]+)"/m)?.[1]?.trim()
}

function candidateFile(name) {
  return path.join(REPO, name)
}

/// The files the chain looked for, so every message can name them.
function versionSourceFiles() {
  return {
    env: 'SOKONANODA_VERSION',
    versionTxt: candidateFile('sokonanoda-version.txt'),
    manifest: candidateFile('sokonanoda.toml'),
    cargo: candidateFile('Cargo.toml'),
  }
}

/// How to pin a version, spelled out for the operator (the actionable half of
/// every refusal below).
function pinAdvice() {
  const files = versionSourceFiles()
  return (
    `Pin the toolchain: export SOKONANODA_VERSION=x.y.z, or write a complete version to\n` +
    `  ${files.versionTxt} (one line), or set requires = "x.y.z" in ${files.manifest}.`
  )
}

function versionError(message) {
  return { message: `${message}\n${pinAdvice()}` }
}

/// The version source chain (WO-001): `$SOKONANODA_VERSION` → the repository's
/// own `sokonanoda-version.txt` → `requires` in `sokonanoda.toml` → `Cargo.toml`.
/// `REPO` is the *launcher's* repository (a vendored launcher points at the
/// course repository), never `cwd`.
///
/// Returns `{version?, source?, constraint?, error?}`:
///   * every source that is present must agree on major.minor, otherwise this is
///     a named-file error — never a silent winner;
///   * `requires = "0.58"` is a constraint, not a download anchor, so it can
///     satisfy a marker check but never build a `v0.58` release URL;
///   * no useful source at all ⇒ no `version`: the caller must refuse to run a
///     cached/repository binary rather than guess an expected version (G-16).
function versionSource() {
  const found = []
  const problems = []
  const push = (source, raw) => {
    if (raw === undefined) return
    const parsed = fullVersion(raw)
    if (!parsed) {
      problems.push({ source, raw })
      return
    }
    found.push({ source, version: parsed })
  }

  push('env', process.env.SOKONANODA_VERSION)

  const files = versionSourceFiles()
  const fromTxt = versionFromText(files.versionTxt)
  if (fromTxt?.invalid !== undefined) problems.push({ source: 'version.txt', raw: fromTxt.invalid })
  else if (fromTxt) found.push({ source: 'version.txt', version: fromTxt })

  let constraint
  const required = manifestRequires(files.manifest)
  if (required !== undefined) {
    const parsed = parseVersion(required)
    if (parsed) constraint = parsed
    else problems.push({ source: 'manifest.requires', raw: required })
  }

  const cargo = cargoVersion(files.cargo)
  if (cargo !== undefined) push('Cargo.toml', cargo)

  if (problems.length) {
    return {
      constraint: constraint?.text,
      error: versionError(
        problems
          .map(problem => `${problem.source}: "${problem.raw}" is not a version (expected x.y.z).`)
          .join('\n'),
      ),
    }
  }

  const anchors = [...found]
  if (constraint) {
    if (constraint.patch !== undefined) anchors.push({ source: 'manifest.requires', version: constraint })
  }
  if (!anchors.length) {
    const files = versionSourceFiles()
    if (constraint) {
      return {
        constraint: constraint.text,
        error: versionError(
          `sokonanoda.toml requires ${constraint.text} — a major.minor *constraint*, not a version pin:\n` +
            `  there is no release tag for it (${releaseBase()}/v${constraint.text}/ is not a release).\n` +
            `  ${files.manifest} keeps requires = "${constraint.text}" as the project contract.`,
        ),
      }
    }
    return {
      error: versionError(
        `no version source found. Looked for:\n` +
          `  $SOKONANODA_VERSION (unset)\n` +
          `  ${files.versionTxt} (missing)\n` +
          `  ${files.manifest} + requires (missing)\n` +
          `  ${files.cargo} (missing)`,
      ),
    }
  }

  // Every present source has to speak about the same major.minor.
  const pairs = new Set(anchors.map(entry => `${entry.version.major}.${entry.version.minor}`))
  if (pairs.size > 1) {
    return {
      constraint: constraint?.text,
      error: versionError(
        `version sources disagree:\n` +
          anchors
            .map(anchor => `  ${anchor.source}: ${anchor.version.text}`)
            .join('\n') +
          `\nUpdate them so every pin names the same major.minor.`,
      ),
    }
  }

  const winner = anchors.find(anchor => anchor.source !== 'manifest.requires') ?? anchors[0]
  return { version: winner.version, source: winner.source, constraint: constraint?.text }
}

/// The repository version every resolution must agree with (`string`), kept for
/// the call sites that only need the number. `undefined` when there is no pin —
/// callers must then refuse to exec rather than guess (see `versionSource`).
function repoVersion() {
  return versionSource().version?.text
}
function markerPath(base) {
  return path.join(cacheDir(), `${base}.version`)
}

function readMarker(base) {
  try {
    return readFileSync(markerPath(base), 'utf8').trim()
  } catch {
    return undefined
  }
}

/// A cache entry is usable only when its marker is `<version> <target>` — the
/// **one canonical vocabulary of this slot** (`crates/cli/src/env/target.rs`
/// `expected_marker`; here `markerExpected` / `writeMarker`).
///
/// ⚠ Both of the VSIX's write ends in `editor/vscode/server.js` are **now
/// same-source with it** (LSP slot: `serverMarkerValue` → `writeServerMarker`;
/// CLI slot: `installBundledCli`) ⇒ nothing the extension writes gets judged
/// `cache(STALE: …)` any more. Same-source is not tidiness: on 2026-10-15 LINK-B
/// measured the real accident this line used to describe — "Install CLI" wrote
/// the bare `<version>` ⇒ a **usable** binary was refused exec ✗. It was fixed
/// by aligning the writer (markC `a5feb8b5`), **never** by dropping the `target`
/// half — that half is what stops "same version, wrong platform", so relaxing it
/// here would loosen `canExec` ✗.
function markerMatches(base, version) {
  return markerExpected(version, readMarker(base))
}

/// True when a cached marker can be verified against the pinned version. A
/// constraint (`0.58`) accepts any patch of that release line; an anchor
/// (`0.58.0`) accepts exactly the marker its own download writes — never an
/// arbitrary other patch, which is the drift this guard exists for.
function markerExpected(version, marker) {
  const target = platformTarget()
  if (!target || !version || typeof marker !== 'string') return false
  const fields = marker.trim().split(/\s+/)
  if (fields[1] !== target) return false
  const found = parseVersion(fields[0])
  if (!found) return false
  if (found.major !== version.major || found.minor !== version.minor) return false
  return version.patch === undefined || found.patch === version.patch
}

function writeMarker(base, version) {
  writeFileSync(markerPath(base), `${version} ${platformTarget()}\n`)
}

// ── resolution chain ─────────────────────────────────────────────────────────

/// Every contributor build on disk (`<cargo target dir>|<repo>/target` ×
/// `release|debug`)，**release 优先、同 profile 内按 mtime 新者优先**。
///
/// ⚠ **必须认 `CARGO_TARGET_DIR`**（2026-10-12 接口 agent 提交 `SUB-cargo-target-dir`）：
/// `scripts/agent-worktree.sh new` 打印的唯一推荐路径是
/// `eval "$(scripts/compile-cache.py env <id>)"`，而那一行导出的正是
/// `CARGO_TARGET_DIR=<主 checkout>/.cache/compile/targets/<id>` ⇒ worktree 里自己刚编好的
/// 二进制在 `<repo>/target/` **根本不存在** ⇒ 旧实现（只看 `REPO/target`）解析不到
/// `cli`/`lsp`（实测两者都是空对象）、离线时直接判"没有"，AGENTS.md 承诺的解析顺序
/// "版本匹配的仓库构建 → 缓存 → 下载"在受管环境下不成立 ✗。
///
/// ⚠ **`release` 必须优先于 `debug`**（2026-10-14 BUILD-Q，坑 2 的第一层）：
/// 旧实现跨 profile **只按 mtime 取最新** ⇒ 刚 `cargo build -p sokonanoda-cli`
/// （debug，21s）的那份**慢**二进制会**遮蔽**稍旧的 release ✗ —— 同一份源码、
/// **同一个版本号**（`--version` 分辨不出来），可代价是实打实的：课程门禁
/// （258 个目标、每个一次 `grade`）实测从**约 1–2 分钟**变成 **>20 分钟**
/// ⇒ 撞上调用方的超时（`timeout` 124）⇒ **假红换成了超时** ✗。
/// 口径：**同 profile 内仍按 mtime 取最新**（旧语义保留 ✓），跨 profile 改成
/// **release 先**；debug 只在"没有 release"或"release 版本对不上"时才会被选中 ✓
/// （`repoBuildForVersion` 逐个试 ⇒ 不许因为偏爱 release 而丢掉一棵**能用的** debug 树 ✗）。
function repoBuildCandidates(base) {
  const name = binaryName(base)
  const roots = []
  const custom = process.env.CARGO_TARGET_DIR
  if (custom) {
    // `CARGO_TARGET_DIR` 允许相对路径（相对**当前工作目录**，cargo 的口径）⇒ 先 resolve ✓
    roots.push(path.resolve(custom))
  }
  if (!roots.includes(path.join(REPO, 'target'))) roots.push(path.join(REPO, 'target'))
  const found = []
  for (const root of roots) {
    for (const profile of ['release', 'debug']) {
      const candidate = path.join(root, profile, name)
      try {
        found.push({ path: candidate, profile, mtime: statSync(candidate).mtimeMs })
      } catch {
        // not built
      }
    }
  }
  const rank = (c) => (c.profile === 'release' ? 0 : 1)
  return found.sort((a, b) => rank(a) - rank(b) || b.mtime - a.mtime)
}

/// 首选的那份贡献者构建（release 优先）。返回**对象**（`buildIdentity` 要 mtime）✓
/// —— 与 `repoBuildPath()`/`repoBuildForVersion()` 要的**路径字符串**是两条契约，别混 ✗。
function repoBuild(base) {
  return repoBuildCandidates(base)[0]
}

/// Semver-ish tuple from an extension folder name.
function entryVersion(entry) {
  const match = /^sokonanoda-lang\.sokonanoda-(\d+)\.(\d+)\.(\d+)/.exec(entry)
  if (!match) return undefined
  return [Number(match[1]), Number(match[2]), Number(match[3])]
}

/// Folder names VS Code marked for deletion; never resolve those.
function obsoleteEntries(root) {
  try {
    const marked = JSON.parse(readFileSync(path.join(root, '.obsolete'), 'utf8'))
    return new Set(Object.keys(marked).filter(name => marked[name]))
  } catch {
    return new Set()
  }
}

function compareVersion(a, b) {
  for (let i = 0; i < 3; i++) {
    if (a[i] !== b[i]) return a[i] - b[i]
  }
  return 0
}

/// Every VS Code-family extension directory this host may have sokonanoda in.
/// **一处定义**（`extensionServer` 与 `prune` 共用 ✓）：漏一个根 = `prune` 清不干净、
/// 或解析链看不见一份已装的扩展，两个 bug 同源 ✗。
function extensionRoots() {
  const home = process.env.HOME ?? process.env.USERPROFILE ?? ''
  return [
    '.vscode/extensions',
    '.vscode-insiders/extensions',
    '.vscode-oss/extensions',
    '.cursor/extensions',
    '.windsurf/extensions',
    '.vscode-server/extensions',
  ].map(rel => path.join(home, rel))
}

/// The version VS Code is **currently using** in `root`（`extensions.json`）。
/// `prune` 拿它当"**不许删**"的硬约束（判据 ③：正在被用的那份删掉 = 编辑器下次
/// 启动少一个扩展 ✗）；解析链不消费它 ✓。
function extensionInUse(root) {
  try {
    const listed = JSON.parse(readFileSync(path.join(root, 'extensions.json'), 'utf8'))
    const entry = (Array.isArray(listed) ? listed : []).find(
      e => e?.identifier?.id === 'sokonanoda-lang.sokonanoda',
    )
    return typeof entry?.version === 'string' ? entry.version : undefined
  } catch {
    return undefined
  }
}

/// Every `sokonanoda-lang.sokonanoda-*` directory in `root`, with the version from
/// its name and whether VS Code marked it obsolete. Non-sokonanoda entries are
/// never returned ⇒ `prune` 的删除面**从构造上**只可能是本扩展的目录 ✓。
function sokonanodaExtensionDirs(root) {
  let entries
  try {
    entries = readdirSync(root)
  } catch {
    return []
  }
  const obsolete = obsoleteEntries(root)
  const dirs = []
  for (const entry of entries) {
    if (!entry.startsWith('sokonanoda-lang.sokonanoda-')) continue
    const version = entryVersion(entry)
    if (!version) continue
    dirs.push({
      name: entry,
      version,
      path: path.join(root, entry),
      obsolete: obsolete.has(entry),
    })
  }
  return dirs
}

/// The whole "version scatter" inventory `prune` reports (and, with `--yes`,
/// repairs): per extension root the surplus dirs + dangling `.obsolete` entries,
/// and the two cache markers against the pin. **Read-only** — no writes here ✓.
///
/// Why a command and not "the extension cleans itself"（`SUB-no-version-cleanup-command`）:
/// `code --install-extension` never removes the previous version — VS Code only
/// records it in `.obsolete` and, on some platforms, never deletes it ⇒ N manual
/// installs leave N directories ✗. A running extension cannot delete its own
/// siblings (it cannot even know which one is running, and deleting behind
/// VS Code's bookkeeping races its own cleanup) ⇒ the **launcher** is the only
/// place with both the knowledge (the pin) and the right to delete ✓.
///
/// Keeper rule（判据 ①/③）：① the version `extensions.json` says VS Code is
/// **using** is never removed; ② the newest **non-obsolete** dir matching the pin
/// is kept; ③ fall back to the newest non-obsolete, then the newest. Everything
/// else is surplus. When the pin matches nothing on disk, the newest is still
/// kept — pruning must not leave the user with zero extensions ✗.
function pruneInventory(pin) {
  const version = pin.version
  const roots = []
  for (const root of extensionRoots()) {
    if (!existsSync(root)) continue
    const dirs = sokonanodaExtensionDirs(root)
    const danglingObsolete = [...obsoleteEntries(root)].filter(
      name => name.startsWith('sokonanoda-lang.sokonanoda-') && !existsSync(path.join(root, name)),
    )
    if (!dirs.length && !danglingObsolete.length) continue
    const inUse = extensionInUse(root)
    const keep = new Set()
    const used = inUse ? dirs.find(dir => dir.version.join('.') === inUse) : undefined
    if (used) keep.add(used.name)
    const newest = list => [...list].sort((a, b) => compareVersion(b.version, a.version))
    const matching = version
      ? newest(dirs.filter(dir => !dir.obsolete && versionSatisfied(version, dir.version.join('.'))))
      : []
    const best = matching[0] ?? newest(dirs.filter(dir => !dir.obsolete))[0] ?? newest(dirs)[0]
    if (best) keep.add(best.name)
    roots.push({
      root,
      inUse,
      dirs,
      keep: dirs.filter(dir => keep.has(dir.name)).map(dir => dir.name),
      remove: dirs.filter(dir => !keep.has(dir.name)).map(dir => dir.name),
      danglingObsolete,
      // 保留的那一份**是否就是版本钉**（`prune` 只清多余、**不装**新版 ⇒ 这一格
      // 可能是 false，要如实说，并给装 VSIX 的出路 —— 静默会让人以为"统一了" ✗）。
      pinMatched: Boolean(
        version && dirs.some(dir => keep.has(dir.name) && versionSatisfied(version, dir.version.join('.'))),
      ),
    })
  }
  const markers = {
    cli: readMarker('sokonanoda'),
    lsp: readMarker('sokonanoda-lsp'),
    expected: version ? `${version.text} ${platformTarget()}` : undefined,
  }
  markers.unified =
    markerMatches('sokonanoda', version) && markerMatches('sokonanoda-lsp', version)
  return { roots, markers }
}

/// Drop the sokonanoda `.obsolete` entries that point at a directory that is
/// gone (or is being removed in this same run). VS Code's bookkeeping is
/// append-only and never prunes itself ⇒ 15 stale entries survive every cleanup ✗.
/// Returns the names dropped; **only rewrites the file when something dropped** ✓.
function pruneObsolete(root, removing) {
  const file = path.join(root, '.obsolete')
  let marked
  try {
    marked = JSON.parse(readFileSync(file, 'utf8'))
  } catch {
    return []
  }
  if (!marked || typeof marked !== 'object') return []
  const dropped = []
  for (const name of Object.keys(marked)) {
    if (!name.startsWith('sokonanoda-lang.sokonanoda-')) continue
    if (existsSync(path.join(root, name)) && !removing.has(name)) continue
    delete marked[name]
    dropped.push(name)
  }
  if (dropped.length) writeFileSync(file, `${JSON.stringify(marked, null, 2)}\n`)
  return dropped
}

/// 机器可读的"版本不统一"读数 —— `doctor --json` 与 `prune --json` **同一份形状** ✓
/// （`AGENTS.md` 硬规则 0(b)：同一件事只有一处定义，否则两个视图会漂移 ✗）。
function versionScatter() {
  const inv = pruneInventory(versionSource())
  return {
    extension_roots: inv.roots.map(r => ({
      root: r.root,
      in_use: r.inUse,
      keep: r.keep,
      remove: r.remove,
    })),
    surplus: inv.roots.reduce((n, r) => n + r.remove.length, 0),
    dangling_obsolete: inv.roots.reduce((n, r) => n + r.danglingObsolete.length, 0),
    cache: inv.markers,
    unified: inv.markers.unified && inv.roots.every(r => !r.remove.length && !r.danglingObsolete.length),
  }
}

/// `doctor` 的"版本不统一"警告（**只报告、不改 `ready`**）。空数组 = 干净 ⇒
/// 不输出任何东西（干净时刷屏会让真正的警告贬值 ✗）。
function scatterWarning(scatter) {
  if (scatter.unified) return []
  const lines = [
    `  versions: NOT unified — ${scatter.surplus} surplus extension dir(s) · ` +
      `${scatter.dangling_obsolete} dangling .obsolete entr(ies) · ` +
      `cache ${scatter.cache.unified ? 'unified' : 'markers differ'}\n`,
  ]
  for (const r of scatter.extension_roots) {
    if (r.remove.length) {
      lines.push(`    ${r.root}: keep ${r.keep.join(', ') || '(none)'} · remove ${r.remove.length}\n`)
    }
  }
  lines.push('    Next: `scripts/soko prune` (dry-run) then `scripts/soko prune --yes`\n')
  return lines
}

/// Server bundled by an installed VS Code extension (zero network). Picks the
/// highest version rather than the newest mtime: several versions stay on disk.
///
/// ⚠ **版本匹配优先**（2026-10-15 LINK-B，照 `.opencode/plugins/sokonanoda.ts`
/// 的 CHAIN-X 口径 ✓）：只按"目录名里版本最大"挑 ⇒ 仓库钉 0.90.0、盘上只有 0.83.0
/// 的扩展时会**静默**拿它当语言服务器 ✗ —— 与缓存 marker 同一条纪律：**没校验过的
/// 产物不许 exec**（G-16）✓。
/// ⚠ **与插件有意不同的一处**（写清楚，免得下一个人"对齐"回去 ✗）：一份都不匹配
/// 时插件仍返回最高的（编辑器没有"换个引擎"的选项，必须能启动 ✓），**启动器不给**
/// —— 它还有下载/拒绝两条路，跑一份不属于这棵树的引擎会让判卷静默错 ✗。
/// 返回 `{path, version, matched}`：`matched:false` **只用于拒绝时的点名**，
/// `probe()` 不会把它当链接交出去 ✓（`canExec` 只认匹配的那份 ⇒ 语义不松 ✓）。
function extensionServer(target, version) {
  const roots = extensionRoots()
  const name = binaryName('sokonanoda-lsp')
  const candidates = []
  for (const root of roots) {
    if (!existsSync(root)) continue
    let entries
    try {
      entries = readdirSync(root)
    } catch {
      continue
    }
    const obsolete = obsoleteEntries(root)
    for (const entry of entries) {
      if (!entry.startsWith('sokonanoda-lang.sokonanoda-')) continue
      if (obsolete.has(entry)) continue
      const candidate = path.join(root, entry, 'bin', target, name)
      try {
        candidates.push({ path: candidate, version: entryVersion(entry), mtime: statSync(candidate).mtimeMs })
      } catch {
        // no binary for this target
      }
    }
  }
  candidates.sort((a, b) => {
    if (a.version && b.version) return compareVersion(b.version, a.version) || b.mtime - a.mtime
    if (a.version) return -1
    if (b.version) return 1
    return b.mtime - a.mtime
  })
  const matching = candidates.filter(candidate =>
    versionSatisfied(version, candidate.version ? candidate.version.join('.') : ''),
  )
  const best = (matching.length ? matching : candidates)[0]
  if (!best) return undefined
  return { path: best.path, version: best.version, matched: matching.length > 0 }
}

/// Why the last download attempt failed, for the operator-facing message.
/// Silence here is what turns "network needs a proxy" into a mystery.
let lastDownloadError

/// The URL the last download attempt actually asked for（`SUB-soko-update-cli-404`）:
/// "fetch failed: HTTP 404" without the URL leaves the operator unable to tell
/// *what* was missing — and the 404 was in fact a URL the launcher built wrong,
/// not a missing asset. Always print what was requested.
let lastDownloadUrl

/// The extension bundle the last probe **saw but refused** (version mismatch).
/// The link is version-checked, so a user who *has* the extension installed must
/// still be told why it was not used — otherwise the refusal reads as "nothing
/// resolved" and the obvious question ("I have the VSIX!") has no answer ✗.
let extensionNearMiss

/// Fetch the tarball bytes. Node's `fetch` ignores HTTPS_PROXY, while a machine
/// behind a proxy usually has a `curl` that honours it (and `curl` also handles
/// the corporate CA bundle), so try curl first when it exists.
function fetchTarball(url) {
  if (!process.env.SOKONANODA_NO_CURL) {
    const viaCurl = spawnSync(
      'curl',
      ['-fsSL', '--retry', '2', '--connect-timeout', '20', '--max-time', '600', '-o', '-', url],
      { maxBuffer: 512 * 1024 * 1024 },
    )
    if (viaCurl.status === 0 && viaCurl.stdout?.length) return viaCurl.stdout
    lastDownloadError = `curl exit ${viaCurl.status ?? 'n/a'}: ${(viaCurl.stderr ?? '').toString().trim().split('\n').pop() ?? ''}`
  }
  return fetch(url)
    .then(res => (res.ok ? res.arrayBuffer().then(buf => Buffer.from(buf)) : Promise.reject(new Error(`HTTP ${res.status}`))))
    .catch(error => {
      lastDownloadError = `fetch failed: ${error?.message ?? error}`
      return undefined
    })
}

/// Version-pinned download + extract (`curl`-or-`fetch` + `tar`; no shell).
///
/// ⚠ **`version` 必须是 `x.y.z`**（`SUB-soko-update-cli-404`，2026-10-15 用户实测）：
/// 这里是**唯一拼 release URL 的地方**，所以归一化也收在这一处 ✓。`ensure(force)`
/// 曾经把 `resolver().version`（**对象** `{major,minor,patch,text}`）直接传进来 ⇒
/// `${version}` 插值成 `[object Object]` ⇒ URL 变成
/// `…/releases/download/v[object Object]/sokonanoda-cli-<triple>.tar.gz`
/// ⇒ curl 把 `[` 当 URL glob（`bad range`，exit 3）、Node `fetch` 拿到 **HTTP 404**
/// ⇒ `scripts/soko update`（**强制刷新**那条路）**永远**写不成缓存：CLI 有仓库构建
/// 兜底所以只报错，LSP 落到 `resolve()` 那条**用 `version.text`** 的路才侥幸下成
/// ⇒ 两个 marker 从此各走各的（实测 `0.83.0` vs `0.73.0` ✗）。**非版本一律拒绝，
/// 绝不拼 URL** —— 拼出一个"看起来像 URL"的坏地址比直接报错更坏（它 404 得像
/// "资产不存在"，把人引去查 release ✗）。
async function download(base, version) {
  const triple = rustTriple()
  if (!triple) {
    lastDownloadError = `unknown Rust target for ${platformTarget() ?? process.platform}/${process.arch}`
    return undefined
  }
  if (offline()) {
    lastDownloadError = 'SOKONANODA_OFFLINE is set'
    return undefined
  }
  const anchor = fullVersion(typeof version === 'string' ? version : version?.text)
  if (!anchor) {
    lastDownloadError = `refusing to build a release URL from a non-version (${JSON.stringify(version)})`
    return undefined
  }
  const pkg = base === 'sokonanoda-lsp' ? 'sokonanoda-lsp' : 'sokonanoda-cli'
  const dest = path.join(cacheDir(), binaryName(base))
  const url = `${releaseBase()}/v${anchor.text}/${pkg}-${triple}.tar.gz`
  lastDownloadUrl = url
  lastDownloadError = undefined
  let tmp
  try {
    const bytes = await fetchTarball(url)
    if (!bytes) return undefined
    tmp = mkdtempSync(path.join(tmpdir(), 'sokonanoda-'))
    const tarball = path.join(tmp, 'asset.tar.gz')
    writeFileSync(tarball, bytes)
    const untar = spawnSync('tar', ['xzf', tarball, '-C', tmp], { stdio: 'ignore' })
    if (untar.status !== 0) {
      lastDownloadError = `tar exit ${untar.status ?? 'n/a'}`
      return undefined
    }
    const extracted = path.join(tmp, binaryName(base))
    if (!existsSync(extracted)) {
      lastDownloadError = `asset ${pkg}-${triple}.tar.gz did not contain ${binaryName(base)}`
      return undefined
    }
    mkdirSync(cacheDir(), { recursive: true })
    copyFileSync(extracted, dest)
    if (process.platform !== 'win32') {
      try {
        chmodSync(dest, 0o755)
      } catch {
        // read-only cache dir
      }
    }
    writeMarker(base, anchor.text)
    return existsSync(dest) ? dest : undefined
  } catch (error) {
    lastDownloadError = String(error?.message ?? error)
    return undefined
  } finally {
    if (tmp) rmSync(tmp, { recursive: true, force: true })
  }
}

/// The version a candidate CLI binary reports, or undefined when it cannot run
/// or does not answer `--version`.
function binaryVersion(candidate) {
  try {
    const out = spawnSync(candidate, ['--version'], { encoding: 'utf8', timeout: 10_000 })
    if (out.status !== 0) return undefined
    return /(\d+\.\d+\.\d+)/.exec(out.stdout ?? '')?.[1]
  } catch {
    return undefined
  }
}

/// True when a binary reporting `reported` satisfies the pinned version. A
/// constraint (`0.58`) is satisfied by any patch of that line; an anchor
/// (`0.58.0`) requires exactly that version.
function versionSatisfied(version, reported) {
  if (!version || !reported) return false
  if (reported === version.text) return true
  const found = parseVersion(reported)
  if (!found || found.patch === undefined) return false
  return found.major === version.major && found.minor === version.minor &&
    (version.patch === undefined || found.patch === version.patch)
}

/// A repository build is trustworthy only when it reports the pinned version.
/// A stale `target/` from an earlier round is exactly the drift this launcher
/// exists to prevent (the opencode plugin used mtime alone and would happily
function repoBuildPath(base) {
  return repoBuild(base)?.path
}

/// **源码 newer than 二进制**（2026-10-12 接口 agent 提交 `SUB-probe-build-drift`）：
/// 落地一笔修好探针所指缺口的 commit 之后，**主 checkout 的 `target/` 二进制没有重建**
/// （实测 `target/release/sokonanoda` @15:48 vs 最新 commit @19:58）⇒ 干净的**主 checkout**
/// 上跑 `r07` 得 `exit 0`（"缺口仍在"），而成同一份源码的 worktree 里得 `exit 1`（已修）
/// ⇒ **读数取决于"解析到哪个二进制"而不是 commit** ✗（正是仓库点名的病："跨轮比较任何探针
/// 读数前先确认两次读数来自同一份构建"）。判据：`crates/**/*.rs` + `Cargo.{toml,lock}` 的
/// 最大 mtime > 二进制 mtime ⇒ `stale: true`。⚠ 只报告，**不改解析顺序**（旧行为逐字节保留 ✓）。
///
/// ⚠ **要描述"会跑的那一个"**（2026-10-14 BUILD-Q，坑 1 的接缝）：`build.stale` 现在有
/// **消费者**了（`courses/set-theory/tools/check.py` 拿它决定"这次判卷算不算数" ✓）⇒
/// 它必须描述 `cli.path` 那条链接，而不是"首选的那份仓库构建" ✗ —— 偏爱 release 之后
/// 两者会在"release 版本对不上、debug 顶上"时分叉（旧实现只描述 mtime 最新的那份，
/// 而 `repoBuildForVersion` 可能选了另一份）✗。`link` 就是 `probe()`/`resolve()` 的结果 ✓。
/// ⚠ 2026-10-15 CHAIN-X：**别的链接不再由本函数顶替** —— `linkBuildIdentity()` 会把
/// 缓存/下载链接交给 `cacheLinkIdentity()`（那才是"会跑的那一个"的身份 ✓），
/// 显式 override / 扩展链接回 `undefined`（逃生门，不拿本树产物去说它 ✓）。
/// 这里的 `?? candidates[0]` 只留作**防御**（`source === 'repo-build'` 却找不到那条路径）。
function buildIdentity(base, link) {
  const candidates = repoBuildCandidates(base)
  const build = (link && link.source === 'repo-build'
    ? candidates.find((c) => c.path === link.path)
    : undefined) ?? candidates[0]
  if (!build) return undefined
  const newest = newestEngineSource()
  return {
    path: build.path,
    link: 'repo-build',
    profile: build.profile,
    mtime: new Date(build.mtime).toISOString(),
    source_newest: newest.mtime ? new Date(newest.mtime).toISOString() : undefined,
    source_newest_file: newest.file ? path.relative(REPO, newest.file) : undefined,
    stale: newest.mtime > build.mtime,
  }
}

/// 本检出里**会编进二进制**的最新引擎源（`crates/**` 的 `*.rs` 除 `tests/`、
/// `tests.rs`，加根上的 `Cargo.{toml,lock}`）。`mtime: 0` = 这棵树没有引擎源
/// （课程仓、或还没落源的检出）⇒ 调用方必须把它当成"无从比较"，不是"很旧" ✗。
///
/// ⚠ **只算会编进二进制的源**（2026-10-12 修假 stale 实测）：`crates/*/tests/**`
/// 与 `src/**/tests.rs` **不参与 release 二进制**，可它们改了照样把
/// `source_newest` 推后 ⇒ `build.stale = true` **假报**（实测：只改了一句注释的
/// `crates/cli/tests/notation.rs` ⇒ 整个仓库报"二进制陈旧" ✗，而它根本不影响产物）
/// ⇒ 假信号比没信号更坏（会让人去重建、或反过来不再信这个字段 ✗）。
function newestEngineSource() {
  let newest = 0
  let newestFile
  const consider = (p) => {
    try {
      const m = statSync(p).mtimeMs
      if (m > newest) {
        newest = m
        newestFile = p
      }
    } catch {
      // gone
    }
  }
  for (const name of ['Cargo.toml', 'Cargo.lock']) consider(path.join(REPO, name))
  const walk = (dir) => {
    let entries
    try {
      entries = readdirSync(dir, { withFileTypes: true })
    } catch {
      return
    }
    for (const ent of entries) {
      if (ent.name === 'target' || ent.name === '.git' || ent.name === '.worktrees') continue
      const full = path.join(dir, ent.name)
      if (ent.isDirectory()) {
        if (ent.name === 'tests') continue
        walk(full)
      } else if (ent.name.endsWith('.rs') && ent.name !== 'tests.rs') consider(full)
    }
  }
  walk(path.join(REPO, 'crates'))
  return { mtime: newest, file: newestFile }
}

/// **缓存/下载链接的身份**（2026-10-15 CHAIN-X，洞 `CACHE-LINK-SILENT-FALSE-REJECTS`）。
///
/// 病根（chainV 实测、CHAIN-X 复现）：`probe()` 选到缓存（marker 与版本钉一致 ✓）时，
/// `build` 块退回"首选仓库构建"**只作诊断** ⇒ 这棵树里**没有仓库构建**时它是 `null` ✗
/// ⇒ **零信号**：`version --json` 分不出"跑的是本树编的引擎"还是"跑的是发布/缓存产物" ✗。
/// 实测夹具（CHAIN-X）：缓存里放一份 **0.90.0 但 10-13 编的**引擎（早于 10-14/15 的
/// front 修复）⇒ 课程门禁把它当"当前引擎"判出**成批假判负**（6/6 解答判负、
/// 单目标 `rejected=1 checked=0`），而 `build` 是 `null`、`check.py` 又只看
/// `source === 'repo-build'` ⇒ 一路静默 ✓。
///
/// ⚠ **语义两难（本条的边界，别修过头 ✗）**：**已发布/缓存产物天然比开发中源码旧**
/// ⇒ **不许**把"缓存比源码旧"一律判 `stale`（每个课程仓/发布态都会成批假红 ✗）。
/// 但"**同版本号、不同引擎**"必须**能被区分** ⇒ 这里给的是**身份与事实**，不是判决：
///   * `link: 'cache'|'download'` —— 这条链接**不是**本检出编出来的（与 `repo-build` 的
///     可区分点 ✓）；
///   * `marker` / `mtime` —— 这份产物是谁、什么时候落盘的（`cli.marker` 另有一份 ✓）；
///   * `built_from_source: false` —— 明说"不是本树编的"；
///   * `predates_source` + `source_newest`/`source_newest_file` —— **事实**：这份产物早于
///     本检出最新的引擎源 ⇒ 它**不可能包含那些改动**（"同版本号、不同引擎"的判据 ✓）；
///   * ⚠ **`stale` 故意不给缓存链接** —— 保持它"**本树的**构建比**本树的**源码旧"的原义 ✓
///     （给了就会让 `check.py` 那种消费者把发布产物一律拒掉 ✗）。消费者要"这份算不算数"
///     就读 `predates_source`；要"能不能跑"仍读 `canExec` ✓。
function cacheLinkIdentity(base, link) {
  let mtime
  try {
    mtime = statSync(link.path).mtimeMs
  } catch {
    mtime = undefined
  }
  const newest = newestEngineSource()
  const marker = readMarker(base)
  return {
    path: link.path,
    link: String(link.source).startsWith('download') ? 'download' : 'cache',
    mtime: mtime ? new Date(mtime).toISOString() : undefined,
    marker: marker ?? undefined,
    marker_source: 'cache-marker',
    built_from_source: false,
    source_newest: newest.mtime ? new Date(newest.mtime).toISOString() : undefined,
    source_newest_file: newest.file ? path.relative(REPO, newest.file) : undefined,
    predates_source: Boolean(mtime && newest.mtime && newest.mtime > mtime),
  }
}

/// `build` 块 = **会跑的那条链接**的身份（BUILD-Q 的口径 ✓，CHAIN-X 补齐缓存那一支）。
/// 显式 override / 扩展链接回 `undefined`：那是人自己选的二进制（逃生门），
/// 拿"这棵树里的产物"去说它是误导 ✗（与 `lspBuildIdentity` 同一条口径 ✓）。
function linkBuildIdentity(base, link) {
  if (!link) return undefined
  const source = String(link.source)
  if (source === 'cache' || source.startsWith('cache(') || source.startsWith('download')) {
    return cacheLinkIdentity(base, link)
  }
  if (source === 'repo-build') return buildIdentity(base, link)
  return undefined
}

/// run it).
function repoBuildForVersion(base, version) {
  const candidates = repoBuildCandidates(base)
  if (!candidates.length) return undefined
  if (!version) return undefined
  if (base !== 'sokonanoda') {
    // The language-server binary has no `--version`; trust a build only when
    // the CLI build of the same tree already proved the version.
    return versionSatisfied(version, binaryVersion(repoBuildPath('sokonanoda') ?? ''))
      ? candidates[0].path
      : undefined
  }
  // ⚠ 两条契约别混（我第一版混了，两处各错一半）：
  //   * `repoBuild()` 返回**对象**（`buildIdentity` 要 mtime）；
  //   * 本函数与 `resolver.probe()` 要的是**路径字符串**（`[object Object]` 就是这么来的 ✗）；
  //   * `binaryVersion()` 也要**路径字符串**（传对象 ⇒ 静默回落到缓存二进制，
  //     实测 `version` 报 `cache(STALE: …0.83.0)` 而仓库构建明明在）✗。
  // ⚠ **逐个试、release 先**（2026-10-14 BUILD-Q）：偏爱 release **但不许**因此丢掉
  //   一棵版本对得上的 debug 树 ✗（实测场景：release 还是上一版的、debug 刚编对 ⇒
  //   旧口径"按 mtime 取最新"能选对，一味先看 release 反而会退到缓存/下载）。
  //   都对不上 ⇒ `undefined`（回落缓存 → 下载，旧语义逐字节保留 ✓）。
  for (const candidate of candidates) {
    if (versionSatisfied(version, binaryVersion(candidate.path))) return candidate.path
  }
  return undefined
}

/// 判据前的**一声喊**（"别让它静默地慢 / 静默地用旧构建" ✗）：`stale`（源码比
/// 二进制新 ⇒ 这次读数不属于当前 commit）与 `debug`（同一份工作慢约 2×）各一行。
///
/// ⚠ **只给人看/判据前**的入口用（`version` 人读分支 · `doctor` · `gate` · `lsp`）✓；
/// ⚠ **绝不挂到转发路径上**（`scripts/soko grade|query|course …`）✗：复现件
/// `courses/set-theory/gaps/*.sh` 把 **stderr 与 stdout 合并**成 JSON 再 `json.load`
/// （实测 C-05：`node … query check … > /tmp/c05-repro.json 2>&1`）⇒ 多一行警告
/// 就会把复现件打成 `BAD C-05: grader output is not JSON` ✗ —— 而那批脚本
/// 故意剥掉 `SOKONANODA_BIN`（它们测的就是启动器自己的解析链）⇒ 恰是最容易踩到的路。
///
/// `label`/`pkg` 是给**第二条链接**（LSP）用的（2026-10-15 `LSP-BINARY-STALE-NO-WARNING`）：
/// 不写参数时输出与旧版**逐字节相同** ✓（`label` 默认 `build`、`pkg` 默认 CLI 的包名）。
function buildWarning(identity, label = 'build', pkg = 'sokonanoda-cli') {
  const lines = []
  if (identity?.stale) {
    lines.push(
      `  ⚠ ${label}: **stale** —— 源码（${identity.source_newest_file} @ ${identity.source_newest}）` +
        `比二进制（${identity.mtime}）新 ⇒ **这次读数不属于当前 commit** ✗` +
        `（先 \`cargo build --release -p ${pkg}\` 或换一棵刚编过的树）\n`,
    )
  }
  // ⚠ **缓存/下载链接也要出声**（2026-10-15 CHAIN-X，洞 `CACHE-LINK-SILENT-FALSE-REJECTS`）：
  // 解析到缓存时 `build` 以前是 `null` ⇒ **零信号**，可"缓存里的二进制可以与仓库构建
  // **同版本号**（0.90.0）**但是更旧的引擎**" ⇒ 课程门禁拿它判出成批假判负 ✗。
  // ⚠ 只在 `predates_source` 时出声：**已发布产物天然比开发中源码旧** ⇒ 一律喊会变成
  // 噪声（正对照：源码与缓存一致时**一个字都不说** ✓）；而且这里**只喊不拦** ✓
  // （能不能跑是 `canExec` 的事；发布/缓存产物是合法链接，拦它会让课程仓全红 ✗）。
  if ((identity?.link === 'cache' || identity?.link === 'download') && identity.predates_source) {
    lines.push(
      `  ⚠ ${label}: **不是本树编的**（${identity.link} 产物 ${identity.path} @ ${identity.mtime}）——` +
        `本检出最新的引擎源是 ${identity.source_newest_file} @ ${identity.source_newest} ⇒ ` +
        `它**不可能包含那些改动**（**同版本号、不同引擎**）⇒ **这次读数不属于当前 commit** ✗\n` +
        `    ⚠ 这**不是** stale 判负（已发布/缓存产物天然比开发中源码旧 ✓）；要跑本树的引擎：\n` +
        `      cargo build --release -p ${pkg} --locked   # 无需联网，约 2 分钟\n` +
        `    要承认这次量的是"已发布/缓存的那份引擎"：` +
        `\`scripts/soko update\` 之后它仍是缓存链接，但会与源码同源 ✓\n`,
    )
  }
  if (identity?.profile === 'debug') {
    lines.push(
      `  ⚠ ${label}: **debug** 构建（${identity.path}）—— 同一份判卷比 release 慢约 2×` +
        `（课程门禁 258 个目标实测从约 1–2 分钟变成 >20 分钟）⇒ 判据请用 ` +
        `\`cargo build --release -p ${pkg}\` 的产物\n`,
    )
  }
  return lines
}

/// **LSP 的构建身份**（2026-10-15 修 `LSP-BINARY-STALE-NO-WARNING`，第十四次复核实测）。
///
/// 病根：`build` 那个块**一直只描述 CLI**（`buildIdentity('sokonanoda', cli)`）⇒
/// 「源码比二进制新」这件事**只对 CLI 出声** ✗，而**编辑器跑的是 `sokonanoda-lsp`** ✗
/// —— 实测 `target/release/sokonanoda-lsp` 是 **10-13 09:44** 的二进制，早于 10-14 的
/// 引擎身份与隐变量两族修复（两个摘要串都不含它），而 `doctor --json` 照报
/// `lsp.ready: true`、零警告 ⇒ **编辑器那条路静默跑旧引擎** ✗。这是 stale 族
/// （`STALE-BUILD-NO-CONSUMER` → `DEBUG-BUILD-SHADOWS-RELEASE`）**同一条链上的第三个链接** ✓。
///
/// ⚠ 与 `build` 的**一处有意不同**：**只在 `lsp.source === 'repo-build'` 或缓存/下载
/// 时才给**（不给"首选仓库构建"的诊断回落）—— 要的是**"跑的那份陈旧"** ✓，不是"这棵树里
/// 有份旧产物" ✗。缓存/下载那一支由 `cacheLinkIdentity` 给**身份与事实**
/// （`predates_source`，2026-10-15 CHAIN-X ✓）；显式 override 是逃生门 ⇒ 都不拿
/// "仓库构建陈旧"去吓人 ✓（与 `gate`/`check.py` 只在 repo-build 上判同口径 ✓）。
/// ⚠ **已知的粗口径**：`buildIdentity` 扫的是 `crates/**`（除 `tests/`、`tests.rs`）——
/// 对 LSP 来说，只改 `crates/cli/**` 也会报 stale（假阳性）。**有意保留**：宁可多报
/// 也不漏报 ✓（漏报 = 编辑器静默跑旧引擎，正是本条要修的洞 ✗）；消息里点名了最新的
/// 源文件，人能自己判 ✓。
function lspBuildIdentity(lsp) {
  if (!lsp) return undefined
  const source = String(lsp.source)
  if (source === 'repo-build' || source === 'cache' || source.startsWith('cache(') ||
      source.startsWith('download')) {
    return linkBuildIdentity('sokonanoda-lsp', lsp)
  }
  return undefined
}

/// **拒绝**用陈旧的仓库构建判定：一条给操作者的正解（重建 release，无需联网）。
/// 与 `check.py` 的 `Prerequisite` 同口径（那边 exit 2，这边 `gate` exit 3）✓。
function staleBuildRefusal(identity) {
  return (
    `scripts/soko: 拒绝用**陈旧的仓库构建**判定 —— ${identity.path} [repo-build, ${identity.profile}]\n` +
    `  二进制 mtime: ${identity.mtime}\n` +
    `  最新源文件:   ${identity.source_newest_file} @ ${identity.source_newest}\n` +
    `  ⇒ 源码比二进制新 ⇒ **这次判卷不属于当前 commit**（同一份源码会有两个读数）✗\n` +
    `  正解（无需联网，约 2 分钟）：cargo build --release -p sokonanoda-cli --locked\n` +
    `  想改判"已发布版本"：scripts/soko update\n`
  )
}

/// How a binary was found, for `version`/`doctor` reporting.
function resolver(base, override) {
  const cached = path.join(cacheDir(), binaryName(base))
  const pin = versionSource()
  const version = pin.version
  return {
    override,
    cached,
    pin,
    version,
    /// The cache link **as it is on disk** — verified (`cache`) or not
    /// (`cache(STALE: …)` / `cache(unverified: …)`). The unverified shapes are
    /// only ever *reported*: `canExec` is the gate that refuses them.
    cacheEntry() {
      if (!existsSync(cached)) return undefined
      const marker = readMarker(base)
      if (markerMatches(base, version)) return { path: cached, source: 'cache' }
      if (!version) {
        return {
          path: cached,
          source: `cache(${pin.constraint ? `unverified: requires ${pin.constraint}` : 'unknown repo version'}: found ${marker ?? 'no marker'})`,
        }
      }
      return { path: cached, source: `cache(STALE: expected ${version.text} ${platformTarget()}, found ${marker ?? 'no marker'})` }
    },
    /// The **VS Code extension** link（2026-10-15 LINK-B）。本文件头注释与
    /// `AGENTS.md` 一直写着这一格，`extensionServer()` 正是为它写的、`canExec()`
    /// 也留着 `extension` 分支 —— 但**没有任何调用点** ⇒ 链接是死的：通用 VSIX +
    /// 没跑过「Install CLI」+ 离线时，`scripts/soko lsp` 只能下载（或被拒）✗。
    /// ⚠ **只给语言服务器**：文档承诺的就是它（CLI 那一份由扩展自己的
    /// 「Install CLI」装进缓存 ⇒ 归缓存链接管 ✓）。
    /// ⚠ **只给版本匹配的那份**：链上其余各格都按版本钉校验过，这一格不例外 ⇒
    /// 不匹配就**当没有这一格**（只把候选记下来，拒绝时点名 ✓）。
    extensionLink() {
      if (base !== 'sokonanoda-lsp') return undefined
      const target = platformTarget()
      if (!target) return undefined
      const found = extensionServer(target, version)
      if (!found) return undefined
      if (!found.matched) {
        extensionNearMiss =
          `${found.path} [v${(found.version ?? []).join('.') || '?'}]` +
          ` —— 与版本钉 v${version?.text ?? '?'} 不匹配 ⇒ 不 exec`
        return undefined
      }
      return { path: found.path, source: 'extension' }
    },
    /// Which link of the chain wins, without downloading anything.
    probe() {
      if (override && existsSync(override)) return { path: override, source: 'override' }
      const build = repoBuildForVersion(base, version)
      if (build) return { path: build, source: 'repo-build' }
      const onDisk = this.cacheEntry()
      if (canExec(onDisk)) return onDisk
      // ⚠ 链上的下一格（头注释 / `AGENTS.md` / opencode 插件都把它排在**缓存与
      // 下载之间** ✓）：缓存缺失或 marker 对不上时才看扩展 ✓。
      const bundled = this.extensionLink()
      if (bundled) return bundled
      // Offline / failed download / constraint-only: hand back what is on disk
      // so the caller can report *what* it is — `canExec()` above is the single
      // gate that decides whether it may actually run.
      return onDisk
    },
    async resolve() {
      const found = this.probe()
      // Resolution walks the *same* order as the probe and stops at the first
      // executable link. Only a stale/missing cache needs the network, so a
      // usable override, repository build or matching cache entry never waits on
      // a download (re-downloading a binary we already have is exactly the stall
      // that made `grade` hang for a minute behind a proxy-less network).
      if (canExec(found)) return found
      if (version?.patch !== undefined) {
        const downloaded = await download(base, version.text)
        if (downloaded) return { path: downloaded, source: 'download' }
      }
      // Offline / failed download / constraint-only: hand back what is on disk
      // so the caller can report *what* it is — `canExec()` above is the single
      // gate that decides whether it may actually run.
      return found
    },
  }
}

/// The one execution gate (G-16). Only a candidate from a *trusted* source may
/// be exec'd:
///   * an explicit `SOKONANODA_BIN` / `SOKONANODA_LSP_BIN` override — the user
///     chose that binary, so its version is their business (documented escape
///     hatch; `scripts/new-course-repo.sh` used to need it);
///   * the VS Code extension bundle — it belongs to an installed extension and
///     carries its own version in its folder name;
///   * a repository build or cache entry that was verified against the pinned
///     version;
///   * a binary the launcher just downloaded for that pinned version.
/// A cache entry is *not* trusted just because it exists: without a pinned
/// version there is nothing to compare its marker to, so it must be refused
/// (that silent exec is exactly G-16).
function canExec(result) {
  if (!result) return false
  if (result.source === 'override' || result.source === 'extension') return true
  if (result.source === 'repo-build') return true
  return result.source === 'cache' || result.source.startsWith('download')
}

/// Human-readable summary of the pin, for every refusal message.
function pinReport(pin) {
  const files = versionSourceFiles()
  const lines = [
    `  expected version: ${pin.version?.text ?? 'unresolved'}${pin.version ? ` (from ${pin.source})` : ''}`,
  ]
  if (pin.constraint) lines.push(`  constraint:       requires = "${pin.constraint}" in ${files.manifest}`)
  if (pin.error) lines.push(...pin.error.message.split('\n').map(line => `  ${line}`))
  return lines.join('\n')
}

/// One refusal path for every untrusted candidate: nothing resolved, a cache
/// whose marker does not match the pin, or — G-16 — a cache that cannot be
/// verified because there is no pinned version at all. The old code rewrote the
/// probe's `cache(STALE …)` into `cache(unknown repo version)` and then exec'd
/// it, which is how a 0.55.0 binary ran inside a repository that pins 0.58.0.
function refuseUntrusted(base, found, pin) {
  const files = versionSourceFiles()
  process.stderr.write(
    `scripts/soko: refusing to run an unverified ${base} binary — ` +
      `${found ? `${found.path} [${found.source}]` : 'nothing resolved'} ` +
      `(offline=${offline() ? 'yes' : 'no'}).\n` +
      `${pinReport(pin)}\n` +
      `  cache:            ${cacheDir()} (marker: ${readMarker(base) ?? 'none'})\n` +
      (extensionNearMiss ? `  extension:        ${extensionNearMiss}\n` : '') +
      (pin.error
        ? ''
        : `Next: run \`scripts/soko update\` to refresh the cache to the pinned version, or\n` +
          `      just bumped the version in this checkout? then the *repository* build is the\n` +
          `      one that is stale — rebuild it first (no network, no release needed):\n` +
          `        cargo build -p sokonanoda-cli --bin sokonanoda   # then re-run the command\n` +
          `      otherwise fix the file named above so every pin agrees.\n`) +
      `  ${files.versionTxt} is the pin for a course repository.\n`,
  )
  return 3
}

/// The Python interpreter the course gate needs (`python3`, or Windows' `py -3`
/// / a `python` that is really Python 3). `undefined` means the gate must refuse
/// (exit 3) instead of silently skipping the course layer.
function pythonCommand() {
  const candidates =
    process.platform === 'win32'
      ? [['py', ['-3']], ['python3', []], ['python', []]]
      : [['python3', []], ['python', []]]
  for (const [cmd, args] of candidates) {
    let probe
    try {
      probe = spawnSync(cmd, [...args, '--version'], { encoding: 'utf8', timeout: 15_000 })
    } catch {
      continue
    }
    if (probe.status !== 0) continue
    const said = `${probe.stdout ?? ''}${probe.stderr ?? ''}`
    if (/Python 3\./.test(said)) return { cmd, args, version: said.trim() }
  }
  return undefined
}

// ── commands ─────────────────────────────────────────────────────────────────

/// Resolve a binary, optionally forcing a cache refresh first. The result
/// carries `refreshed` so `update` can tell "I refreshed the cache" apart from
/// "I handed you a fallback" — see the `setup`/`update` case.
async function ensure(base, override, { force = false } = {}) {
  const r = resolver(base, override)
  if (force && r.version) {
    // ⚠ `.text`（不是 `r.version`）：`download` 要的是 `x.y.z` 字符串，传对象会
    // 拼出 `v[object Object]`（`SUB-soko-update-cli-404`）。`download` 自己也归一化
    // 并拒绝非版本（单一入口的守卫），这里显式传字符串是**调用点的正确形状** ✓。
    const downloaded = await download(base, r.version.text)
    if (downloaded) return { path: downloaded, source: 'download(forced)', refreshed: true }
  }
  const result = await r.resolve()
  if (!result) return result
  // `resolve()` downloads too whenever the cache is missing or stale, so every
  // download source means the cache really was written.
  return { ...result, refreshed: result.source.startsWith('download') }
}

function report(target, result) {
  process.stdout.write(`${target}: ${result ? `${result.path} [${result.source}]` : 'unresolved'}\n`)
}

/// The **actionable** half of a download failure（`SUB-soko-update-cli-404` 判据 ③）。
///
/// ⚠ 404 与"网络不通"是**两码事**，出路也相反：老话术一律说"检查代理/网络"，
/// 而用户实测网络是好的（同一 URL 用 curl 是 200）⇒ 把人引向错误的方向 ✗。
/// `HTTP 404` 只可能意味着**这个 URL 上没有资产**：要么 release/资产名不对，
/// 要么（就是本次这个 bug）URL 本身拼错了 —— 两种都要先让人**看见 URL**，
/// 再给"离线也能自救"的那条路（仓库构建 / 缓存）✓。
function downloadAdvice(error, version) {
  if (/\bHTTP 404\b/.test(error ?? '')) {
    return (
      `Next: the release does not serve the URL above (HTTP 404). Compare it with the release's\n` +
      `      asset list before touching the network — a 404 is not a connectivity problem:\n` +
      `        gh release view v${version ?? '?'} --json assets --jq '.assets[].name'\n` +
      `      If the asset really is missing, this pin has no matching binary yet; build the\n` +
      `      repository one instead (no network, no release needed) and re-run:\n` +
      `        cargo build --release -p sokonanoda-cli --locked\n`
    )
  }
  return (
    `Next: allow network access (behind a proxy, export HTTPS_PROXY so curl can use it),\n` +
    `      or point SOKONANODA_BIN / SOKONANODA_LSP_BIN at existing binaries.\n`
  )
}

/// What a resolved link reports about **itself** (`version --json` /
/// `doctor --json`).
///
/// ⚠ **`marker` must describe this link, never the cache directory**（E1，
/// `scripts/ux-probes/lsp-probe.mjs --case E1-version-marker-misleading`）：
/// `source: "repo-build"` 旁边挂一个 **stale 缓存 marker**（实测：仓库是
/// 0.90.0，`<cache>/sokonanoda-lsp.version` 却是 0.73.0）⇒ 编辑器读 `marker`
/// 就把**缓存目录的版本**当成这份构建的版本，显示的版本是误导性的 ✗。取**诚实**
/// 的那一支（不是"标个 caveat"）：marker 按**赢的那条链接**报告 ——
///   * **缓存条目**（`cache` / `cache(STALE: …)`）⇒ marker **就是**它自己那份
///     `<version> <target>` 文件（既有语义逐字节不变，`opencode.rs` 钉着它）；
///   * **仓库构建 / 显式 override** ⇒ marker = **这条链接自述的版本 + 目标**
///     （同一个 `<version> <target>` 词汇）。CLI 自己答 `--version`；服务器二进制
///     没有 `--version`（见 `repoBuildForVersion`）⇒ 用**同树的 CLI** 自述版本，
///     那正是启动器信任这份构建的**唯一依据**（不是另立一份真相）。
///
/// `marker_source` 明说这个串从哪来（`cache-marker` / `binary-version`），
/// `cache_marker` 仍如实报告缓存目录里那份（诊断要它）—— 但它不再冒充别的链接。
function linkInfo(base, link, extra = {}) {
  const cacheMarker = readMarker(base)
  const source = link?.source
  if (!link) {
    return { path: undefined, ...extra, marker: undefined, marker_source: undefined, cache_marker: cacheMarker }
  }
  if (source === 'cache' || source.startsWith('cache(')) {
    return { path: link.path, ...extra, source, marker: cacheMarker, marker_source: 'cache-marker', cache_marker: cacheMarker }
  }
  const reported = linkVersion(base, link)
  const target = platformTarget()
  return {
    path: link.path,
    ...extra,
    source,
    marker: reported && target ? `${reported} ${target}` : undefined,
    marker_source: reported ? 'binary-version' : undefined,
    cache_marker: cacheMarker,
  }
}

/// The version a **non-cache** link reports about itself. The CLI answers
/// `--version`; the server binary has none (`repoBuildForVersion`), so a
/// repository-build server is identified by the CLI of the same tree and an
/// explicit override server is honestly `undefined`（未知就说未知，绝不借缓存
/// marker 充数 ✗）。
function linkVersion(base, link) {
  if (base === 'sokonanoda') return binaryVersion(link.path)
  if (link.source === 'repo-build') return binaryVersion(repoBuildPath('sokonanoda') ?? '')
  return undefined
}

async function main(argv) {
  const [command, ...rest] = argv
  const cliOverride = process.env.SOKONANODA_BIN
  const lspOverride = process.env.SOKONANODA_LSP_BIN

  switch (command) {
    case undefined:
    case '--help':
    case '-h':
      process.stdout.write(
        'scripts/soko — harness-neutral launcher for the pinned sokonanoda binaries\n' +
          '\n' +
          'usage:\n' +
          '  scripts/soko setup                 fetch CLI + LSP into the cache (idempotent)\n' +
          '  scripts/soko update                force-refresh both to the repo version\n' +
          '                                     (exit 3 when the cache could not be written)\n' +
          '  scripts/soko version [--json]      repo version + resolution + cache markers\n' +
          '  scripts/soko doctor [--json]       readiness report; exit 3 when not ready\n' +
          '  scripts/soko prune [--yes|--check] unify the versions on this machine: remove\n' +
          '                                     surplus VS Code extension dirs + dangling\n' +
          '                                     .obsolete entries and align the two cache\n' +
          '                                     markers (dry-run unless --yes; --check exits 3\n' +
          '                                     when something would be pruned)\n' +
          '  scripts/soko lsp                   run the language server on stdio\n' +
          '  scripts/soko mcp                   run the MCP stdio server (harness tools)\n' +
          '  scripts/soko gate                  contributor gate: cargo (fmt/clippy/test/anchor)\n' +
          '                                     + the set-theory course gate (python3; exit 3\n' +
          '                                     when python3 is missing — never a silent skip)\n' +
          '  scripts/soko <anything else…>      forwarded to the sokonanoda CLI\n' +
          '                                     e.g. grade playground.sokonanoda --json\n' +
          '\n' +
          'env: SOKONANODA_BIN / SOKONANODA_LSP_BIN (path overrides), SOKONANODA_OFFLINE=1,\n' +
          '     SOKONANODA_CACHE_DIR (default ~/.local/share/sokonanoda/bin),\n' +
          '     SOKONANODA_RELEASE_BASE (download base override),\n' +
          '     SOKONANODA_VERSION (version pin; default: <repo>/sokonanoda-version.txt →\n' +
          '     <repo>/sokonanoda.toml requires → <repo>/Cargo.toml)\n',
      )
      return 0

    case 'setup':
    case 'update': {
      const pin = versionSource()
      if (!pin.version && (cliOverride || lspOverride)) {
        // No pin, but the user brought their own binary: that is the documented
        // escape hatch, so `setup` is as done as it can be. Say what happened.
        process.stderr.write(
          `scripts/soko ${command}: no pinned version — using the explicit SOKONANODA_BIN\n` +
            'override as-is (nothing was downloaded or verified).\n',
        )
        return 0
      }
      const force = command === 'update'
      const cli = await ensure('sokonanoda', cliOverride, { force })
      const cliDownloadError = lastDownloadError
      const cliDownloadUrl = lastDownloadUrl
      const lsp = await ensure('sokonanoda-lsp', lspOverride, { force })
      const lspDownloadError = lastDownloadError
      const lspDownloadUrl = lastDownloadUrl
      report('cli', cli)
      report('lsp', lsp)
      const version = pin.version?.text
      // `cli`/`lsp` can be undefined when nothing resolved at all. `report()`
      // above already said so, and the message below is the actionable one —
      // indexing them unguarded used to throw a TypeError, which killed the
      // process and made that message unreachable. Without a pin nothing is
      // executable (`canExec`), and the message has to stay reachable — that is
      // the shape `launcher.rs` pins.
      const stale = pin.version ? [cli, lsp].filter(r => r && !canExec(r)) : []
      if (!cli || !lsp || stale.length) {
        process.stderr.write(
          `scripts/soko ${command}: could not provide matching binaries for v${version ?? '?'}\n` +
            `  target:  ${rustTriple() ?? platformTarget() ?? 'unknown'}\n` +
            `  offline: ${offline() ? 'yes (SOKONANODA_OFFLINE)' : 'no'}\n` +
            (version ? `  release: ${releaseBase()}/v${version}/\n` : '') +
            (lastDownloadUrl ? `  url:     ${lastDownloadUrl}\n` : '') +
            (lastDownloadError ? `  download: ${lastDownloadError}\n` : '') +
            (pin.error ? `${pinReport(pin)}\n` : '') +
            downloadAdvice(lastDownloadError, version),
        )
        return 3
      }
      // `update` promises the refresh itself, so a usable fallback must not
      // paper over a download that never happened. a read-only cache directory
      // (or a dead network) used to make every write fail while `update` still
      // printed a resolved path and exited 0 — the caller had no way to learn
      // that nothing was refreshed.
      if (force) {
        const missed = [
          ['cli', cli, cliDownloadError, cliDownloadUrl],
          ['lsp', lsp, lspDownloadError, lspDownloadUrl],
        ].filter(([, r]) => !r.refreshed)
        if (missed.length) {
          process.stderr.write(
            `scripts/soko update: cache NOT refreshed for v${version ?? '?'}\n` +
              missed
                .map(
                  ([name, r, error, url]) =>
                    `  ${name}: ${r.path} [${r.source}] — download: ${error ?? 'unknown error'}\n` +
                    (url ? `        url: ${url}\n` : ''),
                )
                .join('') +
              `  cache:  ${cacheDir()}\n` +
              'The binaries above are usable, so nothing else is broken — but the cache you asked\n' +
              'to refresh was not written.\n' +
              (missed.some(([, , error]) => /\bHTTP 404\b/.test(error ?? ''))
                ? downloadAdvice('HTTP 404', version)
                : 'Next: make sure the cache directory is writable and the network is reachable\n' +
                  '      (behind a proxy, export HTTPS_PROXY so curl can use it), or point\n' +
                  '      SOKONANODA_CACHE_DIR at a writable directory.\n'),
          )
          return 3
        }
      }
      return 0
    }

    case 'version': {
      const pin = versionSource()
      const cli = resolver('sokonanoda', cliOverride).probe()
      const lsp = resolver('sokonanoda-lsp', lspOverride).probe()
      if (rest.includes('--json')) {
        process.stdout.write(
          `${JSON.stringify(
            {
              version: pin.version?.text,
              version_source: pin.version ? pin.source : undefined,
              version_constraint: pin.constraint,
              version_error: pin.error?.message,
              target: platformTarget(),
              rust_target: rustTriple(),
              cache: cacheDir(),
              offline: offline(),
              cli: linkInfo('sokonanoda', cli),
              lsp: linkInfo('sokonanoda-lsp', lsp),
              // **构建身份**（2026-10-12 接口 agent 提交 `SUB-probe-build-drift`）：
              // 探针读数的可比性靠它 —— `stale: true` = 源码比二进制新 ⇒
              // **这一次读数不属于当前 commit**（先重建，或换一棵刚编过的树）。
              // ⚠ 描述**会跑的那条链接**（`cli`）✓，`profile` 明说 release/debug
              // （2026-10-14 BUILD-Q：debug 会静默慢 10×+ ⇒ 消费者要能看见它）。
              // ⚠ 2026-10-15 CHAIN-X：缓存/下载链接**不再回落成 `null`** ——
              // `linkBuildIdentity` 给的是那份产物自己的身份（`link`/`marker`/`mtime`/
              // `built_from_source: false`/`predates_source` ✓），因为"缓存里的二进制
              // 可以与仓库构建**同版本号**但是**更旧的引擎**"正是要能被区分的那一格 ✗。
              build: linkBuildIdentity('sokonanoda', cli),
              // ⚠ **LSP 也有一份**（2026-10-15 `LSP-BINARY-STALE-NO-WARNING`）：
              // 编辑器跑的是 `sokonanoda-lsp`，而上面那个块只描述 CLI ✗ ⇒
              // 「源码比二进制新」对**编辑器那条路**一直零警告 ✗（同一条链的第三个链接）。
              // `lsp_build` 在 `repo-build` 与缓存/下载链接上出现，显式 override 上不给
              // （见 `lspBuildIdentity` ✓）。
              lsp_build: lspBuildIdentity(lsp),
            },
            null,
            2,
          )}\n`,
        )
      } else {
        process.stdout.write(`scripts/soko version\n`)
        process.stdout.write(
          `  repo:   v${pin.version?.text ?? '?'}${pin.version ? ` (from ${pin.source})` : ''}` +
            ` (${platformTarget() ?? '?'}, ${rustTriple() ?? '?'})\n`,
        )
        process.stdout.write(`  cache:  ${cacheDir()}${offline() ? ' (offline)' : ''}\n`)
        report('  cli', cli)
        report('  lsp', lsp)
        // ⚠ **stale / debug / 缓存身份都必须出声**：第一个让"同一份源码两个读数"成为可能
        // （本仓最贵的坑之一），第二个让"同一份判卷慢 10×+"成为可能 ✓，
        // 第三个（2026-10-15 CHAIN-X）让"**跑的是发布/缓存产物**、不是本树引擎"可见 ✓。
        for (const line of buildWarning(linkBuildIdentity('sokonanoda', cli))) process.stdout.write(line)
        // ⚠ **编辑器那条路也要出声**（2026-10-15）：`build` 只描述 CLI ⇒ 以前
        // `sokonanoda-lsp` 陈旧时 `version` **一个字都不说** ✗。
        for (const line of buildWarning(lspBuildIdentity(lsp), 'lsp build', 'sokonanoda-lsp')) {
          process.stdout.write(line)
        }
        if (pin.error) process.stdout.write(`${pin.error.message}\n`)
      }
      // `version` is a read-only report: it always succeeds and lets the caller
      // decide. A stale marker shows up in the source text and in `doctor`.
      return 0
    }

    case 'doctor': {
      const pin = versionSource()
      const cli = await resolver('sokonanoda', cliOverride).resolve()
      const lsp = await resolver('sokonanoda-lsp', lspOverride).resolve()
      // `canExec` is the same gate the forwarded command uses, so the report
      // can never call something ready that the launcher would then refuse.
      const ready = Boolean(pin.version) && canExec(cli) && canExec(lsp)
      if (rest.includes('--json')) {
        process.stdout.write(
          `${JSON.stringify(
            {
              ready,
              version: pin.version?.text,
              version_source: pin.version ? pin.source : undefined,
              version_constraint: pin.constraint,
              version_error: pin.error?.message,
              target: platformTarget(),
              rust_target: rustTriple(),
              cache: cacheDir(),
              offline: offline(),
              launcher: path.join(REPO, 'scripts', 'soko'),
              cli: linkInfo('sokonanoda', cli, { present: Boolean(cli), ready: canExec(cli) }),
              lsp: linkInfo('sokonanoda-lsp', lsp, { present: Boolean(lsp), ready: canExec(lsp) }),
              // ⚠ **只报告、不改 `ready`**（2026-10-14 BUILD-Q）：`ready` 答的是
              // "能不能跑"，而 `stale`/`predates_source` 答的是"这份构建算不算数"——
              // 判据入口（`gate` / `check.py`）才拒绝 ✓；`doctor` 若把 stale 并进 `ready`，
              // opencode 插件的 provision 就会因为"源码刚改过"去下载/刷新，
              // 那是另一条链路的行为 ✗（`version --json` 的 `build` 与本字段同源 ✓）。
              // ⚠ 2026-10-15 CHAIN-X：缓存/下载链接给的是那份产物自己的身份
              // （`link`/`mtime`/`built_from_source`/`predates_source` ✓）——**不是** `null` ✓。
              build: linkBuildIdentity('sokonanoda', cli),
              // ⚠ **LSP 一份**（2026-10-15 `LSP-BINARY-STALE-NO-WARNING`）：同一条
              // "只报告、不改 `ready`" 的口径 ✓ —— 编辑器**必须**能启动（拒绝启动比
              // 跑一份旧引擎更坏 ✗），但要**看得见**它跑的是不是当前 commit 的引擎 ✓。
              // ⚠ 在 `repo-build` 与缓存/下载链接上出现（`lspBuildIdentity` ✓）：
              // 要的是"**跑的那份**陈旧/外来"，不是"这棵树里有份旧产物" ✗。
              lsp_build: lspBuildIdentity(lsp),
              // **版本不统一**（`SUB-no-version-cleanup-command`）：扩展目录 / 两半
              // marker 的散布。与 `stale` 同一条纪律：**只报告、不改 `ready`** ——
              // `ready` 答"能不能跑"，而"盘上有几个版本"答的是"环境干不干净"；
              // 把后者并进 `ready` 会让 opencode 的 provision 去下载/刷新 ✗
              // （那是另一条链路，且**修不了**扩展目录的堆积）✓。
              versions: versionScatter(),
            },
            null,
            2,
          )}\n`,
        )
      } else {
        process.stdout.write(`scripts/soko doctor\n`)
        process.stdout.write(
          `  version:  v${pin.version?.text ?? '?'}${pin.version ? ` (from ${pin.source})` : ''}\n`,
        )
        process.stdout.write(`  platform: ${platformTarget() ?? '?'} (rust: ${rustTriple() ?? '?'})\n`)
        process.stdout.write(`  cache:    ${cacheDir()}\n`)
        report('  cli', cli)
        report('  lsp', lsp)
        for (const line of buildWarning(linkBuildIdentity('sokonanoda', cli))) process.stdout.write(line)
        // ⚠ **LSP 的陈旧也要出声**（2026-10-15）：以前 `doctor` 只报 CLI 的构建身份，
        // 于是"编辑器跑旧引擎"这件事在就绪报告里**一个字都没有** ✗（`ready` 仍是 yes ✓
        // —— 能不能跑与算不算数是两回事，见 `--json` 分支的说明 ✓）。
        for (const line of buildWarning(lspBuildIdentity(lsp), 'lsp build', 'sokonanoda-lsp')) {
          process.stdout.write(line)
        }
        // **版本不统一要出声**（判据 ③：不许静默）——但**不**并进 `ready` ✓。
        for (const line of scatterWarning(versionScatter())) process.stdout.write(line)
        process.stdout.write(`  ready:    ${ready ? 'yes' : 'no'}\n`)
      }
      return ready ? 0 : 3
    }

    case 'prune': {
      // **一条清理环境的命令**（`SUB-no-version-cleanup-command`，用户原话
      // 「帮我清理环境吧，这种版本不统一出现好多好多次了」）。
      //
      // ⚠ **名字为什么是 `prune` 而不是 `clean`**：`scripts/soko clean` 会被
      // 转发给 `sokonanoda clean`（**编译缓存**，`build|clean|rebuild` 那一族，
      // `AGENTS.md` 已写死）⇒ 叫 `clean` 会**撞名**：用户以为在清版本，实际清了
      // 编译缓存 ✗。`prune` 是"剪掉多余的"，不与任何既有子命令重叠，也不与
      // `update`（刷新缓存）重叠 ✓。
      //
      // ⚠ **默认 dry-run**（删除不可逆）：不带 `--yes` 一个字节都不删 ✓。
      // `--check` = 只判定（有可清的就 exit 3，可当门禁用）；`--yes` = 真清。
      const pin = versionSource()
      const apply = rest.includes('--yes')
      const check = rest.includes('--check')
      const asJson = rest.includes('--json')
      const inv = pruneInventory(pin)
      const surplus = inv.roots.reduce((n, r) => n + r.remove.length, 0)
      const dangling = inv.roots.reduce((n, r) => n + r.danglingObsolete.length, 0)
      const unified = inv.markers.unified
      const clean = surplus === 0 && dangling === 0 && unified

      const applied = { removed: [], obsolete: [], cache: [] }
      if (apply) {
        for (const r of inv.roots) {
          const removing = new Set(r.remove)
          for (const name of r.remove) {
            rmSync(path.join(r.root, name), { recursive: true, force: true })
            applied.removed.push(path.join(r.root, name))
          }
          for (const name of pruneObsolete(r.root, removing)) {
            applied.obsolete.push(path.join(r.root, name))
          }
        }
        // Cache 两半对齐：这是"版本不统一"里**唯一**由 `update` 的 404 直接造成的一半
        // （实测 CLI 0.83.0 / LSP 0.73.0）⇒ 一条命令要能把它一起收口 ✓。
        if (!unified && pin.version) {
          for (const base of ['sokonanoda', 'sokonanoda-lsp']) {
            const dest = await download(base, pin.version.text)
            applied.cache.push({ base, ok: Boolean(dest), error: lastDownloadError, url: lastDownloadUrl })
          }
        }
      }

      if (asJson) {
        process.stdout.write(
          `${JSON.stringify(
            {
              dry_run: !apply,
              clean,
              surplus,
              dangling_obsolete: dangling,
              version: pin.version?.text,
              extensions: inv.roots.map(r => ({
                root: r.root,
                in_use: r.inUse,
                keep: r.keep,
                remove: r.remove,
                dangling_obsolete: r.danglingObsolete,
              })),
              cache: inv.markers,
              applied,
            },
            null,
            2,
          )}\n`,
        )
      } else {
        process.stdout.write(`scripts/soko prune${apply ? '' : ' (dry-run)'}\n`)
        if (!inv.roots.length) process.stdout.write('  extensions: none found\n')
        for (const r of inv.roots) {
          process.stdout.write(`  extensions: ${r.root}\n`)
          for (const name of r.keep) process.stdout.write(`    keep    ${name}\n`)
          for (const name of r.remove) process.stdout.write(`    remove  ${name}\n`)
          if (r.danglingObsolete.length) {
            process.stdout.write(`    .obsolete: ${r.danglingObsolete.length} dangling entr(ies)\n`)
          }
        }
        process.stdout.write(
          `  cache:      cli ${inv.markers.cli ?? '(no marker)'} · lsp ${inv.markers.lsp ?? '(no marker)'}\n` +
            `              expected ${inv.markers.expected ?? '(no pin)'} ⇒ ` +
            `${unified ? 'unified' : 'NOT unified'}\n`,
        )
        // `prune` 不装新版 ⇒ 盘上可能没有与版本钉匹配的扩展。**必须说出来**（否则
        // "清干净了"会被读成"版本统一了"，而编辑器仍跑旧扩展 ✗）。
        for (const r of inv.roots) {
          if (!r.pinMatched && pin.version) {
            process.stdout.write(
              `  note:       no installed extension matches the pin v${pin.version.text} in ${r.root}\n` +
                `              (kept the newest). Install the matching VSIX to finish the job:\n` +
                `                code --install-extension sokonanoda-<target>.vsix\n`,
            )
          }
        }
        if (clean) {
          process.stdout.write('  verdict:    already unified — nothing to prune\n')
        } else {
          process.stdout.write(
            `  verdict:    ${surplus} surplus extension dir(s) · ${dangling} dangling .obsolete ` +
              `entr(ies)${unified ? '' : ' · cache markers differ'}\n`,
          )
        }
        if (apply) {
          process.stdout.write(
            `  applied:    removed ${applied.removed.length} dir(s) · dropped ${applied.obsolete.length} ` +
              `.obsolete entr(ies)` +
              (applied.cache.length
                ? ` · cache refreshed ${applied.cache.filter(c => c.ok).length}/${applied.cache.length}\n`
                : '\n'),
          )
        } else if (!clean) {
          process.stdout.write('  dry-run:    nothing was deleted — re-run with --yes to apply\n')
        }
      }

      if (check && !clean) return 3
      // `--yes` promised a unified environment; a cache that could not be
      // refreshed must not look like success (same discipline as `update` ✓).
      if (apply && !unified && applied.cache.some(c => !c.ok)) {
        process.stderr.write(
          'scripts/soko prune: extension clutter was removed, but the cache markers could not be\n' +
            '  unified. Run `scripts/soko update` and read its report (it prints the URL + advice).\n',
        )
        return 3
      }
      return 0
    }

    case 'gate': {
      // Contributor gate = the CLI's cargo gate (fmt + clippy + test + playground
      // anchor) **plus** the course gate (`courses/set-theory/tools/check.py`,
      // criteria G1–G5). Design: docs/design/course-gate-in-ci.md §2.4 / §7 S3.
      //
      // **`--fast` = 迭代内环**（2026-09-23，用户报"gate 太慢、严重阻碍迭代"）：
      //   * 跳过 `cargo test --workspace`（最贵的是**课程规模**的 suite：
      //     LSP 库 129s、`judge_batch` 87s——实测 CI 数据）；
      //   * 改成只跑**改动过的 crate** 的**单测**（`cargo test -p … --lib`）；
      //   * 跳过缺口门禁（~94s；它是**提交前**的台账契约）；
      //   * **保留** fmt + clippy + anchor + 课程门禁（后者现在走持久缓存 ⇒ 秒级）。
      // 完整 gate（不带 `--fast`）仍是提交/推送/CI 的判据。
      //
      // python3 is probed *before* anything expensive: a missing interpreter is
      // exit 3 and never a silent skip — a local "green" that skipped the course
      // layer would be a lie (CI is the backstop, not the excuse).
      const python = pythonCommand()
      if (!python) {
        process.stderr.write(
          'scripts/soko gate: 找不到 python3 —— 课程门禁无法判定（不静默跳过，exit 3）。\n' +
            '  装法：macOS `brew install python3` · Debian/Ubuntu `sudo apt install python3` ·\n' +
            '        Windows `winget install Python.Python.3`（`py -3` 也认）。\n' +
            '  课程判据的唯一真相是 courses/set-theory/tools/check.py（硬规则 6：课程线零 cargo）。\n',
        )
        return 3
      }
      const r = resolver('sokonanoda', cliOverride)
      const found = await r.resolve()
      if (!canExec(found)) return refuseUntrusted('sokonanoda', found, r.pin)
      // ⚠ **陈旧的仓库构建 ⇒ 拒绝**（2026-10-14 BUILD-Q，坑 1 的消费者）：
      // `build.stale` 以前只有 `version` 会打印 ⇒ 「守卫看得见却不用」✗（复核实测：
      // `check.py` 拿着陈旧引擎判出 **14 条假红**，而仓库自己早就算出 `stale=true`）。
      // 这里是**选二进制的那一步** ⇒ 该拒绝；而且要在 cargo 步骤**之前**拒绝，
      // 别让人等完 fmt/clippy/test 才听说构建是旧的 ✓。
      // ⚠ 只在 `source === 'repo-build'` 时**判定**：显式 override（`SOKONANODA_BIN`）
      // 是逃生门、缓存/下载按 marker 与版本钉把关 ⇒ 都不拿"仓库构建陈旧"去拦 ✗。
      // ⚠ 2026-10-15 CHAIN-X：**缓存链接要出声但不拦** —— `linkBuildIdentity` 会认出
      // "这份产物不是本树编的、且早于本树最新引擎源"（`predates_source`）⇒ 打印
      // `buildWarning`（发布/缓存产物天然比源码旧，**拦它会让课程仓全红** ✗）；
      // `stale` 仍只在 repo-build 上出现 ⇒ 下面那条拒绝路径逐字节不变 ✓。
      const identity = linkBuildIdentity('sokonanoda', found)
      if (found.source === 'repo-build' && identity?.stale) {
        process.stderr.write(staleBuildRefusal(identity))
        return 3
      }
      for (const line of buildWarning(identity)) process.stderr.write(line)
      const fast = rest.includes('--fast')
      const cargoGate = spawnSync(found.path, ['gate', ...rest], { stdio: 'inherit' })
      if (cargoGate.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${found.path}: ${cargoGate.error.message}\n`)
        return 3
      }
      const cargoStatus = cargoGate.status ?? 3
      if (fast) {
        const crates = changedCrates()
        if (crates.length === 0) {
          process.stderr.write(
            'scripts/soko gate --fast: `crates/` 下没有改动 ⇒ 跳过 Rust 单测（课程门禁照跑）。\n',
          )
        } else {
          // ⚠ **不能写死 `--lib`**：`sokonanoda-cli` **没有 lib target**（bin crate）
          // ⇒ `cargo test -p sokonanoda-cli --lib` 报 `no library targets found`
          // 并**以非 0 退出** ⇒ `gate --fast` 判红 ✗（2026-09-30 实测踩到：
          // 改了 `crates/cli/` 就必红，与代码无关）。
          // ⚠ **`--lib --bins` 也不行**：cargo 对"某个被 `-p` 指名的包没有那类
          // target"是**硬错误**（实测：`-p sokonanoda-cli -p sokonanoda-front --lib --bins`
          // 仍然报 `no library targets found` ✗）。
          // ⇒ **按 crate 分开选**：有 `src/lib.rs` 的用 `--lib`，否则用 `--bins` ✓。
          const hasLib = (c) =>
            existsSync(path.join(REPO, 'crates', c.replace(/^sokonanoda-/, ''), 'src', 'lib.rs')) ||
            existsSync(path.join(REPO, 'crates', c, 'src', 'lib.rs'))
          const libCrates = crates.filter(hasLib)
          const binCrates = crates.filter((c) => !hasLib(c))
          const runs = []
          // ⚠ **每个 crate 各自一个 `-p`**（2026-10-10 修，两个独立执行者都撞到）：
          // `['-p', a, b, '--lib']` 里**第二个包名被 cargo 当成测试名过滤器**
          // （`-p` 只吃一个值）⇒ 实测 `0 passed … 910 filtered out`：
          // **第二个 crate 的单测从来没跑过** ✗ —— 「咬不住的守卫等于没有」的同族。
          // 判据：`+ cargo test -p <a> -p <b> --lib` 这一行必须**每个包各带一个 `-p`**，
          // 且两个 crate 的用例数都非 0（实测 `-p sokonanoda-front -p sokonanoda-lsp --lib`
          // ⇒ 910 + 198 passed）。
          const pkgFlags = (cs) => cs.flatMap((c) => ['-p', c])
          if (libCrates.length) runs.push([...pkgFlags(libCrates), '--lib'])
          if (binCrates.length) runs.push([...pkgFlags(binCrates), '--bins'])
          if (runs.length === 0) {
            process.stderr.write('scripts/soko gate --fast: 改动过的 crate 都没有可跑的 target（跳过）\n')
          }
          for (const one of runs) {
            const argv = ['test', ...one]
            process.stderr.write(`+ cargo ${argv.join(' ')}（--fast：只跑改动过的 crate 的单测）\n`)
            const t = spawnSync('cargo', argv, {
              stdio: 'inherit',
              cwd: REPO,
              // 课程规模的测试（`perf_course` / `project` / `judge_batch`）会整门课
              // 编一遍——给它们同一个**持久缓存**，第二次起就是命中。
              env: {
                ...process.env,
                SOKONANODA_CACHE_DIR:
                  process.env.SOKONANODA_CACHE_DIR || path.join(REPO, 'target', 'gate-cache'),
              },
            })
            if ((t.status ?? 3) !== 0) return t.status ?? 3
          }
        }
      }
      if (cargoStatus !== 0) return cargoStatus
      const courseCheck = path.join(REPO, 'courses', 'set-theory', 'tools', 'check.py')
      if (!existsSync(courseCheck)) {
        // A checkout without the course is a legitimate state (the course can be
        // extracted into its own repository); say so rather than pretend green.
        // The ledger below still runs — `docs/gaps/` travels with the language repo.
        process.stderr.write(
          `scripts/soko gate: 跳过课程门禁 —— 本检出里没有 ${path.relative(REPO, courseCheck)}。\n` +
            '  （课程在仓库里时这一步必须跑；缺文件不会静默当作绿。）\n',
        )
      } else {
        // Hand the *resolved* binary to check.py: 34 targets must not each
        // re-resolve the launcher (that re-probe was half the per-target cost).
        const course = spawnSync(python.cmd, [...python.args, courseCheck], {
          stdio: 'inherit',
          cwd: REPO,
          env: {
            ...process.env,
            SOKONANODA_BIN: found.path,
            // **持久编译缓存**（迭代速度，2026-09-23）：课程门禁要判 34 个目标，
            // 冷缓存实测 **164s**、暖缓存几秒——而它以前每次都是冷的（`grade()`
            // 只继承环境，没人给它缓存目录）。缓存是**内容键**的，且 `soko` 对
            // 版本不匹配**拒绝运行**（G-16）⇒ 复用不会掩盖过期。
            // 想回到冷缓存：`SOKONANODA_CACHE_DIR=$(mktemp -d) scripts/soko gate`。
            SOKONANODA_CACHE_DIR:
              process.env.SOKONANODA_CACHE_DIR || path.join(REPO, 'target', 'gate-cache'),
          },
        })
        if (course.error) {
          process.stderr.write(`scripts/soko gate: failed to run ${courseCheck}: ${course.error.message}\n`)
          return 3
        }
        if ((course.status ?? 3) !== 0) return course.status ?? 3
      }
      // Notation rule (2026-09-21): the course tree must use Lean 4 notation
      // everywhere (lib + body + intro course + playground). The checker is
