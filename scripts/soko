      // 实测 `grep -c audit-wire-fields scripts/soko` = **0** ✗ ⇒ **从不自动跑** ✓
      // —— 与 R-3「门禁崩了却不判」同形 ✓。这条补上 ✓。
      const wireFields = path.join(REPO, 'scripts', 'audit-wire-fields.py')
      if (!existsSync(wireFields)) {
