      }
      const lint = spawnSync(python.cmd, [...python.args, notationLint], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (lint.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${notationLint}: ${lint.error.message}\n`)
        return 3
      }
      if ((lint.status ?? 3) !== 0) return lint.status ?? 3
      // **自检也进 gate** ✓（2026-09-27 E00 判据普查补的 ✓）：本门禁原来
      // **没有任何自检入口** ✗ ⇒ 无法自证"能咬住" ✗（`AGENTS.md`：
      // **咬不住的守卫等于没有** ✓）。毫秒级 ⇒ `--fast` 也跑 ✓。
      const notationSelf = spawnSync(python.cmd, [...python.args, notationLint, '--selftest'], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (notationSelf.error || (notationSelf.status ?? 3) !== 0) {
