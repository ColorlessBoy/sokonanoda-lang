      // 为什么必须进 gate：`AGENTS.md` —— **咬不住的守卫等于没有** ✓；而 77 处
      // 存量若一次性判红，gate 就常红、别的东西就没法判了 ✗。
      const notationPaths = path.join(REPO, 'scripts', 'audit-notation-paths.py')
      if (!existsSync(notationPaths)) {
