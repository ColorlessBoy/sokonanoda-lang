            `scripts/soko gate: ${path.relative(REPO, tacticDocsLint)} ${extra.join(' ')} 判红 —— tactic 清单漂移（exit ${step.status}）。\n`,
          )
          return step.status ?? 3
        }
      }
      // Ledger contract: every gap's repro must still agree with its recorded
      // status (`docs/gaps/ledger.jsonl`, docs/gaps/README.md). Cheap (~3 s) and
      // it is the only thing that keeps "fixed_in" honest as the language moves.
      //
      // Deliberately **no** SOKONANODA_BIN here (unlike the course gate above):
      // half of these repros test the launcher's own resolution chain, and an
      // exported override short-circuits their fixtures (that reddened this step
      // the first time it ran under `gate`). `gap.py` also strips it itself.
      // Version single-source (T-A08): every `sokonanoda.toml` in the repo that
      // declares `requires` must equal the repo version. The user's own words
      // were "开发没有默认提升这个 project 的 requires，这是根因" — a stale
      // `requires` used to turn the whole project cache off (G-24), and each
      // manifest drifting on its own is how it happened. Cheap (git ls-files +
      // regex) and it makes `scripts/bump.py` the only place a version is written.
      const manifests = path.join(REPO, 'scripts', 'bump.py')
      if (!existsSync(manifests)) {
        process.stderr.write(
          `scripts/soko gate: 找不到 ${path.relative(REPO, manifests)} —— 版本漂移无法判定（exit 3）。\n`,
        )
        return 3
      }
      const versionCheck = spawnSync(python.cmd, [...python.args, manifests, '--check'], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (versionCheck.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${manifests}: ${versionCheck.error.message}\n`)
        return 3
      }
      if ((versionCheck.status ?? 3) !== 0) return versionCheck.status ?? 3
      // **重复功守卫**（G-68，2026-09-28 用户 22:09「重复编译这种灾难怎么会发生」）：
      // 既有性能纪律**全是相对量** —— `perf-gate` 比"与台账上一次同名记录的 delta"、
      // E17 按"每声明"归一 ⇒ **基线里已经包含的浪费在定义上不可见**：per-entry-closure
      // 键让共享依赖在每个入口里各编一遍（课程项目实测 **174 次模块编译 = 4.14×**、
      // rebuild **222.1s**），而它在 0.68.0→0.78.0 **每个版本都是同一个常数** ⇒
      // 恒定 `0%` delta、归一化后 `44.9 → 44.9 ms` ✓✓。
      // ⇒ 补一条**测次数**（不测耗时）的守卫：夹具 = 3 个入口共享 1 个依赖，
      // `SOKO_STAGE_STATS` 的 `by_calls` 就是"共享依赖被编了几次"的直接读数；
      // 上界在 `scripts/recompile-budget.json`（**只许减不许增**）。
      // 复盘（时间线 + 为什么七条纪律一条都没抓到）：docs/perf/recompile-waste-retrospective-2026-09-28.md
      const recompile = path.join(REPO, 'scripts', 'check-recompile-factor.py')
      if (!existsSync(recompile)) {
        process.stderr.write(
          `scripts/soko gate: 找不到 ${path.relative(REPO, recompile)} —— 重复功无法判定（exit 3）。\n`,
        )
        return 3
      }
      const recompileRun = spawnSync(python.cmd, [...python.args, recompile], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (recompileRun.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${recompile}: ${recompileRun.error.message}\n`)
        return 3
      }
      if ((recompileRun.status ?? 3) !== 0) return recompileRun.status ?? 3
      // 反向验证也进 gate ✓（`AGENTS.md`：**咬不住的守卫等于没有** ✓）：
      // 造一个"5 个入口共享 1 个依赖"的场景，它**必须判红** ✗⇒✓。
      const recompileSelf = spawnSync(python.cmd, [...python.args, recompile, '--selftest'], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (recompileSelf.error || (recompileSelf.status ?? 3) !== 0) {
        process.stderr.write(
          `scripts/soko gate: ${path.relative(REPO, recompile)} --selftest 失败 —— 守卫咬不住 G-68（exit 3）。\n`,
        )
        return 3
      }
      // **P2 进度判据**（用户 2026-09-28）：`build`/`rebuild` 的最小进度粒度以前是
      // **文件** ⇒ 大文件时用户可见面长时间不动像卡死（实测冷编课程**最长无输出间隔
      // 39.0s**）✗。判据直接量**事件流最长空档**（`build.decl` 声明级 + `build.tick`
      // 心跳两条通道）≤ 2.5s；反向验证（合成 5s 空档必须判红）也进 gate ✓。
      // 快（~3s）⇒ `--fast` 也跑 ✓。
      const progressGap = path.join(REPO, 'scripts', 'check-progress-gap.py')
      if (!existsSync(progressGap)) {
        process.stderr.write(
          `scripts/soko gate: 找不到 ${path.relative(REPO, progressGap)} —— 进度粒度无法判定（exit 3）。\n`,
        )
        return 3
      }
      const gapRun = spawnSync(python.cmd, [...python.args, progressGap], { stdio: 'inherit', cwd: REPO })
      if (gapRun.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${progressGap}: ${gapRun.error.message}\n`)
        return 3
      }
      if ((gapRun.status ?? 3) !== 0) return gapRun.status ?? 3
      const gapSelf = spawnSync(python.cmd, [...python.args, progressGap, '--selftest'], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (gapSelf.error || (gapSelf.status ?? 3) !== 0) {
        process.stderr.write(
          `scripts/soko gate: ${path.relative(REPO, progressGap)} --selftest 失败 —— 判据咬不住空档（exit 3）。\n`,
        )
        return 3
      }
      // **C1 进度节奏判据**（用户 2026-10-08：「build 汇报太稀疏，约 24 个文件才一条」✗）：
      // `check-progress-gap.py` 量的是 **`--json` 的事件流**（机器通道）—— 它**看不见
      // 人看的那条**（stderr）✗。这条补上：N=120 个文件 ⇒ 人看的进度行 **≥ N**（旧的是
      // 每 10% ⇒ 只有 10 行 ✗）+ 人话心跳 ≥2 条（显式 200ms 周期 ⇒ 结构判据）。
      // 反向验证（`--selftest`：造"每 24 个一行"的流必须判红）也进 gate ✓。
      // 快（~2s）⇒ `--fast` 也跑 ✓。
      const progressCadence = path.join(REPO, 'scripts', 'check-progress-cadence.py')
      if (!existsSync(progressCadence)) {
        process.stderr.write(
          `scripts/soko gate: 找不到 ${path.relative(REPO, progressCadence)} —— 进度节奏无法判定（exit 3）。\n`,
        )
        return 3
      }
      for (const extra of [[], ['--selftest']]) {
        const cadenceRun = spawnSync(python.cmd, [...python.args, progressCadence, ...extra], {
          stdio: 'inherit',
          cwd: REPO,
        })
        if (cadenceRun.error) {
          process.stderr.write(
            `scripts/soko gate: failed to run ${progressCadence} ${extra.join(' ')}: ${cadenceRun.error.message}\n`,
          )
          return 3
        }
        if ((cadenceRun.status ?? 3) !== 0) {
          process.stderr.write(
            `scripts/soko gate: ${path.relative(REPO, progressCadence)} ${extra.join(' ')} 失败 —— ` +
              `人看的进度太稀/太静（或判据咬不住，exit 3）。\n`,
          )
          return cadenceRun.status ?? 3
        }
      }
      // **测试的环境档位隔离**（2026-09-30 事故）：`SOKO_JUDGE_INPLACE*` 走
      // `OnceLock` 只读一次环境，而**同一文件的多个 `#[test]` 共享一个进程**
      // ⇒ 两条判据抢同一个档位 ⇒ **间歇判红**（实测 6 连跑 4 红 2 绿；
      // 症状是"单独跑绿、gate 里红"，最容易被误读成"gate 有问题" ✗）。
      // 纯静态扫描、**毫秒级** ⇒ `--fast` 也跑 ✓。
      const envIsolation = path.join(REPO, 'scripts', 'check-test-env-isolation.py')
      if (!existsSync(envIsolation)) {
        process.stderr.write(
          `scripts/soko gate: 找不到 ${path.relative(REPO, envIsolation)} —— 档位隔离无法判定（exit 3）。\n`,
        )
        return 3
      }
      for (const extra of [[], ['--selftest']]) {
        const r = spawnSync(python.cmd, [...python.args, envIsolation, ...extra], {
          stdio: 'inherit',
          cwd: REPO,
        })
        if (r.error) {
          process.stderr.write(`scripts/soko gate: failed to run ${envIsolation}: ${r.error.message}\n`)
          return 3
        }
        if ((r.status ?? 3) !== 0) return r.status ?? 3
      }
      // **`target/` 体积守卫**（2026-10-11 用户：「浪费我太多 ssd，好麻烦」✓）：
      // 增量编译每会话往 `deps/` 吐一批新的 `*.rcgu.o`、cargo **从不回收** ✗
      // ⇒ 2026-09-27 实测堆到 `target/` **205 GB**；2026-10-11 又堆到 **142 GiB**
      // （61.7 万个 `.rcgu.o` + `incremental/` 53 GiB）。
      // ⚠ **本守卫以前从没跑过** ✗：`grep -rn target-hygiene scripts/soko .github/workflows/`
      // = 0 ⇒ 文档宣称有守卫、实际**从不执行** ✗ —— 与 R-3「门禁崩了却不判」同形 ✓。
      // **为什么不进 CI**：runner 是**一次性**的，`target/` 天生只有一次构建 ⇒ 在那边
      // 没有意义 ✓（`scripts/soko gate` 本来也不被 CI 调用：CI 按 job 拆开各跑同源判据 ✓）。
      // **退出码口径**（有意与别步不同 ✓）：`2 = 告警`（40 GB / 25 万个 .o —— 用户 2026-09-27
      // 指定的"两周没清"量级）**只报不拦** ✓ —— 拦在告警线上会让 gate 在日常规模就常红，
      // 别的东西就没法判了 ✗；`1 = 判红`（100 GB / 60 万个 .o / 60 GiB incremental）
      // **真拦** ✓，那时它确实是病态。判红了就 `python3 scripts/target-hygiene.py --reclaim` ✓。
      // 健康时 0.3 秒（实测 1.7 GB / 23,498 文件）；病态规模约 16–21 秒（实测速率
      // 43–59k files/s 外推到 91.8 万文件）⇒ 只在**该知道的时候**才慢 ✓ ⇒ `--fast` 也跑 ✓。
      // **判红但不短路**（2026-10-15 修 `CACHE-GUARD-NO-HEADROOM`，第十四次复核实测）：
      // `target/` 体积与编译缓存预算这两步都是**磁盘**判据，而它们以前 `return` 得
      // **太早** ⇒ 后面那些**与磁盘无关**的判据（e2e 台账 / multi-session / 队列门禁 /
      // 缺口台账）**一次都不跑** ✗ —— 实测：`gate --fast` 里缓存守卫一红，multi-session
      // 与 `ux-queue --check` 就没跑（而单独跑 `--check` = **0** ✓）⇒ **一条无关的红
      // 把别的判据全藏起来** ✗。现在**记下**它、把余下步骤跑完，最后当退出码交出去
      // （**牙还在**：真超预算仍判红并点名 ✓）。退出码口径 = **先失败者优先**
      // （与别步的短路顺序一致 ✓）；`defer` 只认第一条。
      let deferredStatus = 0
      const defer = (code) => {
        if (!deferredStatus) deferredStatus = code
      }
      const targetHygiene = path.join(REPO, 'scripts', 'target-hygiene.py')
      if (!existsSync(targetHygiene)) {
        process.stderr.write(
          `scripts/soko gate: 找不到 ${path.relative(REPO, targetHygiene)} —— target/ 体积无法判定（exit 3）。\n`,
        )
        return 3
      }
      const hygiene = spawnSync(python.cmd, [...python.args, targetHygiene], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (hygiene.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${targetHygiene}: ${hygiene.error.message}\n`)
        return 3
      }
      const hygieneStatus = hygiene.status ?? 3
      if (hygieneStatus === 1 || hygieneStatus === 3) {
        process.stderr.write(
          `scripts/soko gate: target/ 体积判红（exit ${hygieneStatus}）—— ` +
            '回收：`python3 scripts/target-hygiene.py --reclaim` ✓\n' +
            '  （余下步骤照跑：磁盘判据不许把别的判据藏起来 ✓）\n',
        )
        defer(hygieneStatus)
      }
      if (hygieneStatus === 2) {
        process.stderr.write(
          'scripts/soko gate: target/ 体积**告警**（未超红线，不拦 gate ✓）—— ' +
            '要腾空间就跑 `python3 scripts/target-hygiene.py --reclaim` ✓\n',
        )
      }
      // 反向验证也进 gate ✓（`AGENTS.md`：**咬不住的守卫等于没有** ✓）：自检里那条
      // **硬链接夹具**必须咬得住 2026-10-11 的"高报 60%" ✗⇒✓（实测：撤掉按 inode
      // 去重 ⇒ 6 条链接读成 1.5 MB、第 ③ 条当场判红 ✓）。毫秒级 ⇒ `--fast` 也跑 ✓。
      const hygieneSelf = spawnSync(python.cmd, [...python.args, targetHygiene, '--selftest'], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (hygieneSelf.error || (hygieneSelf.status ?? 3) !== 0) {
        process.stderr.write(
          `scripts/soko gate: ${path.relative(REPO, targetHygiene)} --selftest 失败 —— 守卫咬不住堆积（exit 3）。\n`,
        )
        return 3
      }
      if (fast) {
        process.stderr.write(
          'scripts/soko gate --fast: 跳过缺口台账门禁（~94s；它是**提交前**的契约，' +
            '提交前跑完整 `scripts/soko gate`）。\n',
        )
      }
      // **e2e 台账完整性**（2026-09-24 补的洞）：`docs/e2e/ledger.jsonl` 的每条记录都
      // 引用一个 `docs/e2e/logs/*.log`；文件缺了，CI 的 `e2e ledger` job 就红 ✗
      // —— 而以前**只有 CI 查它** ⇒ 本地推送前测不出来（真事故：merge-tree 合成
      // merge 丢了 4 个被引用的日志）。放在这里 ⇒ 每次本地 gate 都能抓到。
      const e2eLedger = path.join(REPO, 'scripts', 'e2e-merge.py')
      if (!fast && existsSync(e2eLedger)) {
        const r = spawnSync(python.cmd, [...python.args, e2eLedger, '--check'], {
          stdio: 'inherit',
          cwd: REPO,
        })
        if (r.error) {
          process.stderr.write(`scripts/soko gate: failed to run ${e2eLedger}: ${r.error.message}\n`)
          return 3
        }
        if ((r.status ?? 3) !== 0) return r.status ?? 3
      }
      // **编译缓存预算**（2026-10-12 用户：「rust 编译器对编译缓存文件的管理非常差，经常占了一百多 G……
      // 多 workspace 会放大这种问题，现在收口到我们这边来管理」）：`compile-cache.py status --quiet`
      // 报一行总量（跨工作树，硬链接去重 ⇒ 与 `du` 同口径 ✓），**超预算判红** ✗。
      // 预算 = `SOKO_CACHE_BUDGET_GB` 或 `.cache/compile/registry.json`（默认 60 G）；
      // **回收目标** = 预算 − 余量（默认 5% ⇒ 57 G）—— 判红线**不动** ✓（见 `compile-cache.py`）。
      // ⚠ **判红但不短路**（同上）：这一步以前 `return cc.status` ⇒ multi-session 与
      //   队列门禁**一次都不跑** ✗（第十四次复核：那两步在本次 gate 里没跑，单独跑 = 0 ✓）。
      const cacheMgr = path.join(REPO, 'scripts', 'compile-cache.py')
      if (existsSync(cacheMgr)) {
        const cc = spawnSync(python.cmd, [...python.args, cacheMgr, 'status', '--quiet'], {
          stdio: 'inherit',
          cwd: REPO,
        })
        if (cc.error) {
          process.stderr.write(`scripts/soko gate: failed to run ${cacheMgr}: ${cc.error.message}\n`)
          return 3
        }
        if ((cc.status ?? 3) !== 0) {
          process.stderr.write(
            'scripts/soko gate: 编译缓存**超预算**（上面那一行有总量与预算）—— ' +
              '回收：`python3 scripts/compile-cache.py reclaim --to-budget` ✓\n' +
              '  （余下步骤照跑：磁盘判据不许把别的判据藏起来 ✓；' +
              '回收目标 = 预算 − 余量 ⇒ 收完还剩一次构建的余量 ✓）\n',
          )
          defer(cc.status ?? 3)
        }
      }
      // **多会话/工作树门禁**（2026-10-12 并行 agent 基建）：`check-multi-session.py` 在 **worktree**
      // 里跑时会拦「台账落后 main ⇒ 合回必冲突」（正解 = worktree 隔离 + 台账只在 main 上改 ✓）。
      // 秒级 ⇒ `--fast` 也跑；在主工作树且不落后时它直接绿 ✓。
      const multiSession = path.join(REPO, 'scripts', 'check-multi-session.py')
      if (existsSync(multiSession)) {
        const ms = spawnSync(python.cmd, [...python.args, multiSession], {
          stdio: 'inherit',
          cwd: REPO,
        })
        if (ms.error) {
          process.stderr.write(`scripts/soko gate: failed to run ${multiSession}: ${ms.error.message}\n`)
          return 3
        }
        if ((ms.status ?? 3) !== 0) return ms.status ?? 3
      }
      // **队列门禁**（2026-10-12 用户：「这个事件机制不能全依赖大模型运作，而是同时依靠
      // 脚本，比如 python 脚本当成一个事件调度器」）：`ux-queue.py --check` = 覆盖自检
      // （四个来源逐条在队列里 · 探针都有登记 · §0.2 摘要与队列**同数**）+ 调度器不变量
      // （收口必须有证据 · umbrella 子任务全关才收口 · 两层不漂移 · 锁）。**秒级** ⇒
      // `--fast` 也跑：它是"没做完的"那条线的唯一机器入口，脱钩必须当场判红 ✗。
      const queueCheck = path.join(REPO, 'scripts', 'ux-queue.py')
      if (existsSync(queueCheck)) {
        const q = spawnSync(python.cmd, [...python.args, queueCheck, '--check'], {
          stdio: 'inherit',
          cwd: REPO,
        })
        if (q.error) {
          process.stderr.write(`scripts/soko gate: failed to run ${queueCheck}: ${q.error.message}\n`)
          return 3
        }
        if ((q.status ?? 3) !== 0) return q.status ?? 3
      }
      const ledgerCheck = path.join(REPO, 'scripts', 'gap.py')
      if (fast) return deferredStatus
      if (!existsSync(ledgerCheck)) return deferredStatus
      const ledger = spawnSync(python.cmd, [...python.args, ledgerCheck, 'check'], {
        stdio: 'inherit',
        cwd: REPO,
      })
      if (ledger.error) {
        process.stderr.write(`scripts/soko gate: failed to run ${ledgerCheck}: ${ledger.error.message}\n`)
        return deferredStatus || 3
      }
      // **先失败者优先**：磁盘判据（`defer`）排在台账门禁之前 ⇒ 它的退出码优先 ✓。
      return deferredStatus || (ledger.status ?? 3)
    }

    case 'mcp': {
      // MCP stdio server for harnesses (DSH `mcp__sokonanoda__*` tools). It is a
      // plain Node script in this repository, so this branch needs no binary at
      // all — but it does require the launcher to live in a checkout, which is
      // exactly the contract (`cwd` = repo root, or SOKO_REPO).
      const server = path.join(REPO, 'dsh', 'mcp', 'server.js')
      if (!existsSync(server)) {
        process.stderr.write(
          `scripts/soko mcp: no MCP server at ${server}\n` +
            'Run it from the repository checkout (or set SOKO_REPO to one).\n',
        )
        return 3
      }
      const result = spawnSync(process.execPath, [server, ...rest], { stdio: 'inherit' })
      if (result.error) {
        process.stderr.write(`scripts/soko mcp: failed to run ${server}: ${result.error.message}\n`)
        return 3
      }
      return result.status ?? 3
    }

    default: {
      // Everything else goes to the CLI: grade / gate / watch / course / repl /
      // a bare file path / --json …
      const base = command === 'lsp' ? 'sokonanoda-lsp' : 'sokonanoda'
      const override = command === 'lsp' ? lspOverride : cliOverride
      const r = resolver(base, override)
      const found = await r.resolve()
      const pin = r.pin
      if (!canExec(found)) {
        // One refusal path for every untrusted candidate: nothing resolved, a
        // cache whose marker does not match the pin, or — G-16 — a cache that
        // cannot be verified because there is no pinned version at all.
        return refuseUntrusted(base, found, pin)
      }
      // `lsp` must reach the server binary; the CLI would re-dispatch it, but
      // going straight there keeps stdout a pure LSP frame stream.
      const args = command === 'lsp' ? rest : [command, ...rest]
      if (command === 'lsp') {
        // ⚠ **编辑器那条路也要出声**（2026-10-15 `LSP-BINARY-STALE-NO-WARNING`）：
        // 这是**唯一**真正启动 LSP 的入口（VS Code 扩展 / opencode 插件 / shim 都走它）
        // ⇒ 不在这里喊，"跑旧引擎"就永远静默 ✗。
        // ⚠ **只警告、不拒绝**（与 `gate` 的 exit 3 有意不同 ✓）：编辑器没有"换个引擎"的
        // 选项，拒绝启动 = 整个 LSP 挂掉，比跑一份旧引擎**更坏** ✗；而 stderr 是 LSP 的
        // **日志**通道（协议走 stdout）⇒ 一行警告是安全的 ✓（**不许**写 stdout ✗）。
        for (const line of buildWarning(lspBuildIdentity(found), 'lsp build', 'sokonanoda-lsp')) {
          process.stderr.write(line)
        }
      }
      const result = spawnSync(found.path, args, { stdio: 'inherit' })
      if (result.error) {
        process.stderr.write(`scripts/soko: failed to run ${found.path}: ${result.error.message}\n`)
        return 3
      }
      return result.status ?? 3
    }
  }
}

process.exitCode = await main(process.argv.slice(2))
