{
  "schema": "soko.lesson-preflight-fixtures/1",
  "note": "会话预检的红/绿对照夹具：X11 自造术语必红、选项引理无卡必红、无卡兜底缺 why/引理名必红、干净题必绿、X6/X7/X12/X13 只出 warning、基线棘轮双向生效。改判据必须同步改这里（--selftest 会把绿例误报、红例不咬、基线失效都判红）。",
  "declarations": {
    "lib/Fixture.sokonanoda": "theorem foo_lemma (α : Type) (A : Set α) : A ⊆ A := by\n  intro x hx\n  exact hx\n\ndef bar_pred (α : Type) (x : α) : Prop := True\n\ndef SomeType (α : Type) : Type := α\n\ndef univLike {α : Type} : Set α := fun (x : α) => True\n\ndef Set.Le (α β : Type) (A : Set α) (B : Set β) : Prop := True\n\ntheorem Set.Le.refl (α : Type) (A : Set α) : A ≼ A := by\n  exact Set.Le.intro α α A A (fun x => x) (fun x => x) (fun x hx => hx)\n"
  },
  "expected_candidates": [
    "foo_lemma",
    "bar_pred"
  ],
  "expected_not_candidates": [
    "SomeType",
    "univLike"
  ],
  "expected_namespaces": [
    "Set.Le"
  ],
  "terms": {
    "selfInvented": [
      "落点",
      "原序对",
      "全称命题"
    ],
    "metaphors": [
      "搬运",
      "拆开",
      "装回",
      "接起来",
      "外壳"
    ]
  },
  "cases": [
