          "id": "green-fallback-backslash",
          "prompt": "差集 `A \\ B` 的元素有什么特点？",
          "options": [
            "属于 A 且不属于 B",
            "属于 B 且不属于 A"
          ],
          "why": "差集写成 `A \\ B`：取的是属于 `A` 但不属于 `B` 的元素。",
