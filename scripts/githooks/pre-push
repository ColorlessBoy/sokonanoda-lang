#!/usr/bin/env bash
# pre-push —— **推送前跑本地快层**（2026-09-25 用户要求 ✓，第 ⑥ 条 ✓）
#
# 用户原话 ✓：「`scripts/ci-local.sh` 已存在（注释写着"CI 只当平台矩阵确认，不当第一次测试"），
# **关键是要真的接到 push 之前**（git hook 或手动执行），**否则等于白写**」✓ —— 完全对 ✓。
#
# 设计取舍：
#  * 只看**快层**（`--fast` ✓，约 1 分钟 ✓）—— 与"本地 ≤1 分钟识别问题"的验收一致 ✓；
#  * 全量（含 e2e ✓）留给批次收尾手动跑 ✓（`scripts/ci-local.sh --e2e` ✓）；
#  * **逃生门** ✓：`git push --no-verify`（诊断性推送 / 紧急修复 ✓），
#    或 `SOKO_SKIP_HOOK=1 git push …` ✓ —— 但**不许**成为默认动作 ✗
#    （本 session 的教训 ✓：纪律要能被绕过，但不能被遗忘 ✓）。
#
# 安装：`scripts/install-hooks.sh`（设置 core.hooksPath ✓，一条命令 ✓）
set -uo pipefail
[ "${SOKO_SKIP_HOOK:-0}" = "1" ] && { echo "[pre-push] SOKO_SKIP_HOOK=1 ⇒ 跳过本地快层 ✗"; exit 0; }

# 只在本仓库根跑（hook 可能从别处被调用 ✓）
root=$(git rev-parse --show-toplevel)
[ -x "$root/scripts/ci-local.sh" ] || { echo "[pre-push] 找不到 scripts/ci-local.sh ⇒ 跳过 ✓"; exit 0; }

echo "[pre-push] 跑本地快层（scripts/ci-local.sh --fast ✓，约 1 分钟 ✓）……"
if ! (cd "$root" && ./scripts/ci-local.sh --fast); then
  cat >&2 <<'MSG'

[pre-push] ❌ 本地快层红了 ✗ ⇒ **拒绝推送** ✓（这就是它的用途 ✓）。
  * 修掉上面第一个红项 ✓（它**指名**了是哪一条 ✓）；
  * 诊断性推送可用 `git push --no-verify` ✓ 或 `SOKO_SKIP_HOOK=1 git push` ✓
    —— 但要在 `STATUS.md` 写明原因 ✓（纪律：例外要留痕 ✓）。
MSG
  exit 1
fi
# **E18 · 时序证据守卫**（2026-09-28）：动了内核源码、或 subject 自称 perf 的提交，
# commit message 里必须有**实测计时数字**（或显式豁免 `soko:no-timing: <理由>`）✓。
# 用户 D10：「**干等一个后台任务 30 分钟，还是黑箱**……后续完全没有优化的可能」⇒
# 这条纪律必须**可判红** ✓（只写在文档里，几轮之后就失效 ✗ —— 已经被验证过一次 ✓）。
base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo '')
if [ -n "$base" ]; then range="$base..HEAD"; else range="HEAD~1..HEAD"; fi
if ! (cd "$root" && python3 scripts/check-timing-evidence.py ${range%%..*} HEAD); then
  cat >&2 <<'MSG'

[pre-push] ❌ **时序证据守卫判红** ✗ ⇒ 拒绝推送 ✓（E18）。
  * 上面**指名**了是哪个提交、为什么受检 ✓；
  * 三选一补齐（**不许编数字** ✗）：① 真去量并把数字写进 commit message；
    ② 加一行 `soko:no-timing: <理由>`（≥8 字，说明为什么与时间无关）；
    ③ 把计时记进 `docs/perf/ledger.jsonl`（`scripts/perf-ledger.sh`）✓；
  * 逃生门（诊断性推送）：`git push --no-verify` / `SOKO_SKIP_HOOK=1` ✓ —— 但要在
    `STATUS.md` 写明原因 ✓。
MSG
  exit 1
fi
# **一次只让一条 CI run 活着**（2026-09-28 用户红线 ✓）：连推三次 ⇒
# `cancel-in-progress` 把每轮都顶掉 ⇒ **HEAD 一条跑完的 CI 都没有** = 「本地绿就算绿」的翻版 ✗。
# ⚠ **`gh` 不可用 ⇒ exit 2 ⇒ 判不了**（**不是绿**）⇒ 这里按"判不了就放行 + 提示"处理 ✓
# （`gh` 是运维工具，不该因为它缺席就把所有人的推送堵死 ✗ —— 但**要说出来** ✓）。
if (cd "$root" && python3 scripts/check-one-run.py); then
  :
else
  rc=$?
  if [ "$rc" = 1 ]; then
    cat >&2 <<'MSG'

[pre-push] ❌ **已有未完成的 CI run** ✗ ⇒ 拒绝推送 ✓（用户 2026-09-28 红线）。
  * **等它跑完**（推荐）：`scripts/ci-watch.sh --follow` ⇒ 然后
    `python3 scripts/ci-green.py --run <id>` 判**真绿**（exit 0 + 重活 x/10 + failure 0）✓；
  * 确认那批**不需要验证** ⇒ `scripts/ci-push.sh`（会先关旧 run ✓）；
  * 紧急逃生门：`git push --no-verify` / `SOKO_SKIP_HOOK=1` ⇒ **必须在 `STATUS.md` 写明原因** ✓。
MSG
    exit 1
  fi
  echo "[pre-push] ⚠ one-run 守卫**判不了**（exit $rc）⇒ 放行，但请手动确认没有未完成的 run ✓"
fi
echo "[pre-push] ✅ 本地快层全绿 + 时序证据齐 + 无并发 run ✓ ⇒ 放行 ✓"
