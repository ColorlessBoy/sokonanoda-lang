-- ==========================================================================
-- unit28-set-algebra.sokonanoda —— 卷 I 单元㉘ **集合代数：分配律与 De Morgan**
--
-- 靶子（教材，逐条查过目录页）：Halmos《Naive Set Theory》**§5–6**（并交差的代数律）·
-- Enderton《Elements of Set Theory》**§1.8 / §2.2**（集合运算律）。
-- 大纲：`set-theory-syllabus.md` §4.1（I.11 章「集合代数」开工）。
--
-- 本单元的"该学的定理"：**分配律两个方向** · **De Morgan 的两条**（哪一条能证、哪一条
-- 只有一半）· **吸收律** · **逆否**（`A ⊆ B ⇒ Bᶜ ⊆ Aᶜ`）· **差 = 交补** ✓
--
-- ⚠ **本单元最值得学的一件事：De Morgan 的两条在直觉主义下不对称** ——
--   · `(A ∪ B)ᶜ = Aᶜ ∩ Bᶜ` **整条都能证** ✓
--   · `(A ∩ B)ᶜ = Aᶜ ∪ Bᶜ` **只有一个方向能证**（`Aᶜ ∪ Bᶜ ⊆ (A ∩ B)ᶜ`），
--     另一个方向等价于"`¬(p ∧ q) → ¬p ∨ ¬q`" —— **要排中律** ✗（缺口 **G-74**）
--   · 同理 `Aᶜᶜ = A` 与 `A ∪ Aᶜ = Set.univ` 也**做不了**（都要排中律）⇒ **如实不排** ✓
--
-- ⚠ **两条写码边界（本单元实测，写题时会踩）**：
--   ① **后缀记法不能直接应用**：`Bᶜ x` 解析失败 ⇒ 要写 `(Bᶜ) x`；
--   ② **`∅` 出现在 `=` 或 `⊆` 的右侧时类型推不出来** ⇒ 那两条如实写成"成员层面"的形态 ✓
--
-- **本单元只允许用**：`intro` / `exact` / `apply` / `constructor` / `cases` / `have`，
--   加 `import` 进来的库引理。**解答一律项风格**。
-- **本单元 `import` 两样**：`lib.Set` · `lib.Rel`。
--
-- 依赖：单元②③④（子集、并交差、外延性恒等式）—— 本单元把那些恒等式补全成"代数"。
-- ==========================================================================
import lib.Rel
import lib.Set

-- ─────────────────────────────────────────────────────────────
-- 28.1 三条库引理（并、差、包含的展开）
-- ─────────────────────────────────────────────────────────────

-- 演示：并的成员刻画。
theorem demo_mem_union (α : Type) (a : α) (A B : Set α) :
    a ∈ (A ∪ B) ↔ (a ∈ A ∨ a ∈ B) :=
  Set.mem_union a A B

-- 演示：差的成员刻画。
theorem demo_mem_sdiff (α : Type) (a : α) (A B : Set α) :
    a ∈ (A \ B) ↔ (a ∈ A ∧ ¬ (a ∈ B)) :=
  Set.mem_sdiff a A B

-- 演示：包含的展开（"每个点"形态）。
theorem demo_subset_def (α : Type) (A B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def A B

-- ─────────────────────────────────────────────────────────────
-- 28.2 差与补：**差就是交补**
-- ─────────────────────────────────────────────────────────────

-- 练习 1（T 类）：`A \ B = A ∩ Bᶜ`（两个方向都是"把合取的两个支换个说法"）。
-- soko:hint 思路：逐点证 `↔`（用外延公理）；两个方向各自把 `A x ∧ ¬ (B x)` 原样交出去
--   （`Bᶜ` 展开就是 `¬ (B x)`）。
-- soko:hint 目标形态：`A \ B = A ∩ Bᶜ`。
-- soko:hint 关键件：`Set.ext`（**要写全论域**）· `Iff.intro`（**前导 Prop 实参写全**）·
--   `And.intro`/`And.left`/`And.right` · **后缀记法要加括号**（写 `(Bᶜ) x`）✓
theorem sdiff_eq_inter_compl (α : Type) (A B : Set α) :
    A \ B = A ∩ Bᶜ := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 28.3 分配律：**两个方向**
-- ─────────────────────────────────────────────────────────────

-- 练习 2（L 类，旗舰之一）：`(A ∪ B) ∩ C = (A ∩ C) ∪ (B ∩ C)`。
-- soko:hint 思路：→：把交的两个支拆开，左边那个析取用 `Or.elim` 分两支，各自造出右边的析取；
--   ←：把右边的析取分两支，每支都能给出"在并里"与"在 `C` 里"。
-- soko:hint 目标形态：`(A ∪ B) ∩ C = (A ∩ C) ∪ (B ∩ C)`。
-- soko:hint 关键件：`Set.ext` · `Or.elim`/`Or.inl`/`Or.inr`（**前导 Prop 实参写全**）·
--   `And.intro`/`And.left`/`And.right`（**注意合取是右嵌套**）。
theorem union_inter_distrib_right (α : Type) (A B C : Set α) :
    (A ∪ B) ∩ C = (A ∩ C) ∪ (B ∩ C) := by
  sorry

-- 练习 3（L 类，旗舰之一）：**对偶的那一条** `(A ∩ B) ∪ C = (A ∪ C) ∩ (B ∪ C)`。
-- soko:hint 思路：→：把左边的析取分开，`C` 那一支直接给两个"在并里"；←：右边是两个析取，
--   需要**双重 `Or.elim`**（先拆 `A ∨ C`，再拆 `B ∨ C`），其中两支直接给 `C`，剩下两支合成交。
-- soko:hint 目标形态：`(A ∩ B) ∪ C = (A ∪ C) ∩ (B ∪ C)`。
-- soko:hint 关键件：`Set.ext` · 两次 `Or.elim` · `Or.inl`/`Or.inr` · `And.intro`。
theorem inter_union_distrib_right (α : Type) (A B C : Set α) :
    (A ∩ B) ∪ C = (A ∪ C) ∩ (B ∪ C) := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 28.4 De Morgan：**能证的那条**
-- ─────────────────────────────────────────────────────────────

-- 练习 4（L 类，**本单元旗舰**）：`(A ∪ B)ᶜ = Aᶜ ∩ Bᶜ`（**整条都能证**）。
-- soko:hint 思路：→：假设 `¬(A x ∨ B x)`，两个方向各自"把析取的左/右支喂给假设"；
--   ←：假设 `¬A x ∧ ¬B x`，反过来对 `A x ∨ B x` 做 `Or.elim`，两支分别撞上两个否定。
-- soko:hint 目标形态：`(A ∪ B)ᶜ = Aᶜ ∩ Bᶜ`。
-- soko:hint 关键件：`Set.ext` · `Or.elim`/`Or.inl`/`Or.inr` · **否定是函数** ——
--   "用假设消掉一个析取支"就是**把它当函数应用** ✓
theorem compl_union (α : Type) (A B : Set α) :
    (A ∪ B)ᶜ = Aᶜ ∩ Bᶜ := by
  sorry

-- 练习 5（L 类）：**De Morgan 的另一条只有一半**：`Aᶜ ∪ Bᶜ ⊆ (A ∩ B)ᶜ`。
-- soko:hint 思路：把左边的析取分开，两支各自"把交的一个支喂给对应的否定"。
-- soko:hint 目标形态：`Aᶜ ∪ Bᶜ ⊆ (A ∩ B)ᶜ`。
-- soko:hint 关键件：`Or.elim` · `And.left`/`And.right` · 否定当函数用。
--   ⚠ **反方向要排中律** ⇒ 本单元**如实不排**（G-74）✓
theorem compl_inter_subset (α : Type) (A B : Set α) :
    Aᶜ ∪ Bᶜ ⊆ (A ∩ B)ᶜ := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 28.5 吸收律与逆否
-- ─────────────────────────────────────────────────────────────

-- 练习 6（L 类）：`A ∪ (A ∩ B) = A`（吸收律）。
-- soko:hint 思路：→：左边的析取分两支，第二支取合取的左支；←：右边直接用析取的左支。
-- soko:hint 目标形态：`A ∪ (A ∩ B) = A`。
-- soko:hint 关键件：`Set.ext` · `Or.elim` · `Or.inl` · `And.left`。
theorem union_absorb (α : Type) (A B : Set α) :
    A ∪ (A ∩ B) = A := by
  sorry

-- 练习 7（L 类）：`A ∩ (A ∪ B) = A`（对偶的吸收律）。
-- soko:hint 思路：→：直接取交的左支；←：用右边那个点同时造出"在 `A` 里"与"在并里"。
-- soko:hint 目标形态：`A ∩ (A ∪ B) = A`。
-- soko:hint 关键件：`Set.ext` · `And.intro`/`And.left` · `Or.inl`。
theorem inter_absorb (α : Type) (A B : Set α) :
    A ∩ (A ∪ B) = A := by
  sorry

-- 练习 8（D 类）：**逆否**：`A ⊆ B ⇒ Bᶜ ⊆ Aᶜ`。
-- soko:hint 思路：要证"不在 `B` 里 ⇒ 不在 `A` 里"：反设"在 `A` 里"，由包含假设得到"在 `B` 里"，
--   与手上的否定撞上。
-- soko:hint 目标形态：`A ⊆ B → Bᶜ ⊆ Aᶜ`。
-- soko:hint 关键件：**包含假设是定义头 ⇒ 先 λ 绑定再应用**（G-73 形状 ①）· 否定当函数用 ·
--   ⚠ 反方向（`Bᶜ ⊆ Aᶜ → A ⊆ B`）同样要**排中律** ⇒ 如实不排 ✓
theorem compl_subset_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) :
    Bᶜ ⊆ Aᶜ := by
  sorry
