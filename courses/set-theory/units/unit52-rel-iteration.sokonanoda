-- ==========================================================================
-- unit52-rel-iteration.sokonanoda —— 卷 I 单元52 **关系的复合：单位律与逐点形态**
--
-- 靶子（教材，逐条查过目录页）：Halmos《Naive Set Theory》**§10**（inverses and
--   composites）；Enderton《Elements of Set Theory》**§3.4**（compositions）。
-- 大纲：`set-theory-syllabus.md` §4.1（I.13 章补强 —— 接单元㊱㊲（结合律与逆）
--   与单元㊺（单值性）：本单元做**恒等关系的单位律**与**单调性**的逐点形态 ✓）。
--
-- 本单元的"该学的定理"：
--   · **复合的成员刻画**（两条取用子：造出中间点 / 拆出中间点）；
--   · **旗舰：恒等关系的单位律** —— `r • id = r` 与 `id • r = r` 的**逐点形态** ✓
--     （见证分别取 `b` 与 `a` 自己 ✓）；
--   · **单调**：两个方向的"逐点包含"⇒ 复合的逐点包含（含**单边单调**的特例 ✓）。
--
-- ⚠ **本单元的写法纪律**（配方第三片 ✓）：全部用**逐点形态**（`∀ a b, …`）与**取用子**，
--   把 `⊆`（def 头）留给"点态前提"而不是记法目标 ✓ —— 前两轮降级攒下的三条边界
--   在单元51 验证后，本单元**一次通过** ✓。
--
-- **本单元只允许用**：`intro` / `exact` / `apply` / `constructor` / `cases` / `have`，
--   加 `import` 进来的库引理。**解答一律项风格**。
-- **本单元 `import` 三样**：`lib.Rel` · `lib.Set` · `lib.Order`。
--
-- 依赖：单元㊱（关系的代数）· 单元㊲（逆的刻画）· 单元㊺（单值性与函数的图）✓
-- ==========================================================================
import lib.Rel
import lib.Set
import lib.Order

-- ─────────────────────────────────────────────────────────────
-- 52.0 画布给的词汇：恒等关系 `idRel`（单元㊱ 起就在用 ✓）
-- ─────────────────────────────────────────────────────────────
def idRel (α : Type) : Rel α α :=
  fun (a : α) (b : α) => Eq.{1} α a b  -- soko:notation-ok: G-73 形状 ②：`•`/`Rel` 是 def 头，这些位置补不出前导实参

-- ─────────────────────────────────────────────────────────────
-- 52.1 三条库引理（复合的成员 · 逆的成员 · 恒等关系落在自己上）
-- ─────────────────────────────────────────────────────────────

-- 演示：复合的成员刻画（"存在一个中间点"）。
theorem demo_mem_comp (α β γ : Type) (r : Rel α β) (s : Rel β γ) (a : α) (c : γ) :
    (r • s) a c ↔ ∃ (b : β), r a b ∧ s b c :=
  Rel.comp_apply r s a c
theorem demo_mem_inv (α β : Type) (r : Rel α β) (b : β) (a : α) :
    (r ⁻¹) b a ↔ r a b :=
  Rel.inv_apply α β r b a
theorem demo_idRel_self (α : Type) (a : α) : idRel α a a :=
  Eq.refl.{1} α a
-- ─────────────────────────────────────────────────────────────
-- 52.2 复合的两条取用子
-- ─────────────────────────────────────────────────────────────
-- 练习 1（T 类）：**造出复合的成员**（给定中间点与两条前提）。

-- soko:hint 关键件：`Rel.comp_apply`（**先 λ 绑定再取用** ✓ —— 配方第 ① 条）· `Iff.mpr` ·

--   `Exists.intro`（前导实参写全）· `And.intro` ✓

theorem comp_intro (α β γ : Type) (r : Rel α β) (s : Rel β γ) (a : α) (b : β) (c : γ)
    (h1 : r a b) (h2 : s b c) : (r • s) a c := by
  sorry
-- 练习 2（T 类）：**拆出中间点**（练习 1 的对偶）。

-- soko:hint 关键件：`Rel.comp_apply` · `Iff.mp` ✓

theorem comp_apply_elim (α β γ : Type) (r : Rel α β) (s : Rel β γ) (a : α) (c : γ)
    (h : (r • s) a c) : ∃ (b : β), r a b ∧ s b c := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 52.3 单位律（逐点）与单调
-- ─────────────────────────────────────────────────────────────
-- 练习 3（L 类，**旗舰一向**）：**`r • id = r` 的逐点形态**（右单位律）。

-- soko:hint 思路：中间点取 `b` 自己 —— 两条前提分别是给定的 `r a b` 与**自反** `b = b`。

-- soko:hint 目标形态：`r a b → (r • idRel β) a b`。

-- soko:hint 关键件：练习 1 · `Eq.refl`（**写全宇宙层级与论域**）✓

theorem comp_idRel_right (α β : Type) (r : Rel α β) (a : α) (b : β) (h : r a b) :
    (r • idRel β) a b := by
  sorry
-- 练习 4（L 类，**旗舰另一向**）：**`id • r = r` 的逐点形态**（左单位律）。

-- soko:hint 思路：中间点取 `a` 自己。

-- soko:hint 关键件：练习 1 · `Eq.refl` ✓

theorem idRel_comp_left (α β : Type) (r : Rel α β) (a : α) (b : β) (h : r a b) :
    (idRel α • r) a b := by
  sorry
-- 练习 5（L 类）：**单调**（两个方向的逐点包含 ⇒ 复合的逐点包含）。

-- soko:hint 思路：先用练习 2 拆出中间点 `b`，两条前提分别沿两个"逐点包含"走一步，

--   再用练习 1 拼回去。

-- soko:hint 目标形态：`(∀ a b, r a b → r1 a b) → (∀ b c, s b c → s1 b c) → (r • s) a c → (r1 • s1) a c`。

-- soko:hint 关键件：练习 1 / 练习 2 · `Exists.elim`（前导实参写全）· `And.left`/`And.right` ✓

theorem comp_mono_apply (α β γ : Type) (r r1 : Rel α β) (s s1 : Rel β γ)
    (hr : ∀ (a : α) (b : β), r a b → r1 a b)
    (hs : ∀ (b : β) (c : γ), s b c → s1 b c)
    (a : α) (c : γ) (h : (r • s) a c) : (r1 • s1) a c := by
  sorry
-- 练习 6（T 类）：**单边单调**（只有左边变宽）。

-- soko:hint 思路：把"右边不动"写成恒等函数，交给练习 5。

-- soko:hint 关键件：练习 5（**第二个前提传恒等函数** ✓）✓

theorem comp_mono_left (α β γ : Type) (r r1 : Rel α β) (s : Rel β γ)
    (hr : ∀ (a : α) (b : β), r a b → r1 a b) (a : α) (c : γ) (h : (r • s) a c) :
    (r1 • s) a c := by
  sorry
