-- ==========================================================================
-- unit66-subset-algebra.sokonanoda —— 卷 I 单元66 **包含关系的代数**
--
-- 靶子（教材）：Enderton《Elements of Set Theory》**§1.2**（subset 的性质：自反 · 传递）·
--   Halmos《Naive Set Theory》**§3**（含于关系的代数）。大纲 §4.1（I.1 收口 ✓）。
--
-- 本单元的"该学的定理"：
--   · **取用子**（`A ⊆ B` 用在点上 ✓ —— 本单元的中心工具 ✓）；
--   · **预序性质**：自反 ✓ · 传递 ✓；
--   · **与并交的关系**：`A ⊆ A ∪ B` ✓ · `A ∩ B ⊆ A` ✓ · `A ∩ B ⊆ B` ✓；
--   · **合成**：`A ⊆ C ⇒ B ⊆ D ⇒ A ∩ B ⊆ C ∩ D` ✓ · `A ⊆ C ⇒ B ⊆ C ⇒ A ∪ B ⊆ C` ✓ ·
--     `C ⊆ A ⇒ C ⊆ B ⇒ C ⊆ A ∩ B` ✓
--
-- ⚠ 全部**点态 / 包含式**（构造性可证 ✓）—— 集合等式层见单元61–65 ✓。
--
-- **本单元只允许用**：`intro` / `exact` / `apply` / `constructor` / `cases` / `have`，
--   加 `import` 进来的库引理。**解答一律项风格**。
-- **本单元 `import` 四样**：`lib.Set` · `lib.SUnion` · `lib.Order` · `lib.Rel`。
--
-- 依赖：单元①（集合与成员）· 单元②（子集与空集）· 单元62（外延性的推论）✓
-- ==========================================================================
import lib.Set
import lib.SUnion
import lib.Order
import lib.Rel

-- ─────────────────────────────────────────────────────────────
-- 66.1 三条库引理（包含的展开 · 并 · 交 的成员刻画）
-- ─────────────────────────────────────────────────────────────

-- 演示：包含的展开（`A ⊆ B` 就是"每个 `A` 的点都在 `B` 里"）。
theorem demo_subset_def (α : Type) (A B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def α A B
theorem demo_mem_union (α : Type) (a : α) (A B : Set α) :
    a ∈ (A ∪ B) ↔ a ∈ A ∨ a ∈ B :=
  Set.mem_union a A B
theorem demo_mem_inter (α : Type) (a : α) (A B : Set α) :
    a ∈ (A ∩ B) ↔ a ∈ A ∧ a ∈ B :=
  Set.mem_inter_iff a A B-- 练习 1（T 类，**中心工具**）：`A ⊆ B` 用在点上。

-- soko:hint 关键件：`Set.subset_def`（**先 λ 绑定、再 `Iff.mp`** ✓）· 按 点 · 前提 应用 ✓

theorem mem_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) (a : α) (ha : a ∈ A) : a ∈ B := by
  sorry
-- 练习 2（T 类）：**包含自反**（恒等 ✓）。

-- soko:hint 关键件：直接给 `fun a ha => ha` ✓（包含就是"点态蕴含" ✓）

theorem subset_refl (α : Type) (A : Set α) : A ⊆ A := by
  sorry
-- 练习 3（L 类）：**包含传递**（两个假设各走一步 ✓）。

-- soko:hint 关键件：练习 1（**两次**，显式复合 ✓ —— 手册"子集链要显式复合"✓）

theorem subset_trans (α : Type) (A B C : Set α) (h1 : A ⊆ B) (h2 : B ⊆ C) : A ⊆ C := by
  sorry
-- 练习 4（T 类）：**`A ⊆ A ∪ B`**。

-- soko:hint 关键件：`Set.mem_union` · `Iff.mpr` · `Or.inl` ✓

theorem subset_union_right (α : Type) (A B : Set α) : A ⊆ (A ∪ B) := by
  sorry
-- 练习 5（T 类）：**`A ∩ B ⊆ A`**。

-- soko:hint 关键件：`Set.mem_inter_iff` · `Iff.mp` · `And.left`（**写全前导实参** ✓）

theorem inter_subset_left (α : Type) (A B : Set α) : (A ∩ B) ⊆ A := by
  sorry
-- 练习 6（T 类）：**`A ∩ B ⊆ B`**。

-- soko:hint 关键件：`Set.mem_inter_iff` · `Iff.mp` · `And.right`（**写全** ✓）

theorem inter_subset_right (α : Type) (A B : Set α) : (A ∩ B) ⊆ B := by
  sorry
-- 练习 7（L 类）：**交的单调**（两个包含 ⇒ 交之间也包含 ✓）。

-- soko:hint 关键件：练习 1 · 练习 5 / 练习 6 · `And.intro` · `Iff.mpr`（**写全** ✓）

theorem inter_subset_inter (α : Type) (A B C D : Set α) (h1 : A ⊆ C) (h2 : B ⊆ D) :
    (A ∩ B) ⊆ (C ∩ D) := by
  sorry
-- 练习 8（L 类，**并的"最小性"**）：**`A ⊆ C ⇒ B ⊆ C ⇒ A ∪ B ⊆ C`**。

-- soko:hint 关键件：`Set.mem_union` · `Or.elim`（**动机位放肯定命题** ✓ 铁律）· 练习 1 ✓

theorem union_subset_iff (α : Type) (A B C : Set α) (h1 : A ⊆ C) (h2 : B ⊆ C) :
    (A ∪ B) ⊆ C := by
  sorry
-- 练习 9（L 类，**交的"最大性"**）：**`C ⊆ A ⇒ C ⊆ B ⇒ C ⊆ A ∩ B`**。

-- soko:hint 关键件：练习 1（两次）· `Set.mem_inter_iff` · `Iff.mpr` · `And.intro` ✓

theorem subset_inter_of_both (α : Type) (A B C : Set α) (h1 : C ⊆ A) (h2 : C ⊆ B) :
    C ⊆ (A ∩ B) := by
  sorry
