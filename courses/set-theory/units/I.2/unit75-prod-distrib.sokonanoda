-- ==========================================================================
-- unit75-prod-distrib.sokonanoda —— 卷 I 单元75 **笛卡尔积对并/交的分配**
--
-- 靶子（教材）：Enderton《Elements of Set Theory》**§3.2**（Cartesian products）·
--   Halmos《Naive Set Theory》**§6/§9**。大纲 §4.1（**I.2 ↔ I.9 合流** ✓）。
--
-- 本单元的"该学的定理"：
--   · 积的三条取用子（第一坐标 · 第二坐标 · 合成 ✓ —— 都用**投影**表述 ✓）；
--   · **旗舰一：`p ∈ s ×ˢ (t ∪ u) ⇔ p ∈ (s ×ˢ t) ∪ (s ×ˢ u)`** ✓（**积对并分配** ✓）；
--   · **旗舰二：`p ∈ s ×ˢ (t ∩ u) ⇔ p ∈ (s ×ˢ t) ∩ (s ×ˢ u)`** ✓（**积对交分配** ✓）；
--   · **`s ×ˢ ∅` 没有成员** ✓ · **单调**（两个坐标各单调 ✓）
--
-- ⚠ **为什么两条分配都成立** ✓：成员刻画的右边是 `fst p ∈ s ∧ snd p ∈ …` ✓，
--   而分配律就是命题逻辑里的 `P ∧ (Q ∨ R) ↔ (P ∧ Q) ∨ (P ∧ R)` ✓ 与
--   `P ∧ (Q ∧ R) ↔ (P ∧ Q) ∧ (P ∧ R)` ✓ —— **两条都是构造性有效的** ✓
--   （不像"像与交"那种要单射 ✗，见单元73 ✓）。
--
-- ⚠ **写法要点** ✓：积的成员刻画用**投影** `Prod.fst`/`Prod.snd` ✓（点名 ✓），
--   因而**不需要 η 引理** ✓ —— 这是本单元避开"序对相等"那条难路的关键 ✓。
--   `×ˢ` 有记法 ✓；`Set.prod` 是它的点名形式 ✓。
--
-- **本单元只允许用**：`intro` / `exact` / `apply` / `constructor` / `cases` / `have`，
--   加 `import` 进来的库引理。**解答一律项风格**。
-- **本单元 `import` 三样**：`lib.Set` · `lib.Prod` · `lib.Order`。
--
-- 依赖：单元⑤（序对与积）· 单元㉓（积的代数）· 单元③（并交差）· 单元73/74（像与原像）✓
-- ==========================================================================
import lib.Set
import lib.Prod
import lib.Order

-- ─────────────────────────────────────────────────────────────
-- 75.1 三条库引理（积的成员刻画 · 序对形态 · 并）
-- ─────────────────────────────────────────────────────────────

-- 演示：积的成员刻画（**用投影表述** —— 这就是本单元避开 η 引理的关键 ✓）。
theorem demo_mem_prod_iff (A : Type) (B : Type) (s : Set A) (t : Set B) (p : Prod A B) :
    p ∈ (s ×ˢ t) ↔ (Prod.fst A B p) ∈ s ∧ (Prod.snd A B p) ∈ t :=
  Set.mem_prod_iff A B s t p
theorem demo_mem_prod_mk (A : Type) (B : Type) (s : Set A) (t : Set B) (a : A) (b : B) :
    (prod_mk A B a b) ∈ (s ×ˢ t) ↔ a ∈ s ∧ b ∈ t :=
  Set.mem_prod_mk A B s t a b
theorem demo_mem_union (α : Type) (a : α) (A B : Set α) :
    a ∈ (A ∪ B) ↔ a ∈ A ∨ a ∈ B :=
  Set.mem_union a A B-- 练习 1（T 类）：**进积 ⇒ 第一坐标在 `s` 里**。

-- soko:hint 关键件：`Set.mem_prod_iff`（**先 λ 绑定再 `Iff.mp`** ✓）· `And.left`（**写全前导实参** ✓）
theorem mem_prod_fst (A : Type) (B : Type) (s : Set A) (t : Set B) (p : Prod A B)
    (h : p ∈ (s ×ˢ t)) : (Prod.fst A B p) ∈ s := by
  sorry
-- 练习 2（T 类）：**进积 ⇒ 第二坐标在 `t` 里**。

-- soko:hint 关键件：`Set.mem_prod_iff` · `Iff.mp` · `And.right`（**写全** ✓）
theorem mem_prod_snd (A : Type) (B : Type) (s : Set A) (t : Set B) (p : Prod A B)
    (h : p ∈ (s ×ˢ t)) : (Prod.snd A B p) ∈ t := by
  sorry
-- 练习 3（T 类）：两个坐标各就位 ⇒ 进积。

-- soko:hint 关键件：`Set.mem_prod_iff` · `Iff.mpr` · `And.intro`（**写全** ✓）
theorem mem_prod_intro (A : Type) (B : Type) (s : Set A) (t : Set B) (p : Prod A B)
    (h1 : (Prod.fst A B p) ∈ s) (h2 : (Prod.snd A B p) ∈ t) : p ∈ (s ×ˢ t) := by
  sorry
-- 练习 4（L 类，**旗舰一**）：**积对并分配**（`p ∈ s ×ˢ (t ∪ u) ↔ p ∈ (s ×ˢ t) ∪ (s ×ˢ u)`）。

-- soko:hint 思路：两边都化到「两个坐标的命题」✓ —— 左到右用 `Or.elim` 分两支

--   （**动机位放肯定命题** ✓ 铁律），右到左两支各用练习 1–3 合成 ✓。

-- soko:hint 教学点：这条就是 `P ∧ (Q ∨ R) ↔ (P ∧ Q) ∨ (P ∧ R)` ✓（**构造性有效** ✓）。

-- soko:hint 关键件：`Set.mem_prod_iff` · `Set.mem_union` · `Or.elim` / `Or.inl` / `Or.inr` · 练习 1–3 ✓
theorem mem_prod_union_iff (A : Type) (B : Type) (s : Set A) (t : Set B) (u : Set B)
    (p : Prod A B) :
    p ∈ (s ×ˢ (t ∪ u)) ↔ p ∈ ((s ×ˢ t) ∪ (s ×ˢ u)) := by
  sorry
-- 练习 5（L 类，**旗舰二**）：**积对交分配**。

-- soko:hint 教学点：这条是 `P ∧ (Q ∧ R) ↔ (P ∧ Q) ∧ (P ∧ R)` ✓（**构造性有效** ✓）。

-- soko:hint 关键件：`Set.mem_prod_iff` · `Set.mem_inter_iff` · `And.left`/`And.right`/`And.intro`

--   （**一律写全前导实参** ✓）· 练习 1–3 ✓
theorem mem_prod_inter_iff (A : Type) (B : Type) (s : Set A) (t : Set B) (u : Set B)
    (p : Prod A B) :
    p ∈ (s ×ˢ (t ∩ u)) ↔ p ∈ ((s ×ˢ t) ∩ (s ×ˢ u)) := by
  sorry
-- 练习 6（T 类）：**`s ×ˢ ∅` 没有成员**。

-- soko:hint 关键件：练习 2（第二坐标落在 `∅` 里 ✗）· `Set.mem_empty_iff_false` ✓
theorem not_mem_prod_empty (A : Type) (B : Type) (s : Set A) (p : Prod A B) :
    ¬ (p ∈ (s ×ˢ (∅))) := by
  sorry
-- 练习 7（T 类，**收尾**）：**单调**（两个坐标各单调 ⇒ 积单调 ✓）。

-- soko:hint 关键件：`Set.subset_def`（**两次，类型不同** ✓）· `Iff.mp` · 练习 1 / 练习 2 / 练习 3 ✓
theorem prod_mono (A : Type) (B : Type) (s₁ : Set A) (s₂ : Set A) (t₁ : Set B) (t₂ : Set B)
    (h1 : s₁ ⊆ s₂) (h2 : t₁ ⊆ t₂) (p : Prod A B) (h : p ∈ (s₁ ×ˢ t₁)) : p ∈ (s₂ ×ˢ t₂) := by
  sorry
