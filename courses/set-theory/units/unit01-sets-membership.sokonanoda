-- ==========================================================================
-- unit01-sets-membership.sokonanoda —— 卷 I 单元① 集合与隶属
--
-- **本单元只允许用**（tactic 白名单）：
--   `intro` / `exact` / `apply` / `assumption` / `rfl` / `constructor` / `cases`
--   加 lib/ 里已备好的引理（`Set.subset_def`、`Set.mem_singleton_iff`、…）。
--   **不需要**自己写 `Eq.symm`/`Or.elim`/`Iff.mp` 这类东西——那是标准库的一部分
--   （见 docs/design/course-stdlib.md）。
--
-- **记法不用自己声明**：`∈` / `⊆` / `{a}` 由 `lib/Set` 提供、随 `import` 生效；
--   逻辑连接符 `∧ ∨ ↔ ¬` 与箭头 `→` 是**语言内建**（Lean core 级），任何文件
--   直接写。所以下面看不到一条 `infix`/`notation`。
-- ==========================================================================
import lib.Logic
import lib.Set

-- ─────────────────────────────────────────────────────────────
-- 1.1 集合就是"论域上的谓词"
--
--     x ∈ A   ↔  Set.mem α x A   ↔  A x
--     A ⊆ B   ↔  Set.subset α A B ↔  ∀ x, A x → B x
-- 于是"隶属"不是新东西，就是**函数应用**；"子集"就是**全称箭头**。
-- 符号只是把底下那层结构写短了——报错看不懂时，把它翻回点名形式就懂了。
-- ─────────────────────────────────────────────────────────────

-- 演示（已写好）：子集的定义展开是"定义上相等"。
theorem demo_subset_def (α : Type) (A B : Set α) :
    (A ⊆ B) ↔ ∀ (x : α), A x → B x := by
  exact Set.subset_def α A B

-- 演示（已写好）：隶属 = 应用。
theorem demo_mem_def (α : Type) (a : α) (A : Set α) : (a ∈ A) ↔ A a := by
  constructor
  intro h
  exact h
  intro h
  exact h

-- 练习 1（T 类）：元素落在子集里。
-- soko:hint 思路：手里 h 是 A ⊆ B，目标是一个元素命题；把 h 当函数用。
-- soko:hint 目标形态：目标是 a ∈ B（也就是 B a）。
-- soko:hint 关键件：先 intro 掉 a ∈ A；此时 h a 的类型正是 a ∈ A → a ∈ B，喂进去即可。
theorem mem_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) (a : α) :
    a ∈ A → a ∈ B := by
  sorry

-- 练习 2（X 类：形式 ↔ 散文）：把下面这句散文翻译成定理并证明。
--
--   "A set is determined by its elements: if two sets have exactly the same
--    elements, they are equal."
--
-- soko:hint 思路：这句话就是外延性；库里已作为公理 Set.ext 备好。
-- soko:hint 目标形态：目标是 Eq.{1} (Set α) A B，前提是 ∀ (x : α), A x ↔ B x。
-- soko:hint 关键件：apply Set.ext 会把目标换成逐元素的 ∀ 命题，再 intro 一个 x，交给 h。
theorem eq_of_same_elements (α : Type) (A B : Set α) (h : ∀ (x : α), A x ↔ B x) :
    Eq.{1} (Set α) A B := by
  sorry

-- 练习 3（T 类）：{a} ⊆ A 推出 a ∈ A。（**这一步用不到第 4 题**）
-- soko:hint 思路：子集给每个元素一条通道；把 a 自己喂进去。
-- soko:hint 目标形态：目标是 a ∈ A；手里 h 的类型是 {a} ⊆ A。
-- soko:hint 关键件：apply h 把目标换成 a ∈ {a}——那正是 Set.mem_singleton_self α a（库里）。
theorem mem_of_subset_singleton (α : Type) (A : Set α) (a : α)
    (h : {a} ⊆ A) : a ∈ A := by
  sorry

-- 练习 4（T 类）：a ∈ A 推出 {a} ⊆ A。
-- soko:hint 思路：目标是全称命题；intro 一个元素与"它在 {a} 里"。
-- soko:hint 目标形态：intro 之后手里有 hx : x ∈ {a}，目标是 A x。
-- soko:hint 关键件：Set.mem_singleton_iff α x a 把 hx 变成等式 Eq.{1} α x a；再用 Eq.symm 与 Eq.subst 把这个等式搬进目标（本单元还没有 rw，所以写成 exact 的实参）。
theorem subset_of_mem_singleton (α : Type) (A : Set α) (a : α) (h : a ∈ A) :
    {a} ⊆ A := by
  sorry

-- 练习 5（L 类）：把练习 3 与 4 合成一条"当且仅当"。
-- soko:hint 思路：↔ 就是一对箭头，两边分别用前两题。
-- soko:hint 目标形态：({a} ⊆ A) ↔ a ∈ A。
-- soko:hint 关键件：constructor 会把目标拆成两个方向；两个方向分别就是 mem_of_subset_singleton 与 subset_of_mem_singleton 本身。
theorem singleton_subset_iff (α : Type) (a : α) (A : Set α) :
    ({a} ⊆ A) ↔ a ∈ A := by
  sorry

-- 练习 6（D 类）：下面两条哪条为真？
--   (i)  若 {a} = {b}，则 a = b。
--   (ii) 若 a = b，则 {a} = {b}。
-- 为真的证明，为假的说明理由（写在注释里）。
-- soko:hint 思路：(i) 用"a ∈ {a}"沿等式搬过去再展开；(ii) 两个集合相等就逐元素证 ↔。
-- soko:hint 目标形态：目标是 (Eq.{1} (Set α) {a} {b}) ↔ Eq.{1} α a b，两个方向分别如上。
-- soko:hint 关键件：(i) Eq.subst 把 a ∈ {a} 搬到 {b} 上，再用 Set.mem_singleton_iff 取出等式；(ii) apply Set.ext 之后对每个 x 用 constructor，两边各用一次 Set.mem_singleton_iff 与 Eq.trans。
theorem singleton_eq_singleton_iff (α : Type) (a b : α) :
    (Eq.{1} (Set α) {a} {b}) ↔ Eq.{1} α a b := by
  sorry
