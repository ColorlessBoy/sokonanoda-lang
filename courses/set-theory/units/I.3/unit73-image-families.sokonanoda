    (h : y ∈ (f '' (Set.sUnion α F))) : ∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A) := by  -- soko:notation-ok: `⋃`/`⋂`/`Set.*` 是 def 头，这些位置补不出前导实参（手册边界）
