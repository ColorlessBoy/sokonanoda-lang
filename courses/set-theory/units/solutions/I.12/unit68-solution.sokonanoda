import lib.Set
import lib.SUnion
import lib.Order

theorem demo_mem_powerset (α : Type) (A B : Set α) :
    B ∈ (𝒫 A) ↔ B ⊆ A :=
  Set.mem_powerset_iff A B

theorem demo_subset_def (α : Type) (A B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def α A B

theorem demo_mem_sUnion (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ (⋃₀ F) ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A :=
  Set.mem_sUnion_iff α F x

theorem mem_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) (a : α) (ha : a ∈ A) : a ∈ B :=
  (fun (hu : ∀ (x : α), x ∈ A → x ∈ B) => hu a ha)
    ((fun (hv : A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B) => Iff.mp hv h) (Set.subset_def α A B))

theorem subset_refl (α : Type) (A : Set α) : A ⊆ A :=
  fun (a : α) (ha : a ∈ A) => ha

theorem empty_subset (α : Type) (A : Set α) : (∅ α) ⊆ A :=
  fun (a : α) (h : a ∈ (∅ α)) =>
    (False.elim (a ∈ A)) ((Iff.mp (Set.mem_empty_iff_false a)) h)

theorem powerset_self_mem (α : Type) (A : Set α) : A ∈ (𝒫 A) :=
  (fun (hu : A ∈ (𝒫 A) ↔ A ⊆ A) => Iff.mpr hu (subset_refl α A))
    (Set.mem_powerset_iff A A)

theorem sUnion_powerset_subset (α : Type) (A : Set α) :
    (⋃₀ (𝒫 A)) ⊆ A :=
  fun (x : α) (h : x ∈ (⋃₀ (𝒫 A))) =>  -- soko:notation-ok: `𝒫`/`⋃`/`⋂` 无记法（点名写法）+ `∈`/`⊆` 是 def 头（手册边界）
    Exists.elim (Set α) (fun (B : Set α) => B ∈ (𝒫 A) ∧ x ∈ B) (x ∈ A)  -- soko:notation-ok: `𝒫`/`⋃`/`⋂` 无记法（点名写法）+ `∈`/`⊆` 是 def 头（手册边界）
      ((fun (hu : x ∈ (⋃₀ (𝒫 A)) ↔
          ∃ (B : Set α), B ∈ (𝒫 A) ∧ x ∈ B) => Iff.mp hu h)
        (Set.mem_sUnion_iff α (𝒫 A) x))
      (fun (B : Set α) (hB : B ∈ (𝒫 A) ∧ x ∈ B) =>
        mem_of_subset α B A
          ((fun (hu : B ∈ (𝒫 A) ↔ B ⊆ A) =>
            Iff.mp hu (And.left hB))
            (Set.mem_powerset_iff A B))
          x (And.right hB))

theorem subset_sUnion_powerset (α : Type) (A : Set α) :
    A ⊆ (⋃₀ (𝒫 A)) :=
  fun (a : α) (ha : a ∈ A) =>
    (fun (hu : a ∈ (⋃₀ (𝒫 A)) ↔
        ∃ (B : Set α), B ∈ (𝒫 A) ∧ a ∈ B) =>
      Iff.mpr hu (Exists.intro (Set α)
        (fun (B : Set α) => B ∈ (𝒫 A) ∧ a ∈ B) A
        (And.intro (powerset_self_mem α A) ha)))
      (Set.mem_sUnion_iff α (𝒫 A) a)

theorem sInter_powerset_subset (α : Type) (A : Set α) :
    (⋂₀ (𝒫 A)) ⊆ A :=
  fun (x : α) (h : x ∈ (⋂₀ (𝒫 A))) =>
    Set.mem_sInter_elim α (𝒫 A) x (x ∈ A) h
      (fun (k : ∀ (B : Set α), B ∈ (𝒫 A) → x ∈ B) =>
        k A (powerset_self_mem α A))

theorem powerset_mono (α : Type) (A B C : Set α) (h : A ⊆ B) (hC : C ∈ (𝒫 A)) :
    C ∈ (𝒫 B) :=
  (fun (hu : C ∈ (𝒫 B) ↔ C ⊆ B) =>
    Iff.mpr hu (fun (c : α) (hc : c ∈ C) =>
      mem_of_subset α A B h c
        ((fun (hv : C ∈ (𝒫 A) ↔ C ⊆ A) => Iff.mp hv hC)
          (Set.mem_powerset_iff A C) c hc)))
    (Set.mem_powerset_iff B C)
