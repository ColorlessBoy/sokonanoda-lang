-- unit02 解答钥匙（agent 专用）。
-- 前 6 题的证明**原先住在 lib/Set.sokonanoda 里**——那是分层错误（台账 L-05）：
-- Mathlib 有它们，但它们有数学内容，属于练习。现在它们只在这里与画布里。
--
-- 全部改写为 **tactic 模式**（设计 docs/design/course-lean-style.md R2）：
-- 记法用 Lean core 的符号（`∈ ⊆ ∅ {a} {a, b} = ≠ ∧ ↔ ¬`），证明用 `by` 块。
import lib.Logic
import lib.Set

theorem subset_refl (α : Type) (A : Set α) : A ⊆ A := by
  intro x
  intro hx
  exact hx

theorem subset_trans (α : Type) (A B C : Set α)
    (h1 : A ⊆ B) (h2 : B ⊆ C) : A ⊆ C := by
  intro x
  intro hx
  exact h2 x (h1 x hx)

theorem subset_antisymm (α : Type) (A B : Set α)
    (h1 : A ⊆ B) (h2 : B ⊆ A) : A = B := by
  apply Set.ext
  intro x
  constructor
  exact h1 x
  exact h2 x

theorem empty_subset (α : Type) (A : Set α) : ∅ ⊆ A := by
  intro x
  intro hx
  exact False.elim (x ∈ A) hx

theorem subset_empty_iff (α : Type) (A : Set α) :
    (A ⊆ ∅) ↔ (A = ∅) := by
  constructor
  intro h
  apply subset_antisymm
  exact h
  exact empty_subset α A
  intro h
  exact Eq.subst.{1} (Set α) (fun (X : Set α) => A ⊆ X) A ∅ h (subset_refl α A)

theorem eq_empty_iff_forall_notMem (α : Type) (A : Set α) :
    (A = ∅) ↔ (∀ (x : α), ¬ (x ∈ A)) := by
  constructor
  intro h
  intro x
  intro hx
  exact Set.notMem_empty α x (Eq.subst.{1} (Set α) (fun (X : Set α) => x ∈ X) A ∅ h hx)
  intro h
  apply subset_antisymm
  intro x
  intro hx
  exact absurd (x ∈ A) (x ∈ ∅) hx (h x)
  exact empty_subset α A

-- 后四条的语句一度只能写**点名形式**（`Not (Eq.{1} …)`），因为 `≠` 展开成 `Ne`
-- 之后定义体里的宇宙变量 `u` 没人实例化（源 AST 是记法节点、内核 pp 又是裸名，
-- 两条路都不带 `.{u}`）⇒ `intro` 报 `unknown universe level u`。判卷器现在按
-- **操作数的 sort** 算层级提示（与 `elab_notation` 给记法求层级同一条规则），
-- 所以下面四题与画布逐字一致。
theorem singleton_ne_empty (α : Type) (a : α) : {a} ≠ ∅ := by
  intro h
  exact Set.notMem_empty α a
    (Eq.subst.{1} (Set α) (fun (X : Set α) => Set.mem α a X) (Set.singleton α a)
      (Set.empty α) h (Set.mem_singleton_self α a))

theorem pair_subset_iff (α : Type) (a b : α) (A : Set α) :
    {a, b} ⊆ A ↔ a ∈ A ∧ b ∈ A := by
  constructor
  intro h
  constructor
  exact h a (Or.inl (Eq.{1} α a a) (Eq.{1} α a b) (Eq.refl.{1} α a))
  exact h b (Or.inr (Eq.{1} α b a) (Eq.{1} α b b) (Eq.refl.{1} α b))
  intro h
  intro x
  intro hx
  exact Or.elim (Eq.{1} α x a) (Eq.{1} α x b) (A x)
    (fun (hxa : Eq.{1} α x a) =>
      Eq.subst.{1} α (fun (y : α) => A y) a x (Eq.symm.{1} α x a hxa)
        (And.left (Set.mem α a A) (Set.mem α b A) h))
    (fun (hxb : Eq.{1} α x b) =>
      Eq.subst.{1} α (fun (y : α) => A y) b x (Eq.symm.{1} α x b hxb)
        (And.right (Set.mem α a A) (Set.mem α b A) h))
    hx

theorem pair_comm (α : Type) (a b : α) : {a, b} = {b, a} := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact Or.elim (Eq.{1} α x a) (Eq.{1} α x b) ((Eq.{1} α x b) ∨ (Eq.{1} α x a))
    (fun (ha : Eq.{1} α x a) => Or.inr (Eq.{1} α x b) (Eq.{1} α x a) ha)
    (fun (hb : Eq.{1} α x b) => Or.inl (Eq.{1} α x b) (Eq.{1} α x a) hb)
    h
  intro h
  exact Or.elim (Eq.{1} α x b) (Eq.{1} α x a) ((Eq.{1} α x a) ∨ (Eq.{1} α x b))
    (fun (hb : Eq.{1} α x b) => Or.inr (Eq.{1} α x a) (Eq.{1} α x b) hb)
    (fun (ha : Eq.{1} α x a) => Or.inl (Eq.{1} α x a) (Eq.{1} α x b) ha)
    h

theorem singleton_of_singleton (a : Nat) : {a} ∈ {{a}} := by
  exact Eq.refl.{1} (Set Nat) (Set.singleton Nat a)
