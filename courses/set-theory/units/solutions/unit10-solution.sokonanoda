-- unit10 解答钥匙（agent 专用；画布不 import 它）。
--
-- 判据：全部证明只用 lib/ 与 prelude 里已备好的东西——学习者的负担只有"集合论内容"。
-- 三条纪律：
--   · lib/Equiv 的等势是**数据版**（一对互逆映射 + 四条条件），不是"存在双射"：
--     用它只能用 Exists.elim 两次，而且每次的结论里不许提到证人 f / g；
--   · 对角线论证不需要外延性、也不需要选择公理——练习 1–6 一条新公理都没引；
--   · **练习 7 是唯一的例外**：它正面用一次选择公理（Exists.choose 与成对的
--     Exists.choose_spec，见文件末尾），把单元⑦ 只能写成数据版的那条补成存在版
--     （台账 L-06 的边界就记在这里）。
import lib.Logic
import lib.Set
import lib.Exists
import lib.Fun
import lib.Equiv

-- 练习 1（T）：可数的定义 = 与 ℕ 等势。
def Set.Countable (α : Type) : Prop :=
  Set.Equiv Nat α (Set.univ Nat) (Set.univ α)

-- 练习 2（L）：恒等映射给出 ℕ 与自己的等势（=「ℕ 可数」的实例）。
-- 两条"进集合"的域条件是 True 的证明，两条互逆律是 rfl 级。
theorem nat_equiv_nat : Set.Equiv Nat Nat (Set.univ Nat) (Set.univ Nat) :=
  Set.Equiv.mk Nat Nat (Set.univ Nat) (Set.univ Nat)
    (fun (n : Nat) => n)
    (fun (n : Nat) => n)
    (fun (x : Nat) => fun (hx : Set.mem Nat x (Set.univ Nat)) => True.intro)
    (fun (y : Nat) => fun (hy : Set.mem Nat y (Set.univ Nat)) => True.intro)
    (fun (x : Nat) => fun (hx : Set.mem Nat x (Set.univ Nat)) => Eq.refl.{1} Nat x)
    (fun (y : Nat) => fun (hy : Set.mem Nat y (Set.univ Nat)) => Eq.refl.{1} Nat y)

-- 练习 3（T）：对角线集合的成员判定——定义层面的相等。
theorem diag_mem_iff (α : Type) (f : α -> Set α) (x : α) :
    Iff (Set.mem α x (fun (y : α) => Not (f y y))) (Not (f x x)) :=
  Iff.refl (Not (f x x))

-- 练习 4（L）：Cantor 定理。
-- 结构：intro 等势 → 外层 Exists.elim 取正向映射 f（结论 False 不许提 f）
--       → 内层 Exists.elim 取反向映射 g → ④号互逆律（PD）在 D := fun y => Not (f y y) 上
--       给出 Eq (f (g D)) D → 调向 → 对角线矛盾（D (g D) 与 f (g D) (g D) 互为否定）。
-- 两个 motive（MF/MG）先 let 出来，因为 Exists.elim 的 p 是全显式参数。
-- 画布里的 demo_diag 就是这条对角线矛盾；解答是独立文件（不 import 画布），所以这里把它
-- 就地写开（练习 6 同理）——学习者在画布里可以直接点 demo_diag，不必重复这一段。
theorem cantor (α : Type) :
    Not (Set.Equiv α (Set α) (Set.univ α) (Set.univ (Set α))) :=
  fun (h : Set.Equiv α (Set α) (Set.univ α) (Set.univ (Set α))) =>
    let MF : (α -> Set α) -> Prop :=
      fun (f : α -> Set α) =>
        And (forall (x : α), Set.mem α x (Set.univ α) -> Set.mem (Set α) (f x) (Set.univ (Set α)))
          (Exists ((Set α) -> α) (fun (g : (Set α) -> α) =>
            And (forall (y : Set α),
                  Set.mem (Set α) y (Set.univ (Set α)) -> Set.mem α (g y) (Set.univ α))
              (And (forall (x : α), forall (hx : Set.mem α x (Set.univ α)), Eq.{1} α (g (f x)) x)
                   (forall (y : Set α), forall (hy : Set.mem (Set α) y (Set.univ (Set α))),
                     Eq.{1} (Set α) (f (g y)) y))));
    Exists.elim (α -> Set α) MF False h
      (fun (f : α -> Set α) => fun (hf : MF f) =>
        let UF : Prop :=
          forall (x : α), Set.mem α x (Set.univ α) -> Set.mem (Set α) (f x) (Set.univ (Set α));
        let MG : ((Set α) -> α) -> Prop :=
          fun (g : (Set α) -> α) =>
            And (forall (y : Set α),
                  Set.mem (Set α) y (Set.univ (Set α)) -> Set.mem α (g y) (Set.univ α))
              (And (forall (x : α), forall (hx : Set.mem α x (Set.univ α)), Eq.{1} α (g (f x)) x)
                   (forall (y : Set α), forall (hy : Set.mem (Set α) y (Set.univ (Set α))),
                     Eq.{1} (Set α) (f (g y)) y));
        let hMG : Exists ((Set α) -> α) MG := And.right UF (Exists ((Set α) -> α) MG) hf;
        Exists.elim ((Set α) -> α) MG False hMG
          (fun (g : (Set α) -> α) => fun (hg : MG g) =>
            let PA : Prop :=
              forall (y : Set α), Set.mem (Set α) y (Set.univ (Set α)) -> Set.mem α (g y) (Set.univ α);
            let PD : Prop :=
              forall (y : Set α), forall (hy : Set.mem (Set α) y (Set.univ (Set α))),
                Eq.{1} (Set α) (f (g y)) y;
            let PC : Prop :=
              forall (x : α), forall (hx : Set.mem α x (Set.univ α)), Eq.{1} α (g (f x)) x;
            let hPD : PD := And.right PC PD (And.right PA (And PC PD) hg);
            let D : Set α := fun (y : α) => Not (f y y);
            let hD : Eq.{1} (Set α) (f (g D)) D := hPD D True.intro;
            let e : Eq.{1} Prop (f (g D) (g D)) (Not (f (g D) (g D))) :=
              congrArg.{1} (Set α) Prop (fun (X : Set α) => X (g D)) (f (g D)) D hD;
            let np : Not (f (g D) (g D)) := fun (p : f (g D) (g D)) =>
              (Eq.subst.{1} Prop (fun (Q : Prop) => Q) (f (g D) (g D))
                (Not (f (g D) (g D))) e p) p;
            let hp : f (g D) (g D) :=
              Eq.subst.{1} Prop (fun (Q : Prop) => Q) (Not (f (g D) (g D)))
                (f (g D) (g D))
                (Eq.symm.{1} Prop (f (g D) (g D)) (Not (f (g D) (g D))) e) np;
            absurd (f (g D) (g D)) False hp np))

-- 练习 5（D）：「𝒫ℕ 可数」为假——Cantor 定理在 α := Nat 上的实例。
theorem powerset_nat_not_countable :
    Not (Set.Equiv Nat (Set Nat) (Set.univ Nat) (Set.univ (Set Nat))) :=
  cantor Nat

-- 练习 6（D）：不存在 α -> Set α 的满射（假的枚举补不成满射）。
-- 只有满射可拆，所以对角线这里自己接：hf D 给原像 x 与 Eq (f x) D，再制造 P ↔ ¬P 的矛盾。
theorem no_surjection_powerset (α : Type) :
    Not (Exists (α -> Set α) (fun (f : α -> Set α) => Function.Surjective α (Set α) f)) :=
  fun (h : Exists (α -> Set α) (fun (f : α -> Set α) => Function.Surjective α (Set α) f)) =>
    Exists.elim (α -> Set α)
      (fun (f : α -> Set α) => Function.Surjective α (Set α) f)
      False h
      (fun (f : α -> Set α) => fun (hf : Function.Surjective α (Set α) f) =>
        let D : Set α := fun (y : α) => Not (f y y);
        Exists.elim α (fun (x : α) => Eq.{1} (Set α) (f x) D) False (hf D)
          (fun (x : α) => fun (hx : Eq.{1} (Set α) (f x) D) =>
            let e : Eq.{1} Prop (f x x) (Not (f x x)) :=
              congrArg.{1} (Set α) Prop (fun (X : Set α) => X x) (f x) D hx;
            let np : Not (f x x) := fun (p : f x x) =>
              (Eq.subst.{1} Prop (fun (Q : Prop) => Q) (f x x) (Not (f x x)) e p) p;
            let hp : f x x :=
              Eq.subst.{1} Prop (fun (Q : Prop) => Q) (Not (f x x)) (f x x)
                (Eq.symm.{1} Prop (f x x) (Not (f x x)) e) np;
            absurd (f x x) False hp np))

-- 练习 7（L）：满射 ⇒ 存在右逆函数——**卷 I 唯一一次用选择公理**（台账 L-06 的边界）。
--
-- 公理成对出现（Lean 4 core 同款；Avigad《Logic and Proof》§16.4 写成 `choose h` 配
-- `choose_spec h`）：`Exists.choose` 只挑出元素，`Exists.choose_spec` 才说明挑中的那个
-- 满足性质。所以右逆 g 的**函数体**由 choose 填、**逐点等式**由 choose_spec 交：
--   g := fun y => choose (hf y)                     —— 每个 y 挑一个原像
--   f (g y) = y 就是 choose_spec (hf y) 的类型展开  —— 挑出来的确实是原像
-- 少了 choose_spec，g 只是一个来路不明的 α 元素，"f (g y) = y" 一个字都写不出来——
-- 这正是单元⑦ 题 6 只能把 g 与互逆证据当**参数**收下的原因（数据版，L-06）。
-- 本文件其它 6 题、以及卷 I 其它单元，一条都没引这两条公理。
axiom Exists.choose : (A : Type) -> (p : A -> Prop) -> Exists A p -> A
axiom Exists.choose_spec : (A : Type) -> (p : A -> Prop) -> (h : Exists A p) ->
  p (Exists.choose A p h)

theorem choice_split (α β : Type) (f : α -> β)
    (hf : Function.Surjective α β f) :
    Exists (β -> α) (fun (g : β -> α) => Function.RightInverse α β g f) :=
  let g : β -> α := fun (y : β) => Exists.choose α (fun (x : α) => Eq.{1} β (f x) y) (hf y);
  Exists.intro (β -> α) (fun (g : β -> α) => Function.RightInverse α β g f) g
    (fun (y : β) => Exists.choose_spec α (fun (x : α) => Eq.{1} β (f x) y) (hf y))
