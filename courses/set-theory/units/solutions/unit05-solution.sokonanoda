-- ==========================================================================
-- unit05 解答钥匙（agent 专用；画布不 import 它，画布与它各自自足）
--
-- 与画布 courses/set-theory/units/unit05-pairs-products.sokonanoda 的练习**同名一一对应**：
--     prod_fst_mk · prod_snd_mk · prod_mk_inj · prod_mk_eq_iff ·
--     mem_prod_iff · prod_set_swap_ne · kura_degenerate
--
-- 本文件自带 `def Set.prod`：画布里的同一条定义是**给定词汇**（不是练习），而两个文件
-- 之间无法共享名字（模块名不能带 `-`，台账 G-12 的同一族限制；同名重声明会被内核判
-- import-name-collision），所以这里原样抄一遍。因此本文件的 decl_checked = 7 条练习 + 1 条 def。
--
-- 全部改写为 **tactic 模式**（设计 docs/design/course-lean-style.md R2）：语句与画布
-- 逐字一致，记法用 Lean core 的符号（`∈ ⊆ ×ˢ = ≠ ∧ ∨ ↔` 与集合字面量 `{a}` / `{a, b}`），
-- 证明用 `by` 块。引理名照旧点名（`Prod.fst_mk` / `Eq.subst.{1}` / `Or.elim` …）——
-- 记法是**连接符**的糖，不是引理名的糖。
--
-- 每条证明只用到 lib/ 与 prelude 里已备好的东西（Prod.fst_mk / Prod.snd_mk / Eq.subst /
-- Set.ext / Or.elim / Set.mem_singleton_self …），学习者不需要任何"额外的数学"。
-- ==========================================================================
import lib.Logic
import lib.Set
import lib.Prod

-- 画布 5.2 的给定定义（笛卡尔积），此处原样重抄，供下面的练习使用。
-- `×ˢ` 记法的目标就是它——所以本文件里 `s ×ˢ t` 只在**这一行之后**可用。
def Set.prod (A B : Type) (s : Set A) (t : Set B) : Set (Prod A B) :=
  fun (p : Prod A B) => (s (Prod.fst A B p)) ∧ (t (Prod.snd A B p))

-- 练习 1（T 类）：投影算在构造子上（直接点名库里的展开引理）。
theorem prod_fst_mk (A B : Type) (a : A) (b : B) :
    Prod.fst A B (prod_mk A B a b) = a := by
  exact Prod.fst_mk A B a b

-- 练习 2（T 类）：第二个投影同款。
theorem prod_snd_mk (A B : Type) (a : A) (b : B) :
    Prod.snd A B (prod_mk A B a b) = b := by
  exact Prod.snd_mk A B a b

-- 练习 3（L 类）：配对定理 —— 序对相等沿两个投影各搬一次。
theorem prod_mk_inj (A B : Type) (a a1 : A) (b b1 : B) :
    prod_mk A B a b = prod_mk A B a1 b1 → a = a1 ∧ b = b1 := by
  intro h
  constructor
  exact Eq.subst.{1} (Prod A B) (fun (p : Prod A B) => a = Prod.fst A B p)
    (prod_mk A B a b) (prod_mk A B a1 b1) h (Eq.refl.{1} A a)
  exact Eq.subst.{1} (Prod A B) (fun (p : Prod A B) => b = Prod.snd A B p)
    (prod_mk A B a b) (prod_mk A B a1 b1) h (Eq.refl.{1} B b)

-- 练习 4（L 类）：配对定理的完整形态；← 方向对两个坐标各做一次 Eq.subst。
theorem prod_mk_eq_iff (A B : Type) (a a1 : A) (b b1 : B) :
    (prod_mk A B a b = prod_mk A B a1 b1) ↔ (a = a1 ∧ b = b1) := by
  constructor
  exact prod_mk_inj A B a a1 b b1
  intro h
  have ha : a = a1 := And.left h
  have hb : b = b1 := And.right h
  exact Eq.subst.{1} B (fun (y : B) => prod_mk A B a b = prod_mk A B a1 y) b b1 hb
    (Eq.subst.{1} A (fun (x : A) => prod_mk A B a b = prod_mk A B x b) a a1 ha
      (Eq.refl.{1} (Prod A B) (prod_mk A B a b)))

-- 练习 5（T 类）：A ×ˢ B 的成员刻画 —— 两边定义上相等，两个方向都是恒等函数。
theorem mem_prod_iff (A B : Type) (s : Set A) (t : Set B) (p : Prod A B) :
    p ∈ s ×ˢ t ↔ Prod.fst A B p ∈ s ∧ Prod.snd A B p ∈ t := by
  constructor
  intro h
  exact h
  intro h
  exact h

-- 练习 6（D 类）：A ×ˢ B = B ×ˢ A 的反例（同一类型上 s = {a}、t = {b}）。
-- 把 `prod_mk A A a b ∈ {a} ×ˢ {b}` 沿假设的等式搬到 `{b} ×ˢ {a}` 上，
-- 搬完它就变成 `a = b ∧ b = a`。
theorem prod_set_swap_ne (A : Type) (a b : A) (h : a ≠ b) :
    {a} ×ˢ {b} ≠ {b} ×ˢ {a} := by
  intro e
  exact h (And.left
    (Eq.subst.{1} (Set (Prod A A))
      (fun (S : Set (Prod A A)) => prod_mk A A a b ∈ S)
      ({a} ×ˢ {b}) ({b} ×ˢ {a}) e
      (And.intro
        (Set.mem_singleton_self A a) (Set.mem_singleton_self A b))))

-- 练习 7（R 类）：Kuratowski 编码的退化情形 —— a = b 时 {{a},{a,b}} 塌缩成 {{a}}。
-- 外层 Set.ext 逐元素 x : Set α 证 Iff；右到左直接 Or.inl；左到右 cases 分两支，
-- 其中 x = {a, b} 那一支要再用一次 Set.ext（把 {a, b} 与 {a} 逐点比较）。
-- `cases` 的臂体用 `have … := by …` 包一层：`cases` 组装出来的是 `match`，而
-- `match` 需要一处**有类型标注**的位置（`have` 的标注正好提供它）。
theorem kura_degenerate (α : Type) (a b : α) (h : a = b) :
    {{a}, {a, b}} = {{a}} := by
  apply Set.ext (Set α)
  intro x
  constructor
  intro hX
  have hmem : x = {a} := by
    cases hX with
      | Or.inl h1 => exact h1
      | Or.inr h2 =>
        exact Eq.trans.{1} (Set α) x {a, b} {a} h2
          (Set.ext α {a, b} {a}
            (fun (y : α) =>
              Iff.intro (y = a ∨ y = b) (y = a)  -- soko:notation-ok: 复合项/λ 体的 Eq 型实参隐式反解判红（引擎边界）
                (fun (hy : y = a ∨ y = b) =>
                  Or.elim (y = a) (y = b) (y = a)  -- soko:notation-ok: 复合项/λ 体的 Eq 型实参隐式反解判红（引擎边界）
                    (fun (hya : y = a) => hya)
                    (fun (hyb : y = b) => Eq.trans.{1} α y b a hyb (Eq.symm.{1} α a b h))
                    hy)
                (fun (hya : y = a) => Or.inl hya)))
  exact hmem
  intro h1
  exact Or.inl (x = {a}) (x = {a, b}) h1  -- soko:notation-ok: 复合项/λ 体的 Eq 型实参隐式反解判红（引擎边界）
