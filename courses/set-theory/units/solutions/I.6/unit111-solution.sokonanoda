import lib.Set

def add (a b : Nat) : Nat :=
  Nat.rec (fun (_ : Nat) => Nat) a (fun (n : Nat) (ih : Nat) => Nat.succ ih) b

def mul (a b : Nat) : Nat :=
  Nat.rec (fun (_ : Nat) => Nat) Nat.zero (fun (n : Nat) (ih : Nat) => add a ih) b

theorem add_zero (a : Nat) : Eq.{1} Nat (add a Nat.zero) a :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Eq.refl.{1} Nat a

theorem add_succ (a b : Nat) : Eq.{1} Nat (add a (Nat.succ b)) (Nat.succ (add a b)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Eq.refl.{1} Nat (Nat.succ (add a b))

theorem zero_add (b : Nat) : Eq.{1} Nat (add Nat.zero b) b :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => Eq.{1} Nat (add Nat.zero n) n)  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Eq.{1} Nat (add Nat.zero n) n) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      Eq.subst.{1} Nat (fun (m : Nat) => Eq.{1} Nat (Nat.succ (add Nat.zero n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (add Nat.zero n) n ih (Eq.refl.{1} Nat (Nat.succ (add Nat.zero n))))
    b

theorem succ_add (a b : Nat) : Eq.{1} Nat (add (Nat.succ a) b) (Nat.succ (add a b)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => Eq.{1} Nat (add (Nat.succ a) n) (Nat.succ (add a n)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (Eq.refl.{1} Nat (Nat.succ a))
    (fun (n : Nat) (ih : Eq.{1} Nat (add (Nat.succ a) n) (Nat.succ (add a n))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      Eq.subst.{1} Nat
        (fun (m : Nat) => Eq.{1} Nat (Nat.succ (add (Nat.succ a) n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (add (Nat.succ a) n) (Nat.succ (add a n)) ih
        (Eq.refl.{1} Nat (Nat.succ (add (Nat.succ a) n))))
    b

theorem add_assoc (a b c : Nat) :
    Eq.{1} Nat (add (add a b) c) (add a (add b c)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => Eq.{1} Nat (add (add a b) n) (add a (add b n)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (Eq.refl.{1} Nat (add a b))
    (fun (n : Nat) (ih : Eq.{1} Nat (add (add a b) n) (add a (add b n))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      Eq.subst.{1} Nat
        (fun (m : Nat) => Eq.{1} Nat (Nat.succ (add (add a b) n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (add (add a b) n) (add a (add b n)) ih
        (Eq.refl.{1} Nat (Nat.succ (add (add a b) n))))
    c

theorem add_comm (a b : Nat) : Eq.{1} Nat (add a b) (add b a) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => Eq.{1} Nat (add a n) (add n a))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (Eq.symm.{1} Nat (add Nat.zero a) a (zero_add a))
    (fun (n : Nat) (ih : Eq.{1} Nat (add a n) (add n a)) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      Eq.trans.{1} Nat (Nat.succ (add a n)) (Nat.succ (add n a)) (add (Nat.succ n) a)
        (Eq.subst.{1} Nat
          (fun (m : Nat) => Eq.{1} Nat (Nat.succ (add a n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
          (add a n) (add n a) ih
          (Eq.refl.{1} Nat (Nat.succ (add a n))))
        (Eq.symm.{1} Nat (add (Nat.succ n) a) (Nat.succ (add n a)) (succ_add n a)))
    b

theorem add_rotate (a b c : Nat) :
    Eq.{1} Nat (add a (add b c)) (add b (add a c)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Eq.trans.{1} Nat (add a (add b c)) (add (add a b) c) (add b (add a c))
    (Eq.symm.{1} Nat (add (add a b) c) (add a (add b c)) (add_assoc a b c))
    (Eq.trans.{1} Nat (add (add a b) c) (add (add b a) c) (add b (add a c))
      (Eq.subst.{1} Nat (fun (m : Nat) => Eq.{1} Nat (add (add a b) c) (add m c))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (add a b) (add b a) (add_comm a b) (Eq.refl.{1} Nat (add (add a b) c)))
      (add_assoc b a c))

theorem mul_zero (a : Nat) : Eq.{1} Nat (mul a Nat.zero) Nat.zero :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Eq.refl.{1} Nat Nat.zero

theorem mul_succ (a b : Nat) : Eq.{1} Nat (mul a (Nat.succ b)) (add a (mul a b)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Eq.refl.{1} Nat (add a (mul a b))

theorem zero_mul (b : Nat) : Eq.{1} Nat (mul Nat.zero b) Nat.zero :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => Eq.{1} Nat (mul Nat.zero n) Nat.zero)  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Eq.{1} Nat (mul Nat.zero n) Nat.zero) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      Eq.trans.{1} Nat (add Nat.zero (mul Nat.zero n)) (add Nat.zero Nat.zero) Nat.zero
        (Eq.subst.{1} Nat (fun (m : Nat) => Eq.{1} Nat (add Nat.zero (mul Nat.zero n)) (add Nat.zero m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
          (mul Nat.zero n) Nat.zero ih (Eq.refl.{1} Nat (add Nat.zero (mul Nat.zero n))))
        (zero_add Nat.zero))
    b

theorem mul_distrib (a b c : Nat) :
    Eq.{1} Nat (mul a (add b c)) (add (mul a b) (mul a c)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => Eq.{1} Nat (mul a (add b n)) (add (mul a b) (mul a n)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (Eq.refl.{1} Nat (mul a b))
    (fun (n : Nat) (ih : Eq.{1} Nat (mul a (add b n)) (add (mul a b) (mul a n))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      Eq.trans.{1} Nat (add a (mul a (add b n))) (add a (add (mul a b) (mul a n)))
        (add (mul a b) (add a (mul a n)))
        (Eq.subst.{1} Nat (fun (m : Nat) => Eq.{1} Nat (add a (mul a (add b n))) (add a m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
          (mul a (add b n)) (add (mul a b) (mul a n)) ih
          (Eq.refl.{1} Nat (add a (mul a (add b n)))))
        (add_rotate a (mul a b) (mul a n)))
    c
