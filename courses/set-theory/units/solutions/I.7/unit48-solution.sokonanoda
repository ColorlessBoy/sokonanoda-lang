import lib.Rel
import lib.Set
import lib.SUnion
import lib.Order

theorem demo_mem_sUnion (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ ⋃₀ F ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A :=
  Set.mem_sUnion_iff α F x

theorem demo_mem_sInter (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ ⋂₀ F ↔ ∀ (A : Set α), A ∈ F → x ∈ A :=
  Set.mem_sInter_iff α F x

theorem demo_mem_pi (ι α : Type) (A : ι → Set α) (f : ι → α) :
    f ∈ Set.pi ι α A ↔ ∀ (i : ι), f i ∈ A i :=
  Set.mem_pi_iff ι α A f

theorem subset_sUnion_intro (α : Type) (F : Set (Set α)) (A : Set α) (hA : A ∈ F) :
    A ⊆ ⋃₀ F :=
  fun (x : α) => fun (hx : x ∈ A) =>
    Set.mem_sUnion_intro α F A x hA hx

theorem sUnion_mono (α : Type) (F G : Set (Set α)) (h : F ⊆ G) :
    ⋃₀ F ⊆ Set.sUnion α G :=  -- soko:notation-ok: G-30/G-73 形状 ②③：前导实参或 `Eq` 层级在这些位置补不出来
  fun (x : α) => fun (hx : x ∈ ⋃₀ F) =>
    Set.mem_sUnion_elim α F x (x ∈ ⋃₀ G) hx
      (fun (A : Set α) (hA : A ∈ F) (hxA : x ∈ A) =>
        Set.mem_sUnion_intro α G A x (h A hA) hxA)

theorem sUnion_subset_of_all_subset (α : Type) (F : Set (Set α)) (A : Set α)
    (h : ∀ (B : Set α), B ∈ F → B ⊆ A) : ⋃₀ F ⊆ A :=
  fun (x : α) => fun (hx : x ∈ ⋃₀ F) =>
    Set.mem_sUnion_elim α F x (x ∈ A) hx
      (fun (B : Set α) (hB : B ∈ F) (hxB : x ∈ B) => h B hB x hxB)

theorem all_subset_of_sUnion_subset (α : Type) (F : Set (Set α)) (A : Set α)
    (h : ⋃₀ F ⊆ A) : ∀ (B : Set α), B ∈ F → B ⊆ A :=
  fun (B : Set α) => fun (hB : B ∈ F) => fun (x : α) => fun (hx : x ∈ B) =>
    h x (subset_sUnion_intro α F B hB x hx)

theorem sUnion_mem_of_mem (α : Type) (F : Set (Set α)) (A : Set α) (x : α)
    (hA : A ∈ F) (hx : x ∈ A) : x ∈ ⋃₀ F :=
  Set.mem_sUnion_intro α F A x hA hx

theorem sInter_mem_of_all (α : Type) (F : Set (Set α)) (x : α)
    (h : ∀ (B : Set α), B ∈ F → x ∈ B) : x ∈ ⋂₀ F :=
  (fun (hu : x ∈ ⋂₀ F ↔ ∀ (B : Set α), B ∈ F → x ∈ B) => Iff.mpr hu h)
    (Set.mem_sInter_iff α F x)

theorem sUnion_empty_apply (α : Type) (x : α) :
    ¬ (x ∈ ⋃₀ (fun (_ : Set α) => False)) :=
  fun (hx : x ∈ ⋃₀ (fun (_ : Set α) => False)) =>
    Set.mem_sUnion_elim α (fun (_ : Set α) => False) x False hx
      (fun (A : Set α) (hA : False) (hxA : x ∈ A) => hA)

theorem sUnion_empty_of_all_empty (α : Type) (F : Set (Set α))
    (h : ∀ (A : Set α), A ∈ F → ∀ (x : α), ¬ (x ∈ A)) :
    ∀ (x : α), ¬ (x ∈ ⋃₀ F) :=
  fun (x : α) => fun (hx : x ∈ ⋃₀ F) =>
    Set.mem_sUnion_elim α F x False hx
      (fun (A : Set α) (hA : A ∈ F) (hxA : x ∈ A) => h A hA x hxA)

theorem sInter_subset_of_mem (α : Type) (F : Set (Set α)) (A : Set α) (hA : A ∈ F) :
    ⋂₀ F ⊆ A :=
  fun (x : α) => fun (hx : x ∈ ⋂₀ F) =>
    (fun (hv : ∀ (B : Set α), B ∈ F → x ∈ B) => hv A hA)
      ((fun (hu : x ∈ ⋂₀ F ↔ ∀ (B : Set α), B ∈ F → x ∈ B) =>
        Iff.mp hu hx) (Set.mem_sInter_iff α F x))

theorem sInter_mono (α : Type) (F G : Set (Set α)) (h : F ⊆ G) :
    ⋂₀ G ⊆ ⋂₀ F :=
  fun (x : α) => fun (hx : x ∈ ⋂₀ G) =>
    (fun (hv : ∀ (B : Set α), B ∈ F → x ∈ B) => hv)
      ((fun (hu : x ∈ ⋂₀ F ↔ ∀ (B : Set α), B ∈ F → x ∈ B) =>
        Iff.mpr hu)
        (Set.mem_sInter_iff α F x)
        (fun (B : Set α) (hB : B ∈ F) =>
          (fun (hw : ∀ (C : Set α), C ∈ G → x ∈ C) => hw B (h B hB))
            ((fun (hu : x ∈ ⋂₀ G ↔ ∀ (C : Set α), C ∈ G → x ∈ C) =>
              Iff.mp hu hx) (Set.mem_sInter_iff α G x))))

