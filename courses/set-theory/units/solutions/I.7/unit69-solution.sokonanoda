import lib.Set
import lib.SUnion
import lib.Order

theorem demo_mem_sUnion (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ (⋃₀ F) ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A :=
  Set.mem_sUnion_iff α F x

theorem demo_mem_sInter (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ (⋂₀ F) ↔ ∀ (A : Set α), A ∈ F → x ∈ A :=
  Set.mem_sInter_iff α F x

theorem demo_subset_def (α : Type) (A B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def α A B

theorem mem_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) (a : α) (ha : a ∈ A) : a ∈ B :=
  (fun (hu : ∀ (x : α), x ∈ A → x ∈ B) => hu a ha)
    ((fun (hv : A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B) => Iff.mp hv h) (Set.subset_def α A B))

theorem subset_refl (α : Type) (A : Set α) : A ⊆ A :=
  fun (a : α) (ha : a ∈ A) => ha

theorem mem_of_mem_sUnion (α : Type) (F : Set (Set α)) (x : α)
    (h : x ∈ (⋃₀ F)) : ∃ (A : Set α), A ∈ F ∧ x ∈ A :=
  (fun (hu : x ∈ (⋃₀ F) ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A) => Iff.mp hu h)
    (Set.mem_sUnion_iff α F x)

theorem mem_of_mem_sInter (α : Type) (F : Set (Set α)) (x : α)
    (h : x ∈ (⋂₀ F)) : ∀ (A : Set α), A ∈ F → x ∈ A :=
  (fun (hu : x ∈ (⋂₀ F) ↔ ∀ (A : Set α), A ∈ F → x ∈ A) => Iff.mp hu h)
    (Set.mem_sInter_iff α F x)

theorem sInter_subset_of_mem (α : Type) (F : Set (Set α)) (A : Set α) (hA : A ∈ F) :
    (⋂₀ F) ⊆ A :=
  fun (x : α) (hx : x ∈ (⋂₀ F)) => mem_of_mem_sInter α F x hx A hA

theorem sUnion_subset_iff (α : Type) (F : Set (Set α)) (A : Set α) :
    (⋃₀ F) ⊆ A ↔ ∀ (B : Set α), B ∈ F → B ⊆ A :=
  Iff.intro ((⋃₀ F) ⊆ A) (∀ (B : Set α), B ∈ F → B ⊆ A)
    (fun (h : (⋃₀ F) ⊆ A) =>
      fun (B : Set α) (hB : B ∈ F) =>
        fun (b : α) (hb : b ∈ B) =>
          h b ((fun (hu : b ∈ (⋃₀ F) ↔ ∃ (C : Set α), C ∈ F ∧ b ∈ C) =>  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`⊆` 是 def 头（手册边界）
            Iff.mpr hu (Exists.intro (Set α) (fun (C : Set α) => C ∈ F ∧ b ∈ C) B  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`⊆` 是 def 头（手册边界）
              (And.intro hB hb))) (Set.mem_sUnion_iff α F b)))
    (fun (h : ∀ (B : Set α), B ∈ F → B ⊆ A) =>
      fun (x : α) (hx : x ∈ (⋃₀ F)) =>
        Set.mem_sUnion_elim α F x (x ∈ A) hx
          (fun (B : Set α) (hB : B ∈ F) (hxB : x ∈ B) => h B hB x hxB))

theorem subset_sInter_iff (α : Type) (F : Set (Set α)) (A : Set α) :
    A ⊆ (⋂₀ F) ↔ ∀ (B : Set α), B ∈ F → A ⊆ B :=
  Iff.intro (A ⊆ (⋂₀ F)) (∀ (B : Set α), B ∈ F → A ⊆ B)
    (fun (h : A ⊆ (⋂₀ F)) =>
      fun (B : Set α) (hB : B ∈ F) =>
        fun (a : α) (ha : a ∈ A) => mem_of_mem_sInter α F a (h a ha) B hB)
    (fun (h : ∀ (B : Set α), B ∈ F → A ⊆ B) =>
      fun (a : α) (ha : a ∈ A) =>
        (fun (hu : a ∈ (⋂₀ F) ↔ ∀ (B : Set α), B ∈ F → a ∈ B) =>
          Iff.mpr hu (fun (B : Set α) (hB : B ∈ F) => h B hB a ha))
          (Set.mem_sInter_iff α F a))
