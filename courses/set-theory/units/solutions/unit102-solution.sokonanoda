import lib.Set
import lib.Rel
import lib.Order
import lib.Equiv

def LeOn (α : Type) (β : Type) (A : Set α) (B : Set β) : Prop :=
  ∃ (f : α → β), Set.InjOn α β f A ∧ Set.MapsTo α β f A B

theorem demo_subset_def (α : Type) (A : Set α) (B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def α A B

theorem demo_not_def (α : Type) (P : Prop) : ¬ P ↔ (P → False) :=
  Iff.intro (¬ P) (P → False) (fun (h : ¬ P) => h) (fun (h : P → False) => h)  -- soko:notation-ok: `LeOn` 是 def 头（手册边界）

theorem demo_leOn_intro (α : Type) (β : Type) (A : Set α) (B : Set β) (f : α → β)
    (hf : Set.InjOn α β f A) (hfm : Set.MapsTo α β f A B) : LeOn α β A B :=
  Exists.intro (α → β) (fun (k : α → β) => Set.InjOn α β k A ∧ Set.MapsTo α β k A B) f  -- soko:notation-ok: `LeOn` 是 def 头（手册边界）
    (And.intro (Set.InjOn α β f A) (Set.MapsTo α β f A B) hf hfm)  -- soko:notation-ok: `LeOn` 是 def 头（手册边界）

theorem subset_antisymm_forward (α : Type) (A : Set α) (B : Set α)
    (hAB : A ⊆ B) (hBA : B ⊆ A) : ∀ (x : α), x ∈ A → x ∈ B :=
  fun (x : α) (hx : x ∈ A) =>
    (fun (hs : ∀ (z : α), z ∈ A → z ∈ B) => hs x hx)
      ((fun (hu : A ⊆ B ↔ ∀ (z : α), z ∈ A → z ∈ B) => Iff.mp hu hAB) (Set.subset_def α A B))

theorem subset_antisymm_backward (α : Type) (A : Set α) (B : Set α)
    (hAB : A ⊆ B) (hBA : B ⊆ A) : ∀ (x : α), x ∈ B → x ∈ A :=
  fun (x : α) (hx : x ∈ B) =>
    (fun (hs : ∀ (z : α), z ∈ B → z ∈ A) => hs x hx)
      ((fun (hu : B ⊆ A ↔ ∀ (z : α), z ∈ B → z ∈ A) => Iff.mp hu hBA) (Set.subset_def α B A))

theorem subset_antisymm_pointwise (α : Type) (A : Set α) (B : Set α)
    (hAB : A ⊆ B) (hBA : B ⊆ A) :
    (∀ (x : α), x ∈ A → x ∈ B) ∧ (∀ (x : α), x ∈ B → x ∈ A) :=
  And.intro (∀ (x : α), x ∈ A → x ∈ B) (∀ (x : α), x ∈ B → x ∈ A)
    (subset_antisymm_forward α A B hAB hBA) (subset_antisymm_backward α A B hAB hBA)

theorem injOn_id (α : Type) (A : Set α) : Set.InjOn α α (fun (x : α) => x) A :=
  fun (x : α) (hx : x ∈ A) (y : α) (hy : y ∈ A) (h : x = y) => h

theorem leOn_of_subset (α : Type) (A : Set α) (B : Set α) (h : A ⊆ B) : LeOn α α A B :=
  (fun (hs : ∀ (x : α), x ∈ A → x ∈ B) =>
    demo_leOn_intro α α A B (fun (x : α) => x) (injOn_id α A) hs)
    ((fun (hu : A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B) => Iff.mp hu h) (Set.subset_def α A B))

theorem leOn_of_subset_both (α : Type) (A : Set α) (B : Set α)
    (hAB : A ⊆ B) (hBA : B ⊆ A) : LeOn α α A B ∧ LeOn α α B A :=
  And.intro (LeOn α α A B) (LeOn α α B A) (leOn_of_subset α A B hAB)  -- soko:notation-ok: `LeOn` 是 def 头（手册边界）
    (leOn_of_subset α B A hBA)
