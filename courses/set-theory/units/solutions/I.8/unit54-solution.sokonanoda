import lib.Rel
import lib.Set
import lib.Equiv
import lib.Order

theorem demo_le_def (α β : Type) (A : Set α) (B : Set β) :
    A ≼ B ↔ ∃ (f : α → β), Set.InjOn α β f A ∧ Set.MapsTo α β f A B :=
  Set.le_def α β A B

theorem demo_injOn_def (α β : Type) (f : α → β) (A : Set α) :
    Set.InjOn α β f A ↔
      ∀ (x : α), x ∈ A → ∀ (y : α), y ∈ A → Eq.{1} β (f x) (f y) → Eq.{1} α x y :=  -- soko:notation-ok: G-73 形状 ②：`≼`/`≈`/`Set.*` 是 def 头，这些位置补不出前导实参
  Set.injOn_def α β f A

theorem demo_equiv_mk (α β : Type) (A : Set α) (B : Set β) (f : α → β) (g : β → α)
    (hf : Set.MapsTo α β f A B) (hg : Set.MapsTo β α g B A)
    (hgf : Set.LeftInvOn α β g f A) (hfg : Set.RightInvOn α β f g B) : A ≈ B :=
  Set.Equiv.mk α β A B f g hf hg hgf hfg

theorem injOn_id (α : Type) (A : Set α) : Set.InjOn α α (fun (x : α) => x) A :=
  (fun (hu : ∀ (x : α), x ∈ A → ∀ (y : α), y ∈ A → Eq.{1} α x y → Eq.{1} α x y) => hu)  -- soko:notation-ok: G-73 形状 ②：`≼`/`≈`/`Set.*` 是 def 头，这些位置补不出前导实参
    ((fun (hv : Set.InjOn α α (fun (x : α) => x) A ↔
        ∀ (x : α), x ∈ A → ∀ (y : α), y ∈ A → Eq.{1} α x y → Eq.{1} α x y) => Iff.mpr hv)  -- soko:notation-ok: G-73 形状 ②：`≼`/`≈`/`Set.*` 是 def 头，这些位置补不出前导实参
      (Set.injOn_def α α (fun (x : α) => x) A)
      (fun (x : α) (hx : x ∈ A) => fun (y : α) (hy : y ∈ A) =>
        fun (hxy : Eq.{1} α x y) => hxy))  -- soko:notation-ok: G-73 形状 ②：`≼`/`≈`/`Set.*` 是 def 头，这些位置补不出前导实参

theorem le_refl (α : Type) (A : Set α) : A ≼ A :=
  Set.Le.intro α α A A (fun (x : α) => x) (injOn_id α A)
    (fun (x : α) (hx : x ∈ A) => hx)

theorem subset_le (α : Type) (A B : Set α) (h : A ⊆ B) : A ≼ B :=
  Set.Le.intro α α A B (fun (x : α) => x) (injOn_id α A)
    (fun (x : α) (hx : x ∈ A) => h x hx)

theorem equiv_refl (α : Type) (A : Set α) : A ≈ A :=
  Set.Equiv.mk α α A A (fun (x : α) => x) (fun (x : α) => x)
    (fun (x : α) (hx : x ∈ A) => hx)
    (fun (x : α) (hx : x ∈ A) => hx)
    (fun (x : α) (hx : x ∈ A) => Eq.refl.{1} α x)
    (fun (x : α) (hx : x ∈ A) => Eq.refl.{1} α x)

theorem equiv_symm (α β : Type) (A : Set α) (B : Set β) (h : A ≈ B) : B ≈ A :=
  Set.Equiv.elim α β A B (B ≈ A) h
    (fun (f : α → β) (g : β → α)
      (hf : Set.MapsTo α β f A B) (hg : Set.MapsTo β α g B A)
      (hgf : Set.LeftInvOn α β g f A) (hfg : Set.RightInvOn α β f g B) =>
      Set.Equiv.mk β α B A g f hg hf hfg hgf)

theorem le_of_equiv (α β : Type) (A : Set α) (B : Set β) (h : A ≈ B) : A ≼ B :=
  Set.Equiv.elim α β A B (A ≼ B) h
    (fun (f : α → β) (g : β → α)
      (hf : Set.MapsTo α β f A B) (hg : Set.MapsTo β α g B A)
      (hgf : Set.LeftInvOn α β g f A) (hfg : Set.RightInvOn α β f g B) =>
      Set.Le.intro α β A B f
        (fun (x : α) (hx : x ∈ A) => fun (y : α) (hy : y ∈ A) =>
          fun (hxy : Eq.{1} β (f x) (f y)) =>  -- soko:notation-ok: G-73 形状 ②：`≼`/`≈`/`Set.*` 是 def 头，这些位置补不出前导实参
            Eq.trans.{1} α x (g (f y)) y
              (Eq.trans.{1} α x (g (f x)) (g (f y))
                (Eq.symm.{1} α (g (f x)) x (hgf x hx))
                (rel_subst_right β (fun (u : β) (v : β) => Eq.{1} α (g u) (g v))  -- soko:notation-ok: G-73 形状 ②：`≼`/`≈`/`Set.*` 是 def 头，这些位置补不出前导实参
                  (f x) (f x) (f y) hxy (Eq.refl.{1} α (g (f x)))))
              (hgf y hy))
        hf)

theorem equiv_trans (α β γ : Type) (A : Set α) (B : Set β) (C : Set γ)
    (h1 : A ≈ B) (h2 : B ≈ C) : A ≈ C :=
  Set.Equiv.elim α β A B (A ≈ C) h1
    (fun (f1 : α → β) (g1 : β → α)
      (hf1 : Set.MapsTo α β f1 A B) (hg1 : Set.MapsTo β α g1 B A)
      (hgf1 : Set.LeftInvOn α β g1 f1 A) (hfg1 : Set.RightInvOn α β f1 g1 B) =>
      Set.Equiv.elim β γ B C (A ≈ C) h2
        (fun (f2 : β → γ) (g2 : γ → β)
          (hf2 : Set.MapsTo β γ f2 B C) (hg2 : Set.MapsTo γ β g2 C B)
          (hgf2 : Set.LeftInvOn β γ g2 f2 B) (hfg2 : Set.RightInvOn β γ f2 g2 C) =>
          Set.Equiv.mk α γ A C (fun (a : α) => f2 (f1 a)) (fun (c : γ) => g1 (g2 c))
            (fun (a : α) (ha : a ∈ A) => hf2 (f1 a) (hf1 a ha))
            (fun (c : γ) (hc : c ∈ C) => hg1 (g2 c) (hg2 c hc))
            (fun (a : α) (ha : a ∈ A) =>
              Set.Equiv.comp_left_aux α β γ A B f1 g1 f2 g2 hgf1 hgf2 hf1 a ha)
            (fun (c : γ) (hc : c ∈ C) =>
              Set.Equiv.comp_right_aux α β γ B C f1 g1 f2 g2 hfg1 hfg2 hg2 c hc)))
