import lib.Rel
import lib.Set
import lib.Order

def symmDiff (α : Type) (A B : Set α) : Set α :=
  fun (x : α) => (A x ∧ ¬ (B x)) ∨ (B x ∧ ¬ (A x))

theorem mem_symmDiff (α : Type) (A B : Set α) (x : α) :
    (symmDiff α A B) x ↔ ((A x ∧ ¬ (B x)) ∨ (B x ∧ ¬ (A x))) :=
  Iff.intro ((symmDiff α A B) x) ((A x ∧ ¬ (B x)) ∨ (B x ∧ ¬ (A x)))
    (fun (h : (symmDiff α A B) x) => h)
    (fun (h : (A x ∧ ¬ (B x)) ∨ (B x ∧ ¬ (A x))) => h)

theorem not_symmDiff_of_iff (α : Type) (A B : Set α) (x : α)
    (h : A x ↔ B x) : ¬ ((symmDiff α A B) x) :=
  fun (hd : (symmDiff α A B) x) =>
    Or.elim (A x ∧ ¬ (B x)) (B x ∧ ¬ (A x)) (¬ (A x))
      (fun (h1 : A x ∧ ¬ (B x)) => (And.right h1) (Iff.mp h (And.left h1)))
      (fun (h2 : B x ∧ ¬ (A x)) => And.right h2) hd

