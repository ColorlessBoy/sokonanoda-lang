import lib.Set
import lib.SUnion
import lib.Image
import lib.Order

theorem demo_mem_image (α : Type) (β : Type) (f : α → β) (A : Set α) (y : β) :
    y ∈ (f '' A) ↔ ∃ (x : α), x ∈ A ∧ f x = y :=
  Set.mem_image f A y

theorem demo_mem_image_intro (α : Type) (β : Type) (f : α → β) (A : Set α) (y : β)
    (x : α) (hx : x ∈ A) (hxy : f x = y) : y ∈ (f '' A) :=
  Set.mem_image_intro f A y x hx hxy

theorem demo_mem_sUnion (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ (Set.sUnion α F) ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  Set.mem_sUnion_iff α F x

theorem mem_image_of_mem (α : Type) (β : Type) (f : α → β) (A : Set α) (x : α)
    (hx : x ∈ A) : f x ∈ (f '' A) :=
  Set.mem_image_intro f A (f x) x hx (Eq.refl.{1} β (f x))

theorem mem_of_mem_image (α : Type) (β : Type) (f : α → β) (A : Set α) (y : β)
    (h : y ∈ (f '' A)) : ∃ (x : α), x ∈ A ∧ f x = y :=
  (fun (hu : y ∈ (f '' A) ↔ ∃ (x : α), x ∈ A ∧ f x = y) => Iff.mp hu h)
    (Set.mem_image f A y)

theorem mem_image_union (α : Type) (β : Type) (f : α → β) (A B : Set α) (y : β) :
    y ∈ (f '' (A ∪ B)) ↔ y ∈ ((f '' A) ∪ (f '' B)) :=
  Iff.intro (y ∈ (f '' (A ∪ B))) (y ∈ ((f '' A) ∪ (f '' B)))
    (fun (h : y ∈ (f '' (A ∪ B))) =>
      Set.mem_image_elim f (A ∪ B) y (y ∈ ((f '' A) ∪ (f '' B))) h
        (fun (x : α) (hx : x ∈ (A ∪ B)) (hxy : f x = y) =>
          Or.elim (x ∈ A) (x ∈ B) (y ∈ ((f '' A) ∪ (f '' B)))
            (fun (hA : x ∈ A) => Or.inl (y ∈ (f '' A)) (y ∈ (f '' B))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
              (Set.mem_image_intro f A y x hA hxy))
            (fun (hB : x ∈ B) => Or.inr (y ∈ (f '' A)) (y ∈ (f '' B))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
              (Set.mem_image_intro f B y x hB hxy))
            ((fun (hu : x ∈ (A ∪ B) ↔ x ∈ A ∨ x ∈ B) => Iff.mp hu hx)
              (Set.mem_union x A B))))
    (fun (h : y ∈ ((f '' A) ∪ (f '' B))) =>
      Or.elim (y ∈ (f '' A)) (y ∈ (f '' B)) (y ∈ (f '' (A ∪ B)))
        (fun (hA : y ∈ (f '' A)) =>
          Set.mem_image_elim f A y (y ∈ (f '' (A ∪ B))) hA
            (fun (x : α) (hx : x ∈ A) (hxy : f x = y) =>
              Set.mem_image_intro f (A ∪ B) y x
                ((fun (hu : x ∈ (A ∪ B) ↔ x ∈ A ∨ x ∈ B) =>
                  Iff.mpr hu (Or.inl (x ∈ A) (x ∈ B) hx)) (Set.mem_union x A B)) hxy))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
        (fun (hB : y ∈ (f '' B)) =>
          Set.mem_image_elim f B y (y ∈ (f '' (A ∪ B))) hB
            (fun (x : α) (hx : x ∈ B) (hxy : f x = y) =>
              Set.mem_image_intro f (A ∪ B) y x
                ((fun (hu : x ∈ (A ∪ B) ↔ x ∈ A ∨ x ∈ B) =>
                  Iff.mpr hu (Or.inr (x ∈ A) (x ∈ B) hx)) (Set.mem_union x A B)) hxy))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
        ((fun (hu : y ∈ ((f '' A) ∪ (f '' B)) ↔ y ∈ (f '' A) ∨ y ∈ (f '' B)) => Iff.mp hu h)
          (Set.mem_union y (f '' A) (f '' B))))

theorem mem_sUnion_of_mem_mem (α : Type) (F : Set (Set α)) (A : Set α) (x : α)
    (hA : A ∈ F) (hx : x ∈ A) : x ∈ (Set.sUnion α F) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  (fun (hu : x ∈ (Set.sUnion α F) ↔ ∃ (D : Set α), D ∈ F ∧ x ∈ D) =>  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    Iff.mpr hu (Exists.intro (Set α) (fun (D : Set α) => D ∈ F ∧ x ∈ D) A  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
      (And.intro (A ∈ F) (x ∈ A) hA hx))) (Set.mem_sUnion_iff α F x)  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）

theorem exists_mem_of_mem_sUnion (α : Type) (F : Set (Set α)) (x : α)
    (h : x ∈ (Set.sUnion α F)) : ∃ (A : Set α), A ∈ F ∧ x ∈ A :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  (fun (hu : x ∈ (Set.sUnion α F) ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A) => Iff.mp hu h)  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    (Set.mem_sUnion_iff α F x)

theorem mem_image_sUnion_of_mem_image (α : Type) (β : Type) (f : α → β)
    (F : Set (Set α)) (A : Set α) (y : β) (hA : A ∈ F) (hy : y ∈ (f '' A)) :
    y ∈ (f '' (Set.sUnion α F)) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  Set.mem_image_elim f A y (y ∈ (f '' (Set.sUnion α F))) hy  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    (fun (x : α) (hx : x ∈ A) (hxy : f x = y) =>
      Set.mem_image_intro f (Set.sUnion α F) y x  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
        (mem_sUnion_of_mem_mem α F A x hA hx) hxy)

theorem mem_image_sUnion_of_exists (α : Type) (β : Type) (f : α → β)
    (F : Set (Set α)) (y : β)
    (h : ∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A)) : y ∈ (f '' (Set.sUnion α F)) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  Exists.elim (Set α) (fun (A : Set α) => A ∈ F ∧ y ∈ (f '' A))
    (y ∈ (f '' (Set.sUnion α F))) h  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    (fun (A : Set α) (hA : A ∈ F ∧ y ∈ (f '' A)) =>
      mem_image_sUnion_of_mem_image α β f F A y
        (And.left (A ∈ F) (y ∈ (f '' A)) hA) (And.right (A ∈ F) (y ∈ (f '' A)) hA))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）

theorem mem_of_mem_image_sUnion (α : Type) (β : Type) (f : α → β)
    (F : Set (Set α)) (y : β)
    (h : y ∈ (f '' (Set.sUnion α F))) : ∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  Set.mem_image_elim f (Set.sUnion α F) y  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    (∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A)) h
    (fun (x : α) (hx : x ∈ (Set.sUnion α F)) (hxy : f x = y) =>  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
      Exists.elim (Set α) (fun (A : Set α) => A ∈ F ∧ x ∈ A)
        (∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A))
        (exists_mem_of_mem_sUnion α F x hx)
        (fun (A : Set α) (hA : A ∈ F ∧ x ∈ A) =>
          Exists.intro (Set α) (fun (D : Set α) => D ∈ F ∧ y ∈ (f '' D)) A  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
            (And.intro (A ∈ F) (y ∈ (f '' A)) (And.left (A ∈ F) (x ∈ A) hA)  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
              (Set.mem_image_intro f A y x (And.right (A ∈ F) (x ∈ A) hA) hxy))))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）

theorem mem_image_sUnion_iff (α : Type) (β : Type) (f : α → β) (F : Set (Set α))
    (y : β) :
    y ∈ (f '' (Set.sUnion α F)) ↔ ∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  Iff.intro (y ∈ (f '' (Set.sUnion α F))) (∃ (A : Set α), A ∈ F ∧ y ∈ (f '' A))  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    (mem_of_mem_image_sUnion α β f F y)
    (mem_image_sUnion_of_exists α β f F y)

theorem mem_image_mono (α : Type) (β : Type) (f : α → β) (A B : Set α) (h : A ⊆ B)
    (y : β) (hy : y ∈ (f '' A)) : y ∈ (f '' B) :=
  Set.mem_image_elim f A y (y ∈ (f '' B)) hy
    (fun (x : α) (hx : x ∈ A) (hxy : f x = y) =>
      Set.mem_image_intro f B y x
        ((fun (hu : ∀ (u : α), u ∈ A → u ∈ B) => hu x hx)
          ((fun (hv : A ⊆ B ↔ ∀ (u : α), u ∈ A → u ∈ B) => Iff.mp hv h)
            (Set.subset_def α A B))) hxy)

theorem not_mem_image_empty (α : Type) (β : Type) (f : α → β) (y : β) :
    ¬ (y ∈ (f '' (Set.empty α))) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  fun (h : y ∈ (f '' (Set.empty α))) =>  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
    Set.mem_image_elim f (Set.empty α) y False h  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
      (fun (x : α) (hx : x ∈ (Set.empty α)) (hxy : f x = y) =>  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
        (Iff.mp (Set.mem_empty_iff_false x)) hx)

theorem mem_preimage_image (α : Type) (β : Type) (f : α → β) (A : Set α) (x : α)
    (hx : x ∈ A) : x ∈ (f ⁻¹' (f '' A)) :=
  (fun (hu : x ∈ (f ⁻¹' (f '' A)) ↔ f x ∈ (f '' A)) => Iff.mpr hu (mem_image_of_mem α β f A x hx))
    (Set.mem_preimage f (f '' A) x)

theorem mem_image_sInter_of_mem (α : Type) (β : Type) (f : α → β) (F : Set (Set α))
    (y : β) (h : y ∈ (f '' (Set.sInter α F))) : ∀ (A : Set α), A ∈ F → y ∈ (f '' A) :=  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
  fun (A : Set α) (hA : A ∈ F) =>
    Set.mem_image_elim f (Set.sInter α F) y (y ∈ (f '' A)) h  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
      (fun (x : α) (hx : x ∈ (Set.sInter α F)) (hxy : f x = y) =>  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
        Set.mem_image_intro f A y x
          ((fun (hu : ∀ (B : Set α), B ∈ F → x ∈ B) => hu A hA)
            ((fun (hv : x ∈ (Set.sInter α F) ↔ ∀ (B : Set α), B ∈ F → x ∈ B) => Iff.mp hv hx)  -- soko:notation-ok: `⋃`/`⋂` 无记法（点名写法）+ `∈`/`` 是 def 头（手册边界）
              (Set.mem_sInter_iff α F x))) hxy)
