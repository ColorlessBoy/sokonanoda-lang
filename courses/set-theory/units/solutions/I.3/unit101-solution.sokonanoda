import lib.Set
import lib.Rel
import lib.Order

theorem demo_mem_empty_iff_false (α : Type) (x : α) :
    x ∈ (∅ α) ↔ False :=
  Set.mem_empty_iff_false α x

theorem demo_subset_def (α : Type) (A : Set α) (B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def α A B

theorem demo_not_def (α : Type) (P : Prop) : ¬ P ↔ (P → False) :=
  Iff.intro (fun (h : ¬ P) => h) (fun (h : P → False) => h)

theorem subset_empty_elim (α : Type) (A : Set α) (h : A ⊆ ∅ α) :
    ∀ (x : α), x ∈ A → False :=
  fun (x : α) (hx : x ∈ A) =>
    (fun (hu : x ∈ ∅ α ↔ False) => Iff.mp hu (h x hx))
      (Set.mem_empty_iff_false α x)

theorem subset_empty_intro (α : Type) (A : Set α) (h : ∀ (x : α), x ∈ A → False) :
    A ⊆ ∅ α :=
  fun (x : α) (hx : x ∈ A) =>
    (fun (hu : x ∈ ∅ α ↔ False) => Iff.mpr hu (h x hx))
      (Set.mem_empty_iff_false α x)

theorem not_mem_of_subset_empty (α : Type) (A : Set α) (h : A ⊆ ∅ α) :
    ∀ (x : α), x ∈ A → False :=
  subset_empty_elim α A h

theorem empty_subset (α : Type) (A : Set α) : ∅ α ⊆ A :=
  fun (x : α) (hx : x ∈ ∅ α) =>  -- soko:notation-ok: `False.elim` 的目标位（手册边界）
    (fun (hu : x ∈ ∅ α ↔ False) => False.elim (x ∈ A) (Iff.mp hu hx))  -- soko:notation-ok: `False.elim` 的目标位（手册边界）
      (Set.mem_empty_iff_false α x)

theorem subset_empty_iff_pointwise (α : Type) (A : Set α) :
    (A ⊆ ∅ α) → (∀ (x : α), x ∈ A → False) :=
  subset_empty_elim α A
