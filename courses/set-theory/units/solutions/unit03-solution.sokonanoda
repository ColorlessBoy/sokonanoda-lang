-- unit03 解答钥匙（agent 专用；画布不 import 它）。
-- 靶子：Tao §3.1 后半（并/交/差 → 幂集 → 成员判定与单调性）。
-- 全部证明只用 term 风格（fun / Or.inl / Or.inr / Or.elim / And.intro / And.left / And.right）
-- 与 lib/ 里已备好的成员判定引理——**不用任何 tactic**。
import lib.Logic
import lib.Set

-- ── 3.1 并 ───────────────────────────────────────────────────────────────
theorem subset_union_left (α : Type) (A B : Set α) : Set.subset α A (Set.union α A B) :=
  fun (x : α) => fun (hx : A x) => Or.inl (A x) (B x) hx

theorem subset_union_right (α : Type) (A B : Set α) : Set.subset α B (Set.union α A B) :=
  fun (x : α) => fun (hx : B x) => Or.inr (A x) (B x) hx

theorem union_subset_iff (α : Type) (A B C : Set α) :
    Iff (Set.subset α (Set.union α A B) C) (And (Set.subset α A C) (Set.subset α B C)) :=
  Iff.intro (Set.subset α (Set.union α A B) C) (And (Set.subset α A C) (Set.subset α B C))
    (fun (h : Set.subset α (Set.union α A B) C) =>
      And.intro (Set.subset α A C) (Set.subset α B C)
        (fun (x : α) => fun (hx : A x) => h x (Or.inl (A x) (B x) hx))
        (fun (x : α) => fun (hx : B x) => h x (Or.inr (A x) (B x) hx)))
    (fun (h : And (Set.subset α A C) (Set.subset α B C)) =>
      fun (x : α) => fun (hx : Set.mem α x (Set.union α A B)) =>
        Or.elim (A x) (B x) (C x)
          (fun (ha : A x) => And.left (Set.subset α A C) (Set.subset α B C) h x ha)
          (fun (hb : B x) => And.right (Set.subset α A C) (Set.subset α B C) h x hb)
          hx)

-- ── 3.2 交 ───────────────────────────────────────────────────────────────
theorem inter_subset_left (α : Type) (A B : Set α) : Set.subset α (Set.inter α A B) A :=
  fun (x : α) => fun (hx : Set.mem α x (Set.inter α A B)) => And.left (A x) (B x) hx

theorem inter_subset_right (α : Type) (A B : Set α) : Set.subset α (Set.inter α A B) B :=
  fun (x : α) => fun (hx : Set.mem α x (Set.inter α A B)) => And.right (A x) (B x) hx

theorem subset_inter (α : Type) (A B C : Set α)
    (h1 : Set.subset α A B) (h2 : Set.subset α A C) : Set.subset α A (Set.inter α B C) :=
  fun (x : α) => fun (hx : A x) => And.intro (B x) (C x) (h1 x hx) (h2 x hx)

-- ∩ 的泛性质（练习 3 的对偶）：→ 把 h x hx : And (B x) (C x) 劈成两条包含；
-- ← 把一对包含在同一 x hx 上取出来，再 And.intro 装回一对证据。
theorem subset_inter_iff (α : Type) (A B C : Set α) :
    Iff (Set.subset α A (Set.inter α B C)) (And (Set.subset α A B) (Set.subset α A C)) :=
  Iff.intro (Set.subset α A (Set.inter α B C))
    (And (Set.subset α A B) (Set.subset α A C))
    (fun (h : Set.subset α A (Set.inter α B C)) =>
      And.intro (Set.subset α A B) (Set.subset α A C)
        (fun (x : α) => fun (hx : A x) => And.left (B x) (C x) (h x hx))
        (fun (x : α) => fun (hx : A x) => And.right (B x) (C x) (h x hx)))
    (fun (h : And (Set.subset α A B) (Set.subset α A C)) =>
      fun (x : α) => fun (hx : A x) =>
        And.intro (B x) (C x)
          (And.left (Set.subset α A B) (Set.subset α A C) h x hx)
          (And.right (Set.subset α A B) (Set.subset α A C) h x hx))

-- ── 3.3 差 ───────────────────────────────────────────────────────────────
theorem sdiff_subset (α : Type) (A B : Set α) : Set.subset α (Set.sdiff α A B) A :=
  fun (x : α) => fun (hx : Set.mem α x (Set.sdiff α A B)) =>
    And.left (A x) (Not (B x)) hx

-- ── 3.4 幂集单调 ─────────────────────────────────────────────────────────
theorem powerset_mono (α : Type) (A B : Set α) (h : Set.subset α A B) :
    Set.subset (Set α) (Set.powerset α A) (Set.powerset α B) :=
  fun (X : Set α) => fun (hX : Set.mem (Set α) X (Set.powerset α A)) =>
    Iff.mpr (Set.mem (Set α) X (Set.powerset α B)) (Set.subset α X B)
      (Set.mem_powerset_iff α B X)
      (fun (x : α) => fun (hx : X x) =>
        h x (Iff.mp (Set.mem (Set α) X (Set.powerset α A)) (Set.subset α X A)
               (Set.mem_powerset_iff α A X) hX x hx))

-- ── 3.5 D 类 ─────────────────────────────────────────────────────────────

-- 反例：A = univ、B = empty（α 非空时的最小反例）；原命题的否定。
theorem union_subset_inter_false (α : Type) (a : α) :
    Not (Set.subset α (Set.union α (Set.univ α) (Set.empty α))
                       (Set.inter α (Set.univ α) (Set.empty α))) :=
  fun (hsub : Set.subset α (Set.union α (Set.univ α) (Set.empty α))
                          (Set.inter α (Set.univ α) (Set.empty α))) =>
    And.right (Set.mem α a (Set.univ α)) (Set.mem α a (Set.empty α))
      (hsub a (Or.inl (Set.mem α a (Set.univ α)) (Set.mem α a (Set.empty α))
        (Set.mem_univ α a)))

-- 命题甲为真：A ∈ 𝒫 A（展开即 A ⊆ A）；命题乙 A ⊆ 𝒫 A 连类型都不对（见画布注释）。
theorem powerset_self_mem (α : Type) (A : Set α) :
    Set.mem (Set α) A (Set.powerset α A) :=
  Iff.mpr (Set.mem (Set α) A (Set.powerset α A)) (Set.subset α A A)
    (Set.mem_powerset_iff α A A)
    (fun (x : α) => fun (hx : A x) => hx)
