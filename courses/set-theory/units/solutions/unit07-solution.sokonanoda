-- unit07 解答钥匙（agent 专用；画布不 import 它）。
--
-- 9 条练习的证明全部只用 lib/ 与 prelude 里已备好的东西，且全部写成 **`by` tactic 块**
-- （白名单：intro / exact / apply / assumption / rfl / match / constructor / left /
-- right / use / exfalso / cases / have / sorry）——**没有** rw / obtain / change /
-- simp / induction / calc / rintro / `·`。
-- 语句一律用**记法**（`∀ ∃ → ∧ ↔ ¬ =` 与 `Set Nat` 上的 `∈`）；**引理名照旧点名**
-- （`Eq.symm`、`congrArg`、`Exists.intro`、`And.left`、`Set.notMem_empty`…）——
-- 记法是连接符的糖，不是引理名的糖。
--
-- 唯一"证不出来"的是**存在版** bijective_iff_inverse 的另一半
--     Bijective f -> ∃ (g : β -> α), Inverse f g
-- 它等价于选择公理（每个满射都可裂），本语言没有 Classical.choice / funext / propext，
-- 所以画布第 6 题证的是**数据版**：逆函数 g 与右逆证据 hg 由调用者交出，此时 Iff
-- 两个方向都成立（见下面 bijective_iff_inverse）。这条边界记在单元报告的 unprovable。
import lib.Logic
import lib.Set
import lib.Exists
import lib.Fun

-- 题 1：两边 delta/beta 展开后是同一个 λ，所以 `Eq.refl` 直接成立（没有 funext，
-- 这是本语言里唯一能证函数等式的方式）。目标用 `=` 写，证明体点名交 `Eq.refl`。
theorem comp_assoc (α β γ δ : Type) (f : α → β) (g : β → γ) (h : γ → δ) :
    Function.comp α γ δ h (Function.comp α β γ g f)
      = Function.comp α β δ (Function.comp β γ δ h g) f := by
  exact Eq.refl.{1} (α → δ) (Function.comp α β δ (Function.comp β γ δ h g) f)

-- 题 2：先把复合等式经 g 的单射降到 f 层，再交给 f 的单射。
-- `intro` 会把 `Function.Injective` 展开到 Pi；`apply` 用引理的**结论**对齐目标，
-- 其余参数（两个点、以及"值相等"这条前提）变子目标。
theorem injective_comp (α β γ : Type) (f : α → β) (g : β → γ)
    (hf : Function.Injective α β f) (hg : Function.Injective β γ g) :
    Function.Injective α γ (Function.comp α β γ g f) := by
  intro x y h
  apply hf
  apply hg
  exact h

-- 题 3：两次 `Exists.elim` 拆证人（Q 都取目标那个 Exists）：外层拿到中间点 y 与
-- `hy : g y = z`，内层拿到 x 与 `hx : f x = y`；最后由 `Exists.intro` 交出内层证人，
-- 等式用 congrArg 把 hx 抬过 g，再与 hy 经 Eq.trans 接起来。
theorem surjective_comp (α β γ : Type) (f : α → β) (g : β → γ)
    (hf : Function.Surjective α β f) (hg : Function.Surjective β γ g) :
    Function.Surjective α γ (Function.comp α β γ g f) := by
  intro z
  exact Exists.elim β (fun (y : β) => g y = z)
    (∃ (x : α), Function.comp α β γ g f x = z)
    (hg z)
    (fun (y : β) => fun (hy : g y = z) =>
      Exists.elim α (fun (x : α) => f x = y)
        (∃ (x : α), Function.comp α β γ g f x = z)
        (hf y)
        (fun (x : α) => fun (hx : f x = y) =>
          Exists.intro α (fun (x2 : α) => Function.comp α β γ g f x2 = z) x
            (Eq.trans.{1} γ (g (f x)) (g y) z (congrArg.{1} β γ g (f x) y hx) hy)))

-- 题 4：x ← g (f x) → g (f y) → y，两段用 Eq.trans 接。
theorem leftInverse_injective (α β : Type) (f : α → β) (g : β → α)
    (h : Function.LeftInverse α β g f) : Function.Injective α β f := by
  intro x y hxy
  exact Eq.trans.{1} α x (g (f x)) y
    (Eq.symm.{1} α (g (f x)) x (h x))
    (Eq.trans.{1} α (g (f x)) (g (f y)) y
      (congrArg.{1} β α g (f x) (f y) hxy)
      (h y))

-- 题 5：原像是现成的——g y；证据就是右逆 h 本身。`Exists.intro` 点名写四样。
theorem surjective_of_rightInverse (α β : Type) (f : α → β) (g : β → α)
    (h : Function.RightInverse α β g f) : Function.Surjective α β f := by
  intro y
  exact Exists.intro α (fun (x : α) => f x = y) (g y) (h y)

-- 题 6：数据版 iff。
--   "→"：有单射与右逆 hg ⇒ 左逆：对每个 x，用单射把目标 `g (f x) = x` 化成
--         `f (g (f x)) = f x`，而那正是 hg (f x)。
--   "←"：双边逆 ⇒ 单射（题 4）∧ 满射（题 5）。
-- `constructor` 会把 `↔` 与两边的 `∧`（Bijective / Inverse 都定义成 ∧）逐层拆开。
theorem bijective_iff_inverse (α β : Type) (f : α → β) (g : β → α)
    (hg : Function.RightInverse α β g f) :
    Function.Bijective α β f ↔ Function.Inverse α β f g := by
  constructor
  intro hb
  constructor
  intro x
  exact And.left (Function.Injective α β f) (Function.Surjective α β f) hb
    (g (f x)) x (hg (f x))
  exact hg
  intro hi
  constructor
  exact leftInverse_injective α β f g
    (And.left (Function.LeftInverse α β g f) (Function.RightInverse α β g f) hi)
  exact surjective_of_rightInverse α β f g
    (And.right (Function.LeftInverse α β g f) (Function.RightInverse α β g f) hi)

-- 题 7：题 2 的逆命题方向；congrArg 把 f 层等式抬成复合等式。
theorem injective_of_comp_injective (α β γ : Type) (f : α → β) (g : β → γ)
    (h : Function.Injective α γ (Function.comp α β γ g f)) : Function.Injective α β f := by
  intro x y hxy
  exact h x y (congrArg.{1} β γ g (f x) (f y) hxy)

-- 题 8：换序的恒真方向：`cases` 拆出证人（臂体里拿到 hw : ∀ x, P x w），
-- 逐个取用；再把同一个证人用 `Exists.intro` 交回去。
theorem swap_exists_forall (α β : Type) (P : α → β → Prop)
    (h : ∃ (y : β), ∀ (x : α), P x y) :
    ∀ (x : α), ∃ (y : β), P x y := by
  intro x
  cases h with
  | intro w hw =>
    exact Exists.intro β (fun (y2 : β) => P x y2) w (hw x)

-- 题 9：反例的形式化。把 P 取成 Set Nat 上的恒等关系：
--   · 前提：每个 x 都有 y（取 y := x，Eq.refl）——先用 `have` 把"把反例喂给假设
--     之后的结论"命名下来（这条 Exists 的形状较长，先命名再拆读起来清楚）；
--   · 结论：`Exists.elim` 拆出 y 与 hy : ∀ x, x = y，用 hy univ 与 hy ∅ 得 univ = ∅；
--     再把 0 ∈ univ（Set.mem_univ）沿等式搬到 0 ∈ ∅，与 Set.notMem_empty 矛盾。
-- 语句里的前提写成**具名 binder**（`∀ (hpre : …)`）而不是箭头：见单元报告的语言缺口。
theorem swap_converse_false :
    ¬ (∀ (P : Set Nat → Set Nat → Prop),
      ∀ (hpre : ∀ (x : Set Nat), ∃ (y : Set Nat), P x y),
        (∃ (y : Set Nat), ∀ (x : Set Nat), P x y)) := by
  intro h
  have hbad : ∃ (y : Set Nat), ∀ (x : Set Nat), x = y :=
    h (fun (x : Set Nat) => fun (y : Set Nat) => x = y)
      (fun (x : Set Nat) =>
        Exists.intro (Set Nat) (fun (y : Set Nat) => x = y) x (Eq.refl.{1} (Set Nat) x))
  exact Exists.elim (Set Nat) (fun (y : Set Nat) => ∀ (x : Set Nat), x = y) False hbad
    (fun (y : Set Nat) => fun (hy : ∀ (x : Set Nat), x = y) =>
      Set.notMem_empty Nat 0
        (Eq.subst.{1} (Set Nat)
          (fun (X : Set Nat) => 0 ∈ X)
          (Set.univ Nat) (Set.empty Nat)
          (Eq.trans.{1} (Set Nat) (Set.univ Nat) y (Set.empty Nat)
            (hy (Set.univ Nat))
            (Eq.symm.{1} (Set Nat) (Set.empty Nat) y (hy (Set.empty Nat))))
          (Set.mem_univ Nat 0)))
