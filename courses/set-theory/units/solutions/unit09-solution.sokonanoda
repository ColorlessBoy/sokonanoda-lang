      (Set.Equiv.mk Nat Nat nonzero (Set.univ Nat) Nat.pred Nat.succ
        (fun (x : Nat) => fun (hx : x ∈ nonzero) => True.intro)
        (fun (y : Nat) => fun (hy : y ∈ Set.univ Nat) => Nat.succ_ne_zero y)
