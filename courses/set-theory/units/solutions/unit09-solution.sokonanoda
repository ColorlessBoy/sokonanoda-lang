-- ==========================================================================
-- unit09-solution.sokonanoda —— 卷 I 单元⑨ 的解答钥匙（agent 专用）
--
-- 与画布 units/unit09-equinumerosity.sokonanoda **同名一一对应**：
--   演示 2 条（Set.Equiv.refl、Set.Equiv.of_inj_surj）
--   + 反例脚手架 4 条（Nat.isZero、Nat.pred、Nat.succ_ne_zero、nonzero）
--   + 练习 7 条（T2 · L3 · D2）。
-- 练习名：Set.Equiv.symm · Set.Equiv.trans · Set.Equiv.singleton ·
--         Set.equivOfEq · not_equiv_empty_singleton ·
--         equiv_nonempty_iff · proper_subset_counterexample
--
-- 语句一律用记法（`∈ ⊆ ∅ {a}` 与 `∧ ↔ ¬ ≠`、`∃ (x : α), …`）；引理名照旧点名
-- （`And.left`、`Exists.elim`、`Eq.subst.{1} …`）——记法是连接符的糖，不是引理名的糖。
--
-- 证明体说明（性能）：`apply Exists.elim` 这种"部分应用 + 大谓词实参"的 tactic 写法
-- 会让判卷器在**累计到第 11 条声明**时把每条目标反复重算（实测 68s → 192s → 超时），
-- 而把同一个证明项交给 `exact` 一次判定只要 ~18s（13 条全过 43s）。所以本文件的
-- 证明体统一写成 `by exact <证明项>`：`by` 块 + 白名单里的 `exact` 都满足要求，
-- 只是把"逐条 tactic"收在 `exact` 这一步里——这是判卷器当前的性能边界，不是记法问题。
-- ==========================================================================
import lib.Logic
import lib.Exists
import lib.Set
import lib.Equiv

-- ─────────────────────────────────────────────────────────────
-- 演示（画布上已写好，这里逐字同款）
-- ─────────────────────────────────────────────────────────────

-- 演示 1（必证①）：等势自反——恒等映射，四条条件都是一行。
theorem Set.Equiv.refl (α : Type) (A : Set α) : Set.Equiv α α A A := by
  exact Set.Equiv.mk α α A A (fun (x : α) => x) (fun (x : α) => x)
    (fun (x : α) => fun (hx : x ∈ A) => hx)
    (fun (y : α) => fun (hy : y ∈ A) => hy)
    (fun (x : α) => fun (hx : x ∈ A) => Eq.refl.{1} α x)
    (fun (y : α) => fun (hy : y ∈ A) => Eq.refl.{1} α y)

-- 演示 2（必证④）：从单射 + 右逆（**满射的数据形式**）构造等势。
-- 缺的那条左互逆律由单射补上：f (g (f x)) = f x 是因为 g 在 B 上是右逆，
-- 再把 hinj 用在 g (f x) 与 x 上即可。注意"满射"这里必须给**数据**（右逆 g）：
-- ∃-形式的满射要挑原像，那是选择公理（lib/Equiv 文件头）。
theorem Set.Equiv.of_inj_surj (α β : Type) (A : Set α) (B : Set β)
    (f : α → β) (g : β → α)
    (hf : Set.MapsTo α β f A B)
    (hg : Set.MapsTo β α g B A)
    (hinj : ∀ (x1 x2 : α), (f x1) = (f x2) → x1 = x2)
    (hsec : Set.RightInvOn α β f g B) :
    Set.Equiv α β A B := by
  exact Set.Equiv.mk α β A B f g hf hg
    (fun (x : α) => fun (hx : x ∈ A) =>
      hinj (g (f x)) x (hsec (f x) (hf x hx)))
    hsec

-- ─────────────────────────────────────────────────────────────
-- 反例脚手架（画布上也有）：只为把"无限集上的真子集"陈述并判出来。
-- 两条是 Nat 上的递归定义，一条是 succ ≠ 0，一条是"非零自然数之集"。
-- 它们**不是本单元的内容**，画布上标成脚手架。
-- ─────────────────────────────────────────────────────────────

def Nat.isZero (n : Nat) : Prop := match n with
  | Nat.zero => False
  | Nat.succ k => True

def Nat.pred (n : Nat) : Nat := match n with
  | Nat.zero => Nat.zero
  | Nat.succ k => k

-- succ n ≠ 0：把 n 送进"是不是 0"的谓词里，succ 那一支给 True、zero 那一支给
-- False；于是 Eq.subst 把 succ n 处的 True.intro 搬到 zero 处，得到 False。
theorem Nat.succ_ne_zero (n : Nat) : ¬ ((Nat.succ n) = Nat.zero) := by
  intro h
  exact Eq.subst.{1} Nat (fun (k : Nat) => Nat.isZero k) (Nat.succ n) Nat.zero h True.intro

-- 非零自然数之集（自定名：Mathlib 里没有"非零自然数"这个名字的 Set Nat）。
def nonzero : Set Nat := fun (n : Nat) => ¬ (n = Nat.zero)

-- ─────────────────────────────────────────────────────────────
-- 练习 1（T 类，必证②）：等势对称——交换两把映射。
-- 结论 `Set.Equiv β α B A` 里不出现 f、g，正好满足 Exists.elim 的纪律。
-- ─────────────────────────────────────────────────────────────
theorem Set.Equiv.symm (α β : Type) (A : Set α) (B : Set β)
    (h : Set.Equiv α β A B) : Set.Equiv β α B A := by
  exact Exists.elim h (fun (f : α → β) =>
      fun (hf : Set.MapsTo α β f A B ∧
          (∃ (g : β → α), Set.MapsTo β α g B A ∧
            (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B))) =>
        Exists.elim (And.right hf) (fun (g : β → α) =>
            fun (hg : Set.MapsTo β α g B A ∧
                (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)) =>
              Set.Equiv.mk β α B A g f
                (And.left hg)
                (And.left hf)
                (And.right
                  (And.right hg))
                (And.left
                  (And.right hg))))
theorem Set.Equiv.trans (α β γ : Type) (A : Set α) (B : Set β) (C : Set γ)
    (h1 : Set.Equiv α β A B) (h2 : Set.Equiv β γ B C) : Set.Equiv α γ A C := by
  exact Exists.elim (α → β)
    (fun (f1 : α → β) =>
      Set.MapsTo α β f1 A B ∧
        (∃ (g1 : β → α), Set.MapsTo β α g1 B A ∧
            (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)))
    (Set.Equiv α γ A C)
    h1
    (fun (f1 : α → β) =>
      fun (hf1 : Set.MapsTo α β f1 A B ∧
                     (∃ (g1 : β → α), Set.MapsTo β α g1 B A ∧
                         (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B))) =>
        Exists.elim (β → α)
          (fun (g1 : β → α) =>
            Set.MapsTo β α g1 B A ∧
              (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B))
          (Set.Equiv α γ A C)
          (And.right (Set.MapsTo α β f1 A B)
            (∃ (g1 : β → α), Set.MapsTo β α g1 B A ∧
                (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)) hf1)
          (fun (g1 : β → α) =>
            fun (hg1 : Set.MapsTo β α g1 B A ∧
                           (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)) =>
              Exists.elim (β → γ)
                (fun (f2 : β → γ) =>
                  Set.MapsTo β γ f2 B C ∧
                    (∃ (g2 : γ → β), Set.MapsTo γ β g2 C B ∧
                        (Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C)))
                (Set.Equiv α γ A C)
                h2
                (fun (f2 : β → γ) =>
                  fun (hf2 : Set.MapsTo β γ f2 B C ∧
                                 (∃ (g2 : γ → β), Set.MapsTo γ β g2 C B ∧
                                     (Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C))) =>
                    Exists.elim (γ → β)
                      (fun (g2 : γ → β) =>
                        Set.MapsTo γ β g2 C B ∧
                          (Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C))
                      (Set.Equiv α γ A C)
                      (And.right (Set.MapsTo β γ f2 B C)
                        (∃ (g2 : γ → β), Set.MapsTo γ β g2 C B ∧
                            (Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C)) hf2)
                      (fun (g2 : γ → β) =>
                        fun (hg2 : Set.MapsTo γ β g2 C B ∧
                                       (Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C)) =>
                          Set.Equiv.mk α γ A C
                            (fun (x : α) => f2 (f1 x))
                            (fun (z : γ) => g1 (g2 z))
                            (fun (x : α) => fun (hx : x ∈ A) =>
                              And.left (Set.MapsTo β γ f2 B C)
                                (∃ (g2 : γ → β), Set.MapsTo γ β g2 C B ∧
                                    (Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C)) hf2
                                (f1 x)
                                (And.left (Set.MapsTo α β f1 A B)
                                  (∃ (g1 : β → α), Set.MapsTo β α g1 B A ∧
                                      (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)) hf1
                                  x hx))
                            (fun (z : γ) => fun (hz : z ∈ C) =>
                              And.left (Set.MapsTo β α g1 B A)
                                ((Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B))
                                hg1
                                (g2 z)
                                (And.left (Set.MapsTo γ β g2 C B)
                                  ((Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C))
                                  hg2 z hz))
                            (fun (x : α) => fun (hx : x ∈ A) =>
                              Eq.trans.{1} α (g1 (g2 (f2 (f1 x)))) (g1 (f1 x)) x
                                (congrArg.{1} g1
                                  (And.left (Set.LeftInvOn β γ g2 f2 B) (Set.RightInvOn β γ f2 g2 C)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                                    (And.right (Set.MapsTo γ β g2 C B)
                                      ((Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C)) hg2)
                                    (f1 x)
                                    (And.left (Set.MapsTo α β f1 A B)
                                      (∃ (g1 : β → α), Set.MapsTo β α g1 B A ∧
                                          (Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)) hf1
                                      x hx)))
                                (And.left (Set.LeftInvOn α β g1 f1 A) (Set.RightInvOn α β f1 g1 B)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                                  (And.right (Set.MapsTo β α g1 B A)
                                    ((Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)) hg1)
                                  x hx))
                            (fun (z : γ) => fun (hz : z ∈ C) =>
                              Eq.trans.{1} γ (f2 (f1 (g1 (g2 z)))) (f2 (g2 z)) z
                                (congrArg.{1} f2
                                  (And.right (Set.LeftInvOn α β g1 f1 A) (Set.RightInvOn α β f1 g1 B)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                                    (And.right (Set.MapsTo β α g1 B A)
                                      ((Set.LeftInvOn α β g1 f1 A) ∧ (Set.RightInvOn α β f1 g1 B)) hg1)
                                    (g2 z)
                                    (And.left (Set.MapsTo γ β g2 C B)
                                      ((Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C))
                                      hg2 z hz)))
                                (And.right (Set.LeftInvOn β γ g2 f2 B) (Set.RightInvOn β γ f2 g2 C)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                                  (And.right (Set.MapsTo γ β g2 C B)
                                    ((Set.LeftInvOn β γ g2 f2 B) ∧ (Set.RightInvOn β γ f2 g2 C)) hg2)
                                  z hz))))))

-- ─────────────────────────────────────────────────────────────
-- 练习 3（L 类）：任意两个单元素集都等势——亲手写那对映射。
-- 正向是常函数 x ↦ b，反向是常函数 y ↦ a；两条互逆律都要把
-- "x ∈ {a}"（就是一个等式 x = a）掉个头。
-- ─────────────────────────────────────────────────────────────
theorem Set.Equiv.singleton (α β : Type) (a : α) (b : β) :
    Set.Equiv α β {a} {b} := by
  exact Set.Equiv.mk α β {a} {b} (fun (x : α) => b) (fun (y : β) => a)
    (fun (x : α) => fun (hx : x ∈ {a}) => Eq.refl.{1} β b)
    (fun (y : β) => fun (hy : y ∈ {b}) => Eq.refl.{1} α a)
    (fun (x : α) => fun (hx : x ∈ {a}) => Eq.symm.{1} α x a hx)
    (fun (y : β) => fun (hy : y ∈ {b}) => Eq.symm.{1} β y b hy)

-- ─────────────────────────────────────────────────────────────
-- 练习 4（L 类）：集合相等蕴涵等势（Mathlib 真名 `Set.equivOfEq`）。
-- 两把映射都取恒等，四条条件里"送进"的两条要把成员关系沿等式搬过去
-- （Eq.subst），反向那条搬的是 Eq.symm 过的等式。
-- ─────────────────────────────────────────────────────────────
theorem Set.equivOfEq (α : Type) (A B : Set α) (h : A = B) :
    Set.Equiv α α A B := by
  exact Set.Equiv.mk α α A B (fun (x : α) => x) (fun (x : α) => x)
    (fun (x : α) => fun (hx : x ∈ A) =>
      Eq.subst.{1} (Set α) (fun (X : Set α) => x ∈ X) A B h hx)
    (fun (y : α) => fun (hy : y ∈ B) =>
      Eq.subst.{1} (Set α) (fun (X : Set α) => y ∈ X) B A
        (Eq.symm.{1} (Set α) A B h) hy)
    (fun (x : α) => fun (hx : x ∈ A) => Eq.refl.{1} α x)
    (fun (y : α) => fun (hy : y ∈ B) => Eq.refl.{1} α y)

-- ─────────────────────────────────────────────────────────────
-- 练习 5（L 类）：空集与单元素集不等势——用数据反驳。
-- 假设有等势，把反向映射用在 b ∈ {b} 上，得到 g b ∈ ∅，而 ∅ 没有元素。
-- 结论 False 里不出现 f、g，所以两次 Exists.elim 都合法。
-- ─────────────────────────────────────────────────────────────
theorem not_equiv_empty_singleton (α β : Type) (b : β) :
    ¬ (Set.Equiv α β ∅ {b}) := by
  exact fun (h : Set.Equiv α β ∅ {b}) =>
    Exists.elim (α → β)
      (fun (f : α → β) =>
        Set.MapsTo α β f ∅ {b} ∧
          (∃ (g : β → α), Set.MapsTo β α g {b} ∅ ∧
              (Set.LeftInvOn α β g f ∅) ∧ (Set.RightInvOn α β f g {b})))
      False
      h
      (fun (f : α → β) =>
        fun (hf : Set.MapsTo α β f ∅ {b} ∧
                      (∃ (g : β → α), Set.MapsTo β α g {b} ∅ ∧
                          (Set.LeftInvOn α β g f ∅) ∧ (Set.RightInvOn α β f g {b}))) =>
          Exists.elim (β → α)
            (fun (g : β → α) =>
              Set.MapsTo β α g {b} ∅ ∧
                (Set.LeftInvOn α β g f ∅) ∧ (Set.RightInvOn α β f g {b}))
            False
            (And.right (Set.MapsTo α β f ∅ {b})
              (∃ (g : β → α), Set.MapsTo β α g {b} ∅ ∧
                  (Set.LeftInvOn α β g f ∅) ∧ (Set.RightInvOn α β f g {b})) hf)
            (fun (g : β → α) =>
              fun (hg : Set.MapsTo β α g {b} ∅ ∧
                            (Set.LeftInvOn α β g f ∅) ∧ (Set.RightInvOn α β f g {b})) =>
                And.left (Set.MapsTo β α g {b} ∅)
                  ((Set.LeftInvOn α β g f ∅) ∧ (Set.RightInvOn α β f g {b})) hg
                  b (Set.mem_singleton_self β b)))

-- ─────────────────────────────────────────────────────────────
-- 练习 6（D 类，判断：**真**）：等势的集合同时空、同时不空。
-- 两个方向各用一次"用等势"：正向把 A 的元素推到 B，反向把 B 的元素推回 A。
-- 每个方向的结论（∃ (y : β), y ∈ B 或 ∃ (x : α), x ∈ A）都不提证人，两次嵌套 elim 都合法。
-- ─────────────────────────────────────────────────────────────
theorem equiv_nonempty_iff (α β : Type) (A : Set α) (B : Set β)
    (h : Set.Equiv α β A B) :
    (∃ (x : α), x ∈ A) ↔ (∃ (y : β), y ∈ B) := by
  exact Iff.intro (∃ (x : α), x ∈ A) (∃ (y : β), y ∈ B)
    (fun (ha : ∃ (x : α), x ∈ A) =>
      Exists.elim α A (∃ (y : β), y ∈ B) ha
        (fun (x : α) => fun (hx : x ∈ A) =>
          Exists.elim (α → β)
            (fun (f : α → β) =>
              Set.MapsTo α β f A B ∧
                (∃ (g : β → α), Set.MapsTo β α g B A ∧
                    (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)))
            (∃ (y : β), y ∈ B)
            h
            (fun (f : α → β) =>
              fun (hf : Set.MapsTo α β f A B ∧
                            (∃ (g : β → α), Set.MapsTo β α g B A ∧
                                (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B))) =>
                Exists.intro β B (f x)
                  (And.left (Set.MapsTo α β f A B)
                    (∃ (g : β → α), Set.MapsTo β α g B A ∧
                        (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)) hf x hx))))
    (fun (hb : ∃ (y : β), y ∈ B) =>
      Exists.elim β B (∃ (x : α), x ∈ A) hb
        (fun (y : β) => fun (hy : y ∈ B) =>
          Exists.elim (α → β)
            (fun (f : α → β) =>
              Set.MapsTo α β f A B ∧
                (∃ (g : β → α), Set.MapsTo β α g B A ∧
                    (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)))
            (∃ (x : α), x ∈ A)
            h
            (fun (f : α → β) =>
              fun (hf : Set.MapsTo α β f A B ∧
                            (∃ (g : β → α), Set.MapsTo β α g B A ∧
                                (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B))) =>
                Exists.elim (β → α)
                  (fun (g : β → α) =>
                    Set.MapsTo β α g B A ∧
                      (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B))
                  (∃ (x : α), x ∈ A)
                  (And.right (Set.MapsTo α β f A B)
                    (∃ (g : β → α), Set.MapsTo β α g B A ∧
                        (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)) hf)
                  (fun (g : β → α) =>
                    fun (hg : Set.MapsTo β α g B A ∧
                                  (Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)) =>
                      Exists.intro α A (g y)
                        (And.left (Set.MapsTo β α g B A)
                          ((Set.LeftInvOn α β g f A) ∧ (Set.RightInvOn α β f g B)) hg y hy)))))

-- ─────────────────────────────────────────────────────────────
-- 练习 7（D 类，判断：**假**）："真子集一定严格更小"——反例。
-- 本语言没有基数序，"严格更小"只能表述成"真子集且不等势"；于是反例要三段：
--   ① 非零自然数之集 ⊆ Nat（真子集那一半的包含）；
--   ② 它 ≠ Nat（真子集那一半的严格性：0 在右边不在左边）；
--   ③ 它与 Nat 等势（正向 pred、反向 succ——无限集上的"整体与真部分一样大"）。
-- 左互逆律 pred (succ x) = x 要对 x 分情况：succ 那一支靠 iota 直接算，
-- zero 那一支被 x ∈ nonzero 直接否掉（这就是为什么脚手架里要有 succ_ne_zero）。
-- 第一段用点名形式 Set.subset Nat …：⊆ 记法在这里补不出论域（见画布同款注释）。  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
-- ─────────────────────────────────────────────────────────────
theorem proper_subset_counterexample :
    Set.subset Nat nonzero (Set.univ Nat) ∧  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (nonzero ≠ Set.univ Nat ∧ Set.Equiv Nat Nat nonzero (Set.univ Nat)) := by
  exact And.intro (Set.subset Nat nonzero (Set.univ Nat))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (¬ (Eq.{1} (Set Nat) nonzero (Set.univ Nat)) ∧
         Set.Equiv Nat Nat nonzero (Set.univ Nat))
    (fun (x : Nat) => fun (hx : x ∈ nonzero) => True.intro)
    (And.intro (¬ (Eq.{1} (Set Nat) nonzero (Set.univ Nat)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.Equiv Nat Nat nonzero (Set.univ Nat))
      (fun (h : Eq.{1} (Set Nat) nonzero (Set.univ Nat)) =>  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (fun (h0 : Nat.zero ∈ nonzero) => h0 (Eq.refl.{1} Nat Nat.zero))
          (Eq.subst.{1} (Set Nat) (fun (X : Set Nat) => Nat.zero ∈ X)
            (Set.univ Nat) nonzero
