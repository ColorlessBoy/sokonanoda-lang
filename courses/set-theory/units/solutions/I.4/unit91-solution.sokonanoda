import lib.Set
import lib.Rel
import lib.Order

def Injective (α : Type) (β : Type) (f : α → β) : Prop :=
  ∀ (a : α) (b : α), f a = f b → a = b

def Surjective (α : Type) (β : Type) (f : α → β) : Prop :=
  ∀ (b : β), ∃ (a : α), f a = b

def BijPair (α : Type) (β : Type) (f : α → β) : Prop :=
  Injective α β f ∧ Surjective α β f

theorem demo_bij_def (α : Type) (β : Type) (f : α → β) :
    BijPair α β f ↔ Injective α β f ∧ Surjective α β f :=
  Iff.intro (BijPair α β f) (Injective α β f ∧ Surjective α β f)
    (fun (h : BijPair α β f) => h) (fun (h : Injective α β f ∧ Surjective α β f) => h)

theorem demo_inj_def (α : Type) (β : Type) (f : α → β) :
    Injective α β f ↔ ∀ (a : α) (b : α), f a = f b → a = b :=
  Iff.intro (Injective α β f) (∀ (a : α) (b : α), f a = f b → a = b)
    (fun (h : Injective α β f) => h) (fun (h : ∀ (a : α) (b : α), f a = f b → a = b) => h)

theorem demo_surj_def (α : Type) (β : Type) (f : α → β) :
    Surjective α β f ↔ ∀ (b : β), ∃ (a : α), f a = b :=
  Iff.intro (Surjective α β f) (∀ (b : β), ∃ (a : α), f a = b)
    (fun (h : Surjective α β f) => h) (fun (h : ∀ (b : β), ∃ (a : α), f a = b) => h)

theorem bij_id (α : Type) : BijPair α α (fun (x : α) => x) :=
  And.intro (Injective α α (fun (x : α) => x)) (Surjective α α (fun (x : α) => x))
    (fun (a : α) (b : α) (h : a = b) => h)
    (fun (b : α) => Exists.intro α (fun (a : α) => a = b) b (Eq.refl.{1} α b))

theorem right_inv_inj (α : Type) (β : Type) (f : α → β) (g : β → α)
    (hgf : ∀ (b : β), f (g b) = b) : Injective β α g :=
  fun (b : β) (b' : β) (h : g b = g b') =>
    Eq.trans.{1} β b (f (g b)) b' (Eq.symm.{1} β (f (g b)) b (hgf b))
      (Eq.trans.{1} β (f (g b)) (f (g b')) b'
        (Eq.subst.{1} α (fun (x : α) => f (g b) = f x) (g b) (g b') h
          (Eq.refl.{1} β (f (g b))))
        (hgf b'))

theorem left_inv_surj (α : Type) (β : Type) (f : α → β) (g : β → α)
    (hfg : ∀ (a : α), g (f a) = a) : Surjective β α g :=
  fun (a : α) => Exists.intro β (fun (b : β) => g b = a) (f a) (hfg a)

theorem inv_bij (α : Type) (β : Type) (f : α → β) (g : β → α)
    (hfg : ∀ (a : α), g (f a) = a) (hgf : ∀ (b : β), f (g b) = b) :
    BijPair β α g :=
  And.intro (Injective β α g) (Surjective β α g)
    (right_inv_inj α β f g hgf) (left_inv_surj α β f g hfg)

theorem inv_unique (α : Type) (β : Type) (f : α → β) (g : β → α) (g' : β → α)
    (hfg : ∀ (a : α), g (f a) = a) (hg : ∀ (b : β), f (g b) = b)
    (hg' : ∀ (b : β), f (g' b) = b) : ∀ (b : β), g b = g' b :=
  fun (b : β) =>
    Eq.trans.{1} α (g b) (g (f (g' b))) (g' b)
      (Eq.subst.{1} β (fun (x : β) => g b = g x) b (f (g' b))
        (Eq.symm.{1} β (f (g' b)) b (hg' b)) (Eq.refl.{1} α (g b)))
      (hfg (g' b))
