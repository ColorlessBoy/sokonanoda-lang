import lib.Set
import lib.SUnion
import lib.Order

theorem demo_mem_empty_iff_false (α : Type) (a : α) :
    a ∈ (∅) ↔ False :=
  Set.mem_empty_iff_false a

theorem demo_not_mem_empty (α : Type) (a : α) : ¬ (a ∈ (∅)) :=
  fun (h : a ∈ (∅)) => (Iff.mp (Set.mem_empty_iff_false a) h)

theorem demo_subset_def (α : Type) (A B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  @Set.subset_def α A B

theorem not_all_of_counterexample (α : Type) (P : α → Prop) (a : α) (hna : ¬ (P a)) :
    ¬ (∀ (x : α), P x) :=
  fun (h : ∀ (x : α), P x) => hna (h a)

theorem not_subset_of_witness (α : Type) (A B : Set α) (a : α)
    (ha : a ∈ A) (hna : ¬ (a ∈ B)) : ¬ (A ⊆ B) :=
  fun (h : A ⊆ B) => hna (h a ha)

theorem not_all_mem_empty (α : Type) (a : α) : ¬ (∀ (x : α), x ∈ (∅)) :=
  not_all_of_counterexample α (fun (x : α) => x ∈ (∅)) a
    (fun (h : a ∈ (∅)) => (Iff.mp (Set.mem_empty_iff_false a) h))

theorem not_univ_subset_empty (α : Type) (a : α) :
    ¬ (Set.univ α ⊆ (∅)) :=
  fun (h : Set.univ α ⊆ (∅)) =>
    (Iff.mp (Set.mem_empty_iff_false a)) (h a (@Set.mem_univ α a))
