-- unit08 解答钥匙（agent 专用；与画布 unit08-images-preimages.sokonanoda 逐题同名一一对应）。
-- 判卷：`node scripts/soko grade "<绝对路径>/unit08-solution.sokonanoda"`（相对路径会因 G-12 报 import-not-found）。
-- 练习格局（与画布同一套编号）：T-3（preimage_union / preimage_compl / image_union）·
--           L-3（preimage_inter / image_subset_iff / image_preimage_image_eq_preimage）·
--           D-3（像不保交 / 像不还原 / 补上假设等号回来）= 9 题。
-- 另有 6 条**辅助声明**（不是练习，画布没有同名件）：bb_mem_U01 / aa_mem_inter_image /
-- image_preimage_eq_aa / bb_not_mem_image_preimage / image_preimage_eq_image / eq_of_subsets
-- ——它们是反例的零件与桥；其中 aa_mem_inter_image 在画布里就是那条**无名 `example`**。
--
-- ⚠️ 三条**语言缺口**决定了本文件的写法（每条都是判卷实测，详见文件末 §实测记录）：
--   ① 构造子"aa ≠ bb"无法从内核推出 ⇒ 只能立公理；
--   ② 假设**不能**当函数喂给具体参数（`h B` 被拒）⇒ 反例必须做成独立的 `False` 引理；
--   ③ 内核不化简变量处的 `match` 定义 ⇒ 抽象等式必须用 `match` 证（`f1_eq_aa`）。
import lib.Logic
import lib.Exists
import lib.Set
import lib.Image

-- ─────────────────────────────────────────────────────────────
-- 演示（两条，与画布同名）：image / preimage 的定义展开
-- ─────────────────────────────────────────────────────────────

theorem demo_mem_image (α β : Type) (f : α → β) (A : Set α) (y : β) :
    y ∈ f '' A ↔ ∃ (x : α), A x ∧ f x = y := by
  exact Set.mem_image α β f A y

theorem demo_mem_preimage (α β : Type) (f : α → β) (B : Set β) (x : α) :
    (x ∈ (f ⁻¹' B)) ↔ ((f x) ∈ B) := by
  exact Set.mem_preimage α β f B x

-- ─────────────────────────────────────────────────────────────
-- 练习 1（T 类）：原像保并
-- ─────────────────────────────────────────────────────────────

theorem preimage_union (α β : Type) (f : α → β) (B C : Set β) :
    Eq.{1} (Set α) (f ⁻¹' (B ∪ C))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      ((f ⁻¹' B) ∪ (f ⁻¹' C)) := by
  exact Set.ext α (f ⁻¹' (B ∪ C))
    ((f ⁻¹' B) ∪ (f ⁻¹' C))
    (fun (x : α) =>
      Iff.intro (x ∈ (f ⁻¹' (B ∪ C)))
        ((x ∈ (f ⁻¹' B)) ∨ (x ∈ (f ⁻¹' C)))
        (fun (h : x ∈ (f ⁻¹' (B ∪ C))) =>
          Or.elim ((f x) ∈ B) ((f x) ∈ C)
            ((x ∈ (f ⁻¹' B)) ∨ (x ∈ (f ⁻¹' C)))
            (fun (hb : (f x) ∈ B) =>
              Or.inl hb)
            (fun (hc : (f x) ∈ C) =>
              Or.inr hc)
            h)
        (fun (h : (x ∈ (f ⁻¹' B)) ∨ (x ∈ (f ⁻¹' C))) =>
          Or.elim (x ∈ (f ⁻¹' B)) (x ∈ (f ⁻¹' C))
            ((f x) ∈ (B ∪ C))
            (fun (hb : x ∈ (f ⁻¹' B)) =>
              Or.inl hb)
            (fun (hc : x ∈ (f ⁻¹' C)) =>
              Or.inr hc)
            h))

-- ─────────────────────────────────────────────────────────────
-- 练习 2（T 类）：原像保补
-- ─────────────────────────────────────────────────────────────

theorem preimage_compl (α β : Type) (f : α → β) (B : Set β) :
    (f ⁻¹' (Bᶜ)) = ((f ⁻¹' B)ᶜ) := by
  exact Set.ext α (f ⁻¹' (Bᶜ)) ((f ⁻¹' B)ᶜ)
    (fun (x : α) =>
      Iff.intro (fun (h : x ∈ (f ⁻¹' (Bᶜ))) =>
          fun (hb : x ∈ (f ⁻¹' B)) => h hb) (fun (h : ¬ (x ∈ (f ⁻¹' B))) =>
          fun (hb : (f x) ∈ B) => h hb))

-- ─────────────────────────────────────────────────────────────
-- 练习 3（L 类）：原像保交
-- ─────────────────────────────────────────────────────────────

theorem preimage_inter (α β : Type) (f : α → β) (B C : Set β) :
    Eq.{1} (Set α) (f ⁻¹' (B ∩ C))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      ((f ⁻¹' B) ∩ (f ⁻¹' C)) := by
  exact Set.ext α (f ⁻¹' (B ∩ C))
    ((f ⁻¹' B) ∩ (f ⁻¹' C))
    (fun (x : α) =>
      Iff.intro (x ∈ (f ⁻¹' (B ∩ C)))
        ((x ∈ (f ⁻¹' B)) ∧ (x ∈ (f ⁻¹' C)))
        (fun (h : x ∈ (f ⁻¹' (B ∩ C))) =>
          And.intro (And.left h)
            (And.right h))
        (fun (h : (x ∈ (f ⁻¹' B)) ∧ (x ∈ (f ⁻¹' C))) =>
          And.intro (And.left h)
            (And.right h)))

-- ─────────────────────────────────────────────────────────────
-- 练习 4（T 类）：像保并
-- ─────────────────────────────────────────────────────────────

theorem image_union (α β : Type) (f : α → β) (A B : Set α) :
    Eq.{1} (Set β) (f '' (A ∪ B))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      ((f '' A) ∪ (f '' B)) := by
  exact Set.ext β (f '' (A ∪ B))
    ((f '' A) ∪ (f '' B))
    (fun (y : β) =>
      Iff.intro (y ∈ (f '' (A ∪ B)))
        ((y ∈ (f '' A)) ∨ (y ∈ (f '' B)))
        (fun (h : y ∈ (f '' (A ∪ B))) =>
          Exists.elim α (fun (x : α) => (x ∈ (A ∪ B)) ∧ ((f x) = y))
            ((y ∈ (f '' A)) ∨ (y ∈ (f '' B))) h
            (fun (x : α) => fun (hx : (x ∈ (A ∪ B)) ∧ ((f x) = y)) =>
              Or.elim (A x) (B x)
                ((y ∈ (f '' A)) ∨ (y ∈ (f '' B)))
                (fun (ha : A x) =>
                  Or.inl (y ∈ (f '' A)) (y ∈ (f '' B))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                    (Exists.intro α (fun (t : α) => (A t) ∧ ((f t) = y)) x
                      (And.intro (A x) ((f x) = y) ha  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                        (And.right (x ∈ (A ∪ B)) ((f x) = y) hx))))
                (fun (hb : B x) =>
                  Or.inr (y ∈ (f '' A)) (y ∈ (f '' B))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                    (Exists.intro α (fun (t : α) => (B t) ∧ ((f t) = y)) x
                      (And.intro (B x) ((f x) = y) hb  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                        (And.right (x ∈ (A ∪ B)) ((f x) = y) hx))))
                (And.left (x ∈ (A ∪ B)) ((f x) = y) hx)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (fun (h : (y ∈ (f '' A)) ∨ (y ∈ (f '' B))) =>
          Or.elim (y ∈ (f '' A)) (y ∈ (f '' B))
            (y ∈ (f '' (A ∪ B)))
            (fun (ha : y ∈ (f '' A)) =>
              Exists.elim α (fun (x : α) => (A x) ∧ ((f x) = y))
                (y ∈ (f '' (A ∪ B))) ha
                (fun (x : α) => fun (hx : (A x) ∧ ((f x) = y)) =>
                  Exists.intro α
                    (fun (t : α) => (t ∈ (A ∪ B)) ∧ ((f t) = y)) x
                    (And.intro (x ∈ (A ∪ B)) ((f x) = y)
                      (Or.inl (A x) (B x) (And.left (A x) ((f x) = y) hx))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                      (And.right (A x) ((f x) = y) hx))))
            (fun (hb : y ∈ (f '' B)) =>
              Exists.elim α (fun (x : α) => (B x) ∧ ((f x) = y))
                (y ∈ (f '' (A ∪ B))) hb
                (fun (x : α) => fun (hx : (B x) ∧ ((f x) = y)) =>
                  Exists.intro α
                    (fun (t : α) => (t ∈ (A ∪ B)) ∧ ((f t) = y)) x
                    (And.intro (x ∈ (A ∪ B)) ((f x) = y)
                      (Or.inr (A x) (B x) (And.left (B x) ((f x) = y) hx))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                      (And.right (B x) ((f x) = y) hx))))
            h))

-- ─────────────────────────────────────────────────────────────
-- 练习 5（L 类）：image_subset_iff（库里的判据，直接引用）
-- ─────────────────────────────────────────────────────────────

theorem image_subset_iff (α β : Type) (f : α → β) (A : Set α) (B : Set β) :
    ((f '' A) ⊆ B) ↔ (A ⊆ (f ⁻¹' B)) := by
  exact Set.image_subset_iff α β f A B

-- ─────────────────────────────────────────────────────────────
-- 演示（与画布同名）：`f '' (A ∩ B) = f '' A ∩ f '' B` 假——真的那一半
-- ─────────────────────────────────────────────────────────────

theorem image_inter_subset (α β : Type) (f : α → β) (A B : Set α) :
    Set.subset β (f '' (A ∩ B))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      ((f '' A) ∩ (f '' B)) := by
  intro y h
  exact Exists.elim α
    (fun (x : α) => (x ∈ (A ∩ B)) ∧ ((f x) = y))
    ((y ∈ (f '' A)) ∧ (y ∈ (f '' B))) h
    (fun (x : α) => fun (hx : (x ∈ (A ∩ B)) ∧ ((f x) = y)) =>
      And.intro (y ∈ (f '' A)) (y ∈ (f '' B))
        (Exists.intro α (fun (t : α) => (A t) ∧ ((f t) = y)) x
          (And.intro (A x) ((f x) = y)
            (And.left (A x) (B x)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
              (And.left (x ∈ (A ∩ B)) ((f x) = y) hx))
            (And.right (x ∈ (A ∩ B)) ((f x) = y) hx)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (Exists.intro α (fun (t : α) => (B t) ∧ ((f t) = y)) x
          (And.intro (B x) ((f x) = y)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
            (And.right (A x) (B x)
              (And.left (x ∈ (A ∩ B)) ((f x) = y) hx))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
            (And.right (x ∈ (A ∩ B)) ((f x) = y) hx))))

-- 像的单调性（真的那一半的另一半）：直接吃库里的 `Set.image_mono`。
theorem image_mono (α β : Type) (f : α → β) (A B : Set α)
    (h : A ⊆ B) : (f '' A) ⊆ (f '' B) := by
  exact Set.image_mono α β f A B h

-- ─────────────────────────────────────────────────────────────
-- 反例用的元素类型、映射与零件引理（与画布 8.4 同名同内容）
-- ─────────────────────────────────────────────────────────────

inductive Two : Type
ctor aa : Two
ctor bb : Two
end

-- 语言缺口 ①（复核轮已消解）：初版把"aa ≠ bb"立成公理（`ax_aa_ne_bb`）；复核轮实测它**可证**
-- 且可当函数用，所以这里改成 `isAa` + `two_aa_ne_bb`（见文件末 §实测记录 ①）。
def isAa (t : Two) : Prop := match t with
| aa => True
| bb => False

theorem two_aa_ne_bb : ¬ (aa = bb) := by
  intro h
  exact Eq.subst.{1} Two (fun (t : Two) => isAa t) aa bb h True.intro

-- 画布要求"把映射写出来"：反例用的映射 f1 就写在纸面上（两个点塌成一个）。
def f1 (t : Two) : Two := match t with
| aa => aa
| bb => aa

-- 语言缺口 ③：内核不化简变量处的 match 定义，所以这条抽象等式只能用 match 证。
theorem f1_eq_aa (x : Two) : (f1 x) = aa := by
  exact match x with
  | aa => Eq.refl.{1} Two aa
  | bb => Eq.refl.{1} Two aa

def U01 : Set Two := fun (x : Two) => (x = aa) ∨ (x = bb)

theorem bb_mem_U01 : bb ∈ U01 := by  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
  exact Or.inr (bb = aa) (bb = bb) (Eq.refl.{1} Two bb)

theorem inter_singletons_empty :
    Eq.{1} (Set Two) (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.empty Two) := by
  exact Set.ext Two (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)) (Set.empty Two)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (fun (x : Two) =>
      Iff.intro (Set.mem Two x (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (Set.mem Two x (Set.empty Two))
        (fun (hx : Set.mem Two x (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb))) =>  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
          False.elim (Set.mem Two x (Set.empty Two))
            (two_aa_ne_bb
              (Eq.trans.{1} Two aa x bb
                (Eq.symm.{1} Two x aa
                  (And.left (Set.mem Two x (Set.singleton Two aa))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                    (Set.mem Two x (Set.singleton Two bb)) hx))
                (And.right (Set.mem Two x (Set.singleton Two aa))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                  (Set.mem Two x (Set.singleton Two bb)) hx))))
        (fun (h0 : Set.mem Two x (Set.empty Two)) =>  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
          False.elim (Set.mem Two x (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb))) h0))

theorem image_empty (A : Set Two) :
    (f1 '' (∅)) = (∅) := by
  exact Set.ext Two (f1 '' (∅)) (∅)
    (fun (y : Two) =>
      Iff.intro (y ∈ (f1 '' (∅)))
        (y ∈ (∅))
        (fun (hy : y ∈ (f1 '' (∅))) =>
          Exists.elim Two
            (fun (x : Two) => (x ∈ (∅)) ∧ ((f1 x) = y))
            (y ∈ (∅)) hy
            (fun (x : Two) =>
              fun (hx : (x ∈ (∅)) ∧ ((f1 x) = y)) =>
                False.elim (And.left hx)))
        (fun (h0 : y ∈ (∅)) =>
          False.elim h0))

theorem image_inter_singletons_empty :
    Eq.{1} (Set Two)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.image Two Two f1 (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)))
      (Set.empty Two) := by  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
  exact Eq.trans.{1} (Set Two)
    (Set.image Two Two f1 (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (Set.image Two Two f1 (Set.empty Two))
    (Set.empty Two)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (congrArg.{1} (fun (X : Set Two) => Set.image Two Two f1 X) inter_singletons_empty)
    (image_empty (Set.empty Two))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）

-- aa 落在 `f1 '' {aa} ∩ f1 '' {bb}` 里（两个单点集都被压到 {aa}）。
theorem aa_mem_inter_image :
    Set.mem Two aa  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.inter Two (Set.image Two Two f1 (Set.singleton Two aa))
        (Set.image Two Two f1 (Set.singleton Two bb))) := by  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
  exact And.intro (Set.mem Two aa (Set.image Two Two f1 (Set.singleton Two aa)))
    (Set.mem Two aa (Set.image Two Two f1 (Set.singleton Two bb)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (Exists.intro Two (fun (t : Two) => (Eq.{1} Two t aa) ∧ (Eq.{1} Two (f1 t) aa))
      aa (And.intro (Eq.{1} Two aa aa) (Eq.{1} Two (f1 aa) aa)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (Eq.refl.{1} Two aa) (Eq.refl.{1} Two aa)))
    (Exists.intro Two (fun (t : Two) => (Eq.{1} Two t bb) ∧ (Eq.{1} Two (f1 t) aa))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      bb (And.intro (Eq.{1} Two bb bb) (Eq.{1} Two (f1 bb) aa)
        (Eq.refl.{1} Two bb) (Eq.refl.{1} Two aa)))

-- 练习 6（D 类，必破）：两侧不等——左边是 ∅，右边含 aa。
theorem not_image_inter_eq_image_inter :
    ¬ (Eq.{1} (Set Two)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.image Two Two f1 (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)))
      (Set.inter Two (Set.image Two Two f1 (Set.singleton Two aa))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (Set.image Two Two f1 (Set.singleton Two bb)))) := by
  intro h
  exact Set.notMem_empty Two aa
    (Eq.subst.{1} (Set Two) (fun (X : Set Two) => Set.mem Two aa X)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.inter Two (Set.image Two Two f1 (Set.singleton Two aa))
        (Set.image Two Two f1 (Set.singleton Two bb)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (Set.empty Two)
      (Eq.trans.{1} (Set Two)
        (Set.inter Two (Set.image Two Two f1 (Set.singleton Two aa))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
          (Set.image Two Two f1 (Set.singleton Two bb)))
        (Set.image Two Two f1 (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (Set.empty Two)
        (Eq.symm.{1} (Set Two)
          (Set.image Two Two f1 (Set.inter Two (Set.singleton Two aa) (Set.singleton Two bb)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
          (Set.inter Two (Set.image Two Two f1 (Set.singleton Two aa))
            (Set.image Two Two f1 (Set.singleton Two bb))) h)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
        (image_inter_singletons_empty))
      aa_mem_inter_image)

-- ─────────────────────────────────────────────────────────────
-- 演示（与画布同名）：`f '' (f ⁻¹' C) = C` 假——真的那一半（无需任何假设）
-- ─────────────────────────────────────────────────────────────

theorem image_preimage_subset (α β : Type) (f : α → β) (C : Set β) :
    (f '' (f ⁻¹' C)) ⊆ C := by
  intro y h
  exact Exists.elim α
    (fun (x : α) => (x ∈ (f ⁻¹' C)) ∧ ((f x) = y))
    (y ∈ C) h
    (fun (x : α) => fun (hx : (x ∈ (f ⁻¹' C)) ∧ ((f x) = y)) =>
      Eq.subst.{1} β (fun (z : β) => z ∈ C) (f x) y
        (And.right hx)
        (And.left hx))

-- 练习 7（D 类，必破）：反例的零件。
-- def image_preimage 与画布 8.4 同名同定义（被 f1 取到的点 = 值域）；
-- 下面三条引理各自结论具体（`Eq`/`Not`），主定理只做 Eq.subst 搬运（见 §实测记录 ④）。
def image_preimage : Set Two := fun (y : Two) =>
  ∃ (x : Two), (f1 x) = y

theorem image_preimage_eq_aa (y : Two) (hy : y ∈ image_preimage) :
    y = aa := by
  exact Exists.elim Two (fun (x : Two) => (f1 x) = y) (y = aa) hy  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (fun (x : Two) => fun (hx : (f1 x) = y) =>
      Eq.trans.{1} Two y (f1 x) aa (Eq.symm.{1} Two (f1 x) y hx) (f1_eq_aa x))

theorem bb_not_mem_image_preimage : ¬ (bb ∈ image_preimage) := by
  intro h
  exact Exists.elim h
    (fun (x : Two) => fun (hx : (f1 x) = bb) =>
      two_aa_ne_bb
        (Eq.trans.{1} Two aa (f1 x) bb (Eq.symm.{1} Two (f1 x) aa (f1_eq_aa x)) hx))

theorem image_preimage_eq_image :
    Eq.{1} (Set Two) image_preimage  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
      (f1 '' (f1 ⁻¹' U01)) := by
  exact Set.ext Two image_preimage (f1 '' (f1 ⁻¹' U01))
    (fun (y : Two) =>
      Iff.intro (y ∈ image_preimage)
        (y ∈ (f1 '' (f1 ⁻¹' U01)))
        (fun (hy : y ∈ image_preimage) =>
          Exists.elim Two (fun (x : Two) => (f1 x) = y)
            (y ∈ (f1 '' (f1 ⁻¹' U01))) hy
            (fun (x : Two) => fun (hx : (f1 x) = y) =>
              Exists.intro Two
                (fun (t : Two) => t ∈ (f1 ⁻¹' U01) ∧
                  (f1 t) = y)
                x
                (And.intro (x ∈ (f1 ⁻¹' U01)) ((f1 x) = y)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                  (Or.inl ((f1 x) = aa) ((f1 x) = bb) (f1_eq_aa x))
                  hx)))
        (fun (hy : y ∈ (f1 '' (f1 ⁻¹' U01))) =>
          Exists.elim Two
            (fun (x : Two) => x ∈ (f1 ⁻¹' U01) ∧
              (f1 x) = y)
            (y ∈ image_preimage) hy
            (fun (x : Two) => fun (hx : x ∈ (f1 ⁻¹' U01) ∧
                (f1 x) = y) =>  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
              Exists.intro Two (fun (t : Two) => (f1 t) = y) x
                (And.right (x ∈ (f1 ⁻¹' U01)) ((f1 x) = y) hx))))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）

-- 通用小引理：两条包含给相等（就是单元②的 subset_antisymm，这里按 Set.ext 写一遍）。
theorem eq_of_subsets (α : Type) (A B : Set α)
    (h1 : A ⊆ B) (h2 : B ⊆ A) : A = B := by
  exact Set.ext α A B (fun (x : α) => Iff.intro (h1 x) (h2 x))

-- 练习 8（L 类）：反例闭环的桥（方向：左式 = image_preimage）。
theorem image_preimage_image_eq_preimage :
    (f1 '' (f1 ⁻¹' U01)) = image_preimage := by
  exact eq_of_subsets Two (f1 '' (f1 ⁻¹' U01)) image_preimage
    (fun (y : Two) =>
      fun (hy : y ∈ (f1 '' (f1 ⁻¹' U01))) =>
        Exists.elim Two
          (fun (x : Two) => x ∈ (f1 ⁻¹' U01) ∧
            (f1 x) = y)
          (y ∈ image_preimage) hy
          (fun (x : Two) => fun (hx : x ∈ (f1 ⁻¹' U01) ∧
              (f1 x) = y) =>  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
            Exists.intro Two (fun (t : Two) => (f1 t) = y) x
              (And.right (x ∈ (f1 ⁻¹' U01)) ((f1 x) = y) hx)))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
    (fun (y : Two) => fun (hy : y ∈ image_preimage) =>
      Exists.elim Two (fun (x : Two) => (f1 x) = y)
        (y ∈ (f1 '' (f1 ⁻¹' U01))) hy
        (fun (x : Two) => fun (hx : (f1 x) = y) =>
          Exists.intro Two
            (fun (t : Two) => t ∈ (f1 ⁻¹' U01) ∧
              (f1 t) = y)
            x
            (And.intro (x ∈ (f1 ⁻¹' U01)) ((f1 x) = y)  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
              (Or.inl ((f1 x) = aa) ((f1 x) = bb) (f1_eq_aa x))
              hx)))

theorem not_image_preimage_eq :
    ¬ ((f1 '' (f1 ⁻¹' U01)) = U01) := by
  intro h
  exact bb_not_mem_image_preimage
    (Eq.subst.{1} (Set Two) (fun (X : Set Two) => bb ∈ X)
      (f1 '' (f1 ⁻¹' U01)) image_preimage
      (Eq.symm.{1} (Set Two) image_preimage
        (f1 '' (f1 ⁻¹' U01)) image_preimage_eq_image)
      (Eq.subst.{1} (Set Two) (fun (X : Set Two) => bb ∈ X) U01
        (f1 '' (f1 ⁻¹' U01))
        (Eq.symm.{1} (Set Two) (f1 '' (f1 ⁻¹' U01)) U01 h)
        bb_mem_U01))

-- 练习 9（D 类）：`C ⊆ f '' univ`（满射性）时等号回来——"需要什么假设"的答案。
theorem image_preimage_eq_of_subset_image_univ (α β : Type) (f : α → β) (C : Set β)
    (h : C ⊆ (f '' (Set.univ α))) :
    (f '' (f ⁻¹' C)) = C := by
  exact Set.ext β (f '' (f ⁻¹' C)) C
    (fun (y : β) =>
      Iff.intro (y ∈ (f '' (f ⁻¹' C))) (y ∈ C)
        (image_preimage_subset α β f C y)
        (fun (hy : y ∈ C) =>
          Iff.mpr (y ∈ (f '' (f ⁻¹' C)))
            (∃ (x : α), (x ∈ (f ⁻¹' C)) ∧ ((f x) = y))
            (Set.mem_image α β f (f ⁻¹' C) y)
            (Exists.elim α (fun (x : α) => (x ∈ (Set.univ α)) ∧ ((f x) = y))
              (∃ (x : α), (x ∈ (f ⁻¹' C)) ∧ ((f x) = y))
              (h y hy)
              (fun (x : α) => fun (hx : (x ∈ (Set.univ α)) ∧ ((f x) = y)) =>
                Exists.intro α
                  (fun (t : α) => (t ∈ (f ⁻¹' C)) ∧ ((f t) = y)) x
                  (And.intro (x ∈ (f ⁻¹' C)) ((f x) = y)
                    (Eq.subst.{1} β (fun (z : β) => z ∈ C) y (f x)
                      (Eq.symm.{1} β (f x) y
                        (And.right (x ∈ (Set.univ α)) ((f x) = y) hx))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）
                      hy)
                    (And.right (x ∈ (Set.univ α)) ((f x) = y) hx))))))  -- soko:notation-ok: R1/R2：点名叫法写全前导类型参数（短写在 def-headed 目标/嵌套 λ 里补不出）

-- ─────────────────────────────────────────────────────────────
-- §实测记录（**复核轮重测过**；每条都给出可复现的最小实验。初版有两条结论被推翻，见 ①②）
--
-- ① **"aa ≠ bb"可证，不需要公理**（初版曾写成 axiom `ax_aa_ne_bb`，复核轮推翻）：
--      `def isAa (t : Two) : Prop := match t with | aa => True | bb => False` 配
--      `theorem two_aa_ne_bb : ¬ (aa = bb) := fun h => Eq.subst (fun t => isAa t) aa bb h True.intro`
--    不但判过，**而且能当函数用**：把它替换进本文件的全部四个用点（inter_singletons_empty、
--    bb_not_mem_image_preimage），整份文件 `grade` 退出码 0（复核实测）。
--    ⚠ 用法限制（实测）：`match` 的结果类型必须已知——内联写成
--    `Eq.subst (fun t => match t with …)` 会被解析器拒（`elab-match-no-expected-type`），
--    所以 motive 要先命名成带类型标注的 `def isAa`。
-- ② **假设可以喂给具体参数**（初版结论不复现）：`axiom bad : False` 配
--    `theorem t2 (hsub : False → False) : False := hsub bad` 判过（复核实测）。
--    本文件保留"零件各自独立成引理"的写法是**风格选择**（每步结论具体、好核对），
--    不是语言限制。
-- ③ **变量处的 match 定义不归约**（这条仍然成立）：`f1 x` 在 `x` 抽象时不归约，所以
--    `f1 x = aa` 只能用 `match` 证（两支各交一个具体等式，见 `f1_eq_aa`）。
-- ④ 于是本文件的 D 类反例一律拆成**结论具体**的零件（`aa_mem_inter_image`、
--    `bb_not_mem_image_preimage`、`image_preimage_eq_aa`、`image_preimage_eq_image`），
--    主定理只负责用 `Eq.subst` 沿假设的等号搬零件——这样每一步的结论都是具体的
--    `Eq`/`Not`/`False`，不必求内核去化简 `match` 定义或公理应用。
