-- unit04 解答钥匙（agent 专用；画布不 import 它）。
--
-- 与 unit04-extensionality-identities.sokonanoda 的 8 条练习**同名一一对应**：
--   T 类 2 条：union_comm、inter_comm
--   R 类 2 条：union_inter_idem（幂等律打包成一条 And）、union_sdiff_univ_ne_univ（必破：证伪）
--   X 类 4 条：inter_union_distrib_left、union_inter_self、sdiff_sdiff、union_empty
--
-- 全部改写为 **tactic 模式**（设计 docs/design/course-lean-style.md R2）：
-- 记法用 `∈ ∪ ∩ \ ∅ = ∧ ∨ ↔ ¬`（集合符号由 `lib/Set` 声明、随 import 生效，
-- 连接符是语言内建），证明只用白名单 tactic：`apply` / `intro` / `exact` /
-- `constructor`，项位照旧可写 `fun` 与点名引理（`Or.inl` / `Or.elim` /
-- `And.left` / `Eq.subst.{1}` …）——与单元② 的解答同一风格。
-- 等式不再需要写宇宙：`=` 记法由判卷器按操作数的 sort 定层级。
--
-- 一条**书写纪律**（判卷器的实测边界，不是风格偏好）：`∅` 是零元记法，落在
-- 「被应用」的位置（`(∅) x`）补不出类型参数 ⇒ 第 8 题的语句里 `\` 与 `∪`
-- 写点名形式（`Set.sdiff` / `Set.union`）。画布 `demo_sdiff_self` 给出了
-- 另一条边界：`apply Set.ext` 会把子目标写成 `(A \ A) x ↔ (∅) x`，
-- 所以那里先用 `have` 写出逐元素 Iff 的**源形态**再交给 `Set.ext`。
import lib.Logic
import lib.Set

-- T 类：并交换律。逐元素 Iff (x ∈ A ∪ B) (x ∈ B ∪ A)。
theorem union_comm (α : Type) (A B : Set α) :
    A ∪ B = B ∪ A := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact Or.elim (x ∈ A) (x ∈ B) (x ∈ B ∪ A)
    (fun (ha : x ∈ A) => Or.inr (x ∈ B) (x ∈ A) ha)
    (fun (hb : x ∈ B) => Or.inl (x ∈ B) (x ∈ A) hb)
    h
  intro h
  exact Or.elim (x ∈ B) (x ∈ A) (x ∈ A ∪ B)
    (fun (hb : x ∈ B) => Or.inr (x ∈ A) (x ∈ B) hb)
    (fun (ha : x ∈ A) => Or.inl (x ∈ A) (x ∈ B) ha)
    h

-- T 类：交交换律。逐元素 Iff (x ∈ A ∩ B) (x ∈ B ∩ A)。
theorem inter_comm (α : Type) (A B : Set α) :
    A ∩ B = B ∩ A := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact And.intro (x ∈ B) (x ∈ A)
    (And.right (x ∈ A) (x ∈ B) h)
    (And.left (x ∈ A) (x ∈ B) h)
  intro h
  exact And.intro (x ∈ A) (x ∈ B)
    (And.right (x ∈ B) (x ∈ A) h)
    (And.left (x ∈ B) (x ∈ A) h)

-- R 类（读·评译）：幂等律打包 —— A ∪ A = A 与 A ∩ A = A。
theorem union_inter_idem (α : Type) (A : Set α) :
    (A ∪ A = A) ∧ (A ∩ A = A) := by
  constructor
  apply Set.ext
  intro x
  constructor
  intro h
  exact Or.elim (x ∈ A) (x ∈ A) (x ∈ A)
    (fun (ha : x ∈ A) => ha)
    (fun (ha : x ∈ A) => ha)
    h
  intro ha
  exact Or.inl (x ∈ A) (x ∈ A) ha
  apply Set.ext
  intro x
  constructor
  intro h
  exact And.left (x ∈ A) (x ∈ A) h
  intro ha
  exact And.intro (x ∈ A) (x ∈ A) ha ha

-- X 类：交对并分配 —— A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C)。
theorem inter_union_distrib_left (α : Type) (A B C : Set α) :
    A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C) := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact Or.elim (x ∈ B) (x ∈ C) (x ∈ (A ∩ B) ∪ (A ∩ C))
    (fun (hb : x ∈ B) =>
      Or.inl (x ∈ A ∩ B) (x ∈ A ∩ C)
        (And.intro (x ∈ A) (x ∈ B) (And.left (x ∈ A) (x ∈ B ∨ x ∈ C) h) hb))
    (fun (hc : x ∈ C) =>
      Or.inr (x ∈ A ∩ B) (x ∈ A ∩ C)
        (And.intro (x ∈ A) (x ∈ C) (And.left (x ∈ A) (x ∈ B ∨ x ∈ C) h) hc))
    (And.right (x ∈ A) (x ∈ B ∨ x ∈ C) h)
  intro h
  exact Or.elim (x ∈ A ∩ B) (x ∈ A ∩ C) (x ∈ A ∩ (B ∪ C))
    (fun (hab : x ∈ A ∩ B) =>
      And.intro (x ∈ A) (x ∈ B ∨ x ∈ C)
        (And.left (x ∈ A) (x ∈ B) hab)
        (Or.inl (x ∈ B) (x ∈ C) (And.right (x ∈ A) (x ∈ B) hab)))
    (fun (hac : x ∈ A ∩ C) =>
      And.intro (x ∈ A) (x ∈ B ∨ x ∈ C)
        (And.left (x ∈ A) (x ∈ C) hac)
        (Or.inr (x ∈ B) (x ∈ C) (And.right (x ∈ A) (x ∈ C) hac)))
    h

-- X 类：吸收律 —— A ∪ (A ∩ B) = A。
theorem union_inter_self (α : Type) (A B : Set α) :
    A ∪ (A ∩ B) = A := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact Or.elim (x ∈ A) (x ∈ A ∩ B) (x ∈ A)
    (fun (ha : x ∈ A) => ha)
    (fun (hab : x ∈ A ∩ B) => And.left (x ∈ A) (x ∈ B) hab)
    h
  intro ha
  exact Or.inl (x ∈ A) (x ∈ A ∩ B) ha

-- X 类：差的差 —— (A \ B) \ C = A \ (B ∪ C)。
theorem sdiff_sdiff (α : Type) (A B C : Set α) :
    (A \ B) \ C = A \ (B ∪ C) := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact And.intro (x ∈ A) (¬ (x ∈ B ∪ C))
    (And.left (x ∈ A) (¬ (x ∈ B))
      (And.left (x ∈ A ∧ ¬ (x ∈ B)) (¬ (x ∈ C)) h))
    (fun (hbc : x ∈ B ∪ C) =>
      Or.elim (x ∈ B) (x ∈ C) False
        (fun (hb : x ∈ B) =>
          And.right (x ∈ A) (¬ (x ∈ B))
            (And.left (x ∈ A ∧ ¬ (x ∈ B)) (¬ (x ∈ C)) h) hb)
        (fun (hcx : x ∈ C) =>
          And.right (x ∈ A ∧ ¬ (x ∈ B)) (¬ (x ∈ C)) h hcx)
        hbc)
  intro h
  exact And.intro (x ∈ A ∧ ¬ (x ∈ B)) (¬ (x ∈ C))
    (And.intro (x ∈ A) (¬ (x ∈ B))
      (And.left (x ∈ A) (¬ (x ∈ B ∪ C)) h)
      (fun (hb : x ∈ B) =>
        And.right (x ∈ A) (¬ (x ∈ B ∪ C)) h (Or.inl (x ∈ B) (x ∈ C) hb)))
    (fun (hc : x ∈ C) =>
      And.right (x ∈ A) (¬ (x ∈ B ∪ C)) h (Or.inr (x ∈ B) (x ∈ C) hc))

-- X 类：∅ 是并的单位元 —— A ∪ ∅ = A。
theorem union_empty (α : Type) (A : Set α) :
    A ∪ ∅ = A := by
  apply Set.ext
  intro x
  constructor
  intro h
  exact Or.elim (x ∈ A) (x ∈ ∅) (x ∈ A)
    (fun (ha : x ∈ A) => ha)
    (fun (hf : x ∈ ∅) => False.elim (x ∈ A) hf)
    h
  intro ha
  exact Or.inl (x ∈ A) (x ∈ ∅) ha

-- R 类（必破 / 证伪）：(A ∪ B) \ B = A **为假**。
-- 反例取 α = Nat、A = B = Set.univ Nat：右边含 Nat.zero，左边要求
-- Nat.zero ∈ univ 且 ¬ Nat.zero ∈ univ，矛盾 —— 于是两边不相等。
-- 语句里 `\` 与 `∪` 写点名形式：`∅` 的零元记法边界之外，这是唯一
-- 能让判卷器回读该假设类型的写法（见文件头注释）。
theorem union_sdiff_univ_ne_univ :
    ¬ (Set.sdiff Nat (Set.union Nat (Set.univ Nat) (Set.univ Nat)) (Set.univ Nat)
        = Set.univ Nat) := by
  intro h
  have hmem : Nat.zero ∈
      Set.sdiff Nat (Set.union Nat (Set.univ Nat) (Set.univ Nat)) (Set.univ Nat) :=
    Eq.subst.{1} (Set Nat) (fun (X : Set Nat) => Nat.zero ∈ X)
      (Set.univ Nat)
      (Set.sdiff Nat (Set.union Nat (Set.univ Nat) (Set.univ Nat)) (Set.univ Nat))
      (Eq.symm.{1} (Set Nat)
        (Set.sdiff Nat (Set.union Nat (Set.univ Nat) (Set.univ Nat)) (Set.univ Nat))
        (Set.univ Nat) h)
      (Set.mem_univ Nat Nat.zero)
  exact And.right (Nat.zero ∈ Set.union Nat (Set.univ Nat) (Set.univ Nat))
    (¬ (Nat.zero ∈ Set.univ Nat)) hmem (Set.mem_univ Nat Nat.zero)
