import lib.Set
import lib.SUnion
import lib.Order
import lib.Rel
import lib.Extensionality

theorem demo_funext (α : Type) (β : α → Type)
    (f : (x : α) → β x) (g : (x : α) → β x) (h : ∀ (x : α), Eq.{1} (β x) (f x) (g x)) :  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
    Eq.{1} ((x : α) → β x) f g :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
  funext_spec α β f g h

theorem demo_propext (a b : Prop) (h : a ↔ b) : Eq.{1} Prop a b :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
  propext_spec a b h

theorem demo_subset_def (α : Type) (A B : Set α) :
    A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B :=
  Set.subset_def α A B

theorem mem_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) (a : α) (ha : a ∈ A) :
    a ∈ B :=
  (fun (hu : ∀ (x : α), x ∈ A → x ∈ B) => hu a ha)
    ((fun (hv : A ⊆ B ↔ ∀ (x : α), x ∈ A → x ∈ B) => Iff.mp hv h) (Set.subset_def α A B))

theorem subset_of_eq (α : Type) (A B : Set α) (h : Eq.{1} (Set α) A B) : A ⊆ B :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
  fun (a : α) (ha : a ∈ A) =>
    rel_subst_right (Set α) (fun (u : Set α) (v : Set α) => a ∈ v) A A B h ha

theorem mem_inter_left (α : Type) (A B : Set α) (a : α) (h : a ∈ (A ∩ B)) : a ∈ A :=
  And.left (a ∈ A) (a ∈ B)  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A ∩ B) ↔ a ∈ A ∧ a ∈ B) => Iff.mp hu h) (Set.mem_inter_iff a A B))

theorem mem_inter_intro (α : Type) (A B : Set α) (a : α) (ha : a ∈ A) (hb : a ∈ B) :
    a ∈ (A ∩ B) :=
  (fun (hu : a ∈ (A ∩ B) ↔ a ∈ A ∧ a ∈ B) =>
    Iff.mpr hu (And.intro (a ∈ A) (a ∈ B) ha hb)) (Set.mem_inter_iff a A B)  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）

theorem mem_union_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) (a : α)
    (hu : a ∈ (A ∪ B)) : a ∈ B :=
  Or.elim (a ∈ A) (a ∈ B) (a ∈ B)
    (fun (ha : a ∈ A) => mem_of_subset α A B h a ha)
    (fun (hb : a ∈ B) => hb)
    ((fun (hw : a ∈ (A ∪ B) ↔ a ∈ A ∨ a ∈ B) => Iff.mp hw hu) (Set.mem_union a A B))

theorem subset_antisymm (α : Type) (A B : Set α) (h1 : A ⊆ B) (h2 : B ⊆ A) :
    Eq.{1} (Set α) A B :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
  funext_spec α (fun (_ : α) => Prop) A B
    (fun (a : α) =>
      propext_spec (a ∈ A) (a ∈ B)
        (Iff.intro (a ∈ A) (a ∈ B)
          (fun (ha : a ∈ A) => mem_of_subset α A B h1 a ha)
          (fun (hb : a ∈ B) => mem_of_subset α B A h2 a hb)))

theorem inter_eq_left_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) :
    Eq.{1} (Set α) (A ∩ B) A :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
  funext_spec α (fun (_ : α) => Prop) (A ∩ B) A
    (fun (a : α) =>
      propext_spec (a ∈ (A ∩ B)) (a ∈ A)
        (Iff.intro (a ∈ (A ∩ B)) (a ∈ A)
          (fun (hc : a ∈ (A ∩ B)) => mem_inter_left α A B a hc)
          (fun (ha : a ∈ A) => mem_inter_intro α A B a ha (mem_of_subset α A B h a ha))))

theorem union_eq_right_of_subset (α : Type) (A B : Set α) (h : A ⊆ B) :
    Eq.{1} (Set α) (A ∪ B) B :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
  funext_spec α (fun (_ : α) => Prop) (A ∪ B) B
    (fun (a : α) =>
      propext_spec (a ∈ (A ∪ B)) (a ∈ B)
        (Iff.intro (a ∈ (A ∪ B)) (a ∈ B)
          (fun (hu : a ∈ (A ∪ B)) => mem_union_of_subset α A B h a hu)
          (fun (hb : a ∈ B) =>
            (fun (hw : a ∈ (A ∪ B) ↔ a ∈ A ∨ a ∈ B) =>
              Iff.mpr hw (Or.inr (a ∈ A) (a ∈ B) hb)) (Set.mem_union a A B))))  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`∩`/`∪` 是 def 头（手册边界）
