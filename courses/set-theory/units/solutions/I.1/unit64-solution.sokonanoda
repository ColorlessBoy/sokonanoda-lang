import lib.Set
import lib.SUnion
import lib.Order
import lib.Rel
import lib.Extensionality

theorem demo_funext (α : Type) (β : α → Type)
    (f : (x : α) → β x) (g : (x : α) → β x) (h : ∀ (x : α), Eq.{1} (β x) (f x) (g x)) :  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
    Eq.{1} ((x : α) → β x) f g :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
  funext_spec α β f g h

theorem demo_propext (a b : Prop) (h : a ↔ b) : Eq.{1} Prop a b :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
  propext_spec a b h

theorem demo_mem_sdiff (α : Type) (a : α) (A B : Set α) :
    a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B) :=
  Set.mem_sdiff a A B

theorem mem_of_mem_sdiff (α : Type) (A B : Set α) (a : α) (h : a ∈ (A \ B)) : a ∈ A :=
  And.left (a ∈ A) (¬ (a ∈ B))  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) => Iff.mp hu h) (Set.mem_sdiff a A B))

theorem not_mem_of_mem_sdiff (α : Type) (A B : Set α) (a : α) (h : a ∈ (A \ B)) :
    ¬ (a ∈ B) :=
  And.right (a ∈ A) (¬ (a ∈ B))  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) => Iff.mp hu h) (Set.mem_sdiff a A B))

theorem mem_sdiff_intro (α : Type) (A B : Set α) (a : α) (ha : a ∈ A) (hna : ¬ (a ∈ B)) :
    a ∈ (A \ B) :=
  (fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) =>
    Iff.mpr hu (And.intro ha hna)) (Set.mem_sdiff a A B)

theorem mem_inter_left (α : Type) (A B : Set α) (a : α) (h : a ∈ (A ∩ B)) : a ∈ A :=
  And.left (a ∈ A) (a ∈ B)  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A ∩ B) ↔ a ∈ A ∧ a ∈ B) => Iff.mp hu h) (Set.mem_inter_iff a A B))

theorem mem_inter_right (α : Type) (A B : Set α) (a : α) (h : a ∈ (A ∩ B)) : a ∈ B :=
  And.right (a ∈ A) (a ∈ B)  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A ∩ B) ↔ a ∈ A ∧ a ∈ B) => Iff.mp hu h) (Set.mem_inter_iff a A B))

theorem mem_inter_intro (α : Type) (A B : Set α) (a : α) (ha : a ∈ A) (hb : a ∈ B) :
    a ∈ (A ∩ B) :=
  (fun (hu : a ∈ (A ∩ B) ↔ a ∈ A ∧ a ∈ B) =>
    Iff.mpr hu (And.intro ha hb)) (Set.mem_inter_iff a A B)

theorem mem_inter_sdiff_iff (α : Type) (A B C : Set α) (a : α) :
    a ∈ ((A ∩ B) \ C) ↔ a ∈ ((A \ C) ∩ B) :=
  Iff.intro (a ∈ ((A ∩ B) \ C)) (a ∈ ((A \ C) ∩ B))
    (fun (h : a ∈ ((A ∩ B) \ C)) =>
      mem_inter_intro α (A \ C) B a
        (mem_sdiff_intro α A C a
          (mem_inter_left α A B a (mem_of_mem_sdiff α (A ∩ B) C a h))
          (not_mem_of_mem_sdiff α (A ∩ B) C a h))
        (mem_inter_right α A B a (mem_of_mem_sdiff α (A ∩ B) C a h)))
    (fun (h : a ∈ ((A \ C) ∩ B)) =>
      mem_sdiff_intro α (A ∩ B) C a
        (mem_inter_intro α A B a
          (mem_of_mem_sdiff α A C a (mem_inter_left α (A \ C) B a h))
          (mem_inter_right α (A \ C) B a h))
        (not_mem_of_mem_sdiff α A C a (mem_inter_left α (A \ C) B a h)))

theorem inter_sdiff_eq (α : Type) (A B C : Set α) :
    Eq.{1} (Set α) ((A ∩ B) \ C) ((A \ C) ∩ B) :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∩` 是 def 头（手册边界）
  funext_spec α (fun (_ : α) => Prop) ((A ∩ B) \ C) ((A \ C) ∩ B)
    (fun (a : α) =>
      propext_spec (a ∈ ((A ∩ B) \ C)) (a ∈ ((A \ C) ∩ B))
        (mem_inter_sdiff_iff α A B C a))
