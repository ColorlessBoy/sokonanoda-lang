import lib.Set
import lib.SUnion
import lib.Order
import lib.Rel
import lib.Extensionality

theorem demo_funext (α : Type) (β : α → Type)
    (f : (x : α) → β x) (g : (x : α) → β x) (h : ∀ (x : α), Eq.{1} (β x) (f x) (g x)) :  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
    Eq.{1} ((x : α) → β x) f g :=  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
  funext_spec α β f g h

theorem demo_propext (a b : Prop) (h : a ↔ b) : Eq.{1} Prop a b :=  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
  propext_spec a b h

theorem demo_mem_sdiff (α : Type) (a : α) (A B : Set α) :
    a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B) :=
  Set.mem_sdiff a A B

theorem mem_of_mem_sdiff (α : Type) (A B : Set α) (a : α) (h : a ∈ (A \ B)) : a ∈ A :=
  And.left (a ∈ A) (¬ (a ∈ B))  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
    ((fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) => Iff.mp hu h) (Set.mem_sdiff a A B))

theorem not_mem_of_mem_sdiff (α : Type) (A B : Set α) (a : α) (h : a ∈ (A \ B)) :
    ¬ (a ∈ B) :=
  And.right (a ∈ A) (¬ (a ∈ B))  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
    ((fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) => Iff.mp hu h) (Set.mem_sdiff a A B))

theorem not_mem_sdiff_self (α : Type) (A : Set α) (a : α) : ¬ (a ∈ (A \ A)) :=
  fun (h : a ∈ (A \ A)) => not_mem_of_mem_sdiff α A A a h (mem_of_mem_sdiff α A A a h)

theorem not_mem_inter_compl (α : Type) (A : Set α) (a : α) : ¬ (a ∈ (A ∩ (Aᶜ))) :=
  fun (h : a ∈ (A ∩ (Aᶜ))) =>
    And.right (a ∈ A) (a ∈ (Aᶜ))  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
      ((fun (hu : a ∈ (A ∩ (Aᶜ)) ↔ a ∈ A ∧ a ∈ (Aᶜ)) => Iff.mp hu h)
        (Set.mem_inter_iff a A (Aᶜ)))
      (And.left (a ∈ A) (a ∈ (Aᶜ))  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
        ((fun (hu : a ∈ (A ∩ (Aᶜ)) ↔ a ∈ A ∧ a ∈ (Aᶜ)) => Iff.mp hu h)
          (Set.mem_inter_iff a A (Aᶜ))))

theorem sdiff_empty_eq (α : Type) (A : Set α) : Eq.{1} (Set α) (A \ (∅ α)) A :=  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
  funext_spec α (fun (_ : α) => Prop) (A \ (∅ α)) A
    (fun (a : α) =>
      propext_spec (a ∈ (A \ (∅ α))) (a ∈ A)
        (Iff.intro (a ∈ (A \ (∅ α))) (a ∈ A)
          (fun (h : a ∈ (A \ (∅ α))) => mem_of_mem_sdiff α A (∅ α) a h)
          (fun (h : a ∈ A) =>
            (fun (hu : a ∈ (A \ (∅ α)) ↔ a ∈ A ∧ ¬ (a ∈ (∅ α))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
              Iff.mpr hu (And.intro (a ∈ A) (¬ (a ∈ (∅ α))) h  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
                (fun (he : a ∈ (∅ α)) => (Iff.mp (Set.mem_empty_iff_false a) he))))
              (Set.mem_sdiff a A (∅ α)))))

theorem sdiff_self_eq_empty (α : Type) (A : Set α) :
    Eq.{1} (Set α) (A \ A) (∅ α) :=  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
  funext_spec α (fun (_ : α) => Prop) (A \ A) (∅ α)
    (fun (a : α) =>
      propext_spec (a ∈ (A \ A)) (a ∈ (∅ α))
        (Iff.intro (a ∈ (A \ A)) (a ∈ (∅ α))
          (fun (h : a ∈ (A \ A)) => (False.elim (a ∈ (∅ α))) (not_mem_sdiff_self α A a h))
          (fun (h : a ∈ (∅ α)) => (False.elim (a ∈ (A \ A))) ((Iff.mp (Set.mem_empty_iff_false a)) h))))

theorem inter_compl_self_eq_empty (α : Type) (A : Set α) :
    Eq.{1} (Set α) (A ∩ (Aᶜ)) (∅ α) :=  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
  funext_spec α (fun (_ : α) => Prop) (A ∩ (Aᶜ)) (∅ α)
    (fun (a : α) =>
      propext_spec (a ∈ (A ∩ (Aᶜ))) (a ∈ (∅ α))
        (Iff.intro (a ∈ (A ∩ (Aᶜ))) (a ∈ (∅ α))
          (fun (h : a ∈ (A ∩ (Aᶜ))) => (False.elim (a ∈ (∅ α))) (not_mem_inter_compl α A a h))
          (fun (h : a ∈ (∅ α)) => (False.elim (a ∈ (A ∩ (Aᶜ)))) ((Iff.mp (Set.mem_empty_iff_false a)) h))))

theorem inter_univ_eq (α : Type) (A : Set α) : Eq.{1} (Set α) (A ∩ (Set.univ α)) A :=  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
  funext_spec α (fun (_ : α) => Prop) (A ∩ (Set.univ α)) A
    (fun (a : α) =>
      propext_spec (a ∈ (A ∩ (Set.univ α))) (a ∈ A)
        (Iff.intro (a ∈ (A ∩ (Set.univ α))) (a ∈ A)
          (fun (h : a ∈ (A ∩ (Set.univ α))) =>
            And.left (a ∈ A) (a ∈ (Set.univ α))  -- soko:notation-ok: 等式族证明项的宇宙层级 + `∈`/`\`/`∩`/`ᶜ` 是 def 头（手册明说的边界）
              ((fun (hu : a ∈ (A ∩ (Set.univ α)) ↔ a ∈ A ∧ a ∈ (Set.univ α)) => Iff.mp hu h)
                (Set.mem_inter_iff a A (Set.univ α))))
          (fun (h : a ∈ A) =>
            (fun (hu : a ∈ (A ∩ (Set.univ α)) ↔ a ∈ A ∧ a ∈ (Set.univ α)) =>
              Iff.mpr hu (And.intro h (Set.mem_univ α a)))
              (Set.mem_inter_iff a A (Set.univ α)))))
