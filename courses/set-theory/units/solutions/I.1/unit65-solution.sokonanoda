import lib.Set
import lib.SUnion
import lib.Order
import lib.Rel
import lib.Extensionality

theorem demo_funext (α : Type) (β : α → Type)
    (f : (x : α) → β x) (g : (x : α) → β x) (h : ∀ (x : α), Eq.{1} (β x) (f x) (g x)) :  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∪` 是 def 头（手册边界）
    Eq.{1} ((x : α) → β x) f g :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∪` 是 def 头（手册边界）
  funext_spec α β f g h

theorem demo_propext (a b : Prop) (h : a ↔ b) : Eq.{1} Prop a b :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∪` 是 def 头（手册边界）
  propext_spec a b h

theorem demo_mem_sdiff (α : Type) (a : α) (A B : Set α) :
    a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B) :=
  Set.mem_sdiff a A B

theorem mem_of_mem_sdiff (α : Type) (A B : Set α) (a : α) (h : a ∈ (A \ B)) : a ∈ A :=
  And.left (a ∈ A) (¬ (a ∈ B))  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∪` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) => Iff.mp hu h) (Set.mem_sdiff a A B))

theorem not_mem_of_mem_sdiff (α : Type) (A B : Set α) (a : α) (h : a ∈ (A \ B)) :
    ¬ (a ∈ B) :=
  And.right (a ∈ A) (¬ (a ∈ B))  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∪` 是 def 头（手册边界）
    ((fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) => Iff.mp hu h) (Set.mem_sdiff a A B))

theorem mem_sdiff_intro (α : Type) (A B : Set α) (a : α) (ha : a ∈ A) (hna : ¬ (a ∈ B)) :
    a ∈ (A \ B) :=
  (fun (hu : a ∈ (A \ B) ↔ a ∈ A ∧ ¬ (a ∈ B)) =>
    Iff.mpr hu (And.intro ha hna)) (Set.mem_sdiff a A B)

theorem mem_union_left (α : Type) (A B : Set α) (a : α) (ha : a ∈ A) : a ∈ (A ∪ B) :=
  (fun (hu : a ∈ (A ∪ B) ↔ a ∈ A ∨ a ∈ B) => Iff.mpr hu (Or.inl ha))
    (Set.mem_union a A B)

theorem mem_union_right (α : Type) (A B : Set α) (a : α) (hb : a ∈ B) : a ∈ (A ∪ B) :=
  (fun (hu : a ∈ (A ∪ B) ↔ a ∈ A ∨ a ∈ B) => Iff.mpr hu (Or.inr hb))
    (Set.mem_union a A B)

theorem mem_union_sdiff_iff (α : Type) (A B C : Set α) (a : α) :
    a ∈ ((B ∪ C) \ A) ↔ a ∈ ((B \ A) ∪ (C \ A)) :=
  Iff.intro (a ∈ ((B ∪ C) \ A)) (a ∈ ((B \ A) ∪ (C \ A)))
    (fun (h : a ∈ ((B ∪ C) \ A)) =>
      Or.elim (a ∈ B) (a ∈ C) (a ∈ ((B \ A) ∪ (C \ A)))
        (fun (hb : a ∈ B) => mem_union_left α (B \ A) (C \ A) a
          (mem_sdiff_intro α B A a hb (not_mem_of_mem_sdiff α (B ∪ C) A a h)))
        (fun (hc : a ∈ C) => mem_union_right α (B \ A) (C \ A) a
          (mem_sdiff_intro α C A a hc (not_mem_of_mem_sdiff α (B ∪ C) A a h)))
        ((fun (hw : a ∈ (B ∪ C) ↔ a ∈ B ∨ a ∈ C) =>
          Iff.mp hw (mem_of_mem_sdiff α (B ∪ C) A a h)) (Set.mem_union a B C)))
    (fun (h : a ∈ ((B \ A) ∪ (C \ A))) =>
      mem_sdiff_intro α (B ∪ C) A a
        (Or.elim (a ∈ (B \ A)) (a ∈ (C \ A)) (a ∈ (B ∪ C))
          (fun (h1 : a ∈ (B \ A)) => mem_union_left α B C a (mem_of_mem_sdiff α B A a h1))
          (fun (h2 : a ∈ (C \ A)) => mem_union_right α B C a (mem_of_mem_sdiff α C A a h2))
          ((fun (hw : a ∈ ((B \ A) ∪ (C \ A)) ↔ a ∈ (B \ A) ∨ a ∈ (C \ A)) => Iff.mp hw h)
            (Set.mem_union a (B \ A) (C \ A))))
        (Or.elim (a ∈ (B \ A)) (a ∈ (C \ A)) (¬ (a ∈ A))
          (fun (h1 : a ∈ (B \ A)) => not_mem_of_mem_sdiff α B A a h1)
          (fun (h2 : a ∈ (C \ A)) => not_mem_of_mem_sdiff α C A a h2)
          ((fun (hw : a ∈ ((B \ A) ∪ (C \ A)) ↔ a ∈ (B \ A) ∨ a ∈ (C \ A)) => Iff.mp hw h)
            (Set.mem_union a (B \ A) (C \ A)))))

theorem union_sdiff_distrib_eq (α : Type) (A B C : Set α) :
    Eq.{1} (Set α) ((B ∪ C) \ A) ((B \ A) ∪ (C \ A)) :=  -- soko:notation-ok: 等式族宇宙层级 + `∈`/`\`/`∪` 是 def 头（手册边界）
  funext_spec α (fun (_ : α) => Prop) ((B ∪ C) \ A) ((B \ A) ∪ (C \ A))
    (fun (a : α) =>
      propext_spec (a ∈ ((B ∪ C) \ A)) (a ∈ ((B \ A) ∪ (C \ A)))
        (mem_union_sdiff_iff α A B C a))

theorem mem_sdiff_sdiff (α : Type) (A B C : Set α) (a : α) (h : a ∈ (A \ B)) :
    a ∈ (A \ (B \ C)) :=
  mem_sdiff_intro α A (B \ C) a
    (mem_of_mem_sdiff α A B a h)
    (fun (hbc : a ∈ (B \ C)) => not_mem_of_mem_sdiff α A B a h (mem_of_mem_sdiff α B C a hbc))

theorem sdiff_sdiff_subset (α : Type) (A B C : Set α) : A \ B ⊆ A \ (B \ C) :=
  fun (a : α) (h : a ∈ (A \ B)) => mem_sdiff_sdiff α A B C a h
