-- unit03 解答钥匙（agent 专用；画布不 import 它）。
-- 靶子：Tao §3.1 后半（并/交/差 → 幂集 → 成员判定与单调性）。
-- 全部证明写成 `by` tactic 块（白名单：intro / exact / apply / assumption / rfl /
-- match / constructor / left / right / use / exfalso / cases / have / sorry）。
-- 语句一律用记法（`∈ ⊆ ∪ ∩ \ ∅ 𝒫` 与 `∧ ∨ ↔ ¬`）；**引理名照旧点名**
-- （`Or.inl`、`And.left`、`Set.mem_union`、`Eq.subst.{1} …`）——记法是连接符的糖，
-- 不是引理名的糖。
import lib.Logic
import lib.Set

-- ── 3.1 并 ───────────────────────────────────────────────────────────────
theorem subset_union_left (α : Type) (A B : Set α) : A ⊆ A ∪ B := by
  intro x
  intro hx
  exact Or.inl (A x) (B x) hx  -- soko:notation-ok: 目标经 intro 展开（非语句层）后期望类型传不到（引擎边界）

theorem subset_union_right (α : Type) (A B : Set α) : B ⊆ A ∪ B := by
  intro x
  intro hx
  exact Or.inr (A x) (B x) hx  -- soko:notation-ok: 目标经 intro 展开（非语句层）后期望类型传不到（引擎边界）

theorem union_subset_iff (α : Type) (A B C : Set α) :
    (A ∪ B ⊆ C) ↔ (A ⊆ C ∧ B ⊆ C) := by
  constructor
  intro h
  constructor
  intro x
  intro hx
  exact h x (Or.inl (A x) (B x) hx)  -- soko:notation-ok: 目标经 intro 展开（非语句层）后期望类型传不到（引擎边界）
  intro x
  intro hx
  exact h x (Or.inr (A x) (B x) hx)  -- soko:notation-ok: 目标经 intro 展开（非语句层）后期望类型传不到（引擎边界）
  intro h
  intro x
  intro hx
  exact Or.elim (A x) (B x) (C x)
    (fun (ha : A x) => And.left (A ⊆ C) (B ⊆ C) h x ha)  -- soko:notation-ok: And.left/right 续应用被误判成旧写法（引擎边界）
    (fun (hb : B x) => And.right (A ⊆ C) (B ⊆ C) h x hb)  -- soko:notation-ok: And.left/right 续应用被误判成旧写法（引擎边界）
    hx

-- ── 3.2 交 ───────────────────────────────────────────────────────────────
theorem inter_subset_left (α : Type) (A B : Set α) : A ∩ B ⊆ A := by
  intro x
  intro hx
  exact And.left hx

theorem inter_subset_right (α : Type) (A B : Set α) : A ∩ B ⊆ B := by
  intro x
  intro hx
  exact And.right hx

-- 目标 `x ∈ B ∩ C` 的头是 `Set.inter`（不是 `And`），所以这里不用 `constructor`，
-- 直接把一对证据交给 `And.intro`。
theorem subset_inter (α : Type) (A B C : Set α)
    (h1 : A ⊆ B) (h2 : A ⊆ C) : A ⊆ B ∩ C := by
  intro x
  intro hx
  exact And.intro (h1 x hx) (h2 x hx)

-- ∩ 的泛性质（练习 3 的对偶）：→ 把 h x hx : B x ∧ C x 劈成两条包含；
-- ← 把一对包含在同一 x hx 上取出来，再装回一对证据。
theorem subset_inter_iff (α : Type) (A B C : Set α) :
    (A ⊆ B ∩ C) ↔ (A ⊆ B ∧ A ⊆ C) := by
  constructor
  intro h
  constructor
  intro x
  intro hx
  exact And.left (h x hx)
  intro x
  intro hx
  exact And.right (h x hx)
  intro h
  intro x
  intro hx
  exact And.intro
    (And.left (A ⊆ B) (A ⊆ C) h x hx)  -- soko:notation-ok: And.left/right 续应用被误判成旧写法（引擎边界）
    (And.right (A ⊆ B) (A ⊆ C) h x hx)  -- soko:notation-ok: And.left/right 续应用被误判成旧写法（引擎边界）

-- ── 3.3 差 ───────────────────────────────────────────────────────────────
theorem sdiff_subset (α : Type) (A B : Set α) : A \ B ⊆ A := by
  intro x
  intro hx
  exact And.left hx

-- ── 3.4 幂集单调 ─────────────────────────────────────────────────────────
-- `𝒫 A ⊆ 𝒫 B` 的成员层要**两层**定义展开才到 `∀`（`Set.mem` → `Set.powerset`
-- → `Set.subset`），而 `intro` 只展开一层；所以内层那条包含整条交给 `exact`
-- 一次判定：`Iff.mpr` 把 `X ∈ 𝒫 B` 换成 `X ⊆ B`，lambda 逐元素把证据经 `h` 送一程。
theorem powerset_mono (α : Type) (A B : Set α) (h : A ⊆ B) :
    𝒫 A ⊆ 𝒫 B := by
  exact fun (X : Set α) => fun (hX : X ∈ 𝒫 A) =>
    Iff.mpr (Set.mem_powerset_iff α B X)
      (fun (x : α) => fun (hx : X x) => h x (hX x hx))

-- ── 3.5 D 类 ─────────────────────────────────────────────────────────────

-- 反例：A = univ、B = empty（α 非空时的最小反例）；原命题的否定。
theorem union_subset_inter_false (α : Type) (a : α) :
    ¬ ((Set.univ α ∪ ∅) ⊆ (Set.univ α ∩ ∅)) := by
  intro hsub
  exact And.right
    (hsub a (Or.inl (a ∈ Set.univ α) (a ∈ ∅) (Set.mem_univ α a)))  -- soko:notation-ok: 目标经 intro 展开（非语句层）后期望类型传不到（引擎边界）

-- 命题甲为真：A ∈ 𝒫 A（展开即 A ⊆ A）；命题乙 A ⊆ 𝒫 A 连类型都不对（见画布注释）。
theorem powerset_self_mem (α : Type) (A : Set α) : A ∈ 𝒫 A := by
  have hAA : A ⊆ A := by
    intro x
    intro hx
    exact hx
  exact Iff.mpr (Set.mem_powerset_iff α A A) hAA
