import lib.Set
import lib.Rel
import lib.Order

theorem demo_em (P : Prop) : P ∨ ¬ P :=
  Classical.em P

theorem demo_byContradiction (P : Prop) (h : ¬ P → False) : P :=
  Classical.byContradiction P h

theorem demo_mem_sdiff (α : Type) (a : α) (A : Set α) (B : Set α) :
    a ∈ (A \ B) ↔ (a ∈ A ∧ ¬ (a ∈ B)) :=
  Set.mem_sdiff a A B

theorem not_not_elim (P : Prop) (h : ¬ ¬ P) : P :=
  Classical.byContradiction P h

theorem em_cases (P : Prop) (Q : Prop) (h1 : P → Q) (h2 : ¬ P → Q) : Q :=
  Or.elim h1 h2 (Classical.em P)

theorem mem_sdiff_of_mem_not_mem (α : Type) (x : α) (A : Set α) (B : Set α)
    (hx : x ∈ A) (hnb : ¬ (x ∈ B)) : x ∈ (A \ B) :=
  (fun (hm : x ∈ (A \ B) ↔ (x ∈ A ∧ ¬ (x ∈ B))) =>
    Iff.mpr hm (And.intro hx hnb)) (Set.mem_sdiff x A B)

theorem not_mem_of_eq_empty (α : Type) (x : α) (C : Set α) (h : C = ∅ α)
    (hx : x ∈ C) : False :=
  (fun (hu : x ∈ ∅ α ↔ False) => Iff.mp hu (Eq.subst.{1} (Set α) (fun (D : Set α) => x ∈ D)
    C (∅ α) h hx)) (Set.mem_empty_iff_false α x)

theorem subset_of_sdiff_empty (α : Type) (A : Set α) (B : Set α) (h : A \ B = ∅ α) :
    A ⊆ B :=
  fun (x : α) (hx : x ∈ A) =>
    em_cases (x ∈ B) (x ∈ B) (fun (hb : x ∈ B) => hb)
      (fun (hnb : ¬ (x ∈ B)) =>
        False.elim (x ∈ B)
          (not_mem_of_eq_empty α x (A \ B) h (mem_sdiff_of_mem_not_mem α x A B hx hnb)))

theorem not_forall_imp_exists (α : Type) (P : α → Prop) (h : ¬ (∀ (x : α), ¬ (P x))) :
    ∃ (x : α), P x :=
  Classical.byContradiction (∃ (x : α), P x)
    (fun (hne : ¬ (∃ (x : α), P x)) =>
      h (fun (x : α) (hx : P x) => hne (Exists.intro α P x hx)))
