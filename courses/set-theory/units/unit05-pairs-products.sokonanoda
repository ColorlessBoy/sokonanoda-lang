-- ==========================================================================
-- unit05-pairs-products.sokonanoda —— 卷 I 单元⑤ 序对与笛卡尔积
--
-- 靶子：Tao《Analysis I》§3.5（有序对与笛卡尔积）。Kuratowski 编码 (a,b) := {{a},{a,b}}
-- 在本单元只作**阅读题**（5.6）；我们用的序对是语言原语 inductive Prod。
--
-- ── 本单元只允许用什么 ──────────────────────────────────────────────────
--   · import lib.Logic / lib.Set / lib.Prod；
--   · 记法**不用自己声明**（随 import 生效）：`∈ ⊆ ∅` 来自 lib/Set，集合积记法
--     `×ˢ` 的目标 `Set.prod` 是**本文件 5.2 给出的定义**，所以它只在那一行
--     **之后**才可用；连接符 `∧ ∨ ↔ ¬`、箭头 `→`、等号 `=` 与不等号 `≠` 是
--     **语言内建**；集合字面量 `{a}` / `{a, b}`（1–2 个元素）也是内建糖；
--   · 序对的全部词汇来自 lib/Prod：类型 Prod、构造子 prod_mk、投影 Prod.fst / Prod.snd，
--     以及"投影算在构造子上"的展开引理 Prod.fst_mk / Prod.snd_mk / Prod.fst_snd_mk
--     （L2 层，证明是 rfl 级或一行，直接点名用，不用自己写）；
--   · 逻辑库：And / Or / Iff / Eq / Not 及其引理；集合库：Set.* 与公理 Set.ext。
--     **引理名照旧点名写**（`Or.inl`、`And.left`、`Eq.subst.{1}`、`Set.mem_singleton_self`…）
--     ——记法是**连接符**的糖，不是引理名的糖；
--   · tactic（白名单）：intro / exact / apply / assumption / rfl / match /
--     constructor / left / right / use / exfalso / cases / have / sorry
--     ——没有 rw / obtain / change / simp / induction / ⟨a, b⟩ / ·；
--     练习一律 `:= by` + 缩进两格的 `sorry`。
--   · 本文件**给出**的两个定义：def Set.prod（笛卡尔积）、def Set.graph（函数图）
--     ——它们是本单元新引入的词汇，不用你写。
--
-- ── 本单元不用 ─────────────────────────────────────────────────────────
--   单射 / 满射 / 双射的正式定义（单元⑦ 与 ⑨ 才讲）、选择公理、证明无关性。
--
-- ── 记法提醒 ────────────────────────────────────────────────────────────
--   `s ×ˢ t` 就是 Set.prod A B s t；序对**没有**字面量记法，`(a, b)` 仍写
--   prod_mk A B a b；命题里的等式直接写 `=`（宇宙层级由判卷器按操作数类型解），
--   只有**引理名**才显式写层级：Eq.subst.{1} / Eq.refl.{1} / Eq.symm.{1}。
-- ==========================================================================
import lib.Logic
import lib.Set
import lib.Prod

-- ─────────────────────────────────────────────────────────────
-- 5.0 序对是什么：lib/Prod 已经给好
--
--     inductive Prod (A B : Type)                -- 类型：A × B
--     ctor prod_mk (a : A) (b : B) : Prod A B    -- 构造子：(a, b)
--     def Prod.fst (A B : Type) (p : Prod A B) : A
--     def Prod.snd (A B : Type) (p : Prod A B) : B
--
-- 构造子叫 `prod_mk` 而不是 `mk`：本语言没有命名空间（台账 G-02），构造子是裸名、
-- 且全项目唯一；官方 Lean 4 / Mathlib 里它叫 `Prod.mk`。
-- 序对的**全部**信息就是这两个投影——所以"两个序对相等"这件事，只能靠投影来拆。
-- ─────────────────────────────────────────────────────────────

-- 演示 1（已写好）：库自检 —— 两个投影算在构造子上都还原（这是 iota 计算，不是数学内容）。
theorem demo_fst_snd_mk (A B : Type) (a : A) (b : B) :
    Prod.fst A B (prod_mk A B a b) = a ∧ Prod.snd A B (prod_mk A B a b) = b := by
  exact Prod.fst_snd_mk A B a b

-- ─────────────────────────────────────────────────────────────
-- 5.1 序对唯一性（配对定理）：序对唯一决定它的两个坐标
--
-- 这是 Tao §3.5 的第一条：`(a,b) = (a',b')` 当且仅当 `a = a'` 且 `b = b'`。
-- 没有它，序对就只是个"记号"，`Prod.fst` / `Prod.snd` 也拿不回来东西。
-- 第 3 题的证明只有一句话可做：把等式沿两个投影搬过去（投影就是取坐标的唯一动作）。
-- ─────────────────────────────────────────────────────────────

-- 练习 1（T 类）：第一个投影算在构造子上。
-- soko:hint 思路：这条是 lib/Prod 里现成的展开引理，照名字点名即可。
-- soko:hint 目标形态：目标就是 `Prod.fst A B (prod_mk A B a b) = a`，不需要 intro。
-- soko:hint 关键件：lib/Prod 的 `Prod.fst_mk` 正是这个形状（A B a b 四个参数按序喂）。
theorem prod_fst_mk (A B : Type) (a : A) (b : B) :
    Prod.fst A B (prod_mk A B a b) = a := by
  sorry

-- 练习 2（T 类）：第二个投影算在构造子上。
-- soko:hint 思路：与第 1 题同款，换成第二个投影。
-- soko:hint 目标形态：`Prod.snd A B (prod_mk A B a b) = b`，不需要 intro。
-- soko:hint 关键件：lib/Prod 的 `Prod.snd_mk`（A B a b 四个参数按序喂）。
theorem prod_snd_mk (A B : Type) (a : A) (b : B) :
    Prod.snd A B (prod_mk A B a b) = b := by
  sorry

-- 练习 3（L 类）：**配对定理** —— 两个序对相等推出两个坐标分别相等。
-- soko:hint 思路：序对没有别的结构可用；把等式沿两个投影各搬一次，就得到两个坐标的等式。
-- soko:hint 目标形态：intro 之后手里是 `h : prod_mk A B a b = prod_mk A B a1 b1`，目标是 `a = a1 ∧ b = b1`。
-- soko:hint 关键件：`constructor` 拆开 `∧`；两个分支都用 `Eq.subst`，motive 分别是"第一个投影等于什么"与"第二个投影等于什么"；搬完两边会归约成同一个东西，所以起点是 `Eq.refl`；`Prod.fst_mk` / `Prod.snd_mk` 说明归约的结果长什么样。
theorem prod_mk_inj (A B : Type) (a a1 : A) (b b1 : B) :
    prod_mk A B a b = prod_mk A B a1 b1 → a = a1 ∧ b = b1 := by
  sorry

-- 练习 4（L 类）：配对定理的完整形态（"当且仅当"）。
-- soko:hint 思路：`↔` 是两个方向：→ 就是第 3 题；← 从两个坐标的等式反推出序对的等式。
-- soko:hint 目标形态：`(prod_mk A B a b = prod_mk A B a1 b1) ↔ (a = a1 ∧ b = b1)`。
-- soko:hint 关键件：`constructor` 拆 `↔`；→ 用 prod_mk_inj（第 3 题）；← 对 `∧` 的两半各做一次 `Eq.subst`（先把第一个坐标换掉、再换第二个），起点是一条 rfl 级的等式（`Eq.refl`）。
theorem prod_mk_eq_iff (A B : Type) (a a1 : A) (b b1 : B) :
    (prod_mk A B a b = prod_mk A B a1 b1) ↔ (a = a1 ∧ b = b1) := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 5.2 笛卡尔积：s ×ˢ t 是 Prod A B 上的一个谓词
--
-- 定义给出（照抄 Mathlib 的 `Set.prod`，定义体点名写）：
--     def Set.prod (A B : Type) (s : Set A) (t : Set B) : Set (Prod A B) :=
--       fun (p : Prod A B) => And (s (Prod.fst A B p)) (t (Prod.snd A B p))
-- 注意返回值是 Set (Prod A B) —— 也就是谓词 Prod A B -> Prop。
-- 记法 `s ×ˢ t` 的目标就是它（由 lib/Set 声明，**在这一行之后**才可用）。
-- 元素 `prod_mk A B a b` 属于 `s ×ˢ t`，展开后正好是"两个坐标分别满足 s 与 t"。
-- ─────────────────────────────────────────────────────────────

def Set.prod (A B : Type) (s : Set A) (t : Set B) : Set (Prod A B) :=
  fun (p : Prod A B) => (s (Prod.fst A B p)) ∧ (t (Prod.snd A B p))

-- 练习 5（T 类）：s ×ˢ t 的成员刻画（Tao §3.5 的第二条）。
-- soko:hint 思路：Set.prod 的定义就是"两个坐标分别满足 s 与 t"，两边定义上相等。
-- soko:hint 目标形态：`p ∈ s ×ˢ t ↔ Prod.fst A B p ∈ s ∧ Prod.snd A B p ∈ t`。
-- soko:hint 关键件：`constructor` 拆 `↔`，两个方向都是恒等函数（`∈` 与 `×ˢ` 展开即可），不需要任何引理。
theorem mem_prod_iff (A B : Type) (s : Set A) (t : Set B) (p : Prod A B) :
    p ∈ s ×ˢ t ↔ Prod.fst A B p ∈ s ∧ Prod.snd A B p ∈ t := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 5.3 D 类：A × B = B × A 吗？
--
-- 先看"等式"本身：`s ×ˢ t : Set (Prod A B)`，而 `t ×ˢ s : Set (Prod B A)`。
-- 两个类型不同 —— 只要 A 与 B 不是同一个类型，"A × B = B × A" 这句话**根本写不出来**；
-- 换成数学语言：需要先有一个 A × B 到 B × A 的**交换双射**
--     fun (p : Prod A B) => prod_mk B A (Prod.snd A B p) (Prod.fst A B p)
-- （双射的正式定义在单元⑦ 与 ⑨；这里只点名，不证。）
--
-- 退化情形（这时它才成立）：
--   · A 与 B 取成同一个类型、并且 s = t：两侧是同一个表达式，等式自明；
--   · s 或 t 是空集：两侧都是空集（用上面那个交换映射 + 空集成员刻画说明，本单元不证）。
--
-- 但即使把类型取成同一个，s ≠ t 时两侧一般也不相等 —— 底下的原因是序对**连交换都做不到**：
-- 只有 a = b 时 `prod_mk A A a b` 与 `prod_mk A A b a` 才是同一个序对。下面的练习把这个反例证出来。
-- （设计判断：有序对与 Kuratowski 编码没有实证研究支撑，此处不作"研究表明"的断言。）
-- ─────────────────────────────────────────────────────────────

-- 练习 6（D 类）：判断 `A × B = B × A` 并给出反例。
-- soko:hint 思路：判"假"必须给反例：同一个类型上取 s = {a}、t = {b}，序对 `prod_mk A A a b` 只在 `{a} ×ˢ {b}` 里。
-- soko:hint 目标形态：目标是到 False 的箭头（`≠` 展开后就是）；intro 之后手里有两条集合相等的等式 `e : {a} ×ˢ {b} = {b} ×ˢ {a}`，目标是 False（前提里还有 `h : a ≠ b` 备用）。
-- soko:hint 关键件：先用 `And.intro` 与 `Set.mem_singleton_self` 造出 `prod_mk A A a b ∈ {a} ×ˢ {b}`；再用 `Eq.subst`（motive 是"这个序对落在哪张集合里"）沿 `e` 搬到 `{b} ×ˢ {a}` 上 —— 搬完它的类型就是 `a = b ∧ b = a`，用 `And.left` 取出来交给 `h`。
theorem prod_set_swap_ne (A : Type) (a b : A) (h : a ≠ b) :
    {a} ×ˢ {b} ≠ {b} ×ˢ {a} := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 5.4 函数图
--
-- 函数 f : A -> B 的**图**是 A × B 的子集：
--     def Set.graph (A B : Type) (f : A -> B) : Set (Prod A B) :=
--       fun (p : Prod A B) => Eq.{1} B (f (Prod.fst A B p)) (Prod.snd A B p)
-- 读法："第二坐标就是函数在第一坐标处的值"。单元⑦ 会用它把函数看成关系；
-- 现在只要会算它的成员：把 p 写成构造子，两个投影都会归约。
-- ─────────────────────────────────────────────────────────────

def Set.graph (A B : Type) (f : A → B) : Set (Prod A B) :=
  fun (p : Prod A B) => Eq.{1} B (f (Prod.fst A B p)) (Prod.snd A B p)

-- 演示 2（已写好）：图的成员刻画 —— `prod_mk A B a b` 在图里当且仅当 `f a = b`。
-- 两边在定义展开后是同一个命题（投影算在构造子上），所以 `↔` 的两个方向都是恒等函数。
theorem demo_graph_mem (A B : Type) (f : A → B) (a : A) (b : B) :
    prod_mk A B a b ∈ Set.graph A B f ↔ f a = b := by
  constructor
  intro h
  exact h
  intro h
  exact h

-- ─────────────────────────────────────────────────────────────
-- 5.5 演示 3（已写好）：无序配对的成员刻画
--
-- 下面 5.6 要读 Kuratowski 编码，读之前先把 `{a, b}` 的成员判定备好
-- （lib/Set 里 `Set.pair` 的定义就是 `Or (x = a) (x = b)`，缺一条展开引理）。
-- ─────────────────────────────────────────────────────────────

theorem demo_mem_pair (α : Type) (x a b : α) :
    x ∈ {a, b} ↔ x = a ∨ x = b := by
  constructor
  intro h
  exact h
  intro h
  exact h

-- ─────────────────────────────────────────────────────────────
-- 5.6 阅读：Kuratowski 编码（Tao 习题 3.5.1）
--
-- 不用原语也能把有序对做成集合，定义是
--     (a, b) := {{a}, {a, b}}
-- 写成我们的语言（集合字面量）就是
--     {{a}, {a, b}}      -- : Set (Set α)
-- 读法：**两层**。第一层 {a} 单独把第一个坐标记下来，第二层 {a, b} 把两个坐标都带上；
-- 由于 {a} 与 {a, b} 一般不相等，"谁在前"就能从集合里读回来。
--
-- 问：这样的编码要"够用"，哪条性质是必须的？
-- 答：**配对映射的单射性** —— 编码必须把"不同的坐标组合"送到不同的集合，否则
--     (a,b) = (a',b') 推不出 a = a' ∧ b = b'，序对就丢信息了。我们原语版本的这条性质
--     正是 5.1 的 prod_mk_inj；Kuratowski 编码要证的是
--     {{a},{a,b}} = {{a'},{a',b'}} → a = a' ∧ b = b'（即 Tao 习题 3.5.1，可自行阅读）。
--     顺带一句反面：无序配对 {a,b} **不够用** —— 它只记下"有哪些元素"，不记顺序。
--
-- 下面这题把编码最微妙的一幕读出来：两个坐标相同时，第二层塌缩进第一层。
-- ─────────────────────────────────────────────────────────────

-- 练习 7（R 类）：读 Kuratowski 编码 —— a = b 时 {{a},{a,b}} 塌缩成 {{a}}。
-- soko:hint 思路：编码是"两层集合"；a = b 时第二层 {a, b} 与第一层 {a} 重合，于是整个编码塌缩成 {{a}}。
-- soko:hint 目标形态：目标是集合层的等式 `{{a}, {a, b}} = {{a}}`（外层 `{ }` 装的是集合，里层的 `{a}` / `{a, b}` 才是元素）；套路是 `Set.ext`，再对每个 `x : Set α` 证 `↔` —— 展开后 `x ∈ {{a}, {a, b}}` 就是 `x = {a} ∨ x = {a, b}`。
-- soko:hint 关键件：`apply Set.ext (Set α)`（外层集合的元素类型是 `Set α`，`Set.ext` 的类型参数要显式写出来）+ `constructor` 拆 `↔`；左到右对 `∨` 分情况（`cases`，臂体包在 `have … := by …` 里——`cases` 组装出的是 `match`，它需要一处**有类型标注**的位置），其中 `x = {a, b}` 那一支再用一次 `Set.ext`（把 `{a, b}` 与 `{a}` 逐点比较），搬 `x = b` 用的是 `h` 的对称版本 `Eq.symm`。
theorem kura_degenerate (α : Type) (a b : α) (h : a = b) :
    {{a}, {a, b}} = {{a}} := by
  sorry
