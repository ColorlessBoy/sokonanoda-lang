-- ==========================================================================
-- unit03-union-inter-powerset.sokonanoda —— 卷 I 单元③ 并、交、差与幂集
--
-- 靶子：Tao《Analysis I》§3.1 后半。概念顺序：三个二元运算（并/交/差分别用
-- Or / And / Not 定义）→ 幂集（定义为"子集谓词"）→ 成员判定与单调性。
-- 题库参照 MIL 4.1 与 FM2024 Sheet1（A ⊆ A ∪ B、A ∩ B ⊆ A、
-- A ⊆ B → A ⊆ C → A ⊆ B ∩ C 同款）。
--
-- 本单元只允许用什么（逐步解锁，见 docs/design/set-theory-syllabus.md §2）：
--   · 证明：一律 `by` tactic 块，白名单**只有**
--       intro / exact / apply / assumption / rfl / match / constructor /
--       left / right / use / exfalso / cases / have / sorry
--     ——**没有** rw / obtain / change / simp / induction / calc / rintro，
--     也没有匿名构造子 ⟨a, b⟩ 与 focus 点 `·`；
--   · 语句一律写**记法**：`x ∈ A` · `A ⊆ B` · `A ∪ B` · `A ∩ B` · `A \ B` ·
--     `∅` · `𝒫 A`，集合字面量 `{a}` / `{a, b}`；逻辑连接符 `∧ ∨ ↔ ¬` 与
--     `→ = ≠` 是**语言内建**，任何文件零声明可用；
--   · 记法**由 lib/Set 随 import 带来**（`infix` / `notation` 写在
--     lib/Set.sokonanoda 里）：本文件一条记法声明都不写——同一个符号
--     全课程只能声明一次；
--   · 记法只是**连接符的糖**，不是引理名的糖：引理照旧点名写——
--       Or.inl / Or.inr / Or.elim / And.intro / And.left / And.right /
--       Iff.intro / Iff.mp / Iff.mpr / Set.ext；
--   · 库里已备好、直接用（lib.Logic + lib.Set）：
--       True / True.intro / False / False.elim / Not / absurd /
--       And / And.intro / And.left / And.right / And.elim /
--       Or（构造子是**点号名** Or.inl / Or.inr）/ Or.elim /
--       Iff / Iff.intro / Iff.mp / Iff.mpr / Iff.refl / Iff.symm / Iff.trans /
--       Eq.symm / Eq.trans / congrArg / Eq.subst（`Eq.*` 是**证明项**：仍写显式宇宙）/
--       Set 与集合记法 `∈` `⊆` `∪` `∩` `\` `∅` `𝒫` `ᶜ` `{a}` `{a, b}`、
--       `Set.univ`（无记法，写 `Set.univ α`）、公理 Set.ext、
--       以及展开引理 Set.subset_def / Set.mem_empty_iff_false / Set.notMem_empty /
--       Set.mem_univ / Set.mem_singleton_iff / Set.mem_union / Set.mem_inter_iff /
--       Set.mem_sdiff / Set.mem_powerset_iff；
--   · 只允许引用**前面已经出现**的声明（声明顺序 = 依赖顺序）。
-- ==========================================================================
import lib.Logic
import lib.Set

-- ─────────────────────────────────────────────────────────────
-- 3.0 成员判定（演示，已写好）：运算与幂集"里面装的是什么"
--
-- 这一层是"定义展开"（L2，没有数学内容），所以直接交给你；练习从 3.1 起。
-- 三条演示都写成 `by` 块：目标用记法，证明体点名交出手里那条成员判定引理。
-- 差的成员判定 Set.mem_sdiff 形状相同，留给练习 8 自己展开着用。
-- ─────────────────────────────────────────────────────────────

-- 演示：x ∈ A ∪ B 当且仅当 x ∈ A 或 x ∈ B。
theorem demo_mem_union (α : Type) (a : α) (A B : Set α) :
    (a ∈ A ∪ B) ↔ (a ∈ A ∨ a ∈ B) := by
  exact Set.mem_union α a A B

-- 演示：x ∈ A ∩ B 当且仅当 x ∈ A 且 x ∈ B。
theorem demo_mem_inter (α : Type) (a : α) (A B : Set α) :
    (a ∈ A ∩ B) ↔ (a ∈ A ∧ a ∈ B) := by
  exact Set.mem_inter_iff α a A B

-- 演示：X ∈ 𝒫 A 当且仅当 X ⊆ A（注意 X 与 A 同为 Set α，而 𝒫 A 是 Set (Set α)）。
theorem demo_mem_powerset (α : Type) (A B : Set α) :
    (B ∈ 𝒫 A) ↔ (B ⊆ A) := by
  exact Set.mem_powerset_iff α A B

-- 演示（记法即糖）：与上一条**同一个命题**，这次用 `constructor` 把两个方向
-- 拆开、`Iff.mp` / `Iff.mpr` 各交一次——说明 lib/Set 里**点名写下的引理**
-- 直接适用于记法写下的目标（记法只是糖）。前缀记法 `prefix:100 " 𝒫 " => Set.powerset` 住在
-- `lib/Set.sokonanoda` 里，随 `import lib.Set` 带进来：**本文件不重声明任何
-- 记法**（同一个符号全课程只能声明一次）。前导类型参数 `α` 由记法路径自己从
-- 操作数解出（`A : Set α`）；点名调用则要写全前面的类型参数。
-- 写成 `example`（与单元⑧ 的"演示 8"同款）：演示不该往单元里塞具名声明，
-- 课程门禁的 `decl.checked` 计数因此**一个都不动**（记法本身也不是声明，N6）。
example (α : Type) (A B : Set α) :
    (B ∈ 𝒫 A) ↔ (B ⊆ A) := by
  constructor
  intro h
  exact Iff.mp (Set.mem_powerset_iff α A B) h
  intro h
  exact Iff.mpr (Set.mem_powerset_iff α A B) h

-- ─────────────────────────────────────────────────────────────
-- 3.1 并：两个"塞进去"的包含，以及 ∪ 的**泛性质**（A ∪ B 是最小的公共上界）
-- ─────────────────────────────────────────────────────────────

-- 练习 1（T 类）：左项被并包含。
-- soko:hint 思路：目标是全称命题——intro 一个元素 x 与"x ∈ A"，要交出的结论是"或"。
-- soko:hint 目标形态：A ⊆ A ∪ B，展开后是 ∀ (x : α), x ∈ A → x ∈ A ∪ B。
-- soko:hint 关键件：Or 的构造子是点号名 Or.inl / Or.inr；左项走 Or.inl，把证据本身喂给它。
theorem subset_union_left (α : Type) (A B : Set α) : A ⊆ A ∪ B := by
  sorry

-- 练习 2（T 类）：右项被并包含（与练习 1 对称，换一支构造子）。
-- soko:hint 思路：与练习 1 同形，只是证据要放进"或"的右边。
-- soko:hint 目标形态：B ⊆ A ∪ B，展开后是 ∀ (x : α), x ∈ B → x ∈ A ∪ B。
-- soko:hint 关键件：Or.inr，把手里那条 `x ∈ B` 的证据喂给它。
theorem subset_union_right (α : Type) (A B : Set α) : B ⊆ A ∪ B := by
  sorry

-- 练习 3（L 类）：并的**泛性质**——A ∪ B ⊆ C 当且仅当 A ⊆ C 且 B ⊆ C。
-- soko:hint 思路：两个方向分开做——→ 把 h 分别用在"从 A 来"与"从 B 来"的元素上；← 手里是一对包含，对 x ∈ A ∪ B 分情况。
-- soko:hint 目标形态：(A ∪ B ⊆ C) ↔ (A ⊆ C ∧ B ⊆ C)；→ 的目标是一个 ∧（两条都是全称），← 的目标是 ∀ (x : α), x ∈ A ∪ B → x ∈ C。
-- soko:hint 关键件：→ 用 And.intro，两支分别把 Or.inl / Or.inr 造出的证据喂给 h；← 用 Or.elim，两个包含用 And.left / And.right 取出。
theorem union_subset_iff (α : Type) (A B C : Set α) :
    (A ∪ B ⊆ C) ↔ (A ⊆ C ∧ B ⊆ C) := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 3.2 交：与 3.1 恰好对偶（两条包含从 ∩ 出来，一条包含进 ∩，外加 ∩ 的泛性质）
-- ─────────────────────────────────────────────────────────────

-- 练习 4（T 类）：交是左项的子集。
-- soko:hint 思路：x ∈ A ∩ B 是"一对证据"，目标只要其中左边那一半。
-- soko:hint 目标形态：A ∩ B ⊆ A，展开后是 ∀ (x : α), x ∈ A ∩ B → x ∈ A。
-- soko:hint 关键件：成员判定 Set.mem_inter_iff 说 x ∈ A ∩ B 展开就是 ∧；用 And.left 取前半。
theorem inter_subset_left (α : Type) (A B : Set α) : A ∩ B ⊆ A := by
  sorry

-- 练习 5（T 类）：交是右项的子集。
-- soko:hint 思路：与练习 4 同形，取"一对证据"里的另一半。
-- soko:hint 目标形态：A ∩ B ⊆ B，展开后是 ∀ (x : α), x ∈ A ∩ B → x ∈ B。
-- soko:hint 关键件：用 And.right 取后半。
theorem inter_subset_right (α : Type) (A B : Set α) : A ∩ B ⊆ B := by
  sorry

-- 练习 6（L 类）：两条包含给出到交的包含（**练习 4/5 的逆向**）。
-- soko:hint 思路：目标是"且"——分别向两条假设要证据，再拼起来。
-- soko:hint 目标形态：A ⊆ B ∩ C，展开后是 ∀ (x : α), x ∈ A → x ∈ B ∩ C。
-- soko:hint 关键件：h1 x hx : x ∈ B 与 h2 x hx : x ∈ C，交给 And.intro 拼起来。
theorem subset_inter (α : Type) (A B C : Set α)
    (h1 : A ⊆ B) (h2 : A ⊆ C) : A ⊆ B ∩ C := by
  sorry

-- 练习 7（L 类）：∩ 的**泛性质**——练习 3 在交这边的对偶：A ⊆ B ∩ C 当且仅当
-- A ⊆ B 且 A ⊆ C。（练习 6 正是这条的 ← 方向：拿到一对包含就能造出到交的包含。）
-- soko:hint 思路：两个方向分开——→ 把"整条包含"按交的两个坐标劈成两条包含；← 把一对包含合成一条"落进交里"的包含。
-- soko:hint 目标形态：(A ⊆ B ∩ C) ↔ (A ⊆ B ∧ A ⊆ C)；→ 的目标是一个 ∧（两条都是全称），← 的目标是 ∀ (x : α), x ∈ A → x ∈ B ∩ C。
-- soko:hint 关键件：→ 任给 x 与 hx : x ∈ A：h x hx 给出的是一对证据（成员判定 Set.mem_inter_iff 说 x ∈ B ∩ C 展开就是 ∧），And.left / And.right 各取一半交出去；← 两条包含用 And.left h / And.right h 取出，喂同一个 x hx 之后交给 And.intro 装回一对。
theorem subset_inter_iff (α : Type) (A B C : Set α) :
    (A ⊆ B ∩ C) ↔ (A ⊆ B ∧ A ⊆ C) := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 3.3 差：A \ B 是 A 与"B 的补"的交，所以它当然落在 A 里
-- ─────────────────────────────────────────────────────────────

-- 练习 8（T 类）：差是左项的子集。
-- soko:hint 思路：x ∈ A \ B 也是"且"（x ∈ A 的证据 + x ∉ B 的否证），目标只要前半。
-- soko:hint 目标形态：A \ B ⊆ A，展开后是 ∀ (x : α), x ∈ A \ B → x ∈ A。
-- soko:hint 关键件：Set.mem_sdiff α x A B 是这一层的成员判定，展开后是一对证据（`x ∈ A` 与 `¬ (x ∈ B)`），用 And.left 取前半。
theorem sdiff_subset (α : Type) (A B : Set α) : A \ B ⊆ A := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 3.4 幂集：𝒫 关于 ⊆ **单调**（幂集元素是上一层类型的集合，注意层数）
-- ─────────────────────────────────────────────────────────────

-- 练习 9（T 类）：A ⊆ B 推出 𝒫 A ⊆ 𝒫 B。
-- soko:hint 思路：𝒫 A 的元素是"A 的子集"；要证 𝒫 A ⊆ 𝒫 B，就是任给 X ⊆ A 去证 X ⊆ B——逐元素把 X 里的证据经 A ⊆ B 送一程。
-- soko:hint 目标形态：𝒫 A ⊆ 𝒫 B；内层展开是 ∀ (X : Set α), X ⊆ A → X ⊆ B，再展开是 ∀ (x : α), x ∈ X → x ∈ B，手里有 h : A ⊆ B。
-- soko:hint 关键件：Set.mem_powerset_iff（成员判定，**第一个参数是"大集合"**）把两边的"X ∈ 𝒫 ?"换成包含，Iff.mp / Iff.mpr 各走一个方向；最后一步用 h x。注意 intro 只把目标展开一层（`∈` → `𝒫`），所以内层包含要靠这条引理换出来。
theorem powerset_mono (α : Type) (A B : Set α) (h : A ⊆ B) :
    𝒫 A ⊆ 𝒫 B := by
  sorry

-- ─────────────────────────────────────────────────────────────
-- 3.5 D 类：真假要自己判——两条都**不能**按字面写成 theorem
-- ─────────────────────────────────────────────────────────────

-- 练习 10（D 类）：判断真假，假的给出反例。
--
--   命题："(A ∪ B) ⊆ (A ∩ B)"（也就是 3.1/3.2 那两条包含的**逆**）。
--   判断：**假**。反例：取 A = 全集、B = 空集——只要 α 里有一个元素 a，
--   它就在 A ∪ B 里，却不在 A ∩ B 里。
--   下面把这条反例写成"原命题的否定"：假命题本身不能当 theorem 的靶子
--   （那样只会留下一个永远填不上的 sorry）。
-- soko:hint 思路：否定就是一个箭头——intro 假设 hsub（那条包含），目标是 False。
-- soko:hint 目标形态：¬ ((Set.univ α ∪ ∅) ⊆ (Set.univ α ∩ ∅))，展开之后目标是 False，手里有 hsub : (Set.univ α ∪ ∅) ⊆ (Set.univ α ∩ ∅)。
-- soko:hint 关键件：先造 a ∈ Set.univ α ∪ ∅——Set.mem_univ α a 配上 Or.inl；把它喂给 hsub a 之后用 And.right 取出后半（展开即 False）。
theorem union_subset_inter_false (α : Type) (a : α) :
    ¬ ((Set.univ α ∪ ∅) ⊆ (Set.univ α ∩ ∅)) := by
  sorry

-- 练习 11（D 类）：判断真假并说明理由（本题把**真的那条**写成定理）。
--
--   命题甲：A ∈ 𝒫 A。   命题乙：A ⊆ 𝒫 A。
--   甲：**真**——`A ∈ 𝒫 A` 展开就是 A ⊆ A。
--   乙：**连类型都不对**——𝒫 A : Set (Set α) 的元素类型是 Set α，比 A : Set α 高一层，
--       所以它当不了 A ⊆ ? 的右参数。这正是"∈ 与 ⊆ 混淆"在幂集上的样子：
--       要写的是"属于"，不是"包含"。（Tao §3.1 的散文里 A ⊆ 𝒫A 有意义但一般不真；
--       我们的编码用类型层把它提前挡住——本课程的设计判断。）
--   （大纲单元③把"A ∈ 𝒫A"列为假命题：那是笔误，随本题解答一并更正。）
-- soko:hint 思路：目标展开就是 A ⊆ A——先 `have` 一条包含（intro 一个元素与它的证据），再问自己还需要做什么。
-- soko:hint 目标形态：A ∈ 𝒫 A，展开是 ∀ (x : α), x ∈ A → x ∈ A。
-- soko:hint 关键件：Set.mem_powerset_iff α A A（成员判定）把目标换成 A ⊆ A；剩下的形状与单元②的子集自反同形，不需要新引理。
theorem powerset_self_mem (α : Type) (A : Set α) : A ∈ 𝒫 A := by
  sorry
