-- ==========================================================================
-- unit10-cantor.sokonanoda —— 卷 I 单元⑩ 可数与 Cantor 定理（基数 Ⅱ）
--
-- 靶子：Tao §3.6 后半。概念顺序：
--   可数的定义（与 ℕ 等势）→ 对角线法 → Cantor 定理（𝒫α 不与 α 等势）
--   → 选择公理（本卷唯一一次动手用它：满射 ⇒ 存在右逆函数，练习 7）。
--
-- 讲 Cantor 之前先给一个**假的枚举**让你找矛盾（Zazkis & Mamolo 2009 的实证：
-- 学过 Cantor 定理的学生面对假的 ℝ 枚举只会说 "Cool!"——所以我们这里不放 ℝ，
-- 放 α -> Set α 的假枚举，逼你指出那个漏掉的集合）。
--
-- 本单元只允许用：
--   · 写法：fun（命名箭头）/ intro / exact / apply / assumption / rfl，项风格优先；
--   · lib/Set：Set.mem / Set.univ / Set.singleton 与已有的展开引理（Set.mem_univ…）；
--   · lib/Exists：Exists / Exists.intro / Exists.elim（用等势至少要 elim 两次）；
--   · lib/Fun：Function.Surjective（练习 6、7 用到它）；
--   · lib/Equiv（单元⑨ 已写好）：Set.Equiv 与构造子 Set.Equiv.mk；
--   · lib/Logic：True/False、Not / Iff / And / Or / absurd /
--     Eq.refl / Eq.symm / Eq.trans / Eq.subst / congrArg。
--   · **选择公理（整个单元只准出现在练习 7 这一处）**：文件末尾 §10.6 的
--     Exists.choose 与 Exists.choose_spec 这一对。练习 1–6 与卷 I 先修单元的每条
--     证明**一条都没用它**（与台账 L-06 的边界一致）。
-- 本单元**不用**：Set.ext（一条集合等式都不证）、funext / propext（语言里根本没有）——
-- 对角线论证不需要外延性，也不需要 choice；choice 只在"从满射里挑原像"那一步上场。
--
-- 注：练习 2 起都把「可数」按定义**展开**写成等势，不点名 Set.Countable——
-- 本单元的每条练习都独立判卷，不依赖前面那条是否已经填好。
-- ==========================================================================
import lib.Logic
import lib.Set
import lib.Exists
import lib.Fun
import lib.Equiv

-- ─────────────────────────────────────────────────────────────
-- 10.1 假的枚举：先看它坏在哪
--
-- 有人递给你一张"𝒫ℕ 的清单"：第 n 项就是单元素集 {n}。
-- 每项都在清单上，看起来挺像样。要戳穿它，只需指出一个**永远不在清单上**的集合：
--
--     D := fun (y : Nat) => Not (y ∈ 清单第 y 项) = fun (y : Nat) => Not (y = y)
--
-- 它把"第 y 项含不含 y"逐项反过来，于是第 k 项 {k} 含 k，D 不含 k——两者不可能相等。
-- ─────────────────────────────────────────────────────────────

def fake_enum (n : Nat) : Set Nat := Set.singleton Nat n

theorem demo_fake_enum_escapes (k : Nat) :
    Not (Eq.{1} (Set Nat) (fun (y : Nat) => Not (Eq.{1} Nat y y)) (fake_enum k)) :=
  fun (h : Eq.{1} (Set Nat) (fun (y : Nat) => Not (Eq.{1} Nat y y)) (fake_enum k)) =>
    (Eq.subst.{1} (Set Nat) (fun (X : Set Nat) => X k)
      (fake_enum k) (fun (y : Nat) => Not (Eq.{1} Nat y y))
      (Eq.symm.{1} (Set Nat) (fun (y : Nat) => Not (Eq.{1} Nat y y)) (fake_enum k) h)
      (Set.mem_singleton_self Nat k))
      (Eq.refl.{1} Nat k)

-- ─────────────────────────────────────────────────────────────
-- 10.2 对角线法（通用形式）
--
-- 把 10.1 的动作从"清单 {n}"升级成任意 f : α -> Set α：取
--     D := fun (y : α) => Not (f y y)
-- 则 D 不在 f 的像里——这就是对角线法，也是 Cantor 定理的全部内容。
--
-- 证明的关键只有一句逻辑：D x = Not (f x x) 与 (f x) x = f x x，
-- 所以"D x 等于 f x 那一点的值"会给出 `Not P 等于 P`，而命题不可能与自己的否定等价。
-- ─────────────────────────────────────────────────────────────

theorem demo_diag (α : Type) (f : α -> Set α) (x : α) :
    Not (Eq.{1} (Set α) (fun (y : α) => Not (f y y)) (f x)) :=
  fun (h : Eq.{1} (Set α) (fun (y : α) => Not (f y y)) (f x)) =>
    (fun (npto : Not (f x x) -> f x x) =>
      (fun (ptnp : f x x -> Not (f x x)) =>
        absurd (f x x) False
          (npto (fun (p : f x x) => ptnp p p))
          (fun (p : f x x) => ptnp p p))
        (Eq.subst.{1} Prop (fun (Q : Prop) => Q -> Not (f x x))
          (Not (f x x)) (f x x)
          (congrArg.{1} (Set α) Prop (fun (A : Set α) => A x)
            (fun (y : α) => Not (f y y)) (f x) h)
          (fun (np : Not (f x x)) => np)))
      (Eq.subst.{1} Prop (fun (Q : Prop) => Q)
        (Not (f x x)) (f x x)
        (congrArg.{1} (Set α) Prop (fun (A : Set α) => A x)
          (fun (y : α) => Not (f y y)) (f x) h))

-- ─────────────────────────────────────────────────────────────
-- 10.3 可数：定义
-- ─────────────────────────────────────────────────────────────

-- 练习 1（T 类）：把「可数」的定义填出来。
--   Tao 的用法：X 可数 ⟺ X 与 ℕ **等势**（"能排成一列"只是它的白话版；
--   有限集的可数是单元⑨ 处理过的另一回事，本单元只做无限可数）。
-- soko:hint 思路：可数不是描述句，而是一次等势断言——用单元⑨ 备好的 Set.Equiv 写。
-- soko:hint 目标形态：目标类型是 Prop（定义体的类型），形状为 Set.Equiv 作用在四个参数上。
-- soko:hint 关键件：Set.Equiv 的参数顺序是 α β A B（两侧论域、两侧集合）；两侧集合都取"整个类型"，用 Set.univ。
def Set.Countable (α : Type) : Prop :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 10.4 亲手写出那个映射：ℕ 与自己的等势
--
-- lib/Equiv 的等势是**数据版**：交出一对互逆映射 f、g 与四条条件（进集合、回集合、
-- g∘f = id、f∘g = id）。所以"等势"这道题永远从"写下那个映射"开始（Hamza & O'Shea 2011：
-- 援引双射判据的学生极少真的把映射写出来）。
-- ─────────────────────────────────────────────────────────────

-- 练习 2（L 类）：恒等映射给出 ℕ 与自己的等势——这就是「ℕ 可数」的实例。
-- soko:hint 思路：来回都用恒等函数（最省的一对互逆映射），再逐条交四样证据。
-- soko:hint 目标形态：Set.Equiv Nat Nat (Set.univ Nat) (Set.univ Nat)；四条条件都只谈全集：两条"进集合"是 True 的证明，两条互逆律是 rfl 级。
-- soko:hint 关键件：Set.Equiv.mk 依次吃 f、g、①进集合、②回集合、③g∘f=id、④f∘g=id；全集的成员判定交给 Set.mem_univ，等式交给 Eq.refl。
theorem nat_equiv_nat : Set.Equiv Nat Nat (Set.univ Nat) (Set.univ Nat) :=
  sorry

-- 练习 3（T 类）：对角线集合的成员判定——把 D := fun (y : α) => Not (f y y) 写开。
-- soko:hint 思路：Set.mem 就是函数应用，D 本身又是一个 λ：两边都是"算一下"。
-- soko:hint 目标形态：Iff (Set.mem α x D) (Not (f x x))，其中 D 是那个 λ。
-- soko:hint 关键件：这是定义层面的相等，直接交 Iff.refl 作用在右边那个命题上。
theorem diag_mem_iff (α : Type) (f : α -> Set α) (x : α) :
    Iff (Set.mem α x (fun (y : α) => Not (f y y))) (Not (f x x)) :=
  sorry

-- 练习 4（L 类）：Cantor 定理——α 与 𝒫α 不等势。
--   给定 f : α -> Set α，取 D := fun (x : α) => Not (f x x)，证 D 不在 f 的像里。
-- soko:hint 思路：先 intro 假设的等势；等势里裹着正向映射 f 与反向映射 g，用两次 Exists.elim 取出来（结论只能是 False——证人 f、g 不许出现在结论里）。
-- soko:hint 目标形态：Not (Set.Equiv α (Set α) (Set.univ α) (Set.univ (Set α)))；intro 之后手里是 h : Set.Equiv …，目标是 False。
-- soko:hint 关键件：④号互逆律（两层 And.right 之后那条）在 y := D 上给出 Eq (f (g D)) D；用 Eq.symm 调成 Eq D (f (g D))，交给演示 demo_diag 收尾。
theorem cantor (α : Type) :
    Not (Set.Equiv α (Set α) (Set.univ α) (Set.univ (Set α))) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 10.5 两条"判断真假"：都是假的，请证否定
-- ─────────────────────────────────────────────────────────────

-- 练习 5（D 类）：判断真假——「𝒫ℕ 可数」。
--   可数 = 与 ℕ 等势（练习 1），展开写就是下面的类型。它**为假**：请证它的否定。
-- soko:hint 思路：这正是 Cantor 定理在 α := Nat 上的实例——对角线集合就是那个漏掉的集合。
-- soko:hint 目标形态：Not (Set.Equiv Nat (Set Nat) (Set.univ Nat) (Set.univ (Set Nat)))。
-- soko:hint 关键件：练习 4 的 cantor 作用在 Nat 上，目标逐字相同。
theorem powerset_nat_not_countable :
    Not (Set.Equiv Nat (Set Nat) (Set.univ Nat) (Set.univ (Set Nat))) :=
  sorry

-- 练习 6（D 类）：判断真假——「存在满射 α -> Set α」（假的枚举想补成满射）。它**为假**。
--   与练习 4 的差别：这里只有满射，没有单射/等势的包装，所以拆包少一层、对角线要自己接。
-- soko:hint 思路：intro 之后用 Exists.elim 拆出映射 f 与它的满射性 hf；把对角线集合交给 hf 得到原像。
-- soko:hint 目标形态：Not (Exists (α -> Set α) (fun (f : α -> Set α) => Function.Surjective α (Set α) f))；拆完之后目标是 False，手里有 hf : Function.Surjective α (Set α) f。
-- soko:hint 关键件：hf D 给出 Exists α (fun (x : α) => Eq (f x) D)，再用一次 Exists.elim 取出 x 与那个等式；方向调过来（Eq.symm）才是 demo_diag 要的 Eq D (f x)。
theorem no_surjection_powerset (α : Type) :
    Not (Exists (α -> Set α) (fun (f : α -> Set α) => Function.Surjective α (Set α) f)) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 10.6 选择公理：本卷唯一一次动手用它
--
-- lib/Exists 的文件头把这条留给了本单元：从"存在一个满足 p 的元素"**取出**一个元素。
-- 官方 Lean 里它是 `Classical.choice`（Mathlib 的基数理论建立在它之上）；本卷到
-- 单元⑩ 才正面碰上它，而卷 I 的证明**一条都没用它**——等势之所以定义成"一对互逆
-- 映射"的数据（lib/Equiv 文件头），就是为了让对称性与传递性不必挑原像。
--
-- 选择公理在官方 Lean 4 里是**成对**的两条：`Exists.choose` 只交出元素，
-- `Exists.choose_spec` 才说明**所选的那个元素确实满足性质**（Avigad《Logic and Proof》
-- §16.4 的写法就是 `choose h` 配 `choose_spec h`）。为什么必须成对：没有后者，
-- `Exists.choose …` 就只是一个来路不明的元素——既不知道它是谁，也用不上它的任何性质。
--
-- Förster 2006 观察到教学惯于略过选择公理的应用，学生因此没有形成它的心智图像、
-- 日后也认不出何时被使用（**这是作者观点，不是实证研究**）。
-- ─────────────────────────────────────────────────────────────

axiom Exists.choose : (A : Type) -> (p : A -> Prop) -> Exists A p -> A

axiom Exists.choose_spec : (A : Type) -> (p : A -> Prop) -> (h : Exists A p) ->
  p (Exists.choose A p h)

-- 练习 7（L 类）：满射 ⇒ 存在右逆函数——**本单元唯一允许用选择公理的题**。
--
-- 这正是单元⑦ 只能写成数据版的那条（unit07 题 4/5/6 与 lib/Fun 文件头 §逆 的 (a)/(b)）：
--   · 没有选择公理，能证的只有 (a)：逆函数 g 与"它是右逆"的证据**由调用者交出来**
--     （unit07 题 6 的 bijective_iff_inverse 就是这么立的前提）；
--   · (b)"满射 ⇒ 存在 g 使 f ∘ g = id"（满射可裂）要求替**每个** y 从"有原像"里挑定
--     一个、还要让这个挑选本身是一个**函数**——那就是选择公理。台账 L-06 记的正是这条
--     边界："本语言接受签名但证不出来"；今天补上它，也就看清了没有它时缺的是什么。
--   对照单元⑦ 题 5（右逆 ⇒ 满射，数据版）：练习 7 正是它的**逆方向**——没有选择公理，
--   这个方向在本语言里一步也走不动。
-- 出处：一份纯 Lean 4 集合论讲义里这条叫 surj_iff_exists_right_inverse
-- （`surjective f ↔ ∃ f', f ∘ f' = id`），注释注明其中一个方向要用 Classical.choose
-- 与 Classical.choose_spec（docs/notes/settheory-survey/lean4-sets-functions-prior-art.md §6.1）。
--
-- 边界（务必看清）：全卷只有这一题用选择公理。练习 1–6 与卷 I 其它单元的每条证明
-- 都没用它——等势的数据版、对角线法、Cantor 定理都不需要 choice。
-- soko:hint 思路：要交的是一个**函数** β -> α，外加它逐点满足的等式；满射性对每个 y 都恰好给出一条"存在原像"的命题，从这条命题里挑出元素就是选择公理上场的那一刻。
-- soko:hint 目标形态：Exists (β -> α) (fun (g : β -> α) => Function.RightInverse α β g f)；展开成数据版就是"先交一个 g，再交 forall (y : β), Eq.{1} β (f (g y)) y"。
-- soko:hint 关键件：挑元素用 Exists.choose（触发条件：手里有一条 Exists，而你要用它的证人去填一个**函数**体）；挑完还要用与它成对的 Exists.choose_spec，才能拿到"所选元素满足性质"那条等式——两条都在上面 §10.6，缺后一条证明走不动。
theorem choice_split (α β : Type) (f : α -> β)
    (hf : Function.Surjective α β f) :
    Exists (β -> α) (fun (g : β -> α) => Function.RightInverse α β g f) :=
  sorry
