theorem sUnion_empty_apply (α : Type) (x : α) :
    ¬ (x ∈ Set.sUnion α (fun (_ : Set α) => False)) := by  -- soko:notation-ok: G-30/G-73 形状 ②③：前导实参或 `Eq` 层级在这些位置补不出来
