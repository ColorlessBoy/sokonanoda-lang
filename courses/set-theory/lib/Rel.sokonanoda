-- Rel.sokonanoda —— 卷 I 的**关系标准库**（L2 层）
--
-- 分层判据（docs/design/course-stdlib.md）：
--   L2（本文件）= 关系的**词汇 + 定义展开**：`Rel`、逆、复合，以及"逆/复合算在
--                 元素上是什么"的展开引理——每一条在 Mathlib 里都是 `rfl`、
--                 一行或纯管道，**没有数学内容**；
--   L3（units/）= 一切**有数学内容**的陈述（复合结合律、逆的逆、三律、等价类、
--                 划分↔等价关系、"自反+对称⇏传递"的反例…）——哪怕 Mathlib 早就有，
--                 课程就是要让学习者自己证一遍（台账 L-05 的教训：L3 放进库，
--                 练习就作废了）。
--
-- 名字一律照抄 **Mathlib/core 取证名**（docs/design/course-stdlib.md §3.1）：
--   Rel A B ↔ A → B → Prop（Tao §3.3 的"关系"；Mathlib `Relation` 是
--             `α → β → Prop` 的同义词，本课按 Tao 的写法直接展开成箭头）
--   Rel.inv（Mathlib `Relation.inv`）
--   Rel.comp（Mathlib `Relation.comp`；官方定义逐字同款：
--             `comp r s x z ↔ ∃ y, r x y ∧ s y z`）
--
-- 记法：复合 `r • s` 在**本文件里声明**（E01，紧跟 `def Rel.comp`），单元
-- `import lib.Rel` 即可用；
-- 逆 `r ⁻¹` 与复合 `r • s` 都在**本文件里声明**（E01/E03）⇒ 单元 `import lib.Rel` 即可用。
--   ⚠ 引用更正（E01）：本文件原来写"`r • s` 是 Mathlib 的记法"——**不准确**。
--   Mathlib 的 `Relation.Comp` 用的是 **`local infixr:80 " ∘r "`**
--   （`Mathlib/Logic/Relation.lean:158` 逐字），而且 `local`（出了那个 section 就没了）。
--   本课取 `•`（PLAN v0.74.0 指定）：`∘` 已经给了函数复合
--   （Lean 4 `Init/Notation.lean:274` 的 `infixr:90`），同一符号在一个闭包里
--   只能有一个目标；优先级沿用 Mathlib `Relation.Comp` 那一档 80。
--
-- ⚠ 为什么必须有 `Rel.ext`（**公理**）：
--   单元⑥ 的必证题 `rel_comp_assoc`（复合结合律）与 `rel_inv_inv`（逆的逆）都是
--   **关系之间的等式**，即 `f = g`。`rel_inv_inv` 是定义等式，
--   一个 `Eq.refl` 就够；但两条复合的**结合律**不是定义等式（∃ 要先交换量词顺序），
--   要证它必须把"∀ a c, f a c ↔ g a c"升级成"f = g"——这正是**函数外延性**。
--   官方 Mathlib 里 `funext` 由 `Quot.sound` 推出，`Rel.ext` 则是
--   `funext` + `propext` 的推论；本语言两者都没有（prelude 只有 Nat/Bool/Eq），
--   所以与 lib/Set.sokonanoda 的 `Set.ext` 完全同款：**就地取一条外延性公理**。
--   `Set.ext` 与本条是整个卷 I 仅有的两条外延性公理，其余一切照常由内核重查。
import lib.Logic
import lib.Exists

-- ── 词汇（Mathlib: Mathlib/Logic/Relation.lean，语义逐字同款）────────────────
-- 关系就是"两元谓词"：`Rel A B` 与 `A → B → Prop` 是同一个东西（定义等式）。
def Rel (A B : Type) : Type := A → B → Prop

-- 逆关系：把两个参数对调（记法 r ⁻¹）。
def Rel.inv (A B : Type) (r : Rel A B) : Rel B A :=
  fun (b : B) => fun (a : A) => r a b

-- ── 记法（E03）：逆关系 `r ⁻¹` ─────────────────────────────────────────────
-- 与 `r • s` 同族：源级糖、**零事件、不进声明表** ⇒ 加这一行不改变任何计数。
-- 形状取 `postfix:100`（与 lib/Set 的 `ᶜ`/`𝒫` 同档：贴着操作数、比二元算子都紧）。
-- ⚠ **取证更正（E03）**：本文件早先写"Mathlib `Relation.inv`，即记法 r ⁻¹"——
-- mathlib4 master 的 `Mathlib/Logic/Relation.lean` 里**既没有 `Relation.inv`
-- 也没有 `⁻¹` 记法**（那里只有 `local infixr:80 " ∘r " => Relation.Comp`）
-- ⇒ 这条记法是**本课自定**（符号按数学书读法，PLAN v0.74.0 指定）。
-- 与 lib/Set 的 `⁻¹'`（原像，`infixr:80`）是**两个符号**：词法按声明**最长匹配**
-- ⇒ `f ⁻¹' B` 仍读作 `⁻¹'`（单元⑧⑫ 两个符号同文件共存，已实测 ✓）。
postfix:100 " ⁻¹ " => Rel.inv

-- 复合（关系串接，Mathlib `Relation.comp`，记法 r • s；参数顺序与 Mathlib 一致：
-- `r • s` 里 r : Rel A B 先走，s : Rel B C 后走）。中缀的 `∃ b, …`
-- 在这里就是带标注的 `∃ (b : B), …`；定义体照课程库的统一写法用 `∃` 记法
-- （定义是词汇，不是证明——`∃` 记法本身由 lib/Exists 声明）。
def Rel.comp {A B C : Type} (r : Rel A B) (s : Rel B C) : Rel A C :=
  fun (a : A) => fun (c : C) =>
    ∃ (b : B), (r a b) ∧ (s b c)

-- ── 记法（E01）：关系复合 `r • s` ───────────────────────────────────────────
-- 与 lib/Set 末尾那段记法同族：源级糖、**零事件、不进声明表** ⇒ 加这一行
-- 不改变课程门禁的任何计数。被 import 的模块声明的记法在**入口文件里从文件头
-- 就可用**（docs/design/notation-subset.md §10.3）⇒ 单元只要 `import lib.Rel`
-- 就能写 `r • s`；同一符号全课程只能声明一次（重声明是 parse 错误）。
-- 点名形式永久可用（N4.3）：`Rel.comp` 写全前导类型参数时，两种写法判卷一致。
infixr:80 " • " => Rel.comp

-- ── 外延性（**公理**：Mathlib 由 funext + propext 推出，我们两者都没有）──────
-- 用法与 `Set.ext` 同款：要证两条关系相等，就逐元素证两个方向。
axiom Rel.ext : (A B : Type) → (r s : Rel A B) →
  (∀ (a : A) (b : B), r a b ↔ s a b) → r = s

-- ── 定义展开引理（L2：两边是同一个东西，没有数学内容）──────────────────────
-- 与 lib/Set 的 `Set.mem_union` 一族同款：右端就是把左端**定义**里的东西照抄一遍，
-- 所以证明是**恒等**——`constructor` 拆开 `↔`，两个方向各 `intro h; exact h`。
theorem Rel.inv_apply (A B : Type) (r : Rel A B) (b : B) (a : A) :
    (r ⁻¹) b a ↔ r a b :=  Iff.refl

theorem Rel.comp_apply {A B C : Type} (r : Rel A B) (s : Rel B C) (a : A) (c : C) :
    (r • s) a c ↔ ∃ (b : B), r a b ∧ s b c :=  Iff.refl (∃ (b : B), r a b ∧ s b c)  -- soko:notation-ok: `Iff.refl` 短写解不出 A

-- ── 库自检：两条展开引理合起来，把"逆的逆"退回原关系（`rfl` 级）。────────────
-- 单元⑥ 的必证题 `rel_inv_inv` 在画布上由学习者自己写：它的证明项与本条同款
-- （函数外延性在这里用不上——`(r ⁻¹) ⁻¹` 与 `r` 是定义等式）。
theorem Rel.inv_inv_apply (A B : Type) (r : Rel A B) (a : A) (b : B) :
    ((r ⁻¹) ⁻¹) a b ↔ r a b :=  Iff.refl (r a b)  -- soko:notation-ok: `Iff.refl` 短写解不出 A

-- ── Eq 搬运（**具名包装**；本语言里 `Eq.subst` 嵌在别的应用里会被 elaborator 判红）──
-- 读法：`rel_subst_left r h` 把 `r b c` 沿 `a = c` 搬成 `r b a`（把等式的**左端**换掉）。
-- 为什么包一层：`Eq.subst.{1} α (fun (x : α) => r b x) c a (Eq.symm …) hbc` 写在
-- **顶层**判绿 ✓，一旦嵌进 `f … (Eq.subst …)` 这样的实参位就报
-- 「期望 `Sort(0)`，实际是 `Sort(1)`」（实测；与 G-72 同一族，**登记在案等语言线修**）✓
theorem rel_subst_left (α : Type) (r : α → α → Prop) (a b c : α) (h : a = c) :
    r b c → r b a :=
  Eq.subst.{1} α (fun (x : α) => r b x) c a (Eq.symm.{1} α a c h)

-- 读法：把 `r a b` 沿 `b = c` 搬成 `r a c`（把等式的**右端**换掉）。
theorem rel_subst_right (α : Type) (r : α → α → Prop) (a b c : α) (h : b = c) :
    r a b → r a c :=
  Eq.subst.{1} α (fun (x : α) => r a x) b c h

-- ── 三种闭包（Enderton §3.5 / Halmos §10 的词汇；L2：都是"一行定义"）──────────
-- 读法（**关键是传递闭包那条**）：不断言"反复复合"（那要递归，本语言没有 ℕ 上的递归原则
-- 之外的现成工具），而是照 Halmos 的**交集式**定义 ——
--   `a (r⁺) b` ⟺ "在**每个**包含 `r` 的传递关系里都有 `a s b`" ✓
-- 这个写法**不需要任何递归**，三种闭包的定律就都能直接证 ✓
def Rel.reflClosure (α : Type) (r : Rel α α) : Rel α α :=
  fun (a : α) (b : α) => r a b ∨ a = b

def Rel.symClosure (α : Type) (r : Rel α α) : Rel α α :=
  fun (a : α) (b : α) => r a b ∨ r b a

def Rel.transClosure (α : Type) (r : Rel α α) : Rel α α :=
  fun (a : α) (b : α) =>
    ∀ (s : Rel α α), (∀ (x : α) (y : α) (z : α), s x y → s y z → s x z) →
      (∀ (x : α) (y : α), r x y → s x y) → s a b

-- ── 展开引理 + 取用子 / 构造子（L2）──────────────────────────────────────────
theorem Rel.reflClosure_apply (α : Type) (r : Rel α α) (a b : α) :
    Rel.reflClosure α r a b ↔ (r a b ∨ a = b) :=
  Iff.intro (fun (h : Rel.reflClosure α r a b) => h) (fun (h : r a b ∨ a = b) => h)

theorem Rel.symClosure_apply (α : Type) (r : Rel α α) (a b : α) :
    Rel.symClosure α r a b ↔ (r a b ∨ r b a) :=
  Iff.intro (fun (h : Rel.symClosure α r a b) => h) (fun (h : r a b ∨ r b a) => h)

-- 传递闭包的**两条**取用子：① 用在具体的 `s` 上；② 用在"闭包自己的传递性"上 ✓
theorem Rel.transClosure_elim (α : Type) (r s : Rel α α) (a b : α)
    (h : Rel.transClosure α r a b)
    (hs : ∀ (x : α) (y : α) (z : α), s x y → s y z → s x z)
    (hr : ∀ (x : α) (y : α), r x y → s x y) : s a b :=
  (fun (hh : ∀ (s' : Rel α α), (∀ (x : α) (y : α) (z : α), s' x y → s' y z → s' x z) →
      (∀ (x : α) (y : α), r x y → s' x y) → s' a b) => hh s hs hr) h

-- ── 等价类与商集（L2：`Set α` 就是 `α → Prop`，所以这里直接写谓词，不必 import lib.Set）──
-- 读法：`Rel.EquivClass α r a` 就是"与 `a` 相关的那些点"（记作 `[a]`）✓
def Rel.EquivClass (α : Type) (r : Rel α α) (a : α) : α → Prop :=
  fun (c : α) => r a c

-- 读法：`Rel.Classes α r` 是"**是某个等价类**"这条性质（作用在集合 `C : α → Prop` 上）✓
-- —— 于是"商集"就是由它切出来的那一族集合，不需要新类型 ✓
def Rel.Classes (α : Type) (r : Rel α α) : (α → Prop) → Prop :=
  fun (C : α → Prop) => ∃ (a : α), ∀ (c : α), C c ↔ r a c

theorem Rel.mem_equivClass (α : Type) (r : Rel α α) (a b : α) :
    Rel.EquivClass α r a b ↔ r a b :=
  Iff.intro (fun (h : Rel.EquivClass α r a b) => h) (fun (h : r a b) => h)

theorem Rel.mem_classes (α : Type) (r : Rel α α) (C : α → Prop) :
    Rel.Classes α r C ↔ ∃ (a : α), ∀ (c : α), C c ↔ r a c :=
  Iff.intro (fun (h : Rel.Classes α r C) => h)
    (fun (h : ∃ (a : α), ∀ (c : α), C c ↔ r a c) => h)

-- ── 划分（Enderton §3.5 的另一半；L2：三条的合取）────────────────────────────
-- 读法：`P` 是**一族集合**（写成 `(α → Prop) → Prop`），三条说：
--   ① 每个块**非空**；② 每个点**落在某个块里**；③ 有公共点的两块**逐点相同** ✓
def Rel.Partition (α : Type) (P : (α → Prop) → Prop) : Prop :=
  (∀ (A : α → Prop), P A → ∃ (a : α), A a) ∧
  (∀ (a : α), ∃ (A : α → Prop), P A ∧ A a) ∧
  (∀ (A B : α → Prop), P A → P B → (∃ (x : α), A x ∧ B x) →
    ∀ (c : α), A c ↔ B c)

-- 读法：**由划分造出的关系** —— "两个点落在同一个块里" ✓
-- （这正是"等价关系 = 划分"这一定理的反方向：划分 ⇒ 等价关系）
def Rel.ofPartition (α : Type) (P : (α → Prop) → Prop) (a b : α) : Prop :=
  ∃ (A : α → Prop), P A ∧ A a ∧ A b

theorem Rel.partition_def (α : Type) (P : (α → Prop) → Prop) :
    Rel.Partition α P ↔
      (∀ (A : α → Prop), P A → ∃ (a : α), A a) ∧
      (∀ (a : α), ∃ (A : α → Prop), P A ∧ A a) ∧
      (∀ (A B : α → Prop), P A → P B → (∃ (x : α), A x ∧ B x) →
        ∀ (c : α), A c ↔ B c) :=
  Iff.intro (fun (h : Rel.Partition α P) => h)
    (fun (h : (∀ (A : α → Prop), P A → ∃ (a : α), A a) ∧
      (∀ (a : α), ∃ (A : α → Prop), P A ∧ A a) ∧
      (∀ (A B : α → Prop), P A → P B → (∃ (x : α), A x ∧ B x) →
        ∀ (c : α), A c ↔ B c)) => h)

theorem Rel.ofPartition_apply (α : Type) (P : (α → Prop) → Prop) (a b : α) :
    Rel.ofPartition α P a b ↔ ∃ (A : α → Prop), P A ∧ A a ∧ A b :=
  Iff.intro (fun (h : Rel.ofPartition α P a b) => h)
    (fun (h : ∃ (A : α → Prop), P A ∧ A a ∧ A b) => h)

-- 三条取用子（**参数一次给全**；同 G-73 的处置）
theorem partition_nonempty (α : Type) (P : (α → Prop) → Prop) (h : Rel.Partition α P) :
    ∀ (A : α → Prop), P A → ∃ (a : α), A a :=
  And.left h

theorem partition_cover (α : Type) (P : (α → Prop) → Prop) (h : Rel.Partition α P) :
    ∀ (a : α), ∃ (A : α → Prop), P A ∧ A a :=
  And.left (And.right h)

theorem partition_disjoint (α : Type) (P : (α → Prop) → Prop) (h : Rel.Partition α P) :
    ∀ (A B : α → Prop), P A → P B → (∃ (x : α), A x ∧ B x) → ∀ (c : α), A c ↔ B c :=
  And.right (And.right h)
