-- SUnion.sokonanoda —— 卷 I 的**集族与无限并/交**（ST4，v0.77.0）
--
-- 分层判据（docs/design/course-stdlib.md）：本文件是 **L2（词汇 + 定义展开）**：
--   · 2 个定义：`Set.sUnion` / `Set.sInter`；
--   · 4 条定义展开引理：`Set.mem_sUnion_iff` / `Set.mem_sInter_iff` /
--     `Set.subset_sUnion` / `Set.sInter_subset`。
-- 有数学内容的（如 `sUnion_pair`、单调性、`sUnion_empty`）属 **L3**，留作单元练习 ✗。
--
-- **依赖方向**：`lib/Logic` + `lib/Exists` + `lib/Set`（无限并要用 `∃`）。
-- 为什么单独一个文件而不是并进 `lib/Set`：`lib/Set` 不 import `Exists`（它只依赖
-- 语言内建的逻辑符号），而无限并**必须**用存在量化 ⇒ 并进 `Set` 会把 `Exists` 的
-- 依赖方向拧成环。**Mathlib 里它们是同一个文件**（`Mathlib/Data/Set/Defs.lean`），
-- 我们按**依赖**拆开 —— 这是有意的偏离，理由记在这里 ✓。
--
-- 名字一律用 Loogle 取证版：`Set.sUnion`（不是 `sUnion₀`）、`Set.mem_sUnion_iff`、
-- `Set.subset_sUnion`、`Set.sInter_subset`（Mathlib 的四个真名）。
import lib.Logic
import lib.Exists
import lib.Set

namespace Set

-- ── 词汇（Mathlib: Mathlib/Data/Set/Defs.lean，逐字同款）────────────────────
-- `F : Set (Set α)` 是一族集合。
--   · `⋃₀ F`：**存在**一个 `A ∈ F` 使 `x ∈ A`；
--   · `⋂₀ F`：对**每个** `A ∈ F` 都有 `x ∈ A`。
-- 谓词式里这两条就是存在/全称量化，零外挂（ST1 决策记录结论 ① ✓）。
def sUnion (α : Type) (F : Set (Set α)) : Set α :=
  fun (x : α) => ∃ (A : Set α), A ∈ F ∧ x ∈ A

def sInter (α : Type) (F : Set (Set α)) : Set α :=
  fun (x : α) => ∀ (A : Set α), A ∈ F → x ∈ A

-- ── 定义展开引理（L2：Mathlib 里是 `rfl` 或一行，没有数学内容）──────────────
theorem mem_sUnion_iff (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ sUnion α F ↔ ∃ (A : Set α), A ∈ F ∧ x ∈ A := by
  constructor
  intro h
  exact h
  intro h
  exact h

theorem mem_sInter_iff (α : Type) (F : Set (Set α)) (x : α) :
    x ∈ sInter α F ↔ ∀ (A : Set α), A ∈ F → x ∈ A := by
  constructor
  intro h
  exact h
  intro h
  exact h

-- 族里的每个 `A` 都包含在 `⋃₀ F` 里。
-- ⚠ 结论写成**展开形式**（`x ∈ sUnion α F` 会让期望类型头是 `Set.sUnion`，
-- 而 `⟨…⟩` 只认单构造子归纳）⇒ 展开成 `∃` 之后 `⟨A, h, hx⟩` 才解析得出来 ✓。
theorem subset_sUnion (α : Type) (F : Set (Set α)) (A : Set α) (h : A ∈ F) :
    ∀ (x : α), x ∈ A → ∃ (B : Set α), B ∈ F ∧ x ∈ B := by
  intro x
  intro hx
  exact Exists.intro A (And.intro h hx)

theorem sInter_subset (α : Type) (F : Set (Set α)) (A : Set α) (h : A ∈ F) :
    sInter α F ⊆ A := by
  intro x
  intro hx
  exact hx A h

end Set

-- ── 记法（Mathlib: `⋃₀` / `⋂₀`，逐字同款）────────────────────────────────
-- 与 `lib/Set` 的记法同一套约定：目标名在**使用点**解析 ⇒ 用到就得在作用域里。
prefix:100 " ⋃₀ " => Set.sUnion
prefix:100 " ⋂₀ " => Set.sInter

-- ── 消去子 / 构造子（L2：把"拆 `∃`"与"造 `∃`"收进库；同 `Set.Le.elim` 的处置）──────
-- ⚠ 为什么要有（实测）：单元㉑㉒ 那种"族里套族"的证明里，手写嵌套 `Exists.elim` 极易少数一个
-- 右括号（整份文件只剩一条 `expected ')'`、还指向后面某一行 ⇒ G-15 的老毛病）⇒ 收进库 ✓
theorem Set.mem_sUnion_elim (α : Type) (F : Set (Set α)) (x : α) (C : Prop)
    (h : x ∈ ⋃₀ F)
    (k : ∀ (A : Set α), A ∈ F → x ∈ A → C) : C :=
  Exists.elim (Set α) (fun (A : Set α) => A ∈ F ∧ x ∈ A) C  -- soko:notation-ok: G-73 形状 ②：期望类型是定义头时前导实参必须写全
    ((fun (hs : ∃ (A : Set α), A ∈ F ∧ x ∈ A) => hs) h)
    (fun (A : Set α) (hA : A ∈ F ∧ x ∈ A) => k A (And.left hA) (And.right hA))

theorem Set.mem_sUnion_intro (α : Type) (F : Set (Set α)) (A : Set α) (x : α)
    (hA : A ∈ F) (hx : x ∈ A) : x ∈ ⋃₀ F :=
  Set.subset_sUnion α F A hA x hx

theorem Set.mem_sInter_elim (α : Type) (F : Set (Set α)) (x : α) (C : Prop)
    (h : x ∈ ⋂₀ F)
    (k : (∀ (A : Set α), A ∈ F → x ∈ A) → C) : C :=
  k ((fun (hs : ∀ (A : Set α), A ∈ F → x ∈ A) => hs) h)

-- ── 广义交的**引入**子（2026-10-01 补，台账 **L-10**）────────────────────────
-- 为什么补：并侧一直是**成对**的（`Set.mem_sUnion_intro` + `Set.mem_sUnion_elim` ✓），
--   交侧却**只有 `elim`** ✗ ⇒ 单元㊽ 想"引入交的成员"时只能自己走
--   `Set.mem_sInter_iff` + `Iff.mpr`（而且还得**先把绑定形态落地成 λ** ✓，见课程手册）✓。
-- 这一条与 `Set.mem_sInter_elim` **互为对偶**，形状与 `Set.mem_sUnion_intro` 对齐 ✓
theorem Set.mem_sInter_intro (α : Type) (F : Set (Set α)) (x : α)
    (h : ∀ (A : Set α), A ∈ F → x ∈ A) : x ∈ ⋂₀ F :=
  (fun (hu : x ∈ ⋂₀ F ↔ ∀ (A : Set α), A ∈ F → x ∈ A) =>
    Iff.mpr hu h) (Set.mem_sInter_iff α F x)

-- ── 广义积（索引族的积；Mathlib `Set.pi` / `Set.mem_pi` 同款）────────────────
-- 读法：`A : ι → Set α` 是**索引族**，`Set.pi ι α A` 是"每个坐标都落在对应因子里"的
-- **函数**的集合 ✓ —— 这就是"任意多个集合的笛卡尔积"在谓词式里的样子。
-- ⚠ 它与二元积 `Set.prod`（`lib/Prod`）的关系：二元积的元素是**序对** `Prod A B`，
--   而这里的元素是**函数** `ι → α` —— 索引取 `Bool` 一类两点类型时，两边等势 ✓（L3）。
def Set.pi (ι α : Type) (A : ι → Set α) : Set (ι → α) :=
  fun (f : ι → α) => ∀ (i : ι), f i ∈ A i

theorem Set.mem_pi_iff (ι α : Type) (A : ι → Set α) (f : ι → α) :
    f ∈ Set.pi ι α A ↔ ∀ (i : ι), f i ∈ A i :=
  Iff.intro (fun (h : f ∈ Set.pi ι α A) => h) (fun (h : ∀ (i : ι), f i ∈ A i) => h)

-- 取用子 / 构造子（L2：同 `lib/SUnion` 那一组）
theorem Set.mem_pi_elim (ι α : Type) (A : ι → Set α) (f : ι → α) (i : ι)
    (h : f ∈ Set.pi ι α A) : f i ∈ A i :=
  (fun (hs : ∀ (i' : ι), f i' ∈ A i') => hs i) h

theorem Set.mem_pi_intro (ι α : Type) (A : ι → Set α) (f : ι → α)
    (h : ∀ (i : ι), f i ∈ A i) : f ∈ Set.pi ι α A :=
  (fun (hs : ∀ (i : ι), f i ∈ A i) => hs) h

-- 单调（L2 级的一步：逐坐标包含 ⇒ 积包含）
theorem Set.pi_mono (ι α : Type) (A B : ι → Set α) (h : ∀ (i : ι), A i ⊆ B i) :
    Set.pi ι α A ⊆ Set.pi ι α B :=
  fun (f : ι → α) (hf : f ∈ Set.pi ι α A) =>
    Set.mem_pi_intro ι α B f
      (fun (i : ι) =>
        (fun (hs : ∀ (j : ι), A j ⊆ B j) => (fun (hu : ∀ (x : α), x ∈ A i → x ∈ B i) =>
          hu (f i) (Set.mem_pi_elim ι α A f i hf)) (hs i)) h)

-- 交对族**反变**（S-B ✓；λ 落地 ✓）：`F ⊆ G ⇒ ⋂G ⊆ ⋂F`
theorem sInter_mono (α : Type) (F G : Set (Set α)) (h : F ⊆ G) :
    Set.sInter α G ⊆ Set.sInter α F :=
  fun (x : α) (hx : x ∈ Set.sInter α G) =>
    (fun (hxG : ∀ (A : Set α), A ∈ G → x ∈ A) =>
      (fun (hxF : ∀ (A : Set α), A ∈ F → x ∈ A) => hxF)
        (fun (A : Set α) (hA : A ∈ F) => hxG A (h A hA))) hx

-- 并含于 `B` 的充分条件（S-B ✓）：族里每个成员都含于 `B` 即可
theorem sUnion_subset (α : Type) (F : Set (Set α)) (B : Set α)
    (h : ∀ (A : Set α), A ∈ F → A ⊆ B) : Set.sUnion α F ⊆ B :=
  fun (x : α) (hx : x ∈ Set.sUnion α F) =>
    (fun (hxE : ∃ (A : Set α), A ∈ F ∧ x ∈ A) =>
      Exists.elim (Set α) (fun (A : Set α) => A ∈ F ∧ x ∈ A) (B x) hxE
        (fun (A : Set α) (hA : A ∈ F ∧ x ∈ A) => h A (And.left hA) x (And.right hA))) hx

-- 含于交的充分条件（S-B ✓）：含于族里每个成员即可
theorem sInter_subset_iff (α : Type) (F : Set (Set α)) (B : Set α)
    (h : ∀ (A : Set α), A ∈ F → B ⊆ A) : B ⊆ Set.sInter α F :=
  fun (x : α) (hx : B x) =>
    (fun (hxF : ∀ (A : Set α), A ∈ F → x ∈ A) => hxF)
      (fun (A : Set α) (hA : A ∈ F) => h A hA x hx)

-- 积单调的**点式**特例（S-B ✓ I.9）：逐坐标包含 ⇒ 成员搬运（`Set.pi_mono` 的直接应用）
theorem Set.pi_mono_apply (ι α : Type) (A B : ι → Set α) (h : ∀ (i : ι), A i ⊆ B i)
    (f : ι → α) (hf : f ∈ Set.pi ι α A) : f ∈ Set.pi ι α B :=
  Set.pi_mono ι α A B h f hf
