-- Order.sokonanoda —— 卷 I 的**序关系词汇**（I.5 章的第一块，2026-10-01）
--
-- **定位**：把「序」这件事拆成**六个二元谓词性质**（自反/非自反/对称/反对称/传递/全）
-- 与**四个序类**（偏序/严格序/全序/良序），再加**最小元**与**良基**。
-- 一个定义都没有数学内容 —— 全是「读出来就知道」的展开 ⇒ **L2（词汇）** ✓。
-- 有数学内容的（严格序 ↔ 非严格序的互相翻译、良序 ⇒ 无无穷下降链、反例）
-- 属 **L3**，留作单元⑬⑭ 的练习 ✗（分层判据见 docs/design/course-stdlib.md）。
--
-- **基准**（名字与形状逐条对齐 Lean core / Mathlib）：
--   Lean core（`Init/Core.lean`）：
--       def Reflexive    (r : Rel α α) := ∀ a, r a a
--       def Irreflexive  (r : Rel α α) := ∀ a, ¬ r a a
--       def Symmetric    (r : Rel α α) := ∀ ⦃a b⦄, r a b → r b a
--       def Antisymmetric (r : Rel α α) := ∀ ⦃a b⦄, r a b → r b a → a = b
--       def Transitive   (r : Rel α α) := ∀ ⦃a b c⦄, r a b → r b c → r a c
--       def Total        (r : Rel α α) := ∀ a b, r a b ∨ r b a
--   Mathlib（`Mathlib/Order/Defs.lean`）：
--       def IsPartialOrder (r : Rel α α) := Reflexive r ∧ Antisymmetric r ∧ Transitive r
--       def IsStrictOrder  (r : Rel α α) := Irreflexive r ∧ Transitive r
--       def IsLinearOrder  (r : Rel α α) := IsPartialOrder r ∧ Total r
--       def IsWellOrder    (r : Rel α α) := IsStrictOrder r ∧ WellFounded r   （严格版）
--   ⚠ **三处有意的偏离**（理由写在各自定义处）：
--   ① 参数表写成**显式** `(α : Type) (r : Rel α α)` —— 与本课程既有的
--      `Function.Injective (α β : Type) (f : α → β)`、集合的包含谓词那一条 一致
--      （点名调用不靠隐式反解，学习者的报错更可读）✓
--   ② **两种良序都有**（2026-10-01 **L-07 修复**）：`IsWellOrder` 是**非严格**版
--      （`IsLinearOrder ∧ HasLeast`，"每个非空子集有**最小**元" —— 与 `≤` 的直觉一致，
--      单元⑮⑯ 的序数用它）✓；`IsStrictWellOrder` 是**严格**版（`IsStrictOrder ∧
--      IsWellFounded`，Mathlib 的 `WellOrder` 就是这一版 —— 单元⑭ 要证的
--      "非空子集有**极小**元"要用它）✓ **两版不能混**：非严格序含自反，配"极小"版
--      会立刻矛盾（那就只在空论域上可满足 ✗）✓

import lib.Logic
import lib.Exists
import lib.Rel

-- ⚠ **为什么两个翻译函数的返回类型写 `Rel α α` 而不是字面的 `α → α → Prop`**
-- （实测踩过，**这是本档最贵的一课**）：`def f (α) (r) : α → α → Prop := fun (a b : α) =>
-- r a b ∧ …` 这种形状**单文件判卷是绿的、被 `import` 时判红**
-- （`unknown identifier \`b\`` —— 函数体里的第二个绑定变量在 import 路径上丢了），
-- 即"**库自己绿、每个使用者红**"的假绿 ✗。返回类型换成**具名别名** `Rel α α` 两态都对 ✓。
-- **最小复现 = `docs/gaps/repro/G-72-import-lambda-body.sokonanoda`，台账编号 G-72**；
-- 语言线修好之前**别把这两行的返回类型改回字面箭头** ✗

-- ── 六个二元谓词性质（Lean core 的真名）──────────────────────────────────────
-- 读法：`r a b` 是"a 排在 b 前面"（非严格序读作 a ≤ b，严格序读作 a < b）。

-- 自反：每个元素都与自己可比（`≤` 有，`<` 没有）
def Reflexive (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a : α), r a a

-- 非自反：没有一个元素与自己可比（`<` 有，`≤` 没有）
def Irreflexive (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a : α), ¬ (r a a)

-- 对称：`r a b` 与 `r b a` 同进同出（等价关系有，序**没有**）
def Symmetric (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a b : α), r a b → r b a

-- 反对称：两边都能排 ⇒ 两个元素相等（这是"序"与"等价"的分水岭）
def Antisymmetric (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a b : α), r a b → r b a → a = b

-- 传递
def Transitive (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a b c : α), r a b → r b c → r a c

-- 全（任意两个元素至少有一个方向可比）—— ⚠ 注意**不含**"a = b"那一支：
-- 全序 = 偏序 + 全，反对称把"两个方向都有"的情形压成相等 ✓
def Total (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (a b : α), r a b ∨ r b a

-- ── 四个序类（Mathlib 的真名，形状见文件头）──────────────────────────────────

-- 偏序 = 自反 + 反对称 + 传递（`⊆` 是样板）
def IsPartialOrder (α : Type) (r : α → α → Prop) : Prop :=
  Reflexive α r ∧ Antisymmetric α r ∧ Transitive α r

-- 严格序 = 非自反 + 传递（`<` 是样板；**注意它不需要反对称** —— 非自反已经够了）
def IsStrictOrder (α : Type) (r : α → α → Prop) : Prop :=
  Irreflexive α r ∧ Transitive α r

-- 全序 = 偏序 + 全（`≤` 在 `Nat` 上是样板）
def IsLinearOrder (α : Type) (r : α → α → Prop) : Prop :=
  IsPartialOrder α r ∧ Total α r

-- ── 良基与良序（**集合论形式**，见文件头偏离 ③）──────────────────────────────

-- `m` 是 `P` 的 `r`-**最小元**：`m ∈ P`，且没有 `P` 里的元素排在 `m` 前面。
-- ⚠ 注意这是"**极小**"（没有更小的），不是"**最小**"（比谁都小）——
-- 在全序里两者重合，在偏序里不重合（单元⑭ 的必破题之一）✓
def HasMin (α : Type) (r : α → α → Prop) (P : α → Prop) : Prop :=
  ∃ (m : α), P m ∧ ∀ (y : α), P y → ¬ (r y m)

-- `m` 是 `P` 的 `r`-**最小元**（比 `P` 里谁都小）—— **非严格序要用这一版** ✓
-- ⚠ 这一条是 **L-07 的修复**（2026-10-01）：非严格良序（线性序，含自反）**必须**配
-- "最小"版 —— 配"极小"版（`¬ r y m`）会与自反性直接冲突（取 `y := m` 即矛盾）⇒
-- 那样定义出来的 `IsWellOrder` **只在空论域上可满足**（良序定理全部空真 ✗）✓
def HasLeast (α : Type) (r : α → α → Prop) (P : α → Prop) : Prop :=
  ∃ (m : α), P m ∧ ∀ (y : α), P y → r m y

-- 良基：**每个非空子集都有最小元**（`Acc` 版本见文件末尾 —— 台账 **G-56 已修** ✓）
def IsWellFounded (α : Type) (r : α → α → Prop) : Prop :=
  ∀ (P : α → Prop), (∃ (x : α), P x) → HasMin α r P

-- 良序 = 全序 + 良基（**非严格版**，见文件头偏离 ②）
def IsWellOrder (α : Type) (r : α → α → Prop) : Prop :=
  IsLinearOrder α r ∧ ∀ (P : α → Prop), (∃ (x : α), P x) → HasLeast α r P

-- **严格良序** = 严格序 + 良基（Mathlib 的 `WellOrder` 就是这一版）——
-- 单元⑭ 要证的"非空子集有**极小**元"要用它 ✓（非严格序配不上"极小"版 ⇒ **L-07**）✓
def IsStrictWellOrder (α : Type) (r : Rel α α) : Prop :=
  IsStrictOrder α r ∧ IsWellFounded α r

-- ── 严格部分 / 非严格部分（两个**翻译函数**：定义是词汇，性质是练习）──────────
-- `strictOf r`：把非严格序的"相等那一份"切掉 ⇒ `a < b` 读作 `a ≤ b ∧ a ≠ b`。
def strictOf (α : Type) (r : Rel α α) : Rel α α :=
  fun (a b : α) => r a b ∧ a ≠ b

-- `nonstrictOf r`：把严格序的"相等那一份"补回来 ⇒ `a ≤ b` 读作 `a < b ∨ a = b`。
def nonstrictOf (α : Type) (r : Rel α α) : Rel α α :=
  fun (a b : α) => r a b ∨ a = b

-- ── 六个性质的展开引理（L2；`rfl` 级）────────────────────────────────────
theorem reflexive_def (α : Type) (r : α → α → Prop) :
    Reflexive α r ↔ ∀ (a : α), r a a :=
  Iff.intro (fun (h : Reflexive α r) => h) (fun (h : ∀ (a : α), r a a) => h)

theorem irreflexive_def (α : Type) (r : α → α → Prop) :
    Irreflexive α r ↔ ∀ (a : α), ¬ (r a a) :=
  Iff.intro (fun (h : Irreflexive α r) => h) (fun (h : ∀ (a : α), ¬ (r a a)) => h)

theorem symmetric_def (α : Type) (r : α → α → Prop) :
    Symmetric α r ↔ ∀ (a b : α), r a b → r b a :=
  Iff.intro (fun (h : Symmetric α r) => h) (fun (h : ∀ (a b : α), r a b → r b a) => h)

theorem antisymmetric_def (α : Type) (r : α → α → Prop) :
    Antisymmetric α r ↔ ∀ (a b : α), r a b → r b a → a = b :=
  Iff.intro (fun (h : Antisymmetric α r) => h)
    (fun (h : ∀ (a b : α), r a b → r b a → a = b) => h)

theorem transitive_def (α : Type) (r : α → α → Prop) :
    Transitive α r ↔ ∀ (a b c : α), r a b → r b c → r a c :=
  Iff.intro (fun (h : Transitive α r) => h)
    (fun (h : ∀ (a b c : α), r a b → r b c → r a c) => h)

theorem total_def (α : Type) (r : α → α → Prop) :
    Total α r ↔ ∀ (a b : α), r a b ∨ r b a :=
  Iff.intro (fun (h : Total α r) => h) (fun (h : ∀ (a b : α), r a b ∨ r b a) => h)

-- ── 定义展开引理（L2：Mathlib 里是 `Iff.rfl` 或一行，没有数学内容）────────────
theorem isPartialOrder_def (α : Type) (r : α → α → Prop) :
    IsPartialOrder α r ↔ Reflexive α r ∧ Antisymmetric α r ∧ Transitive α r :=
  Iff.intro (fun (h : IsPartialOrder α r) => h)
    (fun (h : Reflexive α r ∧ Antisymmetric α r ∧ Transitive α r) => h)

theorem isStrictOrder_def (α : Type) (r : α → α → Prop) :
    IsStrictOrder α r ↔ Irreflexive α r ∧ Transitive α r :=
  Iff.intro (fun (h : IsStrictOrder α r) => h)
    (fun (h : Irreflexive α r ∧ Transitive α r) => h)

theorem isLinearOrder_def (α : Type) (r : α → α → Prop) :
    IsLinearOrder α r ↔ IsPartialOrder α r ∧ Total α r :=
  Iff.intro (fun (h : IsLinearOrder α r) => h)
    (fun (h : IsPartialOrder α r ∧ Total α r) => h)

theorem isWellFounded_def (α : Type) (r : α → α → Prop) :
    IsWellFounded α r ↔
      ∀ (P : α → Prop), (∃ (x : α), P x) → HasMin α r P :=
  Iff.intro (fun (h : IsWellFounded α r) => h)
    (fun (h : ∀ (P : α → Prop), (∃ (x : α), P x) → HasMin α r P) => h)

theorem isWellOrder_def (α : Type) (r : Rel α α) :
    IsWellOrder α r ↔
      IsLinearOrder α r ∧ ∀ (P : α → Prop), (∃ (x : α), P x) → HasLeast α r P :=
  Iff.intro (fun (h : IsWellOrder α r) => h)
    (fun (h : IsLinearOrder α r ∧ ∀ (P : α → Prop), (∃ (x : α), P x) → HasLeast α r P) => h)

theorem isStrictWellOrder_def (α : Type) (r : Rel α α) :
    IsStrictWellOrder α r ↔ IsStrictOrder α r ∧ IsWellFounded α r :=
  Iff.intro (fun (h : IsStrictWellOrder α r) => h)
    (fun (h : IsStrictOrder α r ∧ IsWellFounded α r) => h)

-- ── 取用子（accessor）：把四个序类拆回性质，**参数一次给全** ─────────────────
-- ⚠ **为什么要有这一组**（实测换来的）：`And.left h` 得到的是**定义头**类型
-- （`Reflexive α r` 这种），而本语言的 elaborator **不能把一个"展开出来的函数值"
-- 直接应用到实参上**（对一个合取取左支、再把结果喂给 `a` ⇒「期望 `Sort(0)`，实际是定义头」）
-- ⇒ 每个使用点都得写成 `(fun (hr : Reflexive α r) => hr a) (And.left h)`。
-- 把这一层收进库里，上层（单元⑬⑭ 与学习者）就能写 `partialOrder_refl α r h a` ✓。
-- 它们是**纯投影**（删掉名字就是 `And.left`），所以仍是 **L2**，不是练习 ✓
theorem partialOrder_refl (α : Type) (r : Rel α α) (h : IsPartialOrder α r) (a : α) :
    r a a :=
  (fun (hr : Reflexive α r) => hr a) (And.left h)

theorem partialOrder_antisymm (α : Type) (r : Rel α α) (h : IsPartialOrder α r)
    (a b : α) : r a b → r b a → a = b :=
  (fun (ha : Antisymmetric α r) => ha a b) (And.left (And.right h))

theorem partialOrder_trans (α : Type) (r : Rel α α) (h : IsPartialOrder α r)
    (a b c : α) : r a b → r b c → r a c :=
  (fun (ht : Transitive α r) => ht a b c) (And.right (And.right h))

theorem strictOrder_irrefl (α : Type) (r : Rel α α) (h : IsStrictOrder α r) (a : α) :
    ¬ (r a a) :=
  (fun (hi : Irreflexive α r) => hi a) (And.left h)

theorem strictOrder_trans (α : Type) (r : Rel α α) (h : IsStrictOrder α r)
    (a b c : α) : r a b → r b c → r a c :=
  (fun (ht : Transitive α r) => ht a b c) (And.right h)

theorem linearOrder_total (α : Type) (r : Rel α α) (h : IsLinearOrder α r)
    (a b : α) : r a b ∨ r b a :=
  (fun (ht : Total α r) => ht a b) (And.right h)

theorem wellOrder_linear (α : Type) (r : Rel α α) (h : IsWellOrder α r) :
    IsLinearOrder α r :=
  And.left h

theorem wellOrder_hasLeast (α : Type) (r : Rel α α) (h : IsWellOrder α r)
    (P : α → Prop) : (∃ (x : α), P x) → HasLeast α r P :=
  (fun (hw : ∀ (P1 : α → Prop), (∃ (x : α), P1 x) → HasLeast α r P1) => hw P) (And.right h)

-- 严格良序的三条取用子（单元⑭ 用 `strictWellOrder_wellFounded`）✓
theorem strictWellOrder_irrefl (α : Type) (r : Rel α α) (h : IsStrictWellOrder α r) :
    Irreflexive α r :=
  (fun (hs : IsStrictOrder α r ∧ IsWellFounded α r) => And.left (And.left hs)) h

theorem strictWellOrder_trans (α : Type) (r : Rel α α) (h : IsStrictWellOrder α r) :
    Transitive α r :=
  (fun (hs : IsStrictOrder α r ∧ IsWellFounded α r) => And.right (And.left hs)) h

theorem strictWellOrder_wellFounded (α : Type) (r : Rel α α)
    (h : IsStrictWellOrder α r) : IsWellFounded α r :=
  And.right h

theorem wellFounded_hasMin (α : Type) (r : Rel α α) (h : IsWellFounded α r)
    (P : α → Prop) : (∃ (x : α), P x) → HasMin α r P :=
  (fun (hw : ∀ (P : α → Prop), (∃ (x : α), P x) → HasMin α r P) => hw P)
    (Iff.mp (isWellFounded_def α r) h)

-- 两个翻译函数的**应用**展开（`rfl` 级：定义体是字面 lambda）
theorem strictOf_apply (α : Type) (r : Rel α α) (a b : α) :
    strictOf α r a b ↔ r a b ∧ a ≠ b :=
  Iff.intro (fun (h : strictOf α r a b) => h)
    (fun (h : r a b ∧ a ≠ b) => h)

theorem nonstrictOf_apply (α : Type) (r : Rel α α) (a b : α) :
    nonstrictOf α r a b ↔ r a b ∨ a = b :=
  Iff.intro (fun (h : nonstrictOf α r a b) => h)
    (fun (h : r a b ∨ a = b) => h)

-- ── 智能构造子（把 `And.intro` 的隐式实参反解收进库里）──────────────────────
-- ⚠ **为什么要有这一组**（实测）：单元里直接写
-- `And.intro <refl> (And.intro <anti> <trans>)` 去构造 `IsPartialOrder α r` 时，
-- 期望类型是**定义头**（`IsPartialOrder α r`），本语言的 elaborator 在反解
-- `And` 的隐式实参时会判红（「期望 `Sort(0)`，实际是 `Set α`」）。在**库层**
-- 把这一步做掉，单元就只写 `isPartialOrder_intro α r hrefl hanti htrans` ✓
theorem isPartialOrder_intro (α : Type) (r : α → α → Prop)
    (hrefl : Reflexive α r) (hanti : Antisymmetric α r) (htrans : Transitive α r) :
    IsPartialOrder α r :=
  Iff.mpr (isPartialOrder_def α r) (And.intro hrefl (And.intro hanti htrans))

theorem isStrictOrder_intro (α : Type) (r : α → α → Prop)
    (hirrefl : Irreflexive α r) (htrans : Transitive α r) : IsStrictOrder α r :=
  Iff.mpr (isStrictOrder_def α r) (And.intro hirrefl htrans)

theorem isLinearOrder_intro (α : Type) (r : α → α → Prop)
    (hpartial : IsPartialOrder α r) (htotal : Total α r) : IsLinearOrder α r :=
  Iff.mpr (isLinearOrder_def α r) (And.intro hpartial htotal)

theorem isWellOrder_intro (α : Type) (r : α → α → Prop)
    (hlinear : IsLinearOrder α r)
    (hleast : ∀ (P : α → Prop), (∃ (x : α), P x) → HasLeast α r P) : IsWellOrder α r :=
  Iff.mpr (isWellOrder_def α r) (And.intro hlinear hleast)

theorem isStrictWellOrder_intro (α : Type) (r : α → α → Prop)
    (hs : IsStrictOrder α r) (hwf : IsWellFounded α r) : IsStrictWellOrder α r :=
  Iff.mpr (isStrictWellOrder_def α r) (And.intro hs hwf)

-- ── HasMin / 良基的展开与包装（L2；与上面四个序类的 `…_intro` 同一族）────────
-- ⚠ 为什么同样要有这一组：`HasMin α r P` 是**定义头**的 `∃`，直接写
-- `Exists.intro …` 时前导类型参数反解会判红（G-73 的形状 ②）⇒ 在库层做掉。
theorem hasMin_def (α : Type) (r : α → α → Prop) (P : α → Prop) :
    HasMin α r P ↔ ∃ (m : α), P m ∧ ∀ (y : α), P y → ¬ (r y m) :=
  Iff.intro (fun (h : HasMin α r P) => h)
    (fun (h : ∃ (m : α), P m ∧ ∀ (y : α), P y → ¬ (r y m)) => h)

theorem hasMin_intro (α : Type) (r : α → α → Prop) (P : α → Prop) (m : α)
    (hm : P m) (hmin : ∀ (y : α), P y → ¬ (r y m)) : HasMin α r P :=
  Iff.mpr (hasMin_def α r P)
    (Exists.intro α (fun (m' : α) => P m' ∧ ∀ (y : α), P y → ¬ (r y m')) m
      (And.intro hm hmin))

theorem hasMin_elim (α : Type) (r : α → α → Prop) (P : α → Prop)
    (h : HasMin α r P) : ∃ (m : α), P m ∧ ∀ (y : α), P y → ¬ (r y m) :=
  Iff.mp (hasMin_def α r P) h

theorem hasMin_witness (α : Type) (r : α → α → Prop) (P : α → Prop)
    (h : HasMin α r P) : ∃ (m : α), P m :=
  Exists.elim (hasMin_elim α r P h)
    (fun (m : α) (hm : P m ∧ ∀ (y : α), P y → ¬ (r y m)) =>
      Exists.intro α P m (And.left hm))

theorem isWellFounded_intro (α : Type) (r : α → α → Prop)
    (h : ∀ (P : α → Prop), (∃ (x : α), P x) → HasMin α r P) : IsWellFounded α r :=
  Iff.mpr (isWellFounded_def α r) h

-- ── HasLeast 的四件套（与 `HasMin` 同款；**非严格序用它** ✓）──────────────────
theorem hasLeast_def (α : Type) (r : α → α → Prop) (P : α → Prop) :
    HasLeast α r P ↔ ∃ (m : α), P m ∧ ∀ (y : α), P y → r m y :=
  Iff.intro (fun (h : HasLeast α r P) => h)
    (fun (h : ∃ (m : α), P m ∧ ∀ (y : α), P y → r m y) => h)

theorem hasLeast_intro (α : Type) (r : α → α → Prop) (P : α → Prop) (m : α)
    (hm : P m) (hleast : ∀ (y : α), P y → r m y) : HasLeast α r P :=
  Iff.mpr (hasLeast_def α r P)
    (Exists.intro α (fun (m1 : α) => P m1 ∧ ∀ (y : α), P y → r m1 y) m
      (And.intro hm hleast))

theorem hasLeast_elim (α : Type) (r : α → α → Prop) (P : α → Prop)
    (h : HasLeast α r P) : ∃ (m : α), P m ∧ ∀ (y : α), P y → r m y :=
  Iff.mp (hasLeast_def α r P) h

theorem hasLeast_witness (α : Type) (r : α → α → Prop) (P : α → Prop)
    (h : HasLeast α r P) : ∃ (m : α), P m :=
  Exists.elim (hasLeast_elim α r P h)
    (fun (m : α) (hm : P m ∧ ∀ (y : α), P y → r m y) =>
      Exists.intro α P m (And.left hm))

-- ── 空关系（Mathlib `EmptyRelation`；下面两道反例题的样板）────────────────────
def EmptyRelation (α β : Type) : α → β → Prop :=
  fun (x : α) (y : β) => False

-- ── 等价关系（Enderton §3.5 / Halmos §10 的词汇；L2：三条的合取）──────────────
def IsEquivalence (α : Type) (r : α → α → Prop) : Prop :=
  Reflexive α r ∧ Symmetric α r ∧ Transitive α r

theorem isEquivalence_def (α : Type) (r : α → α → Prop) :
    IsEquivalence α r ↔ Reflexive α r ∧ Symmetric α r ∧ Transitive α r :=
  Iff.intro (fun (h : IsEquivalence α r) => h)
    (fun (h : Reflexive α r ∧ Symmetric α r ∧ Transitive α r) => h)

-- 三条取用子（**参数一次给全**；同 G-73 的处置）
theorem equivalence_refl (α : Type) (r : α → α → Prop) (h : IsEquivalence α r) :
    Reflexive α r :=
  And.left h

theorem equivalence_symm (α : Type) (r : α → α → Prop) (h : IsEquivalence α r) :
    Symmetric α r :=
  And.left (And.right h)

theorem equivalence_trans (α : Type) (r : α → α → Prop) (h : IsEquivalence α r) :
    Transitive α r :=
  And.right (And.right h)

theorem isEquivalence_intro (α : Type) (r : α → α → Prop)
    (hrefl : Reflexive α r) (hsymm : Symmetric α r) (htrans : Transitive α r) :
    IsEquivalence α r :=
  Iff.mpr (isEquivalence_def α r) (And.intro hrefl (And.intro hsymm htrans))

-- ── 上界 / 下界 / 上确界 / 下确界（Enderton §7.1 · Halmos §14 的词汇；L2）────────
-- 读法：`A : α → Prop` 就是 `Set α`（本卷的谓词式口径），所以这四个定义**不必** import lib.Set ✓
-- `IsSup` = "是上界，而且比**任何**上界都小"（最小上界）；`IsInf` 对偶 ✓
def UpperBound (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) : Prop :=
  ∀ (a : α), A a → r a b

def LowerBound (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) : Prop :=
  ∀ (a : α), A a → r b a

def IsSup (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) : Prop :=
  UpperBound α r A b ∧ ∀ (c : α), UpperBound α r A c → r b c

def IsInf (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) : Prop :=
  LowerBound α r A b ∧ ∀ (c : α), LowerBound α r A c → r c b

-- 展开引理（L2：证明都是恒等函数）
theorem upperBound_def (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) :
    UpperBound α r A b ↔ ∀ (a : α), A a → r a b :=
  Iff.intro (fun (h : UpperBound α r A b) => h) (fun (h : ∀ (a : α), A a → r a b) => h)

theorem lowerBound_def (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) :
    LowerBound α r A b ↔ ∀ (a : α), A a → r b a :=
  Iff.intro (fun (h : LowerBound α r A b) => h) (fun (h : ∀ (a : α), A a → r b a) => h)

theorem isSup_def (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) :
    IsSup α r A b ↔ UpperBound α r A b ∧ ∀ (c : α), UpperBound α r A c → r b c :=
  Iff.intro (fun (h : IsSup α r A b) => h)
    (fun (h : UpperBound α r A b ∧ ∀ (c : α), UpperBound α r A c → r b c) => h)

theorem isInf_def (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α) :
    IsInf α r A b ↔ LowerBound α r A b ∧ ∀ (c : α), LowerBound α r A c → r c b :=
  Iff.intro (fun (h : IsInf α r A b) => h)
    (fun (h : LowerBound α r A b ∧ ∀ (c : α), LowerBound α r A c → r c b) => h)

-- 取用子 / 构造子（L2：同 G-73 的处置，参数一次给全）
theorem isSup_upper (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α)
    (h : IsSup α r A b) : UpperBound α r A b :=
  And.left h

theorem isSup_least (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α)
    (h : IsSup α r A b) : ∀ (c : α), UpperBound α r A c → r b c :=
  And.right h

theorem isInf_lower (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α)
    (h : IsInf α r A b) : LowerBound α r A b :=
  And.left h

theorem isInf_greatest (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α)
    (h : IsInf α r A b) : ∀ (c : α), LowerBound α r A c → r c b :=
  And.right h

theorem isSup_intro (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α)
    (hub : UpperBound α r A b) (hleast : ∀ (c : α), UpperBound α r A c → r b c) :
    IsSup α r A b :=
  And.intro hub hleast

theorem isInf_intro (α : Type) (r : α → α → Prop) (A : α → Prop) (b : α)
    (hlb : LowerBound α r A b) (hgreatest : ∀ (c : α), LowerBound α r A c → r c b) :
    IsInf α r A b :=
  And.intro (LowerBound α r A b) (∀ (c : α), LowerBound α r A c → r c b) hlb hgreatest  -- soko:notation-ok: G-73 形状 ②/③：前导 Prop 实参或 `Eq`/广义并的记法在这些位置解不出来，必须点名

-- ── 单调 / 反射（Enderton §7.1 的 order-preserving map；L2：一行定义）──────────────
def Monotone (α β : Type) (r : α → α → Prop) (s : β → β → Prop) (f : α → β) : Prop :=
  ∀ (a b : α), r a b → s (f a) (f b)

-- 读法：**反向保序** —— "像上 `s`，则原像上 `r`"（序同构的另一半）✓
def OrderReflecting (α β : Type) (r : α → α → Prop) (s : β → β → Prop) (f : α → β) : Prop :=
  ∀ (a b : α), s (f a) (f b) → r a b

theorem monotone_def (α β : Type) (r : α → α → Prop) (s : β → β → Prop) (f : α → β) :
    Monotone α β r s f ↔ ∀ (a b : α), r a b → s (f a) (f b) :=
  Iff.intro (fun (h : Monotone α β r s f) => h)
    (fun (h : ∀ (a b : α), r a b → s (f a) (f b)) => h)

theorem orderReflecting_def (α β : Type) (r : α → α → Prop) (s : β → β → Prop) (f : α → β) :
    OrderReflecting α β r s f ↔ ∀ (a b : α), s (f a) (f b) → r a b :=
  Iff.intro (fun (h : OrderReflecting α β r s f) => h)
    (fun (h : ∀ (a b : α), s (f a) (f b) → r a b) => h)

theorem monotone_apply (α β : Type) (r : α → α → Prop) (s : β → β → Prop) (f : α → β)
    (h : Monotone α β r s f) (a b : α) (hab : r a b) : s (f a) (f b) :=
  (fun (hu : ∀ (x y : α), r x y → s (f x) (f y)) => hu a b hab) h

theorem reflecting_apply (α β : Type) (r : α → α → Prop) (s : β → β → Prop) (f : α → β)
    (h : OrderReflecting α β r s f) (a b : α) (hab : s (f a) (f b)) : r a b :=
  (fun (hu : ∀ (x y : α), s (f x) (f y) → r x y) => hu a b hab) h

-- ── 逐点序（函数空间上的序；Enderton §7.1 的练习、Mathlib `Pi.instLE` 同款）────────
-- 读法：`f ≤ g` 逐点成立。**注意**：它一般**不是**偏序 —— 反对称要**函数外延**
-- （`(∀ a, f a = g a) → f = g`）—— 本语言**有**（`lib.Extensionality` 的 `funext` ✓）⇒ 单元㉜ 里
-- 只证"逐点"形态的结论 ✓
def PointwiseLe (α β : Type) (r : β → β → Prop) (f g : α → β) : Prop :=
  ∀ (a : α), r (f a) (g a)

theorem pointwiseLe_def (α β : Type) (r : β → β → Prop) (f g : α → β) :
    PointwiseLe α β r f g ↔ ∀ (a : α), r (f a) (g a) :=
  Iff.intro (fun (h : PointwiseLe α β r f g) => h)
    (fun (h : ∀ (a : α), r (f a) (g a)) => h)

theorem pointwiseLe_apply (α β : Type) (r : β → β → Prop) (f g : α → β)
    (h : PointwiseLe α β r f g) (a : α) : r (f a) (g a) :=
  (fun (hu : ∀ (a' : α), r (f a') (g a')) => hu a) h

-- ── 良基递归（`Acc`）────────────────────────────────────────────────────────
-- 台账 **G-56**（「`Acc` 立不起来 ⇒ 语言里没有良基递归」）**已修** ⇒ 现在可以在库里
-- 声明它、并用它的**归纳原理**做证明。它是**带索引**的归纳（下标在返回位）：
-- `Acc α r : α → Prop`；派生的 `Acc.rec` 的 motive 吃 `(x : α)` 与 `Acc α r x` 两个参数
-- ⇒ 库把它包成课程惯用的 `acc_ind`（motive 只吃 `x`）。
inductive Acc (α : Type) (r : α → α → Prop) : α → Prop
ctor Acc.intro (x : α) (h : ∀ (y : α), r y x → Acc α r y) : Acc α r x
end

-- **良基归纳**：`Acc` 上的归纳原理（`step` 只需在"所有前驱都成立"的前提下证 `x`）。
theorem acc_ind (α : Type) (r : α → α → Prop) (motive : α → Prop)
    (step : ∀ (x : α), (∀ (y : α), r y x → motive y) → motive x) :
    ∀ (x : α), Acc α r x → motive x :=
  fun (x : α) (h : Acc α r x) =>
    Acc.rec α r (fun (z : α) (_ : Acc α r z) => motive z)
      (fun (z : α) (hz : ∀ (y : α), r y z → Acc α r y)
        (ih : ∀ (y : α) (hy : r y z), motive y) => step z ih) x h

-- **递归定义的唯一性**（良基关系的教科书定理）：两条满足同一递归方程的函数在 `Acc` 上
-- 处处相等 —— 证明只用 `acc_ind` ✓（**不需要选择公理** ✓）。
theorem acc_unique (α : Type) (β : Type) (r : α → α → Prop) (f : α → β) (g : α → β)
    (spec : ∀ (x : α), (∀ (y : α), r y x → f y = g y) → f x = g x) :
    ∀ (x : α), Acc α r x → f x = g x :=
  acc_ind α r (fun (x : α) => f x = g x)
    (fun (x : α) (ih : ∀ (y : α), r y x → f y = g y) => spec x ih)

-- **取用子**：`Acc α r x` 的**前驱都可达** ✓ —— 注意它**不能**由 `acc_ind` 得到
-- （那里的 motive 只吃 `x`，归纳假设拿不到"前驱的 `Acc`"）⇒ 直接用 `Acc.rec` 的
-- **下标感知** motive（吃 `x` 与 `Acc α r x` 两个参数）。
theorem acc_inv (α : Type) (r : α → α → Prop) (x : α) (h : Acc α r x) :
    ∀ (y : α), r y x → Acc α r y :=
  Acc.rec α r (fun (z : α) (_ : Acc α r z) => ∀ (y : α), r y z → Acc α r y)
    (fun (z : α) (hz : ∀ (y : α), r y z → Acc α r y)
      (_ih : ∀ (y : α) (hy : r y z), ∀ (v : α), r v y → Acc α r v) => hz) x h
