-- ============================================================================
-- C-112 进展件（**WIP** · 2026-10-02 第 687 轮）—— Cantor–Bernstein 的**迭代/并集版链构造**
--
-- ⚠ 这是**进展件、不是单元**：不登记进 `course.json`、门禁不判它 ✓。
--    重放：`python3 /tmp/soko/bisect.py <本文件>` ✓（bisect 目标在此目录 ⇒ 探针落在
--    `gaps/zzprobe.sokonanoda` ✓ —— 别忘了删这一处 ✓）。
--
-- ✅ **交集版是错的（上一轮实测 ✓，留作反面教材）**：`K(C) = A∖g(B) ∪ g(B∖f(C))` 对 `C`
--    **反单调** ✗ ⇒ "取交集"的 `cb_core_step` 需要 `b ∉ f '' C`，而手里只有
--    `b ∉ f '' cbCore` + `cbCore ⊆ C` ⇒ 单调性方向相反 ⇒ **假命题** ✗（内核顶回来是对的 ✓）。
-- ✅ **本轮实测：迭代/并集版 5 条全绿** ✓（`Aseq` · `cbChain` · `cb_chain_start` ·
--    `cb_chain_mono` · **`cb_chain_step`** ✓）—— `cb_chain_step` 的关键正是
--    「`Aseq 0 ⊆ cbChain` ⇒ `f '' (Aseq 0) ⊆ f '' cbChain` ⇒ 从 `b ∉ f '' cbChain`
--    回收到 `b ∉ f '' (Aseq 0)`」✓（**交集版缺的就是这一方向** ✗）。
-- ⚠ 两个"读签名"级的坑（本件换来 ✓）：像 `g '' D`（`D : Set β`）的**见证在 `β`** ✗
--    （写成 `α` 会报宇宙不符 `Set.[] $9` vs `Set.[] $8` ✓）；包装引理里 `sInter` 是 `def`
--    ⇒ 直接用 `h` ✓ 不必碰 `Iff` ✓。
-- ✅ **本轮的迭代/并集版（Halmos ✓）**：`Aseq : Nat → Set α` 用 `Nat.rec` 递归 ✓
--    （`Aseq 0 = A` ✓；`Aseq (n+1) = g '' (B ∖ f '' (Aseq n))` ✓），`cbChain = ⋃ₙ Aseq n` ✓
--    —— 关键：此时 `Aseq n ⊆ cbChain` ✓ ⇒ `f '' (Aseq n) ⊆ f '' cbChain` ✓ ⇒
--    **单调性方向正好是对的** ✓（这正是交集版缺的那一步 ✓）。
--
-- ⚠⚠ **偏离标注（原样保留、不许弱化）**：**本课的 CB 经选择公理**（后面用 `choice` 从
--    "全 + 单值"的**关系版图**里取双射函数 ✓）；而 **CB 数学上不需要选择** ✗
--    ⇒ **这是偏离，不是"标准证法"** ✓。零公理的 CB 要 `Exists`→Type 的安全消去
--    （**G-6** 一族，仍 open ✗）。**为什么必须绕**：CB 双射的**直接定义**要按 `x ∈ C₀` 分支
--    ⇒ Prop→Type 情形分析 ⇒ 判红（判据 `gaps/C-112-cb-direct-def-reject.sokonanoda` ✓）。
-- ============================================================================
import lib.Set
import lib.Image
import lib.SUnion
import lib.Rel
import lib.Equiv
import lib.Choice

def Aseq (α : Type) (β : Type) (A : Set α) (B : Set β) (f : α → β) (g : β → α) :
    Nat → Set α :=
  Nat.rec (fun (_ : Nat) => Set α) A
    (fun (n : Nat) (ih : Set α) => g '' (B \ f '' ih))

def cbChain (α : Type) (β : Type) (A : Set α) (B : Set β) (f : α → β) (g : β → α) :
    Set α :=
  fun (x : α) => ∃ (n : Nat), x ∈ Aseq α β A B f g n

theorem cb_chain_start (α : Type) (β : Type) (A : Set α) (B : Set β) (f : α → β) (g : β → α)
    (x : α) (hx : x ∈ A) : x ∈ cbChain α β A B f g :=
  Exists.intro Nat.zero hx

theorem cb_chain_mono (α : Type) (β : Type) (A : Set α) (B : Set β) (f : α → β) (g : β → α)
    (n : Nat) : ∀ (x : α), x ∈ Aseq α β A B f g n → x ∈ cbChain α β A B f g :=
  fun (x : α) (hx : x ∈ Aseq α β A B f g n) =>
    Exists.intro n hx

theorem cb_chain_step (α : Type) (β : Type) (A : Set α) (B : Set β) (f : α → β) (g : β → α)
    (b : β) (hb : b ∈ B) (hbf : ¬ (b ∈ f '' (cbChain α β A B f g))) :
    g b ∈ cbChain α β A B f g :=
-- soko:notation-ok: 引擎边界：前导命题在 def-headed 假设/期望类型上补不出来（逐处实测判红）
  Exists.intro Nat (fun (n : Nat) => g b ∈ Aseq α β A B f g n) (Nat.succ Nat.zero)
    (Exists.intro β
-- soko:notation-ok: 等式族证明项的宇宙层级（手册明说的边界）
      (fun (y : β) => y ∈ (B \ f '' (Aseq α β A B f g Nat.zero)) ∧ Eq.{1} α (g y) (g b))
      b
-- soko:notation-ok: 等式族证明项的宇宙层级（手册明说的边界）
      (And.intro (b ∈ (B \ f '' (Aseq α β A B f g Nat.zero))) (Eq.{1} α (g b) (g b))
-- soko:notation-ok: 引擎边界：前导命题在 def-headed 假设/期望类型上补不出来（逐处实测判红）
        (And.intro (b ∈ B) (¬ (b ∈ f '' (Aseq α β A B f g Nat.zero))) hb
          (fun (hbA : b ∈ f '' (Aseq α β A B f g Nat.zero)) =>
            hbf (Set.image_mono f (Aseq α β A B f g Nat.zero) (cbChain α β A B f g)
              (cb_chain_mono α β A B f g Nat.zero) b hbA)))
        (Eq.refl.{1} α (g b))))
