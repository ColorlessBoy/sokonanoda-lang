-- ============================================================================
-- C-04 **对照件** —— **期望判绿**
--
-- 与 `C-04-prop-to-type-reject.sokonanoda` 同一种"按 `em` 分情况"，唯一的差别是
-- **动机位落在 `Prop`**（`P ∨ ¬ P`）而不是 `Type`。
-- ⇒ 它判绿说明：被拒的**不是**"分情况"本身，而是**往 `Type` 消去**这一件事。
-- 反向验证见 `C-04-prop-to-type.sh`：若本文件判红，说明小消去坏了（另一类回归）。
-- ============================================================================
import lib.Set
import lib.Rel
import lib.Order

theorem p_case_prop (P : Prop) (h : P ∨ ¬ P) : P ∨ ¬ P :=
  Or.elim P (¬ P) (P ∨ ¬ P)
    (fun (hp : P) => Or.inl P (¬ P) hp)
    (fun (hnp : ¬ P) => Or.inr P (¬ P) hnp) h
