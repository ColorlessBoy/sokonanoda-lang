-- 单元㉙ 有理数的序：代表元公式与自反性
--
-- 卷 II 把 ℚ 建成 Quot ratRel（单元⑳），并在代表元层结清了加法与乘法的良定义性
-- （㉖–㉘）。接下来进入 ℚ 的性质：序、绝对值、幂、间隙。先做序，因为后面的
-- 绝对值与极限都要用它。
--
-- 序的定义沿用整数序的同一套想法：(a-b)/(m+1) ≤ (c-d)/(n+1) 等价于交叉相乘后的
-- ℕ 不等式 a·(n+1) + d·(m+1) ≤ c·(m+1) + b·(n+1)。右边不是笔误：(a-b)(n+1) ≤
-- (c-d)(m+1) 移项后，负部 -b(n+1) 与 -d(m+1) 都搬到对面。分母 (m+1)(n+1) 是正的，
-- 所以交叉相乘不改变方向。
--
-- 这里先立起序的定义、自反、以及「相等蕴含序」；传递性、全序与加法/乘法相容都要
-- 先把两个代表元换到公分母，留给后续单元。

import lib.Rat

-- 有理数的非严格序：交叉相乘后的 ℕ 不等式。
def ratLeRep (x y : ratRep) : Prop :=
  leRep (mulRep (numOf x) (den (denOf y)))
        (mulRep (numOf y) (den (denOf x)))

-- 严格序：≤ 且不相等（相等仍用商上的 `ratRel` 表达）。
def ratLtRep (x y : ratRep) : Prop :=
  ratLeRep x y ∧ ¬ ratRel x y

-- ─────────────────────────────────────────────────────────────
-- ㉙.1 序的自反性
-- ─────────────────────────────────────────────────────────────

-- -- 先看最平凡的一条：任何有理数都不小于自己。
-- soko:hint 目标形态：`ratLeRep x x`。
-- soko:hint 关键件：leRep_refl。
theorem ratLeRep_refl (x : ratRep) : ratLeRep x x :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- ㉙.2 相等蕴含序
-- ─────────────────────────────────────────────────────────────

-- -- 再证相等蕴含序：相等时两个交叉乘积的整数相等，序的良定义性把它搬过来。
-- soko:hint 目标形态：`ratRel x y → ratLeRep x y`。
-- soko:hint 关键件：leRep_wd_pair · intRel_refl · leRep_refl。
theorem ratLeRep_of_ratRel (x y : ratRep) (h : ratRel x y) : ratLeRep x y :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- ㉙.3 具体数字：0 ≤ 1
-- ─────────────────────────────────────────────────────────────

-- -- 具体算一个：0 ≤ 1。
-- soko:hint 目标形态：`ratLeRep (qrep 0 0 0) (qrep 1 0 0)`。
-- soko:hint 关键件：le_succ · le_refl。
theorem demo_zero_le_one :
    ratLeRep (qrep Nat.zero Nat.zero Nat.zero) (qrep 1 Nat.zero Nat.zero) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- ㉙.4 具体数字：1/2 ≤ 3/4
-- ─────────────────────────────────────────────────────────────

-- -- 再算 1/2 ≤ 3/4。
-- soko:hint 目标形态：`ratLeRep (qrep 1 0 1) (qrep 3 0 3)`。
-- soko:hint 关键件：le_succ · le_refl。
theorem demo_half_le_three_quarters :
    ratLeRep (qrep 1 Nat.zero 1) (qrep 3 Nat.zero 3) :=
  sorry
