-- 单元163 阿基米德性质：反复相加总能超过
--
-- 要把面积误差压到 ε 以下，靠的是把区间切得足够细。切得够不够细，取决
-- 于同一个问题：一个正数反复相加，能不能超过区间长度？如果无论加多少次
-- 都超不过 b - a，那么段数再多也只能覆盖很窄的一段，误差压不下去。
--
-- 在有理数里这件事可以直接算。一个正数写成 (p - q)/(m+1)，其中 p > q；
-- 把它乘上 (r+1)(m+1)，分式变成 (r+1)(p - q)，而任何待超过的量
-- r/(j+1) 都不超过 r。倍数取得够大，就一定超过。
--
-- 要把这句话写成证明，第一步是把「一个有理数不超过另一个」翻译成整数
-- 乘法的大小比较。交叉相乘之后，两个分母各被消到一边，剩下两条 ℕ 上的
-- 不等式；这一步把分式问题变成算术问题。
--
-- 第二步是 ℕ 上的估计。下面四条事实反复出现：一乘任何数还是它自己；
-- 某数加上一段不会变小；两个至少为 1 的数相乘仍然至少为 1；把一段乘到
-- 两边，大小关系不变。主定理取 n = (r+1)(m+1)，代进交叉相乘的形式后，
-- 待证的不等式变成「一个乘积不超过另一个乘积」，四项各交给上面的一条。
--
-- 严格版本不必重新算：把待超过的量换成它加一，弱序就收紧成严格序。
--
-- 这条性质只管倍数能超过，不谈倒数，也不谈倍数能任意接近某个数；证明停在
-- 有理代表元层。

import lib.Rat
import lib.RatOrder
import lib.RatAbs
import lib.RatZero
import lib.RatRing
import lib.RatMulOrder

-- ─────────────────────────────────────────────────────────────
-- 把正数写成 n/1 的倍数
-- ─────────────────────────────────────────────────────────────

-- 自然数放进有理数：n/1。
def natToRat (n : Nat) : ratRep := qrep n Nat.zero Nat.zero

-- 分母字段：`ratDenRep 0 m` 就是 m。
theorem ratDenRep_zero_left (m : Nat) : ratDenRep Nat.zero m = m :=
  @Eq.trans.{1} Nat
    (ratDenRep Nat.zero m)
    (ratDenRep m Nat.zero)
    m
    (ratDenRep_comm Nat.zero m)
    (ratAdd_zero_den m)

-- `n · (p - q)/(m+1) = (n·p - n·q)/(m+1)`：分子两个坐标各用 `myMul 0` 的零律。
theorem natToRat_mul_rep (n p q m : Nat) :
    ratMulRep (natToRat n) (qrep p q m) =
      qrep (myMul n p) (myMul n q) m :=
  @Eq.trans.{1} ratRep
    (ratMulRep (natToRat n) (qrep p q m))
    (qrep
      (Nat.add (myMul n p) (myMul Nat.zero q))
      (Nat.add (myMul n q) (myMul Nat.zero p))
      (ratDenRep Nat.zero m))
    (qrep (myMul n p) (myMul n q) m)
    (@Eq.refl.{1} ratRep
      (qrep
        (Nat.add (myMul n p) (myMul Nat.zero q))
        (Nat.add (myMul n q) (myMul Nat.zero p))
        (ratDenRep Nat.zero m)))
    (qrep_congr
      (Nat.add (myMul n p) (myMul Nat.zero q))
      (myMul n p)
      (Nat.add (myMul n q) (myMul Nat.zero p))
      (myMul n q)
      (ratDenRep Nat.zero m)
      m
      (@Eq.trans.{1} Nat
        (Nat.add (myMul n p) (myMul Nat.zero q))
        (Nat.add (myMul n p) Nat.zero)
        (myMul n p)
        (@congrArg.{1} Nat Nat (myMul Nat.zero q) Nat.zero
          (fun (z : Nat) => Nat.add (myMul n p) z) (zero_mul q))
        (add_zero (myMul n p)))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul n q) (myMul Nat.zero p))
        (Nat.add (myMul n q) Nat.zero)
        (myMul n q)
        (@congrArg.{1} Nat Nat (myMul Nat.zero p) Nat.zero
          (fun (z : Nat) => Nat.add (myMul n q) z) (zero_mul p))
        (add_zero (myMul n q)))
      (ratDenRep_zero_left m))

-- 零作左因子：交叉相乘的第一半是 (0,0)。
theorem leNum_zero_lit (a b m : Nat) :
    leNum ratZeroRep (qrep a b m) = @prod_mk Nat Nat Nat.zero Nat.zero :=
  mulRep_zero_pair (Nat.succ m) Nat.zero

-- 零作右因子：交叉相乘的第二半是原来的分子。
theorem leNum_lit_zero (a b m : Nat) :
    leNum (qrep a b m) ratZeroRep = @prod_mk Nat Nat a b :=
  prod_mk_congr
    (Nat.add (myMul a (Nat.succ Nat.zero)) (myMul b Nat.zero))
    a
    (Nat.add (myMul a Nat.zero) (myMul b (Nat.succ Nat.zero)))
    b
    (@Eq.trans.{1} Nat
      (Nat.add (myMul a (Nat.succ Nat.zero)) (myMul b Nat.zero))
      (Nat.add (Nat.add a Nat.zero) Nat.zero)
      a
      (@Eq.refl.{1} Nat (Nat.add (Nat.add a Nat.zero) Nat.zero))
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add a Nat.zero) Nat.zero)
        (Nat.add a Nat.zero)
        a
        (add_zero (Nat.add a Nat.zero))
        (add_zero a)))
    (@Eq.trans.{1} Nat
      (Nat.add (myMul a Nat.zero) (myMul b (Nat.succ Nat.zero)))
      (Nat.add Nat.zero (Nat.add b Nat.zero))
      b
      (@Eq.refl.{1} Nat (Nat.add Nat.zero (Nat.add b Nat.zero)))
      (@Eq.trans.{1} Nat
        (Nat.add Nat.zero (Nat.add b Nat.zero))
        (Nat.add b Nat.zero)
        b
        (zero_add (Nat.add b Nat.zero))
        (add_zero b)))

-- ─────────────────────────────────────────────────────────────
-- 把「0 ≤ x」化成整数的大小
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：把 `ratLeRep` 展开成 `leRep (leNum …) (leNum …)`，再用两条已给的交叉相乘公式把两个 `leNum` 换成 (0,0) 与 (a,b)；剩下的 `0 + b ≤ a + 0` 用 `zero_add` 与 `add_zero` 消掉。
-- soko:hint 目标形态：`ratLeRep ratZeroRep (qrep a b m) ↔ LeNat b a`。
-- soko:hint 关键件：leNum_zero_lit · leNum_lit_zero · zero_add · add_zero · Eq.subst。
theorem ratLeRep_zero_lit (a b m : Nat) :
    ratLeRep ratZeroRep (qrep a b m) ↔ LeNat b a :=
  sorry

-- soko:hint 思路：分子两格相等就把这个有理数认成零：先由 `ratRel_zero_iff_num_zero` 得到「分子序对与 (0,0) 相等」，这条等式在 `b = a` 时由 `add_zero` 与 `zero_add` 拼出来；最后用对称性换成 `0 ~ x` 的方向。
-- soko:hint 目标形态：`ratRel ratZeroRep (qrep a b m)`。
-- soko:hint 关键件：ratRel_zero_iff_num_zero · ratRel_symm · add_zero · zero_add · Eq.trans。
theorem ratRel_zero_of_num_eq (a b m : Nat) (h : b = a) :
    ratRel ratZeroRep (qrep a b m) :=
  sorry

-- soko:hint 思路：先由上一条得到 `b ≤ a`；`b = a` 那一支与「不相等」撞上矛盾，于是 `leNat_eq_or_succ` 只能给出 `b + 1 ≤ a`。
-- soko:hint 目标形态：`LeNat (Nat.succ b) a`。
-- soko:hint 关键件：ratLeRep_zero_lit · leNat_eq_or_succ · ratRel_zero_of_num_eq · False.elim。
theorem ratLtRep_zero_num (a b m : Nat)
    (h : ratLtRep ratZeroRep (qrep a b m)) : LeNat (Nat.succ b) a :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 阿基米德性质
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：由正性取 `p = q + (k+1)`，由非负取 `r = s + u`；倍数取 n = (r+1)(m+1)。代进交叉相乘的形式后，`n·p` 拆成 `n·q + n·(k+1)`，`r` 拆成 `s + u`，公共项两两对齐，剩下的 `u(m+1) ≤ n(k+1)(j+1)` 由「u ≤ r < r+1 ≤ n」与「两个至少为 1 的因子」两步乘出来。
-- soko:hint 目标形态：`∃ n, ratLeRep (qrep r s j) (ratMulRep (natToRat n) (qrep p q m))`。
-- soko:hint 关键件：ratLtRep_zero_num · ratLeRep_zero_lit · leNat_exists_add · mul_add · mul_add_right · succ_mul · leNat_mul_right · leNat_trans · ratLeRep_lit。
theorem arch_le_lit (p q m : Nat) (hpq : ratLtRep ratZeroRep (qrep p q m))
    (r s j : Nat) (hc : ratLeRep ratZeroRep (qrep r s j)) :
    ∃ (n : Nat), ratLeRep (qrep r s j)
      (ratMulRep (natToRat n) (qrep p q m)) :=
  sorry

-- soko:hint 思路：任意代表元是三个分量，按「分母字段在外、分子序对在内」两层 `match` 拆开，两条前提的类型跟着变成字面形式，直接交给字面版本。前提要写在 `match` 里面的 `fun` 上，否则内核看不到替换后的形状。
-- soko:hint 目标形态：`ratLtRep ratZeroRep x → ratLeRep ratZeroRep c → ∃ n, ratLeRep c (ratMulRep (natToRat n) x)`。
-- soko:hint 关键件：arch_le_lit · 两层 match · 前提写成 fun 的绑定点。
theorem arch_le (x c : Prod (Prod Nat Nat) Nat) :
    ratLtRep ratZeroRep x → ratLeRep ratZeroRep c →
      ∃ (n : Nat), ratLeRep c (ratMulRep (natToRat n) x) :=
  sorry

-- soko:hint 思路：把待超过的量换成 `c + 1` 再取倍数，得到 `c + 1 ≤ n·x`；另一侧 `c < c + 1` 由「0 < 1 加在右边」得到，两条一夹就是 `c < n·x`。
-- soko:hint 目标形态：`∃ n, ratLtRep c (ratMulRep (natToRat n) x)`。
-- soko:hint 关键件：arch_le · ratLeRep_zero_add_nonneg · ratLtRep_zero_one · ratLtRep_self_add_pos · ratLtRep_of_lt_le。
theorem arch_lt_of_nonneg (x c : ratRep) (hx : ratLtRep ratZeroRep x)
    (hc : ratLeRep ratZeroRep c) :
    ∃ (n : Nat), ratLtRep c (ratMulRep (natToRat n) x) :=
  sorry

-- soko:hint 思路：待证形式换成字面比较：左边是 1/1，右边是 2·1/2；交叉相乘后两边都是 2，交给自反的弱序。
-- soko:hint 目标形态：`ratLeRep ratOneRep (ratMulRep (natToRat 2) (qrep 1 Nat.zero (Nat.succ Nat.zero)))`。
-- soko:hint 关键件：ratLeRep_lit · le_refl · natToRat_mul_rep。
theorem demo_arch_two :
    ratLeRep ratOneRep
      (ratMulRep (natToRat (Nat.succ (Nat.succ Nat.zero)))
        (qrep 1 Nat.zero (Nat.succ Nat.zero))) :=
  sorry
