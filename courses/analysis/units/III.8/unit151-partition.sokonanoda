-- 单元151 分割：把区间切成有限段
--
-- 要谈曲线下的面积，先得把「区间」变成可以逐段求和的对象。曲线本身有无限
-- 多个点，不能逐点相加；但可以在 a 与 b 之间插进有限多个切点，把整段分成
-- 有限个小段，每一段上用一条水平线近似曲线。切点怎么选，决定了近似的好坏，
-- 也决定了后面能不能把「越来越细」说清楚。
--
-- 这里把分割写成两个部件：段数 n，以及一个给出第 i 个切点的函数。函数只在
-- 0 到 n 这些下标上有义务，段的端点、相邻切点的先后，都由 `IsPartition`
-- 另外规定。切点严格上升，是为了让每一段的长度为正；否则一段可能缩成一点，
-- 面积的和就失去意义。两个切点的分割是最小的样本：左端 a、右端 b。
--
-- 边界：切点取有理代表元，分割停在 `ratRep` 层；还不谈函数的上下和，也不
-- 谈加细。不新增公理。

import lib.Rat
import lib.RatAbs
import lib.Cauchy
import lib.Bounded

-- ─────────────────────────────────────────────────────────────
-- 分割的部件
-- ─────────────────────────────────────────────────────────────

-- 分割由段数与切点函数组成。段数不放在类型参数里，因为后面谈加细时要在
-- 两个不同段数的分割之间作比较。
def Partition : Type := Prod Nat (Nat → ratRep)

def partCount (p : Partition) : Nat := Prod.fst Nat (Nat → ratRep) p

def partPoint (p : Partition) (i : Nat) : ratRep :=
  Prod.snd Nat (Nat → ratRep) p i

-- 合格的分割要求三件事：第一个切点是 a，最后一个切点是 b，相邻切点严格
-- 上升。上升只查到下标 n-1 为止，因为第 n 个切点就是右端点。
def IsPartition (a b : ratRep) (p : Partition) : Prop :=
  partPoint p Nat.zero = a ∧
  partPoint p (partCount p) = b ∧
  (∀ (i : Nat), LeNat (Nat.succ i) (partCount p) →
    ratLtRep (partPoint p i) (partPoint p (Nat.succ i)))

-- ─────────────────────────────────────────────────────────────
-- 定义的三条投影
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：定义是三个合取，左边那条就是第一个分量，直接取。
-- soko:hint 目标形态：`partPoint p 0 = a`。
-- soko:hint 关键件：And.left · 定义性展开。
theorem isPartition_left (a b : ratRep) (p : Partition)
    (h : IsPartition a b p) : partPoint p Nat.zero = a :=
  sorry

-- soko:hint 思路：右端点藏在第二个合取里，先取右边再取左边。
-- soko:hint 目标形态：`partPoint p (partCount p) = b`。
-- soko:hint 关键件：And.right · And.left。
theorem isPartition_right (a b : ratRep) (p : Partition)
    (h : IsPartition a b p) : partPoint p (partCount p) = b :=
  sorry

-- soko:hint 思路：相邻上升是第二个合取的右边，把下标与前提交给它。
-- soko:hint 目标形态：`LeNat (succ i) (partCount p) → ratLtRep (partPoint p i) (partPoint p (succ i))`。
-- soko:hint 关键件：And.right · And.right。
theorem isPartition_step (a b : ratRep) (p : Partition)
    (h : IsPartition a b p) (i : Nat)
    (hi : LeNat (Nat.succ i) (partCount p)) :
    ratLtRep (partPoint p i) (partPoint p (Nat.succ i)) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 两个切点的分割
-- ─────────────────────────────────────────────────────────────

-- 下标 0 放 a，其余下标放 b。段数是 1，所以只有第 0 段，长度是 b - a。
def twoPointAt (a b : ratRep) (i : Nat) : ratRep :=
  match i with
  | Nat.zero => a
  | Nat.succ _ => b

def twoPoint (a b : ratRep) : Partition :=
  @prod_mk Nat (Nat → ratRep) (Nat.succ Nat.zero) (twoPointAt a b)

-- soko:hint 思路：`partPoint` 与 `twoPoint` 都是定义，下标 0 落在第一个分支，直接返回 a。
-- soko:hint 目标形态：`partPoint (twoPoint a b) 0 = a`。
-- soko:hint 关键件：定义性展开 · Eq.refl。
theorem twoPoint_zero (a b : ratRep) :
    partPoint (twoPoint a b) Nat.zero = a :=
  @Eq.refl.{1} ratRep a

-- soko:hint 思路：下标 1 是后继，落在第二个分支；段数也是 1，所以右端点就是 b。
-- soko:hint 目标形态：`partPoint (twoPoint a b) 1 = b`。
-- soko:hint 关键件：定义性展开 · Eq.refl。
theorem twoPoint_one (a b : ratRep) :
    partPoint (twoPoint a b) (Nat.succ Nat.zero) = b :=
  @Eq.refl.{1} ratRep b

-- 两个切点的分割合格，前提是 a 严格小于 b。上升条件只查下标 0：其余下标
-- 已经越过了段数，前提本身不成立。
--
-- soko:hint 思路：对下标归纳。0 时前提 `1 ≤ 1` 成立，结论就是 h；后继下标要满足 `j+2 ≤ 1`，交给 `leNat_pred` 化成 `j+1 ≤ 0`，再由 `leNat_succ_zero_absurd` 排除。
-- soko:hint 目标形态：`∀ i, LeNat (succ i) 1 → ratLtRep (partPoint (twoPoint a b) i) (partPoint (twoPoint a b) (succ i))`。
-- soko:hint 关键件：leNat_pred · leNat_succ_zero_absurd · Nat.rec。
theorem twoPoint_step (a b : ratRep) (h : ratLtRep a b) :
    ∀ (i : Nat), LeNat (Nat.succ i) (partCount (twoPoint a b)) →
      ratLtRep (partPoint (twoPoint a b) i)
        (partPoint (twoPoint a b) (Nat.succ i)) :=
  sorry

-- soko:hint 思路：前两条用 `twoPoint_zero` 与 `twoPoint_one`；上升条件交给 `twoPoint_step`。
-- soko:hint 目标形态：`IsPartition a b (twoPoint a b)`。
-- soko:hint 关键件：twoPoint_zero · twoPoint_one · twoPoint_step · And.intro。
theorem twoPoint_isPartition (a b : ratRep) (h : ratLtRep a b) :
    IsPartition a b (twoPoint a b) :=
  sorry

-- soko:hint 思路：把上一条的三条投影各取一次，得到左端、右端与唯一一段的严格上升。
-- soko:hint 目标形态：`partPoint (twoPoint a b) 0 = a ∧ partPoint (twoPoint a b) 1 = b ∧ ratLtRep a b`。
-- soko:hint 关键件：twoPoint_isPartition · isPartition_left · isPartition_right · isPartition_step。
theorem demo_twoPoint (a b : ratRep) (h : ratLtRep a b) :
    partPoint (twoPoint a b) Nat.zero = a ∧
    partPoint (twoPoint a b) (Nat.succ Nat.zero) = b ∧
    ratLtRep a b :=
  sorry
