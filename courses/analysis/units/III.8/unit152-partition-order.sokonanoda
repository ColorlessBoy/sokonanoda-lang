-- 单元152 切点只往前走：分割上的序
--
-- 分割把 [a, b] 切成有限段，但定义只说相邻两个切点严格上升，没有说隔了几段
-- 的两个切点谁高谁低。估计面积的和时，每一段都要与整个区间比较：段里的点
-- 不能跑到区间外面，左边的切点也不能越过右边的切点。这两件事都要从相邻的
-- 上升一步步传过去。
--
-- 路线是先证明「从第 i 个切点出发，往前走 k 段，函数值不会下降」，再把它
-- 用在「i ≤ j」与「j = i + k」的换算上，得到任意两个有先后次序的切点之间的
-- 弱序。最后把左端点与右端点接上，得到每个切点都落在闭区间里。
--
-- 边界：只谈切点之间的弱序，不谈段的长度为正；后者要另一条严格版本。分割
-- 与 `IsPartition` 在这里重新写一遍，因为每个单元自包含。不新增公理。

import lib.Rat
import lib.RatAbs
import lib.Cauchy
import lib.Bounded
import lib.MaxOn

-- ─────────────────────────────────────────────────────────────
-- 分割的部件
-- ─────────────────────────────────────────────────────────────

def Partition : Type := Prod Nat (Nat → ratRep)

def partCount (p : Partition) : Nat := Prod.fst Nat (Nat → ratRep) p

def partPoint (p : Partition) (i : Nat) : ratRep :=
  Prod.snd Nat (Nat → ratRep) p i

def IsPartition (a b : ratRep) (p : Partition) : Prop :=
  partPoint p Nat.zero = a ∧
  partPoint p (partCount p) = b ∧
  (∀ (i : Nat), LeNat (Nat.succ i) (partCount p) →
    ratLtRep (partPoint p i) (partPoint p (Nat.succ i)))

def twoPointAt (a b : ratRep) (i : Nat) : ratRep :=
  match i with
  | Nat.zero => a
  | Nat.succ _ => b

def twoPoint (a b : ratRep) : Partition :=
  @prod_mk Nat (Nat → ratRep) (Nat.succ Nat.zero) (twoPointAt a b)

-- soko:hint 思路：定义是三个合取，最左边一条直接取。
-- soko:hint 目标形态：`partPoint p 0 = a`。
-- soko:hint 关键件：And.left。
theorem isPartition_left (a b : ratRep) (p : Partition)
    (h : IsPartition a b p) : partPoint p Nat.zero = a :=
  And.left h

-- soko:hint 思路：右端点藏在第二个合取里，先取右边再取左边。
-- soko:hint 目标形态：`partPoint p (partCount p) = b`。
-- soko:hint 关键件：And.right · And.left。
theorem isPartition_right (a b : ratRep) (p : Partition)
    (h : IsPartition a b p) : partPoint p (partCount p) = b :=
  And.left (And.right h)

-- soko:hint 思路：相邻上升是第二个合取的右边。
-- soko:hint 目标形态：`LeNat (succ i) (partCount p) → ratLtRep (partPoint p i) (partPoint p (succ i))`。
-- soko:hint 关键件：And.right · And.right。
theorem isPartition_step (a b : ratRep) (p : Partition)
    (h : IsPartition a b p) (i : Nat)
    (hi : LeNat (Nat.succ i) (partCount p)) :
    ratLtRep (partPoint p i) (partPoint p (Nat.succ i)) :=
  (And.right (And.right h)) i hi

-- ─────────────────────────────────────────────────────────────
-- 往前走 k 段不会下降
-- ─────────────────────────────────────────────────────────────

-- 对 k 归纳。k = 0 时下标不动，用自反性。k + 1 时先把前 k 段的弱序拿到，
-- 再接上第 k 段到第 k+1 段的严格上升；严格上升投成弱序，两条用传递性串起来。
-- 前提 `i + k ≤ n` 在两处都要用：归纳假设要它，上升条件也要它。
--
-- soko:hint 思路：对 k 归纳。零情形下标 `i + 0` 定义性地等于 i，返回 `ratLeRep_refl`。后继情形先用 `leNat_trans` 把 `i + k ≤ i + (k+1)` 与已知的 `i + (k+1) ≤ n` 接起来，喂给归纳假设；再把 `isPartition_step` 用在 `i + k` 上，经 `ratLtRep_le` 投成弱序，最后 `ratLeRep_trans`。
-- soko:hint 目标形态：`LeNat (i + k) (partCount p) → ratLeRep (partPoint p i) (partPoint p (i + k))`。
-- soko:hint 关键件：ratLeRep_refl · leNat_trans · le_succ · isPartition_step · ratLtRep_le · ratLeRep_trans · Nat.rec。
theorem point_le_add (a b : ratRep) (p : Partition) (hp : IsPartition a b p)
    (i k : Nat) (h : LeNat (Nat.add i k) (partCount p)) :
    ratLeRep (partPoint p i) (partPoint p (Nat.add i k)) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 任意两个有先后次序的切点
-- ─────────────────────────────────────────────────────────────

-- `i ≤ j` 时把 j 写成 i + k，再把上一条的结论沿这个等式搬到 j 上。两个
-- `Eq.subst` 分别处理结论里的下标与前提里的下标。
--
-- soko:hint 思路：用 `leNat_exists_add i j hij` 取 k 使 `j = i + k`。前提 `j ≤ n` 沿这个等式搬成 `i + k ≤ n`；结论 `point i ≤ point (i+k)` 再沿等式搬回 `point j`。
-- soko:hint 目标形态：`LeNat i j → LeNat j (partCount p) → ratLeRep (partPoint p i) (partPoint p j)`。
-- soko:hint 关键件：leNat_exists_add · point_le_add · Eq.subst。
theorem point_mono (a b : ratRep) (p : Partition) (hp : IsPartition a b p)
    (i j : Nat) (hij : LeNat i j) (hj : LeNat j (partCount p)) :
    ratLeRep (partPoint p i) (partPoint p j) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 每个切点都落在闭区间里
-- ─────────────────────────────────────────────────────────────

-- 左边：`0 ≤ i`，`point_mono` 给出 `point 0 ≤ point i`，再把 `point 0 = a`
-- 沿等式换掉。右边：`i ≤ n`，得到 `point i ≤ point n`，再把 `point n = b`
-- 换掉。
--
-- soko:hint 思路：左半边用 `leNat_zero_le i` 与 `point_mono` 得 `point 0 ≤ point i`，沿 `isPartition_left` 把左端换成 a；右半边用 `point_mono` 得 `point i ≤ point n`，沿 `isPartition_right` 把右端换成 b。
-- soko:hint 目标形态：`InClosed a b (partPoint p i)`。
-- soko:hint 关键件：leNat_zero_le · point_mono · isPartition_left · isPartition_right · Eq.subst · And.intro。
theorem point_in_closed (a b : ratRep) (p : Partition) (hp : IsPartition a b p)
    (i : Nat) (hi : LeNat i (partCount p)) :
    InClosed a b (partPoint p i) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 两个切点的分割
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：对下标归纳。0 时前提 `1 ≤ 1` 成立，结论就是 h；后继下标要满足 `j+2 ≤ 1`，交给 `leNat_pred` 化成 `j+1 ≤ 0`，再由 `leNat_succ_zero_absurd` 排除。
-- soko:hint 目标形态：`∀ i, LeNat (succ i) 1 → ratLtRep (partPoint (twoPoint a b) i) (partPoint (twoPoint a b) (succ i))`。
-- soko:hint 关键件：leNat_pred · leNat_succ_zero_absurd · Nat.rec。
theorem twoPoint_step (a b : ratRep) (h : ratLtRep a b) :
    ∀ (i : Nat), LeNat (Nat.succ i) (partCount (twoPoint a b)) →
      ratLtRep (partPoint (twoPoint a b) i)
        (partPoint (twoPoint a b) (Nat.succ i)) :=
  fun (i : Nat) =>
    Nat.rec
      (fun (i : Nat) =>
        LeNat (Nat.succ i) (partCount (twoPoint a b)) →
          ratLtRep (partPoint (twoPoint a b) i)
            (partPoint (twoPoint a b) (Nat.succ i)))
      (fun (_hi : LeNat (Nat.succ Nat.zero) (partCount (twoPoint a b))) => h)
      (fun (j : Nat)
          (_ih : LeNat (Nat.succ j) (partCount (twoPoint a b)) →
            ratLtRep (partPoint (twoPoint a b) j)
              (partPoint (twoPoint a b) (Nat.succ j)))
          (hbad : LeNat (Nat.succ (Nat.succ j))
            (partCount (twoPoint a b))) =>
        False.elim
          (leNat_succ_zero_absurd j
            (leNat_pred (Nat.succ j) Nat.zero hbad)))
      i

-- soko:hint 思路：前两条是定义性展开；上升条件交给 `twoPoint_step`。
-- soko:hint 目标形态：`IsPartition a b (twoPoint a b)`。
-- soko:hint 关键件：定义性展开 · twoPoint_step · And.intro。
theorem twoPoint_isPartition (a b : ratRep) (h : ratLtRep a b) :
    IsPartition a b (twoPoint a b) :=
  And.intro
    (@Eq.refl.{1} ratRep a)
    (And.intro
      (@Eq.refl.{1} ratRep b)
      (twoPoint_step a b h))

-- soko:hint 思路：下标 0 与 1 是同一段的两端，`point_mono` 给出弱序；`le_succ 0 0` 是 `0 ≤ 1`，`le_refl 1` 是 `1 ≤ 段数`。
-- soko:hint 目标形态：`ratLeRep (partPoint (twoPoint a b) 0) (partPoint (twoPoint a b) 1)`。
-- soko:hint 关键件：twoPoint_isPartition · point_mono · le_succ · le_refl。
theorem demo_twoPoint_mono (a b : ratRep) (h : ratLtRep a b) :
    ratLeRep (partPoint (twoPoint a b) Nat.zero)
      (partPoint (twoPoint a b) (Nat.succ Nat.zero)) :=
  sorry

-- soko:hint 思路：下标 0 落在闭区间里只要 `0 ≤ 1`，把 `a < b` 交给 `twoPoint_isPartition`，再把 `0 ≤ 1` 交给 `point_in_closed`。
-- soko:hint 目标形态：`InClosed a b (partPoint (twoPoint a b) 0)`。
-- soko:hint 关键件：point_in_closed · twoPoint_isPartition · leNat_zero_le。
theorem demo_twoPoint_in_closed (a b : ratRep) (h : ratLtRep a b) :
    InClosed a b (partPoint (twoPoint a b) Nat.zero) :=
  sorry
