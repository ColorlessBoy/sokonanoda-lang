-- 单元① 整数与商构造
--
-- 自然数上减法常常做不了：3-5 在 ℕ 里没有结果。但「差」是有的——3-5 与 4-6
-- 是同一个差，5-2 与 4-1 也是同一个差。要把这种「差」本身变成可运算的对象，
-- 可以把序对 (a,b) 读成 a-b，再把表示同一个差的序对粘成一点；粘出来的东西
-- 就是整数。
--
-- 麻烦在于这个说法不能直接写进定义：定义关系时还不允许用减法。两个差相等的
-- 充要条件是交叉相加相等，(a,b) 与 (c,d) 表示同一个差当且仅当 a+d = b+c；
-- 这个条件只用加法，可以在 ℕ 上直接陈述。把「差相等」作成一个等价关系，
-- 再取商，整数就有了。
--
-- 商上的相等只有一条规则：相关的代表元在商里相等。这条规则后面每证一个
-- 代表元层面的等式，都要用它把等式搬进 ℤ。加法与乘法在这层粘合下是否仍然
-- 良定义、序又怎样定义，是后面几个单元要回答的问题。

import lib.Logic
import lib.Prod

-- 两个序对表示同一个差：a-b = c-d。没有减法可写，就写成 a+d = b+c。
def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

-- 每个整数都是某个序对的类，两个序对属于同一个类当且仅当它们差相等。
def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

-- 自然数 n 在整数里是 n-0，也就是序对 (n,0) 所在的类。
def intOfNat (n : Nat) : Int :=
  @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat n Nat.zero)

-- 先看一个具体例子：2-0 与 3-1 是同一个差，因为 2+1 = 3+0。
theorem demo_intRel :
    intRel (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 3 1) :=
  Eq.refl 3

-- 既然差相等，两个序对在商里就是同一个点。这正是商的相等规则：
-- 相关的代表元在商里相等（Quot.sound）。
theorem demo_quot_sound :
    intOfNat 2 = @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 3 1) :=
  @Quot.sound.{1} (Prod Nat Nat) intRel
    (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 3 1) (Eq.refl 3)

-- 关系是自反的：任意序对与自身的差当然相同。展开定义后两边是同一个
-- Nat 表达式，所以证明项就是 Eq.refl。
-- soko:hint 思路：intRel p p 展开后两边都是同一个 Nat 表达式，直接 Eq.refl。
-- soko:hint 目标形态：Nat.add (fst p) (snd p) = Nat.add (fst p) (snd p)。
-- soko:hint 关键件：Eq.refl。
theorem intRel_refl (p : Prod Nat Nat) : intRel p p :=
  sorry

-- 差相等也是对称的：a+d = b+c 交换两边就是 b+c = a+d。
-- soko:hint 思路：把 intRel 的定义当成「a + d = b + c」，交换两边即可。
-- soko:hint 目标形态：intRel b a 是「b + c = a + d」。
-- soko:hint 关键件：Eq.symm。
theorem intRel_swap (a b : Prod Nat Nat) (h : intRel a b) : intRel b a :=
  sorry

-- 具体到零：0-0 与 1-1 都是零，因为 0+1 = 1+0。两边算出来都是 1。
-- soko:hint 思路：两边算出来都是 1；展开 intRel 后直接 Eq.refl。
-- soko:hint 目标形态：intRel (0,0) (1,1)。
-- soko:hint 关键件：Eq.refl 1。
theorem zero_rel :
    intRel (@prod_mk Nat Nat Nat.zero Nat.zero) (@prod_mk Nat Nat 1 1) :=
  sorry

-- 同一个自然数在整数里有不止一个代表元：2-0 与 3-1 都表示 2。这条练习说明
-- 商里的相等可以这样用：先在代表元上认出两个序对相等，再用 Quot.sound 把
-- 等式搬进 ℤ。
-- soko:hint 思路：和 demo_quot_sound 同一形状；2 - 0 与 3 - 1 相关。
-- soko:hint 目标形态：intOfNat 2 = Quot.mk (3,1)。
-- soko:hint 关键件：Quot.sound；相关性证明是 Eq.refl 3。
theorem intOfNat_sound :
    intOfNat 2 = @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 3 1) :=
  sorry

-- 整数有了，但整数上的加法还只是一堆代表元公式。下一单元要把加法、取负与
-- 减法写成序对上的公式；再下一单元证明它们尊重「差相等」——只有这样，
-- 商上的加法才真正定义得下来。
