-- 单元⑮ 整数序的良定义性
--
-- 单元⑫ 把整数序写成了代表元公式：a-b ≤ c-d 当且仅当 a+d ≤ c+b。要把这个序搬到
-- 商类型 Int 上（Quot.lift），必须先证它不依赖代表元的选择：若 (a,b) ~ (a',b')
-- 且 (c,d) ~ (c',d')，则 leRep (a,b) (c,d) 与 leRep (a',b') (c',d') 同真假。
--
-- 两条假设按定义是两个交叉和等式：Hp : a+b' = b+a'，Hq : c+d' = d+c'。证明的
-- 套路是「把差补平再消掉」：两边同加 b'（或 d'），再用 Hp / Hq 把新加的数搬到
-- 对面，最后用一次序的加法消去律。整个过程只用 ℕ 的加法律、单元⑬的序单调性
-- 与单元⑭的序消去律。
--
-- 证明按「先对称、再逐个坐标、最后当且仅当」的顺序拆开：先确认整数相等的对称性，
-- 再分别处理第一个、第二个坐标，然后把两个坐标合起来，最后把单向蕴含升级成
-- 当且仅当。
import lib.Logic
import lib.Exists
import lib.Prod

inductive LeNat : Nat → Nat → Prop
ctor le_refl (n : Nat) : LeNat n n
ctor le_succ (m : Nat) (n : Nat) : LeNat m n → LeNat m (Nat.succ n)
end

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def leRep (p q : Prod Nat Nat) : Prop :=
  LeNat (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q))
        (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p))

-- 下面四条是单元③证过的 ℕ 加法律，这里重新列出；后面的证明直接引用。
theorem zero_add (b : Nat) :
    Nat.add Nat.zero b = b :=
  Nat.rec (fun (n : Nat) => Nat.add Nat.zero n = n)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Nat.add Nat.zero n = n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add Nat.zero n) = Nat.succ m)
        (Nat.add Nat.zero n) n ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add Nat.zero n))))
    b

theorem succ_add (a b : Nat) :
    Nat.add (Nat.succ a) b = Nat.succ (Nat.add a b) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n))
    (@Eq.refl.{1} Nat (Nat.succ a))
    (fun (n : Nat) (ih : Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.succ a) n) = Nat.succ m)
        (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.succ a) n))))
    b

theorem add_assoc (a b c : Nat) :
    Nat.add (Nat.add a b) c = Nat.add a (Nat.add b c) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n))
    (@Eq.refl.{1} Nat (Nat.add a b))
    (fun (n : Nat) (ih : Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.add a b) n) = Nat.succ m)
        (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a b) n))))
    c

theorem add_comm (a b : Nat) :
    Nat.add a b = Nat.add b a :=
  Nat.rec (fun (n : Nat) => Nat.add a n = Nat.add n a)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero a) a (zero_add a))
    (fun (n : Nat) (ih : Nat.add a n = Nat.add n a) =>
      @Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ (Nat.add n a)) (Nat.add (Nat.succ n) a)
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.succ (Nat.add a n) = Nat.succ m)
          (Nat.add a n) (Nat.add n a) ih
          (@Eq.refl.{1} Nat (Nat.succ (Nat.add a n))))
        (@Eq.symm.{1} Nat (Nat.add (Nat.succ n) a) (Nat.succ (Nat.add n a)) (succ_add n a)))
    b

-- 前驱 `pred (succ n) = n` 是定义性相等：用它把前驱等式换回原等式。
def Nat.pred (n : Nat) : Nat := match n with
| zero => Nat.zero
| succ m => m

-- 本语言没有内建的 `Nat.succ.inj`：对等式两边取前驱即得（定义性相等）。
theorem Nat.succ.inj (a b : Nat) (h : Nat.succ a = Nat.succ b) :
    a = b :=
  congrArg.{1} Nat.pred h

-- 转动加数把 (a+k)+j 换成 (a+j)+k；消去律最后一步要用它。
theorem add_rotate (a k j : Nat) :
    Nat.add (Nat.add a k) j = Nat.add (Nat.add a j) k :=
  @Eq.trans.{1} Nat (Nat.add (Nat.add a k) j) (Nat.add a (Nat.add k j)) (Nat.add (Nat.add a j) k)
    (add_assoc a k j)
    (@Eq.trans.{1} Nat (Nat.add a (Nat.add k j)) (Nat.add a (Nat.add j k)) (Nat.add (Nat.add a j) k)
      (congrArg.{1} (fun (x : Nat) => Nat.add a x) (add_comm k j))
      (@Eq.symm.{1} Nat (Nat.add (Nat.add a j) k) (Nat.add a (Nat.add j k)) (add_assoc a j k)))

-- 具体例子：前驱把 succ 的等式还原。
theorem demo_succ_inj : 1 = 1 :=
  Nat.succ.inj 1 1 (@Eq.refl.{1} Nat 2)

-- 具体例子：2-0 ≤ 4-2 就是 2+2 ≤ 4+0，两边都是 4。
theorem demo_leRep_two_four :
    leRep (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 4 2) :=
  le_refl 4

theorem nat_add_cancel_right (a b k : Nat) :
    Nat.add a k = Nat.add b k → a = b :=
  Nat.rec
    (fun (n : Nat) => Nat.add a n = Nat.add b n → a = b)
    (fun (h : a = b) => h)
    (fun (n : Nat)
         (ih : Nat.add a n = Nat.add b n → a = b) =>
      fun (h : Nat.succ (Nat.add a n) = Nat.succ (Nat.add b n)) =>
        ih (Nat.succ.inj (Nat.add a n) (Nat.add b n) h))
    k

theorem leNat_exists_add (m n : Nat) (h : LeNat m n) :
    ∃ (k : Nat), n = Nat.add m k :=
  @LeNat.rec
    (fun (m n : Nat) (_ : LeNat m n) =>
      ∃ (k : Nat), n = Nat.add m k)
    (fun (n : Nat) =>
      Exists.intro Nat.zero (@Eq.refl.{1} Nat n))
    (fun (m n : Nat) (h : LeNat m n)
         (ih : ∃ (k : Nat), n = Nat.add m k) =>
      Exists.elim ih (fun (k : Nat) (hk : n = Nat.add m k) =>
          Exists.intro (Nat.succ k) (congrArg.{1} Nat.succ hk)))
    m n h

theorem leNat_self_add (m k : Nat) : LeNat m (Nat.add m k) :=
  Nat.rec (fun (n : Nat) => LeNat m (Nat.add m n))
    (le_refl m)
    (fun (n : Nat) (ih : LeNat m (Nat.add m n)) => le_succ m (Nat.add m n) ih)
    k

theorem leNat_of_exists_add (m n : Nat)
    (h : ∃ (k : Nat), n = Nat.add m k) :
    LeNat m n :=
  Exists.elim h (fun (k : Nat) (hk : n = Nat.add m k) =>
      @Eq.subst.{1} Nat (fun (x : Nat) => LeNat m x) (Nat.add m k) n
        (@Eq.symm.{1} Nat n (Nat.add m k) hk)
        (leNat_self_add m k))

theorem leNat_add_cancel_right (a b k : Nat)
    (h : LeNat (Nat.add a k) (Nat.add b k)) : LeNat a b :=
  leNat_of_exists_add a b
    (Exists.elim (leNat_exists_add (Nat.add a k) (Nat.add b k) h) (fun (j : Nat)
           (hj : Nat.add b k = Nat.add (Nat.add a k) j) =>
        Exists.intro j (nat_add_cancel_right b (Nat.add a j) k
            (@Eq.trans.{1} Nat (Nat.add b k) (Nat.add (Nat.add a k) j)
              (Nat.add (Nat.add a j) k)
              hj
              (add_rotate a k j)))))

theorem leNat_succ_succ (a b : Nat) (h : LeNat a b) :
    LeNat (Nat.succ a) (Nat.succ b) :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat (Nat.succ m) (Nat.succ n))
    (fun (n : Nat) => le_refl (Nat.succ n))
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat (Nat.succ m) (Nat.succ n)) =>
       le_succ (Nat.succ m) (Nat.succ n) ih)
    a b h

theorem leNat_add_right (a b k : Nat) (h : LeNat a b) :
    LeNat (Nat.add a k) (Nat.add b k) :=
  Nat.rec (fun (k : Nat) => LeNat (Nat.add a k) (Nat.add b k))
    h
    (fun (k : Nat) (ih : LeNat (Nat.add a k) (Nat.add b k)) =>
       leNat_succ_succ (Nat.add a k) (Nat.add b k) ih)
    k

-- 具体例子：1-0 ≤ 3-0 就是 1 ≤ 3，从 1 ≤ 1 往上抬两层。
theorem demo_leRep_one_three :
    leRep (@prod_mk Nat Nat 1 Nat.zero) (@prod_mk Nat Nat 3 Nat.zero) :=
  le_succ 1 2 (le_succ 1 1 (le_refl 1))

-- 具体例子：良定义性在「不改代表元」时是废话（自反）。
theorem demo_leRep_wd_refl :
    leRep (@prod_mk Nat Nat 2 2) (@prod_mk Nat Nat 3 1) →
    leRep (@prod_mk Nat Nat 2 2) (@prod_mk Nat Nat 3 1) :=
  fun (h : leRep (@prod_mk Nat Nat 2 2) (@prod_mk Nat Nat 3 1)) => h

-- 把 intRel 假设直接读成等式：intRel (a,b) (x,y) 展开是 a+y = x+b。
-- 假设位不会自动展开这个定义，先用 Eq.subst 一次把等式拿到手。
theorem intRel_to_eq (a b x y : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat x y)) :
    Nat.add a y = Nat.add x b :=
  @Eq.subst.{1} Nat
    (fun (m : Nat) => Nat.add a y = m)
    (Nat.add a y) (Nat.add x b) h
    (@Eq.refl.{1} Nat (Nat.add a y))

-- 先证整数相等的对称性：把 intRel 假设读成等式再取对称。
-- soko:hint 思路：`intRel (a1,b1) (a,b)` 展开是 `a1 + b = a + b1`，正是 `intRel (a,b) (a1,b1)`（`a + b1 = a1 + b`）取对称。
-- soko:hint 目标形态：`a + b1 = a1 + b → a1 + b = a + b1`。
-- soko:hint 关键件：intRel_to_eq · Eq.symm。
theorem intRel_symm (a b a1 b1 : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a1 b1)) :
    intRel (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat a b)  :=
  sorry

-- 第一个坐标：把 Hp 补平再消掉（两边同加 b1，重排后用序的消去律）。
-- soko:hint 思路：先把 h 用 intRel_to_eq 读成 Hp : a + b1 = a1 + b。两边同加 b1（leNat_add_right），左边 `(a+d)+b1` 用 add_rotate 转成 `(a+b1)+d`、用 Hp 换成 `(a1+b)+d`、再 rotate 成 `(a1+d)+b`；右边 rotate 成 `(c+b1)+b`。最后用 leNat_add_cancel_right 消去 b。
-- soko:hint 目标形态：`LeNat (a+d) (c+b) → LeNat (a1+d) (c+b1)`（Hp : a + b1 = a1 + b）。
-- soko:hint 关键件：intRel_to_eq · leNat_add_right · add_rotate · congrArg · Eq.trans · Eq.subst · leNat_add_cancel_right。
theorem leRep_wd_fst (a b a1 b1 c d : Nat)
    (h : Nat.add a b1 = Nat.add a1 b)
    (hl : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c d)  :=
  sorry

-- 第二个坐标：结构和第一个坐标完全对偶，只是把 Hp 换成 Hq。
-- soko:hint 思路：结构对偶：先把 h 用 intRel_to_eq 读成 Hq : c + d1 = c1 + d。两边同加 d1，左边 rotate 成 `(a+d1)+d`；右边 `(c+b)+d1` rotate 成 `(c+d1)+b`、用 Hq 换成 `(c1+d)+b`、再 rotate 成 `(c1+b)+d`。最后用 leNat_add_cancel_right 消去 d。
-- soko:hint 目标形态：`LeNat (a+d) (c+b) → LeNat (a+d1) (c1+b)`（Hq : c + d1 = c1 + d）。
-- soko:hint 关键件：intRel_to_eq · leNat_add_right · add_rotate · congrArg · Eq.trans · leNat_add_cancel_right。
theorem leRep_wd_snd (a b c d c1 d1 : Nat)
    (h : Nat.add c d1 = Nat.add c1 d)
    (hl : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c1 d1)  :=
  sorry

-- 两个坐标一起换：先对第一对代表元用 leRep_wd_fst，再对第二对用 leRep_wd_snd。
-- soko:hint 思路：先对第一对代表元用 leRep_wd_fst 得 `leRep (a1,b1) (c,d)`，再对第二对用 leRep_wd_snd。两条假设用 intRel_to_eq 各读成等式一次。
-- soko:hint 目标形态：`leRep (a,b) (c,d) → leRep (a1,b1) (c1,d1)`。
-- soko:hint 关键件：intRel_to_eq · leRep_wd_fst · leRep_wd_snd。
theorem leRep_wd (a b a1 b1 c d c1 d1 : Nat)
    (hpp : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a1 b1))
    (hqq : intRel (@prod_mk Nat Nat c d) (@prod_mk Nat Nat c1 d1)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) →
    leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c1 d1)  :=
  sorry

-- 最后把单向蕴含升级成当且仅当：两个方向各证一次，用 And.intro 装起来。
-- soko:hint 思路：两个方向：正向就是 leRep_wd；反向把两条假设各取一次 intRel_symm，再对调两组代表元用一次 leRep_wd。用 And.intro 把两个方向装起来。
-- soko:hint 目标形态：`(leRep p q → leRep p1 q1) ∧ (leRep p1 q1 → leRep p q)`。
-- soko:hint 关键件：And.intro · leRep_wd · intRel_symm。
theorem leRep_wd_iff (a b a1 b1 c d c1 d1 : Nat)
    (hpp : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a1 b1))
    (hqq : intRel (@prod_mk Nat Nat c d) (@prod_mk Nat Nat c1 d1)) :
    (leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) →
         leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c1 d1)) ∧
        (leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c1 d1) →
         leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))  :=
  sorry
