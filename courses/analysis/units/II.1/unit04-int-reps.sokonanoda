-- 单元④ 整数加法 / 负 / 减的代表元公式
--
-- 整数是 ℕ×ℕ 的商，但商上的加法还没定义。直接定义 addRep 会遇到
-- “换代表元结果是否改变”的问题；本单元先把加法、取负、减法写成代表元公式，
-- 下一单元再交良定义性：
--   (a-b) + (c-d) = (a+c) - (b+d)
--   -(a-b)        = b - a
--   (a-b) - (c-d) = (a+d) - (b+c)

import lib.Logic
import lib.Prod

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def intOfNat (n : Nat) : Int :=
  @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat n Nat.zero)

def addRep (a b : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (Prod.fst Nat Nat a) (Prod.fst Nat Nat b))
    (Nat.add (Prod.snd Nat Nat a) (Prod.snd Nat Nat b))

def negRep (p : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat (Prod.snd Nat Nat p) (Prod.fst Nat Nat p)

def subRep (a b : Prod Nat Nat) : Prod Nat Nat :=
  addRep a (negRep b)

-- 演示：2 - 0 加 3 - 1 = 5 - 1。
theorem demo_addRep :
    addRep (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 3 1) =
    @prod_mk Nat Nat 5 1 :=
  Eq.refl (@prod_mk Nat Nat 5 1)

-- 演示：-(2 - 5) = 5 - 2。
theorem demo_negRep :
    negRep (@prod_mk Nat Nat 2 5) = @prod_mk Nat Nat 5 2 :=
  Eq.refl (@prod_mk Nat Nat 5 2)

-- soko:hint 思路：addRep 的定义直接展开，两边是同一个 prod_mk。
-- soko:hint 目标形态：prod_mk (a+c) (b+d) = prod_mk (a+c) (b+d)。
-- soko:hint 关键件：Eq.refl。
theorem addRep_mk (a b c d : Nat) :
    addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
    @prod_mk Nat Nat (Nat.add a c) (Nat.add b d) :=
  sorry

-- soko:hint 思路：negRep 交换两个分量，定义直接展开。
-- soko:hint 目标形态：prod_mk b a = prod_mk b a。
-- soko:hint 关键件：Eq.refl。
theorem negRep_mk (a b : Nat) :
    negRep (@prod_mk Nat Nat a b) = @prod_mk Nat Nat b a :=
  sorry

-- soko:hint 思路：subRep 先 negRep 再 addRep，展开后是 (a+d, b+c)。
-- soko:hint 目标形态：prod_mk (a+d) (b+c) = prod_mk (a+d) (b+c)。
-- soko:hint 关键件：Eq.refl。
theorem subRep_mk (a b c d : Nat) :
    subRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
    @prod_mk Nat Nat (Nat.add a d) (Nat.add b c) :=
  sorry

-- soko:hint 思路：闭值计算；2+3 与 0+1 都归约成 5 和 1。
-- soko:hint 目标形态：addRep (2,0) (3,1) = (5,1)。
-- soko:hint 关键件：Eq.refl。
theorem addRep_closed :
    addRep (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 3 1) =
    @prod_mk Nat Nat 5 1 :=
  sorry

-- soko:hint 思路：闭值计算；negRep 交换 (2,5) 得 (5,2)。
-- soko:hint 目标形态：negRep (2,5) = (5,2)。
-- soko:hint 关键件：Eq.refl。
theorem negRep_closed :
    negRep (@prod_mk Nat Nat 2 5) = @prod_mk Nat Nat 5 2 :=
  sorry

-- soko:hint 思路：闭值计算；(2-5) - (1-3) = 5 - 6。
-- soko:hint 目标形态：subRep (2,5) (1,3) = (5,6)。
-- soko:hint 关键件：Eq.refl。
theorem subRep_closed :
    subRep (@prod_mk Nat Nat 2 5) (@prod_mk Nat Nat 1 3) =
    @prod_mk Nat Nat 5 6 :=
  sorry
