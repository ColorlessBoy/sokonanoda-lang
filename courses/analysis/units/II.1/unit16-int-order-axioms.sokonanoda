-- 单元⑯ 整数序的传递性与加法单调（序公理，代表元层）
--
-- 单元⑮ 把整数序 `leRep` 证成了良定义的关系：换代表元不改变真假。
-- 按单元⑦的教训（本语言没有 `funext`，也还没有把关系「下降」成 `Int → Int → Prop`
-- 的机制），序公理继续在**代表元层**陈述：
--   a - b ≤ c - d  ⇔  a + d ≤ c + b
-- 它们是整数序的三条核心性质中的两条（自反已在单元⑫）：
--   ① 传递：a ≤ b 且 b ≤ c ⇒ a ≤ c；
--   ② 平移不变：a ≤ b ⇒ a + r ≤ b + r（本单元做右加；左加留给读者用交换律推出）。
-- 证明只用到单元⑬的 ℕ 序传递 / 右加单调、单元⑭的序消去律，以及一个纯算术的
-- 四项交换引理 `add4`（本文件已给）。
import lib.Logic
import lib.Prod

inductive LeNat : Nat → Nat → Prop
ctor le_refl (n : Nat) : LeNat n n
ctor le_succ (m : Nat) (n : Nat) : LeNat m n → LeNat m (Nat.succ n)
end

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def leRep (p q : Prod Nat Nat) : Prop :=
  LeNat (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q))
        (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p))

def addRep (p q : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (Prod.fst Nat Nat p) (Prod.fst Nat Nat q))
    (Nat.add (Prod.snd Nat Nat p) (Prod.snd Nat Nat q))

-- 以下四条是单元③的 ℕ 加法律，本单元自用（L3：律必须留在单元里）。
theorem zero_add (b : Nat) :
    @Eq.{1} Nat (Nat.add Nat.zero b) b :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => @Eq.{1} Nat (Nat.add Nat.zero n) n)  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : @Eq.{1} Nat (Nat.add Nat.zero n) n) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      @Eq.subst.{1} Nat
        (fun (m : Nat) => @Eq.{1} Nat (Nat.succ (Nat.add Nat.zero n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (Nat.add Nat.zero n) n ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add Nat.zero n))))
    b

theorem succ_add (a b : Nat) :
    @Eq.{1} Nat (Nat.add (Nat.succ a) b) (Nat.succ (Nat.add a b)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => @Eq.{1} Nat (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (@Eq.refl.{1} Nat (Nat.succ a))
    (fun (n : Nat) (ih : @Eq.{1} Nat (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      @Eq.subst.{1} Nat
        (fun (m : Nat) => @Eq.{1} Nat (Nat.succ (Nat.add (Nat.succ a) n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.succ a) n))))
    b

theorem add_assoc (a b c : Nat) :
    @Eq.{1} Nat (Nat.add (Nat.add a b) c) (Nat.add a (Nat.add b c)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => @Eq.{1} Nat (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (@Eq.refl.{1} Nat (Nat.add a b))
    (fun (n : Nat) (ih : @Eq.{1} Nat (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      @Eq.subst.{1} Nat
        (fun (m : Nat) => @Eq.{1} Nat (Nat.succ (Nat.add (Nat.add a b) n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a b) n))))
    c

theorem add_comm (a b : Nat) :
    @Eq.{1} Nat (Nat.add a b) (Nat.add b a) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec (fun (n : Nat) => @Eq.{1} Nat (Nat.add a n) (Nat.add n a))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (@Eq.symm.{1} Nat (Nat.add Nat.zero a) a (zero_add a))
    (fun (n : Nat) (ih : @Eq.{1} Nat (Nat.add a n) (Nat.add n a)) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      @Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ (Nat.add n a)) (Nat.add (Nat.succ n) a)
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => @Eq.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ m))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
          (Nat.add a n) (Nat.add n a) ih
          (@Eq.refl.{1} Nat (Nat.succ (Nat.add a n))))
        (@Eq.symm.{1} Nat (Nat.add (Nat.succ n) a) (Nat.succ (Nat.add n a)) (succ_add n a)))
    b

-- 前驱：`pred (succ n) = n` 是定义性相等；用于从前驱等式换回原等式。
def Nat.pred (n : Nat) : Nat := match n with
| zero => Nat.zero
| succ m => m

-- 本语言没有内建的 `Nat.succ.inj`：对等式两边取前驱即得（定义性相等）。
theorem Nat.succ.inj (a b : Nat) (h : @Eq.{1} Nat (Nat.succ a) (Nat.succ b)) :  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    @Eq.{1} Nat a b :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  congrArg.{1} Nat.pred h

-- 转动加数：把 (a+k)+j 换成 (a+j)+k（消去律最后一步要用）。
theorem add_rotate (a k j : Nat) :
    @Eq.{1} Nat (Nat.add (Nat.add a k) j) (Nat.add (Nat.add a j) k) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  @Eq.trans.{1} Nat (Nat.add (Nat.add a k) j) (Nat.add a (Nat.add k j)) (Nat.add (Nat.add a j) k)
    (add_assoc a k j)
    (@Eq.trans.{1} Nat (Nat.add a (Nat.add k j)) (Nat.add a (Nat.add j k)) (Nat.add (Nat.add a j) k)
      (congrArg.{1} (fun (x : Nat) => Nat.add a x) (add_comm k j))
      (@Eq.symm.{1} Nat (Nat.add (Nat.add a j) k) (Nat.add a (Nat.add j k)) (add_assoc a j k)))

-- ℕ 序的传递性（单元⑬）：对 h2 归纳，动机取 `LeNat a m → LeNat a n`。
theorem leNat_trans (a b c : Nat) (h1 : LeNat a b) (h2 : LeNat b c) : LeNat a c :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat a m → LeNat a n)
    (fun (n : Nat) => fun (h : LeNat a n) => h)
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat a m → LeNat a n) =>
       fun (h1 : LeNat a m) => le_succ a n (ih h1))
    b c h2 h1

theorem nat_add_cancel_right (a b k : Nat) :
    @Eq.{1} Nat (Nat.add a k) (Nat.add b k) → @Eq.{1} Nat a b :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  Nat.rec
    (fun (n : Nat) => @Eq.{1} Nat (Nat.add a n) (Nat.add b n) → @Eq.{1} Nat a b)  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (fun (h : @Eq.{1} Nat a b) => h)  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (fun (n : Nat)
         (ih : @Eq.{1} Nat (Nat.add a n) (Nat.add b n) → @Eq.{1} Nat a b) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      fun (h : @Eq.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ (Nat.add b n))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        ih (Nat.succ.inj (Nat.add a n) (Nat.add b n) h))
    k

theorem leNat_exists_add (m n : Nat) (h : LeNat m n) :
    Exists Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add m k)) :=  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
  @LeNat.rec
    (fun (m n : Nat) (_ : LeNat m n) =>
      Exists Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add m k)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (fun (n : Nat) =>
      @Exists.intro Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add n k)) Nat.zero
        (@Eq.refl.{1} Nat n))
    (fun (m n : Nat) (h : LeNat m n)
         (ih : Exists Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add m k))) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      @Exists.elim Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add m k))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        (Exists Nat (fun (j : Nat) => @Eq.{1} Nat (Nat.succ n) (Nat.add m j)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        ih
        (fun (k : Nat) (hk : @Eq.{1} Nat n (Nat.add m k)) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
          @Exists.intro Nat (fun (j : Nat) => @Eq.{1} Nat (Nat.succ n) (Nat.add m j))
            (Nat.succ k) (congrArg.{1} Nat.succ hk)))
    m n h

theorem leNat_self_add (m k : Nat) : LeNat m (Nat.add m k) :=
  Nat.rec (fun (n : Nat) => LeNat m (Nat.add m n))
    (le_refl m)
    (fun (n : Nat) (ih : LeNat m (Nat.add m n)) => le_succ m (Nat.add m n) ih)
    k

theorem leNat_of_exists_add (m n : Nat)
    (h : Exists Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add m k))) :  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    LeNat m n :=
  @Exists.elim Nat (fun (k : Nat) => @Eq.{1} Nat n (Nat.add m k)) (LeNat m n) h  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
    (fun (k : Nat) (hk : @Eq.{1} Nat n (Nat.add m k)) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      @Eq.subst.{1} Nat (fun (x : Nat) => LeNat m x) (Nat.add m k) n
        (@Eq.symm.{1} Nat n (Nat.add m k) hk)
        (leNat_self_add m k))

theorem leNat_add_cancel_right (a b k : Nat)
    (h : LeNat (Nat.add a k) (Nat.add b k)) : LeNat a b :=
  leNat_of_exists_add a b
    (@Exists.elim Nat
      (fun (j : Nat) => @Eq.{1} Nat (Nat.add b k) (Nat.add (Nat.add a k) j))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      (Exists Nat (fun (j : Nat) => @Eq.{1} Nat b (Nat.add a j)))  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
      (leNat_exists_add (Nat.add a k) (Nat.add b k) h)
      (fun (j : Nat)
           (hj : @Eq.{1} Nat (Nat.add b k) (Nat.add (Nat.add a k) j)) =>  -- soko:notation-ok: 等式族证明项的宇宙层级（手册边界）
        @Exists.intro Nat (fun (j : Nat) => @Eq.{1} Nat b (Nat.add a j)) j
          (nat_add_cancel_right b (Nat.add a j) k
            (@Eq.trans.{1} Nat (Nat.add b k) (Nat.add (Nat.add a k) j)
              (Nat.add (Nat.add a j) k)
              hj
              (add_rotate a k j)))))

theorem leNat_succ_succ (a b : Nat) (h : LeNat a b) :
    LeNat (Nat.succ a) (Nat.succ b) :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat (Nat.succ m) (Nat.succ n))
    (fun (n : Nat) => le_refl (Nat.succ n))
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat (Nat.succ m) (Nat.succ n)) =>
       le_succ (Nat.succ m) (Nat.succ n) ih)
    a b h

theorem leNat_add_right (a b k : Nat) (h : LeNat a b) :
    LeNat (Nat.add a k) (Nat.add b k) :=
  Nat.rec (fun (k : Nat) => LeNat (Nat.add a k) (Nat.add b k))
    h
    (fun (k : Nat) (ih : LeNat (Nat.add a k) (Nat.add b k)) =>
       leNat_succ_succ (Nat.add a k) (Nat.add b k) ih)
    k


-- 四项交换：`(a+d)+(e+f) = (a+e)+(d+f)`。纯 ℕ 算术（结合 + 交换），
-- 两条平移不变性都要用它把「先加在哪一侧」对齐。
theorem add4 (a d e f : Nat) :
    Nat.add (Nat.add a d) (Nat.add e f) = Nat.add (Nat.add a e) (Nat.add d f) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a d) (Nat.add e f))
    (Nat.add a (Nat.add e (Nat.add d f)))
    (Nat.add (Nat.add a e) (Nat.add d f))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add a d) (Nat.add e f))
      (Nat.add a (Nat.add d (Nat.add e f)))
      (Nat.add a (Nat.add e (Nat.add d f)))
      (add_assoc a d (Nat.add e f))
      (@Eq.trans.{1} Nat
        (Nat.add a (Nat.add d (Nat.add e f)))
        (Nat.add a (Nat.add (Nat.add d e) f))
        (Nat.add a (Nat.add e (Nat.add d f)))
        (congrArg.{1} (fun (x : Nat) => Nat.add a x)
          (@Eq.symm.{1} Nat (Nat.add (Nat.add d e) f) (Nat.add d (Nat.add e f))
            (add_assoc d e f)))
        (@Eq.trans.{1} Nat
          (Nat.add a (Nat.add (Nat.add d e) f))
          (Nat.add a (Nat.add (Nat.add e d) f))
          (Nat.add a (Nat.add e (Nat.add d f)))
          (congrArg.{1} (fun (x : Nat) => Nat.add a x)
            (congrArg.{1} (fun (x : Nat) => Nat.add x f) (add_comm d e)))
          (congrArg.{1} (fun (x : Nat) => Nat.add a x)
            (add_assoc e d f)))))
    (@Eq.symm.{1} Nat
      (Nat.add (Nat.add a e) (Nat.add d f))
      (Nat.add a (Nat.add e (Nat.add d f)))
      (add_assoc a e (Nat.add d f)))

-- soko:hint 思路：两条假设在代表元层是 H1 : a+d ≤ c+b、H2 : c+f ≤ e+d。目标是 a+f ≤ e+b。
-- soko:hint 思路：H1 两边同加 f 得 (a+d)+f ≤ (c+b)+f，用 add_rotate 两边各转一次变成 (a+f)+d ≤ (c+f)+b；H2 两边同加 b 得 (c+f)+b ≤ (e+d)+b，再把右边转成 (e+b)+d。传递后对 d 用 leNat_add_cancel_right。
-- soko:hint 目标形态：leRep (a,b) (e,f) 即 LeNat (a+f) (e+b)。
-- soko:hint 关键件：leNat_add_right · add_rotate · Eq.subst · leNat_trans · leNat_add_cancel_right。
theorem leRep_trans (a b c d e f : Nat)
    (h1 : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
    (h2 : leRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat e f) :=
  sorry

-- soko:hint 思路：h : a+d ≤ c+b；两边同加 (e+f) 得 (a+d)+(e+f) ≤ (c+b)+(e+f)。用 add4 把左边改成 (a+e)+(d+f)、右边改成 (c+e)+(b+f)，正是 leRep (addRep (a,b) (e,f)) (addRep (c,d) (e,f)) 展开后的两层。
-- soko:hint 目标形态：LeNat ((a+e)+(d+f)) ((c+e)+(b+f))。
-- soko:hint 关键件：leNat_add_right · add4（本文件已给）· Eq.subst。
theorem leRep_add_right (a b c d e f : Nat)
    (h : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    leRep (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat e f))
          (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f)) :=
  sorry

-- 演示：具体数字上传递一次 —— 0 ≤ 1 ≤ 2 推出 0 ≤ 2（都是 0 - 0 ≤ n - 0）。
theorem demo_leRep_trans :
    leRep (@prod_mk Nat Nat Nat.zero Nat.zero) (@prod_mk Nat Nat 2 Nat.zero) :=
  leRep_trans Nat.zero Nat.zero 1 Nat.zero 2 Nat.zero
    (le_succ Nat.zero Nat.zero (le_refl Nat.zero))
    (le_succ 1 1 (le_refl 1))

-- 演示：(1-0) ≤ (3-0) 两边同加 (2-1) ⇒ (3-1) ≤ (5-1)。
theorem demo_leRep_add_right :
    leRep (addRep (@prod_mk Nat Nat 1 Nat.zero) (@prod_mk Nat Nat 2 1))
          (addRep (@prod_mk Nat Nat 3 Nat.zero) (@prod_mk Nat Nat 2 1)) :=
  leRep_add_right 1 Nat.zero 3 Nat.zero 2 1
    (le_succ 1 2 (le_succ 1 1 (le_refl 1)))
