-- 单元138 无穷远处极限的代数与序列判据
--
-- 上一单元只立了定义，能算的例子还只有常函数与平移。若两个函数各自在
-- 无穷远处靠近 L 与 M，它们的和是否靠近 L + M？把 x 一直往右推，两个
-- 误差都变小，答案应当是肯定的。证明与一点处的和律同形：ε 折半，两个
-- 分界线用序的全性合成一条，越过它之后两条接近性同时成立。
--
-- 取负、减法、加常数都是同一条和律的变形。真正把「无穷远处的极限」接回
-- 序列语言的是下面这条判据：如果自变量序列 x_n 最终越过任何一条分界线，
-- 那么 f(x_n) 就收敛到 L。它说明这里的极限仍然是 ε-N 式的极限，只不过
-- 阈值从下标换成了数轴上的位置。
--
-- 边界：函数取 `ratRep → ratRep`，序列取 `Nat → ratRep`，都停在有理代表元
-- 层；不把 ±∞ 当成数，也不讨论函数值趋于无穷。不新增公理，也不碰
-- kernel/front。

import lib.Rat
import lib.RatAbs
import lib.RatAbsOrder
import lib.RatClose
import lib.RatHalf
import lib.LimInfinity
import lib.RealAdd
import lib.RealNeg
import lib.Limit

-- ─────────────────────────────────────────────────────────────
-- 序列趋于无穷
-- ─────────────────────────────────────────────────────────────

-- 读法：无论把分界线 M 放在哪里，序列最终都越过它。这里不说「极限是
-- 无穷大」，只说「最终超过每个给定的有理数」，避免引入新的极限对象。
def TendsToInfinity (x : Seq) : Prop :=
  ∀ (M : ratRep), ∃ (N : Nat), ∀ (n : Nat), LeNat N n → ratLeRep M (x n)

-- soko:hint 思路：把 `TendsToInfinity` 展开，右边那串量词逐字就是定义；两个方向都直接返回假设。
-- soko:hint 目标形态：`TendsToInfinity x ↔ ∀ M, ∃ N, ∀ n, N ≤ n → M ≤ x n`。
-- soko:hint 关键件：Iff.intro · 定义性展开。
theorem tendsToInfinity_iff (x : Seq) :
    TendsToInfinity x ↔
      ∀ (M : ratRep), ∃ (N : Nat), ∀ (n : Nat), LeNat N n →
        ratLeRep M (x n) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 和的极限
-- ─────────────────────────────────────────────────────────────

-- 两个 ε/2 的界分别由 f 与 g 给出；两条分界线并成 K，越过 K 的点同时
-- 越过两条原线。`close_add` 把两个一半的误差合成 ε。
--
-- soko:hint 思路：对 ε 取半数，分别向 f、g 的极限要分界线；用 `exists_ge_both` 并成 K，越过 K 的点同时越过两条原线，最后 `close_add` 合成。
-- soko:hint 目标形态：`TendsToAtInfinity f L → TendsToAtInfinity g M → TendsToAtInfinity (fun x => f x + g x) (L + M)`。
-- soko:hint 关键件：ratLtRep_half · exists_ge_both · ratLeRep_trans · close_add。
theorem tendsToAtInfinity_add (f g : ratRep → ratRep) (L M : ratRep)
    (hf : TendsToAtInfinity f L) (hg : TendsToAtInfinity g M) :
    TendsToAtInfinity (fun (x : ratRep) => ratAddRep (f x) (g x))
      (ratAddRep L M) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 取负
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：分界线不变，逐点用 `close_neg` 把误差搬到相反数上。
-- soko:hint 目标形态：`TendsToAtInfinity f L → TendsToAtInfinity (fun x => -f x) (-L)`。
-- soko:hint 关键件：close_neg · 定义性展开。
theorem tendsToAtInfinity_neg (f : ratRep → ratRep) (L : ratRep)
    (hf : TendsToAtInfinity f L) :
    TendsToAtInfinity (fun (x : ratRep) => ratNegRep (f x))
      (ratNegRep L) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 减法与加常数
-- ─────────────────────────────────────────────────────────────

-- 减法就是加负元：先取负，再交给和律；两个结论函数定义性相同。
--
-- soko:hint 思路：把 `f - g` 读成 `f + (-g)`，先对 g 用取负律，再交给和律。
-- soko:hint 目标形态：`TendsToAtInfinity (fun x => f x - g x) (L - M)`。
-- soko:hint 关键件：tendsToAtInfinity_add · tendsToAtInfinity_neg。
theorem tendsToAtInfinity_sub (f g : ratRep → ratRep) (L M : ratRep)
    (hf : TendsToAtInfinity f L) (hg : TendsToAtInfinity g M) :
    TendsToAtInfinity (fun (x : ratRep) => ratSubRep (f x) (g x))
      (ratSubRep L M) :=
  sorry

-- 常数项不随 x 变，直接当作常函数交给和律。
--
-- soko:hint 思路：把常数 c 看成常函数，它的极限是 c，再与 f 走和律。
-- soko:hint 目标形态：`TendsToAtInfinity f L → TendsToAtInfinity (fun x => f x + c) (L + c)`。
-- soko:hint 关键件：tendsToAtInfinity_add · tendsToAtInfinity_const。
theorem tendsToAtInfinity_add_const (f : ratRep → ratRep) (c L : ratRep)
    (hf : TendsToAtInfinity f L) :
    TendsToAtInfinity (fun (x : ratRep) => ratAddRep (f x) c)
      (ratAddRep L c) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 序列判据：把自变量换成一条趋于无穷的序列
-- ─────────────────────────────────────────────────────────────

-- 给定 ε，f 的极限给出一条分界线 M；序列的假设对同一条 M 给出阈值 N。
-- N 之后每个 x n 都越过 M，于是 f (x n) 落在 ε 界内。
--
-- soko:hint 思路：给定 ε 得 M；把 M 交给序列假设得阈值 N；N 之后逐项用 f 的极限。
-- soko:hint 目标形态：`TendsToAtInfinity f L → TendsToInfinity x → Converges (fun n => f (x n)) L`。
-- soko:hint 关键件：TendsToInfinity 的展开 · Converges 的展开 · Exists.elim。
theorem tendsToAtInfinity_comp (f : ratRep → ratRep) (L : ratRep)
    (x : Seq) (hf : TendsToAtInfinity f L) (hx : TendsToInfinity x) :
    Converges (fun (n : Nat) => f (x n)) L :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 具体：和的像仍然收敛
-- ─────────────────────────────────────────────────────────────

-- 把「加常数」与序列判据串起来：f (x n) + c 收敛到 L + c。
--
-- soko:hint 思路：对 `fun y => f y + c` 用加常数律得到它在无穷远处的极限，再交给序列判据。
-- soko:hint 目标形态：`Converges (fun n => f (x n) + c) (L + c)`。
-- soko:hint 关键件：tendsToAtInfinity_add_const · tendsToAtInfinity_comp。
theorem demo_comp_add_const (f : ratRep → ratRep) (c L : ratRep) (x : Seq)
    (hf : TendsToAtInfinity f L) (hx : TendsToInfinity x) :
    Converges (fun (n : Nat) => ratAddRep (f (x n)) c)
      (ratAddRep L c) :=
  sorry
