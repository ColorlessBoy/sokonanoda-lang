-- 单元139 单调函数：介值性反过来给出连续
--
-- 134 到 136 用连续性换来了最值与介值：连续函数在闭区间上取到最值，从一个
-- 负值走到正值时必经过零。这些结论都从连续性出发。反过来的问题同样值得问：
-- 「不跳过中间值」这一条性质，能不能把连续性认出来？
--
-- 单调函数是回答这个问题最省的对象。它的图像只朝一个方向走，所以不连续的
-- 方式只剩一种：在某个点跳过去，把一段区间里的值整段让开。若它从不跳过任何
-- 一个中间值，就无处可跳，只能连续。ℚ 上的连续函数未必有介值性（x² - 2 在
-- [1,2] 上连续却没有有理零点），所以这里的介值性是一条显式假设，不是自动
-- 成立的事实。
--
-- 证明把连续性拆成两个单侧的上界。给定 eps，在 c 的右边找一个分界点 u，
-- 使 c 到 u 之间的函数值都不超过 f c + eps/2。若右端点的值本来就不超过这个
-- 阈值，右端点本身就是 u；否则介值性在 c 与 b 之间给出一个点，它的值正好是
-- 阈值。左边对称地得到 l。δ 取 u - c 与 c - l 中较小的那个，于是 c 的 δ
-- 邻域被夹在 [l, u] 里，两次单侧估计合起来就是 |f x - f c| < eps。
--
-- 边界：函数取 `ratRep → ratRep`，停在有理代表元层；介值性作为假设出现，
-- 因为它在 ℚ 上不是连续性的推论。不新增公理，也不碰 kernel/front。

import lib.Rat
import lib.RatOrder
import lib.Cauchy
import lib.RatAbs
import lib.RatAbsOrder
import lib.RatClose
import lib.RatHalf
import lib.RatSub
import lib.RatAssoc
import lib.RatGroup
import lib.LimitOrder
import lib.LimitClass
import lib.MaxOn
import lib.Cont
import lib.Bounded
import lib.LimitAbs
import lib.LocalSign
import lib.RealEq

-- ─────────────────────────────────────────────────────────────
-- 定义：严格递增与介值性
-- ─────────────────────────────────────────────────────────────

-- 严格递增只看严格序：x < y 时 f x < f y。它不假设函数尊重代表元的等价，
-- 所以这条性质只在不跨越等价类的地方使用，构造单射时正好够用。

def StrictlyIncreasing (f : ratRep → ratRep) : Prop :=
  ∀ (x y : ratRep), ratLtRep x y → ratLtRep (f x) (f y)

-- 介值性把「不跳过中间值」写成一个量词句：区间里两点之间取到的每个值，
-- 都被某个严格的中间点取到。函数停在代表元层，取到的值只能报到等价类，
-- 所以结论写成 `ratRel (f c) v` 而不是相等。

def HasIntermediateValue (f : ratRep → ratRep) (a b : ratRep) : Prop :=
  ∀ (x y : ratRep), InClosed a b x → InClosed a b y → ratLtRep x y →
    ∀ (v : ratRep), ratLtRep (f x) v → ratLtRep v (f y) →
      ∃ (c : ratRep), ratLtRep x c ∧ ratLtRep c y ∧ ratRel (f c) v

-- ─────────────────────────────────────────────────────────────
-- 定义的展开
-- ─────────────────────────────────────────────────────────────

-- 定义与展开是同一个命题，两个方向都直接返回假设。

theorem strictlyIncreasing_iff (f : ratRep → ratRep) :
    StrictlyIncreasing f ↔
      ∀ (x y : ratRep), ratLtRep x y → ratLtRep (f x) (f y) :=
  Iff.intro (fun (h : StrictlyIncreasing f) => h)
    (fun (h : ∀ (x y : ratRep), ratLtRep x y → ratLtRep (f x) (f y)) => h)

-- 同一个定义换一行写，展开后逐字相同。

theorem hasIntermediateValue_iff (f : ratRep → ratRep) (a b : ratRep) :
    HasIntermediateValue f a b ↔
      ∀ (x y : ratRep), InClosed a b x → InClosed a b y → ratLtRep x y →
        ∀ (v : ratRep), ratLtRep (f x) v → ratLtRep v (f y) →
          ∃ (c : ratRep), ratLtRep x c ∧ ratLtRep c y ∧ ratRel (f c) v :=
  Iff.intro (fun (h : HasIntermediateValue f a b) => h)
    (fun (h : ∀ (x y : ratRep), InClosed a b x → InClosed a b y →
        ratLtRep x y → ∀ (v : ratRep), ratLtRep (f x) v →
          ratLtRep v (f y) → ∃ (c : ratRep),
            ratLtRep x c ∧ ratLtRep c y ∧ ratRel (f c) v) => h)

-- ─────────────────────────────────────────────────────────────
-- 单射
-- ─────────────────────────────────────────────────────────────

-- 严格递增把不同的点推开：f x 与 f y 等价时，x 与 y 必须等价。证明按序的
-- 全性分左右两支；每支再用「弱序或者相等、或者严格小」拆开，严格小的那一支
-- 与已知的等价直接冲突。

-- soko:hint 思路：对 `ratLeRep_total x y` 分两支；每支用 `ratLeRep_eq_or_lt` 拆成相等或严格小，严格小的一支把 `hf` 给出的严格不等式与 `h` 摆在一起，用 `ratLtRep_right` 收尾。
-- soko:hint 目标形态：`StrictlyIncreasing f → ratRel (f x) (f y) → ratRel x y`。
-- soko:hint 关键件：ratLeRep_total · ratLeRep_eq_or_lt · ratLtRep_right · False.elim · ratRel_symm。

theorem strictlyIncreasing_injective (f : ratRep → ratRep)
    (hf : StrictlyIncreasing f) (x y : ratRep) (h : ratRel (f x) (f y)) :
    ratRel x y :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 序与差的小工具
-- ─────────────────────────────────────────────────────────────

-- 严格序在左边加同一个数也稳定。先对右边加，再用交换律把两端的次序搬回来。

theorem ratLtRep_add_left (x y z : ratRep) (h : ratLtRep x y) :
    ratLtRep (ratAddRep z x) (ratAddRep z y) :=
  ratLtRep_congr_snd (ratAddRep z x) (ratAddRep y z) (ratAddRep z y)
    (ratLtRep_congr_fst (ratAddRep z x) (ratAddRep x z) (ratAddRep y z)
      (ratLtRep_add_right x y z h) (ratAdd_comm z x))
    (ratAdd_comm y z)

-- 弱序换个说法：x ≤ y 就是 0 ≤ y - x。两边同加 -x 得 -y ≤ -x，再在左边
-- 加上 y，把 y + (-y) 收成零。

theorem le_sub_of_le (x y : ratRep) (h : ratLeRep x y) :
    ratLeRep ratZeroRep (ratSubRep y x) :=
  ratLeRep_congr_gen
    (ratAddRep y (ratNegRep y)) ratZeroRep
    (ratSubRep y x) (ratSubRep y x)
    (ratAdd_neg_gen y) (ratRel_refl (ratSubRep y x))
    (ratLeRep_add_left (ratNegRep y) (ratNegRep x) y (ratLeRep_neg_gen x y h))

-- 上一条的逆用：x - y ≤ d 时两边加 y，得到 x ≤ y + d；左边用
-- `(x - y) + y ~ x` 收回。

theorem le_add_of_sub_le (x y d : ratRep)
    (h : ratLeRep (ratSubRep x y) d) : ratLeRep x (ratAddRep y d) :=
  ratLeRep_trans x (ratAddRep (ratSubRep x y) y) (ratAddRep y d)
    (ratLeRep_of_ratRel x (ratAddRep (ratSubRep x y) y)
      (ratRel_symm (ratAddRep (ratSubRep x y) y) x (ratSubRep_add_self x y)))
    (ratLeRep_trans (ratAddRep (ratSubRep x y) y) (ratAddRep d y) (ratAddRep y d)
      (ratLeRep_add_right (ratSubRep x y) d y h)
      (ratLeRep_of_ratRel (ratAddRep d y) (ratAddRep y d) (ratAdd_comm d y)))

-- 两边同时减去同一个数不改变弱序：把 c - x ≤ c - l 的公共被减数 c 消掉，
-- 得到 -x ≤ -l，再取负换成 l ≤ x。

theorem le_of_sub_right_le (c x l : ratRep)
    (h : ratLeRep (ratSubRep c x) (ratSubRep c l)) : ratLeRep l x :=
  ratLeRep_congr_gen (ratNegRep (ratNegRep l)) l
    (ratNegRep (ratNegRep x)) x
    (ratNegRep_invol l) (ratNegRep_invol x)
    (ratLeRep_neg_gen (ratNegRep x) (ratNegRep l)
      (ratLeRep_add_cancel_gen (ratNegRep x) (ratNegRep l) c
        (ratLeRep_congr_gen
          (ratSubRep c x) (ratAddRep (ratNegRep x) c)
          (ratSubRep c l) (ratAddRep (ratNegRep l) c)
          (ratAdd_comm c (ratNegRep x))
          (ratAdd_comm c (ratNegRep l))
          h)))

-- 减去一个正数会变小：x - h 加回 h 得到 x，而加正数严格抬大。

theorem ratLtRep_self_sub_pos (x h : ratRep) (hh : ratLtRep ratZeroRep h) :
    ratLtRep (ratSubRep x h) x :=
  ratLtRep_congr_snd (ratSubRep x h) (ratAddRep (ratSubRep x h) h) x
    (ratLtRep_self_add_pos (ratSubRep x h) h hh)
    (ratSubRep_add_self x h)

-- 两个正数里有较小的一个。序的全性给出两支，每支取自己那一端；它不超过
-- 另一个则由全性直接给出。

theorem exists_min_pos (p q : ratRep) (hp : ratLtRep ratZeroRep p)
    (hq : ratLtRep ratZeroRep q) :
    ∃ (d : ratRep), ratLtRep ratZeroRep d ∧ ratLeRep d p ∧ ratLeRep d q :=
  @Or.elim (ratLeRep p q) (ratLeRep q p)
    (∃ (d : ratRep), ratLtRep ratZeroRep d ∧ ratLeRep d p ∧ ratLeRep d q)
    (fun (h : ratLeRep p q) =>
      Exists.intro p (And.intro hp (And.intro (ratLeRep_refl p) h)))
    (fun (h : ratLeRep q p) =>
      Exists.intro q (And.intro hq (And.intro h (ratLeRep_refl q))))
    (ratLeRep_total p q)

-- ─────────────────────────────────────────────────────────────
-- close 的两侧收口
-- ─────────────────────────────────────────────────────────────

-- 单侧估计变成 `close`：L ≤ x 且 x < L + eps 时，|x - L| 就是 x - L，
-- 它小于 eps。见证取 x - L 本身，绝对值那一支由非负性给出；严格界通过
-- `(L + eps) - L ~ eps` 搬到 eps 上。

theorem close_of_le_lt (x L eps : ratRep)
    (h1 : ratLeRep L x) (h2 : ratLtRep x (ratAddRep L eps)) :
    close x L eps :=
  Exists.intro (ratSubRep x L)
    (And.intro
      (Or.inl (And.intro (le_sub_of_le L x h1)
        (ratRel_refl (ratSubRep x L))))
      (ratLtRep_congr_snd (ratSubRep x L)
        (ratAddRep (ratAddRep L eps) (ratNegRep L)) eps
        (ratLtRep_add_right x (ratAddRep L eps) (ratNegRep L) h2)
        (ratRel_trans_gen
          (ratAddRep (ratAddRep L eps) (ratNegRep L))
          (ratAddRep (ratAddRep eps L) (ratNegRep L))
          eps
          (ratAddRep_wd_gen (ratAddRep L eps) (ratAddRep eps L)
            (ratNegRep L) (ratAdd_comm L eps))
          (ratRel_trans_gen
            (ratAddRep (ratAddRep eps L) (ratNegRep L))
            (ratAddRep eps (ratAddRep L (ratNegRep L)))
            eps
            (ratAdd_assoc eps L (ratNegRep L))
            (ratRel_trans_gen
              (ratAddRep eps (ratAddRep L (ratNegRep L)))
              (ratAddRep eps ratZeroRep)
              eps
              (ratAddRep_wd_snd_gen eps (ratAddRep L (ratNegRep L))
                ratZeroRep (ratAdd_neg_gen L))
              (ratAdd_zero eps))))))

-- 两个条件合成 `close`：L ≤ x ≤ L + h 且 h < eps。先把上界放大成
-- x < L + eps，再交给上一条。

theorem close_of_le_ub (x L eps h : ratRep)
    (h1 : ratLeRep L x) (h2 : ratLeRep x (ratAddRep L h))
    (hh : ratLtRep h eps) : close x L eps :=
  close_of_le_lt x L eps h1
    (ratLtRep_of_le_lt x (ratAddRep L h) (ratAddRep L eps) h2
      (ratLtRep_add_left h eps L hh))

-- 下界那一侧同样处理，只是最后要把 `close` 的方向翻过来。

theorem close_of_le_lb (x L eps h : ratRep)
    (h1 : ratLeRep x L) (h2 : ratLeRep L (ratAddRep x h))
    (hh : ratLtRep h eps) : close x L eps :=
  close_symm L x eps
    (close_of_le_lt L x eps h1
      (ratLtRep_of_le_lt L (ratAddRep x h) (ratAddRep x eps) h2
        (ratLtRep_add_left h eps x hh)))

-- ─────────────────────────────────────────────────────────────
-- 右分界点
-- ─────────────────────────────────────────────────────────────

-- 右端点的值已经在阈值以下时，右端点本身就是分界点：区间里任何 x ≤ b
-- 都有 f x ≤ f b ≤ f c + h。

-- soko:hint 思路：取 u = b；对 x ≤ b 用单调性把 f x 压到 f b 之下，再接上 `f b ≤ f c + h`。
-- soko:hint 目标形态：`∃ u, c < u ∧ u ≤ b ∧ ∀ x ∈ [a,b], c ≤ x → x ≤ u → f x ≤ f c + h`，取 u = b。
-- soko:hint 关键件：Exists.intro · And.intro · ratLeRep_trans · ratLeRep_refl · `NondecreasingOn` 的展开。

theorem right_bound_flat (f : ratRep → ratRep) (a b c h : ratRep)
    (hmono : NondecreasingOn f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hfb : ratLeRep (f b) (ratAddRep (f c) h)) :
    ∃ (u : ratRep), ratLtRep c u ∧ ratLeRep u b ∧
      ∀ (x : ratRep), InClosed a b x → ratLeRep c x → ratLeRep x u →
        ratLeRep (f x) (ratAddRep (f c) h) :=
  sorry

-- 右端点的值超过阈值时，介值性在 c 与 b 之间给出一个点 u，它的值恰好是
-- 阈值。u 严格在 c 的右边（阈值严格大于 f c），也严格在 b 的左边（阈值
-- 严格小于 f b），于是 c 到 u 之间的函数值都被阈值压住。

-- soko:hint 思路：把 x = c、y = b、v = f c + h 交给介值性；它给出 c < u < b 且 f u ~ f c + h，再对 x ≤ u 用单调性。
-- soko:hint 目标形态：与 `right_bound_flat` 相同的存在句。
-- soko:hint 关键件：hivp · ratLtRep_self_add_pos · ratLtRep_le · ratLeRep_of_ratRel · ratLeRep_trans。

theorem right_bound_of_lt (f : ratRep → ratRep) (a b c h : ratRep)
    (hmono : NondecreasingOn f a b)
    (hivp : HasIntermediateValue f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hh : ratLtRep ratZeroRep h)
    (hlt : ratLtRep (ratAddRep (f c) h) (f b)) :
    ∃ (u : ratRep), ratLtRep c u ∧ ratLeRep u b ∧
      ∀ (x : ratRep), InClosed a b x → ratLeRep c x → ratLeRep x u →
        ratLeRep (f x) (ratAddRep (f c) h) :=
  sorry

-- 两支接起来。按 f b 与 f c + h 的序分；第二支里还要用「弱序或者相等、
-- 或者严格小」把相等的边界并入平的那一支。

-- soko:hint 思路：对 `ratLeRep (f b) (f c + h)` 分两支；第二支再用 `ratLeRep_eq_or_lt` 拆相等或严格小，相等交给 `right_bound_flat`，严格小交给 `right_bound_of_lt`。
-- soko:hint 目标形态：与 `right_bound_flat` 相同的存在句。
-- soko:hint 关键件：ratLeRep_total · ratLeRep_eq_or_lt · ratLeRep_of_ratRel · ratRel_symm。

theorem exists_right_bound (f : ratRep → ratRep) (a b c h : ratRep)
    (hmono : NondecreasingOn f a b)
    (hivp : HasIntermediateValue f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hh : ratLtRep ratZeroRep h) :
    ∃ (u : ratRep), ratLtRep c u ∧ ratLeRep u b ∧
      ∀ (x : ratRep), InClosed a b x → ratLeRep c x → ratLeRep x u →
        ratLeRep (f x) (ratAddRep (f c) h) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 左分界点
-- ─────────────────────────────────────────────────────────────

-- 左端点已经在阈值以上时，取 l = a：区间里 x ≥ a 有 f x ≥ f a ≥ f c - h，
-- 于是 f c ≤ f x + h。

-- soko:hint 思路：取 l = a；对 x ≥ a 用单调性把 f a 抬到 f x 之下，再用 `le_add_of_sub_le` 把 f c - h ≤ f x 换成 f c ≤ h + f x，最后交换加数。
-- soko:hint 目标形态：`∃ l, l < c ∧ a ≤ l ∧ ∀ x ∈ [a,b], l ≤ x → x ≤ c → f c ≤ f x + h`，取 l = a。
-- soko:hint 关键件：Exists.intro · le_add_of_sub_le · ratAdd_comm · ratLeRep_congr_gen。

theorem left_bound_flat (f : ratRep → ratRep) (a b c h : ratRep)
    (hmono : NondecreasingOn f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hfa : ratLeRep (ratSubRep (f c) h) (f a)) :
    ∃ (l : ratRep), ratLtRep l c ∧ ratLeRep a l ∧
      ∀ (x : ratRep), InClosed a b x → ratLeRep l x → ratLeRep x c →
        ratLeRep (f c) (ratAddRep (f x) h) :=
  sorry

-- 左端点的值低于阈值时，介值性在 a 与 c 之间给出 l，它的值恰好是阈值。
-- l 严格在 a 的右边、严格在 c 的左边（阈值严格小于 f c），于是 l 到 c
-- 之间的函数值都在阈值以上。

-- soko:hint 思路：把 x = a、y = c、v = f c - h 交给介值性；它给出 a < l < c 且 f l ~ f c - h，再对 x ≥ l 用单调性得到 f l ≤ f x。
-- soko:hint 目标形态：与 `left_bound_flat` 相同的存在句。
-- soko:hint 关键件：hivp · ratLtRep_self_sub_pos · ratLtRep_le · ratLeRep_of_ratRel · le_add_of_sub_le。

theorem left_bound_of_lt (f : ratRep → ratRep) (a b c h : ratRep)
    (hmono : NondecreasingOn f a b)
    (hivp : HasIntermediateValue f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hh : ratLtRep ratZeroRep h)
    (hlt : ratLtRep (f a) (ratSubRep (f c) h)) :
    ∃ (l : ratRep), ratLtRep l c ∧ ratLeRep a l ∧
      ∀ (x : ratRep), InClosed a b x → ratLeRep l x → ratLeRep x c →
        ratLeRep (f c) (ratAddRep (f x) h) :=
  sorry

-- 与右边对称地把两支接起来。

-- soko:hint 思路：对 `ratLeRep (f c - h) (f a)` 分两支；第二支再用 `ratLeRep_eq_or_lt` 拆相等或严格小。
-- soko:hint 目标形态：与 `left_bound_flat` 相同的存在句。
-- soko:hint 关键件：ratLeRep_total · ratLeRep_eq_or_lt · ratLeRep_of_ratRel · ratRel_symm。

theorem exists_left_bound (f : ratRep → ratRep) (a b c h : ratRep)
    (hmono : NondecreasingOn f a b)
    (hivp : HasIntermediateValue f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hh : ratLtRep ratZeroRep h) :
    ∃ (l : ratRep), ratLtRep l c ∧ ratLeRep a l ∧
      ∀ (x : ratRep), InClosed a b x → ratLeRep l x → ratLeRep x c →
        ratLeRep (f c) (ratAddRep (f x) h) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- δ 邻域上的收口与主定理
-- ─────────────────────────────────────────────────────────────

-- 右半邻域上的收口：x 在 c 的右边、且 |x - c| < δ ≤ u - c 时，x 落在
-- [c, u] 里，于是 f c ≤ f x ≤ f c + h < f c + eps。

-- soko:hint 思路：从 `close_two_bounds` 取出 x - c ≤ δ，用 `le_add_of_sub_le` 得 x ≤ c + δ，再经 δ ≤ u - c 把右边认成 u；最后交给 `close_of_le_ub`。
-- soko:hint 目标形态：`close x c δ → c ≤ x → close (f x) (f c) eps`。
-- soko:hint 关键件：close_two_bounds · le_add_of_sub_le · ratLeRep_add_left · ratSubRep_add_self · close_of_le_ub。

theorem right_close_of_delta (f : ratRep → ratRep)
    (a b c u h eps delta : ratRep)
    (hmono : NondecreasingOn f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hub : ratLeRep u b)
    (hbound : ∀ (x : ratRep), InClosed a b x → ratLeRep c x →
      ratLeRep x u → ratLeRep (f x) (ratAddRep (f c) h))
    (hdu : ratLeRep delta (ratSubRep u c))
    (hhe : ratLtRep h eps)
    (x : ratRep) (hx : close x c delta) (hcx : ratLeRep c x) :
    close (f x) (f c) eps :=
  sorry

-- 左半邻域上的收口：|x - c| < δ ≤ c - l 时 x 落在 [l, c] 里，于是
-- f x ≤ f c ≤ f x + h < f x + eps。

-- soko:hint 思路：从 `close_two_bounds` 取出 c - x ≤ δ，与 δ ≤ c - l 合成 c - x ≤ c - l，用 `le_of_sub_right_le` 得 l ≤ x；再交给 `close_of_le_lb`。
-- soko:hint 目标形态：`close x c δ → x ≤ c → close (f x) (f c) eps`。
-- soko:hint 关键件：close_two_bounds · ratLeRep_congr_gen · le_of_sub_right_le · close_of_le_lb。

theorem left_close_of_delta (f : ratRep → ratRep)
    (a b c l h eps delta : ratRep)
    (hmono : NondecreasingOn f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b)
    (hal : ratLeRep a l)
    (hbound : ∀ (x : ratRep), InClosed a b x → ratLeRep l x →
      ratLeRep x c → ratLeRep (f c) (ratAddRep (f x) h))
    (hdl : ratLeRep delta (ratSubRep c l))
    (hhe : ratLtRep h eps)
    (x : ratRep) (hx : close x c delta) (hxc : ratLeRep x c) :
    close (f x) (f c) eps :=
  sorry

-- 主定理。对每个 eps 取 h = eps/2，左右各得一个分界点；δ 取 u - c 与
-- c - l 中较小的正数，于是 c 的 δ 邻域落在 [l, u] 里。x 在 c 的哪一边
-- 由序的全性决定，两边分别交给上面的收口。

-- soko:hint 思路：eps 取半；`exists_right_bound` 与 `exists_left_bound` 给出 u 与 l；`exists_min_pos` 取 δ；对 x 用 `ratLeRep_total x c` 分左右，分别调用 `right_close_of_delta` 与 `left_close_of_delta`。
-- soko:hint 目标形态：`NondecreasingOn f a b → HasIntermediateValue f a b → a < c → c < b → ContinuousAt f c`。
-- soko:hint 关键件：ratLtRep_half · exists_right_bound · exists_left_bound · exists_min_pos · ratLeRep_total · right_close_of_delta · left_close_of_delta。

theorem continuousAt_of_monotone_ivp (f : ratRep → ratRep) (a b c : ratRep)
    (hmono : NondecreasingOn f a b)
    (hivp : HasIntermediateValue f a b)
    (hac : ratLtRep a c) (hcb : ratLtRep c b) :
    ContinuousAt f c :=
  sorry

-- 把主定理打包成「开区间上处处连续」。

-- soko:hint 思路：把 c 与两个严格不等式原样交给主定理。
-- soko:hint 目标形态：`NondecreasingOn f a b → HasIntermediateValue f a b → ∀ c, a < c → c < b → ContinuousAt f c`。
-- soko:hint 关键件：continuousAt_of_monotone_ivp。

