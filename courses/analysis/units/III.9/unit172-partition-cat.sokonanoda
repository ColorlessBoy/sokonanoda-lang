-- 单元172 分割拼接：把两块面积接到同一个分割上
--
-- 面积值 `HasIntegral a c f I` 与 `HasIntegral c b f J` 要合成
-- `HasIntegral a b f (I+J)`，第一件事是把 `[a,c]` 与 `[c,b]` 的两个分割
-- 接成一个 `[a,b]` 的分割。切点序列的拼法只有一种：左半的 `p1(0..n1-1)`，
-- 接缝取 `c`（它同时是 `p1(n1)` 与 `p2(0)`），再接 `p2(1..n2)`。
--
-- 这个「拼接」在库里已经落成 `lib/IntegralCatPart` 的 `catPartition`：
-- 段数是 `(n1+1)+n2`，点函数是 `catFun (n1+1)`。本单元不重证引擎，只把
-- 引擎的四个读数接到课程里：接缝处左/右的取值、拼接后的 `IsPartition`、
-- 下和/上和相加、矩形和相加。
--
-- 函数取 ratRep → ratRep，停在有理代表元层；不新增公理。

import lib.Rat
import lib.RatOrder
import lib.RatAbs
import lib.Cauchy
import lib.Integral
import lib.IntegralSum
import lib.IntegralCatPart

-- ─────────────────────────────────────────────────────────────
-- 拼接的取值
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：`catPartition` 的点函数就是 `catFun (n1+1)`，左半第 k 个点由 `catFun_left` 给出。
-- soko:hint 目标形态：`partPoint (catPartition n1 p1 p2) k = partPoint p1 k`。
-- soko:hint 关键件：catFun_left。
theorem u172_cat_point_left (a c b : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (k : Nat) (hk : LeNat (Nat.succ k) (Nat.succ n1)) :
    partPoint (catPartition n1 p1 p2) k = partPoint p1 k :=
  sorry

-- soko:hint 思路：从接缝 `n1+1` 起走 j 步，点函数由 `catFun_at` 给出。
-- soko:hint 目标形态：`partPoint (catPartition n1 p1 p2) ((n1+1)+j) = partPoint p2 j`。
-- soko:hint 关键件：catFun_at。
theorem u172_cat_point_at (a c b : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (j : Nat) :
    partPoint (catPartition n1 p1 p2) (Nat.add (Nat.succ n1) j) =
      partPoint p2 j :=
  sorry

-- soko:hint 思路：第 0 个点是 `catFun` 的第 0 个点，也就是左半的第 0 个点；再用 `IsPartition` 的左端点。
-- soko:hint 目标形态：`partPoint (catPartition n1 p1 p2) 0 = a`。
-- soko:hint 关键件：catFun_at_zero · isPartition_left。
theorem u172_cat_point_zero (a c b : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (hp1 : IsPartition a c p1) :
    partPoint (catPartition n1 p1 p2) Nat.zero = a :=
  sorry

-- soko:hint 思路：最后一个是 `(n1+1)+n2`，`catFun_at` 给右半的第 n2 个点；再用 `IsPartition` 的右端点。
-- soko:hint 目标形态：`partPoint (catPartition n1 p1 p2) (partCount …) = b`。
-- soko:hint 关键件：catFun_at · isPartition_right。
theorem u172_cat_last (a c b : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (hp2 : IsPartition c b p2) :
    partPoint (catPartition n1 p1 p2) (partCount (catPartition n1 p1 p2)) = b :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 拼接仍是分割
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：把左/右两半的 `IsPartition`、接缝 `p1 的末点 = c`、以及左半段数是后继 `n1+1` 一起交给库里的 `catPartition_isPartition`。
-- soko:hint 目标形态：`IsPartition a b (catPartition n1 p1 p2)`。
-- soko:hint 关键件：catPartition_isPartition。
theorem u172_cat_isPartition (a b c : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (hp1 : IsPartition a c p1) (hp2 : IsPartition c b p2)
    (hjoin : ratRel (partPoint p1 (partCount p1)) c)
    (hn1 : partCount p1 = Nat.succ n1) :
    IsPartition a b (catPartition n1 p1 p2) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 下和与上和相加
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：库里的 `catPartition_lowerSum` 把两半的下和见证拼成拼接分割的下界，直接套。
-- soko:hint 目标形态：`LowerSum a b (catPartition n1 p1 p2) f (L1+L2)`。
-- soko:hint 关键件：catPartition_lowerSum。
theorem u172_cat_lowerSum (a b c : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (f : ratRep → ratRep) (L1 L2 : ratRep)
    (hp1 : IsPartition a c p1) (hp2 : IsPartition c b p2)
    (hjoin : ratRel (partPoint p1 (partCount p1)) c)
    (hn1 : partCount p1 = Nat.succ n1)
    (hL1 : LowerSum a c p1 f L1) (hL2 : LowerSum c b p2 f L2) :
    LowerSum a b (catPartition n1 p1 p2) f (ratAddRep L1 L2) :=
  sorry

-- soko:hint 思路：同上，换成 `catPartition_upperSum`。
-- soko:hint 目标形态：`UpperSum a b (catPartition n1 p1 p2) f (U1+U2)`。
-- soko:hint 关键件：catPartition_upperSum。
theorem u172_cat_upperSum (a b c : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (f : ratRep → ratRep) (U1 U2 : ratRep)
    (hp1 : IsPartition a c p1) (hp2 : IsPartition c b p2)
    (hjoin : ratRel (partPoint p1 (partCount p1)) c)
    (hn1 : partCount p1 = Nat.succ n1)
    (hU1 : UpperSum a c p1 f U1) (hU2 : UpperSum c b p2 f U2) :
    UpperSum a b (catPartition n1 p1 p2) f (ratAddRep U1 U2) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 矩形和相加
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：拼接分割上的矩形和按接缝拆成两段，`catPartition_stepSum` 直接给出。
-- soko:hint 目标形态：`stepSum (catPartition n1 p1 p2) (catFun (n1+1) l1 l2) ~ stepSum p1 l1 + stepSum p2 l2`。
-- soko:hint 关键件：catPartition_stepSum。
theorem u172_cat_stepSum (a b c : ratRep) (p1 p2 : Partition) (n1 : Nat)
    (l1 l2 : Nat → ratRep)
    (hp1 : IsPartition a c p1) (hp2 : IsPartition c b p2)
    (hjoin : ratRel (partPoint p1 (partCount p1)) c)
    (hn1 : partCount p1 = Nat.succ n1) :
    ratRel (stepSum (catPartition n1 p1 p2) (catFun (Nat.succ n1) l1 l2))
      (ratAddRep (stepSum p1 l1) (stepSum p2 l2)) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- 一个可算读数：拼接后的段数就是两半段数之和。
--
-- soko:hint 思路：`catPartition` 的段数字段就是 `(n1+1)+partCount p2`，定义性相等。
-- soko:hint 目标形态：`partCount (catPartition n1 p1 p2) = (n1+1)+partCount p2`。
-- soko:hint 关键件：Eq.refl（定义性归约）。
theorem demo_catPartition_count (p1 p2 : Partition) (n1 : Nat) :
    partCount (catPartition n1 p1 p2) =
      Nat.add (Nat.succ n1) (partCount p2) :=
  sorry
