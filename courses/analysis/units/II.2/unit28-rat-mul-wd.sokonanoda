-- 单元㉘ 有理数乘法的良定义性（第一、第二因子两条义务）
--
-- 单元⑳ 把 ℚ 建成 `Quot ratRel`；㉑–㉕ 结清 `ratRel`；㉖ 定义加法；
-- ㉗ 给出乘法的代表元公式：
--
--   (a-b)/(m+1) * (c-d)/(n+1)
--     = [(ac + bd) - (ad + bc)] / ((m+1)(n+1))
--
-- 本单元把乘法在代表元层结清：固定一个因子，另一个因子换成 `ratRel`
-- 等价但不同的代表元时，乘积仍等价。
--
--   `ratMulRep_wd`      : x ~ x' ⇒ x*y ~ x'*y
--   `ratMulRep_wd_snd`  : y ~ y' ⇒ x*y ~ x*y'
--
-- 两条都化归到整数层已经证过的 `mulRep_wd` / `mulRep_wd_snd`：先用
-- `ratAdd_cross`（同分母的 `ratRel` 可消去正分母）把假设化成整数代表元
-- 的相等，再让整数乘法把这份相等搬到两个分子上，最后乘回公分母。
--
-- 仍然停在整数代表元层：不把乘法下降成 `Rat → Rat → Rat`（那需要
-- `funext`，本语言没有，见 语言边界），也不加任何公理。
--
-- 这里自带全部 ℕ 加/乘法律与前序地基（本单元自备）。

import lib.Logic
import lib.Prod

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def myMul (a b : Nat) : Nat :=
  Nat.rec (fun (_ : Nat) => Nat) Nat.zero
    (fun (n : Nat) (ih : Nat) => Nat.add a ih) b

def mulRep (a b : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (myMul (Prod.fst Nat Nat a) (Prod.fst Nat Nat b))
             (myMul (Prod.snd Nat Nat a) (Prod.snd Nat Nat b)))
    (Nat.add (myMul (Prod.fst Nat Nat a) (Prod.snd Nat Nat b))
             (myMul (Prod.snd Nat Nat a) (Prod.fst Nat Nat b)))

def ratRep : Type := Prod (Prod Nat Nat) Nat

def den (n : Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat (Nat.succ n) Nat.zero

def ratRel (x y : ratRep) : Prop :=
  intRel
    (mulRep (Prod.fst (Prod Nat Nat) Nat x)
            (den (Prod.snd (Prod Nat Nat) Nat y)))
    (mulRep (Prod.fst (Prod Nat Nat) Nat y)
            (den (Prod.snd (Prod Nat Nat) Nat x)))

def Rat : Type := @Quot.{1} ratRep ratRel

def ratOf (a : Prod Nat Nat) (n : Nat) : Rat :=
  @Quot.mk.{1} ratRep ratRel
    (@prod_mk (Prod Nat Nat) Nat a n)

theorem zero_add (b : Nat) :
    Nat.add Nat.zero b = b :=
  Nat.rec (fun (n : Nat) => Nat.add Nat.zero n = n)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Nat.add Nat.zero n = n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add Nat.zero n) = Nat.succ m)
        (Nat.add Nat.zero n) n ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add Nat.zero n))))
    b

theorem succ_add (a b : Nat) :
    Nat.add (Nat.succ a) b = Nat.succ (Nat.add a b) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n))
    (@Eq.refl.{1} Nat (Nat.succ a))
    (fun (n : Nat) (ih : Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.succ a) n) = Nat.succ m)
        (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.succ a) n))))
    b

theorem add_comm (a b : Nat) :
    Nat.add a b = Nat.add b a :=
  Nat.rec (fun (n : Nat) => Nat.add a n = Nat.add n a)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero a) a (zero_add a))
    (fun (n : Nat) (ih : Nat.add a n = Nat.add n a) =>
      @Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ (Nat.add n a)) (Nat.add (Nat.succ n) a)
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.succ (Nat.add a n) = Nat.succ m)
          (Nat.add a n) (Nat.add n a) ih
          (@Eq.refl.{1} Nat (Nat.succ (Nat.add a n))))
        (@Eq.symm.{1} Nat (Nat.add (Nat.succ n) a) (Nat.succ (Nat.add n a)) (succ_add n a)))
    b

theorem add_zero (a : Nat) :
    Nat.add a Nat.zero = a :=
  @Eq.trans.{1} Nat (Nat.add a Nat.zero) (Nat.add Nat.zero a) a
    (add_comm a Nat.zero)
    (zero_add a)

theorem add_assoc (a b c : Nat) :
    Nat.add (Nat.add a b) c = Nat.add a (Nat.add b c) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n))
    (@Eq.refl.{1} Nat (Nat.add a b))
    (fun (n : Nat) (ih : Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.add a b) n) = Nat.succ m)
        (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a b) n))))
    c

-- 搬运律：把两个和里的加法因子换个配对，值不变。

theorem add_shift (a b c d : Nat) :
    Nat.add (Nat.add a c) (Nat.add b d) =
    Nat.add (Nat.add a b) (Nat.add c d) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a c) (Nat.add b d))
    (Nat.add a (Nat.add c (Nat.add b d)))
    (Nat.add (Nat.add a b) (Nat.add c d))
    (add_assoc a c (Nat.add b d))
    (@Eq.trans.{1} Nat
      (Nat.add a (Nat.add c (Nat.add b d)))
      (Nat.add a (Nat.add (Nat.add c b) d))
      (Nat.add (Nat.add a b) (Nat.add c d))
      (@Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add a (Nat.add c (Nat.add b d)) = Nat.add a m)
        (Nat.add c (Nat.add b d)) (Nat.add (Nat.add c b) d)
        (@Eq.symm.{1} Nat (Nat.add (Nat.add c b) d) (Nat.add c (Nat.add b d)) (add_assoc c b d))
        (@Eq.refl.{1} Nat (Nat.add a (Nat.add c (Nat.add b d)))))
      (@Eq.trans.{1} Nat
        (Nat.add a (Nat.add (Nat.add c b) d))
        (Nat.add a (Nat.add (Nat.add b c) d))
        (Nat.add (Nat.add a b) (Nat.add c d))
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.add a (Nat.add (Nat.add c b) d) = Nat.add a (Nat.add m d))
          (Nat.add c b) (Nat.add b c)
          (add_comm c b)
          (@Eq.refl.{1} Nat (Nat.add a (Nat.add (Nat.add c b) d))))
        (@Eq.trans.{1} Nat
          (Nat.add a (Nat.add (Nat.add b c) d))
          (Nat.add a (Nat.add b (Nat.add c d)))
          (Nat.add (Nat.add a b) (Nat.add c d))
          (@Eq.subst.{1} Nat
            (fun (m : Nat) => Nat.add a (Nat.add (Nat.add b c) d) = Nat.add a m)
            (Nat.add (Nat.add b c) d) (Nat.add b (Nat.add c d))
            (add_assoc b c d)
            (@Eq.refl.{1} Nat (Nat.add a (Nat.add (Nat.add b c) d))))
          (@Eq.symm.{1} Nat
            (Nat.add (Nat.add a b) (Nat.add c d))
            (Nat.add a (Nat.add b (Nat.add c d)))
            (add_assoc a b (Nat.add c d))))))


-- 定义性相等：myMul 在第二个参数上递归，base 就是 0。

theorem myMul_zero (a : Nat) :
    myMul a Nat.zero = Nat.zero :=
  Eq.refl Nat.zero

-- 定义性相等：递归步把 myMul a (succ b) 展开成 myAdd a (myMul a b)。

theorem myMul_succ (a b : Nat) :
    myMul a (Nat.succ b) = Nat.add a (myMul a b) :=
  Eq.refl (Nat.add a (myMul a b))

theorem zero_mul (a : Nat) : myMul Nat.zero a = Nat.zero :=
  Nat.rec (fun (n : Nat) => myMul Nat.zero n = Nat.zero)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : myMul Nat.zero n = Nat.zero) =>
      @Eq.trans.{1} Nat (myMul Nat.zero (Nat.succ n)) (Nat.add Nat.zero (myMul Nat.zero n)) Nat.zero
        (@Eq.refl.{1} Nat (Nat.add Nat.zero (myMul Nat.zero n)))
        (@Eq.trans.{1} Nat (Nat.add Nat.zero (myMul Nat.zero n)) (myMul Nat.zero n) Nat.zero
          (zero_add (myMul Nat.zero n)) ih))
    a

-- soko:hint 思路：对 b 归纳。零情形两边都归约成 0；后继情形把左边展开成 (a+1) + myMul (a+1) n，用 ih 把 myMul (a+1) n 换成 a*n + n，再用 succ_add / add_assoc 把两边对到 succ (a + (a*n + n))。
-- soko:hint 目标形态：(a+1) * b = a*b + b。
-- soko:hint 关键件：Nat.rec · Eq.subst（把 ih 换进 add (a+1) 的第二个位置）· succ_add · add_assoc · Eq.refl（add x (succ n) 定义性归约）。

theorem succ_mul (a b : Nat) :
    myMul (Nat.succ a) b = Nat.add (myMul a b) b :=
  Nat.rec (fun (n : Nat) => myMul (Nat.succ a) n = Nat.add (myMul a n) n)
    (@Eq.trans.{1} Nat (myMul (Nat.succ a) Nat.zero) Nat.zero (Nat.add (myMul a Nat.zero) Nat.zero)
      (@Eq.refl.{1} Nat Nat.zero)
      (@Eq.symm.{1} Nat (Nat.add (myMul a Nat.zero) Nat.zero) Nat.zero (add_zero (myMul a Nat.zero))))
    (fun (n : Nat)
         (ih : myMul (Nat.succ a) n = Nat.add (myMul a n) n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add (Nat.succ a) m =
        Nat.add (Nat.add a (myMul a n)) (Nat.succ n))
        (Nat.add (myMul a n) n) (myMul (Nat.succ a) n)
        (@Eq.symm.{1} Nat (myMul (Nat.succ a) n) (Nat.add (myMul a n) n) ih)
        (@Eq.trans.{1} Nat
          (Nat.add (Nat.succ a) (Nat.add (myMul a n) n))
          (Nat.succ (Nat.add a (Nat.add (myMul a n) n)))
          (Nat.add (Nat.add a (myMul a n)) (Nat.succ n))
          (succ_add a (Nat.add (myMul a n) n))
          (@Eq.trans.{1} Nat
            (Nat.succ (Nat.add a (Nat.add (myMul a n) n)))
            (Nat.succ (Nat.add (Nat.add a (myMul a n)) n))
            (Nat.add (Nat.add a (myMul a n)) (Nat.succ n))
            (congrArg.{1} Nat.succ
              (@Eq.symm.{1} Nat (Nat.add (Nat.add a (myMul a n)) n)
                (Nat.add a (Nat.add (myMul a n) n)) (add_assoc a (myMul a n) n)))
            (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a (myMul a n)) n))))))
    b

-- soko:hint 思路：对 b 归纳。零情形用 zero_mul 把两边都变成 0；后继情形 myMul a (n+1) = a + myMul a n，用 ih 换成 a + myMul n a，再用 add_comm 换成 myMul n a + a，最后用 succ_mul 的对称收口。
-- soko:hint 目标形态：myMul a b = myMul b a。
-- soko:hint 关键件：Nat.rec · congrArg（在 add a 下改写 ih）· add_comm · succ_mul（取对称）。

theorem myMul_comm (a b : Nat) :
    myMul a b = myMul b a :=
  Nat.rec (fun (n : Nat) => myMul a n = myMul n a)
    (@Eq.trans.{1} Nat (myMul a Nat.zero) Nat.zero (myMul Nat.zero a)
      (@Eq.refl.{1} Nat Nat.zero)
      (@Eq.symm.{1} Nat (myMul Nat.zero a) Nat.zero (zero_mul a)))
    (fun (n : Nat) (ih : myMul a n = myMul n a) =>
      @Eq.trans.{1} Nat (myMul a (Nat.succ n)) (Nat.add a (myMul a n)) (myMul (Nat.succ n) a)
        (@Eq.refl.{1} Nat (Nat.add a (myMul a n)))
        (@Eq.trans.{1} Nat (Nat.add a (myMul a n)) (Nat.add (myMul n a) a) (myMul (Nat.succ n) a)
          (@Eq.trans.{1} Nat (Nat.add a (myMul a n)) (Nat.add a (myMul n a)) (Nat.add (myMul n a) a)
            (congrArg.{1} (fun (x : Nat) => Nat.add a x) ih)
            (add_comm a (myMul n a)))
          (@Eq.symm.{1} Nat (myMul (Nat.succ n) a) (Nat.add (myMul n a) a) (succ_mul n a))))
    b

-- ─────────────────────────────────────────────────────────────
-- ㉒.1 加法搬运（分配律步例要用）
-- ─────────────────────────────────────────────────────────────

theorem add_mid (a x y : Nat) :
    Nat.add a (Nat.add x y) = Nat.add x (Nat.add a y) :=
  @Eq.trans.{1} Nat
    (Nat.add a (Nat.add x y))
    (Nat.add (Nat.add a x) y)
    (Nat.add x (Nat.add a y))
    (@Eq.symm.{1} Nat (Nat.add (Nat.add a x) y) (Nat.add a (Nat.add x y)) (add_assoc a x y))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add a x) y)
      (Nat.add (Nat.add x a) y)
      (Nat.add x (Nat.add a y))
      (congrArg.{1} (fun (m : Nat) => Nat.add m y) (add_comm a x))
      (add_assoc x a y))

-- ─────────────────────────────────────────────────────────────
-- ㉒.2 左分配律：a * (b + c) = a*b + a*c（对 c 归纳）
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：对 c 归纳。基例 c = 0 时 `b + 0` 定义性等于 b、`a * 0` 定义性等于 0，两边都是 `a*b`，`Eq.refl` 即可；步例把 `a * (b + succ n)` 展开成 `a + a*(b+n)`，用 ih 换成 `a + (a*b + a*n)`，再交给 add_mid 换成 `a*b + (a + a*n)`。
-- soko:hint 目标形态：myMul a (b + c) = myMul a b + myMul a c。
-- soko:hint 关键件：Nat.rec · congrArg（在 add a 下改写 ih）· add_mid · Eq.refl（定义性展开）。

theorem mul_add (a b c : Nat) :
    myMul a (Nat.add b c) = Nat.add (myMul a b) (myMul a c) :=
  Nat.rec (fun (n : Nat) => myMul a (Nat.add b n) = Nat.add (myMul a b) (myMul a n))
    (@Eq.refl.{1} Nat (myMul a b))
    (fun (n : Nat)
         (ih : myMul a (Nat.add b n) = Nat.add (myMul a b) (myMul a n)) =>
      @Eq.trans.{1} Nat
        (myMul a (Nat.add b (Nat.succ n)))
        (Nat.add a (myMul a (Nat.add b n)))
        (Nat.add (myMul a b) (myMul a (Nat.succ n)))
        (@Eq.refl.{1} Nat (Nat.add a (myMul a (Nat.add b n))))
        (@Eq.trans.{1} Nat
          (Nat.add a (myMul a (Nat.add b n)))
          (Nat.add a (Nat.add (myMul a b) (myMul a n)))
          (Nat.add (myMul a b) (myMul a (Nat.succ n)))
          (congrArg.{1} (fun (m : Nat) => Nat.add a m) ih)
          (add_mid a (myMul a b) (myMul a n))))
    c

-- ─────────────────────────────────────────────────────────────
-- ㉒.3 右分配律：(a + b) * c = a*c + b*c
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：把左边用 myMul_comm 翻成 `c * (a+b)`，交给 mul_add 展开，再用两次 myMul_comm（一次对 c a，一次对 c b）把因子顺序摆回来。
-- soko:hint 目标形态：myMul (a + b) c = myMul a c + myMul b c。
-- soko:hint 关键件：myMul_comm · mul_add · congrArg（两次，分别改第一个与第二个加数）· Eq.trans。

theorem mul_add_right (a b c : Nat) :
    myMul (Nat.add a b) c = Nat.add (myMul a c) (myMul b c) :=
  @Eq.trans.{1} Nat
    (myMul (Nat.add a b) c)
    (myMul c (Nat.add a b))
    (Nat.add (myMul a c) (myMul b c))
    (myMul_comm (Nat.add a b) c)
    (@Eq.trans.{1} Nat
      (myMul c (Nat.add a b))
      (Nat.add (myMul c a) (myMul c b))
      (Nat.add (myMul a c) (myMul b c))
      (mul_add c a b)
      (@Eq.trans.{1} Nat
        (Nat.add (myMul c a) (myMul c b))
        (Nat.add (myMul a c) (myMul c b))
        (Nat.add (myMul a c) (myMul b c))
        (congrArg.{1} (fun (m : Nat) => Nat.add m (myMul c b)) (myMul_comm c a))
        (congrArg.{1} (fun (m : Nat) => Nat.add (myMul a c) m) (myMul_comm c b))))

-- ─────────────────────────────────────────────────────────────
-- ㉒.4 结合律：(a * b) * c = a * (b * c)（对 c 归纳）
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：对 c 归纳。基例两边都归约成 0；步例把左边展开成 `(a*b) + (a*b)*n`，用 ih 把第二个加数换成 `a*(b*n)`，右边展开成 `a * (b + b*n)`，交给 mul_add 的对称收口。
-- soko:hint 目标形态：myMul (myMul a b) c = myMul a (myMul b c)。
-- soko:hint 关键件：Nat.rec · congrArg（在 add (a*b) 下改写 ih）· mul_add（取对称）· Eq.refl（定义性展开）。

theorem myMul_assoc (a b c : Nat) :
    myMul (myMul a b) c = myMul a (myMul b c) :=
  Nat.rec (fun (n : Nat) => myMul (myMul a b) n = myMul a (myMul b n))
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat)
         (ih : myMul (myMul a b) n = myMul a (myMul b n)) =>
      @Eq.trans.{1} Nat
        (myMul (myMul a b) (Nat.succ n))
        (Nat.add (myMul a b) (myMul a (myMul b n)))
        (myMul a (myMul b (Nat.succ n)))
        (congrArg.{1} (fun (m : Nat) => Nat.add (myMul a b) m) ih)
        (@Eq.symm.{1} Nat
          (myMul a (Nat.add b (myMul b n)))
          (Nat.add (myMul a b) (myMul a (myMul b n)))
          (mul_add a b (myMul b n))))
    c

-- ─────────────────────────────────────────────────────────────
-- ㉓.1 两个加数同时改写（congrArg 两次装成一个引理）
-- ─────────────────────────────────────────────────────────────

-- ─────────────────────────────────────────────────────────────
-- ㉔.1 加法：`Nat.add a (succ b)` 定义性展开成 `succ (Nat.add a b)`
-- ─────────────────────────────────────────────────────────────

theorem add_succ (a b : Nat) :
    Nat.add a (Nat.succ b) = Nat.succ (Nat.add a b) :=
  Eq.refl (Nat.succ (Nat.add a b))

-- 前驱：`pred (succ n) = n` 是定义性相等；用于从前驱等式换回原等式。

def Nat.pred (n : Nat) : Nat := match n with
| zero => Nat.zero
| succ m => m

-- 本语言没有内建的 `Nat.succ.inj`：对等式两边取前驱即得（定义性相等）。

theorem Nat.succ.inj (a b : Nat) (h : Nat.succ a = Nat.succ b) :
    a = b :=
  congrArg.{1} Nat.pred h

-- 单元⑭的加法消去律，本单元自用（本单元自备）。

theorem nat_add_cancel_right (a b k : Nat) :
    Nat.add a k = Nat.add b k → a = b :=
  Nat.rec
    (fun (n : Nat) => Nat.add a n = Nat.add b n → a = b)
    (fun (h : a = b) => h)
    (fun (n : Nat)
         (ih : Nat.add a n = Nat.add b n → a = b) =>
      fun (h : Nat.succ (Nat.add a n) = Nat.succ (Nat.add b n)) =>
        ih (Nat.succ.inj (Nat.add a n) (Nat.add b n) h))
    k

-- soko:hint 思路：对 `h : succ n = 0` 用 `Eq.subst`，motive 用 `match` 把 0 映成 True、succ 映成 False。先对 h 取对称（0 = succ n），才能把 True.intro 搬到 succ n 上。
-- soko:hint 关键件：Eq.subst / Eq.symm / True.intro / match（本语言支持对 Nat 的模式匹配）。

theorem succ_ne_zero (n : Nat) :
    Nat.succ n = Nat.zero → False :=
  fun (h : Nat.succ n = Nat.zero) =>
    @Eq.subst.{1} Nat
      (fun (m : Nat) =>
        Nat.rec (fun (_ : Nat) => Prop) True (fun (k : Nat) (ih : Prop) => False) m)
      Nat.zero (Nat.succ n)
      (@Eq.symm.{1} Nat (Nat.succ n) Nat.zero h)
      True.intro

-- soko:hint 思路：对 b 归纳。b = 0 时目标就是 0 = 0，Eq.refl；b = succ n 时 `a + succ n` 定义性等于 `succ (a+n)`，用 add_succ 把它写成 succ，再交给 succ_ne_zero 得到 False，最后 False.elim。
-- soko:hint 目标形态：`a + b = 0 → b = 0`。
-- soko:hint 关键件：Nat.rec · add_succ · succ_ne_zero · @False.elim（显式给目标类型）。

theorem add_eq_zero_right (a b : Nat) :
    Nat.add a b = Nat.zero → b = Nat.zero :=
  Nat.rec
    (fun (n : Nat) => Nat.add a n = Nat.zero → n = Nat.zero)
    (fun (h : Nat.add a Nat.zero = Nat.zero) => @Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat)
         (ih : Nat.add a n = Nat.zero → n = Nat.zero) =>
      fun (h : Nat.add a (Nat.succ n) = Nat.zero) =>
        @False.elim (Nat.succ n = Nat.zero)
          (succ_ne_zero (Nat.add a n) (@Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.add a (Nat.succ n)) Nat.zero
            (@Eq.symm.{1} Nat (Nat.add a (Nat.succ n)) (Nat.succ (Nat.add a n)) (add_succ a n)) h)))
    b

-- soko:hint 思路：对 b 归纳。b = 0 时两边都是 0，Eq.refl；b = succ n 时用 succ_mul 把 `(b+1)·(n+1)` 展开成 `b·(n+1) + (n+1)`，交给 add_eq_zero_right 得到 `n+1 = 0`，再用 succ_ne_zero 得到 False。
-- soko:hint 目标形态：`b · (n+1) = 0 → b = 0`。
-- soko:hint 关键件：Nat.rec · succ_mul · add_eq_zero_right · succ_ne_zero · @False.elim。

theorem mul_eq_zero_right (b n : Nat) :
    myMul b (Nat.succ n) = Nat.zero → b = Nat.zero :=
  Nat.rec
    (fun (m : Nat) => myMul m (Nat.succ n) = Nat.zero → m = Nat.zero)
    (fun (h : myMul Nat.zero (Nat.succ n) = Nat.zero) => @Eq.refl.{1} Nat Nat.zero)
    (fun (m : Nat)
         (ih : myMul m (Nat.succ n) = Nat.zero → m = Nat.zero) =>
      fun (h : myMul (Nat.succ m) (Nat.succ n) = Nat.zero) =>
        @False.elim (Nat.succ m = Nat.zero)
          (succ_ne_zero n
            (add_eq_zero_right (myMul m (Nat.succ n)) (Nat.succ n)
              (@Eq.trans.{1} Nat (Nat.add (myMul m (Nat.succ n)) (Nat.succ n)) (myMul (Nat.succ m) (Nat.succ n)) Nat.zero
                (@Eq.symm.{1} Nat (myMul (Nat.succ m) (Nat.succ n)) (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
                  (succ_mul m (Nat.succ n)))
                h))))
    b

-- soko:hint 思路：先证一条「剥掉一层 succ」的辅助引理：两边各用 succ_mul 展开成 `a'·d + d`，再用 nat_add_cancel_right 消去 `+ d`。主定理对 a 归纳；后继情形再对 b 归纳，b = 0 用 mul_eq_zero_right，b = succ b' 用辅助引理把问题降回归纳假设，最后 congrArg succ。
-- soko:hint 目标形态：`a · (n+1) = b · (n+1) → a = b`。
-- soko:hint 关键件：Nat.rec（两层）· succ_mul · nat_add_cancel_right · zero_mul · mul_eq_zero_right · congrArg。

theorem mul_succ_cancel (n m d : Nat)
    (h : myMul (Nat.succ m) (Nat.succ n) = myMul (Nat.succ d) (Nat.succ n)) :
    myMul m (Nat.succ n) = myMul d (Nat.succ n) :=
  nat_add_cancel_right (myMul m (Nat.succ n)) (myMul d (Nat.succ n)) (Nat.succ n)
    (@Eq.trans.{1} Nat
      (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
      (myMul (Nat.succ m) (Nat.succ n))
      (Nat.add (myMul d (Nat.succ n)) (Nat.succ n))
      (@Eq.symm.{1} Nat (myMul (Nat.succ m) (Nat.succ n))
        (Nat.add (myMul m (Nat.succ n)) (Nat.succ n)) (succ_mul m (Nat.succ n)))
      (@Eq.trans.{1} Nat
        (myMul (Nat.succ m) (Nat.succ n))
        (myMul (Nat.succ d) (Nat.succ n))
        (Nat.add (myMul d (Nat.succ n)) (Nat.succ n))
        h (succ_mul d (Nat.succ n))))

theorem mul_cancel_succ_step (n m : Nat)
    (ih : ∀ (c : Nat),
      myMul m (Nat.succ n) = myMul c (Nat.succ n) →
      m = c)
    (c : Nat) :
    myMul (Nat.succ m) (Nat.succ n) = myMul c (Nat.succ n) →
    Nat.succ m = c :=
  Nat.rec
    (fun (d : Nat) =>
      myMul (Nat.succ m) (Nat.succ n) = myMul d (Nat.succ n) →
      Nat.succ m = d)
    (fun (h : myMul (Nat.succ m) (Nat.succ n) = myMul Nat.zero (Nat.succ n)) =>
      mul_eq_zero_right (Nat.succ m) n
        (@Eq.subst.{1} Nat
          (fun (x : Nat) => myMul (Nat.succ m) (Nat.succ n) = x)
          (myMul Nat.zero (Nat.succ n)) Nat.zero
          (zero_mul (Nat.succ n)) h))
    (fun (d : Nat) (_ : myMul (Nat.succ m) (Nat.succ n) = myMul d (Nat.succ n) →
        Nat.succ m = d) =>
      fun (h : myMul (Nat.succ m) (Nat.succ n) = myMul (Nat.succ d) (Nat.succ n)) =>
        congrArg.{1} Nat.succ (ih d (mul_succ_cancel n m d h)))
    c

theorem mul_zero_eq (n c : Nat)
    (h : myMul Nat.zero (Nat.succ n) = myMul c (Nat.succ n)) :
    myMul c (Nat.succ n) = Nat.zero :=
  @Eq.symm.{1} Nat Nat.zero (myMul c (Nat.succ n))
    (@Eq.subst.{1} Nat
      (fun (x : Nat) => x = myMul c (Nat.succ n))
      (myMul Nat.zero (Nat.succ n)) Nat.zero
      (zero_mul (Nat.succ n)) h)

theorem mul_cancel_pos (n a b : Nat) :
    myMul a (Nat.succ n) = myMul b (Nat.succ n) →
    a = b :=
  Nat.rec
    (fun (m : Nat) => ∀ (c : Nat),
      myMul m (Nat.succ n) = myMul c (Nat.succ n) →
      m = c)
    (fun (c : Nat) (h : myMul Nat.zero (Nat.succ n) = myMul c (Nat.succ n)) =>
      @Eq.symm.{1} Nat c Nat.zero
        (mul_eq_zero_right c n (mul_zero_eq n c h)))
    (fun (m : Nat) (ih : ∀ (c : Nat),
        myMul m (Nat.succ n) = myMul c (Nat.succ n) →
        m = c) =>
      fun (c : Nat) =>
        mul_cancel_succ_step n m ih c)
    a
    b

theorem add_congr {a a' b b' : Nat}
    (h1 : a = a') (h2 : b = b') :
    Nat.add a b = Nat.add a' b' :=
  @Eq.trans.{1} Nat (Nat.add a b) (Nat.add a' b) (Nat.add a' b')
    (congrArg.{1} (fun (x : Nat) => Nat.add x b) h1)
    (congrArg.{1} (fun (y : Nat) => Nat.add a' y) h2)

theorem add_rotate (a k j : Nat) :
    Nat.add (Nat.add a k) j = Nat.add (Nat.add a j) k :=
  @Eq.trans.{1} Nat (Nat.add (Nat.add a k) j) (Nat.add a (Nat.add k j)) (Nat.add (Nat.add a j) k)
    (add_assoc a k j)
    (@Eq.trans.{1} Nat (Nat.add a (Nat.add k j)) (Nat.add a (Nat.add j k)) (Nat.add (Nat.add a j) k)
      (congrArg.{1} (fun (x : Nat) => Nat.add a x) (add_comm k j))
      (@Eq.symm.{1} Nat (Nat.add (Nat.add a j) k) (Nat.add a (Nat.add j k)) (add_assoc a j k)))


theorem intRel_trans_mid (a b c d e f : Nat)
    (h1 : Nat.add a d = Nat.add c b)
    (h2 : Nat.add c f = Nat.add e d) :
    Nat.add (Nat.add a d) f = Nat.add (Nat.add e d) b :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a d) f)
    (Nat.add (Nat.add c b) f)
    (Nat.add (Nat.add e d) b)
    (congrArg.{1} (fun (x : Nat) => Nat.add x f) h1)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add c b) f)
      (Nat.add (Nat.add c f) b)
      (Nat.add (Nat.add e d) b)
      (add_rotate c b f)
      (congrArg.{1} (fun (x : Nat) => Nat.add x b) h2))


theorem intRel_trans (p q r : Prod Nat Nat)
    (h1 : intRel p q) (h2 : intRel q r) : intRel p r :=
  nat_add_cancel_right
    (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat r))
    (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat p))
    (Prod.snd Nat Nat q)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat r)) (Prod.snd Nat Nat q))
      (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat r))
      (Nat.add (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat p)) (Prod.snd Nat Nat q))
      (@Eq.symm.{1} Nat
        (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat r))
        (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat r)) (Prod.snd Nat Nat q))
        (add_rotate (Prod.fst Nat Nat p) (Prod.snd Nat Nat q) (Prod.snd Nat Nat r)))
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat r))
        (Nat.add (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat p))
        (Nat.add (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat p)) (Prod.snd Nat Nat q))
        (intRel_trans_mid
          (Prod.fst Nat Nat p) (Prod.snd Nat Nat p)
          (Prod.fst Nat Nat q) (Prod.snd Nat Nat q)
          (Prod.fst Nat Nat r) (Prod.snd Nat Nat r) h1 h2)
        (add_rotate (Prod.fst Nat Nat r) (Prod.snd Nat Nat q) (Prod.snd Nat Nat p))))

theorem mul_congr (a b a' b' c : Nat)
    (h : Nat.add a b' = Nat.add a' b) :
    myMul (Nat.add a b') c = myMul (Nat.add a' b) c :=
  @Eq.subst.{1} Nat
    (fun (x : Nat) => myMul (Nat.add a b') c = myMul x c)
    (Nat.add a b') (Nat.add a' b) h
    (@Eq.refl.{1} Nat (myMul (Nat.add a b') c))

-- h 乘开：a·c + b'·c = a'·c + b·c。

theorem mul_shift_c (a b a' b' c : Nat)
    (h : Nat.add a b' = Nat.add a' b) :
    Nat.add (myMul a c) (myMul b' c) =
    Nat.add (myMul a' c) (myMul b c) :=
  @Eq.trans.{1} Nat
    (Nat.add (myMul a c) (myMul b' c))
    (myMul (Nat.add a b') c)
    (Nat.add (myMul a' c) (myMul b c))
    (@Eq.symm.{1} Nat
      (myMul (Nat.add a b') c)
      (Nat.add (myMul a c) (myMul b' c))
      (mul_add_right a b' c))
    (@Eq.trans.{1} Nat
      (myMul (Nat.add a b') c)
      (myMul (Nat.add a' b) c)
      (Nat.add (myMul a' c) (myMul b c))
      (mul_congr a b a' b' c h)
      (mul_add_right a' b c))

theorem intRel_symm (a b : Prod Nat Nat)
    (h : intRel a b) : intRel b a :=
  @Eq.symm.{1} Nat
    (Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b))
    (Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a))
    h

theorem mulRep_den (p : Prod Nat Nat) (n : Nat) :
    intRel (mulRep p (den n))
      (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat p) (Nat.succ n))
                        (myMul (Prod.snd Nat Nat p) (Nat.succ n))) :=
  congrArg.{1} (fun (x : Nat) =>
      Nat.add (myMul (Prod.fst Nat Nat p) (Nat.succ n)) x)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
      (myMul (Prod.snd Nat Nat p) (Nat.succ n))
      (zero_add (myMul (Prod.snd Nat Nat p) (Nat.succ n))))


-- 把「两边都乘上同一正分母」的等价假设化成一条 ℕ 加法等式。

theorem mulRep_den_mid (u v : Prod Nat Nat) (n : Nat)
    (h : intRel (mulRep u (den n)) (mulRep v (den n))) :
    Nat.add (myMul (Prod.fst Nat Nat u) (Nat.succ n))
               (myMul (Prod.snd Nat Nat v) (Nat.succ n)) =
      Nat.add (myMul (Prod.fst Nat Nat v) (Nat.succ n))
               (myMul (Prod.snd Nat Nat u) (Nat.succ n)) :=
  intRel_trans
    (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat u) (Nat.succ n))
                        (myMul (Prod.snd Nat Nat u) (Nat.succ n)))
    (mulRep u (den n))
    (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat v) (Nat.succ n))
                        (myMul (Prod.snd Nat Nat v) (Nat.succ n)))
    (intRel_symm (mulRep u (den n))
      (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat u) (Nat.succ n))
                          (myMul (Prod.snd Nat Nat u) (Nat.succ n)))
      (mulRep_den u n))
    (intRel_trans (mulRep u (den n)) (mulRep v (den n))
      (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat v) (Nat.succ n))
                          (myMul (Prod.snd Nat Nat v) (Nat.succ n)))
      h (mulRep_den v n))

-- 正分母可消去：mulRep u (n+1,0) ~ mulRep v (n+1,0) ⇒ u ~ v。
-- soko:hint 思路：先把 `mulRep u (den n)` 与 `mulRep v (den n)` 化到规范形 `(u1·d, u2·d)`、`(v1·d, v2·d)`（`d = n+1`），假设就变成 `u1·d + v2·d = v1·d + u2·d`；两边分别用 `mul_add_right` 收成 `(u1+v2)·d` 与 `(v1+u2)·d`，最后用 `mul_cancel_pos` 消去正因子 `d`。
-- soko:hint 目标形态：mulRep u (den n) ~ mulRep v (den n) ⇒ u ~ v。

theorem intRel_refl (p : Prod Nat Nat) : intRel p p :=
  Eq.refl (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat p))


-- ─────────────────────────────────────────────────────────────
-- ㉖.1 公分母：`succ (m*n + m + n) = (m+1)(n+1)`
-- ─────────────────────────────────────────────────────────────

-- `ratRep` 的分母字段是「`succ` 编码」：真正的分母 = 字段 + 1。两个有理数
-- 相加时公分母是 `(m+1)(n+1)`，所以结果的分母字段取 `m*n + m + n`。

def ratDenRep (m n : Nat) : Nat :=
  Nat.add (Nat.add (myMul m n) m) n

-- 把有理数写成「分子序对 + 分母字段」的规范形状（只为这里的陈述好读）。

def qrep (a b m : Nat) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat a b) m

-- soko:hint 思路：左边 `succ (m*n + m + n)` 定义性等于 `(m*n + m) + (n+1)`；右边用 `succ_mul` 展开成 `m*(n+1) + (n+1)`，再用 `mul_add` 把 `m*(n+1)` 拆成 `m*n + m*1`（`m*1` 定义性归约成 `m`）。
-- soko:hint 目标形态：succ (m*n + m + n) = (m+1)*(n+1)。
-- soko:hint 关键件：congrArg · mul_add · succ_mul（取对称）· Eq.refl（定义性归约）。

theorem ratDenRep_succ (m n : Nat) :
    Nat.succ (ratDenRep m n) = myMul (Nat.succ m) (Nat.succ n) :=
  @Eq.trans.{1} Nat
    (Nat.succ (ratDenRep m n))
    (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
    (myMul (Nat.succ m) (Nat.succ n))
    (@Eq.symm.{1} Nat
      (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
      (Nat.succ (ratDenRep m n))
      (congrArg.{1} (fun (x : Nat) => Nat.add x (Nat.succ n))
        (mul_add m n (Nat.succ Nat.zero))))
    (@Eq.symm.{1} Nat
      (myMul (Nat.succ m) (Nat.succ n))
      (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
      (succ_mul m (Nat.succ n)))

-- ─────────────────────────────────────────────────────────────
-- ㉖.2 加法的代表元公式
-- ─────────────────────────────────────────────────────────────

-- (a-b)/(m+1) + (c-d)/(n+1)
--   = [(a(n+1) + c(m+1)) - (b(n+1) + d(m+1))] / ((m+1)(n+1))
-- 分母字段就是 ㉖.1 的 `ratDenRep m n`。

def numOf (x : ratRep) : Prod Nat Nat :=
  Prod.fst (Prod Nat Nat) Nat x

def denOf (x : ratRep) : Nat :=
  Prod.snd (Prod Nat Nat) Nat x

def T1 (a c e : Nat) : Nat := myMul a (myMul c e)

def T2 (b d e : Nat) : Nat := myMul b (myMul d e)

def T3 (a d f : Nat) : Nat := myMul a (myMul d f)

def T4 (b c f : Nat) : Nat := myMul b (myMul c f)

def T5 (a c f : Nat) : Nat := myMul a (myMul c f)

def T6 (a d e : Nat) : Nat := myMul a (myMul d e)

def T7 (b c e : Nat) : Nat := myMul b (myMul c e)

def T8 (b d f : Nat) : Nat := myMul b (myMul d f)

-- ─────────────────────────────────────────────────────────────
-- ㉓.2 第一个分量：两边各自展开，再在规范形上换配对
-- ─────────────────────────────────────────────────────────────

-- 左边：((a*c + b*d)*e + (a*d + b*c)*f) 展开成四个乘积。

theorem fst_expand_left (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) e)
               (myMul (Nat.add (myMul a d) (myMul b c)) f) =
      Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
               (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)) :=
  add_congr
    (mul_add_right (myMul a c) (myMul b d) e)
    (mul_add_right (myMul a d) (myMul b c) f)

-- 右边：a*(c*e + d*f) + b*(c*f + d*e) 展开成四个乘积。

theorem fst_expand_right (a b c d e f : Nat) :
    Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
               (myMul b (Nat.add (myMul c f) (myMul d e))) =
      Nat.add (Nat.add (T1 a c e) (T3 a d f))
               (Nat.add (T4 b c f) (T2 b d e)) :=
  add_congr
    (mul_add a (myMul c e) (myMul d f))
    (mul_add b (myMul c f) (myMul d e))

-- 左边四个乘积用结合律改成规范形。

theorem fst_normalize (a b c d e f : Nat) :
    Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
               (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)) =
      Nat.add (Nat.add (T1 a c e) (T2 b d e))
               (Nat.add (T3 a d f) (T4 b c f)) :=
  add_congr
    (add_congr (myMul_assoc a c e) (myMul_assoc b d e))
    (add_congr (myMul_assoc a d f) (myMul_assoc b c f))

-- 规范形上换一次配对：add_shift 把中间两个加数对调，
-- 再用 add_comm 把第四个与第二个加数对调。

theorem fst_shift (a b c d e f : Nat) :
    Nat.add (Nat.add (T1 a c e) (T2 b d e))
               (Nat.add (T3 a d f) (T4 b c f)) =
      Nat.add (Nat.add (T1 a c e) (T3 a d f))
               (Nat.add (T4 b c f) (T2 b d e)) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add (T1 a c e) (T2 b d e))
             (Nat.add (T3 a d f) (T4 b c f)))
    (Nat.add (Nat.add (T1 a c e) (T3 a d f))
             (Nat.add (T2 b d e) (T4 b c f)))
    (Nat.add (Nat.add (T1 a c e) (T3 a d f))
             (Nat.add (T4 b c f) (T2 b d e)))
    (Eq.symm (add_shift (T1 a c e) (T2 b d e) (T3 a d f) (T4 b c f)))
    (add_congr (Eq.refl (Nat.add (T1 a c e) (T3 a d f)))
               (add_comm (T2 b d e) (T4 b c f)))

-- ─────────────────────────────────────────────────────────────
-- ㉓.3 第二个分量：同样的四步，只是 b/d 与 a/c 的角色换了位置
-- ─────────────────────────────────────────────────────────────

theorem snd_expand_left (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) f)
               (myMul (Nat.add (myMul a d) (myMul b c)) e) =
      Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
               (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)) :=
  add_congr
    (mul_add_right (myMul a c) (myMul b d) f)
    (mul_add_right (myMul a d) (myMul b c) e)

theorem snd_expand_right (a b c d e f : Nat) :
    Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
               (myMul b (Nat.add (myMul c e) (myMul d f))) =
      Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T7 b c e) (T8 b d f)) :=
  add_congr
    (mul_add a (myMul c f) (myMul d e))
    (mul_add b (myMul c e) (myMul d f))

theorem snd_normalize (a b c d e f : Nat) :
    Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
               (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)) =
      Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)) :=
  add_congr
    (add_congr (myMul_assoc a c f) (myMul_assoc b d f))
    (add_congr (myMul_assoc a d e) (myMul_assoc b c e))

theorem snd_shift (a b c d e f : Nat) :
    Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)) =
      Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T7 b c e) (T8 b d f)) :=
  Eq.symm
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T7 b c e) (T8 b d f)))
      (Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T8 b d f) (T7 b c e)))
      (Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)))
      (add_congr (Eq.refl (Nat.add (T5 a c f) (T6 a d e)))
                 (add_comm (T7 b c e) (T8 b d f)))
      (add_shift (T5 a c f) (T8 b d f) (T6 a d e) (T7 b c e)))

-- ─────────────────────────────────────────────────────────────
-- ㉓.4 两个分量的等式
-- ─────────────────────────────────────────────────────────────

theorem mulRep_assoc_fst (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) e)
               (myMul (Nat.add (myMul a d) (myMul b c)) f) =
      Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
               (myMul b (Nat.add (myMul c f) (myMul d e))) :=
  @Eq.trans.{1} Nat
    (Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) e)
             (myMul (Nat.add (myMul a d) (myMul b c)) f))
    (Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
             (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)))
    (Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
             (myMul b (Nat.add (myMul c f) (myMul d e))))
    (fst_expand_left a b c d e f)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
               (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)))
      (Nat.add (Nat.add (T1 a c e) (T2 b d e))
               (Nat.add (T3 a d f) (T4 b c f)))
      (Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
               (myMul b (Nat.add (myMul c f) (myMul d e))))
      (fst_normalize a b c d e f)
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (T1 a c e) (T2 b d e))
                 (Nat.add (T3 a d f) (T4 b c f)))
        (Nat.add (Nat.add (T1 a c e) (T3 a d f))
                 (Nat.add (T4 b c f) (T2 b d e)))
        (Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
                 (myMul b (Nat.add (myMul c f) (myMul d e))))
        (fst_shift a b c d e f)
        (Eq.symm (fst_expand_right a b c d e f))))

theorem mulRep_assoc_snd (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) f)
               (myMul (Nat.add (myMul a d) (myMul b c)) e) =
      Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
               (myMul b (Nat.add (myMul c e) (myMul d f))) :=
  @Eq.trans.{1} Nat
    (Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) f)
             (myMul (Nat.add (myMul a d) (myMul b c)) e))
    (Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
             (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)))
    (Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
             (myMul b (Nat.add (myMul c e) (myMul d f))))
    (snd_expand_left a b c d e f)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
               (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)))
      (Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)))
      (Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
               (myMul b (Nat.add (myMul c e) (myMul d f))))
      (snd_normalize a b c d e f)
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (T5 a c f) (T8 b d f))
                 (Nat.add (T6 a d e) (T7 b c e)))
        (Nat.add (Nat.add (T5 a c f) (T6 a d e))
                 (Nat.add (T7 b c e) (T8 b d f)))
        (Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
                 (myMul b (Nat.add (myMul c e) (myMul d f))))
        (snd_shift a b c d e f)
        (Eq.symm (snd_expand_right a b c d e f))))

-- ─────────────────────────────────────────────────────────────
-- ㉓.5 拼成 intRel：fst(left) + snd(right) = fst(right) + snd(left)
-- ─────────────────────────────────────────────────────────────

theorem mulRep_assoc (a b c d e f : Nat) :
    intRel
      (mulRep (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
              (@prod_mk Nat Nat e f))
      (mulRep (@prod_mk Nat Nat a b)
              (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f))) :=
  add_congr
    (mulRep_assoc_fst a b c d e f)
    (Eq.symm (mulRep_assoc_snd a b c d e f))

-- 具体数字上走一遍：(2,1)*(3,1) 得 (7,5)，再乘 (4,1)；
-- 与 2 先乘 ((3,1)*(4,1)) 的结果代表元相等。

theorem mulRep_comm (a b c d : Nat) :
    mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
      mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b) :=
  @Eq.trans.{1} (Prod Nat Nat)
    (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
    (@prod_mk Nat Nat
      (Nat.add (myMul c a) (myMul d b))
      (Nat.add (myMul a d) (myMul b c)))
    (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
    (congrArg.{1}
      (fun (x : Nat) => @prod_mk Nat Nat x (Nat.add (myMul a d) (myMul b c)))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a c) (myMul b d))
        (Nat.add (myMul c a) (myMul b d))
        (Nat.add (myMul c a) (myMul d b))
        (congrArg.{1} (fun (x : Nat) => Nat.add x (myMul b d)) (myMul_comm a c))
        (congrArg.{1} (fun (y : Nat) => Nat.add (myMul c a) y) (myMul_comm b d))))
    (congrArg.{1}
      (fun (y : Nat) => @prod_mk Nat Nat (Nat.add (myMul c a) (myMul d b)) y)
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a d) (myMul b c))
        (Nat.add (myMul d a) (myMul c b))
        (Nat.add (myMul c b) (myMul d a))
        (@Eq.trans.{1} Nat
          (Nat.add (myMul a d) (myMul b c))
          (Nat.add (myMul d a) (myMul b c))
          (Nat.add (myMul d a) (myMul c b))
          (congrArg.{1} (fun (x : Nat) => Nat.add x (myMul b c)) (myMul_comm a d))
          (congrArg.{1} (fun (y : Nat) => Nat.add (myMul d a) y) (myMul_comm b c)))
        (add_comm (myMul d a) (myMul c b))))

theorem mulRep_wd (a b a' b' c d : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b')) :
    intRel (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
           (mulRep (@prod_mk Nat Nat a' b') (@prod_mk Nat Nat c d)) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add (myMul a c) (myMul b d))
             (Nat.add (myMul a' d) (myMul b' c)))
    (Nat.add (Nat.add (myMul a c) (myMul b' c))
             (Nat.add (myMul b d) (myMul a' d)))
    (Nat.add (Nat.add (myMul a' c) (myMul b' d))
             (Nat.add (myMul a d) (myMul b c)))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul a c) (myMul b d))
               (Nat.add (myMul a' d) (myMul b' c)))
      (Nat.add (Nat.add (myMul a c) (myMul b d))
               (Nat.add (myMul b' c) (myMul a' d)))
      (Nat.add (Nat.add (myMul a c) (myMul b' c))
               (Nat.add (myMul b d) (myMul a' d)))
      (@Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add (Nat.add (myMul a c) (myMul b d)) (Nat.add (myMul a' d) (myMul b' c)) =
          Nat.add (Nat.add (myMul a c) (myMul b d)) m)
        (Nat.add (myMul a' d) (myMul b' c))
        (Nat.add (myMul b' c) (myMul a' d))
        (add_comm (myMul a' d) (myMul b' c))
        (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a c) (myMul b d)) (Nat.add (myMul a' d) (myMul b' c)))))
      (add_shift (myMul a c) (myMul b' c) (myMul b d) (myMul a' d)))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul a c) (myMul b' c))
               (Nat.add (myMul b d) (myMul a' d)))
      (Nat.add (Nat.add (myMul a' c) (myMul b c))
               (Nat.add (myMul b d) (myMul a' d)))
      (Nat.add (Nat.add (myMul a' c) (myMul b' d))
               (Nat.add (myMul a d) (myMul b c)))
      (@Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add (Nat.add (myMul a c) (myMul b' c)) (Nat.add (myMul b d) (myMul a' d)) =
          Nat.add m (Nat.add (myMul b d) (myMul a' d)))
        (Nat.add (myMul a c) (myMul b' c))
        (Nat.add (myMul a' c) (myMul b c))
        (mul_shift_c a b a' b' c h)
        (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a c) (myMul b' c)) (Nat.add (myMul b d) (myMul a' d)))))
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (myMul a' c) (myMul b c))
                 (Nat.add (myMul b d) (myMul a' d)))
        (Nat.add (Nat.add (myMul a' c) (myMul b c))
                 (Nat.add (myMul b' d) (myMul a d)))
        (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                 (Nat.add (myMul a d) (myMul b c)))
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.add (Nat.add (myMul a' c) (myMul b c)) (Nat.add (myMul b d) (myMul a' d)) =
            Nat.add (Nat.add (myMul a' c) (myMul b c)) m)
          (Nat.add (myMul b d) (myMul a' d))
          (Nat.add (myMul b' d) (myMul a d))
          (@Eq.trans.{1} Nat
            (Nat.add (myMul b d) (myMul a' d))
            (Nat.add (myMul a' d) (myMul b d))
            (Nat.add (myMul b' d) (myMul a d))
            (add_comm (myMul b d) (myMul a' d))
            (@Eq.trans.{1} Nat
              (Nat.add (myMul a' d) (myMul b d))
              (Nat.add (myMul a d) (myMul b' d))
              (Nat.add (myMul b' d) (myMul a d))
              (@Eq.symm.{1} Nat
                (Nat.add (myMul a d) (myMul b' d))
                (Nat.add (myMul a' d) (myMul b d))
                (mul_shift_c a b a' b' d h))
              (add_comm (myMul a d) (myMul b' d))))
          (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a' c) (myMul b c)) (Nat.add (myMul b d) (myMul a' d)))))
        (@Eq.trans.{1} Nat
          (Nat.add (Nat.add (myMul a' c) (myMul b c))
                   (Nat.add (myMul b' d) (myMul a d)))
          (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                   (Nat.add (myMul b c) (myMul a d)))
          (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                   (Nat.add (myMul a d) (myMul b c)))
          (@Eq.symm.{1} Nat
            (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                     (Nat.add (myMul b c) (myMul a d)))
            (Nat.add (Nat.add (myMul a' c) (myMul b c))
                     (Nat.add (myMul b' d) (myMul a d)))
            (add_shift (myMul a' c) (myMul b c) (myMul b' d) (myMul a d)))
          (@Eq.subst.{1} Nat
            (fun (m : Nat) => Nat.add (Nat.add (myMul a' c) (myMul b' d)) (Nat.add (myMul b c) (myMul a d)) =
              Nat.add (Nat.add (myMul a' c) (myMul b' d)) m)
            (Nat.add (myMul b c) (myMul a d))
            (Nat.add (myMul a d) (myMul b c))
            (add_comm (myMul b c) (myMul a d))
            (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a' c) (myMul b' d)) (Nat.add (myMul b c) (myMul a d))))))))

-- ─────────────────────────────────────────────────────────────
theorem mulRep_wd_snd (a b a' b' c d : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b')) :
    intRel (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
           (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a' b')) :=
  @Eq.subst.{1} (Prod Nat Nat)
    (fun (y : Prod Nat Nat) =>
      intRel (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b)) y)
    (mulRep (@prod_mk Nat Nat a' b') (@prod_mk Nat Nat c d))
    (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a' b'))
    (mulRep_comm a' b' c d)
    (@Eq.subst.{1} (Prod Nat Nat)
      (fun (x : Prod Nat Nat) =>
        intRel x (mulRep (@prod_mk Nat Nat a' b') (@prod_mk Nat Nat c d)))
      (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
      (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
      (@Eq.symm.{1} (Prod Nat Nat)
        (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
        (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
        (mulRep_comm c d a b))
      (mulRep_wd a b a' b' c d h))

-- 演示：具体数字上走一遍 —— (2-0) ~ (3-1)，都用 (4-1) 乘在前面，结果仍等价。
-- (4,1)*(2,0) = (8,2)，(4,1)*(3,1) = (13,7)，而 8+7 = 13+2 = 15。

-- den 乘法的规范形：mulRep p (n+1,0) 与 (p1·(n+1), p2·(n+1)) 差相等。
-- soko:hint 思路：`mulRep p (n+1,0)` 的定义性展开是 `(p1·(n+1) + p2·0, p1·0 + p2·(n+1))`；把 `p2·0` 与 `p1·0` 归约成 0，再用 `zero_add` 把右边第二分量的 `0 + p2·(n+1)` 搬到 `p2·(n+1)`。
-- soko:hint 目标形态：mulRep p (den n) ~ (p1·(n+1), p2·(n+1))。
-- soko:hint 关键件：congrArg · Eq.symm · zero_add（乘零由定义性归约）。


-- ─────────────────────────────────────────────────────────────
-- ㉗.1 乘法的代表元公式
-- ─────────────────────────────────────────────────────────────

-- (a-b)/(m+1) * (c-d)/(n+1)
--   = [(ac + bd) - (ad + bc)] / ((m+1)(n+1))
-- 分子正是整数代表元的乘法 `mulRep`；分母字段仍用 ㉖.1 的 `ratDenRep m n`。

def ratMulRep (x y : ratRep) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat
    (mulRep (numOf x) (numOf y))
    (ratDenRep (denOf x) (denOf y))

theorem ratMulRep_mk (a b c d m n : Nat) :
    ratMulRep (qrep a b m) (qrep c d n) =
      qrep
        (Nat.add (myMul a c) (myMul b d))
        (Nat.add (myMul a d) (myMul b c))
        (ratDenRep m n) :=
  Eq.refl (qrep
    (Nat.add (myMul a c) (myMul b d))
    (Nat.add (myMul a d) (myMul b c))
    (ratDenRep m n))

-- soko:hint 思路：`ratMulRep` 的分母字段就是 `ratDenRep (denOf x) (denOf y)`，定义性相等。
-- soko:hint 目标形态：denOf (x*y) = ratDenRep (denOf x) (denOf y)。
-- soko:hint 关键件：Eq.refl（定义性归约）。
theorem ratMul_den (x y : ratRep) :
    denOf (ratMulRep x y) =
    ratDenRep (denOf x) (denOf y) :=
  Eq.refl (ratDenRep (denOf x) (denOf y))

-- soko:hint 思路：两个整数代表元相乘可以交换，直接引用整数层的 `mulRep_comm`。
-- soko:hint 目标形态：mulRep (a,b) (c,d) = mulRep (c,d) (a,b)。
-- soko:hint 关键件：mulRep_comm。
theorem ratMul_num_comm (a b c d : Nat) :
    mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
      mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b) :=
  mulRep_comm a b c d

-- ─────────────────────────────────────────────────────────────
-- ㉗.2 具体数字
-- ─────────────────────────────────────────────────────────────

-- 1/2 * 1/3：分子 (1·1 + 0·0, 1·0 + 0·1) = (1,0)，分母字段 1·2+1+2 = 5
-- （真正分母 6），正是 1/6。

-- soko:hint 思路：两边化到代表元后是同一个具体数字，全部由内核归约，`Eq.refl` 即可。
-- soko:hint 目标形态：(1/2 * 1/3) ~ 1/6。
-- soko:hint 关键件：Eq.refl。
theorem ratMul_demo_one :
    ratRel
      (ratMulRep (qrep 1 0 1) (qrep 1 0 2))
      (qrep 1 0 5) :=
  @Eq.refl.{1} Nat 6

-- 1/2 * 2/3 = 2/6 = 1/3：左边分子 (2,0)、分母字段 5；交叉相乘 2·3 = 1·6。

-- soko:hint 思路：左边代表元分子 2、分母字段 5，右边 1/3；交叉和 2·3 = 1·6 = 6，`Eq.refl`。
-- soko:hint 目标形态：(1/2 * 2/3) ~ 1/3。
-- soko:hint 关键件：Eq.refl。
theorem ratMul_demo_two :
    ratRel
      (ratMulRep (qrep 1 0 1) (qrep 2 0 2))
      (qrep 1 0 2) :=
  @Eq.refl.{1} Nat 6

-- 2/3 * 3/4 = 6/12 = 1/2：分子 6、分母字段 11。

-- soko:hint 思路：左边 6/12，右边 1/2；交叉和 6·2 = 1·12 = 12，`Eq.refl`。
-- soko:hint 目标形态：(2/3 * 3/4) ~ 1/2。
-- soko:hint 关键件：Eq.refl。
theorem ratMul_demo_three :
    ratRel
      (ratMulRep (qrep 2 0 2) (qrep 3 0 3))
      (qrep 1 0 1) :=
  @Eq.refl.{1} Nat 12

-- 同分母的 `ratRel` 可以消去正分母：`(a-b)/(m+1) ~ (a'-b')/(m+1)` 就是
-- `a + b' = a' + b`。乘法两条义务都要先把假设化成这个形状。

theorem rat_cross (a b a' b' : Nat) (m : Nat)
    (h : intRel (mulRep (@prod_mk Nat Nat a b) (den m))
                (mulRep (@prod_mk Nat Nat a' b') (den m))) :
    Nat.add a b' = Nat.add a' b :=
  mul_cancel_pos m (Nat.add a b') (Nat.add a' b)
    (@Eq.trans.{1} Nat
      (myMul (Nat.add a b') (Nat.succ m))
      (Nat.add (myMul a (Nat.succ m)) (myMul b' (Nat.succ m)))
      (myMul (Nat.add a' b) (Nat.succ m))
      (mul_add_right a b' (Nat.succ m))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a (Nat.succ m)) (myMul b' (Nat.succ m)))
        (Nat.add (myMul a' (Nat.succ m)) (myMul b (Nat.succ m)))
        (myMul (Nat.add a' b) (Nat.succ m))
        (mulRep_den_mid (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b') m h)
        (@Eq.symm.{1} Nat
          (myMul (Nat.add a' b) (Nat.succ m))
          (Nat.add (myMul a' (Nat.succ m)) (myMul b (Nat.succ m)))
          (mul_add_right a' b (Nat.succ m)))))

-- ─────────────────────────────────────────────────────────────
-- ㉘.1 乘法对第一个因子良定义
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：`ratAdd_cross` 先把 `x ~ x'` 化成整数代表元的相等 `a + b' = a' + b`；`mulRep_wd` 把它搬到两个乘积分子上；最后再用一次 `mulRep_wd`，把两个分子同时乘上公分母 `(m+1)(n+1)`，正好就是 `ratRel` 的定义。
-- soko:hint 目标形态：`x ~ x' ⇒ x*y ~ x'*y`（同分母 `m`、同一个 `y`）。
-- soko:hint 关键件：ratAdd_cross · mulRep_wd（两次，第二次的乘数是 `den (ratDenRep m n)`）。
theorem ratMulRep_wd (a b a' b' c d m n : Nat)
    (h : ratRel (qrep a b m) (qrep a' b' m)) :
    ratRel (ratMulRep (qrep a b m) (qrep c d n))
           (ratMulRep (qrep a' b' m) (qrep c d n)) :=
  sorry

-- ─────────────────────────────────────────────────────────────
-- ㉘.2 乘法对第二个因子良定义
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：与 ㉘.1 同构，只是这次把 `ratAdd_cross` 用在 `y ~ y'` 上；整数层的 `mulRep_wd_snd` 把 `c + d' = c' + d` 搬到 `x` 的两个乘积分子上，再乘回公分母。
-- soko:hint 目标形态：`y ~ y' ⇒ x*y ~ x*y'`（同分母 `n`、同一个 `x`）。
-- soko:hint 关键件：ratAdd_cross（作用在 `y` 上）· mulRep_wd_snd · mulRep_wd。
theorem ratMulRep_wd_snd (a b c d c' d' m n : Nat)
    (h : ratRel (qrep c d n) (qrep c' d' n)) :
    ratRel (ratMulRep (qrep a b m) (qrep c d n))
           (ratMulRep (qrep a b m) (qrep c' d' n)) :=
  sorry
