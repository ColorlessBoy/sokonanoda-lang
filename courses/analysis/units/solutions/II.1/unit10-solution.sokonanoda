-- 单元⑩ 整数乘法：零元与单位元 —— 解答
--
-- 单元⑤ 只写下了代表元公式 mulRep，还没有任何乘法律。
-- 要把它 lift 到商 Int 上（单元⑪的 mulRep_wd），先得把 ℕ 的乘法律补齐。
-- 本单元做最小的一段：乘法的零元与单位元。
--   myMul_zero : a * 0 = 0      （定义性相等）
--   myMul_one  : a * 1 = a
--   zero_mul   : 0 * a = 0      （对 a 归纳，是本章第一条乘法归纳）
-- 再把它们用在代表元上：p * 0 ~ 0 与 p * 1 ~ p。
-- 下一步（单元⑪）才证 mulRep_wd，那需要分配律与交换律。
import lib.Logic
import lib.Prod

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def intOfNat (n : Nat) : Int :=
  @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat n Nat.zero)

def myAdd (a b : Nat) : Nat :=
  Nat.rec (fun (_ : Nat) => Nat) a (fun (n : Nat) (ih : Nat) => Nat.succ ih) b

def myMul (a b : Nat) : Nat :=
  Nat.rec (fun (_ : Nat) => Nat) Nat.zero
    (fun (n : Nat) (ih : Nat) => myAdd a ih) b

def mulRep (a b : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (myMul (Prod.fst Nat Nat a) (Prod.fst Nat Nat b))
             (myMul (Prod.snd Nat Nat a) (Prod.snd Nat Nat b)))
    (Nat.add (myMul (Prod.fst Nat Nat a) (Prod.snd Nat Nat b))
             (myMul (Prod.snd Nat Nat a) (Prod.fst Nat Nat b)))

-- 单元③的 ℕ 零元律，本单元自用（L3：律必须留在单元里）。
theorem zero_add (b : Nat) :
    Nat.add Nat.zero b = b :=
  Nat.rec (fun (n : Nat) => Nat.add Nat.zero n = n)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Nat.add Nat.zero n = n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add Nat.zero n) = Nat.succ m)
        (Nat.add Nat.zero n) n ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add Nat.zero n))))
    b


-- 定义性相等：myMul 在第二个参数上递归，base 就是 0。
theorem myMul_zero (a : Nat) :
    myMul a Nat.zero = Nat.zero :=
  Eq.refl Nat.zero

-- 定义性相等：递归步把 myMul a (succ b) 展开成 myAdd a (myMul a b)。
theorem myMul_succ (a b : Nat) :
    myMul a (Nat.succ b) = myAdd a (myMul a b) :=
  Eq.refl (myAdd a (myMul a b))

-- soko:hint 思路：myMul a 1 展开成 myAdd a (myMul a 0) = myAdd a 0 = a。
-- soko:hint 目标形态：myMul a 1 = a。
-- soko:hint 关键件：Eq.refl a（两边定义性相等）。
theorem myMul_one (a : Nat) :
    myMul a (Nat.succ Nat.zero) = a :=
  Eq.refl a

-- soko:hint 思路：对 a 归纳。base：myMul 0 0 定义性等于 0。
-- soko:hint 目标形态：myMul 0 (succ n) = 0；它定义性等于 myMyMul 0 n，用 ih 改写。
-- soko:hint 关键件：Nat.rec · Eq.subst · Eq.refl。
theorem zero_mul (a : Nat) :
    myMul Nat.zero a = Nat.zero :=
  Nat.rec (fun (n : Nat) => myMul Nat.zero n = Nat.zero)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : myMul Nat.zero n = Nat.zero) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => myMul Nat.zero (Nat.succ n) = myAdd Nat.zero m)
        (myMul Nat.zero n) Nat.zero ih
        (@Eq.refl.{1} Nat (myMul Nat.zero (Nat.succ n))))
    a

-- soko:hint 思路：mulRep (a,b) (0,0) 的两个分量都是 a*0+b*0，定义性归约为 0。
-- soko:hint 目标形态：intRel (0,0) (0,0)，即 0+0 = 0+0。
-- soko:hint 关键件：Eq.refl 0。
theorem mulRep_zero_rep (a b : Nat) :
    intRel (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat Nat.zero Nat.zero))
           (@prod_mk Nat Nat Nat.zero Nat.zero) :=
  Eq.refl Nat.zero

-- soko:hint 思路：mulRep (a,b) (1,0) = (a*1+b*0, a*0+b*1)；myMul_one / myMul_zero 后与 (a,b) 相等。
-- soko:hint 目标形态：intRel (a,b) (a,b)，即 a+b = a+b。
-- soko:hint 关键件：Eq.refl (Nat.add a b)。
theorem mulRep_one_rep (a b : Nat) :
    intRel (mulRep (@prod_mk Nat Nat a b)
                  (@prod_mk Nat Nat (Nat.succ Nat.zero) Nat.zero))
           (@prod_mk Nat Nat a b) :=
  @Eq.subst.{1} Nat
    (fun (x : Nat) => Nat.add a b = Nat.add a x)
    b (Nat.add Nat.zero b)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero b) b (zero_add b))
    (@Eq.refl.{1} Nat (Nat.add a b))

-- 演示：(2-5) * 1 = 2-5，两边都算成 2+5 = 5+2。
theorem demo_mulRep_one :
    intRel (mulRep (@prod_mk Nat Nat 2 5)
                  (@prod_mk Nat Nat (Nat.succ Nat.zero) Nat.zero))
           (@prod_mk Nat Nat 2 5) :=
  Eq.refl (Nat.add 2 5)

-- 演示：0 * (3-1) = 0-0，两边都算成 0+0 = 0+0。
theorem demo_mulRep_zero_left :
    intRel (mulRep (@prod_mk Nat Nat Nat.zero Nat.zero) (@prod_mk Nat Nat 3 1))
           (@prod_mk Nat Nat Nat.zero Nat.zero) :=
  Eq.refl Nat.zero
