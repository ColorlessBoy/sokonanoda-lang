-- 单元⑬ ℕ 序的传递性与单调性
--
-- 单元⑫ 用归纳族 LeNat 定义了 ℕ 的序，并把整数序化归到它：a-b ≤ c-d 就是
-- a+d ≤ c+b。要把这层化归真正用起来，还需要 ℕ 序的两条基本性质：传递性
-- （m ≤ n 且 n ≤ k 推出 m ≤ k）与右加单调（m ≤ n 推出 m+k ≤ n+k）。后者又
-- 依赖一条垫脚石：后继保持序（m ≤ n 推出 succ m ≤ succ n）。有了这三条，
-- 后面才能把代表元的等式「搬到不等式的两边」。
--
-- 证之前先说清一个技术事实：LeNat 有两个指标 m 与 n。本语言的 match 只把
-- 参数代进动机，指标留在分支里，所以对 h : LeNat m n 不能直接 match，而要
-- 显式用归纳原理 LeNat.rec，让动机同时收两个指标与证明：
-- @LeNat.rec (fun m n h => …) base step m n h。base 对应 le_refl，step 对应
-- le_succ，它的归纳假设是较小证明的。
import lib.Logic
import lib.Prod

inductive LeNat : Nat → Nat → Prop
ctor le_refl (n : Nat) : LeNat n n
ctor le_succ (m : Nat) (n : Nat) : LeNat m n → LeNat m (Nat.succ n)
end

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def leRep (p q : Prod Nat Nat) : Prop :=
  LeNat (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q))
        (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p))

-- 先看构造子链本身：0 ≤ 1 ≤ 2 的中间一段。
theorem demo_leNat_one_two : LeNat 1 2 :=
  le_succ 1 1 (le_refl 1)

theorem leNat_trans (a b c : Nat) (h1 : LeNat a b) (h2 : LeNat b c) : LeNat a c :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat a m → LeNat a n)
    (fun (n : Nat) => fun (h : LeNat a n) => h)
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat a m → LeNat a n) =>
       fun (h1 : LeNat a m) => le_succ a n (ih h1))
    b c h2 h1

theorem leNat_succ_succ (a b : Nat) (h : LeNat a b) :
    LeNat (Nat.succ a) (Nat.succ b) :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat (Nat.succ m) (Nat.succ n))
    (fun (n : Nat) => le_refl (Nat.succ n))
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat (Nat.succ m) (Nat.succ n)) =>
       le_succ (Nat.succ m) (Nat.succ n) ih)
    a b h

theorem leNat_add_right (a b k : Nat) (h : LeNat a b) :
    LeNat (Nat.add a k) (Nat.add b k) :=
  Nat.rec (fun (k : Nat) => LeNat (Nat.add a k) (Nat.add b k))
    h
    (fun (k : Nat) (ih : LeNat (Nat.add a k) (Nat.add b k)) =>
       leNat_succ_succ (Nat.add a k) (Nat.add b k) ih)
    k

-- 具体例子：0-0 ≤ 2-0 就是 0 ≤ 2；已有 0 ≤ 1，再用传递性往前推。
theorem demo_leNat_zero_two : LeNat Nat.zero 2 :=
  leNat_trans Nat.zero 1 2 (le_succ Nat.zero Nat.zero (le_refl Nat.zero))
    (le_succ 1 1 (le_refl 1))

-- 具体例子：1 ≤ 4 推出 1+2 ≤ 4+2，即 3 ≤ 6。
theorem demo_leNat_add_right : LeNat 3 6 :=
  leNat_add_right 1 4 2 (le_succ 1 3 (le_succ 1 2 (le_succ 1 1 (le_refl 1))))
