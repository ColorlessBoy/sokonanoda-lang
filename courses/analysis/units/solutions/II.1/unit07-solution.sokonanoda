-- 单元⑦ 整数加法的交换律与结合律 —— 解答
--
-- 加法在 ℤ 上定义好之后，第一件事是把 ℕ 上熟悉的律搬上来。搬之前先看清商里
-- 的等式从哪来：商只有一条相等规则，相关的代表元在商里相等。所以商上等式的
-- 证明只有一条路——先在代表元上「差相等」，再用这条规则搬过去。
--
-- 还有一层形式上的限制：本语言没有函数外延，加法不能先写成 Int → Int → Int
-- 的函数再谈律；律只能对「由代表元给出的整数」陈述。后面 ℚ、ℝ 章沿用同一形式。
--
-- 证明要用到 ℕ 的交换律与结合律，先把它们在下面重新列出来。
import lib.Logic
import lib.Prod

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)

def Int : Type := @Quot.{1} (Prod Nat Nat) intRel

def addRep (a b : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (Prod.fst Nat Nat a) (Prod.fst Nat Nat b))
    (Nat.add (Prod.snd Nat Nat a) (Prod.snd Nat Nat b))

-- 下面四条是单元③证过的 ℕ 加法律，这里重新列出；后面的证明直接引用。
theorem zero_add (b : Nat) :
    Nat.add Nat.zero b = b :=
  Nat.rec (fun (n : Nat) => Nat.add Nat.zero n = n)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Nat.add Nat.zero n = n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add Nat.zero n) = Nat.succ m)
        (Nat.add Nat.zero n) n ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add Nat.zero n))))
    b

theorem succ_add (a b : Nat) :
    Nat.add (Nat.succ a) b = Nat.succ (Nat.add a b) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n))
    (@Eq.refl.{1} Nat (Nat.succ a))
    (fun (n : Nat) (ih : Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.succ a) n) = Nat.succ m)
        (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.succ a) n))))
    b

theorem add_assoc (a b c : Nat) :
    Nat.add (Nat.add a b) c = Nat.add a (Nat.add b c) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n))
    (@Eq.refl.{1} Nat (Nat.add a b))
    (fun (n : Nat) (ih : Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.add a b) n) = Nat.succ m)
        (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a b) n))))
    c

theorem add_comm (a b : Nat) :
    Nat.add a b = Nat.add b a :=
  Nat.rec (fun (n : Nat) => Nat.add a n = Nat.add n a)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero a) a (zero_add a))
    (fun (n : Nat) (ih : Nat.add a n = Nat.add n a) =>
      @Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ (Nat.add n a)) (Nat.add (Nat.succ n) a)
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.succ (Nat.add a n) = Nat.succ m)
          (Nat.add a n) (Nat.add n a) ih
          (@Eq.refl.{1} Nat (Nat.succ (Nat.add a n))))
        (@Eq.symm.{1} Nat (Nat.add (Nat.succ n) a) (Nat.succ (Nat.add n a)) (succ_add n a)))
    b

-- 先把右零元证出来：a+0 用交换律换成 0+a，再用 zero_add。
theorem add_zero (a : Nat) :
    Nat.add a Nat.zero = a :=
  @Eq.trans.{1} Nat (Nat.add a Nat.zero) (Nat.add Nat.zero a) a
    (add_comm a Nat.zero)
    (zero_add a)

-- 代表元上的交换律：两个分量各用一次 ℕ 的 add_comm。
theorem addRep_comm (a b c d : Nat) :
    intRel (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
           (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b)) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a c) (Nat.add d b))
    (Nat.add (Nat.add a c) (Nat.add b d))
    (Nat.add (Nat.add c a) (Nat.add b d))
    (@Eq.subst.{1} Nat
      (fun (m : Nat) =>
        Nat.add (Nat.add a c) (Nat.add d b) = Nat.add (Nat.add a c) m)
      (Nat.add d b) (Nat.add b d) (add_comm d b)
      (@Eq.refl.{1} Nat (Nat.add (Nat.add a c) (Nat.add d b))))
    (@Eq.subst.{1} Nat
      (fun (m : Nat) =>
        Nat.add (Nat.add a c) (Nat.add b d) = Nat.add m (Nat.add b d))
      (Nat.add a c) (Nat.add c a) (add_comm a c)
      (@Eq.refl.{1} Nat (Nat.add (Nat.add a c) (Nat.add b d))))

-- 代表元上的结合律：左边的两个和分别用 add_assoc 重新结合。
theorem addRep_assoc (a b c d e f : Nat) :
    intRel (addRep (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
                   (@prod_mk Nat Nat e f))
           (addRep (@prod_mk Nat Nat a b)
                   (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f))) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add (Nat.add a c) e) (Nat.add b (Nat.add d f)))
    (Nat.add (Nat.add a (Nat.add c e)) (Nat.add b (Nat.add d f)))
    (Nat.add (Nat.add a (Nat.add c e)) (Nat.add (Nat.add b d) f))
    (@Eq.subst.{1} Nat
      (fun (m : Nat) =>
        Nat.add m (Nat.add b (Nat.add d f)) =
        Nat.add (Nat.add a (Nat.add c e)) (Nat.add b (Nat.add d f)))
      (Nat.add a (Nat.add c e)) (Nat.add (Nat.add a c) e)
      (@Eq.symm.{1} Nat (Nat.add (Nat.add a c) e) (Nat.add a (Nat.add c e))
        (add_assoc a c e))
      (@Eq.refl.{1} Nat
        (Nat.add (Nat.add a (Nat.add c e)) (Nat.add b (Nat.add d f)))))
    (@Eq.subst.{1} Nat
      (fun (m : Nat) =>
        Nat.add (Nat.add a (Nat.add c e)) (Nat.add b (Nat.add d f)) =
        Nat.add (Nat.add a (Nat.add c e)) m)
      (Nat.add b (Nat.add d f)) (Nat.add (Nat.add b d) f)
      (@Eq.symm.{1} Nat (Nat.add (Nat.add b d) f) (Nat.add b (Nat.add d f))
        (add_assoc b d f))
      (@Eq.refl.{1} Nat
        (Nat.add (Nat.add a (Nat.add c e)) (Nat.add b (Nat.add d f)))))

-- 搬到商上：把代表元关系交给 Quot.sound，商里的相等就得到了。
theorem int_add_comm (a b c d : Nat) :
    @Quot.mk.{1} (Prod Nat Nat) intRel (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) =
      @Quot.mk.{1} (Prod Nat Nat) intRel (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b)) :=
  @Quot.sound.{1} (Prod Nat Nat) intRel
    (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
    (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
    (addRep_comm a b c d)

theorem int_add_assoc (a b c d e f : Nat) :
    @Quot.mk.{1} (Prod Nat Nat) intRel
        (addRep (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
                (@prod_mk Nat Nat e f)) =
      @Quot.mk.{1} (Prod Nat Nat) intRel
        (addRep (@prod_mk Nat Nat a b)
                (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f))) :=
  @Quot.sound.{1} (Prod Nat Nat) intRel
    (addRep (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
            (@prod_mk Nat Nat e f))
    (addRep (@prod_mk Nat Nat a b)
            (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f)))
    (addRep_assoc a b c d e f)

-- 具体数字上核对：2-0 与 3-1 相加，交换次序结果不变——两边都算成 5-1。
theorem demo_int_add_comm :
    @Quot.mk.{1} (Prod Nat Nat) intRel
        (addRep (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 3 1)) =
      @Quot.mk.{1} (Prod Nat Nat) intRel
        (addRep (@prod_mk Nat Nat 3 1) (@prod_mk Nat Nat 2 Nat.zero)) :=
  @Quot.sound.{1} (Prod Nat Nat) intRel
    (addRep (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 3 1))
    (addRep (@prod_mk Nat Nat 3 1) (@prod_mk Nat Nat 2 Nat.zero))
    (@Eq.refl.{1} Nat 6)
