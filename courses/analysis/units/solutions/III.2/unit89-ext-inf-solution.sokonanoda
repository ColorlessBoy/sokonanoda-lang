-- 单元89 扩展实数上的下界与下确界（解答）
--
-- 87 把上界与上确界搬到了扩展实数里，下侧还停在实数层。全体实数在
-- 上侧以 `posInf` 为界，在下侧以 `negInf` 为界；只做上确界，遇到「最小」
-- 的地方就还得回到实数层，而那里恰好没有全体实数的下确界。下侧的词汇
-- 要单独补一次。
--
-- `LowerBound ExtReal ele A m` 读作「`m` 是 `A` 在扩展实数里的下界」，
-- `IsInf ExtReal ele A m` 读作「`m` 是 `A` 的下确界」。两个定义都在
-- `lib/Order`，这里把类型取成 `ExtReal`、关系取成 `ele`。
--
-- 证明与 87 逐条对称：上界的放大换成下界的缩小，最小性换成最大性。
-- 两个极端的角色也对调：空集的下确界是 `posInf`，全空间的是 `negInf`。
-- 任意集合下确界的存在性仍不证明。

import lib.Order
import lib.ExtReal
import lib.ExtRealOrder

-- ─────────────────────────────────────────────────────────────
-- 89.0 读法
-- ─────────────────────────────────────────────────────────────

-- 下面一律写 `LowerBound ExtReal ele A m` 与 `IsInf ExtReal ele A m`。
-- 它们在 `lib/Order` 里对任意类型、任意关系陈述，这里只固定参数。

-- ─────────────────────────────────────────────────────────────
-- 89.1 下界可以缩小
-- ─────────────────────────────────────────────────────────────

-- 展开 `LowerBound` 之后，逐点把 `m' ≤ m` 与 `m ≤ a` 接起来。
theorem ext_lowerBound_of_le (A : ExtReal → Prop) (m m' : ExtReal)
    (hm : LowerBound ExtReal ele A m) (h : ele m' m) :
    LowerBound ExtReal ele A m' :=
  fun (a : ExtReal) (ha : A a) => ele_trans m' m a h (hm a ha)

-- ─────────────────────────────────────────────────────────────
-- 89.2 下确界处 `M ≤ m` 与「M 是下界」等价
-- ─────────────────────────────────────────────────────────────

-- 若 `M ≤ m`，每个 `a ∈ A` 有 `m ≤ a`，传递得到 `M ≤ a`；
-- 反过来「`M` 是下界」正是最大性在 `M` 上的取值。
theorem ext_inf_le_iff (A : ExtReal → Prop) (m M : ExtReal)
    (hi : IsInf ExtReal ele A m) :
    ele M m ↔ LowerBound ExtReal ele A M :=
  Iff.intro
    (fun (h : ele M m) =>
      fun (a : ExtReal) (ha : A a) =>
        ele_trans M m a h ((And.left hi) a ha))
    (fun (hM : LowerBound ExtReal ele A M) => (And.right hi) M hM)

-- ─────────────────────────────────────────────────────────────
-- 89.3 下确界唯一
-- ─────────────────────────────────────────────────────────────

-- `m'` 是下界，最大性给 `m' ≤ m`；`m` 是下界，最大性给 `m ≤ m'`。
theorem ext_inf_unique (A : ExtReal → Prop) (m m' : ExtReal)
    (hi : IsInf ExtReal ele A m) (hj : IsInf ExtReal ele A m') : m = m' :=
  ele_antisymm m m'
    ((And.right hj) m (And.left hi))
    ((And.right hi) m' (And.left hj))

-- ─────────────────────────────────────────────────────────────
-- 89.4 集合含负无穷时，下确界是负无穷
-- ─────────────────────────────────────────────────────────────

-- 下界：`negInf` 不超过任何点。最大性：任取下界 `M`，把它作用在
-- `negInf` 与假设 `h` 上，直接得到 `M ≤ negInf`。
theorem ext_inf_of_bot (A : ExtReal → Prop) (h : A negInf) :
    IsInf ExtReal ele A negInf :=
  And.intro
    (fun (a : ExtReal) (_ha : A a) => negInf_le a)
    (fun (M : ExtReal) (hM : LowerBound ExtReal ele A M) => hM negInf h)

-- ─────────────────────────────────────────────────────────────
-- 89.5 空集的下确界是正无穷
-- ─────────────────────────────────────────────────────────────

-- 空集没有元素，下界义务从 `False` 消去。最大性对任取下界 `M`
-- 要证 `M ≤ posInf`，这就是 `le_posInf`。
theorem ext_inf_empty :
    IsInf ExtReal ele (fun (_ : ExtReal) => False) posInf :=
  And.intro
    (fun (a : ExtReal) (ha : False) => False.elim ha)
    (fun (M : ExtReal) (_hM : LowerBound ExtReal ele (fun (_ : ExtReal) => False) M) =>
      le_posInf M)

-- ─────────────────────────────────────────────────────────────
-- 89.6 全空间的下确界是负无穷
-- ─────────────────────────────────────────────────────────────

-- 下界仍是 `negInf_le`。最大性把下界作用在 `negInf` 与 `True.intro` 上。
theorem ext_inf_univ :
    IsInf ExtReal ele (fun (_ : ExtReal) => True) negInf :=
  And.intro
    (fun (a : ExtReal) (_ha : True) => negInf_le a)
    (fun (M : ExtReal) (hM : LowerBound ExtReal ele (fun (_ : ExtReal) => True) M) =>
      hM negInf True.intro)
