-- 单元128 连续函数的代数：和、差与取负
--
-- 两个在 a 处连续的函数，相加之后还在 a 处连续吗？函数极限的和律已经回答过
-- 类似的问题：ε 折半，两块正半径取小者，误差由三角不等式合成。连续是「极限
-- 值就是函数值」的极限，所以同一套估计应该照搬；真正要检查的是连续的定义
-- 没有把 a 排除在外，邻域里每一点都要照顾到。
--
-- 这件事反而让证明变短。函数极限的和律要单独处理「x 不是 a」，连续不需要：
-- 给定 ε，两个函数各交出 ε 的一半作半径，序的全性保证其中一个不超过另一个，
-- 把小的那个当公共半径，大的那个用放大律收进来，邻域里的每一点都直接交给
-- `close_add`。取负只翻方向不动误差，减法接在加法与取负之后。
--
-- 逐点版本成立之后，全局版本只是把 a 换成全称量词。乘积与商会多出一层
-- 「函数在 a 附近有界」的估计，那件事留到后面的单元；这里先把加法群这一半
-- 做完。证明只用到两条已经判过的引擎：半径放大律与 `close_add`。
--
-- 边界：函数取 `ratRep → ratRep`，连续停在有理代表元层。不新增公理。

import lib.Rat
import lib.RatAbs
import lib.RatHalf
import lib.RealAdd
import lib.RealNeg
import lib.LimAtAlgebra
import lib.Cont

-- ─────────────────────────────────────────────────────────────
-- 和保持连续
-- ─────────────────────────────────────────────────────────────

-- ε 折半，两个函数各给一个正半径。序的全性把两个半径分成「δf ≤ δg」与
-- 「δg ≤ δf」两支，两支都取较小的那个当公共半径，较大的那个用放大律收进
-- 同一个半径，再交给 `close_add`。
theorem continuousAt_add (f g : ratRep → ratRep) (a : ratRep)
    (hf : ContinuousAt f a) (hg : ContinuousAt g a) :
    ContinuousAt (fun (x : ratRep) => ratAddRep (f x) (g x)) a :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    Exists.elim (hf (ratHalf eps) (ratLtRep_half eps heps))
      (fun (df : ratRep)
          (hdf : ratLtRep ratZeroRep df ∧
            ∀ (x : ratRep), close x a df →
              close (f x) (f a) (ratHalf eps)) =>
        Exists.elim (hg (ratHalf eps) (ratLtRep_half eps heps))
          (fun (dg : ratRep)
              (hdg : ratLtRep ratZeroRep dg ∧
                ∀ (x : ratRep), close x a dg →
                  close (g x) (g a) (ratHalf eps)) =>
            Or.elim
              (fun (hle : ratLeRep df dg) =>
                Exists.intro df
                  (And.intro (And.left hdf)
                    (fun (x : ratRep) (hx : close x a df) =>
                      close_add (f x) (f a) (g x) (g a) eps
                        ((And.right hdf) x hx)
                        ((And.right hdg) x
                          (close_mono_eps x a df dg hx hle)))))
              (fun (hle : ratLeRep dg df) =>
                Exists.intro dg
                  (And.intro (And.left hdg)
                    (fun (x : ratRep) (hx : close x a dg) =>
                      close_add (f x) (f a) (g x) (g a) eps
                        ((And.right hdf) x
                          (close_mono_eps x a dg df hx hle))
                        ((And.right hdg) x hx))))
              (ratLeRep_total df dg)))

-- ─────────────────────────────────────────────────────────────
-- 取负保持连续
-- ─────────────────────────────────────────────────────────────

-- 取负把误差 `f x - f a` 换成它的相反数，绝对值不变；半径原样沿用。
theorem continuousAt_neg (f : ratRep → ratRep) (a : ratRep)
    (hf : ContinuousAt f a) :
    ContinuousAt (fun (x : ratRep) => ratNegRep (f x)) a :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    Exists.elim (hf eps heps)
      (fun (delta : ratRep)
          (hd : ratLtRep ratZeroRep delta ∧
            ∀ (x : ratRep), close x a delta →
              close (f x) (f a) eps) =>
        Exists.intro delta
          (And.intro (And.left hd)
            (fun (x : ratRep) (hx : close x a delta) =>
              close_neg (f x) (f a) eps ((And.right hd) x hx))))

-- ─────────────────────────────────────────────────────────────
-- 差保持连续
-- ─────────────────────────────────────────────────────────────

-- `f - g` 就是 `f + (-g)`，把上两条接起来。
theorem continuousAt_sub (f g : ratRep → ratRep) (a : ratRep)
    (hf : ContinuousAt f a) (hg : ContinuousAt g a) :
    ContinuousAt (fun (x : ratRep) => ratSubRep (f x) (g x)) a :=
  continuousAt_add f (fun (x : ratRep) => ratNegRep (g x)) a hf
    (continuousAt_neg g a hg)

-- ─────────────────────────────────────────────────────────────
-- 全局连续的和、负与差
-- ─────────────────────────────────────────────────────────────

-- 每个点都用逐点的和律。
theorem continuous_add (f g : ratRep → ratRep)
    (hf : Continuous f) (hg : Continuous g) :
    Continuous (fun (x : ratRep) => ratAddRep (f x) (g x)) :=
  fun (a : ratRep) => continuousAt_add f g a (hf a) (hg a)

-- 在每一点用逐点的取负律。
theorem continuous_neg (f : ratRep → ratRep) (hf : Continuous f) :
    Continuous (fun (x : ratRep) => ratNegRep (f x)) :=
  fun (a : ratRep) => continuousAt_neg f a (hf a)

-- 在每一点用逐点的差律。
theorem continuous_sub (f g : ratRep → ratRep)
    (hf : Continuous f) (hg : Continuous g) :
    Continuous (fun (x : ratRep) => ratSubRep (f x) (g x)) :=
  fun (a : ratRep) => continuousAt_sub f g a (hf a) (hg a)

-- ─────────────────────────────────────────────────────────────
-- 具体：恒等函数加常数
-- ─────────────────────────────────────────────────────────────

-- 恒等函数与常函数都连续，它们的和就是 `x ↦ x + c`。
theorem demo_continuous_add_const (c : ratRep) :
    Continuous (fun (x : ratRep) => ratAddRep x c) :=
  continuous_add (fun (x : ratRep) => x) (fun (_ : ratRep) => c)
    continuous_id (continuous_const c)
