-- 单元55 有理数的加法逆元：`x + (-x) = 0`
--
-- close 的传递性要把 x-y 与 y-z 加起来，再把 x-z 认成 (x-y)+(y-z)。这条等式在
-- 代表元层要先把 -y+y 收成 0，也就是这里要证的加法逆元律：x 加自己的负元与 0 相等。
--
-- 它看着「显然」，但在商构造里要穿过三层。第一层是 ratNegRep 只是把分子序对交换
-- （分母字段不动）；第二层是相加后公分母是 ratDenRep m m，交叉乘积会把
-- myMul 0 (succ D) 带进来（内核不替你归约 0*n，要用 zero_mul）；第三层是两个坐标
-- 只差加法交换，但 ratRel 要的是交叉和相等，两边的 x+0、0+0 尾巴都得用 add_zero
-- 或 zero_add 显式收掉。
--
-- 先在字面三元组上把这条律证出来，再搬到任意代表元；然后把减法读成「加负元」，
-- 最后落在 1/2 - 1/2 上。全部停在代表元层，不碰商、不碰函数外延性、不加公理。

import lib.Cauchy

theorem lhs0_eq (a b m : Nat) :
    Nat.add
      (Nat.add
        (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
        Nat.zero)
      (Nat.add Nat.zero Nat.zero) =
    Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)) :=
  @Eq.trans.{1} Nat
    (Nat.add
      (Nat.add
        (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
        Nat.zero)
      (Nat.add Nat.zero Nat.zero))
    (Nat.add
      (Nat.add
        (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
        Nat.zero)
      Nat.zero)
    (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
    (@congrArg.{1} Nat Nat
      (Nat.add Nat.zero Nat.zero)
      Nat.zero
      (fun (x : Nat) =>
        Nat.add
          (Nat.add
            (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
            Nat.zero)
          x)
      (zero_add Nat.zero))
    (@Eq.trans.{1} Nat
      (Nat.add
        (Nat.add
          (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
          Nat.zero)
        Nat.zero)
      (Nat.add
        (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
        Nat.zero)
      (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
      (add_zero
        (Nat.add
          (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
          Nat.zero))
      (@Eq.trans.{1} Nat
        (Nat.add
          (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
          Nat.zero)
        (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
        (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
        (add_zero (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))))
        (Eq.refl (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))))))

theorem rhs0_eq (a b m : Nat) :
    Nat.add
      (Nat.add Nat.zero Nat.zero)
      (Nat.add Nat.zero
        (Nat.add
          (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
          Nat.zero)) =
    Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)) :=
  @Eq.trans.{1} Nat
    (Nat.add
      (Nat.add Nat.zero Nat.zero)
      (Nat.add Nat.zero
        (Nat.add
          (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
          Nat.zero)))
    (Nat.add Nat.zero
      (Nat.add Nat.zero
        (Nat.add
          (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
          Nat.zero)))
    (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
    (@congrArg.{1} Nat Nat
      (Nat.add Nat.zero Nat.zero)
      Nat.zero
      (fun (x : Nat) =>
        Nat.add x
          (Nat.add Nat.zero
            (Nat.add
              (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
              Nat.zero)))
      (zero_add Nat.zero))
    (@Eq.trans.{1} Nat
      (Nat.add Nat.zero
        (Nat.add Nat.zero
          (Nat.add
            (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
            Nat.zero)))
      (Nat.add Nat.zero
        (Nat.add
          (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
          Nat.zero))
      (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
      (zero_add
        (Nat.add Nat.zero
          (Nat.add
            (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
            Nat.zero)))
      (@Eq.trans.{1} Nat
        (Nat.add Nat.zero
          (Nat.add
            (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
            Nat.zero))
        (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
        (zero_add
          (Nat.add
            (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
            Nat.zero))
        (Eq.refl (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m))))))

theorem neg_zero_case (a b m : Nat) :
    Nat.add
      (Nat.add
        (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
        Nat.zero)
      (Nat.add Nat.zero Nat.zero) =
    Nat.add
      (Nat.add Nat.zero Nat.zero)
      (Nat.add Nat.zero
        (Nat.add
          (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
          Nat.zero)) :=
  @Eq.trans.{1} Nat
    (Nat.add
      (Nat.add
        (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
        Nat.zero)
      (Nat.add Nat.zero Nat.zero))
    (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
    (Nat.add
      (Nat.add Nat.zero Nat.zero)
      (Nat.add Nat.zero
        (Nat.add
          (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
          Nat.zero)))
    (lhs0_eq a b m)
    (@Eq.trans.{1} Nat
      (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
      (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
      (Nat.add
        (Nat.add Nat.zero Nat.zero)
        (Nat.add Nat.zero
          (Nat.add
            (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
            Nat.zero)))
      (add_comm (myMul a (Nat.succ m)) (myMul b (Nat.succ m)))
      (@Eq.symm.{1} Nat
        (Nat.add
          (Nat.add Nat.zero Nat.zero)
          (Nat.add Nat.zero
            (Nat.add
              (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
              Nat.zero)))
        (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
        (rhs0_eq a b m)))

theorem ratAdd_neg_mk (a b m : Nat) :
    ratRel (ratAddRep (qrep a b m) (ratNegRep (qrep a b m))) ratZeroRep :=
  @Eq.subst.{1} Nat
    (fun (z : Nat) =>
      Nat.add
        (Nat.add
          (Nat.add (Nat.add (myMul a (Nat.succ m)) (myMul b (Nat.succ m))) Nat.zero)
          Nat.zero)
        (Nat.add Nat.zero z) =
      Nat.add
        (Nat.add z Nat.zero)
        (Nat.add Nat.zero
          (Nat.add
            (Nat.add (myMul b (Nat.succ m)) (myMul a (Nat.succ m)))
            Nat.zero)))
    Nat.zero
    (myMul Nat.zero (Nat.succ (ratDenRep m m)))
    (@Eq.symm.{1} Nat (myMul Nat.zero (Nat.succ (ratDenRep m m))) Nat.zero (zero_mul (Nat.succ (ratDenRep m m))))
    (neg_zero_case a b m)

theorem ratAdd_neg_aux (x : Prod (Prod Nat Nat) Nat) :
    ratRel (ratAddRep x (ratNegRep x)) ratZeroRep :=
  match x with
  | prod_mk (prod_mk a b) m => ratAdd_neg_mk a b m

theorem ratAdd_neg (x : ratRep) :
    ratRel (ratAddRep x (ratNegRep x)) ratZeroRep :=
  ratAdd_neg_aux x

theorem ratSubRep_self (x : ratRep) :
    ratRel (ratSubRep x x) ratZeroRep :=
  ratAdd_neg x

theorem demo_neg_self :
    ratRel (ratSubRep (qrep 1 Nat.zero 1) (qrep 1 Nat.zero 1)) ratZeroRep :=
  ratSubRep_self (qrep 1 Nat.zero 1)
