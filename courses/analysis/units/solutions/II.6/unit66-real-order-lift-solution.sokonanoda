-- 单元66 实数的序：沿 `realRel` 下降成 `Real` 上的关系
--
-- 前两个单元在代表元层把序立起来，并证了自反与传递：realLeRep x y 当且仅当 x、y
-- 都是 Cauchy 序列，且对任意 eps>0 存在 N，使 n ≥ N 时 (x n - y n) ≤ eps。
--
-- 但 def realLeRep : Seq → Seq → Prop 还不是 Real 上的序：同一个实数可以换代表元，
-- 序必须与代表元的选取无关。现在补上这条良定义性，再经两次 Quot.lift 把序下降到
-- realLe : Real → Real → Prop。两次 lift 与三元加法同一构造：内层把第二个因子送到
-- Prop（良定义性是 realLeRep_wd_snd），外层再把第一个因子送到 Real → Prop
-- （良定义性是 realLeRep_wd，对每个 b 用 Quot.ind 烧成代表元形状）。
--
-- 良定义性的证明本身很短：「相等推出序」把 realRel 的两个方向投成序，序的传递性
-- 把三段接起来。先证两条替换律（换左因子、换右因子），再做两次下降，给出 ι 规则，
-- 最后在常零序列上落一个具体例。

import lib.RealOrder
import lib.RealOrderTrans
import lib.Extensionality

-- ─────────────────────────────────────────────────────────────
-- 66.0 换左因子：`realRel x x' → (x ≤ y ↔ x' ≤ y)`
-- ─────────────────────────────────────────────────────────────

theorem realLeRep_wd (x x' y : Seq) (hx : realRel x x') :
    realLeRep x y ↔ realLeRep x' y :=
  @Iff.intro (realLeRep x y) (realLeRep x' y)
    (fun (h : realLeRep x y) =>
      realLeRep_trans x' x y
        (realLeRep_of_realRel x' x (realRel_symm x x' hx))
        h)
    (fun (h : realLeRep x' y) =>
      realLeRep_trans x x' y
        (realLeRep_of_realRel x x' hx)
        h)

-- ─────────────────────────────────────────────────────────────
-- 66.1 换右因子：`realRel y y' → (x ≤ y ↔ x ≤ y')`
-- ─────────────────────────────────────────────────────────────

theorem realLeRep_wd_snd (x y y' : Seq) (hy : realRel y y') :
    realLeRep x y ↔ realLeRep x y' :=
  @Iff.intro (realLeRep x y) (realLeRep x y')
    (fun (h : realLeRep x y) =>
      realLeRep_trans x y y' h
        (realLeRep_of_realRel y y' hy))
    (fun (h : realLeRep x y') =>
      realLeRep_trans x y' y h
        (realLeRep_of_realRel y' y (realRel_symm y y' hy)))

-- ─────────────────────────────────────────────────────────────
-- 66.2 内层下降：固定 `x`，对 `y` 做 `Quot.lift`
-- ─────────────────────────────────────────────────────────────

-- 外层类型是 `Prop`，良定义性要 `propext` 把 66.1 的 `↔` 变成命题相等。
def realLeY (x : Seq) : Real → Prop :=
  @Quot.lift.{1, 1} Seq realRel Prop
    (fun (y : Seq) => realLeRep x y)
    (fun (y y' : Seq) (hy : realRel y y') =>
      propext (realLeRep x y) (realLeRep x y')
        (realLeRep_wd_snd x y y' hy))

-- ─────────────────────────────────────────────────────────────
-- 66.3 外层下降：对 `x` 再做一次 `Quot.lift`
-- ─────────────────────────────────────────────────────────────

-- 外层要证 `realLeY x = realLeY x'`：先用 `funext` 逐点化，进入 `b` 后
-- 用 `Quot.ind` 把 `b` 烧成 `mk y`，两次 ι 归约把目标变成
-- `realLeRep x y = realLeRep x' y`，交给 66.0 与 `propext`。
def realLe (a : Real) : Real → Prop :=
  @Quot.lift.{1, 1} Seq realRel (Real → Prop)
    (fun (x : Seq) => realLeY x)
    (fun (x x' : Seq) (hx : realRel x x') =>
      funext (fun (b : Real) => realLeY x b)
             (fun (b : Real) => realLeY x' b)
             (fun (b : Real) =>
               @Quot.ind.{1} Seq realRel
                 (fun (b : Real) => realLeY x b = realLeY x' b)
                 (fun (y : Seq) =>
                   propext (realLeRep x y) (realLeRep x' y)
                     (realLeRep_wd x x' y hx))
                 b))
    a

-- ─────────────────────────────────────────────────────────────
-- 66.4 ι 规则：作用在 `mk` 上回到代表元形状
-- ─────────────────────────────────────────────────────────────

-- 两次 `Quot.lift` 都按 ι 归约，所以两边是定义性相等的命题，
-- `Iff.intro` 的两个人射都取恒等函数。
theorem realLe_mk (x y : Seq) :
    realLe (Real.mk x) (Real.mk y) ↔ realLeRep x y :=
  @Iff.intro (realLe (Real.mk x) (Real.mk y)) (realLeRep x y)
    (fun (h : realLe (Real.mk x) (Real.mk y)) => h)
    (fun (h : realLeRep x y) => h)

-- ─────────────────────────────────────────────────────────────
-- 66.5 具体：常零序列 ≤ 常零序列
-- ─────────────────────────────────────────────────────────────

theorem demo_realLe_lift : realLe (Real.mk zeroSeq) (Real.mk zeroSeq) :=
  @Iff.mpr (realLe (Real.mk zeroSeq) (Real.mk zeroSeq)) (realLeRep zeroSeq zeroSeq)
    (realLe_mk zeroSeq zeroSeq)
    (realLeRep_of_realRel zeroSeq zeroSeq realRel_zero)
