-- 单元76 极限的代数：加法、减法、取负（解答）
--
-- 73 给了 ε-N 定义，74 唯一性，75 序。本单元开始做**极限律**：
-- 收敛序列的和、差、取负仍收敛，且极限是各自极限的和、差、取负。
--
-- 路线：
--
--   · 76.1 先备一条换极限的引理：`L ~ L'` 时 `Converges x L` 可换成
--     `Converges x L'`——`close_trans` 把「`x n` 靠近 `L`」与
--     「`L` 靠近 `L'`」串起来（两条都取 `eps/2`）；
--   · 76.2 加法：两条 `eps/2` 的接近性用 73.2 的 `eventually_and` 合并到
--     同一个 `N`，60.2 的 `close_add` 直接给
--     `close (x n + y n) (L + M) eps`；
--   · 76.3 取负：逐点用 59.2 的 `close_neg`（已进 `lib/RealNeg`）；
--   · 76.4 减法：`x - y` 就是 `x + (-y)`，由 76.2 / 76.3 拼起来——
--     `subSeq` 与 `ratSubRep` 都是定义展开，不需要额外的换形引理；
--   · 76.5 具体：零序列加零序列收敛到零（用 76.1 把 `0 + 0` 换回 `0`）。
--
-- 边界：本单元只做「加法群」这一半。乘法律需要先有
-- **有界性**（`|x n|` 的界），那是后续单元的事；本单元不假装已经有了。
-- 不新增公理，也不碰 kernel/front。

import lib.Limit
import lib.RealAdd
import lib.RealNeg
import lib.RatSub

-- ─────────────────────────────────────────────────────────────
-- 76.0 减法序列的定义（本单元给出，不是练习）
-- ─────────────────────────────────────────────────────────────

def subSeq (x y : Seq) : Seq := fun (n : Nat) => ratAddRep (x n) (ratNegRep (y n))

-- ─────────────────────────────────────────────────────────────
-- 76.1 极限可以换成等价的代表元
-- ─────────────────────────────────────────────────────────────

-- `close_trans` 要两条 `eps/2` 的界：一条来自原极限（`h (eps/2)`），
-- 另一条把 `L ~ L'` 经 73.4 的 `close_of_ratRel` 变成常序列的接近性。
theorem converges_congr_limit (x : Seq) (L L' : ratRep)
    (h : Converges x L) (hLL' : ratRel L L') : Converges x L' :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    eventually_mono
      (fun (n : Nat) => close (x n) L (ratHalf eps))
      (fun (n : Nat) => close (x n) L' eps)
      (h (ratHalf eps) (ratLtRep_half eps heps))
      (fun (n : Nat) (hc : close (x n) L (ratHalf eps)) =>
        close_trans (x n) L L' eps heps hc
          (close_of_ratRel L L' hLL' (ratHalf eps)
            (ratLtRep_half eps heps)))

-- ─────────────────────────────────────────────────────────────
-- 76.2 加法律
-- ─────────────────────────────────────────────────────────────

-- 两条「终究」并到同一个 `N`，逐点 `close_add`：
-- `close (x n) L (eps/2)` 与 `close (y n) M (eps/2)` 合成
-- `close (x n + y n) (L + M) eps`。
theorem converges_add (x y : Seq) (L M : ratRep)
    (hx : Converges x L) (hy : Converges y M) :
    Converges (addSeq x y) (ratAddRep L M) :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    eventually_mono
      (fun (n : Nat) => close (x n) L (ratHalf eps) ∧
                        close (y n) M (ratHalf eps))
      (fun (n : Nat) => close (addSeq x y n) (ratAddRep L M) eps)
      (eventually_and
        (fun (n : Nat) => close (x n) L (ratHalf eps))
        (fun (n : Nat) => close (y n) M (ratHalf eps))
        (hx (ratHalf eps) (ratLtRep_half eps heps))
        (hy (ratHalf eps) (ratLtRep_half eps heps)))
      (fun (n : Nat)
           (h : close (x n) L (ratHalf eps) ∧
                close (y n) M (ratHalf eps)) =>
        close_add (x n) L (y n) M eps (And.left h) (And.right h))

-- ─────────────────────────────────────────────────────────────
-- 76.3 取负律
-- ─────────────────────────────────────────────────────────────

-- 阈值不变，逐点 `close_neg`。
theorem converges_neg (x : Seq) (L : ratRep) (h : Converges x L) :
    Converges (negSeq x) (ratNegRep L) :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    eventually_mono
      (fun (n : Nat) => close (x n) L eps)
      (fun (n : Nat) => close (negSeq x n) (ratNegRep L) eps)
      (h eps heps)
      (fun (n : Nat) (hc : close (x n) L eps) =>
        close_neg (x n) L eps hc)

-- ─────────────────────────────────────────────────────────────
-- 76.4 减法律
-- ─────────────────────────────────────────────────────────────

-- `subSeq x y` 展开是 `addSeq x (negSeq y)`，`ratSubRep L M` 展开是
-- `ratAddRep L (ratNegRep M)`——两处都是定义相等，直接转发。
theorem converges_sub (x y : Seq) (L M : ratRep)
    (hx : Converges x L) (hy : Converges y M) :
    Converges (subSeq x y) (ratSubRep L M) :=
  converges_add x (negSeq y) L (ratNegRep M) hx (converges_neg y M hy)

-- ─────────────────────────────────────────────────────────────
-- 76.5 具体：零 + 零收敛到零
-- ─────────────────────────────────────────────────────────────

-- 76.2 给 `zeroSeq + zeroSeq → 0 + 0`；`ratAdd_zero` 把极限换回 `0`。
theorem demo_add_zero :
    Converges (addSeq zeroSeq zeroSeq) ratZeroRep :=
  converges_congr_limit
    (addSeq zeroSeq zeroSeq)
    (ratAddRep ratZeroRep ratZeroRep)
    ratZeroRep
    (converges_add zeroSeq zeroSeq ratZeroRep ratZeroRep
      demo_converges_zero demo_converges_zero)
    (ratAdd_zero ratZeroRep)
