-- 单元80 极限只看尾部：平移
--
-- 收敛的定义里有一个 `∃ N`：性质只要从某个下标起成立。前面的有限项因此
-- 不影响极限。把这句话变成定理，最直接的试验是把序列整体往右推 k 格，
-- 看收敛性与极限是否原样保留。答案是两边都保留。
--
-- 证明是两个方向。若原序列收敛，同一个阈值 N 仍然管用，因为 n + k ≥ n；
-- 反过来，从平移后的序列取阈值 N，原来的序列从 N + k 起都对应平移序列
-- 的第 N 项以后。后一个方向需要把 m ≥ N + k 拆成 m = (N + j) + k，这一步
-- 用 ㊺ 的 `leNat_exists_add` 与 `add_rotate`。
--
-- 边界：这里只做平移，不做「改动有限项」。后者的说法更强，需要把
-- 「终究相等」单独定义，留给下一个单元。不新增公理。

import lib.Limit

-- ─────────────────────────────────────────────────────────────
-- 80.0 平移序列
-- ─────────────────────────────────────────────────────────────

-- `shiftSeq k x` 的第 n 项是原序列的第 n + k 项。
def shiftSeq (k : Nat) (x : Seq) : Seq := fun (n : Nat) => x (Nat.add n k)

-- ─────────────────────────────────────────────────────────────
-- 80.1 终究性沿平移往前搬
-- ─────────────────────────────────────────────────────────────

-- 沿用原阈值 `N`。`N ≤ N + k` 由 `leNat_self_add` 给，
-- `N + k ≤ n + k` 由 `leNat_add_right` 给，传递后即可用原来的见证。
theorem eventually_shift (P : Nat → Prop) (h : Eventually P) (k : Nat) :
    Eventually (fun (n : Nat) => P (Nat.add n k)) :=
  Exists.elim h
    (fun (N : Nat) (hN : ∀ (n : Nat), LeNat N n → P n) =>
      Exists.intro N
        (fun (n : Nat) (hn : LeNat N n) =>
          hN (Nat.add n k)
            (leNat_trans N (Nat.add N k) (Nat.add n k)
              (leNat_self_add N k)
              (leNat_add_right N n k hn))))

-- ─────────────────────────────────────────────────────────────
-- 80.2 从平移后的终究性回到原来的终究性
-- ─────────────────────────────────────────────────────────────

-- 平移的阈值是 `N`，原序列取 `N + k`。对 `m ≥ N + k`，
-- `leNat_exists_add` 给 `m = (N + k) + j`；`add_rotate` 把它改写成
-- `(N + j) + k`，于是 `m` 正是平移序列第 `N + j` 项。
theorem eventually_of_shift (P : Nat → Prop) (k : Nat)
    (h : Eventually (fun (n : Nat) => P (Nat.add n k))) : Eventually P :=
  Exists.elim h
    (fun (N : Nat)
        (hN : ∀ (n : Nat), LeNat N n → P (Nat.add n k)) =>
      Exists.intro (Nat.add N k)
        (fun (m : Nat) (hm : LeNat (Nat.add N k) m) =>
          Exists.elim (leNat_exists_add (Nat.add N k) m hm)
            (fun (j : Nat)
                (hj : m = Nat.add (Nat.add N k) j) =>
              @Eq.subst.{1} Nat (fun (t : Nat) => P t)
                (Nat.add (Nat.add N j) k) m
                (Eq.symm (Eq.trans hj (add_rotate N k j)))
                (hN (Nat.add N j) (leNat_self_add N j)))))

-- ─────────────────────────────────────────────────────────────
-- 80.3 两条合起来
-- ─────────────────────────────────────────────────────────────

theorem eventually_shift_iff (P : Nat → Prop) (k : Nat) :
    Eventually (fun (n : Nat) => P (Nat.add n k)) ↔ Eventually P :=
  Iff.intro
    (fun (h : Eventually (fun (n : Nat) => P (Nat.add n k))) =>
      eventually_of_shift P k h)
    (fun (h : Eventually P) => eventually_shift P h k)

-- ─────────────────────────────────────────────────────────────
-- 80.4 收敛沿平移往前搬
-- ─────────────────────────────────────────────────────────────

-- 对每个 ε，把原极限的终究性用 80.1 平移；`shiftSeq k x n` 就是
-- `x (n + k)`，定义展开即可。
theorem converges_shift_of (x : Seq) (L : ratRep) (k : Nat)
    (h : Converges x L) : Converges (shiftSeq k x) L :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    eventually_shift (fun (n : Nat) => close (x n) L eps)
      (h eps heps) k

-- ─────────────────────────────────────────────────────────────
-- 80.5 平移不改变收敛性与极限
-- ─────────────────────────────────────────────────────────────

-- 正向由 80.4。反向对每个 ε 用 80.2 把平移后的终究性搬回来。
theorem converges_shift (x : Seq) (L : ratRep) (k : Nat) :
    Converges (shiftSeq k x) L ↔ Converges x L :=
  Iff.intro
    (fun (h : Converges (shiftSeq k x) L) (eps : ratRep)
        (heps : ratLtRep ratZeroRep eps) =>
      eventually_of_shift (fun (n : Nat) => close (x n) L eps) k
        (h eps heps))
    (fun (h : Converges x L) => converges_shift_of x L k h)

-- ─────────────────────────────────────────────────────────────
-- 80.6 具体：零序列平移一格
-- ─────────────────────────────────────────────────────────────

theorem demo_shift_zero : Converges (shiftSeq 1 zeroSeq) ratZeroRep :=
  converges_shift_of zeroSeq ratZeroRep 1 demo_converges_zero
