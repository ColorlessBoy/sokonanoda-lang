-- 单元81 尾部等价：改动有限项
--
-- 收敛只约束「从某一项开始」的项，前面的有限项不在其中。80 把这条观察用在
-- 整体平移上；这里换一个更弱的条件：如果两个序列从某一项起逐项相等，极限
-- 会不会改变？不会。把「从某项起相等」写成 `TailEq` 之后，证明只剩一次
-- 逐点搬运。
--
-- 路线：
--
--   · 81.1 `close` 的第一个点沿 `ratRel` 搬运——两条序列的项不必是同一个
--     代表元，只要代表元等价；
--   · 81.2 / 81.3 对称与传递：逐点用 `ratRel_symm` 与 `ratRel_trans_gen`，
--     自反由定义直接给出；
--   · 81.4 主定理：`TailEq x y` 时，`x` 收敛到 `L` 与 `y` 收敛到 `L` 等价，
--     81.5 把两个方向合成充要条件；
--   · 81.6 / 81.7 逐点相等是尾部相等的特例，收敛也随之搬运。
--
-- 边界：这里允许前几项任意不同，也允许对应项只是代表元等价；结论只要求
-- 从某项起逐项相等，比「改动有限项」更宽。不新增公理。

import lib.Limit
import lib.RatSub

-- ─────────────────────────────────────────────────────────────
-- 81.0 尾部等价
-- ─────────────────────────────────────────────────────────────

def TailEq (x y : Seq) : Prop :=
  Eventually (fun (n : Nat) => ratRel (x n) (y n))

theorem tailEq_refl (x : Seq) : TailEq x x :=
  Exists.intro Nat.zero
    (fun (n : Nat) (_hn : LeNat Nat.zero n) => ratRel_refl (x n))

-- ─────────────────────────────────────────────────────────────
-- 81.1 `close` 在第一个点上沿 `ratRel` 搬运
-- ─────────────────────────────────────────────────────────────

-- `y - L` 展开成 `y + (-L)`；`ratAddRep_wd_gen` 把 `x + (-L)` 的等价
-- 搬到它上面，再让绝对值只依赖第一个因子的等价类。
theorem close_wd_left (x y L eps : ratRep) (hxy : ratRel x y)
    (h : close x L eps) : close y L eps :=
  Exists.elim h
    (fun (d : ratRep)
        (hd : ratAbsRel (ratSubRep x L) d ∧ ratLtRep d eps) =>
      Exists.intro d
        (And.intro
          (ratAbsRel_wd_left (ratSubRep x L) (ratSubRep y L) d
            (ratAddRep_wd_gen x y (ratNegRep L) hxy)
            (And.left hd))
          (And.right hd)))

-- ─────────────────────────────────────────────────────────────
-- 81.2 尾部等价是对称的
-- ─────────────────────────────────────────────────────────────

-- 阈值不动，逐点把 `ratRel` 换方向。
theorem tailEq_symm (x y : Seq) (h : TailEq x y) : TailEq y x :=
  eventually_mono (fun (n : Nat) => ratRel (x n) (y n))
    (fun (n : Nat) => ratRel (y n) (x n)) h
    (fun (n : Nat) (hn : ratRel (x n) (y n)) =>
      ratRel_symm (x n) (y n) hn)

-- ─────────────────────────────────────────────────────────────
-- 81.3 尾部等价是传递的
-- ─────────────────────────────────────────────────────────────

-- 两条「终究」并到同一个阈值，逐点串 `ratRel`。
theorem tailEq_trans (x y z : Seq) (hxy : TailEq x y) (hyz : TailEq y z) :
    TailEq x z :=
  eventually_mono
    (fun (n : Nat) => ratRel (x n) (y n) ∧ ratRel (y n) (z n))
    (fun (n : Nat) => ratRel (x n) (z n))
    (eventually_and (fun (n : Nat) => ratRel (x n) (y n))
      (fun (n : Nat) => ratRel (y n) (z n)) hxy hyz)
    (fun (n : Nat) (h : ratRel (x n) (y n) ∧ ratRel (y n) (z n)) =>
      ratRel_trans_gen (x n) (y n) (z n) (And.left h) (And.right h))

-- ─────────────────────────────────────────────────────────────
-- 81.4 尾部等价不改变极限
-- ─────────────────────────────────────────────────────────────

-- 每个 `eps` 把两条终究性并到同一个 `N`，之后逐点用 81.1。
theorem converges_congr_tail (x y : Seq) (L : ratRep) (h : Converges x L)
    (ht : TailEq x y) : Converges y L :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    eventually_mono
      (fun (n : Nat) => close (x n) L eps ∧ ratRel (x n) (y n))
      (fun (n : Nat) => close (y n) L eps)
      (eventually_and (fun (n : Nat) => close (x n) L eps)
        (fun (n : Nat) => ratRel (x n) (y n)) (h eps heps) ht)
      (fun (n : Nat) (hp : close (x n) L eps ∧ ratRel (x n) (y n)) =>
        close_wd_left (x n) (y n) L eps (And.right hp) (And.left hp))

-- ─────────────────────────────────────────────────────────────
-- 81.5 两个方向合起来
-- ─────────────────────────────────────────────────────────────

theorem converges_congr_tail_iff (x y : Seq) (L : ratRep) (ht : TailEq x y) :
    Converges x L ↔ Converges y L :=
  Iff.intro
    (fun (h : Converges x L) => converges_congr_tail x y L h ht)
    (fun (h : Converges y L) =>
      converges_congr_tail y x L h (tailEq_symm x y ht))

-- ─────────────────────────────────────────────────────────────
-- 81.6 逐点相等是尾部相等的特例
-- ─────────────────────────────────────────────────────────────

theorem tailEq_of_pointwise (x y : Seq)
    (h : ∀ (n : Nat), ratRel (x n) (y n)) : TailEq x y :=
  Exists.intro Nat.zero
    (fun (n : Nat) (_hn : LeNat Nat.zero n) => h n)

-- ─────────────────────────────────────────────────────────────
-- 81.7 逐点相等也不改变极限
-- ─────────────────────────────────────────────────────────────

theorem converges_congr_pointwise (x y : Seq) (L : ratRep)
    (h : Converges x L) (hp : ∀ (n : Nat), ratRel (x n) (y n)) :
    Converges y L :=
  converges_congr_tail x y L h (tailEq_of_pointwise x y hp)
