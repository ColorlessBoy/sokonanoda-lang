-- 单元69 数系链：从 ℕ 到 ℝ 的保序嵌入（解答）
--
-- 本课程已经把数系从 ℕ 造到 ℤ（序对商）、ℚ（再商一次）、ℝ（Cauchy
-- 序列的商）。II.7 不再造新数，而是把这四层接起来读一遍：
--
--   ℕ —(n ↦ (n,0))→ ℤ —((a,b) ↦ (a-b)/1)→ ℚ —(q ↦ 常序列 q)→ ℝ
--
-- 三段各有不同的代价：
--
--   · ℕ → ℤ：只换代表元，`(n, 0)` 直接就是 `intOfNat n`；
--   · ℤ → ℚ：要把代表元映射下降成 `Int → Rat`——必须交良定义性
--     （`intToRatRep_wd`），再经一次 `Quot.lift`；
--   · ℚ → ℝ：`Real` 是序列的商，嵌入的像是常序列
--     `constSeq q`，Cauchy 性由 68.1 付清。
--
-- 序的迁移分两段陈述：前两段停在代表元层（ℤ 的序在本课程里没有下降成
-- `Int → Int → Prop`，本单元不替它下降），ℝ 上的序则是 66 已经下降好
-- 的 `realLe`。于是「ℕ 的 ≤ 一路走到 ℝ 的 ≤」是 69.10 的合成。
--
-- 边界（明说）：本单元只把函数（ℤ → ℚ 的嵌入）下降一次，不把ℤ
-- 的序再下降；序保持的前两段因此写成代表元关系 `leRep` / `ratLeRep`，
-- 这是诚实的部分结论，不是绕过。

import lib.RatAbs
import lib.RealComplete

-- ─────────────────────────────────────────────────────────────
-- 69.0 自然数到整数的代表元
-- ─────────────────────────────────────────────────────────────

-- `intOfNat n` 就是 `Quot.mk (n, 0)`；这里把代表元单独命名，后面
-- 的序与加法都直接对它陈述。
def natToIntRep (n : Nat) : Prod Nat Nat := @prod_mk Nat Nat n Nat.zero

-- ─────────────────────────────────────────────────────────────
-- 69.1 整数到有理数的代表元：`(a, b) ↦ (a - b) / 1`
-- ─────────────────────────────────────────────────────────────

-- `ratRep` 的第三个坐标 `n` 表示分母 `n + 1`；取 `n = 0` 就是除以 1。
-- 于是整数的代表元 `(a, b)`（表示 `a - b`）原样搬成有理数 `(a - b)/1`。
def intToRatRep (p : Prod Nat Nat) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat p Nat.zero

-- ─────────────────────────────────────────────────────────────
-- 69.2 嵌入尊重整数的相等
-- ─────────────────────────────────────────────────────────────

-- `intRel p q` 是交叉和等式；`ratRel (p/1) (q/1)` 的交叉相乘只多乘了
-- `den 0 = (1, 0)`，正好是 `mulRep_wd` 的形状。坐标用 `Prod.fst` /
-- `Prod.snd` 取出来，避免对变量 `p` 做模式匹配（假设位不会跟着重写）。
theorem intToRatRep_wd (p q : Prod Nat Nat) (h : intRel p q) :
    ratRel (intToRatRep p) (intToRatRep q) :=
  mulRep_wd (Prod.fst Nat Nat p) (Prod.snd Nat Nat p)
    (Prod.fst Nat Nat q) (Prod.snd Nat Nat q) 1 0 h

-- ─────────────────────────────────────────────────────────────
-- 69.3 下降成 `Int → Rat`
-- ─────────────────────────────────────────────────────────────

-- 与 ⑲ 的 `intNeg` 同一写法：`Quot.lift` 的函数取 `ratOf p 0`，
-- 良定义性用 `Quot.sound` 把 69.2 的代表元关系升级成商里的相等。
def intToRat : Int → Rat :=
  @Quot.lift.{1, 1} (Prod Nat Nat) intRel Rat
    (fun (p : Prod Nat Nat) => ratOf p Nat.zero)
    (fun (p q : Prod Nat Nat) (h : intRel p q) =>
      @Quot.sound.{1} ratRep ratRel (intToRatRep p) (intToRatRep q)
        (intToRatRep_wd p q h))

-- ─────────────────────────────────────────────────────────────
-- 69.4 ι 规则
-- ─────────────────────────────────────────────────────────────

-- `Quot.lift` 作用在 `Quot.mk p` 上按 ι 归约成 `f p`，所以是定义性相等。
theorem intToRat_mk (a b : Nat) :
    intToRat (@Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat a b)) =
    ratOf (@prod_mk Nat Nat a b) Nat.zero :=
  @Eq.refl.{1} Rat (ratOf (@prod_mk Nat Nat a b) Nat.zero)

-- ─────────────────────────────────────────────────────────────
-- 69.5 ℕ 序嵌入 ℤ（代表元层）
-- ─────────────────────────────────────────────────────────────

-- `leRep (n, 0) (m, 0)` 展开就是 `LeNat (n + 0) (m + 0)`；`leNat_add_right`
-- 把 `LeNat n m` 右加 0 直接搬过去。
theorem natToInt_le (n m : Nat) (h : LeNat n m) :
    leRep (natToIntRep n) (natToIntRep m) :=
  leNat_add_right n m Nat.zero h

-- ─────────────────────────────────────────────────────────────
-- 69.6 ℤ 序嵌入 ℚ
-- ─────────────────────────────────────────────────────────────

-- `ratLeRep (p/1) (q/1)` 是交叉相乘后的 `leRep`；「乘正分母保序」
-- （`leRep_mul_den_right`）正好把 `leRep p q` 搬到 `den 0 = (1, 0)` 上。
theorem intToRat_le (p q : Prod Nat Nat) (h : leRep p q) :
    ratLeRep (intToRatRep p) (intToRatRep q) :=
  leRep_mul_den_right p q Nat.zero h

-- ─────────────────────────────────────────────────────────────
-- 69.7 `x ≤ y ⇒ x - y ≤ 0`
-- ─────────────────────────────────────────────────────────────

-- 把 `x ≤ y` 两边同加 `-y`（㊹ 的加法相容），右边 `y + -y` 用 55 的
-- 逆元律收成 0，再用传递性。`ratSubRep x y` 就是 `x + -y` 的定义。
theorem ratLeRep_sub_nonpos (x y : ratRep) (h : ratLeRep x y) :
    ratLeRep (ratSubRep x y) ratZeroRep :=
  ratLeRep_trans (ratAddRep x (ratNegRep y)) (ratAddRep y (ratNegRep y)) ratZeroRep
    (ratLeRep_add_right x y (ratNegRep y) h)
    (ratLeRep_of_ratRel (ratAddRep y (ratNegRep y)) ratZeroRep (ratAdd_neg_gen y))

-- ─────────────────────────────────────────────────────────────
-- 69.8 ℚ 序嵌入 ℝ（常序列）
-- ─────────────────────────────────────────────────────────────

-- 66 的 ι 规则 `realLe_mk` 把商上的 `realLe` 化回代表元层的 `realLeRep`。
-- 三个分量：两个常序列的 Cauchy 性（68.1），以及逐点的
-- `(constSeq x n) - (constSeq y n) = x - y ≤ 0 ≤ eps`。
theorem ratToReal_le (x y : ratRep) (h : ratLeRep x y) :
    realLe (Real.mk (constSeq x)) (Real.mk (constSeq y)) :=
  Iff.mpr (realLe_mk (constSeq x) (constSeq y))
    (And.intro (cauchy_const x)
      (And.intro (cauchy_const y)
        (fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
          Exists.intro Nat.zero
            (fun (n : Nat) (_hn : LeNat Nat.zero n) =>
              ratLeRep_trans (ratSubRep (constSeq x n) (constSeq y n)) ratZeroRep eps
                (ratLeRep_sub_nonpos (constSeq x n) (constSeq y n) h)
                (ratLtRep_le ratZeroRep eps heps)))))

-- ─────────────────────────────────────────────────────────────
-- 69.9 合成：ℕ → ℝ
-- ─────────────────────────────────────────────────────────────

-- 有理数层的像是 `intToRatRep (natToIntRep n)`；`Real.mk` 再把常序列
-- 送进商。这里不需要 `intToRat`（`Rat` 的商）——`Real` 的代表元是序列，
-- 常序列取的是有理数的代表元，不是商元素。
def natToReal (n : Nat) : Real :=
  Real.mk (constSeq (intToRatRep (natToIntRep n)))

-- ─────────────────────────────────────────────────────────────
-- 69.10 整条链保序
-- ─────────────────────────────────────────────────────────────

-- 69.6 把 ℤ 的序送到 ℚ 的代表元，69.8 再把它送到 ℝ 的序。
theorem natToReal_le (n m : Nat) (h : LeNat n m) :
    realLe (natToReal n) (natToReal m) :=
  ratToReal_le (intToRatRep (natToIntRep n)) (intToRatRep (natToIntRep m))
    (intToRat_le (natToIntRep n) (natToIntRep m) (natToInt_le n m h))

-- ─────────────────────────────────────────────────────────────
-- 69.11 具体：1 ≤ 3 在 ℝ 里仍成立
-- ─────────────────────────────────────────────────────────────

theorem demo_natToReal_le :
    realLe (natToReal 1) (natToReal 3) :=
  natToReal_le 1 3 (le_succ 1 2 (le_succ 1 1 (le_refl 1)))
