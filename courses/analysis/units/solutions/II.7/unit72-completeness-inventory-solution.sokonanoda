-- 单元72 完备性盘点：代表元层的结论，放到集合层还剩下多少
--
-- 前面证了：每个有理 Cauchy 序列 x 在 ℝ 中收敛到自己的类。那是在代表元层说的话。
-- 到了集合层，上界、最小上界这些词要用 realLe 重新陈述；我们自然要问：这条完备性
-- 还能保住多少？
--
-- 结论先说：能保住一个具体集合的 LUB——S = {x | x ≤ 0} 的最小上界是 0；但一般定理
-- 「每个非空有上界集合都有 LUB」需要选择公理，本课程没有，所以不能写。
--
-- 为什么只做具体集合？因为选择公理不在本课程里；与其把一般定理写成公理，不如把能
-- 构造性拿到的实例做干净：先定义零实数为常零序列的类，再证 0 是 S 的上界且最小，
-- 把两件事合成「有 LUB」，最后回到常序列版本的完备性。
--
-- 这一单元不是新造数，而是检查前面造好的 ℝ 在集合语言里能说到哪一步；边界就是
-- 本课程与「完整实数完备性」之间的距离。

import lib.RealComplete
import lib.RealOrderLift

-- ─────────────────────────────────────────────────────────────
-- 72.0 集合层的词汇：上界、最小上界、有 LUB
-- ─────────────────────────────────────────────────────────────

def UpperBound (S : Real → Prop) (b : Real) : Prop :=
  ∀ (x : Real), S x → realLe x b

def IsLUB (S : Real → Prop) (b : Real) : Prop :=
  UpperBound S b ∧ ∀ (b' : Real), UpperBound S b' → realLe b b'

def HasLUB (S : Real → Prop) : Prop := ∃ (b : Real), IsLUB S b

-- 我们用的零：常零序列的类。66.4 的 `realLe_mk` 之后，关于它的序
-- 都回到代表元层。
def zeroReal : Real := Real.mk zeroSeq

-- ─────────────────────────────────────────────────────────────
-- 72.2 0 是 `{x | x ≤ 0}` 的上界
-- ─────────────────────────────────────────────────────────────

-- 展开 `UpperBound` 后目标就是 `∀ x, realLe x zeroReal → realLe x zeroReal`。
theorem upperBound_nonpos :
    UpperBound (fun (x : Real) => realLe x zeroReal) zeroReal :=
  fun (x : Real) (h : realLe x zeroReal) => h

-- ─────────────────────────────────────────────────────────────
-- 72.3 0 是最小上界
-- ─────────────────────────────────────────────────────────────

-- `hb` 对任意 `x ∈ S` 给 `x ≤ b`；取 `x = 0`，只需交 `0 ≤ 0`。
-- 后者经 66.4 的 `realLe_mk` 回到 `realLeRep zeroSeq zeroSeq`，
-- 由 64.1 的自反（`cauchy_zero` 付守卫）给出。
theorem least_nonpos (b : Real)
    (hb : UpperBound (fun (x : Real) => realLe x zeroReal) b) :
    realLe zeroReal b :=
  hb zeroReal
    (Iff.mpr (realLe_mk zeroSeq zeroSeq)
      (realLeRep_refl zeroSeq cauchy_zero))

-- ─────────────────────────────────────────────────────────────
-- 72.4 具体集合有 LUB：构造性的存在
-- ─────────────────────────────────────────────────────────────

-- `HasLUB` 是一个 `∃ b`；见证取 `zeroReal`，两部分交给 72.2 与 72.3。
-- 这里没有 `Classical.choice`：见证是显式给出的。
theorem hasLUB_nonpos :
    HasLUB (fun (x : Real) => realLe x zeroReal) :=
  Exists.intro zeroReal (And.intro upperBound_nonpos least_nonpos)

-- ─────────────────────────────────────────────────────────────
-- 72.5 代表元层完备性的常序列版
-- ─────────────────────────────────────────────────────────────

-- 68.7 对任意 Cauchy 序列给 `TendsTo x x`；常序列的 Cauchy 性是
-- 68.1 的 `cauchy_const`。
theorem const_tends_to_class (q : ratRep) :
    TendsTo (constSeq q) (constSeq q) :=
  cauchy_tends_to_class (constSeq q) (cauchy_const q)

-- ─────────────────────────────────────────────────────────────
-- 72.6 具体：常 1 序列收敛到 1
-- ─────────────────────────────────────────────────────────────

-- 把 72.5 用在 `q := qrep 1 0 0` 上（分母字段 0 就是分母 1）。
theorem demo_const_tends_to_one :
    TendsTo (constSeq (qrep 1 Nat.zero Nat.zero))
      (constSeq (qrep 1 Nat.zero Nat.zero)) :=
  const_tends_to_class (qrep 1 Nat.zero Nat.zero)
