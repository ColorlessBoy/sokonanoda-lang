-- 单元㊺ 序的全性：每个有理数都有绝对值（解答）
--
-- 进入 **II.5：ℝ 的商、代数与序**。第一件事是把 `realRel` 补成**等价关系**：
-- ㊵ 做了自反、㊷ 做了对称，还差**传递性**。传递性的标准证法是三角不等式 +
-- `ε` 折半：
--
--   close x y ε/2  ⇒  close y z ε/2  ⇒  close x z ε
--
-- 而三角不等式要用的第一块地基，正是具体有**ℚ 的序是全序**。
--
-- 为什么全序是前提：㉝ 的绝对值是**关系**而不是函数
--
--   ratAbsRel x d  :⟺  (0 ≤ x ∧ d ~ x) ∨ (x ≤ 0 ∧ d ~ -x)
--
-- 要证「`|x-y|` 存在」就得先知道 `x-y` 落在哪一边；没有全序，这个析取连
-- 一个居民都拿不出来（㉟ 的 `close` 里那个 `∃ d` 就会是空的）。本单元结清：
--
--   · ㊺.1 `leNat_total`：ℕ 的 `≤` 是全序（对第二个变量归纳）；
--   · ㊺.2 `ratLeRep_total`：ℚ 的 `≤` 是全序（`ratLeRep` 就是交叉相乘后的
--     `LeNat`，把 ㊺.1 直接用上）；
--   · ㊺.3 `ratAbsRel_total`：每个有理数都有绝对值（两种情况分别取 `x` 与 `-x`）；
--   · ㊺.4 `ratAbsRel_nonneg`：绝对值非负（`ratLeRep_congr_snd` 把 `x` 换成 `d`，
--     第二支再把 `0 ≤ -x` 用 ㊶ 的 `ratLeRep_neg_gen` 搬过来）；
--   · ㊺.5 具体：`|-1/2| = 1/2`。
--
-- 证明路线：㊺.1 需要一条小引理 `leNat_eq_or_succ`（`k ≤ m` ⇒ `k = m` 或
-- `succ k ≤ m`），它直接对 `LeNat k m` 的证明做 match（`le_refl` 支取等式，
-- `le_succ` 支用 `leNat_succ_succ`）；㊺.1 再用 `Nat.rec` 对 `n` 归纳。
-- ㊺.4 的通用包装要先把参数写成展开类型、在 match 之后引入假设（`ratRep` 是
-- 定义别名，见 ㊷ 的 `_aux` 写法）。
--
-- 本单元不引入新定义；ℚ 的算术与序的引擎来自 `lib/Rat` / `lib/RatOrder`。

import lib.Cauchy

-- ─────────────────────────────────────────────────────────────
-- ㊺.1 ℕ 的序是全序
-- ─────────────────────────────────────────────────────────────

-- 辅助：`k ≤ m` 时，「`k = m`」或「`k + 1 ≤ m`」必居其一。
theorem leNat_eq_or_succ (k m : Nat) (h : LeNat k m) :
    (k = m) ∨ LeNat (Nat.succ k) m :=
  match h with
  | le_refl n => Or.inl (Eq.refl n)
  | le_succ a b hh => Or.inr (leNat_succ_succ a b hh)

theorem leNat_total (m n : Nat) : LeNat m n ∨ LeNat n m :=
  Nat.rec (fun (n : Nat) => LeNat m n ∨ LeNat n m)
    (Or.inr (leNat_zero_le m))
    (fun (k : Nat) (ih : LeNat m k ∨ LeNat k m) =>
      Or.elim
        (fun (h : LeNat m k) => Or.inl (le_succ m k h))
        (fun (h : LeNat k m) =>
          Or.elim
            (fun (heq : k = m) =>
              Or.inl
                (le_succ m k
                  (@Eq.subst.{1} Nat (fun (z : Nat) => LeNat z k) k m heq
                    (le_refl k))))
            (fun (hlt : LeNat (Nat.succ k) m) => Or.inr hlt)
            (leNat_eq_or_succ k m h))
        ih)
    n

-- ─────────────────────────────────────────────────────────────
-- ㊺.2 ℚ 的序是全序
-- ─────────────────────────────────────────────────────────────

theorem ratLeRep_total (x y : ratRep) : ratLeRep x y ∨ ratLeRep y x :=
  leNat_total (Nat.add (Prod.fst Nat Nat (leNum x y)) (Prod.snd Nat Nat (leNum y x)))
              (Nat.add (Prod.fst Nat Nat (leNum y x)) (Prod.snd Nat Nat (leNum x y)))

-- ─────────────────────────────────────────────────────────────
-- ㊺.3 每个有理数都有绝对值
-- ─────────────────────────────────────────────────────────────

theorem ratAbsRel_total (x : ratRep) : ∃ (d : ratRep), ratAbsRel x d :=
  Or.elim
    (fun (h : ratLeRep ratZeroRep x) =>
      Exists.intro x (Or.inl (And.intro h (ratRel_refl x))))
    (fun (h : ratLeRep x ratZeroRep) =>
      Exists.intro (ratNegRep x)
        (Or.inr (And.intro h (ratRel_refl (ratNegRep x)))))
    (ratLeRep_total ratZeroRep x)

-- ─────────────────────────────────────────────────────────────
-- ㊺.4 绝对值非负
-- ─────────────────────────────────────────────────────────────

theorem ratAbsRel_nonneg_aux (x d : Prod (Prod Nat Nat) Nat) :
    ratAbsRel x d → ratLeRep ratZeroRep d :=
  match x with
  | prod_mk (prod_mk a b) m =>
    match d with
    | prod_mk (prod_mk a' b') m' =>
      fun (h : ratAbsRel (prod_mk (prod_mk a b) m) (prod_mk (prod_mk a' b') m')) =>
        @Or.elim
          (ratLeRep ratZeroRep (qrep a b m) ∧ ratRel (qrep a' b' m') (qrep a b m))
          (ratLeRep (qrep a b m) ratZeroRep ∧
            ratRel (qrep a' b' m') (ratNegRep (qrep a b m)))
          (ratLeRep ratZeroRep (qrep a' b' m'))
          (fun (h1 : ratLeRep ratZeroRep (qrep a b m) ∧ ratRel (qrep a' b' m') (qrep a b m)) =>
            ratLeRep_congr_snd Nat.zero Nat.zero a b a' b' Nat.zero m m'
              (ratRel_symm (qrep a' b' m') (qrep a b m) (And.right h1))
              (And.left h1))
          (fun (h2 : ratLeRep (qrep a b m) ratZeroRep ∧
                     ratRel (qrep a' b' m') (ratNegRep (qrep a b m))) =>
            ratLeRep_congr_snd Nat.zero Nat.zero b a a' b' Nat.zero m m'
              (ratRel_symm (qrep a' b' m') (ratNegRep (qrep a b m))
                (And.right h2))
              (ratLeRep_neg_gen (qrep a b m) ratZeroRep (And.left h2)))
          h

theorem ratAbsRel_nonneg (x d : ratRep) (h : ratAbsRel x d) :
    ratLeRep ratZeroRep d :=
  ratAbsRel_nonneg_aux x d h

-- ─────────────────────────────────────────────────────────────
-- ㊺.5 具体：-1/2 的绝对值是 1/2
-- ─────────────────────────────────────────────────────────────

theorem demo_abs_neg_half :
    ratAbsRel (qrep Nat.zero 1 1) (qrep 1 Nat.zero 1) :=
  Or.inr
    (And.intro
      (le_succ Nat.zero Nat.zero (le_refl Nat.zero))
      (ratRel_refl (qrep 1 Nat.zero 1)))
