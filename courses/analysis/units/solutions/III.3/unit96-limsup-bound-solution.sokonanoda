-- 单元96 上下极限与常数界（解答）
--
-- 极限点只描述序列反复靠近的点，不直接说每一项落在哪里。若每一项都不超过
-- 一个常数 B，那么任何极限点也不超过 B：极限保持非严格序。于是 B 是极限点
-- 集合的上界，而上极限是这类上界里最小的，自然有 limsup ≤ B。下侧逐条对偶。
--
-- 96.1 与 96.2 做逐项的版本。96.3 与 96.4 放宽到终究：有限项可以不管，从
-- 某一项起满足就够。96.5 把常数界用在常序列上，配合唯一性认出一个具体的
-- 上极限。96.6 把两侧合起来。
--
-- 边界：只给单向的界。`limsup ≤ B` 不反推每一项都不超过 B——首项可以短暂
-- 高于 B，只要后面不再靠近。常数界因此是充分条件，不是刻画。不新增公理。

import lib.Limsup
import lib.Liminf
import lib.LimitLe

-- ─────────────────────────────────────────────────────────────
-- 96.0 序列的上界与下界
-- ─────────────────────────────────────────────────────────────

-- `BoundedAbove x B`：B 压住序列的每一项。
def BoundedAbove (x : Seq) (B : ratRep) : Prop :=
  ∀ (n : Nat), ratLeRep (x n) B

-- `BoundedBelow x B`：B 托住序列的每一项。
def BoundedBelow (x : Seq) (B : ratRep) : Prop :=
  ∀ (n : Nat), ratLeRep B (x n)

-- ─────────────────────────────────────────────────────────────
-- 96.1 上界压住上极限
-- ─────────────────────────────────────────────────────────────

-- 对每个极限点 P，先取见证轨道 g。`x ∘ g` 的每一项都不超过 B，极限保持
-- 非严格序给出 `P ≤ B`。于是 B 是极限点集合的一个上界，上确界的最小性
-- （93.2）把 L 压在它下面。
theorem limsup_le_of_boundedAbove (x : Seq) (B L : ratRep)
    (hB : BoundedAbove x B) (hL : Limsup x L) : ratLeRep L B :=
  limsup_least x L hL B
    (fun (P : ratRep) (hP : LimitPoint x P) =>
      Exists.elim hP
        (fun (g : Nat → Nat)
            (hg : Subseq g ∧ Converges (fun (n : Nat) => x (g n)) P) =>
          converges_le_const (fun (n : Nat) => x (g n)) P B (And.right hg)
            (Exists.intro Nat.zero
              (fun (n : Nat) (_hn : LeNat Nat.zero n) => hB (g n)))))

-- ─────────────────────────────────────────────────────────────
-- 96.2 下界托住下极限
-- ─────────────────────────────────────────────────────────────

-- 把 96.1 的序翻过来：`B ≤ x n` 沿轨道传给极限点，`B` 成为极限点集合的
-- 一个下界，下确界的最大性（94.2）给出 `B ≤ L`。
theorem le_liminf_of_boundedBelow (x : Seq) (B L : ratRep)
    (hB : BoundedBelow x B) (hL : Liminf x L) : ratLeRep B L :=
  liminf_greatest x L hL B
    (fun (P : ratRep) (hP : LimitPoint x P) =>
      Exists.elim hP
        (fun (g : Nat → Nat)
            (hg : Subseq g ∧ Converges (fun (n : Nat) => x (g n)) P) =>
          converges_le_of_eventually (constSeq B) (fun (n : Nat) => x (g n)) B P
            (converges_const B) (And.right hg)
            (Exists.intro Nat.zero
              (fun (n : Nat) (_hn : LeNat Nat.zero n) => hB (g n)))))

-- ─────────────────────────────────────────────────────────────
-- 96.3 终究有上界就压住上极限
-- ─────────────────────────────────────────────────────────────

-- 有限项可以越过 B。96.1 的证明里，「每一项都不超过 B」只有从某个 N 起
-- 才用得上：轨道 `g` 不回头（91.3），所以 `g n ≥ N` 从 n ≥ N 起成立。
theorem limsup_le_of_eventually_boundedAbove (x : Seq) (B L : ratRep)
    (hB : Eventually (fun (n : Nat) => ratLeRep (x n) B)) (hL : Limsup x L) :
    ratLeRep L B :=
  limsup_least x L hL B
    (fun (P : ratRep) (hP : LimitPoint x P) =>
      Exists.elim hB
        (fun (N : Nat) (hN : ∀ (n : Nat), LeNat N n → ratLeRep (x n) B) =>
          Exists.elim hP
            (fun (g : Nat → Nat)
                (hg : Subseq g ∧ Converges (fun (n : Nat) => x (g n)) P) =>
              converges_le_const (fun (n : Nat) => x (g n)) P B (And.right hg)
                (Exists.intro N
                  (fun (n : Nat) (hn : LeNat N n) =>
                    hN (g n)
                      (leNat_trans N n (g n) hn (subseq_ge g (And.left hg) n)))))))

-- ─────────────────────────────────────────────────────────────
-- 96.4 终究有下界就托住下极限
-- ─────────────────────────────────────────────────────────────

-- 与 96.3 同形：把 96.2 里的逐项下界换成终究下界，阈值沿轨道往前搬。
theorem le_liminf_of_eventually_boundedBelow (x : Seq) (B L : ratRep)
    (hB : Eventually (fun (n : Nat) => ratLeRep B (x n))) (hL : Liminf x L) :
    ratLeRep B L :=
  liminf_greatest x L hL B
    (fun (P : ratRep) (hP : LimitPoint x P) =>
      Exists.elim hB
        (fun (N : Nat) (hN : ∀ (n : Nat), LeNat N n → ratLeRep B (x n)) =>
          Exists.elim hP
            (fun (g : Nat → Nat)
                (hg : Subseq g ∧ Converges (fun (n : Nat) => x (g n)) P) =>
              converges_le_of_eventually (constSeq B) (fun (n : Nat) => x (g n)) B P
                (converges_const B) (And.right hg)
                (Exists.intro N
                  (fun (n : Nat) (hn : LeNat N n) =>
                    hN (g n)
                      (leNat_trans N n (g n) hn (subseq_ge g (And.left hg) n)))))))

-- ─────────────────────────────────────────────────────────────
-- 96.5 常序列的上极限就是它的值
-- ─────────────────────────────────────────────────────────────

-- 常序列以上极限 `q`（93.7）；给出的上极限与它至多差一个相等（93.4）。
theorem limsup_const_rel (q L : ratRep) (h : Limsup (constSeq q) L) : ratRel L q :=
  limsup_unique (constSeq q) L q h (limsup_const q)

-- ─────────────────────────────────────────────────────────────
-- 96.6 两侧的界一起给出
-- ─────────────────────────────────────────────────────────────

-- 96.2 给出 `B ≤ M`，96.1 给出 `L ≤ C`，两条并起来。
theorem demo_both_bounds (x : Seq) (B C L M : ratRep)
    (hB : BoundedBelow x B) (hC : BoundedAbove x C)
    (hM : Liminf x M) (hL : Limsup x L) :
    ratLeRep B M ∧ ratLeRep L C :=
  And.intro
    (le_liminf_of_boundedBelow x B M hB hM)
    (limsup_le_of_boundedAbove x C L hC hL)
