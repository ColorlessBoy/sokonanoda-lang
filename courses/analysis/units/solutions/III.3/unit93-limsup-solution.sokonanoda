-- 单元93 上极限（解答）
--
-- 单元92 把「反复靠近的点」收成极限点集合，但集合本身还不回答「它最高到
-- 哪儿」。序列在两个值之间来回跳时，极限点有两个；要概括它反复靠近的上界，
-- 得把这些点一起压在某个数下面，再取其中最小的那个。这个数就是上极限。
--
-- 直接写「极限点集合的上确界」会遇到存在性问题：课程没有选择公理，也没有
-- 一般集合的最小上界。于是这里把「L 是极限点集合的上确界」整体写成谓词
-- `Limsup x L`，证明它给出的关系，而不声称每条序列都有这样的 L。
--
-- 边界：`Limsup` 是关系不是函数，存在性留待完备性那一层。不新增公理。

import lib.LimitPoint
import lib.Order

-- ─────────────────────────────────────────────────────────────
-- 93.0 上极限
-- ─────────────────────────────────────────────────────────────

def Limsup (x : Seq) (L : ratRep) : Prop :=
  IsSup ratRep ratLeRep (LimitPoint x) L

-- ─────────────────────────────────────────────────────────────
-- 93.1 上极限压住每个极限点
-- ─────────────────────────────────────────────────────────────

-- 「L 是上界」这一半按定义展开就是 `∀ M, LimitPoint x M → M ≤ L`。
theorem limsup_upper (x : Seq) (L : ratRep) (h : Limsup x L) :
    ∀ (M : ratRep), LimitPoint x M → ratLeRep M L :=
  fun (M : ratRep) (hM : LimitPoint x M) => (And.left h) M hM

-- ─────────────────────────────────────────────────────────────
-- 93.2 上极限是这类界里最小的
-- ─────────────────────────────────────────────────────────────

-- 「最小」这一半同样按定义展开：任何上界 B 都不小于 L。
theorem limsup_least (x : Seq) (L : ratRep) (h : Limsup x L) :
    ∀ (B : ratRep), (∀ (M : ratRep), LimitPoint x M → ratLeRep M B) →
      ratLeRep L B :=
  fun (B : ratRep)
      (hB : ∀ (M : ratRep), LimitPoint x M → ratLeRep M B) =>
    (And.right h) B hB

-- ─────────────────────────────────────────────────────────────
-- 93.3 比较的充要条件
-- ─────────────────────────────────────────────────────────────

-- 正方向：`M ≤ L` 与 `L ≤ B` 传递。反方向：把 `hB` 原样交给 93.2。
theorem limsup_le_iff (x : Seq) (L : ratRep) (h : Limsup x L) :
    ∀ (B : ratRep),
      ratLeRep L B ↔
        ∀ (M : ratRep), LimitPoint x M → ratLeRep M B :=
  fun (B : ratRep) =>
    Iff.intro
      (fun (hLB : ratLeRep L B) =>
        fun (M : ratRep) (hM : LimitPoint x M) =>
          ratLeRep_trans M L B ((And.left h) M hM) hLB)
      (fun (hB : ∀ (M : ratRep), LimitPoint x M → ratLeRep M B) =>
        (And.right h) B hB)

-- ─────────────────────────────────────────────────────────────
-- 93.4 上极限至多一个
-- ─────────────────────────────────────────────────────────────

-- `h` 是 L 的最小型：L' 是上界，所以 L ≤ L'。`h'` 反过来给出 L' ≤ L。
-- 两条交给 `ratLeRep_antisymm`。
theorem limsup_unique (x : Seq) (L L' : ratRep)
    (h : Limsup x L) (h' : Limsup x L') : ratRel L L' :=
  ratLeRep_antisymm L L'
    ((And.right h) L' (And.left h'))
    ((And.right h') L (And.left h))

-- ─────────────────────────────────────────────────────────────
-- 93.5 收敛序列的上极限是它的极限
-- ─────────────────────────────────────────────────────────────

-- 上界：极限点 M 与极限 L 相等，翻向后得 M ≤ L。最小性：L 自己是极限点，
-- 所以任意上界 B 都满足 L ≤ B。
theorem limsup_of_converges (x : Seq) (L : ratRep) (h : Converges x L) :
    Limsup x L :=
  And.intro
    (fun (M : ratRep) (hM : LimitPoint x M) =>
      ratLeRep_of_ratRel M L
        (ratRel_symm L M (limitPoint_unique_of_converges x L M h hM)))
    (fun (B : ratRep)
        (hB : ∀ (M : ratRep), LimitPoint x M → ratLeRep M B) =>
      hB L (converges_limitPoint x L h))

-- ─────────────────────────────────────────────────────────────
-- 93.6 收敛序列的上极限与它的极限相等
-- ─────────────────────────────────────────────────────────────

-- 93.5 把 L 变成上极限，与 M 的上极限性质一起交给 93.4。
theorem limsup_unique_of_converges (x : Seq) (L M : ratRep)
    (h : Converges x L) (hM : Limsup x M) : ratRel M L :=
  limsup_unique x M L hM (limsup_of_converges x L h)

-- ─────────────────────────────────────────────────────────────
-- 93.7 常序列的上极限
-- ─────────────────────────────────────────────────────────────

theorem limsup_const (q : ratRep) : Limsup (constSeq q) q :=
  limsup_of_converges (constSeq q) q (converges_const q)
