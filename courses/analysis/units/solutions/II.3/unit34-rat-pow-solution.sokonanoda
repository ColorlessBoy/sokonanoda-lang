-- 单元㉞ 有理数的幂：定义与计算规则
--
-- 幂在代表元上就是对乘法的 Nat.rec：ratPowRep x 0 := 1 = qrep 1 0 0，ratPowRep x
-- (n+1) := ratMulRep x (ratPowRep x n)。
--
-- 递归子写在第二个参数上，所以两条计算规则都是 ι 归约（一条 Eq.refl）。这里先立
-- 定义与三条最基本的计算规则（零次、后继、二次），再算一个具体例子 (1/2)^2 = 1/4。
--
-- 幂的代数律（x^(m+n) 与 x^m * x^n、x^(m·n) 与 (x^m)^n）要先把 ratMulRep 的
-- 结合/交换律搬上来，留给后续单元。

import lib.Rat

def ratOneRep : ratRep := qrep 1 Nat.zero Nat.zero

def ratPowRep (x : ratRep) (n : Nat) : ratRep :=
  Nat.rec (fun (_ : Nat) => ratRep) ratOneRep
    (fun (k : Nat) (ih : ratRep) => ratMulRep x ih) n

-- ─────────────────────────────────────────────────────────────
-- ㉞.1 零次幂
-- ─────────────────────────────────────────────────────────────

-- -- 零次幂：直接归约到 1。
-- soko:hint 目标形态：`ratPowRep x 0 = ratOneRep`。
-- soko:hint 关键件：Nat.rec 的基例（ι 归约）· Eq.refl。
theorem ratPow_zero (x : ratRep) : ratPowRep x Nat.zero = ratOneRep :=
  Eq.refl ratOneRep

-- ─────────────────────────────────────────────────────────────
-- ㉞.2 后继幂
-- ─────────────────────────────────────────────────────────────

-- -- 后继幂：展开成 x 乘 x^n。
-- soko:hint 目标形态：`ratPowRep x (Nat.succ n) = ratMulRep x (ratPowRep x n)`。
-- soko:hint 关键件：Nat.rec 的递归步（ι 归约）· Eq.refl。
theorem ratPow_succ (x : ratRep) (n : Nat) :
    ratPowRep x (Nat.succ n) = ratMulRep x (ratPowRep x n) :=
  Eq.refl (ratMulRep x (ratPowRep x n))

-- ─────────────────────────────────────────────────────────────
-- ㉞.3 二次幂
-- ─────────────────────────────────────────────────────────────

-- -- 二次幂是两次展开。
-- soko:hint 目标形态：`ratPowRep x 2 = ratMulRep x (ratMulRep x ratOneRep)`。
-- soko:hint 关键件：Nat.rec 的两次 ι 归约 · Eq.refl。
theorem ratPow_two (x : ratRep) :
    ratPowRep x 2 = ratMulRep x (ratMulRep x ratOneRep) :=
  Eq.refl (ratMulRep x (ratMulRep x ratOneRep))

-- ─────────────────────────────────────────────────────────────
-- ㉞.4 具体计算：(1/2)^2 = 1/4
-- ─────────────────────────────────────────────────────────────

-- -- 具体算 (1/2)^2 = 1/4。
-- soko:hint 目标形态：`ratPowRep (qrep 1 0 1) 2 = qrep 1 0 3`。
-- soko:hint 关键件：ratPow_two · ratMulRep 的 ι 归约 · Eq.refl。
theorem demo_pow_two_half :
    ratPowRep (qrep 1 Nat.zero 1) 2 = qrep 1 Nat.zero 3 :=
  Eq.refl (qrep 1 Nat.zero 3)
