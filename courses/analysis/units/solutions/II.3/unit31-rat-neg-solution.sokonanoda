-- 单元㉛ 有理数的负元：代表元层定义与良定义性
--
-- 单元㉙–㉚ 建立了 ℚ 的序与严格序。现在补上取负：一个分数取负，就是分子序对的两个
-- 坐标对调——(a-b)/(m+1) 的负是 (b-a)/(m+1)。代表元上正是 ratNegRep x =
-- (negRep (numOf x), denOf x)。
--
-- 要结清三件事：取负尊重相等（x 与 x' 相等时负元也相等）；取负做两次回到原处；
-- 以及一个具体计算 -(1/2) = (-1)/2。良定义性的做法是把 ratNegRep 与整数层的
-- negRep 在交叉乘积上对齐，再交给 negRep_wd。
--
-- 减法在这里不做：它只是加法与取负的组合，留到下一单元。

import lib.Rat

def ratNegRep (x : ratRep) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat (negRep (numOf x)) (denOf x)

-- ─────────────────────────────────────────────────────────────
-- ㉛.1 负元在交叉乘积上的形状
-- ─────────────────────────────────────────────────────────────

-- -- 先把取负在交叉乘积上的形状对齐：negRep 与乘分母的次序可以交换。
-- soko:hint 目标形态：`negRep (mulRep p (den n)) = mulRep (negRep p) (den n)`。
-- soko:hint 关键件：zero_add · congrArg · Eq.symm · Eq.trans。
theorem negRep_mulRep_den (p : Prod Nat Nat) (n : Nat) :
    negRep (mulRep p (den n)) = mulRep (negRep p) (den n) :=
  @Eq.trans.{1} (Prod Nat Nat)
    (negRep (mulRep p (den n)))
    (@prod_mk Nat Nat
      (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
      (Nat.add Nat.zero (myMul (Prod.fst Nat Nat p) (Nat.succ n))))
    (mulRep (negRep p) (den n))
    (@Eq.trans.{1} (Prod Nat Nat)
      (negRep (mulRep p (den n)))
      (@prod_mk Nat Nat
        (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
        (myMul (Prod.fst Nat Nat p) (Nat.succ n)))
      (@prod_mk Nat Nat
        (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
        (Nat.add Nat.zero (myMul (Prod.fst Nat Nat p) (Nat.succ n))))
      (Eq.refl (negRep (mulRep p (den n))))
      (@congrArg.{1} Nat (Prod Nat Nat)
        (myMul (Prod.fst Nat Nat p) (Nat.succ n))
        (Nat.add Nat.zero (myMul (Prod.fst Nat Nat p) (Nat.succ n)))
        (fun (y : Nat) =>
          @prod_mk Nat Nat
            (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n))) y)
        (Eq.symm (zero_add (myMul (Prod.fst Nat Nat p) (Nat.succ n))))))
    (@Eq.trans.{1} (Prod Nat Nat)
      (@prod_mk Nat Nat
        (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
        (Nat.add Nat.zero (myMul (Prod.fst Nat Nat p) (Nat.succ n))))
      (@prod_mk Nat Nat
        (myMul (Prod.snd Nat Nat p) (Nat.succ n))
        (Nat.add Nat.zero (myMul (Prod.fst Nat Nat p) (Nat.succ n))))
      (mulRep (negRep p) (den n))
      (@congrArg.{1} Nat (Prod Nat Nat)
        (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
        (myMul (Prod.snd Nat Nat p) (Nat.succ n))
        (fun (x : Nat) =>
          @prod_mk Nat Nat x
            (Nat.add Nat.zero (myMul (Prod.fst Nat Nat p) (Nat.succ n))))
        (zero_add (myMul (Prod.snd Nat Nat p) (Nat.succ n))))
      (Eq.refl (mulRep (negRep p) (den n))))

-- ─────────────────────────────────────────────────────────────
-- ㉛.2 负元的良定义性
-- ─────────────────────────────────────────────────────────────

-- -- 取负尊重相等：把假设搬到两个负元上，再用上一题的形状对齐。
-- soko:hint 目标形态：`ratRel x y → ratRel (ratNegRep x) (ratNegRep y)`。
-- soko:hint 关键件：negRep_mulRep_den · negRep_wd · intRel_trans · Eq.symm。
theorem ratNegRep_wd (x y : ratRep) (h : ratRel x y) :
    ratRel (ratNegRep x) (ratNegRep y) :=
  intRel_trans
    (mulRep (negRep (numOf x)) (den (denOf y)))
    (negRep (mulRep (numOf x) (den (denOf y))))
    (mulRep (negRep (numOf y)) (den (denOf x)))
    (intRel_of_eq
      (mulRep (negRep (numOf x)) (den (denOf y)))
      (negRep (mulRep (numOf x) (den (denOf y))))
      (@Eq.symm.{1} (Prod Nat Nat)
        (negRep (mulRep (numOf x) (den (denOf y))))
        (mulRep (negRep (numOf x)) (den (denOf y)))
        (negRep_mulRep_den (numOf x) (denOf y))))
    (@intRel_trans
      (negRep (mulRep (numOf x) (den (denOf y))))
      (negRep (mulRep (numOf y) (den (denOf x))))
      (mulRep (negRep (numOf y)) (den (denOf x)))
      (negRep_wd (mulRep (numOf x) (den (denOf y)))
                 (mulRep (numOf y) (den (denOf x))) h)
      (intRel_of_eq
        (negRep (mulRep (numOf y) (den (denOf x))))
        (mulRep (negRep (numOf y)) (den (denOf x)))
        (negRep_mulRep_den (numOf y) (denOf x))))

-- ─────────────────────────────────────────────────────────────
-- ㉛.3 对合：-(-x) ~ x
-- ─────────────────────────────────────────────────────────────

-- -- 取负做两次回到原处。
-- soko:hint 目标形态：`ratRel (ratNegRep (ratNegRep x)) x`。
-- soko:hint 关键件：intRel_refl。
theorem ratNegRep_invol (x : ratRep) :
    ratRel (ratNegRep (ratNegRep x)) x :=
  intRel_refl (mulRep (numOf x) (den (denOf x)))

-- ─────────────────────────────────────────────────────────────
-- ㉛.4 具体计算：-(1/2) = (-1)/2
-- ─────────────────────────────────────────────────────────────

-- -- 具体算：-(1/2) = (-1)/2。
-- soko:hint 目标形态：`ratRel (ratNegRep (qrep 1 0 1)) (qrep 0 1 1)`。
-- soko:hint 关键件：ratNegRep 的 ι 归约 · ratRel_refl。
theorem demo_neg_half :
    ratRel (ratNegRep (qrep 1 Nat.zero 1)) (qrep Nat.zero 1 1) :=
  ratRel_refl (qrep Nat.zero 1 1)
