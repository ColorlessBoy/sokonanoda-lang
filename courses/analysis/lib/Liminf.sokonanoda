-- 课程库：序列的下极限
--
-- 上极限把极限点集合压在下面，下极限从另一边托住它：`L` 是极限点集合的
-- 下确界。两个概念互为镜像，唯一的差别是序的方向。
--
-- 与上极限一样，存在性不在这个模块里；这里收关系与比较律。两个界之间还能
-- 比较：只要集合里有一个极限点，下极限就不超过上极限。
--
--   · `Liminf` —— `L` 是 `x` 的极限点集合的下确界；
--   · `liminf_lower` —— `L` 不超过每个极限点；
--   · `liminf_greatest` —— 托住所有极限点的数不超过 `L`；
--   · `le_liminf_iff` —— 把上面两条合成一个充要条件；
--   · `liminf_unique` —— 这样的 `L` 至多一个；
--   · `liminf_of_converges` —— 收敛序列的下极限是它的极限；
--   · `liminf_unique_of_converges` —— 此时任何下极限都与极限相等；
--   · `liminf_const` —— 常序列的下极限是它的值；
--   · `liminf_le_limsup` —— 有一个极限点时，下极限不超过上极限。
--
-- 边界：`liminf_le_limsup` 带非空前提。集合为空时上下确界这两个谓词都
-- 不可满足；要从前提反推出非空，得另证「空集没有下确界」，本模块不展开
-- 这一步。不新增公理。

import lib.Limsup

def Liminf (x : Seq) (L : ratRep) : Prop :=
  IsInf ratRep ratLeRep (LimitPoint x) L

theorem liminf_lower (x : Seq) (L : ratRep) (h : Liminf x L) :
    ∀ (M : ratRep), LimitPoint x M → ratLeRep L M :=
  fun (M : ratRep) (hM : LimitPoint x M) => (And.left h) M hM

theorem liminf_greatest (x : Seq) (L : ratRep) (h : Liminf x L) :
    ∀ (B : ratRep), (∀ (M : ratRep), LimitPoint x M → ratLeRep B M) →
      ratLeRep B L :=
  fun (B : ratRep)
      (hB : ∀ (M : ratRep), LimitPoint x M → ratLeRep B M) =>
    (And.right h) B hB

theorem le_liminf_iff (x : Seq) (L : ratRep) (h : Liminf x L) :
    ∀ (B : ratRep),
      ratLeRep B L ↔
        ∀ (M : ratRep), LimitPoint x M → ratLeRep B M :=
  fun (B : ratRep) =>
    Iff.intro
      (fun (hBL : ratLeRep B L) =>
        fun (M : ratRep) (hM : LimitPoint x M) =>
          ratLeRep_trans B L M hBL ((And.left h) M hM))
      (fun (hB : ∀ (M : ratRep), LimitPoint x M → ratLeRep B M) =>
        (And.right h) B hB)

theorem liminf_unique (x : Seq) (L L' : ratRep)
    (h : Liminf x L) (h' : Liminf x L') : ratRel L L' :=
  ratLeRep_antisymm L L'
    ((And.right h') L (And.left h))
    ((And.right h) L' (And.left h'))

theorem liminf_of_converges (x : Seq) (L : ratRep) (h : Converges x L) :
    Liminf x L :=
  And.intro
    (fun (M : ratRep) (hM : LimitPoint x M) =>
      ratLeRep_of_ratRel L M
        (limitPoint_unique_of_converges x L M h hM))
    (fun (B : ratRep)
        (hB : ∀ (M : ratRep), LimitPoint x M → ratLeRep B M) =>
      hB L (converges_limitPoint x L h))

theorem liminf_unique_of_converges (x : Seq) (L M : ratRep)
    (h : Converges x L) (hM : Liminf x M) : ratRel M L :=
  liminf_unique x M L hM (liminf_of_converges x L h)

theorem liminf_const (q : ratRep) : Liminf (constSeq q) q :=
  liminf_of_converges (constSeq q) q (converges_const q)

theorem liminf_le_limsup (x : Seq) (L M P : ratRep)
    (hL : Liminf x L) (hM : Limsup x M) (hP : LimitPoint x P) :
    ratLeRep L M :=
  ratLeRep_trans L P M ((And.left hL) P hP) ((And.left hM) P hP)
