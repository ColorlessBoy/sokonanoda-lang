-- Rat.sokonanoda —— M2 的 ℚ 算术内核（L2：M1 已交付的构造与法律）
--
-- 来源：M1 单元⑯（整数序）、⑲（取负下降）、㉕（ratRel 传递）、㉖（ℚ 加法）、㉘（ℚ 乘法良定义）的**已判卷解答**。
-- 这不是新内容：M1 的 28 个单元已经把 ℤ/ℚ 的构造教完；M2 的单元需要这些结果作为**可复用的前序事实**，
-- 而课程单元之间不能互相 import（每个单元自包含）。因此把 M1 已交付的算术内核收进 L2 库：
--   · 定义（intRel/Int/addRep/mulRep/ratRep/ratRel/ratAddRep/ratMulRep…）是词汇；
--   · 法律（加法群、乘法交换/结合/分配、序、ratRel 传递、两条 lift 义务）是 M1 的**已教内容**，
--     M2 不再重复出题，只在单元里引用。
-- M2 的新数学内容（绝对值、幂、Cauchy、ℝ、完备性）仍在 units/ 里。
--
-- 记法：本文件全部用点名形式，不引入新记法。

import lib.Logic
import lib.Prod

def intRel (a b : Prod Nat Nat) : Prop :=
  Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b) =
  Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a)


def Int : Type := @Quot.{1} (Prod Nat Nat) intRel


def myMul (a b : Nat) : Nat :=
  Nat.rec (fun (_ : Nat) => Nat) Nat.zero
    (fun (n : Nat) (ih : Nat) => Nat.add a ih) b


def mulRep (a b : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (myMul (Prod.fst Nat Nat a) (Prod.fst Nat Nat b))
             (myMul (Prod.snd Nat Nat a) (Prod.snd Nat Nat b)))
    (Nat.add (myMul (Prod.fst Nat Nat a) (Prod.snd Nat Nat b))
             (myMul (Prod.snd Nat Nat a) (Prod.fst Nat Nat b)))


def ratRep : Type := Prod (Prod Nat Nat) Nat


def den (n : Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat (Nat.succ n) Nat.zero


def ratRel (x y : ratRep) : Prop :=
  intRel
    (mulRep (Prod.fst (Prod Nat Nat) Nat x)
            (den (Prod.snd (Prod Nat Nat) Nat y)))
    (mulRep (Prod.fst (Prod Nat Nat) Nat y)
            (den (Prod.snd (Prod Nat Nat) Nat x)))


def Rat : Type := @Quot.{1} ratRep ratRel


def ratOf (a : Prod Nat Nat) (n : Nat) : Rat :=
  @Quot.mk.{1} ratRep ratRel
    (@prod_mk (Prod Nat Nat) Nat a n)


theorem zero_add (b : Nat) :
    Nat.add Nat.zero b = b :=
  Nat.rec (fun (n : Nat) => Nat.add Nat.zero n = n)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : Nat.add Nat.zero n = n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add Nat.zero n) = Nat.succ m)
        (Nat.add Nat.zero n) n ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add Nat.zero n))))
    b


theorem succ_add (a b : Nat) :
    Nat.add (Nat.succ a) b = Nat.succ (Nat.add a b) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n))
    (@Eq.refl.{1} Nat (Nat.succ a))
    (fun (n : Nat) (ih : Nat.add (Nat.succ a) n = Nat.succ (Nat.add a n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.succ a) n) = Nat.succ m)
        (Nat.add (Nat.succ a) n) (Nat.succ (Nat.add a n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.succ a) n))))
    b


theorem add_comm (a b : Nat) :
    Nat.add a b = Nat.add b a :=
  Nat.rec (fun (n : Nat) => Nat.add a n = Nat.add n a)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero a) a (zero_add a))
    (fun (n : Nat) (ih : Nat.add a n = Nat.add n a) =>
      @Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.succ (Nat.add n a)) (Nat.add (Nat.succ n) a)
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.succ (Nat.add a n) = Nat.succ m)
          (Nat.add a n) (Nat.add n a) ih
          (@Eq.refl.{1} Nat (Nat.succ (Nat.add a n))))
        (@Eq.symm.{1} Nat (Nat.add (Nat.succ n) a) (Nat.succ (Nat.add n a)) (succ_add n a)))
    b


theorem add_zero (a : Nat) :
    Nat.add a Nat.zero = a :=
  @Eq.trans.{1} Nat (Nat.add a Nat.zero) (Nat.add Nat.zero a) a
    (add_comm a Nat.zero)
    (zero_add a)


theorem add_assoc (a b c : Nat) :
    Nat.add (Nat.add a b) c = Nat.add a (Nat.add b c) :=
  Nat.rec (fun (n : Nat) => Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n))
    (@Eq.refl.{1} Nat (Nat.add a b))
    (fun (n : Nat) (ih : Nat.add (Nat.add a b) n = Nat.add a (Nat.add b n)) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.succ (Nat.add (Nat.add a b) n) = Nat.succ m)
        (Nat.add (Nat.add a b) n) (Nat.add a (Nat.add b n)) ih
        (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a b) n))))
    c

-- 搬运律：把两个和里的加法因子换个配对，值不变。


theorem add_shift (a b c d : Nat) :
    Nat.add (Nat.add a c) (Nat.add b d) =
    Nat.add (Nat.add a b) (Nat.add c d) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a c) (Nat.add b d))
    (Nat.add a (Nat.add c (Nat.add b d)))
    (Nat.add (Nat.add a b) (Nat.add c d))
    (add_assoc a c (Nat.add b d))
    (@Eq.trans.{1} Nat
      (Nat.add a (Nat.add c (Nat.add b d)))
      (Nat.add a (Nat.add (Nat.add c b) d))
      (Nat.add (Nat.add a b) (Nat.add c d))
      (@Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add a (Nat.add c (Nat.add b d)) = Nat.add a m)
        (Nat.add c (Nat.add b d)) (Nat.add (Nat.add c b) d)
        (@Eq.symm.{1} Nat (Nat.add (Nat.add c b) d) (Nat.add c (Nat.add b d)) (add_assoc c b d))
        (@Eq.refl.{1} Nat (Nat.add a (Nat.add c (Nat.add b d)))))
      (@Eq.trans.{1} Nat
        (Nat.add a (Nat.add (Nat.add c b) d))
        (Nat.add a (Nat.add (Nat.add b c) d))
        (Nat.add (Nat.add a b) (Nat.add c d))
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.add a (Nat.add (Nat.add c b) d) = Nat.add a (Nat.add m d))
          (Nat.add c b) (Nat.add b c)
          (add_comm c b)
          (@Eq.refl.{1} Nat (Nat.add a (Nat.add (Nat.add c b) d))))
        (@Eq.trans.{1} Nat
          (Nat.add a (Nat.add (Nat.add b c) d))
          (Nat.add a (Nat.add b (Nat.add c d)))
          (Nat.add (Nat.add a b) (Nat.add c d))
          (@Eq.subst.{1} Nat
            (fun (m : Nat) => Nat.add a (Nat.add (Nat.add b c) d) = Nat.add a m)
            (Nat.add (Nat.add b c) d) (Nat.add b (Nat.add c d))
            (add_assoc b c d)
            (@Eq.refl.{1} Nat (Nat.add a (Nat.add (Nat.add b c) d))))
          (@Eq.symm.{1} Nat
            (Nat.add (Nat.add a b) (Nat.add c d))
            (Nat.add a (Nat.add b (Nat.add c d)))
            (add_assoc a b (Nat.add c d))))))


-- 定义性相等：myMul 在第二个参数上递归，base 就是 0。


theorem myMul_zero (a : Nat) :
    myMul a Nat.zero = Nat.zero :=
  Eq.refl Nat.zero

-- 定义性相等：递归步把 myMul a (succ b) 展开成 myAdd a (myMul a b)。


theorem myMul_succ (a b : Nat) :
    myMul a (Nat.succ b) = Nat.add a (myMul a b) :=
  Eq.refl (Nat.add a (myMul a b))


theorem zero_mul (a : Nat) : myMul Nat.zero a = Nat.zero :=
  Nat.rec (fun (n : Nat) => myMul Nat.zero n = Nat.zero)
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat) (ih : myMul Nat.zero n = Nat.zero) =>
      @Eq.trans.{1} Nat (myMul Nat.zero (Nat.succ n)) (Nat.add Nat.zero (myMul Nat.zero n)) Nat.zero
        (@Eq.refl.{1} Nat (Nat.add Nat.zero (myMul Nat.zero n)))
        (@Eq.trans.{1} Nat (Nat.add Nat.zero (myMul Nat.zero n)) (myMul Nat.zero n) Nat.zero
          (zero_add (myMul Nat.zero n)) ih))
    a

-- soko:hint 思路：对 b 归纳。零情形两边都归约成 0；后继情形把左边展开成 (a+1) + myMul (a+1) n，用 ih 把 myMul (a+1) n 换成 a*n + n，再用 succ_add / add_assoc 把两边对到 succ (a + (a*n + n))。
-- soko:hint 目标形态：(a+1) * b = a*b + b。
-- soko:hint 关键件：Nat.rec · Eq.subst（把 ih 换进 add (a+1) 的第二个位置）· succ_add · add_assoc · Eq.refl（add x (succ n) 定义性归约）。


theorem succ_mul (a b : Nat) :
    myMul (Nat.succ a) b = Nat.add (myMul a b) b :=
  Nat.rec (fun (n : Nat) => myMul (Nat.succ a) n = Nat.add (myMul a n) n)
    (@Eq.trans.{1} Nat (myMul (Nat.succ a) Nat.zero) Nat.zero (Nat.add (myMul a Nat.zero) Nat.zero)
      (@Eq.refl.{1} Nat Nat.zero)
      (@Eq.symm.{1} Nat (Nat.add (myMul a Nat.zero) Nat.zero) Nat.zero (add_zero (myMul a Nat.zero))))
    (fun (n : Nat)
         (ih : myMul (Nat.succ a) n = Nat.add (myMul a n) n) =>
      @Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add (Nat.succ a) m =
        Nat.add (Nat.add a (myMul a n)) (Nat.succ n))
        (Nat.add (myMul a n) n) (myMul (Nat.succ a) n)
        (@Eq.symm.{1} Nat (myMul (Nat.succ a) n) (Nat.add (myMul a n) n) ih)
        (@Eq.trans.{1} Nat
          (Nat.add (Nat.succ a) (Nat.add (myMul a n) n))
          (Nat.succ (Nat.add a (Nat.add (myMul a n) n)))
          (Nat.add (Nat.add a (myMul a n)) (Nat.succ n))
          (succ_add a (Nat.add (myMul a n) n))
          (@Eq.trans.{1} Nat
            (Nat.succ (Nat.add a (Nat.add (myMul a n) n)))
            (Nat.succ (Nat.add (Nat.add a (myMul a n)) n))
            (Nat.add (Nat.add a (myMul a n)) (Nat.succ n))
            (congrArg.{1} Nat.succ
              (@Eq.symm.{1} Nat (Nat.add (Nat.add a (myMul a n)) n)
                (Nat.add a (Nat.add (myMul a n) n)) (add_assoc a (myMul a n) n)))
            (@Eq.refl.{1} Nat (Nat.succ (Nat.add (Nat.add a (myMul a n)) n))))))
    b

-- soko:hint 思路：对 b 归纳。零情形用 zero_mul 把两边都变成 0；后继情形 myMul a (n+1) = a + myMul a n，用 ih 换成 a + myMul n a，再用 add_comm 换成 myMul n a + a，最后用 succ_mul 的对称收口。
-- soko:hint 目标形态：myMul a b = myMul b a。
-- soko:hint 关键件：Nat.rec · congrArg（在 add a 下改写 ih）· add_comm · succ_mul（取对称）。


theorem myMul_comm (a b : Nat) :
    myMul a b = myMul b a :=
  Nat.rec (fun (n : Nat) => myMul a n = myMul n a)
    (@Eq.trans.{1} Nat (myMul a Nat.zero) Nat.zero (myMul Nat.zero a)
      (@Eq.refl.{1} Nat Nat.zero)
      (@Eq.symm.{1} Nat (myMul Nat.zero a) Nat.zero (zero_mul a)))
    (fun (n : Nat) (ih : myMul a n = myMul n a) =>
      @Eq.trans.{1} Nat (myMul a (Nat.succ n)) (Nat.add a (myMul a n)) (myMul (Nat.succ n) a)
        (@Eq.refl.{1} Nat (Nat.add a (myMul a n)))
        (@Eq.trans.{1} Nat (Nat.add a (myMul a n)) (Nat.add (myMul n a) a) (myMul (Nat.succ n) a)
          (@Eq.trans.{1} Nat (Nat.add a (myMul a n)) (Nat.add a (myMul n a)) (Nat.add (myMul n a) a)
            (congrArg.{1} (fun (x : Nat) => Nat.add a x) ih)
            (add_comm a (myMul n a)))
          (@Eq.symm.{1} Nat (myMul (Nat.succ n) a) (Nat.add (myMul n a) a) (succ_mul n a))))
    b

-- ─────────────────────────────────────────────────────────────
-- ㉒.1 加法搬运（分配律步例要用）
-- ─────────────────────────────────────────────────────────────


theorem add_mid (a x y : Nat) :
    Nat.add a (Nat.add x y) = Nat.add x (Nat.add a y) :=
  @Eq.trans.{1} Nat
    (Nat.add a (Nat.add x y))
    (Nat.add (Nat.add a x) y)
    (Nat.add x (Nat.add a y))
    (@Eq.symm.{1} Nat (Nat.add (Nat.add a x) y) (Nat.add a (Nat.add x y)) (add_assoc a x y))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add a x) y)
      (Nat.add (Nat.add x a) y)
      (Nat.add x (Nat.add a y))
      (congrArg.{1} (fun (m : Nat) => Nat.add m y) (add_comm a x))
      (add_assoc x a y))

-- ─────────────────────────────────────────────────────────────
-- ㉒.2 左分配律：a * (b + c) = a*b + a*c（对 c 归纳）
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：对 c 归纳。基例 c = 0 时 `b + 0` 定义性等于 b、`a * 0` 定义性等于 0，两边都是 `a*b`，`Eq.refl` 即可；步例把 `a * (b + succ n)` 展开成 `a + a*(b+n)`，用 ih 换成 `a + (a*b + a*n)`，再交给 add_mid 换成 `a*b + (a + a*n)`。
-- soko:hint 目标形态：myMul a (b + c) = myMul a b + myMul a c。
-- soko:hint 关键件：Nat.rec · congrArg（在 add a 下改写 ih）· add_mid · Eq.refl（定义性展开）。


theorem mul_add (a b c : Nat) :
    myMul a (Nat.add b c) = Nat.add (myMul a b) (myMul a c) :=
  Nat.rec (fun (n : Nat) => myMul a (Nat.add b n) = Nat.add (myMul a b) (myMul a n))
    (@Eq.refl.{1} Nat (myMul a b))
    (fun (n : Nat)
         (ih : myMul a (Nat.add b n) = Nat.add (myMul a b) (myMul a n)) =>
      @Eq.trans.{1} Nat
        (myMul a (Nat.add b (Nat.succ n)))
        (Nat.add a (myMul a (Nat.add b n)))
        (Nat.add (myMul a b) (myMul a (Nat.succ n)))
        (@Eq.refl.{1} Nat (Nat.add a (myMul a (Nat.add b n))))
        (@Eq.trans.{1} Nat
          (Nat.add a (myMul a (Nat.add b n)))
          (Nat.add a (Nat.add (myMul a b) (myMul a n)))
          (Nat.add (myMul a b) (myMul a (Nat.succ n)))
          (congrArg.{1} (fun (m : Nat) => Nat.add a m) ih)
          (add_mid a (myMul a b) (myMul a n))))
    c

-- ─────────────────────────────────────────────────────────────
-- ㉒.3 右分配律：(a + b) * c = a*c + b*c
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：把左边用 myMul_comm 翻成 `c * (a+b)`，交给 mul_add 展开，再用两次 myMul_comm（一次对 c a，一次对 c b）把因子顺序摆回来。
-- soko:hint 目标形态：myMul (a + b) c = myMul a c + myMul b c。
-- soko:hint 关键件：myMul_comm · mul_add · congrArg（两次，分别改第一个与第二个加数）· Eq.trans。


theorem mul_add_right (a b c : Nat) :
    myMul (Nat.add a b) c = Nat.add (myMul a c) (myMul b c) :=
  @Eq.trans.{1} Nat
    (myMul (Nat.add a b) c)
    (myMul c (Nat.add a b))
    (Nat.add (myMul a c) (myMul b c))
    (myMul_comm (Nat.add a b) c)
    (@Eq.trans.{1} Nat
      (myMul c (Nat.add a b))
      (Nat.add (myMul c a) (myMul c b))
      (Nat.add (myMul a c) (myMul b c))
      (mul_add c a b)
      (@Eq.trans.{1} Nat
        (Nat.add (myMul c a) (myMul c b))
        (Nat.add (myMul a c) (myMul c b))
        (Nat.add (myMul a c) (myMul b c))
        (congrArg.{1} (fun (m : Nat) => Nat.add m (myMul c b)) (myMul_comm c a))
        (congrArg.{1} (fun (m : Nat) => Nat.add (myMul a c) m) (myMul_comm c b))))

-- ─────────────────────────────────────────────────────────────
-- ㉒.4 结合律：(a * b) * c = a * (b * c)（对 c 归纳）
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：对 c 归纳。基例两边都归约成 0；步例把左边展开成 `(a*b) + (a*b)*n`，用 ih 把第二个加数换成 `a*(b*n)`，右边展开成 `a * (b + b*n)`，交给 mul_add 的对称收口。
-- soko:hint 目标形态：myMul (myMul a b) c = myMul a (myMul b c)。
-- soko:hint 关键件：Nat.rec · congrArg（在 add (a*b) 下改写 ih）· mul_add（取对称）· Eq.refl（定义性展开）。


theorem myMul_assoc (a b c : Nat) :
    myMul (myMul a b) c = myMul a (myMul b c) :=
  Nat.rec (fun (n : Nat) => myMul (myMul a b) n = myMul a (myMul b n))
    (@Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat)
         (ih : myMul (myMul a b) n = myMul a (myMul b n)) =>
      @Eq.trans.{1} Nat
        (myMul (myMul a b) (Nat.succ n))
        (Nat.add (myMul a b) (myMul a (myMul b n)))
        (myMul a (myMul b (Nat.succ n)))
        (congrArg.{1} (fun (m : Nat) => Nat.add (myMul a b) m) ih)
        (@Eq.symm.{1} Nat
          (myMul a (Nat.add b (myMul b n)))
          (Nat.add (myMul a b) (myMul a (myMul b n)))
          (mul_add a b (myMul b n))))
    c

-- ─────────────────────────────────────────────────────────────
-- ─────────────────────────────────────────────────────────────
-- ㉓.1 两个加数同时改写（congrArg 两次装成一个引理）
-- ─────────────────────────────────────────────────────────────

-- ─────────────────────────────────────────────────────────────
-- ㉔.1 加法：`Nat.add a (succ b)` 定义性展开成 `succ (Nat.add a b)`
-- ─────────────────────────────────────────────────────────────


theorem add_succ (a b : Nat) :
    Nat.add a (Nat.succ b) = Nat.succ (Nat.add a b) :=
  Eq.refl (Nat.succ (Nat.add a b))

-- 前驱：`pred (succ n) = n` 是定义性相等；用于从前驱等式换回原等式。


def Nat.pred (n : Nat) : Nat := match n with
| zero => Nat.zero
| succ m => m

-- 本语言没有内建的 `Nat.succ.inj`：对等式两边取前驱即得（定义性相等）。


theorem Nat.succ.inj (a b : Nat) (h : Nat.succ a = Nat.succ b) :
    a = b :=
  congrArg.{1} Nat.pred h

-- 单元⑭的加法消去律，本单元自用（L3：律必须留在单元里）。


theorem nat_add_cancel_right (a b k : Nat) :
    Nat.add a k = Nat.add b k → a = b :=
  Nat.rec
    (fun (n : Nat) => Nat.add a n = Nat.add b n → a = b)
    (fun (h : a = b) => h)
    (fun (n : Nat)
         (ih : Nat.add a n = Nat.add b n → a = b) =>
      fun (h : Nat.succ (Nat.add a n) = Nat.succ (Nat.add b n)) =>
        ih (Nat.succ.inj (Nat.add a n) (Nat.add b n) h))
    k

-- soko:hint 思路：对 `h : succ n = 0` 用 `Eq.subst`，motive 用 `match` 把 0 映成 True、succ 映成 False。先对 h 取对称（0 = succ n），才能把 True.intro 搬到 succ n 上。
-- soko:hint 关键件：Eq.subst / Eq.symm / True.intro / match（本语言支持对 Nat 的模式匹配）。


theorem succ_ne_zero (n : Nat) :
    Nat.succ n = Nat.zero → False :=
  fun (h : Nat.succ n = Nat.zero) =>
    @Eq.subst.{1} Nat
      (fun (m : Nat) =>
        Nat.rec (fun (_ : Nat) => Prop) True (fun (k : Nat) (ih : Prop) => False) m)
      Nat.zero (Nat.succ n)
      (@Eq.symm.{1} Nat (Nat.succ n) Nat.zero h)
      True.intro

-- soko:hint 思路：对 b 归纳。b = 0 时目标就是 0 = 0，Eq.refl；b = succ n 时 `a + succ n` 定义性等于 `succ (a+n)`，用 add_succ 把它写成 succ，再交给 succ_ne_zero 得到 False，最后 False.elim。
-- soko:hint 目标形态：`a + b = 0 → b = 0`。
-- soko:hint 关键件：Nat.rec · add_succ · succ_ne_zero · @False.elim（显式给目标类型）。


theorem add_eq_zero_right (a b : Nat) :
    Nat.add a b = Nat.zero → b = Nat.zero :=
  Nat.rec
    (fun (n : Nat) => Nat.add a n = Nat.zero → n = Nat.zero)
    (fun (h : Nat.add a Nat.zero = Nat.zero) => @Eq.refl.{1} Nat Nat.zero)
    (fun (n : Nat)
         (ih : Nat.add a n = Nat.zero → n = Nat.zero) =>
      fun (h : Nat.add a (Nat.succ n) = Nat.zero) =>
        @False.elim (Nat.succ n = Nat.zero)
          (succ_ne_zero (Nat.add a n) (@Eq.trans.{1} Nat (Nat.succ (Nat.add a n)) (Nat.add a (Nat.succ n)) Nat.zero
            (@Eq.symm.{1} Nat (Nat.add a (Nat.succ n)) (Nat.succ (Nat.add a n)) (add_succ a n)) h)))
    b

-- soko:hint 思路：对 b 归纳。b = 0 时两边都是 0，Eq.refl；b = succ n 时用 succ_mul 把 `(b+1)·(n+1)` 展开成 `b·(n+1) + (n+1)`，交给 add_eq_zero_right 得到 `n+1 = 0`，再用 succ_ne_zero 得到 False。
-- soko:hint 目标形态：`b · (n+1) = 0 → b = 0`。
-- soko:hint 关键件：Nat.rec · succ_mul · add_eq_zero_right · succ_ne_zero · @False.elim。


theorem mul_eq_zero_right (b n : Nat) :
    myMul b (Nat.succ n) = Nat.zero → b = Nat.zero :=
  Nat.rec
    (fun (m : Nat) => myMul m (Nat.succ n) = Nat.zero → m = Nat.zero)
    (fun (h : myMul Nat.zero (Nat.succ n) = Nat.zero) => @Eq.refl.{1} Nat Nat.zero)
    (fun (m : Nat)
         (ih : myMul m (Nat.succ n) = Nat.zero → m = Nat.zero) =>
      fun (h : myMul (Nat.succ m) (Nat.succ n) = Nat.zero) =>
        @False.elim (Nat.succ m = Nat.zero)
          (succ_ne_zero n
            (add_eq_zero_right (myMul m (Nat.succ n)) (Nat.succ n)
              (@Eq.trans.{1} Nat (Nat.add (myMul m (Nat.succ n)) (Nat.succ n)) (myMul (Nat.succ m) (Nat.succ n)) Nat.zero
                (@Eq.symm.{1} Nat (myMul (Nat.succ m) (Nat.succ n)) (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
                  (succ_mul m (Nat.succ n)))
                h))))
    b

-- soko:hint 思路：先证一条「剥掉一层 succ」的辅助引理：两边各用 succ_mul 展开成 `a'·d + d`，再用 nat_add_cancel_right 消去 `+ d`。主定理对 a 归纳；后继情形再对 b 归纳，b = 0 用 mul_eq_zero_right，b = succ b' 用辅助引理把问题降回归纳假设，最后 congrArg succ。
-- soko:hint 目标形态：`a · (n+1) = b · (n+1) → a = b`。
-- soko:hint 关键件：Nat.rec（两层）· succ_mul · nat_add_cancel_right · zero_mul · mul_eq_zero_right · congrArg。


theorem mul_succ_cancel (n m d : Nat)
    (h : myMul (Nat.succ m) (Nat.succ n) = myMul (Nat.succ d) (Nat.succ n)) :
    myMul m (Nat.succ n) = myMul d (Nat.succ n) :=
  nat_add_cancel_right (myMul m (Nat.succ n)) (myMul d (Nat.succ n)) (Nat.succ n)
    (@Eq.trans.{1} Nat
      (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
      (myMul (Nat.succ m) (Nat.succ n))
      (Nat.add (myMul d (Nat.succ n)) (Nat.succ n))
      (@Eq.symm.{1} Nat (myMul (Nat.succ m) (Nat.succ n))
        (Nat.add (myMul m (Nat.succ n)) (Nat.succ n)) (succ_mul m (Nat.succ n)))
      (@Eq.trans.{1} Nat
        (myMul (Nat.succ m) (Nat.succ n))
        (myMul (Nat.succ d) (Nat.succ n))
        (Nat.add (myMul d (Nat.succ n)) (Nat.succ n))
        h (succ_mul d (Nat.succ n))))


theorem mul_cancel_succ_step (n m : Nat)
    (ih : ∀ (c : Nat),
      myMul m (Nat.succ n) = myMul c (Nat.succ n) →
      m = c)
    (c : Nat) :
    myMul (Nat.succ m) (Nat.succ n) = myMul c (Nat.succ n) →
    Nat.succ m = c :=
  Nat.rec
    (fun (d : Nat) =>
      myMul (Nat.succ m) (Nat.succ n) = myMul d (Nat.succ n) →
      Nat.succ m = d)
    (fun (h : myMul (Nat.succ m) (Nat.succ n) = myMul Nat.zero (Nat.succ n)) =>
      mul_eq_zero_right (Nat.succ m) n
        (@Eq.subst.{1} Nat
          (fun (x : Nat) => myMul (Nat.succ m) (Nat.succ n) = x)
          (myMul Nat.zero (Nat.succ n)) Nat.zero
          (zero_mul (Nat.succ n)) h))
    (fun (d : Nat) (_ : myMul (Nat.succ m) (Nat.succ n) = myMul d (Nat.succ n) →
        Nat.succ m = d) =>
      fun (h : myMul (Nat.succ m) (Nat.succ n) = myMul (Nat.succ d) (Nat.succ n)) =>
        congrArg.{1} Nat.succ (ih d (mul_succ_cancel n m d h)))
    c


theorem mul_zero_eq (n c : Nat)
    (h : myMul Nat.zero (Nat.succ n) = myMul c (Nat.succ n)) :
    myMul c (Nat.succ n) = Nat.zero :=
  @Eq.symm.{1} Nat Nat.zero (myMul c (Nat.succ n))
    (@Eq.subst.{1} Nat
      (fun (x : Nat) => x = myMul c (Nat.succ n))
      (myMul Nat.zero (Nat.succ n)) Nat.zero
      (zero_mul (Nat.succ n)) h)


theorem mul_cancel_pos (n a b : Nat) :
    myMul a (Nat.succ n) = myMul b (Nat.succ n) →
    a = b :=
  Nat.rec
    (fun (m : Nat) => ∀ (c : Nat),
      myMul m (Nat.succ n) = myMul c (Nat.succ n) →
      m = c)
    (fun (c : Nat) (h : myMul Nat.zero (Nat.succ n) = myMul c (Nat.succ n)) =>
      @Eq.symm.{1} Nat c Nat.zero
        (mul_eq_zero_right c n (mul_zero_eq n c h)))
    (fun (m : Nat) (ih : ∀ (c : Nat),
        myMul m (Nat.succ n) = myMul c (Nat.succ n) →
        m = c) =>
      fun (c : Nat) =>
        mul_cancel_succ_step n m ih c)
    a
    b


theorem add_congr {a a' b b' : Nat}
    (h1 : a = a') (h2 : b = b') :
    Nat.add a b = Nat.add a' b' :=
  @Eq.trans.{1} Nat (Nat.add a b) (Nat.add a' b) (Nat.add a' b')
    (congrArg.{1} (fun (x : Nat) => Nat.add x b) h1)
    (congrArg.{1} (fun (y : Nat) => Nat.add a' y) h2)


theorem add_rotate (a k j : Nat) :
    Nat.add (Nat.add a k) j = Nat.add (Nat.add a j) k :=
  @Eq.trans.{1} Nat (Nat.add (Nat.add a k) j) (Nat.add a (Nat.add k j)) (Nat.add (Nat.add a j) k)
    (add_assoc a k j)
    (@Eq.trans.{1} Nat (Nat.add a (Nat.add k j)) (Nat.add a (Nat.add j k)) (Nat.add (Nat.add a j) k)
      (congrArg.{1} (fun (x : Nat) => Nat.add a x) (add_comm k j))
      (@Eq.symm.{1} Nat (Nat.add (Nat.add a j) k) (Nat.add a (Nat.add j k)) (add_assoc a j k)))

-- 前驱：`pred (succ n) = n` 是定义性相等；用于从前驱等式换回原等式。


theorem intRel_trans_mid (a b c d e f : Nat)
    (h1 : Nat.add a d = Nat.add c b)
    (h2 : Nat.add c f = Nat.add e d) :
    Nat.add (Nat.add a d) f = Nat.add (Nat.add e d) b :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a d) f)
    (Nat.add (Nat.add c b) f)
    (Nat.add (Nat.add e d) b)
    (congrArg.{1} (fun (x : Nat) => Nat.add x f) h1)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add c b) f)
      (Nat.add (Nat.add c f) b)
      (Nat.add (Nat.add e d) b)
      (add_rotate c b f)
      (congrArg.{1} (fun (x : Nat) => Nat.add x b) h2))



theorem intRel_trans (p q r : Prod Nat Nat)
    (h1 : intRel p q) (h2 : intRel q r) : intRel p r :=
  nat_add_cancel_right
    (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat r))
    (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat p))
    (Prod.snd Nat Nat q)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat r)) (Prod.snd Nat Nat q))
      (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat r))
      (Nat.add (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat p)) (Prod.snd Nat Nat q))
      (@Eq.symm.{1} Nat
        (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat r))
        (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat r)) (Prod.snd Nat Nat q))
        (add_rotate (Prod.fst Nat Nat p) (Prod.snd Nat Nat q) (Prod.snd Nat Nat r)))
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat r))
        (Nat.add (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat q)) (Prod.snd Nat Nat p))
        (Nat.add (Nat.add (Prod.fst Nat Nat r) (Prod.snd Nat Nat p)) (Prod.snd Nat Nat q))
        (intRel_trans_mid
          (Prod.fst Nat Nat p) (Prod.snd Nat Nat p)
          (Prod.fst Nat Nat q) (Prod.snd Nat Nat q)
          (Prod.fst Nat Nat r) (Prod.snd Nat Nat r) h1 h2)
        (add_rotate (Prod.fst Nat Nat r) (Prod.snd Nat Nat q) (Prod.snd Nat Nat p))))


theorem mul_congr (a b a' b' c : Nat)
    (h : Nat.add a b' = Nat.add a' b) :
    myMul (Nat.add a b') c = myMul (Nat.add a' b) c :=
  @Eq.subst.{1} Nat
    (fun (x : Nat) => myMul (Nat.add a b') c = myMul x c)
    (Nat.add a b') (Nat.add a' b) h
    (@Eq.refl.{1} Nat (myMul (Nat.add a b') c))

-- h 乘开：a·c + b'·c = a'·c + b·c。


theorem mul_shift_c (a b a' b' c : Nat)
    (h : Nat.add a b' = Nat.add a' b) :
    Nat.add (myMul a c) (myMul b' c) =
    Nat.add (myMul a' c) (myMul b c) :=
  @Eq.trans.{1} Nat
    (Nat.add (myMul a c) (myMul b' c))
    (myMul (Nat.add a b') c)
    (Nat.add (myMul a' c) (myMul b c))
    (@Eq.symm.{1} Nat
      (myMul (Nat.add a b') c)
      (Nat.add (myMul a c) (myMul b' c))
      (mul_add_right a b' c))
    (@Eq.trans.{1} Nat
      (myMul (Nat.add a b') c)
      (myMul (Nat.add a' b) c)
      (Nat.add (myMul a' c) (myMul b c))
      (mul_congr a b a' b' c h)
      (mul_add_right a' b c))


theorem intRel_symm (a b : Prod Nat Nat)
    (h : intRel a b) : intRel b a :=
  @Eq.symm.{1} Nat
    (Nat.add (Prod.fst Nat Nat a) (Prod.snd Nat Nat b))
    (Nat.add (Prod.fst Nat Nat b) (Prod.snd Nat Nat a))
    h


theorem mulRep_den (p : Prod Nat Nat) (n : Nat) :
    intRel (mulRep p (den n))
      (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat p) (Nat.succ n))
                        (myMul (Prod.snd Nat Nat p) (Nat.succ n))) :=
  congrArg.{1} (fun (x : Nat) =>
      Nat.add (myMul (Prod.fst Nat Nat p) (Nat.succ n)) x)
    (@Eq.symm.{1} Nat (Nat.add Nat.zero (myMul (Prod.snd Nat Nat p) (Nat.succ n)))
      (myMul (Prod.snd Nat Nat p) (Nat.succ n))
      (zero_add (myMul (Prod.snd Nat Nat p) (Nat.succ n))))


-- 把「两边都乘上同一正分母」的等价假设化成一条 ℕ 加法等式。


theorem mulRep_den_mid (u v : Prod Nat Nat) (n : Nat)
    (h : intRel (mulRep u (den n)) (mulRep v (den n))) :
    Nat.add (myMul (Prod.fst Nat Nat u) (Nat.succ n))
               (myMul (Prod.snd Nat Nat v) (Nat.succ n)) =
      Nat.add (myMul (Prod.fst Nat Nat v) (Nat.succ n))
               (myMul (Prod.snd Nat Nat u) (Nat.succ n)) :=
  intRel_trans
    (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat u) (Nat.succ n))
                        (myMul (Prod.snd Nat Nat u) (Nat.succ n)))
    (mulRep u (den n))
    (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat v) (Nat.succ n))
                        (myMul (Prod.snd Nat Nat v) (Nat.succ n)))
    (intRel_symm (mulRep u (den n))
      (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat u) (Nat.succ n))
                          (myMul (Prod.snd Nat Nat u) (Nat.succ n)))
      (mulRep_den u n))
    (intRel_trans (mulRep u (den n)) (mulRep v (den n))
      (@prod_mk Nat Nat (myMul (Prod.fst Nat Nat v) (Nat.succ n))
                          (myMul (Prod.snd Nat Nat v) (Nat.succ n)))
      h (mulRep_den v n))

-- 正分母可消去：mulRep u (n+1,0) ~ mulRep v (n+1,0) ⇒ u ~ v。
-- soko:hint 思路：先把 `mulRep u (den n)` 与 `mulRep v (den n)` 化到规范形 `(u1·d, u2·d)`、`(v1·d, v2·d)`（`d = n+1`），假设就变成 `u1·d + v2·d = v1·d + u2·d`；两边分别用 `mul_add_right` 收成 `(u1+v2)·d` 与 `(v1+u2)·d`，最后用 `mul_cancel_pos` 消去正因子 `d`。
-- soko:hint 目标形态：mulRep u (den n) ~ mulRep v (den n) ⇒ u ~ v。


theorem intRel_refl (p : Prod Nat Nat) : intRel p p :=
  Eq.refl (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat p))


-- ─────────────────────────────────────────────────────────────
-- ㉖.1 公分母：`succ (m*n + m + n) = (m+1)(n+1)`
-- ─────────────────────────────────────────────────────────────

-- `ratRep` 的分母字段是「`succ` 编码」：真正的分母 = 字段 + 1。两个有理数
-- 相加时公分母是 `(m+1)(n+1)`，所以结果的分母字段取 `m*n + m + n`。


def ratDenRep (m n : Nat) : Nat :=
  Nat.add (Nat.add (myMul m n) m) n

-- 把有理数写成「分子序对 + 分母字段」的规范形状（只为本单元的陈述好读）。


def qrep (a b m : Nat) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat a b) m

-- soko:hint 思路：左边 `succ (m*n + m + n)` 定义性等于 `(m*n + m) + (n+1)`；右边用 `succ_mul` 展开成 `m*(n+1) + (n+1)`，再用 `mul_add` 把 `m*(n+1)` 拆成 `m*n + m*1`（`m*1` 定义性归约成 `m`）。
-- soko:hint 目标形态：succ (m*n + m + n) = (m+1)*(n+1)。
-- soko:hint 关键件：congrArg · mul_add · succ_mul（取对称）· Eq.refl（定义性归约）。


theorem ratDenRep_succ (m n : Nat) :
    Nat.succ (ratDenRep m n) = myMul (Nat.succ m) (Nat.succ n) :=
  @Eq.trans.{1} Nat
    (Nat.succ (ratDenRep m n))
    (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
    (myMul (Nat.succ m) (Nat.succ n))
    (@Eq.symm.{1} Nat
      (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
      (Nat.succ (ratDenRep m n))
      (congrArg.{1} (fun (x : Nat) => Nat.add x (Nat.succ n))
        (mul_add m n (Nat.succ Nat.zero))))
    (@Eq.symm.{1} Nat
      (myMul (Nat.succ m) (Nat.succ n))
      (Nat.add (myMul m (Nat.succ n)) (Nat.succ n))
      (succ_mul m (Nat.succ n)))

-- ─────────────────────────────────────────────────────────────
-- ㉖.2 加法的代表元公式
-- ─────────────────────────────────────────────────────────────

-- (a-b)/(m+1) + (c-d)/(n+1)
--   = [(a(n+1) + c(m+1)) - (b(n+1) + d(m+1))] / ((m+1)(n+1))
-- 分母字段就是 ㉖.1 的 `ratDenRep m n`。


def numOf (x : ratRep) : Prod Nat Nat :=
  Prod.fst (Prod Nat Nat) Nat x


def denOf (x : ratRep) : Nat :=
  Prod.snd (Prod Nat Nat) Nat x


def T1 (a c e : Nat) : Nat := myMul a (myMul c e)


def T2 (b d e : Nat) : Nat := myMul b (myMul d e)


def T3 (a d f : Nat) : Nat := myMul a (myMul d f)


def T4 (b c f : Nat) : Nat := myMul b (myMul c f)


def T5 (a c f : Nat) : Nat := myMul a (myMul c f)


def T6 (a d e : Nat) : Nat := myMul a (myMul d e)


def T7 (b c e : Nat) : Nat := myMul b (myMul c e)


def T8 (b d f : Nat) : Nat := myMul b (myMul d f)

-- ─────────────────────────────────────────────────────────────
-- ㉓.2 第一个分量：两边各自展开，再在规范形上换配对
-- ─────────────────────────────────────────────────────────────

-- 左边：((a*c + b*d)*e + (a*d + b*c)*f) 展开成四个乘积。


theorem fst_expand_left (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) e)
               (myMul (Nat.add (myMul a d) (myMul b c)) f) =
      Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
               (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)) :=
  add_congr
    (mul_add_right (myMul a c) (myMul b d) e)
    (mul_add_right (myMul a d) (myMul b c) f)

-- 右边：a*(c*e + d*f) + b*(c*f + d*e) 展开成四个乘积。


theorem fst_expand_right (a b c d e f : Nat) :
    Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
               (myMul b (Nat.add (myMul c f) (myMul d e))) =
      Nat.add (Nat.add (T1 a c e) (T3 a d f))
               (Nat.add (T4 b c f) (T2 b d e)) :=
  add_congr
    (mul_add a (myMul c e) (myMul d f))
    (mul_add b (myMul c f) (myMul d e))

-- 左边四个乘积用结合律改成规范形。


theorem fst_normalize (a b c d e f : Nat) :
    Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
               (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)) =
      Nat.add (Nat.add (T1 a c e) (T2 b d e))
               (Nat.add (T3 a d f) (T4 b c f)) :=
  add_congr
    (add_congr (myMul_assoc a c e) (myMul_assoc b d e))
    (add_congr (myMul_assoc a d f) (myMul_assoc b c f))

-- 规范形上换一次配对：add_shift 把中间两个加数对调，
-- 再用 add_comm 把第四个与第二个加数对调。


theorem fst_shift (a b c d e f : Nat) :
    Nat.add (Nat.add (T1 a c e) (T2 b d e))
               (Nat.add (T3 a d f) (T4 b c f)) =
      Nat.add (Nat.add (T1 a c e) (T3 a d f))
               (Nat.add (T4 b c f) (T2 b d e)) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add (T1 a c e) (T2 b d e))
             (Nat.add (T3 a d f) (T4 b c f)))
    (Nat.add (Nat.add (T1 a c e) (T3 a d f))
             (Nat.add (T2 b d e) (T4 b c f)))
    (Nat.add (Nat.add (T1 a c e) (T3 a d f))
             (Nat.add (T4 b c f) (T2 b d e)))
    (Eq.symm (add_shift (T1 a c e) (T2 b d e) (T3 a d f) (T4 b c f)))
    (add_congr (Eq.refl (Nat.add (T1 a c e) (T3 a d f)))
               (add_comm (T2 b d e) (T4 b c f)))

-- ─────────────────────────────────────────────────────────────
-- ㉓.3 第二个分量：同样的四步，只是 b/d 与 a/c 的角色换了位置
-- ─────────────────────────────────────────────────────────────


theorem snd_expand_left (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) f)
               (myMul (Nat.add (myMul a d) (myMul b c)) e) =
      Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
               (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)) :=
  add_congr
    (mul_add_right (myMul a c) (myMul b d) f)
    (mul_add_right (myMul a d) (myMul b c) e)


theorem snd_expand_right (a b c d e f : Nat) :
    Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
               (myMul b (Nat.add (myMul c e) (myMul d f))) =
      Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T7 b c e) (T8 b d f)) :=
  add_congr
    (mul_add a (myMul c f) (myMul d e))
    (mul_add b (myMul c e) (myMul d f))


theorem snd_normalize (a b c d e f : Nat) :
    Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
               (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)) =
      Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)) :=
  add_congr
    (add_congr (myMul_assoc a c f) (myMul_assoc b d f))
    (add_congr (myMul_assoc a d e) (myMul_assoc b c e))


theorem snd_shift (a b c d e f : Nat) :
    Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)) =
      Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T7 b c e) (T8 b d f)) :=
  Eq.symm
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T7 b c e) (T8 b d f)))
      (Nat.add (Nat.add (T5 a c f) (T6 a d e))
               (Nat.add (T8 b d f) (T7 b c e)))
      (Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)))
      (add_congr (Eq.refl (Nat.add (T5 a c f) (T6 a d e)))
                 (add_comm (T7 b c e) (T8 b d f)))
      (add_shift (T5 a c f) (T8 b d f) (T6 a d e) (T7 b c e)))

-- ─────────────────────────────────────────────────────────────
-- ㉓.4 两个分量的等式
-- ─────────────────────────────────────────────────────────────


theorem mulRep_assoc_fst (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) e)
               (myMul (Nat.add (myMul a d) (myMul b c)) f) =
      Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
               (myMul b (Nat.add (myMul c f) (myMul d e))) :=
  @Eq.trans.{1} Nat
    (Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) e)
             (myMul (Nat.add (myMul a d) (myMul b c)) f))
    (Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
             (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)))
    (Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
             (myMul b (Nat.add (myMul c f) (myMul d e))))
    (fst_expand_left a b c d e f)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul (myMul a c) e) (myMul (myMul b d) e))
               (Nat.add (myMul (myMul a d) f) (myMul (myMul b c) f)))
      (Nat.add (Nat.add (T1 a c e) (T2 b d e))
               (Nat.add (T3 a d f) (T4 b c f)))
      (Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
               (myMul b (Nat.add (myMul c f) (myMul d e))))
      (fst_normalize a b c d e f)
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (T1 a c e) (T2 b d e))
                 (Nat.add (T3 a d f) (T4 b c f)))
        (Nat.add (Nat.add (T1 a c e) (T3 a d f))
                 (Nat.add (T4 b c f) (T2 b d e)))
        (Nat.add (myMul a (Nat.add (myMul c e) (myMul d f)))
                 (myMul b (Nat.add (myMul c f) (myMul d e))))
        (fst_shift a b c d e f)
        (Eq.symm (fst_expand_right a b c d e f))))


theorem mulRep_assoc_snd (a b c d e f : Nat) :
    Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) f)
               (myMul (Nat.add (myMul a d) (myMul b c)) e) =
      Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
               (myMul b (Nat.add (myMul c e) (myMul d f))) :=
  @Eq.trans.{1} Nat
    (Nat.add (myMul (Nat.add (myMul a c) (myMul b d)) f)
             (myMul (Nat.add (myMul a d) (myMul b c)) e))
    (Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
             (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)))
    (Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
             (myMul b (Nat.add (myMul c e) (myMul d f))))
    (snd_expand_left a b c d e f)
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul (myMul a c) f) (myMul (myMul b d) f))
               (Nat.add (myMul (myMul a d) e) (myMul (myMul b c) e)))
      (Nat.add (Nat.add (T5 a c f) (T8 b d f))
               (Nat.add (T6 a d e) (T7 b c e)))
      (Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
               (myMul b (Nat.add (myMul c e) (myMul d f))))
      (snd_normalize a b c d e f)
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (T5 a c f) (T8 b d f))
                 (Nat.add (T6 a d e) (T7 b c e)))
        (Nat.add (Nat.add (T5 a c f) (T6 a d e))
                 (Nat.add (T7 b c e) (T8 b d f)))
        (Nat.add (myMul a (Nat.add (myMul c f) (myMul d e)))
                 (myMul b (Nat.add (myMul c e) (myMul d f))))
        (snd_shift a b c d e f)
        (Eq.symm (snd_expand_right a b c d e f))))

-- ─────────────────────────────────────────────────────────────
-- ㉓.5 拼成 intRel：fst(left) + snd(right) = fst(right) + snd(left)
-- ─────────────────────────────────────────────────────────────


theorem mulRep_assoc (a b c d e f : Nat) :
    intRel
      (mulRep (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
              (@prod_mk Nat Nat e f))
      (mulRep (@prod_mk Nat Nat a b)
              (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f))) :=
  add_congr
    (mulRep_assoc_fst a b c d e f)
    (Eq.symm (mulRep_assoc_snd a b c d e f))

-- 具体数字上走一遍：(2,1)*(3,1) 得 (7,5)，再乘 (4,1)；
-- 与 2 先乘 ((3,1)*(4,1)) 的结果代表元相等。


theorem mulRep_comm (a b c d : Nat) :
    mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
      mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b) :=
  @Eq.trans.{1} (Prod Nat Nat)
    (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
    (@prod_mk Nat Nat
      (Nat.add (myMul c a) (myMul d b))
      (Nat.add (myMul a d) (myMul b c)))
    (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
    (congrArg.{1}
      (fun (x : Nat) => @prod_mk Nat Nat x (Nat.add (myMul a d) (myMul b c)))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a c) (myMul b d))
        (Nat.add (myMul c a) (myMul b d))
        (Nat.add (myMul c a) (myMul d b))
        (congrArg.{1} (fun (x : Nat) => Nat.add x (myMul b d)) (myMul_comm a c))
        (congrArg.{1} (fun (y : Nat) => Nat.add (myMul c a) y) (myMul_comm b d))))
    (congrArg.{1}
      (fun (y : Nat) => @prod_mk Nat Nat (Nat.add (myMul c a) (myMul d b)) y)
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a d) (myMul b c))
        (Nat.add (myMul d a) (myMul c b))
        (Nat.add (myMul c b) (myMul d a))
        (@Eq.trans.{1} Nat
          (Nat.add (myMul a d) (myMul b c))
          (Nat.add (myMul d a) (myMul b c))
          (Nat.add (myMul d a) (myMul c b))
          (congrArg.{1} (fun (x : Nat) => Nat.add x (myMul b c)) (myMul_comm a d))
          (congrArg.{1} (fun (y : Nat) => Nat.add (myMul d a) y) (myMul_comm b c)))
        (add_comm (myMul d a) (myMul c b))))


theorem mulRep_wd (a b a' b' c d : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b')) :
    intRel (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
           (mulRep (@prod_mk Nat Nat a' b') (@prod_mk Nat Nat c d)) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add (myMul a c) (myMul b d))
             (Nat.add (myMul a' d) (myMul b' c)))
    (Nat.add (Nat.add (myMul a c) (myMul b' c))
             (Nat.add (myMul b d) (myMul a' d)))
    (Nat.add (Nat.add (myMul a' c) (myMul b' d))
             (Nat.add (myMul a d) (myMul b c)))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul a c) (myMul b d))
               (Nat.add (myMul a' d) (myMul b' c)))
      (Nat.add (Nat.add (myMul a c) (myMul b d))
               (Nat.add (myMul b' c) (myMul a' d)))
      (Nat.add (Nat.add (myMul a c) (myMul b' c))
               (Nat.add (myMul b d) (myMul a' d)))
      (@Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add (Nat.add (myMul a c) (myMul b d)) (Nat.add (myMul a' d) (myMul b' c)) =
          Nat.add (Nat.add (myMul a c) (myMul b d)) m)
        (Nat.add (myMul a' d) (myMul b' c))
        (Nat.add (myMul b' c) (myMul a' d))
        (add_comm (myMul a' d) (myMul b' c))
        (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a c) (myMul b d)) (Nat.add (myMul a' d) (myMul b' c)))))
      (add_shift (myMul a c) (myMul b' c) (myMul b d) (myMul a' d)))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add (myMul a c) (myMul b' c))
               (Nat.add (myMul b d) (myMul a' d)))
      (Nat.add (Nat.add (myMul a' c) (myMul b c))
               (Nat.add (myMul b d) (myMul a' d)))
      (Nat.add (Nat.add (myMul a' c) (myMul b' d))
               (Nat.add (myMul a d) (myMul b c)))
      (@Eq.subst.{1} Nat
        (fun (m : Nat) => Nat.add (Nat.add (myMul a c) (myMul b' c)) (Nat.add (myMul b d) (myMul a' d)) =
          Nat.add m (Nat.add (myMul b d) (myMul a' d)))
        (Nat.add (myMul a c) (myMul b' c))
        (Nat.add (myMul a' c) (myMul b c))
        (mul_shift_c a b a' b' c h)
        (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a c) (myMul b' c)) (Nat.add (myMul b d) (myMul a' d)))))
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add (myMul a' c) (myMul b c))
                 (Nat.add (myMul b d) (myMul a' d)))
        (Nat.add (Nat.add (myMul a' c) (myMul b c))
                 (Nat.add (myMul b' d) (myMul a d)))
        (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                 (Nat.add (myMul a d) (myMul b c)))
        (@Eq.subst.{1} Nat
          (fun (m : Nat) => Nat.add (Nat.add (myMul a' c) (myMul b c)) (Nat.add (myMul b d) (myMul a' d)) =
            Nat.add (Nat.add (myMul a' c) (myMul b c)) m)
          (Nat.add (myMul b d) (myMul a' d))
          (Nat.add (myMul b' d) (myMul a d))
          (@Eq.trans.{1} Nat
            (Nat.add (myMul b d) (myMul a' d))
            (Nat.add (myMul a' d) (myMul b d))
            (Nat.add (myMul b' d) (myMul a d))
            (add_comm (myMul b d) (myMul a' d))
            (@Eq.trans.{1} Nat
              (Nat.add (myMul a' d) (myMul b d))
              (Nat.add (myMul a d) (myMul b' d))
              (Nat.add (myMul b' d) (myMul a d))
              (@Eq.symm.{1} Nat
                (Nat.add (myMul a d) (myMul b' d))
                (Nat.add (myMul a' d) (myMul b d))
                (mul_shift_c a b a' b' d h))
              (add_comm (myMul a d) (myMul b' d))))
          (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a' c) (myMul b c)) (Nat.add (myMul b d) (myMul a' d)))))
        (@Eq.trans.{1} Nat
          (Nat.add (Nat.add (myMul a' c) (myMul b c))
                   (Nat.add (myMul b' d) (myMul a d)))
          (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                   (Nat.add (myMul b c) (myMul a d)))
          (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                   (Nat.add (myMul a d) (myMul b c)))
          (@Eq.symm.{1} Nat
            (Nat.add (Nat.add (myMul a' c) (myMul b' d))
                     (Nat.add (myMul b c) (myMul a d)))
            (Nat.add (Nat.add (myMul a' c) (myMul b c))
                     (Nat.add (myMul b' d) (myMul a d)))
            (add_shift (myMul a' c) (myMul b c) (myMul b' d) (myMul a d)))
          (@Eq.subst.{1} Nat
            (fun (m : Nat) => Nat.add (Nat.add (myMul a' c) (myMul b' d)) (Nat.add (myMul b c) (myMul a d)) =
              Nat.add (Nat.add (myMul a' c) (myMul b' d)) m)
            (Nat.add (myMul b c) (myMul a d))
            (Nat.add (myMul a d) (myMul b c))
            (add_comm (myMul b c) (myMul a d))
            (@Eq.refl.{1} Nat (Nat.add (Nat.add (myMul a' c) (myMul b' d)) (Nat.add (myMul b c) (myMul a d))))))))

-- ─────────────────────────────────────────────────────────────

theorem mulRep_wd_snd (a b a' b' c d : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b')) :
    intRel (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
           (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a' b')) :=
  @Eq.subst.{1} (Prod Nat Nat)
    (fun (y : Prod Nat Nat) =>
      intRel (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b)) y)
    (mulRep (@prod_mk Nat Nat a' b') (@prod_mk Nat Nat c d))
    (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a' b'))
    (mulRep_comm a' b' c d)
    (@Eq.subst.{1} (Prod Nat Nat)
      (fun (x : Prod Nat Nat) =>
        intRel x (mulRep (@prod_mk Nat Nat a' b') (@prod_mk Nat Nat c d)))
      (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
      (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
      (@Eq.symm.{1} (Prod Nat Nat)
        (mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b))
        (mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
        (mulRep_comm c d a b))
      (mulRep_wd a b a' b' c d h))

-- 演示：具体数字上走一遍 —— (2-0) ~ (3-1)，都用 (4-1) 乘在前面，结果仍等价。
-- (4,1)*(2,0) = (8,2)，(4,1)*(3,1) = (13,7)，而 8+7 = 13+2 = 15。

-- den 乘法的规范形：mulRep p (n+1,0) 与 (p1·(n+1), p2·(n+1)) 差相等。
-- soko:hint 思路：`mulRep p (n+1,0)` 的定义性展开是 `(p1·(n+1) + p2·0, p1·0 + p2·(n+1))`；把 `p2·0` 与 `p1·0` 归约成 0，再用 `zero_add` 把右边第二分量的 `0 + p2·(n+1)` 搬到 `p2·(n+1)`。
-- soko:hint 目标形态：mulRep p (den n) ~ (p1·(n+1), p2·(n+1))。
-- soko:hint 关键件：congrArg · Eq.symm · zero_add（乘零由定义性归约）。


-- ─────────────────────────────────────────────────────────────
-- ㉗.1 乘法的代表元公式
-- ─────────────────────────────────────────────────────────────

-- (a-b)/(m+1) * (c-d)/(n+1)
--   = [(ac + bd) - (ad + bc)] / ((m+1)(n+1))
-- 分子正是整数代表元的乘法 `mulRep`；分母字段仍用 ㉖.1 的 `ratDenRep m n`。


def ratMulRep (x y : ratRep) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat
    (mulRep (numOf x) (numOf y))
    (ratDenRep (denOf x) (denOf y))


theorem ratMulRep_mk (a b c d m n : Nat) :
    ratMulRep (qrep a b m) (qrep c d n) =
      qrep
        (Nat.add (myMul a c) (myMul b d))
        (Nat.add (myMul a d) (myMul b c))
        (ratDenRep m n) :=
  Eq.refl (qrep
    (Nat.add (myMul a c) (myMul b d))
    (Nat.add (myMul a d) (myMul b c))
    (ratDenRep m n))

-- soko:hint 思路：`ratMulRep` 的分母字段就是 `ratDenRep (denOf x) (denOf y)`，定义性相等。
-- soko:hint 目标形态：denOf (x*y) = ratDenRep (denOf x) (denOf y)。
-- soko:hint 关键件：Eq.refl（定义性归约）。

theorem ratMul_den (x y : ratRep) :
    denOf (ratMulRep x y) =
    ratDenRep (denOf x) (denOf y) :=
  Eq.refl (ratDenRep (denOf x) (denOf y))

-- soko:hint 思路：两个整数代表元相乘可以交换，直接引用整数层的 `mulRep_comm`。
-- soko:hint 目标形态：mulRep (a,b) (c,d) = mulRep (c,d) (a,b)。
-- soko:hint 关键件：mulRep_comm。

theorem ratMul_num_comm (a b c d : Nat) :
    mulRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
      mulRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat a b) :=
  mulRep_comm a b c d

-- ─────────────────────────────────────────────────────────────
-- ㉗.2 具体数字
-- ─────────────────────────────────────────────────────────────

-- 1/2 * 1/3：分子 (1·1 + 0·0, 1·0 + 0·1) = (1,0)，分母字段 1·2+1+2 = 5
-- （真正分母 6），正是 1/6。

-- soko:hint 思路：两边化到代表元后是同一个具体数字，全部由内核归约，`Eq.refl` 即可。
-- soko:hint 目标形态：(1/2 * 1/3) ~ 1/6。
-- soko:hint 关键件：Eq.refl。

theorem ratMul_demo_one :
    ratRel
      (ratMulRep (qrep 1 0 1) (qrep 1 0 2))
      (qrep 1 0 5) :=
  @Eq.refl.{1} Nat 6

-- 1/2 * 2/3 = 2/6 = 1/3：左边分子 (2,0)、分母字段 5；交叉相乘 2·3 = 1·6。

-- soko:hint 思路：左边代表元分子 2、分母字段 5，右边 1/3；交叉和 2·3 = 1·6 = 6，`Eq.refl`。
-- soko:hint 目标形态：(1/2 * 2/3) ~ 1/3。
-- soko:hint 关键件：Eq.refl。

theorem ratMul_demo_two :
    ratRel
      (ratMulRep (qrep 1 0 1) (qrep 2 0 2))
      (qrep 1 0 2) :=
  @Eq.refl.{1} Nat 6

-- 2/3 * 3/4 = 6/12 = 1/2：分子 6、分母字段 11。

-- soko:hint 思路：左边 6/12，右边 1/2；交叉和 6·2 = 1·12 = 12，`Eq.refl`。
-- soko:hint 目标形态：(2/3 * 3/4) ~ 1/2。
-- soko:hint 关键件：Eq.refl。

theorem ratMul_demo_three :
    ratRel
      (ratMulRep (qrep 2 0 2) (qrep 3 0 3))
      (qrep 1 0 1) :=
  @Eq.refl.{1} Nat 12

-- 同分母的 `ratRel` 可以消去正分母：`(a-b)/(m+1) ~ (a'-b')/(m+1)` 就是
-- `a + b' = a' + b`。乘法两条义务都要先把假设化成这个形状。


theorem rat_cross (a b a' b' : Nat) (m : Nat)
    (h : intRel (mulRep (@prod_mk Nat Nat a b) (den m))
                (mulRep (@prod_mk Nat Nat a' b') (den m))) :
    Nat.add a b' = Nat.add a' b :=
  mul_cancel_pos m (Nat.add a b') (Nat.add a' b)
    (@Eq.trans.{1} Nat
      (myMul (Nat.add a b') (Nat.succ m))
      (Nat.add (myMul a (Nat.succ m)) (myMul b' (Nat.succ m)))
      (myMul (Nat.add a' b) (Nat.succ m))
      (mul_add_right a b' (Nat.succ m))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a (Nat.succ m)) (myMul b' (Nat.succ m)))
        (Nat.add (myMul a' (Nat.succ m)) (myMul b (Nat.succ m)))
        (myMul (Nat.add a' b) (Nat.succ m))
        (mulRep_den_mid (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b') m h)
        (@Eq.symm.{1} Nat
          (myMul (Nat.add a' b) (Nat.succ m))
          (Nat.add (myMul a' (Nat.succ m)) (myMul b (Nat.succ m)))
          (mul_add_right a' b (Nat.succ m)))))

-- ─────────────────────────────────────────────────────────────
-- ㉘.1 乘法对第一个因子良定义
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：`ratAdd_cross` 先把 `x ~ x'` 化成整数代表元的相等 `a + b' = a' + b`；`mulRep_wd` 把它搬到两个乘积分子上；最后再用一次 `mulRep_wd`，把两个分子同时乘上公分母 `(m+1)(n+1)`，正好就是 `ratRel` 的定义。
-- soko:hint 目标形态：`x ~ x' ⇒ x*y ~ x'*y`（同分母 `m`、同一个 `y`）。
-- soko:hint 关键件：ratAdd_cross · mulRep_wd（两次，第二次的乘数是 `den (ratDenRep m n)`）。

theorem ratMulRep_wd (a b a' b' c d m n : Nat)
    (h : ratRel (qrep a b m) (qrep a' b' m)) :
    ratRel (ratMulRep (qrep a b m) (qrep c d n))
           (ratMulRep (qrep a' b' m) (qrep c d n)) :=
  mulRep_wd
    (Nat.add (myMul a c) (myMul b d))
    (Nat.add (myMul a d) (myMul b c))
    (Nat.add (myMul a' c) (myMul b' d))
    (Nat.add (myMul a' d) (myMul b' c))
    (Nat.succ (ratDenRep m n)) Nat.zero
    (mulRep_wd a b a' b' c d (rat_cross a b a' b' m h))

-- ─────────────────────────────────────────────────────────────
-- ㉘.2 乘法对第二个因子良定义
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：与 ㉘.1 同构，只是这次把 `ratAdd_cross` 用在 `y ~ y'` 上；整数层的 `mulRep_wd_snd` 把 `c + d' = c' + d` 搬到 `x` 的两个乘积分子上，再乘回公分母。
-- soko:hint 目标形态：`y ~ y' ⇒ x*y ~ x*y'`（同分母 `n`、同一个 `x`）。
-- soko:hint 关键件：ratAdd_cross（作用在 `y` 上）· mulRep_wd_snd · mulRep_wd。

theorem ratMulRep_wd_snd (a b c d c' d' m n : Nat)
    (h : ratRel (qrep c d n) (qrep c' d' n)) :
    ratRel (ratMulRep (qrep a b m) (qrep c d n))
           (ratMulRep (qrep a b m) (qrep c' d' n)) :=
  mulRep_wd
    (Nat.add (myMul a c) (myMul b d))
    (Nat.add (myMul a d) (myMul b c))
    (Nat.add (myMul a c') (myMul b d'))
    (Nat.add (myMul a d') (myMul b c'))
    (Nat.succ (ratDenRep m n)) Nat.zero
    (mulRep_wd_snd c d c' d' a b (rat_cross c d c' d' n h))

def ratAddRep (x y : ratRep) : ratRep :=
  @prod_mk (Prod Nat Nat) Nat
    (@prod_mk Nat Nat
      (Nat.add
        (myMul (Prod.fst Nat Nat (numOf x)) (Nat.succ (denOf y)))
        (myMul (Prod.fst Nat Nat (numOf y)) (Nat.succ (denOf x))))
      (Nat.add
        (myMul (Prod.snd Nat Nat (numOf x)) (Nat.succ (denOf y)))
        (myMul (Prod.snd Nat Nat (numOf y)) (Nat.succ (denOf x)))))
    (ratDenRep (denOf x) (denOf y))


theorem numOf_mk (a b m : Nat) :
    numOf (qrep a b m) = @prod_mk Nat Nat a b :=
  Eq.refl (@prod_mk Nat Nat a b)


theorem denOf_mk (a b m : Nat) :
    denOf (qrep a b m) = m :=
  Eq.refl m


theorem ratAddRep_mk (a b c d m n : Nat) :
    ratAddRep (qrep a b m) (qrep c d n) =
      qrep
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
        (ratDenRep m n) :=
  Eq.refl (qrep
    (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
    (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
    (ratDenRep m n))

-- ─────────────────────────────────────────────────────────────
-- ㉖.3 从等价假设里取出「交叉和相等」，并消去同一个正分母
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：`mulRep_den_mid` 把假设化成 `a·d + b'·d = a'·d + b·d`（`d = m+1`）；两边分别用 `mul_add_right` 收成 `(a+b')·d` 与 `(a'+b)·d`，再用 `mul_cancel_pos` 消去正因子 `d`。
-- soko:hint 目标形态：`(a-b) = (a'-b')` 的交叉和形式 `a + b' = a' + b`。
-- soko:hint 关键件：mulRep_den_mid · mul_add_right · mul_cancel_pos · Eq.symm · Eq.trans。


theorem ratAdd_cross (a b a' b' : Nat) (m : Nat)
    (h : intRel (mulRep (@prod_mk Nat Nat a b) (den m))
                (mulRep (@prod_mk Nat Nat a' b') (den m))) :
    Nat.add a b' = Nat.add a' b :=
  mul_cancel_pos m (Nat.add a b') (Nat.add a' b)
    (@Eq.trans.{1} Nat
      (myMul (Nat.add a b') (Nat.succ m))
      (Nat.add (myMul a (Nat.succ m)) (myMul b' (Nat.succ m)))
      (myMul (Nat.add a' b) (Nat.succ m))
      (mul_add_right a b' (Nat.succ m))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul a (Nat.succ m)) (myMul b' (Nat.succ m)))
        (Nat.add (myMul a' (Nat.succ m)) (myMul b (Nat.succ m)))
        (myMul (Nat.add a' b) (Nat.succ m))
        (mulRep_den_mid (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a' b') m h)
        (@Eq.symm.{1} Nat
          (myMul (Nat.add a' b) (Nat.succ m))
          (Nat.add (myMul a' (Nat.succ m)) (myMul b (Nat.succ m)))
          (mul_add_right a' b (Nat.succ m)))))

-- ─────────────────────────────────────────────────────────────
-- ㉖.4 分子在第一因子上的搬运（两个正分母都乘开）
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：五步链 —— ① `add_shift` 把四项重排成 `(a·n₁ + b'·n₁) + (c·m₁ + d·m₁)`；② 两次 `mul_add_right` 的对称把两个括号收成乘积；③ 用 `h` 在 `n₁` 的因子上改写；④ 再用 `mul_add_right` 拆开；⑤ `add_shift` 的对称收回目标配对。
-- soko:hint 目标形态：(a·n₁ + c·m₁) + (b'·n₁ + d·m₁) = (a'·n₁ + c·m₁) + (b·n₁ + d·m₁)。
-- soko:hint 关键件：add_shift · mul_add_right（四次，其中两次取对称）· add_congr · congrArg。


theorem ratAdd_num_wd (a b a' b' c d m n : Nat)
    (h : Nat.add a b' = Nat.add a' b) :
    Nat.add
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m))) =
      Nat.add
        (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))) :=
  @Eq.trans.{1} Nat
    (Nat.add
      (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
      (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m))))
    (Nat.add
      (Nat.add (myMul a (Nat.succ n)) (myMul b' (Nat.succ n)))
      (Nat.add (myMul c (Nat.succ m)) (myMul d (Nat.succ m))))
    (Nat.add
      (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
      (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
    (add_shift (myMul a (Nat.succ n)) (myMul b' (Nat.succ n))
               (myMul c (Nat.succ m)) (myMul d (Nat.succ m)))
    (@Eq.trans.{1} Nat
      (Nat.add
        (Nat.add (myMul a (Nat.succ n)) (myMul b' (Nat.succ n)))
        (Nat.add (myMul c (Nat.succ m)) (myMul d (Nat.succ m))))
      (Nat.add
        (myMul (Nat.add a b') (Nat.succ n))
        (myMul (Nat.add c d) (Nat.succ m)))
      (Nat.add
        (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
      (add_congr
        (@Eq.symm.{1} Nat
          (myMul (Nat.add a b') (Nat.succ n))
          (Nat.add (myMul a (Nat.succ n)) (myMul b' (Nat.succ n)))
          (mul_add_right a b' (Nat.succ n)))
        (@Eq.symm.{1} Nat
          (myMul (Nat.add c d) (Nat.succ m))
          (Nat.add (myMul c (Nat.succ m)) (myMul d (Nat.succ m)))
          (mul_add_right c d (Nat.succ m))))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul (Nat.add a b') (Nat.succ n))
                 (myMul (Nat.add c d) (Nat.succ m)))
        (Nat.add (myMul (Nat.add a' b) (Nat.succ n))
                 (myMul (Nat.add c d) (Nat.succ m)))
        (Nat.add
          (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
          (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
        (add_congr
          (congrArg.{1} (fun (z : Nat) => myMul z (Nat.succ n)) h)
          (@Eq.refl.{1} Nat (myMul (Nat.add c d) (Nat.succ m))))
        (@Eq.trans.{1} Nat
          (Nat.add (myMul (Nat.add a' b) (Nat.succ n))
                   (myMul (Nat.add c d) (Nat.succ m)))
          (Nat.add
            (Nat.add (myMul a' (Nat.succ n)) (myMul b (Nat.succ n)))
            (Nat.add (myMul c (Nat.succ m)) (myMul d (Nat.succ m))))
          (Nat.add
            (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
            (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
          (add_congr
            (mul_add_right a' b (Nat.succ n))
            (mul_add_right c d (Nat.succ m)))
          (add_shift (myMul a' (Nat.succ n)) (myMul c (Nat.succ m))
                     (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))))

-- ─────────────────────────────────────────────────────────────
-- ㉖.5 分子在第二因子上的搬运
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：与 ㉖.4 同构，只是这次换的是 (c,d) 那一对（乘 `m₁` 的项）：`add_shift` 先把 `(c,d')` 与 `(a,b)` 配对，两次 `mul_add_right` 收成乘积，`h` 改写 `(c+d')`，再拆开、`add_shift` 收回。
-- soko:hint 目标形态：(a·n₁ + c·m₁) + (b·n₁ + d'·m₁) = (a·n₁ + c'·m₁) + (b·n₁ + d·m₁)。
-- soko:hint 关键件：add_shift · mul_add_right（四次，其中两次取对称）· add_congr · congrArg。


theorem ratAdd_num_wd_snd (a b c d c' d' m n : Nat)
    (h : Nat.add c d' = Nat.add c' d) :
    Nat.add
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m))) =
      Nat.add
        (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))) :=
  @Eq.trans.{1} Nat
    (Nat.add
      (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
      (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m))))
    (Nat.add
      (Nat.add (myMul a (Nat.succ n)) (myMul b (Nat.succ n)))
      (Nat.add (myMul c (Nat.succ m)) (myMul d' (Nat.succ m))))
    (Nat.add
      (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
      (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
    (add_shift (myMul a (Nat.succ n)) (myMul b (Nat.succ n))
               (myMul c (Nat.succ m)) (myMul d' (Nat.succ m)))
    (@Eq.trans.{1} Nat
      (Nat.add
        (Nat.add (myMul a (Nat.succ n)) (myMul b (Nat.succ n)))
        (Nat.add (myMul c (Nat.succ m)) (myMul d' (Nat.succ m))))
      (Nat.add
        (myMul (Nat.add a b) (Nat.succ n))
        (myMul (Nat.add c d') (Nat.succ m)))
      (Nat.add
        (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
      (add_congr
        (@Eq.symm.{1} Nat
          (myMul (Nat.add a b) (Nat.succ n))
          (Nat.add (myMul a (Nat.succ n)) (myMul b (Nat.succ n)))
          (mul_add_right a b (Nat.succ n)))
        (@Eq.symm.{1} Nat
          (myMul (Nat.add c d') (Nat.succ m))
          (Nat.add (myMul c (Nat.succ m)) (myMul d' (Nat.succ m)))
          (mul_add_right c d' (Nat.succ m))))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul (Nat.add a b) (Nat.succ n))
                 (myMul (Nat.add c d') (Nat.succ m)))
        (Nat.add (myMul (Nat.add a b) (Nat.succ n))
                 (myMul (Nat.add c' d) (Nat.succ m)))
        (Nat.add
          (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
          (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
        (add_congr
          (@Eq.refl.{1} Nat (myMul (Nat.add a b) (Nat.succ n)))
          (congrArg.{1} (fun (z : Nat) => myMul z (Nat.succ m)) h))
        (@Eq.trans.{1} Nat
          (Nat.add (myMul (Nat.add a b) (Nat.succ n))
                   (myMul (Nat.add c' d) (Nat.succ m)))
          (Nat.add
            (Nat.add (myMul a (Nat.succ n)) (myMul b (Nat.succ n)))
            (Nat.add (myMul c' (Nat.succ m)) (myMul d (Nat.succ m))))
          (Nat.add
            (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
            (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
          (add_congr
            (mul_add_right a b (Nat.succ n))
            (mul_add_right c' d (Nat.succ m)))
          (add_shift (myMul a (Nat.succ n)) (myMul c' (Nat.succ m))
                     (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))))

-- ─────────────────────────────────────────────────────────────
-- ㉖.6 加法对第一个因子良定义
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：先用 `ratAdd_cross` 把假设 `x ~ x'` 化成 `a + b' = a' + b`，再交给 ㉖.4 得到 `A + B' = A' + B`。两端分母字段都是同一个 `ratDenRep m n`，所以直接用 `mul_shift_c` 得到交叉和等式 `A·D + B'·D = A'·D + B·D`（`D = succ (ratDenRep m n)`），它就是 `intRel` 展开后的样子。用 `mulRep_den` 把 `mulRep` 化到规范形，再用 `intRel_trans` 串起来。
-- soko:hint 目标形态：x ~ x' ⇒ (x + y) ~ (x' + y)。
-- soko:hint 关键件：ratAdd_cross · ratAdd_num_wd · mul_shift_c · mulRep_den（两次）· intRel_trans（两次）· intRel_symm。


theorem ratAddRep_wd (a b a' b' c d m n : Nat)
    (h : ratRel (qrep a b m) (qrep a' b' m)) :
    ratRel (ratAddRep (qrep a b m) (qrep c d n))
           (ratAddRep (qrep a' b' m) (qrep c d n)) :=
  intRel_trans
    (mulRep
      (@prod_mk Nat Nat
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
      (den (ratDenRep m n)))
    (@prod_mk Nat Nat
      (myMul
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.succ (ratDenRep m n)))
      (myMul
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
        (Nat.succ (ratDenRep m n))))
    (mulRep
      (@prod_mk Nat Nat
        (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m))))
      (den (ratDenRep m n)))
    (mulRep_den
      (@prod_mk Nat Nat
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
      (ratDenRep m n))
    (intRel_trans
      (@prod_mk Nat Nat
        (myMul
          (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
          (Nat.succ (ratDenRep m n)))
        (myMul
          (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
          (Nat.succ (ratDenRep m n))))
      (@prod_mk Nat Nat
        (myMul
          (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
          (Nat.succ (ratDenRep m n)))
        (myMul
          (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m)))
          (Nat.succ (ratDenRep m n))))
      (mulRep
        (@prod_mk Nat Nat
          (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
          (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m))))
        (den (ratDenRep m n)))
      (mul_shift_c
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
        (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m)))
        (Nat.succ (ratDenRep m n))
        (ratAdd_num_wd a b a' b' c d m n
          (ratAdd_cross a b a' b' m h)))
      (intRel_symm
        (mulRep
          (@prod_mk Nat Nat
            (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
            (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m))))
          (den (ratDenRep m n)))
        (@prod_mk Nat Nat
          (myMul
            (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
            (Nat.succ (ratDenRep m n)))
          (myMul
            (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m)))
            (Nat.succ (ratDenRep m n))))
        (mulRep_den
          (@prod_mk Nat Nat
            (Nat.add (myMul a' (Nat.succ n)) (myMul c (Nat.succ m)))
            (Nat.add (myMul b' (Nat.succ n)) (myMul d (Nat.succ m))))
          (ratDenRep m n))))

-- ─────────────────────────────────────────────────────────────
-- ㉖.7 加法对第二个因子良定义
-- ─────────────────────────────────────────────────────────────

-- soko:hint 思路：与 ㉖.6 同构：`ratAdd_cross` 这次作用在 `y ~ y'` 上（分母字段是 `n`），得到 `c + d' = c' + d`，交给 ㉖.5；两端分母仍是同一个 `ratDenRep m n`，`mul_shift_c` + `mulRep_den` + `intRel_trans` 收口。
-- soko:hint 目标形态：y ~ y' ⇒ (x + y) ~ (x + y')。
-- soko:hint 关键件：ratAdd_cross · ratAdd_num_wd_snd · mul_shift_c · mulRep_den（两次）· intRel_trans（两次）· intRel_symm。


theorem ratAddRep_wd_snd (a b c d c' d' m n : Nat)
    (h : ratRel (qrep c d n) (qrep c' d' n)) :
    ratRel (ratAddRep (qrep a b m) (qrep c d n))
           (ratAddRep (qrep a b m) (qrep c' d' n)) :=
  intRel_trans
    (mulRep
      (@prod_mk Nat Nat
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
      (den (ratDenRep m n)))
    (@prod_mk Nat Nat
      (myMul
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.succ (ratDenRep m n)))
      (myMul
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
        (Nat.succ (ratDenRep m n))))
    (mulRep
      (@prod_mk Nat Nat
        (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m))))
      (den (ratDenRep m n)))
    (mulRep_den
      (@prod_mk Nat Nat
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m))))
      (ratDenRep m n))
    (intRel_trans
      (@prod_mk Nat Nat
        (myMul
          (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
          (Nat.succ (ratDenRep m n)))
        (myMul
          (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
          (Nat.succ (ratDenRep m n))))
      (@prod_mk Nat Nat
        (myMul
          (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
          (Nat.succ (ratDenRep m n)))
        (myMul
          (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m)))
          (Nat.succ (ratDenRep m n))))
      (mulRep
        (@prod_mk Nat Nat
          (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
          (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m))))
        (den (ratDenRep m n)))
      (mul_shift_c
        (Nat.add (myMul a (Nat.succ n)) (myMul c (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d (Nat.succ m)))
        (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
        (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m)))
        (Nat.succ (ratDenRep m n))
        (ratAdd_num_wd_snd a b c d c' d' m n
          (ratAdd_cross c d c' d' n h)))
      (intRel_symm
        (mulRep
          (@prod_mk Nat Nat
            (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
            (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m))))
          (den (ratDenRep m n)))
        (@prod_mk Nat Nat
          (myMul
            (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
            (Nat.succ (ratDenRep m n)))
          (myMul
            (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m)))
            (Nat.succ (ratDenRep m n))))
        (mulRep_den
          (@prod_mk Nat Nat
            (Nat.add (myMul a (Nat.succ n)) (myMul c' (Nat.succ m)))
            (Nat.add (myMul b (Nat.succ n)) (myMul d' (Nat.succ m))))
          (ratDenRep m n))))

-- ─────────────────────────────────────────────────────────────
-- ㉖.8 具体数字：1/2 + 1/3 = 5/6
-- ─────────────────────────────────────────────────────────────

-- 1/2 记成 ((1,0),1)，1/3 记成 ((1,0),2)。按 ㉖.2 的公式：
--   分子 = (1·3 + 1·2) - (0·3 + 0·2) = 5，
--   分母字段 = 1·2 + 1 + 2 = 5（真正分母 6），
-- 正是 5/6；它和 10/12 表示同一个有理数。

-- soko:hint 思路：两边都化成代表元后是同一个具体数字；`10/12` 这一边交叉相乘是 5·12 = 10·6 = 60，全用 `Eq.refl` 即可（内核把具体数字归约掉）。
-- soko:hint 目标形态：(1/2 + 1/3) ~ (10/12)。
-- soko:hint 关键件：Eq.refl（具体数字全部归约）。


theorem ratAddRep_demo :
    ratRel
      (ratAddRep (qrep 1 0 1) (qrep 1 0 2))
      (qrep 10 0 11) :=
  Eq.refl (Nat.add (myMul 5 12) (Nat.add Nat.zero (myMul Nat.zero 12)))

theorem intRel_chain4 (p q r s : Prod Nat Nat)
    (h1 : intRel p q) (h2 : intRel q r) (h3 : intRel r s) : intRel p s :=
  intRel_trans p r s (intRel_trans p q r h1 h2) h3

-- ─────────────────────────────────────────────────────────────
-- ㉑.4 具体数字上走一遍
-- ─────────────────────────────────────────────────────────────

-- 5-2 与 4-1 差相同（5+1 = 4+2），4-1 与 3-0 差相同（4+0 = 3+1），所以 5-2 与 3-0 差相同（5+0 = 3+2）。
-- soko:hint 思路：直接对具体序对用 intRel_trans；两条小前提都是具体数字等式，用 Eq.refl 即可。
-- soko:hint 目标形态：intRel (5,2) (3,0)。
-- soko:hint 关键件：intRel_trans · Eq.refl（内核会把 5+1 与 4+2 都归约成 6）。


theorem intRel_trans_demo :
    intRel (@prod_mk Nat Nat 5 2) (@prod_mk Nat Nat 3 Nat.zero) :=
  intRel_trans
    (@prod_mk Nat Nat 5 2)
    (@prod_mk Nat Nat 4 1)
    (@prod_mk Nat Nat 3 Nat.zero)
    (@Eq.refl.{1} Nat 6)
    (@Eq.refl.{1} Nat 4)


theorem mulRep_den_cancel (u v : Prod Nat Nat) (n : Nat)
    (h : intRel (mulRep u (den n)) (mulRep v (den n))) :
    intRel u v :=
  mul_cancel_pos n
    (Nat.add (Prod.fst Nat Nat u) (Prod.snd Nat Nat v))
    (Nat.add (Prod.fst Nat Nat v) (Prod.snd Nat Nat u))
    (@Eq.trans.{1} Nat
      (myMul (Nat.add (Prod.fst Nat Nat u) (Prod.snd Nat Nat v)) (Nat.succ n))
      (Nat.add (myMul (Prod.fst Nat Nat u) (Nat.succ n))
               (myMul (Prod.snd Nat Nat v) (Nat.succ n)))
      (myMul (Nat.add (Prod.fst Nat Nat v) (Prod.snd Nat Nat u)) (Nat.succ n))
      (mul_add_right (Prod.fst Nat Nat u) (Prod.snd Nat Nat v) (Nat.succ n))
      (@Eq.trans.{1} Nat
        (Nat.add (myMul (Prod.fst Nat Nat u) (Nat.succ n))
                 (myMul (Prod.snd Nat Nat v) (Nat.succ n)))
        (Nat.add (myMul (Prod.fst Nat Nat v) (Nat.succ n))
                 (myMul (Prod.snd Nat Nat u) (Nat.succ n)))
        (myMul (Nat.add (Prod.fst Nat Nat v) (Prod.snd Nat Nat u)) (Nat.succ n))
        (mulRep_den_mid u v n h)
        (@Eq.symm.{1} Nat
          (myMul (Nat.add (Prod.fst Nat Nat v) (Prod.snd Nat Nat u)) (Nat.succ n))
          (Nat.add (myMul (Prod.fst Nat Nat v) (Nat.succ n))
                   (myMul (Prod.snd Nat Nat u) (Nat.succ n)))
          (mul_add_right (Prod.fst Nat Nat v) (Prod.snd Nat Nat u) (Nat.succ n)))))


theorem mulRep_den_den (a b : Nat) :
    intRel (mulRep (den a) (den b))
      (@prod_mk Nat Nat (myMul (Nat.succ a) (Nat.succ b)) Nat.zero) :=
  @Eq.symm.{1} Nat
    (Nat.add (myMul (Nat.succ a) (Nat.succ b))
             (Nat.add Nat.zero (myMul Nat.zero (Nat.succ b))))
    (Nat.add (myMul (Nat.succ a) (Nat.succ b)) Nat.zero)
    (@Eq.trans.{1} Nat
      (Nat.add (myMul (Nat.succ a) (Nat.succ b))
               (Nat.add Nat.zero (myMul Nat.zero (Nat.succ b))))
      (Nat.add (myMul (Nat.succ a) (Nat.succ b))
               (Nat.add Nat.zero Nat.zero))
      (Nat.add (myMul (Nat.succ a) (Nat.succ b)) Nat.zero)
      (congrArg.{1} (fun (y : Nat) =>
          Nat.add (myMul (Nat.succ a) (Nat.succ b)) (Nat.add Nat.zero y))
        (zero_mul (Nat.succ b)))
      (@Eq.refl.{1} Nat (Nat.add (myMul (Nat.succ a) (Nat.succ b)) Nat.zero)))

-- 两个正分母的乘积可交换。
-- soko:hint 思路：先把两边分别化到规范形 `((a+1)(b+1), 0)` 与 `((b+1)(a+1), 0)`，中间用 `myMul_comm` 把两个因子对调，最后沿对称的规范形搬回 `mulRep (den b) (den a)`。
-- soko:hint 目标形态：mulRep (den a) (den b) ~ mulRep (den b) (den a)。
-- soko:hint 关键件：mulRep_den_den（两次，一次取对称）· myMul_comm · intRel_trans。

theorem mulRep_den_comm (a b : Nat) :
    intRel (mulRep (den a) (den b)) (mulRep (den b) (den a)) :=
  intRel_trans
    (mulRep (den a) (den b))
    (@prod_mk Nat Nat (myMul (Nat.succ a) (Nat.succ b)) Nat.zero)
    (mulRep (den b) (den a))
    (mulRep_den_den a b)
    (intRel_trans
      (@prod_mk Nat Nat (myMul (Nat.succ a) (Nat.succ b)) Nat.zero)
      (@prod_mk Nat Nat (myMul (Nat.succ b) (Nat.succ a)) Nat.zero)
      (mulRep (den b) (den a))
      (myMul_comm (Nat.succ a) (Nat.succ b))
      (intRel_symm (mulRep (den b) (den a))
        (@prod_mk Nat Nat (myMul (Nat.succ b) (Nat.succ a)) Nat.zero)
        (mulRep_den_den b a)))

-- 乘法的三个因子中，后两个正分母可以对调（结合律 + 分母交换）。

theorem mulRep_den_swap (p1 p2 a b : Nat) :
    intRel
      (mulRep (mulRep (@prod_mk Nat Nat p1 p2) (den a)) (den b))
      (mulRep (mulRep (@prod_mk Nat Nat p1 p2) (den b)) (den a)) :=
  intRel_trans
    (mulRep (mulRep (@prod_mk Nat Nat p1 p2) (den a)) (den b))
    (mulRep (@prod_mk Nat Nat p1 p2) (mulRep (den a) (den b)))
    (mulRep (mulRep (@prod_mk Nat Nat p1 p2) (den b)) (den a))
    (mulRep_assoc p1 p2 (Nat.succ a) Nat.zero (Nat.succ b) Nat.zero)
    (intRel_trans
      (mulRep (@prod_mk Nat Nat p1 p2) (mulRep (den a) (den b)))
      (mulRep (@prod_mk Nat Nat p1 p2) (mulRep (den b) (den a)))
      (mulRep (mulRep (@prod_mk Nat Nat p1 p2) (den b)) (den a))
      (@Eq.subst.{1} (Prod Nat Nat)
        (fun (x : Prod Nat Nat) =>
          intRel
            (mulRep (@prod_mk Nat Nat p1 p2) (mulRep (den a) (den b)))
            (mulRep (@prod_mk Nat Nat p1 p2) x))
        (mulRep (den a) (den b))
        (mulRep (den b) (den a))
        (mulRep_comm (Nat.succ a) Nat.zero (Nat.succ b) Nat.zero)
        (intRel_refl (mulRep (@prod_mk Nat Nat p1 p2) (mulRep (den a) (den b)))))
      (intRel_symm
        (mulRep (mulRep (@prod_mk Nat Nat p1 p2) (den b)) (den a))
        (mulRep (@prod_mk Nat Nat p1 p2) (mulRep (den b) (den a)))
        (mulRep_assoc p1 p2 (Nat.succ b) Nat.zero (Nat.succ a) Nat.zero)))

-- 主定理：ratRel 是传递的。两边各乘一个正分母，把交叉乘积接到同一条链上，
-- 再消去多出来的正分母 (n+1)。
-- soko:hint 思路：对 h1、h2 各乘一个正分母（用 mulRep_wd 的两次），再用 `mulRep_den_swap` 把 `(p·dn)·dk` 与 `(p·dk)·dn` 对齐，得到一条从 `(p·dk)·dn` 到 `(r·dm)·dn` 的五步链；最后交给 `mulRep_den_cancel` 消去多出来的 `dn`。
-- soko:hint 目标形态：ratRel x y ⇒ ratRel y z ⇒ ratRel x z。
-- soko:hint 关键件：mulRep_wd（两次）· mulRep_den_swap（三次）· intRel_trans（四次）· mulRep_den_cancel。

theorem ratRel_trans (a b c d e f : Nat) (m n k : Nat)
    (h1 : ratRel
      (@prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat a b) m)
      (@prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat c d) n))
    (h2 : ratRel
      (@prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat c d) n)
      (@prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat e f) k)) :
    ratRel
      (@prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat a b) m)
      (@prod_mk (Prod Nat Nat) Nat (@prod_mk Nat Nat e f) k) :=
  mulRep_den_cancel
    (mulRep (@prod_mk Nat Nat a b) (den k))
    (mulRep (@prod_mk Nat Nat e f) (den m))
    n
    (intRel_trans
      (mulRep (mulRep (@prod_mk Nat Nat a b) (den k)) (den n))
      (mulRep (mulRep (@prod_mk Nat Nat a b) (den n)) (den k))
      (mulRep (mulRep (@prod_mk Nat Nat e f) (den m)) (den n))
      (mulRep_den_swap a b k n)
      (intRel_trans
        (mulRep (mulRep (@prod_mk Nat Nat a b) (den n)) (den k))
        (mulRep (mulRep (@prod_mk Nat Nat c d) (den m)) (den k))
        (mulRep (mulRep (@prod_mk Nat Nat e f) (den m)) (den n))
        (mulRep_wd
          (Prod.fst Nat Nat (mulRep (@prod_mk Nat Nat a b) (den n)))
          (Prod.snd Nat Nat (mulRep (@prod_mk Nat Nat a b) (den n)))
          (Prod.fst Nat Nat (mulRep (@prod_mk Nat Nat c d) (den m)))
          (Prod.snd Nat Nat (mulRep (@prod_mk Nat Nat c d) (den m)))
          (Nat.succ k) Nat.zero h1)
        (intRel_trans
          (mulRep (mulRep (@prod_mk Nat Nat c d) (den m)) (den k))
          (mulRep (mulRep (@prod_mk Nat Nat c d) (den k)) (den m))
          (mulRep (mulRep (@prod_mk Nat Nat e f) (den m)) (den n))
          (mulRep_den_swap c d m k)
          (intRel_trans
            (mulRep (mulRep (@prod_mk Nat Nat c d) (den k)) (den m))
            (mulRep (mulRep (@prod_mk Nat Nat e f) (den n)) (den m))
            (mulRep (mulRep (@prod_mk Nat Nat e f) (den m)) (den n))
            (mulRep_wd
              (Prod.fst Nat Nat (mulRep (@prod_mk Nat Nat c d) (den k)))
              (Prod.snd Nat Nat (mulRep (@prod_mk Nat Nat c d) (den k)))
              (Prod.fst Nat Nat (mulRep (@prod_mk Nat Nat e f) (den n)))
              (Prod.snd Nat Nat (mulRep (@prod_mk Nat Nat e f) (den n)))
              (Nat.succ m) Nat.zero h2)
            (mulRep_den_swap e f n m)))))

inductive LeNat : Nat → Nat → Prop

ctor le_refl (n : Nat) : LeNat n n

ctor le_succ (m : Nat) (n : Nat) : LeNat m n → LeNat m (Nat.succ n)

end


def leRep (p q : Prod Nat Nat) : Prop :=
  LeNat (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q))
        (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p))


def addRep (p q : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat
    (Nat.add (Prod.fst Nat Nat p) (Prod.fst Nat Nat q))
    (Nat.add (Prod.snd Nat Nat p) (Prod.snd Nat Nat q))

-- 以下四条是单元③的 ℕ 加法律，本单元自用（L3：律必须留在单元里）。

theorem leNat_trans (a b c : Nat) (h1 : LeNat a b) (h2 : LeNat b c) : LeNat a c :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat a m → LeNat a n)
    (fun (n : Nat) => fun (h : LeNat a n) => h)
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat a m → LeNat a n) =>
       fun (h1 : LeNat a m) => le_succ a n (ih h1))
    b c h2 h1


theorem leNat_exists_add (m n : Nat) (h : LeNat m n) :
    ∃ (k : Nat), n = Nat.add m k :=
  @LeNat.rec
    (fun (m n : Nat) (_ : LeNat m n) =>
      ∃ (k : Nat), n = Nat.add m k)
    (fun (n : Nat) =>
      Exists.intro Nat.zero (@Eq.refl.{1} Nat n))
    (fun (m n : Nat) (h : LeNat m n)
         (ih : ∃ (k : Nat), n = Nat.add m k) =>
      Exists.elim ih (fun (k : Nat) (hk : n = Nat.add m k) =>
          Exists.intro (Nat.succ k) (congrArg.{1} Nat.succ hk)))
    m n h


theorem leNat_self_add (m k : Nat) : LeNat m (Nat.add m k) :=
  Nat.rec (fun (n : Nat) => LeNat m (Nat.add m n))
    (le_refl m)
    (fun (n : Nat) (ih : LeNat m (Nat.add m n)) => le_succ m (Nat.add m n) ih)
    k


theorem leNat_of_exists_add (m n : Nat)
    (h : ∃ (k : Nat), n = Nat.add m k) :
    LeNat m n :=
  Exists.elim h (fun (k : Nat) (hk : n = Nat.add m k) =>
      @Eq.subst.{1} Nat (fun (x : Nat) => LeNat m x) (Nat.add m k) n
        (@Eq.symm.{1} Nat n (Nat.add m k) hk)
        (leNat_self_add m k))


theorem leNat_add_cancel_right (a b k : Nat)
    (h : LeNat (Nat.add a k) (Nat.add b k)) : LeNat a b :=
  leNat_of_exists_add a b
    (Exists.elim (leNat_exists_add (Nat.add a k) (Nat.add b k) h) (fun (j : Nat)
           (hj : Nat.add b k = Nat.add (Nat.add a k) j) =>
        Exists.intro j (nat_add_cancel_right b (Nat.add a j) k
            (@Eq.trans.{1} Nat (Nat.add b k) (Nat.add (Nat.add a k) j)
              (Nat.add (Nat.add a j) k)
              hj
              (add_rotate a k j)))))


theorem leNat_succ_succ (a b : Nat) (h : LeNat a b) :
    LeNat (Nat.succ a) (Nat.succ b) :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat (Nat.succ m) (Nat.succ n))
    (fun (n : Nat) => le_refl (Nat.succ n))
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat (Nat.succ m) (Nat.succ n)) =>
       le_succ (Nat.succ m) (Nat.succ n) ih)
    a b h


theorem leNat_add_right (a b k : Nat) (h : LeNat a b) :
    LeNat (Nat.add a k) (Nat.add b k) :=
  Nat.rec (fun (k : Nat) => LeNat (Nat.add a k) (Nat.add b k))
    h
    (fun (k : Nat) (ih : LeNat (Nat.add a k) (Nat.add b k)) =>
       leNat_succ_succ (Nat.add a k) (Nat.add b k) ih)
    k


-- 四项交换：`(a+d)+(e+f) = (a+e)+(d+f)`。纯 ℕ 算术（结合 + 交换），
-- 两条平移不变性都要用它把「先加在哪一侧」对齐。

theorem add4 (a d e f : Nat) :
    Nat.add (Nat.add a d) (Nat.add e f) = Nat.add (Nat.add a e) (Nat.add d f) :=
  @Eq.trans.{1} Nat
    (Nat.add (Nat.add a d) (Nat.add e f))
    (Nat.add a (Nat.add e (Nat.add d f)))
    (Nat.add (Nat.add a e) (Nat.add d f))
    (@Eq.trans.{1} Nat
      (Nat.add (Nat.add a d) (Nat.add e f))
      (Nat.add a (Nat.add d (Nat.add e f)))
      (Nat.add a (Nat.add e (Nat.add d f)))
      (add_assoc a d (Nat.add e f))
      (@Eq.trans.{1} Nat
        (Nat.add a (Nat.add d (Nat.add e f)))
        (Nat.add a (Nat.add (Nat.add d e) f))
        (Nat.add a (Nat.add e (Nat.add d f)))
        (congrArg.{1} (fun (x : Nat) => Nat.add a x)
          (@Eq.symm.{1} Nat (Nat.add (Nat.add d e) f) (Nat.add d (Nat.add e f))
            (add_assoc d e f)))
        (@Eq.trans.{1} Nat
          (Nat.add a (Nat.add (Nat.add d e) f))
          (Nat.add a (Nat.add (Nat.add e d) f))
          (Nat.add a (Nat.add e (Nat.add d f)))
          (congrArg.{1} (fun (x : Nat) => Nat.add a x)
            (congrArg.{1} (fun (x : Nat) => Nat.add x f) (add_comm d e)))
          (congrArg.{1} (fun (x : Nat) => Nat.add a x)
            (add_assoc e d f)))))
    (@Eq.symm.{1} Nat
      (Nat.add (Nat.add a e) (Nat.add d f))
      (Nat.add a (Nat.add e (Nat.add d f)))
      (add_assoc a e (Nat.add d f)))

-- soko:hint 思路：两条假设在代表元层是 H1 : a+d ≤ c+b、H2 : c+f ≤ e+d。目标是 a+f ≤ e+b。
-- soko:hint 思路：H1 两边同加 f 得 (a+d)+f ≤ (c+b)+f，用 add_rotate 两边各转一次变成 (a+f)+d ≤ (c+f)+b；H2 两边同加 b 得 (c+f)+b ≤ (e+d)+b，再把右边转成 (e+b)+d。传递后对 d 用 leNat_add_cancel_right。
-- soko:hint 目标形态：leRep (a,b) (e,f) 即 LeNat (a+f) (e+b)。
-- soko:hint 关键件：leNat_add_right · add_rotate · Eq.subst · leNat_trans · leNat_add_cancel_right。

theorem leRep_trans (a b c d e f : Nat)
    (h1 : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d))
    (h2 : leRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat e f) :=
  leNat_add_cancel_right (Nat.add a f) (Nat.add e b) d
    (leNat_trans (Nat.add (Nat.add a f) d) (Nat.add (Nat.add c f) b)
      (Nat.add (Nat.add e b) d)
      (@Eq.subst.{1} Nat
        (fun (x : Nat) => LeNat x (Nat.add (Nat.add c f) b))
        (Nat.add (Nat.add a d) f) (Nat.add (Nat.add a f) d) (add_rotate a d f)
        (@Eq.subst.{1} Nat
          (fun (x : Nat) => LeNat (Nat.add (Nat.add a d) f) x)
          (Nat.add (Nat.add c b) f) (Nat.add (Nat.add c f) b) (add_rotate c b f)
          (leNat_add_right (Nat.add a d) (Nat.add c b) f h1)))
      (@Eq.subst.{1} Nat
        (fun (x : Nat) => LeNat (Nat.add (Nat.add c f) b) x)
        (Nat.add (Nat.add e d) b) (Nat.add (Nat.add e b) d) (add_rotate e d b)
        (leNat_add_right (Nat.add c f) (Nat.add e d) b h2)))

-- soko:hint 思路：h : a+d ≤ c+b；两边同加 (e+f) 得 (a+d)+(e+f) ≤ (c+b)+(e+f)。用 add4 把左边改成 (a+e)+(d+f)、右边改成 (c+e)+(b+f)，正是 leRep (addRep (a,b) (e,f)) (addRep (c,d) (e,f)) 展开后的两层。
-- soko:hint 目标形态：LeNat ((a+e)+(d+f)) ((c+e)+(b+f))。
-- soko:hint 关键件：leNat_add_right · add4（本文件已给）· Eq.subst。

theorem leRep_add_right (a b c d e f : Nat)
    (h : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    leRep (addRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat e f))
          (addRep (@prod_mk Nat Nat c d) (@prod_mk Nat Nat e f)) :=
  @Eq.subst.{1} Nat
    (fun (x : Nat) => LeNat (Nat.add (Nat.add a e) (Nat.add d f)) x)
    (Nat.add (Nat.add c b) (Nat.add e f)) (Nat.add (Nat.add c e) (Nat.add b f))
    (add4 c b e f)
    (@Eq.subst.{1} Nat
      (fun (x : Nat) => LeNat x (Nat.add (Nat.add c b) (Nat.add e f)))
      (Nat.add (Nat.add a d) (Nat.add e f)) (Nat.add (Nat.add a e) (Nat.add d f))
      (add4 a d e f)
      (leNat_add_right (Nat.add a d) (Nat.add c b) (Nat.add e f) h))

-- 演示：具体数字上传递一次 —— 0 ≤ 1 ≤ 2 推出 0 ≤ 2（都是 0 - 0 ≤ n - 0）。

theorem demo_leRep_trans :
    leRep (@prod_mk Nat Nat Nat.zero Nat.zero) (@prod_mk Nat Nat 2 Nat.zero) :=
  leRep_trans Nat.zero Nat.zero 1 Nat.zero 2 Nat.zero
    (le_succ Nat.zero Nat.zero (le_refl Nat.zero))
    (le_succ 1 1 (le_refl 1))

-- 演示：(1-0) ≤ (3-0) 两边同加 (2-1) ⇒ (3-1) ≤ (5-1)。

theorem demo_leRep_add_right :
    leRep (addRep (@prod_mk Nat Nat 1 Nat.zero) (@prod_mk Nat Nat 2 1))
          (addRep (@prod_mk Nat Nat 3 Nat.zero) (@prod_mk Nat Nat 2 1)) :=
  leRep_add_right 1 Nat.zero 3 Nat.zero 2 1
    (le_succ 1 2 (le_succ 1 1 (le_refl 1)))

def intOfNat (n : Nat) : Int :=
  @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat n Nat.zero)

-- 代表元上的取负：把序对 (a,b) 翻成 (b,a)。

def negRep (p : Prod Nat Nat) : Prod Nat Nat :=
  @prod_mk Nat Nat (Prod.snd Nat Nat p) (Prod.fst Nat Nat p)


theorem negRep_wd (p q : Prod Nat Nat)
    (h : intRel p q) :
    intRel (negRep p) (negRep q) :=
  @Eq.trans.{1} Nat
    (Nat.add (Prod.snd Nat Nat p) (Prod.fst Nat Nat q))
    (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p))
    (Nat.add (Prod.snd Nat Nat q) (Prod.fst Nat Nat p))
    (add_comm (Prod.snd Nat Nat p) (Prod.fst Nat Nat q))
    (@Eq.trans.{1} Nat
      (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p))
      (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q))
      (Nat.add (Prod.snd Nat Nat q) (Prod.fst Nat Nat p))
      (@Eq.symm.{1} Nat
        (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat q))
        (Nat.add (Prod.fst Nat Nat q) (Prod.snd Nat Nat p)) h)
      (add_comm (Prod.fst Nat Nat p) (Prod.snd Nat Nat q)))

-- ─────────────────────────────────────────────────────────────
-- ⑲.2 下降：`intNeg : Int → Int`
-- ─────────────────────────────────────────────────────────────

-- `Quot.lift` 是唯一的下降通道；两条义务就在这里结清。

def intNeg : Int → Int :=
  @Quot.lift.{1, 1} (Prod Nat Nat) intRel Int
    (fun (p : Prod Nat Nat) => @Quot.mk.{1} (Prod Nat Nat) intRel (negRep p))
    (fun (p q : Prod Nat Nat) (h : intRel p q) =>
      @Quot.sound.{1} (Prod Nat Nat) intRel (negRep p) (negRep q) (negRep_wd p q h))

-- 计算规则：`intNeg` 作用在 `mk p` 上按 ι 归约成 `mk (negRep p)`，所以是 `Eq.refl`。

theorem intNeg_mk (a b : Nat) :
    intNeg (@Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat a b)) =
    @Quot.mk.{1} (Prod Nat Nat) intRel (negRep (@prod_mk Nat Nat a b)) :=
  @Eq.refl.{1} Int (@Quot.mk.{1} (Prod Nat Nat) intRel (negRep (@prod_mk Nat Nat a b)))

-- 取负是对合：`-(-z) = z`。
-- soko:hint 思路：对 z 用 Quot.ind（命题层消去），把 z 换成 mk p。两次 ι 归约后左边是 mk (negRep (negRep p))；negRep 翻两次回到 (fst p, snd p)，与 p 的交叉和相等是自反的，用 Quot.sound 交出去。
-- soko:hint 目标形态：intNeg (intNeg z) = z。
-- soko:hint 关键件：Quot.ind（动机写在 Int 上）· Quot.sound（第三项用 Eq.refl）· ι 归约（两处 intNeg 都要真的烧掉）。

theorem intNeg_invol (z : Int) :
    intNeg (intNeg z) = z :=
  @Quot.ind.{1} (Prod Nat Nat) intRel
    (fun (z : Int) => intNeg (intNeg z) = z)
    (fun (p : Prod Nat Nat) =>
      @Quot.sound.{1} (Prod Nat Nat) intRel
        (negRep (negRep p)) p
        (@Eq.refl.{1} Nat (Nat.add (Prod.fst Nat Nat p) (Prod.snd Nat Nat p))))
    z

-- 演示：具体数字上走一遍 —— -(2,5) 就是 (5,2)，再取负回到 (2,5)。

theorem demo_intNeg_mk :
    intNeg (@Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 2 5)) =
    @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 5 2) :=
  intNeg_mk 2 5

-- 演示：对合在具体数字上 —— -(-(3,1)) 与 (3,1) 是同一个整数（交叉和 3+1 = 3+1）。

theorem demo_intNeg_invol :
    intNeg (intNeg (@Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 3 1))) =
    @Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 3 1) :=
  intNeg_invol (@Quot.mk.{1} (Prod Nat Nat) intRel (@prod_mk Nat Nat 3 1))

-- 演示：取负把自然数嵌入翻到另一边 —— -(intOfNat 0) 仍是 0（(0,0) 与 (0,0) 等价）。

theorem demo_intNeg_zero :
    intNeg (intOfNat Nat.zero) = intOfNat Nat.zero :=
  intNeg_invol (intOfNat Nat.zero)


theorem demo_succ_inj : 1 = 1 :=
  Nat.succ.inj 1 1 (@Eq.refl.{1} Nat 2)

-- 演示：2 - 0 ≤ 4 - 2 就是 2 + 2 ≤ 4 + 0，两边都是 4。

theorem demo_leRep_two_four :
    leRep (@prod_mk Nat Nat 2 Nat.zero) (@prod_mk Nat Nat 4 2) :=
  le_refl 4


theorem demo_leRep_one_three :
    leRep (@prod_mk Nat Nat 1 Nat.zero) (@prod_mk Nat Nat 3 Nat.zero) :=
  le_succ 1 2 (le_succ 1 1 (le_refl 1))

-- 演示：整数序的良定义性在「不改代表元」时是废话（自反）。

theorem demo_leRep_wd_refl :
    leRep (@prod_mk Nat Nat 2 2) (@prod_mk Nat Nat 3 1) →
    leRep (@prod_mk Nat Nat 2 2) (@prod_mk Nat Nat 3 1) :=
  fun (h : leRep (@prod_mk Nat Nat 2 2) (@prod_mk Nat Nat 3 1)) => h

-- 把 `intRel` 假设直接读成等式：`intRel (a,b) (x,y)` 展开是 `a + y = x + b`。
-- （假设位不会自动展开这个定义，先 Eq.subst 一次把等式拿到手。）

theorem intRel_to_eq (a b x y : Nat)
    (h : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat x y)) :
    Nat.add a y = Nat.add x b :=
  @Eq.subst.{1} Nat
    (fun (m : Nat) => Nat.add a y = m)
    (Nat.add a y) (Nat.add x b) h
    (@Eq.refl.{1} Nat (Nat.add a y))

-- soko:hint 思路：`intRel (a1,b1) (a,b)` 展开是 `a1 + b = a + b1`，正是 `intRel (a,b) (a1,b1)`（`a + b1 = a1 + b`）取对称。
-- soko:hint 目标形态：`a + b1 = a1 + b → a1 + b = a + b1`。
-- soko:hint 关键件：intRel_to_eq（本文件已给）· Eq.symm。

theorem leRep_wd_fst (a b a1 b1 c d : Nat)
    (h : Nat.add a b1 = Nat.add a1 b)
    (hl : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c d) :=
  @leNat_add_cancel_right (Nat.add a1 d) (Nat.add c b1) b
    (@Eq.subst.{1} Nat
      (fun (x : Nat) => LeNat x (Nat.add (Nat.add c b1) b))
      (Nat.add (Nat.add a d) b1)
      (Nat.add (Nat.add a1 d) b)
      (@Eq.trans.{1} Nat
        (Nat.add (Nat.add a d) b1)
        (Nat.add (Nat.add a1 b) d)
        (Nat.add (Nat.add a1 d) b)
        (@Eq.trans.{1} Nat
          (Nat.add (Nat.add a d) b1)
          (Nat.add (Nat.add a b1) d)
          (Nat.add (Nat.add a1 b) d)
          (add_rotate a d b1)
          (congrArg.{1} (fun (x : Nat) => Nat.add x d) h))
        (add_rotate a1 b d))
      (@Eq.subst.{1} Nat
        (fun (x : Nat) => LeNat (Nat.add (Nat.add a d) b1) x)
        (Nat.add (Nat.add c b) b1)
        (Nat.add (Nat.add c b1) b)
        (add_rotate c b b1)
        (leNat_add_right (Nat.add a d) (Nat.add c b) b1 hl)))

-- soko:hint 思路：结构对偶：先把 h 用 intRel_to_eq 读成 Hq : c + d1 = c1 + d。两边同加 d1，左边 rotate 成 `(a+d1)+d`；右边 `(c+b)+d1` rotate 成 `(c+d1)+b`、用 Hq 换成 `(c1+d)+b`、再 rotate 成 `(c1+b)+d`。最后用 leNat_add_cancel_right 消去 d。
-- soko:hint 目标形态：`LeNat (a+d) (c+b) → LeNat (a+d1) (c1+b)`（Hq : c + d1 = c1 + d）。
-- soko:hint 关键件：intRel_to_eq · leNat_add_right · add_rotate · congrArg · Eq.trans · leNat_add_cancel_right。

theorem leRep_wd_snd (a b c d c1 d1 : Nat)
    (h : Nat.add c d1 = Nat.add c1 d)
    (hl : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c1 d1) :=
  @leNat_add_cancel_right (Nat.add a d1) (Nat.add c1 b) d
    (@Eq.subst.{1} Nat
      (fun (x : Nat) => LeNat x (Nat.add (Nat.add c1 b) d))
      (Nat.add (Nat.add a d) d1)
      (Nat.add (Nat.add a d1) d)
      (add_rotate a d d1)
      (@Eq.subst.{1} Nat
        (fun (x : Nat) => LeNat (Nat.add (Nat.add a d) d1) x)
        (Nat.add (Nat.add c b) d1)
        (Nat.add (Nat.add c1 b) d)
        (@Eq.trans.{1} Nat
          (Nat.add (Nat.add c b) d1)
          (Nat.add (Nat.add c1 d) b)
          (Nat.add (Nat.add c1 b) d)
          (@Eq.trans.{1} Nat
            (Nat.add (Nat.add c b) d1)
            (Nat.add (Nat.add c d1) b)
            (Nat.add (Nat.add c1 d) b)
            (add_rotate c b d1)
            (congrArg.{1} (fun (x : Nat) => Nat.add x b) h))
          (add_rotate c1 d b))
        (leNat_add_right (Nat.add a d) (Nat.add c b) d1 hl)))

-- soko:hint 思路：先对第一对代表元用 leRep_wd_fst 得 `leRep (a1,b1) (c,d)`，再对第二对用 leRep_wd_snd。两条假设用 intRel_to_eq 各读成等式一次。
-- soko:hint 目标形态：`leRep (a,b) (c,d) → leRep (a1,b1) (c1,d1)`。
-- soko:hint 关键件：intRel_to_eq · leRep_wd_fst（练习 ②）· leRep_wd_snd（练习 ③）。

theorem leRep_wd (a b a1 b1 c d c1 d1 : Nat)
    (hpp : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a1 b1))
    (hqq : intRel (@prod_mk Nat Nat c d) (@prod_mk Nat Nat c1 d1)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) →
    leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c1 d1) :=
  fun (hl : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) =>
    leRep_wd_snd a1 b1 c d c1 d1 (intRel_to_eq c d c1 d1 hqq)
      (leRep_wd_fst a b a1 b1 c d (intRel_to_eq a b a1 b1 hpp) hl)

-- soko:hint 思路：两个方向：正向就是练习 ④；反向把两条假设各取一次 intRel_symm（练习 ①），再对调两组代表元用一次练习 ④。用 And.intro 把两个方向装起来。
-- soko:hint 目标形态：`(leRep p q → leRep p1 q1) ∧ (leRep p1 q1 → leRep p q)`。
-- soko:hint 关键件：And.intro · leRep_wd（练习 ④）· intRel_symm（练习 ①）。

theorem leRep_wd_iff (a b a1 b1 c d c1 d1 : Nat)
    (hpp : intRel (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a1 b1))
    (hqq : intRel (@prod_mk Nat Nat c d) (@prod_mk Nat Nat c1 d1)) :
    (leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) →
         leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c1 d1)) ∧
        (leRep (@prod_mk Nat Nat a1 b1) (@prod_mk Nat Nat c1 d1) →
         leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :=
  And.intro
    (leRep_wd a b a1 b1 c d c1 d1 hpp hqq)
    (leRep_wd a1 b1 a b c1 d1 c d
      (intRel_symm (@prod_mk Nat Nat a b) (@prod_mk Nat Nat a1 b1) hpp)
      (intRel_symm (@prod_mk Nat Nat c d) (@prod_mk Nat Nat c1 d1) hqq))

theorem demo_leNat_succ_self (n : Nat) : LeNat n (Nat.succ n) :=
  le_succ n n (le_refl n)

-- 演示：0 - 0 ≤ 1 - 0，因为 0 + 0 ≤ 1 + 0。

theorem demo_leRep_zero_one :
    leRep (@prod_mk Nat Nat Nat.zero Nat.zero) (@prod_mk Nat Nat 1 Nat.zero) :=
  le_succ Nat.zero Nat.zero (le_refl Nat.zero)


theorem leRep_mk (a b c d : Nat) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) =
    LeNat (Nat.add a d) (Nat.add c b) :=
  Eq.refl (LeNat (Nat.add a d) (Nat.add c b))


theorem leRep_refl (p : Prod Nat Nat) : leRep p p :=
  match p with
  | prod_mk a b => le_refl (Nat.add a b)


theorem leRep_one_two :
    leRep (@prod_mk Nat Nat 1 Nat.zero) (@prod_mk Nat Nat 2 Nat.zero) :=
  le_succ 1 1 (le_refl 1)


theorem leRep_to_leNat (a b c d : Nat)
    (h : leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d)) :
    LeNat (Nat.add a d) (Nat.add c b) :=
  h


theorem leRep_of_leNat (a b c d : Nat)
    (h : LeNat (Nat.add a d) (Nat.add c b)) :
    leRep (@prod_mk Nat Nat a b) (@prod_mk Nat Nat c d) :=
  h


theorem leNat_zero_le (n : Nat) : LeNat Nat.zero n := by
  match n with
  | Nat.zero => le_refl Nat.zero
  | Nat.succ k => le_succ Nat.zero k ih

-- 演示：由 leNat_zero_le 立刻得到 0 - 0 ≤ n - 0。

theorem demo_leRep_zero_le (n : Nat) :
    leRep (@prod_mk Nat Nat Nat.zero Nat.zero) (@prod_mk Nat Nat n Nat.zero) :=
  leNat_zero_le n

-- 序的良定义性（序对版）：避免在调用点对 `mulRep ...` 做 η 展开。
theorem leRep_wd_pair (p p' q q' : Prod Nat Nat)
    (hpp : intRel p p') (hqq : intRel q q') :
    leRep p q → leRep p' q' :=
  fun (hl : leRep p q) =>
    leRep_wd
      (Prod.fst Nat Nat p) (Prod.snd Nat Nat p)
      (Prod.fst Nat Nat p') (Prod.snd Nat Nat p')
      (Prod.fst Nat Nat q) (Prod.snd Nat Nat q)
      (Prod.fst Nat Nat q') (Prod.snd Nat Nat q')
      hpp hqq hl

-- 有理数相等的自反性（M1 单元⑳ 已判卷）。
theorem ratRel_refl (x : ratRep) : ratRel x x :=
  intRel_refl
    (mulRep (Prod.fst (Prod Nat Nat) Nat x) (den (Prod.snd (Prod Nat Nat) Nat x)))

-- 序对相等 ⇒ 整数代表元相等（`intRel` 是交叉和等式，不是序对等式）。
theorem intRel_of_eq (p q : Prod Nat Nat) (h : p = q) : intRel p q :=
  @Eq.subst.{1} (Prod Nat Nat) (fun (x : Prod Nat Nat) => intRel p x) p q h
    (intRel_refl p)



theorem leNat_succ_zero_absurd (n : Nat) (h : LeNat (Nat.succ n) Nat.zero) : False :=
  @LeNat.rec
    (fun (m k : Nat) (_ : LeNat m k) =>
      ∀ (p : Nat), m = Nat.succ p → k = Nat.zero → False)
    (fun (k : Nat) => fun (p : Nat) (e1 : k = Nat.succ p) (e2 : k = Nat.zero) =>
      succ_ne_zero p (@Eq.trans.{1} Nat (Nat.succ p) k Nat.zero
        (@Eq.symm.{1} Nat k (Nat.succ p) e1) e2))
    (fun (m k : Nat) (h : LeNat m k)
         (ih : ∀ (p : Nat), m = Nat.succ p → k = Nat.zero → False) =>
      fun (p : Nat) (e1 : m = Nat.succ p) (e2 : Nat.succ k = Nat.zero) =>
        succ_ne_zero k e2)
    (Nat.succ n) Nat.zero h n (Eq.refl (Nat.succ n)) (Eq.refl Nat.zero)

theorem leNat_mul_right (a b d : Nat) (h : LeNat a b) :
    LeNat (myMul a d) (myMul b d) :=
  @LeNat.rec (fun (m n : Nat) (_ : LeNat m n) => LeNat (myMul m d) (myMul n d))
    (fun (n : Nat) => le_refl (myMul n d))
    (fun (m n : Nat) (h : LeNat m n) (ih : LeNat (myMul m d) (myMul n d)) =>
      @Eq.subst.{1} Nat
        (fun (x : Nat) => LeNat (myMul m d) x)
        (Nat.add (myMul n d) d)
        (myMul (Nat.succ n) d)
        (@Eq.symm.{1} Nat (myMul (Nat.succ n) d) (Nat.add (myMul n d) d) (succ_mul n d))
        (leNat_trans (myMul m d) (Nat.add (myMul m d) d) (Nat.add (myMul n d) d)
          (leNat_self_add (myMul m d) d)
          (leNat_add_right (myMul m d) (myMul n d) d ih)))
    a b h

theorem leNat_mul_cancel (a b d : Nat)
    (h : LeNat (myMul a (Nat.succ d)) (myMul b (Nat.succ d))) : LeNat a b :=
  @Nat.rec
    (fun (a : Nat) =>
      ∀ (b : Nat), LeNat (myMul a (Nat.succ d)) (myMul b (Nat.succ d)) → LeNat a b)
    (fun (b : Nat) (h0 : LeNat (myMul Nat.zero (Nat.succ d)) (myMul b (Nat.succ d))) =>
      leNat_zero_le b)
    (fun (a : Nat)
         (ih : ∀ (b : Nat),
           LeNat (myMul a (Nat.succ d)) (myMul b (Nat.succ d)) → LeNat a b) =>
      fun (b : Nat) =>
        @Nat.rec
          (fun (b : Nat) =>
            LeNat (myMul (Nat.succ a) (Nat.succ d)) (myMul b (Nat.succ d)) →
              LeNat (Nat.succ a) b)
          (fun (h0 : LeNat (myMul (Nat.succ a) (Nat.succ d)) (myMul Nat.zero (Nat.succ d))) =>
            @False.elim (LeNat (Nat.succ a) Nat.zero)
              (leNat_succ_zero_absurd (Nat.add (myMul a (Nat.succ d)) d)
              (@Eq.subst.{1} Nat
                (fun (x : Nat) => LeNat x Nat.zero)
                (myMul (Nat.succ a) (Nat.succ d))
                (Nat.succ (Nat.add (myMul a (Nat.succ d)) d))
                (succ_mul a (Nat.succ d))
                (@Eq.subst.{1} Nat
                  (fun (x : Nat) => LeNat (myMul (Nat.succ a) (Nat.succ d)) x)
                  (myMul Nat.zero (Nat.succ d)) Nat.zero
                  (zero_mul (Nat.succ d)) h0))))
          (fun (b' : Nat)
               (ihb : LeNat (myMul (Nat.succ a) (Nat.succ d)) (myMul b' (Nat.succ d)) →
                      LeNat (Nat.succ a) b') =>
            fun (h0 : LeNat (myMul (Nat.succ a) (Nat.succ d)) (myMul (Nat.succ b') (Nat.succ d))) =>
              leNat_succ_succ a b'
                (ih b'
                  (@leNat_add_cancel_right (myMul a (Nat.succ d)) (myMul b' (Nat.succ d)) (Nat.succ d)
                    (@Eq.subst.{1} Nat
                      (fun (x : Nat) => LeNat x (Nat.add (myMul b' (Nat.succ d)) (Nat.succ d)))
                      (myMul (Nat.succ a) (Nat.succ d))
                      (Nat.add (myMul a (Nat.succ d)) (Nat.succ d))
                      (succ_mul a (Nat.succ d))
                      (@Eq.subst.{1} Nat
                        (fun (x : Nat) =>
                          LeNat (myMul (Nat.succ a) (Nat.succ d)) x)
                        (myMul (Nat.succ b') (Nat.succ d))
                        (Nat.add (myMul b' (Nat.succ d)) (Nat.succ d))
                        (succ_mul b' (Nat.succ d))
                        h0)))))
          b)
    a b h

