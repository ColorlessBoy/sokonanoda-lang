-- 课程库：级数的尾块
--
-- 单元121 在画布上证明下面三条；这里收进 L2，后面的尾块论证直接引用：
--
--   · `cauchy_shift_left` —— 序列向左平移仍 Cauchy（补 `cauchy_shift` 的左侧写法）；
--   · `series_tail_eq` —— 尾块级数的部分和就是 114 的 `TailSum`；
--   · `summable_tail` —— 可和级数的任意尾块仍可和；
--   · `demo_tail_telescope` —— 望远镜级数的尾块仍是望远镜级数。
--
-- 边界：只证「可和 ⇒ 尾块可和」；反方向要处理尾块下标与原下标的换算，
-- 留到后续单元。不新增公理。

import lib.Rat
import lib.RatAbs
import lib.RatClose
import lib.Sum
import lib.SumSplit
import lib.Series
import lib.SeriesTail
import lib.SeriesLinear
import lib.SeriesTelescope
import lib.CauchyTail
import lib.RealComplete

-- ─────────────────────────────────────────────────────────────
-- 121.0 向左平移仍 Cauchy
-- ─────────────────────────────────────────────────────────────

-- `cauchy_shift` 移的是 `x (n + k)`；这里要 `x (k + n)`。两条下标只差
-- ℕ 加法的交换律，用 `Eq.subst` 把阈值搬过去。
theorem cauchy_shift_left (x : Seq) (k : Nat) (h : Cauchy x) :
    Cauchy (fun (n : Nat) => x (Nat.add k n)) :=
  fun (eps : ratRep) (heps : ratLtRep ratZeroRep eps) =>
    Exists.elim (h eps heps)
      (fun (N : Nat)
          (hN : ∀ (n m : Nat), LeNat N n → LeNat N m →
            close (x n) (x m) eps) =>
        Exists.intro N
          (fun (n m : Nat) (hn : LeNat N n) (hm : LeNat N m) =>
            hN (Nat.add k n) (Nat.add k m)
              (leNat_trans N n (Nat.add k n) hn
                (@Eq.subst.{1} Nat
                  (fun (t : Nat) => LeNat n t)
                  (Nat.add n k) (Nat.add k n) (add_comm n k)
                  (leNat_self_add n k)))
              (leNat_trans N m (Nat.add k m) hm
                (@Eq.subst.{1} Nat
                  (fun (t : Nat) => LeNat m t)
                  (Nat.add m k) (Nat.add k m) (add_comm m k)
                  (leNat_self_add m k)))))

-- ─────────────────────────────────────────────────────────────
-- 121.1 尾块级数的部分和
-- ─────────────────────────────────────────────────────────────

-- 两边都是同一个 `sumTo`，只是写法不同。
theorem series_tail_eq (f : Nat → ratRep) (m n : Nat) :
    ratRel (Series (fun (k : Nat) => f (Nat.add m k)) n) (TailSum f m n) :=
  ratRel_refl (TailSum f m n)

-- ─────────────────────────────────────────────────────────────
-- 121.2 可和级数的尾块仍可和
-- ─────────────────────────────────────────────────────────────

-- 尾块级数的部分和是 `S (m + n) - S m`（114.5）。`S` 向左平移仍 Cauchy，
-- 再加一个常数 `-S m`；搬运律把它换成尾块级数本身。
theorem summable_tail (f : Nat → ratRep) (m : Nat) (h : Summable f) :
    Summable (fun (k : Nat) => f (Nat.add m k)) :=
  cauchy_congr
    (addConst (fun (n : Nat) => Series f (Nat.add m n))
      (ratNegRep (Series f m)))
    (Series (fun (k : Nat) => f (Nat.add m k)))
    (fun (n : Nat) =>
      ratRel_symm
        (TailSum f m n)
        (ratSubRep (Series f (Nat.add m n)) (Series f m))
        (tail_eq_sub f m n))
    (cauchy_add_const (fun (n : Nat) => Series f (Nat.add m n))
      (ratNegRep (Series f m))
      (cauchy_shift_left (Series f) m h))

-- ─────────────────────────────────────────────────────────────
-- 121.3 具体：望远镜级数的尾块仍是望远镜级数
-- ─────────────────────────────────────────────────────────────

-- 尾块的第 k 项是 `b (m+k+1) - b (m+k)`，正是平移后端点序列的相邻差。
theorem demo_tail_telescope (b : Nat → ratRep) (m : Nat) (hb : Cauchy b) :
    Summable (fun (k : Nat) =>
      ratSubRep (b (Nat.add m (Nat.succ k))) (b (Nat.add m k))) :=
  summable_telescope (fun (j : Nat) => b (Nat.add m j))
    (cauchy_shift_left b m hb)
