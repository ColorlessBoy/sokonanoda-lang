theorem demo_limit_class_add_zero :
    ∃ (c : Real),
      addRel (Real.mk (constSeq ratZeroRep)) (Real.mk (constSeq ratZeroRep)) c ∧
        LimitClass (addSeq (constSeq ratZeroRep) (constSeq ratZeroRep)) c :=
  limitClass_add (constSeq ratZeroRep) (constSeq ratZeroRep)
    (Real.mk (constSeq ratZeroRep)) (Real.mk (constSeq ratZeroRep))
    (demo_limit_class_const ratZeroRep) (demo_limit_class_const ratZeroRep)

theorem demo_limit_class_neg_zero :
