theorem demo_lib_closure : True := True.intro

theorem demo_ext_real_top : ele negInf posInf := True.intro

theorem demo_ext_real_chain : ele negInf (fin (Real.mk zeroSeq)) :=
  negInf_le (fin (Real.mk zeroSeq))

theorem demo_subseq_id : Subseq (fun (n : Nat) => n) := subseq_id

theorem demo_limitPoint_zero : LimitPoint (constSeq ratZeroRep) ratZeroRep :=
  limitPoint_const ratZeroRep

theorem demo_limsup_const_zero : Limsup (constSeq ratZeroRep) ratZeroRep :=
  limsup_const ratZeroRep

theorem demo_liminf_const_zero : Liminf (constSeq ratZeroRep) ratZeroRep :=
  liminf_const ratZeroRep

theorem demo_limsup_subseq_const_zero :
    Limsup (subseqSeq (fun (n : Nat) => n) (constSeq ratZeroRep)) ratZeroRep :=
  limsup_subseq_of_converges (constSeq ratZeroRep) (fun (n : Nat) => n) subseq_id
    ratZeroRep (converges_const ratZeroRep)

theorem demo_zero_bounded_above : BoundedAbove (constSeq ratZeroRep) ratZeroRep :=
  fun (n : Nat) => ratLeRep_refl ratZeroRep

theorem demo_limsup_le_of_boundedAbove_zero :
    ratLeRep ratZeroRep ratZeroRep :=
  limsup_le_of_boundedAbove (constSeq ratZeroRep) ratZeroRep ratZeroRep
    demo_zero_bounded_above (limsup_const ratZeroRep)

theorem demo_tail_refl_zero : TailEq (constSeq ratZeroRep) (constSeq ratZeroRep) :=
  tailEq_refl (constSeq ratZeroRep)

theorem demo_converges_congr_tail_zero :
    Converges (constSeq ratZeroRep) ratZeroRep :=
  converges_congr_tail (constSeq ratZeroRep) (constSeq ratZeroRep) ratZeroRep
    (converges_const ratZeroRep) (tailEq_refl (constSeq ratZeroRep))
