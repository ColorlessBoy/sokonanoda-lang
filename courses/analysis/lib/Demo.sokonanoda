      LimitClass (constSeq ratZeroRep) a ∧
        ∀ (b : Real), LimitClass (constSeq ratZeroRep) b → b = a :=
  limitClass_exists_unique (constSeq ratZeroRep) (cauchy_const ratZeroRep)

