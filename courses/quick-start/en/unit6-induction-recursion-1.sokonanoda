-- ==========================================================================
-- unit6-induction-recursion-1.sokonanoda — Unit 6 · Induction & Recursion I
--
-- The ground rules:
--
--   * An exercise is a declaration whose value is `sorry`. Replace `sorry`
--     with your answer, and let the kernel be the judge.
--   * A partial answer is a legitimate state: write the first few `fun`
--     layers, leave the last one as `sorry`, and the remaining goal stays
--     open for you.
--   * Everything you complete here is also valid in official Lean: the
--     grammar you learn is a real subset of Lean 4.
--
-- This is the first half of "induction & recursion": build the inductive type
-- Nat yourself, write recursive definitions with it (unfolding `Nat.rec` by
-- hand), then learn `match` for case analysis and recursive `match`, which
-- carries an induction hypothesis automatically. The second half (Unit 7)
-- continues with parameters, dependent match, and indexed types.
-- ==========================================================================

-- So far Nat was a gift from the prelude. This time we build it ourselves: an
-- explicit inductive block is a type, its constructors, the eliminator Nat.rec,
-- and the iota rules. The block replaces the prelude Nat for the whole file —
-- from here on the file is self-sufficient. The block comes from
-- examples/py-nat.sokonanoda with the arrows written as this course's `→`.

inductive Nat : Type
ctor zero : Nat
ctor succ (n : Nat) : Nat
rec Nat.rec {u} :
  (motive : (n : Nat) → Sort u) →
  (mz : motive zero) →
  (ms : (n : Nat) → motive n → motive (succ n)) →
  (n : Nat) → motive n
iota zero :=
  fun (motive : (n : Nat) → Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) → motive n → motive (succ n)) => mz
iota succ :=
  fun (motive : (n : Nat) → Sort u) =>
  fun (mz : motive zero) =>
  fun (ms : (n : Nat) → motive n → motive (succ n)) =>
  fun (n : Nat) => ms n (Nat.rec.{u} motive mz ms n)
end

-- Demo (already written): numbers are now built from constructors; the magic
-- of literals is gone.
def one : Nat := succ zero
def two : Nat := succ one
def three : Nat := succ two

-- Self-test: #reduce walks the iota rules — succ two is 3.
#reduce succ two

-- Reading Nat.rec: give it a motive, a value mz at zero, and a step function ms
-- that builds "the result at succ k" out of "the result ih at k"; it then
-- yields motive n for any n. A recursive definition is exactly choosing these
-- three pieces and feeding a number.

-- Exercise 1 — define four : Nat. Hint: three already exists — stack one more
-- succ on it.
-- soko:hint approach: literals have lost their magic — numbers are layered up from constructors now, and three is already in scope.
-- soko:hint goal shape: the goal is Nat: stack one more layer on three.
-- soko:hint key piece: succ — the constructor that turns a Nat into its successor.
def four : Nat := by sorry

-- Exercise 2 (double, recursively) — zero maps to zero; at succ k, obtain the
-- double of succ k from the induction result ih. The motive is the constant
-- function (fun (x : Nat) => Nat) throughout.
-- Hint: mirror the shape of Nat.rec: motive → mz → ms → n.
-- soko:hint approach: a recursive definition is choosing Nat.rec's three pieces — the motive, the value at zero, and the step function — then feeding n.
-- soko:hint goal shape: outer fun (n : Nat) => Nat.rec … n; the motive is the constant fun (x : Nat) => Nat, and zero maps to zero.
-- soko:hint key piece: Nat.rec.{1} filled as motive → mz → ms → n; ms eats k and ih — think how many extra succs the double of succ k needs over ih.
def double : Nat → Nat := by sorry

-- Exercise 3 (addition) — add m n inducts on m. At zero, return n ("count zero
-- times"); at succ k, stack one more succ on ih ("one more layer").
-- Hint: the induction variable is m — Nat.rec's first explicit argument takes n
-- and its last takes m.
-- soko:hint approach: same three pieces, but the induction variable is m — "counting zero times" is just n, "one more layer" is succ ih.
-- soko:hint goal shape: fun (m : Nat) => fun (n : Nat) => Nat.rec … m — feed m last (the induction variable); n is the starting value.
-- soko:hint key piece: Nat.rec.{1}, motive still constant; n goes at mz (the zero-times result), and ms eats k and ih, stacking a single succ.
def add : Nat → Nat → Nat := by sorry

-- Closing loop (kernel re-check): once Exercise 3 is done, uncomment the line
-- below. It must turn green — add two two is four succs; iota does the
-- counting for you.
-- #reduce add two two

-- ─────────────────────────────────────────────────────────────
-- `match` — case on a non-recursive enum. The Color type below has just
-- two constructors, red and green; as before we give its eliminator
-- Color.rec and the iota rules, then use match to cover every
-- constructor once.
-- ─────────────────────────────────────────────────────────────

inductive Color : Type
ctor red : Color
ctor green : Color
rec Color.rec {u} :
  (motive : (c : Color) → Sort u) →
  (mr : motive red) →
  (mg : motive green) →
  (c : Color) → motive c
iota red :=
  fun (motive : (c : Color) → Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mr
iota green :=
  fun (motive : (c : Color) → Sort u) =>
  fun (mr : motive red) =>
  fun (mg : motive green) => mg
end

-- Demo (already written): swap exchanges red and green; one arm each.
def swap (c : Color) : Color := match c with
| red => green
| green => red

-- Self-test: #reduce walks the Color.rec that match lowers to — swap red is green.
#reduce swap red

-- Exercise 4 — relabel maps red to red and green to green (the identity).
-- soko:hint approach: match lists red and green once, and each arm must produce a Color.
-- soko:hint goal shape: fun (c : Color) => match c with …; arm order is free — the front-end reorders by declaration order.
-- soko:hint key piece: match must cover red and green, and each arm's goal is Color; the identity map hands each constructor straight back.
def relabel (c : Color) : Color := by sorry

-- Exercise 5 — leave a sorry inside one match arm; only the green arm is missing.
-- soko:hint approach: the red arm already yields green; the green arm is pending, and its goal type is Color.
-- soko:hint goal shape: match c with | red => green | green => <your answer>.
-- soko:hint key piece: the green arm's goal is Color; to get swap (red and green exchanged), this arm hands over the other constructor.
def swapOpen (c : Color) : Color := match c with
| red => green
| green => sorry

-- ─────────────────────────────────────────────────────────────
-- `match` + recursion: the induction hypothesis (IH) inside an arm.
-- For a source recursive inductive, every recursive field is followed by an
-- auto-inserted binder named `ih` (its type is the match result type Nat);
-- the arm references it directly, so recursion needs no self-reference. The
-- `addM` demo's succ arm does exactly that: stack one more succ on `ih`.
-- ─────────────────────────────────────────────────────────────

-- Demo (already written): addM a b inducts on a — b at zero, succ ih at succ.
-- Same semantics as Exercise 3's add, just written with match.
def addM (a b : Nat) : Nat := match a with
| zero => b
| succ m => succ ih

-- Self-test: #reduce walks the Nat.rec that match lowers to — addM two three
-- is five succs.
#reduce addM two three

-- Exercise 6 — recDouble inducts on n: zero maps to zero; at succ, build
-- succ (succ ih) from the induction hypothesis ih. Only the succ arm is missing.
-- soko:hint approach: the recursive field m is followed by an auto-inserted induction hypothesis ih (its type is the result type Nat); the succ arm builds its result from it directly.
-- soko:hint goal shape: match n with | zero => zero | succ m => <succ arm>; both arms must produce a Nat.
-- soko:hint key piece: the succ arm's goal is Nat and the auto-inserted induction hypothesis ih is in scope; doubling is two succ layers above ih.
def recDouble (n : Nat) : Nat := match n with
| zero => zero
| succ m => sorry
