-- Ported from py_nanobruijn teaching/fol fragments.
-- Arrow-first style: named arrows replace non-dependent forall binders.

def id {u} : {α : Sort u} -> (a : α) -> α
  := fun {α : Sort u} => fun (a : α) => a

def Function.comp {u, v, w} : {α : Sort u} -> {β : Sort v} -> {δ : Sort w} -> (f : β -> δ) -> (g : α -> β) -> (x : α) -> δ
  := fun {α : Sort u} => fun {β : Sort v} => fun {δ : Sort w} => fun (f : β -> δ) => fun (g : α -> β) => fun (x : α) => f (g x)

def flip {u, v, w} : {α : Sort u} -> {β : Sort v} -> {φ : Sort w} -> (f : α -> β -> φ) -> (b : β) -> (a : α) -> φ
  := fun {α : Sort u} => fun {β : Sort v} => fun {φ : Sort w} => fun (f : α -> β -> φ) => fun (b : β) => fun (a : α) => f a b

axiom True : Prop
axiom True.intro : True

axiom False : Prop
axiom False.rec {u} : (motive : (anon : False) -> Sort u) -> (t : False) -> motive t

axiom And : Prop -> Prop -> Prop
axiom And.intro : {a : Prop} -> {b : Prop} -> (ha : a) -> (hb : b) -> And a b
axiom And.left : {a : Prop} -> {b : Prop} -> (h : And a b) -> a
axiom And.right : {a : Prop} -> {b : Prop} -> (h : And a b) -> b
axiom And.rec : {a : Prop} -> {b : Prop} -> (motive : And a b -> Prop) -> (case : (left : a) -> (right : b) -> motive (@And.intro a b left right)) -> (t : And a b) -> motive t

axiom Or : Prop -> Prop -> Prop
axiom Or.inl : {a : Prop} -> {b : Prop} -> (h : a) -> Or a b
axiom Or.inr : {a : Prop} -> {b : Prop} -> (h : b) -> Or a b
axiom Or.rec : {a : Prop} -> {b : Prop} -> (motive : Or a b -> Prop) -> (left : (l : a) -> motive (@Or.inl a b l)) -> (right : (r : b) -> motive (@Or.inr a b r)) -> (t : Or a b) -> motive t

axiom Iff : Prop -> Prop -> Prop
axiom Iff.intro : {a : Prop} -> {b : Prop} -> (mp : a -> b) -> (mpr : b -> a) -> Iff a b
axiom Iff.mp : {a : Prop} -> {b : Prop} -> (h : Iff a b) -> (ha : a) -> b
axiom Iff.mpr : {a : Prop} -> {b : Prop} -> (h : Iff a b) -> (hb : b) -> a

def Not : Prop -> Prop
  := fun (a : Prop) => a -> False

def absurd {v} : {a : Prop} -> (b : Sort v) -> (ha : a) -> (hn : Not a) -> b
  := fun {a : Prop} => fun (b : Sort v) => fun (ha : a) => fun (hn : Not a) => @False.rec.{v} (fun (anon : False) => b) (hn ha)

axiom Exists {u} : {α : Sort u} -> (p : α -> Prop) -> Prop
axiom Exists.intro {u} : {α : Sort u} -> (p : α -> Prop) -> (w : α) -> (h : p w) -> @Exists.{u} α p

theorem iff_of_true : {a : Prop} -> {b : Prop} -> (ha : a) -> (hb : b) -> Iff a b
  := fun {a : Prop} => fun {b : Prop} => fun (ha : a) => fun (hb : b) => @Iff.intro a b (fun (anon : a) => hb) (fun (anon : b) => ha)

theorem and_comm_iff : {a : Prop} -> {b : Prop} -> Iff (And a b) (And b a)
  := fun {a : Prop} => fun {b : Prop} => @Iff.intro (And a b) (And b a) (fun (x : And a b) => @And.intro b a (@And.right a b x) (@And.left a b x)) (fun (x : And b a) => @And.intro a b (@And.right b a x) (@And.left b a x))

theorem or_comm_iff : {a : Prop} -> {b : Prop} -> Iff (Or a b) (Or b a)
  := fun {a : Prop} => fun {b : Prop} =>
       @Iff.intro (Or a b) (Or b a)
         (fun (t : Or a b) => @Or.rec a b (fun (x : Or a b) => Or b a) (fun (l : a) => @Or.inr b a l) (fun (r : b) => @Or.inl b a r) t)
         (fun (t : Or b a) => @Or.rec b a (fun (x : Or b a) => Or a b) (fun (l : b) => @Or.inr a b l) (fun (r : a) => @Or.inl a b r) t)

axiom Eq {u} : {α : Sort u} -> (a1 : α) -> (a2 : α) -> Prop
axiom Eq.refl {u} : {α : Sort u} -> (a : α) -> @Eq.{u} α a a
axiom Eq.rec {u, v} : {α : Sort u} -> (a : α) -> (motive : (anon : α) -> Sort v) -> (ha : motive a) -> (b : α) -> (h : @Eq.{u} α a b) -> motive b
axiom propext : {a : Prop} -> {b : Prop} -> (h : Iff a b) -> @Eq.{1} Prop a b

theorem Eq_symm {u} : {α : Sort u} -> (a : α) -> (b : α) -> (h : @Eq.{u} α a b) -> @Eq.{u} α b a
  := fun {α : Sort u} => fun (a : α) => fun (b : α) => fun (h : @Eq.{u} α a b) =>
       @Eq.rec.{u, 0} α a (fun (x : α) => @Eq.{u} α x a) (@Eq.refl.{u} α a) b h

theorem Eq_trans {u} : {α : Sort u} -> (a : α) -> (b : α) -> (c : α) -> (h1 : @Eq.{u} α a b) -> (h2 : @Eq.{u} α b c) -> @Eq.{u} α a c
  := fun {α : Sort u} => fun (a : α) => fun (b : α) => fun (c : α) => fun (h1 : @Eq.{u} α a b) => fun (h2 : @Eq.{u} α b c) =>
       @Eq.rec.{u, 0} α b (fun (x : α) => @Eq.{u} α a x) h1 c h2

theorem congrArg {u} : {α : Sort u} -> (β : Prop) -> (f : α -> β) -> (a1 : α) -> (a2 : α) -> (h : @Eq.{u} α a1 a2) -> @Eq.{0} β (f a1) (f a2)
  := fun {α : Sort u} => fun (β : Prop) => fun (f : α -> β) => fun (a1 : α) => fun (a2 : α) => fun (h : @Eq.{u} α a1 a2) =>
       @Eq.rec.{u, 0} α a1 (fun (x : α) => @Eq.{0} β (f a1) (f x)) (@Eq.refl.{0} β (f a1)) a2 h

theorem not_imp_of_and_not_ : {a : Prop} -> {b : Prop} -> (x : And a (Not b)) -> Not (a -> b)
  := fun {a : Prop} => fun {b : Prop} => fun (x : And a (Not b)) => fun (f : a -> b) =>
       @And.rec a (Not b) (fun (y : And a (Not b)) => False) (fun (ha : a) => fun (hn : Not b) => hn (f ha)) x

theorem or_iff_left_of_imp_ : {b : Prop} -> {a : Prop} -> (hb : b -> a) -> Iff (Or a b) a
  := fun {b : Prop} => fun {a : Prop} => fun (hb : b -> a) =>
       @Iff.intro (Or a b) a
         (fun (t : Or a b) => @Or.rec a b (fun (x : Or a b) => a) (fun (ha : a) => ha) (fun (hb0 : b) => hb hb0) t)
         (fun (ha : a) => @Or.inl a b ha)
