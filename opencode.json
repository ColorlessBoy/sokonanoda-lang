{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["./skills"]
  },
  "lsp": {
    "sokonanoda": {
      "command": [
        "bash",
        "-c",
        "exec \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.opencode/lsp/sokonanoda-lsp.sh\""
      ],
      "extensions": [".sokonanoda"]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "lean*": "deny",
      "lake*": "deny",
      "elan*": "deny",
      "leanc*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "target/**",
      "node_modules/**",
      ".vscode-test/**",
      "learner/**",
      "*.vsix"
    ]
  },
  "formatter": {
    "cargofmt": { "disabled": true },
    "rustfmt": { "disabled": true }
  }
}
