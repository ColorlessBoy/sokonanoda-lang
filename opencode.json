{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "lean*": "deny",
      "lake*": "deny",
      "elan*": "deny",
      "leanc*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "target/**",
      "node_modules/**",
      ".vscode-test/**",
      "learner/**",
      "*.vsix"
    ]
  },
  "formatter": {
    "cargofmt": {
      "disabled": true
    },
    "rustfmt": {
      "disabled": true
    }
  }
}
